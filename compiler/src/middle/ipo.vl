// Interprocedural analyses (0.6): function attributes inferred bottom-up
// over the call graph, the questions the other passes ask about a call
// (does it write memory, read memory, can it be removed), and
// interprocedural constant propagation of arguments and results. See
// docs/optimizer.md, "0.6: interprocedural optimization".

use crate::back::abi::{fn_type_uses_c, fn_uses_c};
use crate::back::codecache::{R_ATTRS, R_STATIC, cc_note};
use crate::back::regalloc::intervals::calls_returns_twice;
use crate::back::regalloc::prepare::layout_order;
use crate::base::{
    STDERR, buf_byte, buf_fmt, buf_int, buf_new, buf_str, buf_write_fd, find_sym, intern_c,
    sized_table, sym_name, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::effects::{
    EFF_ALLOC_EXTERN, EFF_DIVERGE, EFF_GLOBAL, EFF_IO, EFF_PANIC, EFF_RAW_DIVERGE, EFF_RAW_PANIC,
    EFF_SYNC, EFF_THREAD, EFF_TLS, EFF_UNKNOWN, Effects, fn_effects,
};
use crate::front::effects::builtin::{
    C_ALLOC, C_GLOBAL, C_IO, C_NONE, C_PURE, C_READS, c_class, c_symbol, known_c_effects,
};
use crate::front::types::{TY_BOOL, TY_U64, TY_U8, is_float, is_integer};
use crate::gen0::gen::fn_is_global;
use crate::gen0::target::rt_panic_sym;
use crate::middle::callfacts::{
    HW_ARGS, HW_ARG_SHIFT, HW_FAR, HW_KNOWN, HW_RESULT, HW_STATIC, mark_returning, no_writes,
    note_writes, writes_bits, writes_hi, writes_lo,
};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::gvn::{
    copy_dst, copy_src, find_escaping_slots, is_copy, is_private_root, root_of,
};
use crate::middle::inline::{ir_callee, param_operand};
use crate::middle::ir::{
    Op, Term, fn_block, fn_block_count, fn_entry, ir_append, ir_arg, ir_enter, ir_insert_before,
    ir_make, ir_new_slot, ir_operand, ir_operand_count, ir_replace, ir_set_operand, ir_unlink,
    ir_val,
};
use crate::middle::ir::Op::{
    Add, Call, CallC, CallI, Cmp, Const, Copy, FAddr, Load, Param, SAddr, Store,
};
use crate::middle::ir::atomic::is_barrier;
use crate::middle::ir::cfg::{succ, succ_count};
use crate::middle::ir::verify::verify_func;
use crate::middle::opt::{resolve_all, simplify_function};
use crate::middle::parallel::fn_facts_ready;

// ---- Attributes ----

// Bits of FN_ATTRS: what is known of a function (an IR function).
// READNONE: it reads and writes no memory but its private frame slots;
// READONLY: it writes none; NORETURN: it never returns; WILLRETURN: it
// always returns (no loop, no recursion, only such callees); NOPANIC: it
// cannot panic or exit.
pub const ATTR_READNONE: i64 = 1;
pub const ATTR_READONLY: i64 = 2;
pub const ATTR_NORETURN: i64 = 4;
pub const ATTR_WILLRETURN: i64 = 8;
pub const ATTR_NOPANIC: i64 = 16;
// (0.25) BOUNDED: it returns after a small, bounded amount of work (no
// cycle, at most SPECULATE_COST of its own and its callees' instructions,
// only bounded callees); its cost is the bits from ATTR_COST_SHIFT. What
// LICM may run where the program would not have (WILLRETURN alone is not:
// `for i in 0..n` returns, after n iterations).
pub const ATTR_BOUNDED: i64 = 32;
const ATTR_COST_SHIFT: i64 = 8;
const SPECULATE_COST: i64 = 64;
// The cost of a bounded C library function (builtin.vl's table: libm).
const C_LIB_COST: i64 = 16;
const ATTR_ALL: i64 = 63;

pub fn init_attrs(pcx: &mut Ctx<Comp>) {
    pcx.fn_attrs.reset(pcx.irfunc_count + 1, 0);
    pcx.fn_nocapture.reset(pcx.irfunc_count + 1, 0);
    pcx.fn_attrs_done.reset(pcx.irfunc_count + 1, 0);
    pcx.attrs_ready = true;
}

// What call v is known to do, as attribute bits (0: nothing known).
pub fn call_attrs(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    let op = (cx.insts[v as usize]).op;
    if op == Call {
        let g = (pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) - 1;
        if g < 0 {
            // A C function (builtin.vl's table, or its declaration).
            return front_attrs((cx.insts[v as usize]).imm, pcx);
        }
        // (0.18.1: in the bottom-up phase, a callee whose component is
        // below this one's: one being done on another thread is not)
        // (0.27.8: FN_ATTRS_DONE[g] read only outside the phase, where
        // fn_facts_ready reads `done`: in it, another component of this
        // level may be writing it, infer_component_attrs)
        if pcx.attrs_ready
            && fn_facts_ready(cx, g,
                cx.cur_comp >= 0 || (pcx.fn_attrs_done.get(g)) != 0, pcx) {
            // (0.18.1: for the code cache, back::codecache)
            cc_note(cx, R_ATTRS, g, pcx);
            return (pcx.fn_attrs.get(g))
                | front_attrs((cx.insts[v as usize]).imm, pcx);
        }
        return front_attrs((cx.insts[v as usize]).imm, pcx);
    }
    if op == CallC {
        let name = (cx.insts[v as usize]).imm;
        if name == rt_panic_sym(pcx) {
            // It prints its operands and exits: it writes nothing a later
            // instruction could see, and nothing comes after it.
            return ATTR_READNONE | ATTR_READONLY | ATTR_NORETURN;
        }
        return c_lib_attrs(cx, v, name, pcx);
    }
    0
}

// What the front end's effects (0.16, front/effects) say of function f (an
// FNS index), as attribute bits: ¬raw diverge WILLRETURN, ¬raw panic
// NOPANIC, and READNONE (and so READONLY) for a C function of the table
// that reads and writes no memory (C_PURE: libm, abs), by the symbol it
// links to. A C function the inference left unknown and that declares
// nothing has builtin.vl's table. 0: nothing known. (0.30.1, RT-5: what
// a C function does to memory comes from the table, never from its
// parameter types: a number can be a pointer in C's ABI, and memset and
// strlen declared with usize parameters were READNONE, so -O1 deleted
// the one and folded the other. Effects say nothing of the memory a
// function reaches through its arguments, so a declaration's
// `#[effects()]` gives no READNONE either.)
pub fn front_attrs(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut e = fn_effects(f, pcx);
    // (0.25) A C function of the table (that declares nothing): libm is
    // bounded.
    let table = pcx.fns[f as usize].is_extern && pcx.fns[f as usize].effect_decl == 0
        && (known_c_effects(pcx.fns[f as usize].name, pcx).bits & EFF_UNKNOWN) == 0;
    if (e.bits & EFF_UNKNOWN) != 0 && pcx.fns[f as usize].is_extern
        && pcx.fns[f as usize].effect_decl == 0 {
        e = known_c_effects(pcx.fns[f as usize].name, pcx);
    }
    let pure = pcx.fns[f as usize].is_extern && pcx.fns[f as usize].effect_decl == 0
        && c_class(c_symbol(f, pcx), pcx) == C_PURE;
    let mut attrs = effects_attrs(e, pure);
    if table {
        attrs = c_lib_bounded(attrs);
    }
    // (0.29) What a C function of the table writes (middle::callfacts).
    if pcx.fns[f as usize].is_extern && pcx.fns[f as usize].effect_decl == 0 {
        attrs = attrs | c_header_writes(f, pcx);
    }
    if pcx.fns[f as usize].is_extern && (attrs & ATTR_WILLRETURN) == 0 {
        // (A C function that may not return may exit: `exit`, `abort`.)
        attrs = attrs & !ATTR_NOPANIC;
    }
    attrs
}

// (0.29) The Vec headers C function f (undeclared effects: std's table)
// may write, as callfacts' bits: HW_KNOWN alone for one that writes no
// memory of the program (strlen; C's allocator, which writes its own
// blocks and tables), with the bit of each pointer parameter for one that
// writes through the pointers it is given (memcpy, read, posix_memalign's
// result); 0 (unknown) for the rest: a function not in the table, a
// variadic one, one that waits for or starts a thread.
fn c_header_writes(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let sym = c_symbol(f, pcx);
    let class = c_class(sym, pcx);
    if class == C_READS || class == C_PURE
        || class == C_ALLOC && sym != find_sym(b"posix_memalign", pcx) {
        return HW_KNOWN;
    }
    if class != C_NONE && class != C_ALLOC && class != C_IO && class != C_GLOBAL
        || pcx.fns[f as usize].variadic {
        return 0;
    }
    let mut bits = HW_KNOWN;
    for k in 0..pcx.fns[f as usize].param_count {
        let t = (pcx.tlists[(pcx.fns[f as usize].params + k) as usize]);
        if !is_integer(t) && !is_float(t) && t != TY_BOOL {
            if k >= HW_ARGS {
                return 0;
            }
            bits = bits | (1 << (HW_ARG_SHIFT + k));
        }
    }
    bits
}

// (0.29) Whether C function f (undeclared effects) returns a block of C's
// allocator (malloc, calloc, realloc...; not posix_memalign, whose result
// is a status).
pub fn c_allocates(f: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.fns[f as usize].is_extern && pcx.fns[f as usize].effect_decl == 0 && {
        let sym = c_symbol(f, pcx);
        c_class(sym, pcx) == C_ALLOC && sym != find_sym(b"posix_memalign", pcx)
    }
}

// The attribute bits effects e give (READNONE too when `readnone_ok`: a C
// function of the table's class C_PURE, front_attrs).
fn effects_attrs(e: Effects, readnone_ok: bool) -> i64 {
    if (e.bits & EFF_UNKNOWN) != 0 {
        return 0;
    }
    let mut attrs: i64 = 0;
    if (e.bits & (EFF_DIVERGE | EFF_RAW_DIVERGE)) == 0 {
        attrs = attrs | ATTR_WILLRETURN;
    }
    if (e.bits & (EFF_PANIC | EFF_RAW_PANIC)) == 0 {
        attrs = attrs | ATTR_NOPANIC;
    }
    // (0.21: sync, thread and tls read and write memory other threads see;
    // 0.26.1: interior, a write through a shared reference, a cell)
    let memory = EFF_IO | EFF_GLOBAL | EFF_ALLOC_EXTERN | EFF_SYNC | EFF_THREAD | EFF_TLS
        | crate::front::effects::EFF_INTERIOR;
    if readnone_ok && e.allocs == 0 && (e.bits & memory) == 0 {
        attrs = attrs | ATTR_READNONE | ATTR_READONLY;
    }
    attrs
}

// What C library function `sym` called by the lowering (CALLC v) does:
// builtin.vl's table, READNONE when its class is C_PURE (0.30.1: not by
// its arguments' types, front_attrs).
fn c_lib_attrs(cx: &mut FnCtx<Comp>, v: i64, sym: i64, pcx: &Ctx<Comp>) -> i64 {
    let attrs = effects_attrs(known_c_effects(sym, pcx), c_class(sym, pcx) == C_PURE);
    if (attrs & ATTR_WILLRETURN) == 0 { 0 } else { c_lib_bounded(attrs) }
}

// (0.25) A C library function of builtin.vl's table that reads no memory
// (libm) is bounded: a few dozen instructions, whatever its arguments.
fn c_lib_bounded(attrs: i64) -> i64 {
    let pure = ATTR_READNONE | ATTR_WILLRETURN | ATTR_NOPANIC;
    if (attrs & pure) == pure { attrs | ATTR_BOUNDED | (C_LIB_COST << ATTR_COST_SHIFT) }
    else { attrs }
}

// (0.25) The cost of a call with attributes `attrs` (call_attrs) when it is
// bounded, else -1.
pub fn bounded_cost(attrs: i64) -> i64 {
    if (attrs & ATTR_BOUNDED) == 0 { -1 } else { (attrs >> ATTR_COST_SHIFT) & 255 }
}

// Whether call v may write memory other than the caller's private slots.
pub fn call_writes(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    call_attrs(cx, v, pcx) & ATTR_READONLY == 0
}

// Whether call v may read memory other than the caller's private slots.
pub fn call_reads(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    call_attrs(cx, v, pcx) & ATTR_READNONE == 0
}

// Whether call v may be removed when its result is unused: it reads and
// writes nothing, always returns and cannot panic.
pub fn call_removable(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    let needed = ATTR_READNONE | ATTR_WILLRETURN | ATTR_NOPANIC;
    call_attrs(cx, v, pcx) & needed == needed
}

// Whether instruction v must stay even when its value is unused.
pub fn has_effect(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    let op = (cx.insts[v as usize]).op;
    if op.is_call() {
        return !call_removable(cx, v, pcx);
    }
    op.has_side_effect()
}

// The attributes of function fi from its instructions, its callees' known
// attributes, and FN_ATTRS of the functions of its own component (assumed
// for now: the component is iterated). Also its nocapture bits.
fn compute_attrs(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> i64 {
    if calls_returns_twice(cx, fi, pcx) {
        pcx.fn_nocapture.set(fi, 0);
        return 0;
    }
    find_escaping_slots(cx, fi, pcx);
    layout_order(cx, fi);
    mark_returning(cx);
    let mut attrs = ATTR_ALL;
    let mut returns = false;
    // (0.25) Its instructions and its callees' costs, for BOUNDED.
    let mut cost: i64 = 0;
    // (0.29) The Vec headers it may write (middle::callfacts).
    let mut hw = no_writes();
    for i in 0..cx.order.len() as i64 {
        let b = (cx.order[i as usize]);
        if (cx.blocks[b as usize]).term == Term::Ret {
            returns = true;
        }
        // A cycle (an edge to a block not later in reverse post-order):
        // the function may loop forever.
        for k in 0..succ_count(cx, b) {
            let s = succ(cx, b, k);
            if (cx.blocks[s as usize]).order >= 0
                && (cx.blocks[s as usize]).order <= (cx.blocks[b as usize]).order {
                attrs = attrs & !(ATTR_WILLRETURN | ATTR_BOUNDED);
            }
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let op = (cx.insts[v as usize]).op;
            if op != Const {
                cost += 1;
            }
            // (0.29) A call's callee's attributes, for the Vec headers
            // it may write (middle::callfacts).
            let mut callee: i64 = 0;
            if op == Load {
                if reads_shared(cx, (cx.insts[v as usize]).a) {
                    attrs = attrs & !ATTR_READNONE;
                }
            } else if op == Store {
                if writes_shared(cx, (cx.insts[v as usize]).a) {
                    attrs = attrs & !(ATTR_READNONE | ATTR_READONLY);
                }
            } else if is_copy(cx, v, pcx) {
                let copy_dst_v = copy_dst(cx, v);
                if writes_shared(cx, copy_dst_v) {
                    attrs = attrs & !(ATTR_READNONE | ATTR_READONLY);
                }
                let copy_src_v = copy_src(cx, v);
                if reads_shared(cx, copy_src_v) {
                    attrs = attrs & !ATTR_READNONE;
                }
            } else if is_barrier(cx, v) {
                // (0.21) An atomic or a fence: shared memory read and
                // written, other threads synchronized with.
                attrs = attrs & !(ATTR_READNONE | ATTR_READONLY);
            } else if op.is_call() {
                let mut known = call_attrs(cx, v, pcx);
                if op == Call {
                    let g = (pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) - 1;
                    cc_note(cx, R_STATIC, g, pcx);
                    if g >= 0
                        && (pcx.fn_scc[g as usize]) == (pcx.fn_scc[fi as usize]) {
                        // Within the component: what is assumed so far;
                        // recursion may not return.
                        known = (pcx.fn_attrs.get(g))
                            & !(ATTR_WILLRETURN | ATTR_BOUNDED);
                        cx.used_component = true;
                    }
                }
                callee = known;
                if known & ATTR_READNONE == 0 {
                    attrs = attrs & !ATTR_READNONE;
                }
                if known & ATTR_READONLY == 0 {
                    attrs = attrs & !(ATTR_READNONE | ATTR_READONLY);
                }
                if known & ATTR_WILLRETURN == 0 && known & ATTR_NORETURN == 0 {
                    attrs = attrs & !ATTR_WILLRETURN;
                }
                if known & ATTR_NOPANIC == 0 {
                    attrs = attrs & !ATTR_NOPANIC;
                }
                // (A call that does not return ends the work too.)
                if known & ATTR_NORETURN == 0 {
                    let c = bounded_cost(known);
                    if c < 0 {
                        attrs = attrs & !ATTR_BOUNDED;
                    } else {
                        cost += c;
                    }
                }
            }
            // (a block that reaches no RET: its writes are not seen)
            if (cx.blocks[b as usize]).mark == 2 {
                note_writes(cx, fi, v, callee, &mut hw, pcx);
            }
            v = (cx.insts[v as usize]).next;
        }
    }
    if returns {
        attrs = attrs & !ATTR_NORETURN;
    } else {
        attrs = attrs & !(ATTR_WILLRETURN | ATTR_BOUNDED);
    }
    if (attrs & ATTR_BOUNDED) != 0 {
        if cost > SPECULATE_COST {
            attrs = attrs & !ATTR_BOUNDED;
        } else {
            attrs = attrs | (cost << ATTR_COST_SHIFT);
        }
    }
    pcx.fn_nocapture.set(fi, compute_nocapture(cx, fi, pcx));
    attrs | writes_bits(&hw)
}

// Whether a load from address a may read memory other than private slots
// and constant data.
fn reads_shared(cx: &mut FnCtx<Comp>, a: i64) -> bool {
    let ir_val_v = ir_val(cx, a);
    let root = root_of(cx, ir_val_v);
    !is_private_root(cx, root) && !(root != 0 && (cx.insts[root as usize]).op == SAddr)
}

// Whether a store to address a may write memory other than private slots.
fn writes_shared(cx: &mut FnCtx<Comp>, a: i64) -> bool {
    let ir_val_v = ir_val(cx, a);
    let root = root_of(cx, ir_val_v);
    !is_private_root(cx, root)
}

// The nocapture bits of function fi: a bit per call operand (see
// param_operand) of a parameter that is only dereferenced, compared, or
// passed to a nocapture parameter.
fn compute_nocapture(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut bits: i64 = 0;
    let entry = fn_entry(cx, fi);
    let mut p = (cx.blocks[entry as usize]).first;
    while p != 0 && (cx.insts[p as usize]).op == Param {
        let k = param_operand(cx, fi, p, pcx);
        if k >= 0 && k < 63 && (cx.insts[p as usize]).ty == TY_U64
            && !captured(cx, fi, p, pcx) {
            bits = bits | (1 << k);
        }
        p = (cx.insts[p as usize]).next;
    }
    bits
}

fn captured(cx: &mut FnCtx<Comp>, fi: i64, p: i64, pcx: &Ctx<Comp>) -> bool {
    cx.capture_stamp += 1;
    let stamp = cx.capture_stamp;
    (cx.insts[p as usize]).mark = stamp;
    let mut result = false;
    let mut grew = true;
    while grew && !result {
        grew = false;
        for i in 0..fn_block_count(cx, fi) {
            let b = (fn_block(cx, fi, i));
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            if (cx.blocks[b as usize]).term == Term::Ret
                && (cx.blocks[b as usize]).cond != 0
                && {
                let at_ix = ir_val(cx, (cx.blocks[b as usize]).cond) as usize;
                cx.insts[at_ix].mark
            }
            == stamp {
                result = true;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 && !result {
                for k in 0..ir_operand_count(cx, v) {
                    let ir_operand_v = ir_operand(cx, v, k);
                    if ir_operand_v == 0
                        || {
                        let at_ix = ir_val(cx, ir_operand(cx, v, k)) as usize;
                        cx.insts[at_ix].mark
                    }
                    != stamp {
                        continue;
                    }
                    let op = (cx.insts[v as usize]).op;
                    if op == Add && (cx.insts[v as usize]).ty == TY_U64 && k <= 1 {
                        if (cx.insts[v as usize]).mark != stamp {
                            (cx.insts[v as usize]).mark = stamp;
                            grew = true;
                        }
                    } else if (op == Load || op == Store) && k == 0 {
                    } else if op == Copy && k <= 1 {
                    } else if op == Cmp {
                    } else if op == Call && k >= 3 {
                        let g = (pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) - 1;
                        let bit = k - 3;
                        cc_note(cx, R_STATIC, g, pcx);
                        if g >= 0 && g != fi
                            && (pcx.fn_scc[g as usize]) != (pcx.fn_scc[fi as usize]) {
                            cc_note(cx, R_ATTRS, g, pcx);
                        }
                        if g >= 0 && g != fi
                            && (pcx.fn_scc[g as usize]) == (pcx.fn_scc[fi as usize]) {
                            cx.used_component = true;
                        }
                        if g < 0 || bit >= 63 || g == fi
                            || ((pcx.fn_scc[g as usize]) != (pcx.fn_scc[fi as usize])
                                && !fn_facts_ready(cx, g,
                                    cx.cur_comp >= 0
                                        || (pcx.fn_attrs_done.get(g)) != 0, pcx))
                            || (pcx.fn_nocapture.get(g)) & (1 << bit) == 0 {
                            result = true;
                        }
                    }
                    else if op == CallC
                        && (cx.insts[v as usize]).imm == rt_panic_sym(pcx) {
                    } else {
                        result = true;
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
        }
    }
    result
}

// Infers the attributes of the functions SCC_ORDER[start..end] (one
// component), optimistically: everything is assumed, then taken away
// until nothing changes. A component whose functions do not call each
// other (a single function, not recursive) takes one round.
pub fn infer_component_attrs(cx: &mut FnCtx<Comp>, start: i64, end: i64, pcx: &Ctx<Comp>) {
    for i in start..end {
        let fi = (pcx.scc_order[i as usize]);
        pcx.fn_attrs.set(fi, (ATTR_ALL & !ATTR_NORETURN) | HW_KNOWN);
        pcx.fn_nocapture.set(fi, -1);
    }
    let mut changed = true;
    let mut rounds: i64 = 0;
    while changed && rounds < 16 {
        changed = false;
        rounds += 1;
        cx.used_component = false;
        for i in start..end {
            let fi = (pcx.scc_order[i as usize]);
            ir_enter(cx, fi, pcx);
            let nocapture = (pcx.fn_nocapture.get(fi));
            let attrs = compute_attrs(cx, fi, pcx);
            if attrs != (pcx.fn_attrs.get(fi))
                || (pcx.fn_nocapture.get(fi)) != nocapture {
                pcx.fn_attrs.set(fi, attrs);
                changed = true;
            }
        }
        if !cx.used_component {
            changed = false;
        }
    }
    if changed {
        // Not settled: nothing is known.
        for i in start..end {
            pcx.fn_attrs.set((pcx.scc_order[i as usize]), 0);
            pcx.fn_nocapture.set((pcx.scc_order[i as usize]), 0);
        }
    }
    for i in start..end {
        pcx.fn_attrs_done.set((pcx.scc_order[i as usize]), 1);
    }
    // (0.30) --vec-stats=FN: FN's summary of the Vec headers it may write,
    // and the first instruction that made it unknown; then the tables as
    // the last function's inference left them
    if pcx.vec_stats_fn != 0 as *mut u8 && end > start {
        let mut said = false;
        for i in start..end {
            let fi = (pcx.scc_order[i as usize]);
            if crate::middle::vectorize::fn_named(pcx.ir_fn[fi as usize], pcx.vec_stats_fn, pcx) {
                report_header_writes(cx, fi, pcx);
                said = true;
            }
        }
        if said {
            let last = (pcx.scc_order[(end - 1) as usize]);
            ir_enter(cx, last, pcx);
            if !calls_returns_twice(cx, last, pcx) {
                find_escaping_slots(cx, last, pcx);
                layout_order(cx, last);
                mark_returning(cx);
            }
        }
    }
}

// (0.30) --vec-stats=FN: a line on stderr saying what is known of the Vec
// headers function fi may write (middle::callfacts: the summary its
// callers keep a Vec's pointer and length across the call with), after
// its component's attributes are settled:
//
//   vec-headers: NAME: known: writes none
//   vec-headers: NAME: known: writes through operand 0 (words 0..3), a static's
//   vec-headers: NAME: unknown: line 12: a call of `g`, whose summary is unknown
//
// For an unknown summary, the first instruction (in layout order, in a
// block that reaches a return) that made it so, and why: the walk of
// compute_attrs again, with the callees' settled attributes.
pub fn report_header_writes(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    let out = buf_new();
    buf_fmt(out,
        format_args("vec-headers: {}: ",
            str::from_utf8(sym_text(pcx.fns[pcx.ir_fn[fi as usize] as usize].display, pcx)).unwrap()));
    let attrs = pcx.fn_attrs.get(fi);
    if attrs & HW_KNOWN != 0 {
        buf_fmt(out, format_args("known: writes"));
        let mut any = false;
        for k in 0..HW_ARGS {
            if attrs & (1 << (HW_ARG_SHIFT + k)) == 0 {
                continue;
            }
            buf_fmt(out, format_args("{} through operand {k}", if any { "," } else { "" }));
            // (the range is the first marked operand's; the others' writes
            // are at any offset)
            if !any {
                let lo = writes_lo(attrs, k);
                let hi = writes_hi(attrs, k);
                if hi == HW_FAR {
                    buf_fmt(out, format_args(" (words from {lo})"));
                } else {
                    buf_fmt(out, format_args(" (words {lo}..{hi})"));
                }
            } else {
                buf_fmt(out, format_args(" (anywhere in it)"));
            }
            any = true;
        }
        if attrs & HW_STATIC != 0 {
            buf_fmt(out, format_args("{} a static's", if any { "," } else { "" }));
            any = true;
        }
        if attrs & HW_RESULT != 0 {
            buf_fmt(out, format_args("{} through its result pointer", if any { "," } else { "" }));
            any = true;
        }
        if !any {
            buf_fmt(out, format_args(" none"));
        }
        buf_fmt(out, format_args("\n"));
        buf_write_fd(out, STDERR);
        return;
    }
    ir_enter(cx, fi, pcx);
    if calls_returns_twice(cx, fi, pcx) {
        buf_fmt(out,
            format_args("unknown: it calls a function that returns twice (setjmp): nothing is inferred of it\n"));
        buf_write_fd(out, STDERR);
        return;
    }
    find_escaping_slots(cx, fi, pcx);
    layout_order(cx, fi);
    mark_returning(cx);
    let mut hw = no_writes();
    let mut first: i64 = 0;
    let mut first_callee: i64 = 0;
    for i in 0..cx.order.len() as i64 {
        let b = (cx.order[i as usize]);
        if (cx.blocks[b as usize]).mark != 2 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 && first == 0 {
            let callee = if (cx.insts[v as usize]).op.is_call() { call_attrs(cx, v, pcx) }
                else { 0 };
            note_writes(cx, fi, v, callee, &mut hw, pcx);
            if !hw.known {
                first = v;
                first_callee = callee;
            }
            v = (cx.insts[v as usize]).next;
        }
        if first != 0 {
            break;
        }
    }
    buf_fmt(out, format_args("unknown: "));
    if first == 0 {
        // (a component that did not settle, or one assumed unknown)
        buf_fmt(out,
            format_args("no instruction of its own: its recursive component did not settle\n"));
        buf_write_fd(out, STDERR);
        return;
    }
    if first < cx.inst_loc.len() as i64 && (cx.inst_loc[first as usize]) > 0 {
        buf_fmt(out,
            format_args("line {}: ",
                crate::back::dwarf::file_and_line((cx.inst_loc[first as usize]) - 1, pcx)
                    & 0xffffffff));
    }
    let op = (cx.insts[first as usize]).op;
    if op == Call {
        let name = sym_text(pcx.fns[(cx.insts[first as usize]).imm as usize].display, pcx);
        let name = str::from_utf8(name).unwrap();
        if (pcx.fn_ir[(cx.insts[first as usize]).imm as usize]) - 1 < 0 {
            buf_fmt(out,
                format_args("a call of C's `{name}` (a C function other than the allocator's has no summary)\n"));
        } else if first_callee & HW_KNOWN == 0 {
            buf_fmt(out,
                format_args("a call of `{name}`, whose summary is unknown (--vec-stats={name})\n"));
        } else {
            buf_fmt(out, format_args("a call of `{name}`, which writes through an operand or its result at an address the summary does not follow here\n"));
        }
    } else if op == CallC {
        buf_fmt(out,
            format_args("a call of C's `{}` (not the allocator's)\n",
                str::from_utf8(sym_text((cx.insts[first as usize]).imm, pcx)).unwrap()));
    } else if op.is_call() {
        buf_fmt(out, format_args("an indirect call\n"));
    } else if op == Store {
        buf_fmt(out, format_args("a store through an address the summary does not follow (a pointer loaded from memory, a raw pointer of unknown origin, a number made a pointer)\n"));
    } else if is_copy(cx, first, pcx) {
        buf_fmt(out, format_args("a block copy to an address the summary does not follow (a pointer loaded from memory, a raw pointer of unknown origin)\n"));
    } else {
        buf_fmt(out,
            format_args("an atomic operation, a fence, a memory intrinsic or an indexed store\n"));
    }
    buf_write_fd(out, STDERR);
}

// --print-attrs.
pub fn print_attrs(pcx: &Ctx<Comp>) {
    let out = buf_new();
    for fi in 0..pcx.irfunc_count {
        if (pcx.fn_live[fi as usize]) == 0
            || (pcx.fn_attrs_done.get(fi)) == 0 {
            continue;
        }
        buf_str(out, sym_name(pcx.fns[pcx.ir_fn[fi as usize] as usize].name, pcx));
        buf_str(out, c":");
        let a = (pcx.fn_attrs.get(fi));
        if a & ATTR_READNONE != 0 {
            buf_str(out, c" readnone");
        } else if a & ATTR_READONLY != 0 {
            buf_str(out, c" readonly");
        }
        if a & ATTR_NORETURN != 0 {
            buf_str(out, c" noreturn");
        }
        if a & ATTR_WILLRETURN != 0 {
            buf_str(out, c" willreturn");
        }
        if a & ATTR_NOPANIC != 0 {
            buf_str(out, c" nopanic");
        }
        if a & ATTR_BOUNDED != 0 {
            buf_str(out, c" bounded(");
            buf_int(out, bounded_cost(a));
            buf_str(out, c")");
        }
        // (0.29) The Vec headers it may write (middle::callfacts): none,
        // or where (a static's, the result's, an operand's).
        if a & HW_KNOWN != 0 {
            buf_str(out, c" headers(");
            let mut sep = false;
            if a & HW_STATIC != 0 {
                buf_str(out, c"static");
                sep = true;
            }
            if a & HW_RESULT != 0 {
                buf_str(out, if sep { c" result" } else { c"result" });
                sep = true;
            }
            for k in 0..HW_ARGS {
                if a & (1 << (HW_ARG_SHIFT + k)) != 0 {
                    if sep {
                        buf_byte(out, b' ');
                    }
                    buf_int(out, k);
                    // (the first one's range, in bytes)
                    if writes_hi(a, k) != HW_FAR {
                        buf_byte(out, b'@');
                        buf_int(out, writes_lo(a, k) * 8);
                        buf_str(out, c"..");
                        buf_int(out, writes_hi(a, k) * 8);
                    }
                    sep = true;
                }
            }
            buf_str(out, c")");
        }
        let nc = (pcx.fn_nocapture.get(fi));
        for k in 0..63 {
            if nc & (1 << k) != 0 {
                buf_str(out, c" nocapture(");
                buf_int(out, k);
                buf_str(out, c")");
            }
        }
        buf_byte(out, b'\n');
    }
    buf_write_fd(out, STDERR);
}

// ---- Interprocedural constant propagation ----

// A constant (or function address) passed at a call site, by value: the
// instruction is the caller's (0.17).
#[derive(Clone, Copy)] struct ConstArg { op: Op, ty: i64, imm: i64 }

// The direct call sites of every function g: CALL_SITES[CALL_START[g] ..
// CALL_START[g + 1]], each an instruction of function CALL_FNS[..] (0.17:
// instruction ids are the caller's own).
fn collect_call_sites(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    let n = pcx.irfunc_count;
    sized_table(&mut pcx.call_start, n + 2, 0);
    let mut total: i64 = 0;
    for pass in 0..2 {
        let mut fill: Vec<i64, Comp> = Vec::new_in(Comp {});
        fill.resize((n + 1) as usize, 0);
        for fi in 0..n {
            if (pcx.fn_live[fi as usize]) == 0 {
                continue;
            }
            ir_enter(cx, fi, pcx);
            for i in 0..fn_block_count(cx, fi) {
                let b = (fn_block(cx, fi, i));
                if (cx.blocks[b as usize]).removed != 0 {
                    continue;
                }
                let mut v = (cx.blocks[b as usize]).first;
                while v != 0 {
                    let g = ir_callee(cx, v, pcx);
                    if g >= 0 {
                        if pass == 0 {
                            (pcx.call_start[g as usize]) += 1;
                        } else {
                            let at = (pcx.call_start[g as usize] + fill[g as usize]) as usize;
                            pcx.call_sites[at] = v;
                            pcx.call_fns[at] = fi;
                            fill[g as usize] += 1;
                        }
                    }
                    v = (cx.insts[v as usize]).next;
                }
            }
        }
        if pass == 0 {
            for g in 0..n + 1 {
                let count = (pcx.call_start[g as usize]);
                (pcx.call_start[g as usize]) = total;
                total += count;
            }
            sized_table(&mut pcx.call_sites, total + 1, 0);
            sized_table(&mut pcx.call_fns, total + 1, 0);
        }
    }
}

// Whether function g is internal: only its direct calls reach it.
fn is_internal(g: i64, pcx: &Ctx<Comp>) -> bool {
    (pcx.fn_live[g as usize]) != 0 && (pcx.fn_address[g as usize]) == 0
        && !fn_is_global(pcx.ir_fn[g as usize], pcx)
        && !fn_uses_c(pcx.ir_fn[g as usize], pcx)
}

// The constant every call site passes as operand k (found: false when
// they do not agree, or one passes no constant).
fn common_constant_arg(cx: &mut FnCtx<Comp>, g: i64, k: i64, found: &mut ConstArg, pcx: &Ctx<Comp>) -> bool {
    let start = (pcx.call_start[g as usize]);
    let end = (pcx.call_start[(g + 1) as usize]);
    if end == start {
        return false;
    }
    for i in start..end {
        let call = (pcx.call_sites[i as usize]);
        ir_enter(cx, (pcx.call_fns[i as usize]), pcx);
        if (cx.insts[call as usize]).block == 0
            || k >= (cx.insts[call as usize]).nargs {
            return false;
        }
        let ir_arg_v = ir_arg(cx, call, k);
        let a = ir_val(cx, ir_arg_v);
        if !is_const(cx, a) && (cx.insts[a as usize]).op != FAddr
            && (cx.insts[a as usize]).op != Op::RtId {
            return false;
        }
        if i == start {
            *found = ConstArg {
                op: (cx.insts[a as usize]).op, ty: (cx.insts[a as usize]).ty,
                imm: (cx.insts[a as usize]).imm,
            };
        }
        else if (cx.insts[a as usize]).op != found.op
            || (cx.insts[a as usize]).imm != found.imm
            || (cx.insts[a as usize]).ty != found.ty {
            return false;
        }
    }
    true
}

// ---- Devirtualization ----

// Indirect calls of a function's address become direct calls (when the
// pointer's convention is the function's): after constant propagation
// and inlining, a function pointer argument is often a constant. Returns
// whether any call changed.
pub fn devirtualize(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    let mut changed = false;
    for i in 0..fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            if (cx.insts[v as usize]).op == CallI {
                let callee = ir_val(cx, (cx.insts[v as usize]).a);
                if (cx.insts[callee as usize]).op == FAddr {
                    let f = (cx.insts[callee as usize]).imm;
                    let fn_ty = (cx.insts[v as usize]).imm;
                    if fn_type_uses_c(fn_ty, pcx) == fn_uses_c(f, pcx)
                        && !pcx.fns[f as usize].variadic
                        && pcx.fns[f as usize].param_count == pcx.types[fn_ty as usize].count {
                        (cx.insts[v as usize]).op = Call;
                        (cx.insts[v as usize]).a = 0;
                        (cx.insts[v as usize]).imm = f;
                        changed = true;
                    }
                }
            }
            v = (cx.insts[v as usize]).next;
        }
    }
    changed
}

// Replaces the uses of v in function fi by `by`, keeping v.
fn replace_uses_keep(cx: &mut FnCtx<Comp>, fi: i64, v: i64, by: i64) {
    for i in 0..fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        let mut w = (cx.blocks[b as usize]).first;
        while w != 0 {
            for k in 0..ir_operand_count(cx, w) {
                let operand = ir_operand(cx, w, k);
                if operand != 0 && ir_val(cx, operand) == v {
                    ir_set_operand(cx, w, k, by);
                }
            }
            w = (cx.insts[w as usize]).next;
        }
        if (cx.blocks[b as usize]).cond != 0
            && ir_val(cx, (cx.blocks[b as usize]).cond) == v {
            (cx.blocks[b as usize]).cond = by;
        }
    }
}

// The constant every `ret` of function g returns (a scalar), or 0.
fn common_constant_result(cx: &mut FnCtx<Comp>, g: i64) -> i64 {
    let mut first: i64 = 0;
    for i in 0..fn_block_count(cx, g) {
        let b = (fn_block(cx, g, i));
        if (cx.blocks[b as usize]).removed != 0
            || (cx.blocks[b as usize]).term != Term::Ret {
            continue;
        }
        let r = ir_val(cx, (cx.blocks[b as usize]).cond);
        if r == 0 || !is_const(cx, r) {
            return 0;
        }
        if first == 0 {
            first = r;
        } else if (cx.insts[r as usize]).imm != (cx.insts[first as usize]).imm {
            return 0;
        }
    }
    first
}

// Interprocedural constant propagation: constant arguments into internal
// functions, top-down (callers first, so constants reaching a function
// can flow on to its callees), and constant results out of them. Returns
// whether anything changed.
pub fn propagate_constants(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    collect_call_sites(cx, pcx);
    let mut any = false;
    let mut i = pcx.scc_order.len() as i64;
    while i > 0 {
        i -= 1;
        let g = (pcx.scc_order[i as usize]);
        if !is_internal(g, pcx)
            || (pcx.call_start[(g + 1) as usize]) == (pcx.call_start[g as usize]) {
            continue;
        }
        ir_enter(cx, g, pcx);
        resolve_all(cx, g);
        let mut changed = false;
        let entry = fn_entry(cx, g);
        let mut p = (cx.blocks[entry as usize]).first;
        while p != 0 && (cx.insts[p as usize]).op == Param {
            let next = (cx.insts[p as usize]).next;
            let k = param_operand(cx, g, p, pcx);
            if k >= 0 {
                let mut c = ConstArg { op: Const, ty: 0, imm: 0 };
                let agree = common_constant_arg(cx, g, k, &mut c, pcx);
                ir_enter(cx, g, pcx);
                if agree && c.ty == (cx.insts[p as usize]).ty {
                    let k2 = ir_make(cx, c.op, c.ty, 0, 0, c.imm, pcx);
                    ir_append_after_params(cx, entry, k2);
                    replace_uses_keep(cx, g, p, k2);
                    changed = true;
                }
            }
            p = next;
        }
        if changed {
            any = true;
            devirtualize(cx, g, pcx);
            verify_func(cx, g, c"interprocedural constants (arguments)", pcx);
            simplify_function(cx, g, pcx);
        }
    }
    // Constant results.
    for g in 0..pcx.irfunc_count {
        if !is_internal(g, pcx) {
            continue;
        }
        ir_enter(cx, g, pcx);
        let r = common_constant_result(cx, g);
        if r == 0 {
            continue;
        }
        let r_ty = (cx.insts[r as usize]).ty;
        let r_imm = (cx.insts[r as usize]).imm;
        for s in (pcx.call_start[g as usize])..(pcx.call_start[(g + 1) as usize]) {
            let call = (pcx.call_sites[s as usize]);
            let fi = (pcx.call_fns[s as usize]);
            ir_enter(cx, fi, pcx);
            if (cx.insts[call as usize]).block == 0
                || (cx.insts[call as usize]).ty == 0
                || (cx.insts[call as usize]).ty != r_ty {
                continue;
            }
            let c = ir_make(cx, Const, r_ty, 0, 0, r_imm, pcx);
            let next = (cx.insts[call as usize]).next;
            if next != 0 {
                ir_insert_before(cx, next, c);
            } else {
                ir_append(cx, (cx.insts[call as usize]).block, c);
            }
            replace_uses_keep(cx, fi, call, c);
            any = true;
        }
    }
    any
}

// ---- Escape analysis: heap to stack ----

const HEAP_TO_STACK_MAX: i64 = 1024;
const CALLOC_TO_STACK_MAX: i64 = 256;

// The C function called by v (a symbol), or 0. (0.30.1) An extern's FNS
// name is the symbol it links to: an extern named malloc that links to
// the program's allocator is not malloc here.
fn c_callee_name(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    if (cx.insts[v as usize]).op == Call && pcx.fns[(cx.insts[v as usize]).imm as usize].is_extern
        && (pcx.fn_ir[(cx.insts[v as usize]).imm as usize]) == 0 {
        return pcx.fns[(cx.insts[v as usize]).imm as usize].name;
    }
    0
}

// The constant size of allocation call v (malloc or calloc of constant
// sizes), or -1.
fn allocation_size(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    let name = c_callee_name(cx, v, pcx);
    if name == pcx.malloc_sym && (cx.insts[v as usize]).nargs == 1 {
        let ir_arg_v = ir_arg(cx, v, 0);
        let n = ir_val(cx, ir_arg_v);
        if is_const(cx, n) && (cx.insts[n as usize]).imm > 0
            && (cx.insts[n as usize]).imm <= HEAP_TO_STACK_MAX {
            return (cx.insts[n as usize]).imm;
        }
    }
    if name == pcx.calloc_sym && (cx.insts[v as usize]).nargs == 2 {
        let ir_arg_v1 = ir_arg(cx, v, 0);
        let n = ir_val(cx, ir_arg_v1);
        let ir_arg_v2 = ir_arg(cx, v, 1);
        let m = ir_val(cx, ir_arg_v2);
        if is_const(cx, n) && is_const(cx, m) && (cx.insts[n as usize]).imm > 0
            && (cx.insts[m as usize]).imm > 0
            && (cx.insts[n as usize]).imm <= CALLOC_TO_STACK_MAX
            && (cx.insts[m as usize]).imm <= CALLOC_TO_STACK_MAX
            && (cx.insts[n as usize]).imm * (cx.insts[m as usize]).imm
            <= CALLOC_TO_STACK_MAX {
            return (cx.insts[n as usize]).imm * (cx.insts[m as usize]).imm;
        }
    }
    -1
}

// Whether the pointer p made by an allocation in function fi stays in fi:
// it (and addresses computed from it) is only dereferenced, compared, or
// passed itself to free; frees of it are listed in `frees`.
fn allocation_stays(cx: &mut FnCtx<Comp>, fi: i64, p: i64, frees: &mut Vec<i64, Comp>,
    pcx: &Ctx<Comp>) -> bool {
    let mut derived: Vec<i64, Comp> = Vec::new_in(Comp {});
    derived.push(p);
    let mut ok = true;
    let mut d: i64 = 0;
    while d < derived.len() as i64 && ok {
        let x = (derived[d as usize]);
        d += 1;
        for i in 0..fn_block_count(cx, fi) {
            let b = (fn_block(cx, fi, i));
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            if (cx.blocks[b as usize]).cond != 0
                && ir_val(cx, (cx.blocks[b as usize]).cond) == x {
                ok = false;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 && ok {
                for k in 0..ir_operand_count(cx, v) {
                    let ir_operand_v = ir_operand(cx, v, k);
                    if ir_operand_v == 0 || ir_val(cx, ir_operand(cx, v, k)) != x {
                        continue;
                    }
                    let op = (cx.insts[v as usize]).op;
                    if op == Add && (cx.insts[v as usize]).ty == TY_U64 && k <= 1 {
                        derived.push(v);
                    } else if (op == Load || op == Store) && k == 0 {
                    } else if op == Copy && k <= 1 {
                    } else if op == Cmp {
                    } else if is_copy(cx, v, pcx) && (k == 3 || k == 4) {
                    }
                    else if x == p && op == Call && k == 3
                        && (cx.insts[v as usize]).nargs == 1
                        && c_callee_name(cx, v, pcx) == pcx.free_sym {
                        frees.push(v);
                    } else {
                        ok = false;
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
        }
    }
    ok
}

// Turns the small allocations of function fi whose pointers stay in it
// into frame slots (zeroed for calloc), and drops their frees. Returns
// whether any was. MALLOC_SYM and the others are made before the tasks
// run (init_syms).
pub fn heap_to_stack(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    if calls_returns_twice(cx, fi, pcx) {
        return false;
    }
    ir_enter(cx, fi, pcx);
    resolve_all(cx, fi);
    let mut changed = false;
    let mut frees: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..fn_block_count(cx, fi) {
        let b = (fn_block(cx, fi, i));
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let next = (cx.insts[v as usize]).next;
            let size = allocation_size(cx, v, pcx);
            frees.clear();
            if size > 0 && allocation_stays(cx, fi, v, &mut frees, pcx) {
                let zero = c_callee_name(cx, v, pcx) == pcx.calloc_sym;
                let s = ir_new_slot(cx, size, 16);
                let addr = ir_make(cx, Op::Slot, TY_U64, 0, 0, s, pcx);
                ir_insert_before(cx, v, addr);
                if zero {
                    zero_fill(cx, addr, size, v, pcx);
                }
                for k in 0..frees.len() as i64 {
                    ir_unlink(cx, (frees[k as usize]));
                }
                ir_replace(cx, v, addr);
                changed = true;
            }
            v = next;
        }
    }
    if changed {
        resolve_all(cx, fi);
        verify_func(cx, fi, c"heap to stack", pcx);
    }
    changed
}

// (0.18.1) The symbols heap_to_stack compares with, made before the tasks
// run (middle::parallel: interning grows the program's table).
pub fn init_syms(pcx: &mut Ctx<Comp>) {
    if pcx.malloc_sym == 0 {
        pcx.malloc_sym = intern_c(c"malloc", pcx);
        pcx.calloc_sym = intern_c(c"calloc", pcx);
        pcx.free_sym = intern_c(c"free", pcx);
    }
}

// Stores zeros to [addr, + size) before instruction `at`.
fn zero_fill(cx: &mut FnCtx<Comp>, addr: i64, size: i64, at: i64, pcx: &Ctx<Comp>) {
    let mut offset: i64 = 0;
    while offset < size {
        let width: i64 = if size - offset >= 8 { 8 } else { 1 };
        let ty = if width == 8 { TY_U64 } else { TY_U8 };
        let zero = ir_make(cx, Const, ty, 0, 0, 0, pcx);
        ir_insert_before(cx, at, zero);
        let st = ir_make(cx, Store, 0, addr, zero, offset, pcx);
        (cx.insts[st as usize]).imm2 = ty;
        ir_insert_before(cx, at, st);
        offset += width;
    }
}

// Inserts instruction v in block b after its PARAMs.
fn ir_append_after_params(cx: &mut FnCtx<Comp>, b: i64, v: i64) {
    let mut w = (cx.blocks[b as usize]).first;
    while w != 0 && (cx.insts[w as usize]).op == Param {
        w = (cx.insts[w as usize]).next;
    }
    if w == 0 {
        ir_append(cx, b, v);
    } else {
        ir_insert_before(cx, w, v);
    }
}
