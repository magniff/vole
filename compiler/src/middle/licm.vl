// Loop-invariant code motion. Natural loops are found from back edges
// (an edge t -> h where h dominates t); a loop's body is h and every block
// that reaches t without passing h. A pure instruction whose operands are
// all defined outside the loop moves to the loop's preheader (the single
// block entering the header from outside; made by splitting the entering
// edge when needed), and so does a load from a frame slot or a static
// that nothing in the loop may write. Nothing here can trap: division
// never traps in vole, and (0.25) a load moves only when its address is
// inside its object on every path (a field at a constant offset) or it
// runs in the loop's first iteration anyway: an element's load, valid
// only under its bounds check, stays below it.

// Loops: header, then the index of their first body block in LOOP_BODY,
// and its count (3 per loop).
use crate::arch::features::{FT_AVX, made_build_features};
use crate::base::{IntVec, alloc_array, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::features::fn_needs;
use crate::front::types::{is_vector, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::gvn::{
    address_base, build_dom_tree, call_may_write, copy_dst, copy_size, find_escaping_slots,
    in_object_bounds, is_copy, may_alias, root_of,
};
use crate::middle::ipo::{
    ATTR_BOUNDED, ATTR_NOPANIC, ATTR_READNONE, ATTR_READONLY, ATTR_WILLRETURN, call_attrs,
    call_writes,
};
use crate::middle::ir::{
    Op, Term, get_irfuncs, ir_append, ir_arg, ir_enter, ir_new_block, ir_resolve_operands,
    ir_unlink,
};
use crate::middle::ir::atomic::is_barrier;
use crate::middle::ir::cfg::{pred_index, redirect_succ, succ, succ_count};
use crate::middle::loops::{invariant_in, loop_preheader, loop_size};
use crate::middle::opt::{dominates, resolve_all};
use crate::middle::vecfacts::in_param_vec_header;

fn find_loops(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        cx.loops.clear();
        cx.loop_body.clear();
        let mut work = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..cx.order.len() as i64 {
            let h = (cx.order[i as usize]);
            let start = cx.loop_body.len() as i64;
            // Every back edge into h.
            for k in 0..(*cx.blocks.add(h as usize)).preds.len() as i64 {
                let t = ((*cx.blocks.add(h as usize)).preds[k as usize]);
                if (*cx.blocks.add(t as usize)).order < 0 || !dominates(cx, h, t) {
                    continue;
                }
                if cx.loop_body.len() as i64 == start {
                    for j in 0..cx.order.len() as i64 {
                        { let at_ix = (cx.order[j as usize]) as usize;
                            (*cx.blocks.add(at_ix)).mark = 0 };
                    }
                    (*cx.blocks.add(h as usize)).mark = 1;
                    cx.loop_body.push(h);
                }
                if (*cx.blocks.add(t as usize)).mark == 0 {
                    (*cx.blocks.add(t as usize)).mark = 1;
                    cx.loop_body.push(t);
                    work.push(t);
                }
                while work.len() as i64 > 0 {
                    let x = work.pop();
                    for m in 0..(*cx.blocks.add(x as usize)).preds.len() as i64 {
                        let p = ((*cx.blocks.add(x as usize)).preds[m as usize]);
                        if (*cx.blocks.add(p as usize)).order >= 0
                            && (*cx.blocks.add(p as usize)).mark == 0 {
                            (*cx.blocks.add(p as usize)).mark = 1;
                            cx.loop_body.push(p);
                            work.push(p);
                        }
                    }
                }
            }
            if cx.loop_body.len() as i64 > start {
                cx.loops.push(h);
                cx.loops.push(start);
                cx.loops.push(cx.loop_body.len() as i64 - start);
            }
        }
        free(work.data as *mut u8);
    }
}

// The preheader of the loop with header h (body blocks marked with
// `stamp`), or 0 when the loop has several entering edges (or when its
// entering edge would have to be split and `split` is false).
fn preheader(cx: &mut FnCtx<Comp>, fi: i64, h: i64, stamp: i64, split: bool, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut outside: i64 = 0;
        let mut count: i64 = 0;
        for k in 0..(*cx.blocks.add(h as usize)).preds.len() as i64 {
            let p = ((*cx.blocks.add(h as usize)).preds[k as usize]);
            if (*cx.blocks.add(p as usize)).mark != stamp {
                outside = p;
                count += 1;
            }
        }
        if count != 1 || (*cx.blocks.add(outside as usize)).order < 0 {
            return 0;
        }
        if (*cx.blocks.add(outside as usize)).term == Term::Jump {
            return outside;
        }
        if !split {
            return 0;
        }
        // Split the edge: a new block between the predecessor and the header,
        // at the same index in the header's predecessors.
        ir_enter(cx, fi, pcx);
        let e = ir_new_block(cx);
        (*cx.blocks.add(e as usize)).sealed = 1;
        (*cx.blocks.add(e as usize)).term = Term::Jump;
        (*cx.blocks.add(e as usize)).s0 = h;
        (*cx.blocks.add(e as usize)).preds.push(outside);
        redirect_succ(cx, outside, h, e);
        let index = pred_index(cx, h, outside);
        ((*cx.blocks.add(h as usize)).preds[index as usize]) = e;
        e
    }
}

// Whether something in the `count` blocks at `blocks` (a loop's) may
// write [base + offset, + size): a store, a copy, or a call (unless the
// base is a private slot).
fn blocks_may_write(cx: *mut FnCtx<Comp>, blocks: &[i64], base: i64, offset: i64,
    size: i64, pcx: &Ctx<Comp>)
    -> bool {
    // UNSAFE: the IR's tables through the raw *FnCtx.
    // SAFETY: read only; `blocks` holds block ids of this function (the
    // caller's loop), every other index an instruction or block id of it.
    unsafe {
        for i in 0..blocks.len() {
            let mut v = (*cx.blocks.add(blocks[i] as usize)).first;
            while v != 0 {
                let op = (*cx.insts.add(v as usize)).op;
                if op == Op::Store || is_copy(&mut *cx, v, pcx) {
                    let mut other_offset: i64 = if op
                        == Op::Store { (*cx.insts.add(v as usize)).imm } else { 0 };
                    let arg_v = if op == Op::Store { (*cx.insts.add(v as usize)).a }
                        else { copy_dst(&mut *cx, v) };
                    let other = address_base(&mut *cx,
                        arg_v,
                        &mut other_offset);
                    let other_size = if op
                        == Op::Store { type_size((*cx.insts.add(v as usize)).imm2, pcx) }
                        else { copy_size(&mut *cx, v) };
                    if may_alias(&mut *cx, base, offset, size, other, other_offset, other_size, pcx) {
                        return true;
                    }
                } else if (op.is_call() && call_writes(&mut *cx, v, pcx) || is_barrier(&mut *cx, v))
                    && call_may_write(&mut *cx, base, pcx) {
                    return true;
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        false
    }
}

// (0.25.4) The loads of loop l (of loops.vl's forest, canonical: it has a
// preheader) that LICM would hoist and that may run anywhere (inside
// their object on every path: a static's, a slot's, a reference
// parameter's field), moved to the preheader before the vectorizer
// analyzes the loop: a Vec's `ptr` read in every iteration keeps an
// element's address from being affine in the induction variable alone,
// and LICM runs after the loop passes. The slots' escapes must be
// current (find_escaping_slots). Returns whether one moved.
pub fn hoist_invariant_loads(cx: &mut FnCtx<Comp>, l: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: the IR's tables through the raw *FnCtx, and `blocks`, a slice
    // of the loop forest's block list taken through a copy of its header.
    // SAFETY: every index is an instruction or block id of this function;
    // `blocks` has loop_size(l) entries and does not move (the loop
    // forest is not rebuilt here: only instructions move).
    unsafe {
        let pre = loop_preheader(cx, l);
        if pre == 0 {
            return false;
        }
        let count = loop_size(cx, l);
        // (through a copy of the list's header, so that cx is free for the
        // calls below: the list does not move meanwhile, see SAFETY)
        let lp_blocks = cx.lp_blocks;
        let first = cx.lp_start[l as usize];
        let blocks = &lp_blocks.as_slice()[first as usize..(first + count) as usize];
        let mut moved = false;
        for i in 0..count {
            let mut v = (*cx.blocks.add(blocks[i as usize] as usize)).first;
            while v != 0 {
                let next = (*cx.insts.add(v as usize)).next;
                if (*cx.insts.add(v as usize)).op == Op::Load {
                    ir_resolve_operands(cx, v);
                    let a = (*cx.insts.add(v as usize)).a;
                    let size = type_size((*cx.insts.add(v as usize)).ty, pcx);
                    let mut offset = (*cx.insts.add(v as usize)).imm;
                    let base = address_base(cx, a, &mut offset);
                    // (a static's or a slot's address in the loop goes too)
                    let at_address = !invariant_in(cx, l, a)
                        && is_address_op((*cx.insts.add(a as usize)).op);
                    if (at_address || invariant_in(cx, l, a)) && !op_guarded(cx, v, pcx)
                        && (root_of(cx, base) != 0
                            || in_param_vec_header(cx, base, offset, size, pcx))
                        && in_object_bounds(cx, a, (*cx.insts.add(v as usize)).imm, size, pcx)
                        && !blocks_may_write(cx, blocks, base, offset, size, pcx) {
                        if at_address {
                            ir_unlink(cx, a);
                            ir_append(cx, pre, a);
                        }
                        ir_unlink(cx, v);
                        ir_append(cx, pre, v);
                        moved = true;
                    }
                }
                v = next;
            }
        }
        moved
    }
}

// (0.25.4) Whether op makes a memory object's address (no operands).
fn is_address_op(op: Op) -> bool {
    op == Op::GAddr || op == Op::Slot || op == Op::SAddr
}

fn defined_outside(cx: &mut FnCtx<Comp>, v: i64, stamp: i64) -> bool {
    unsafe { v == 0 || (*cx.blocks.add((*cx.insts.add(v as usize)).block as usize)).mark != stamp }
}

fn is_invariant(cx: &mut FnCtx<Comp>, v: i64, stamp: i64, start: i64, count: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        // (0.19) An operation the function may run without (it needs a
        // feature known only under a has/detect guard: an intrinsic, a
        // 256-bit value's load on x86-64) is never run before its guard:
        // hoisted only when it runs in every iteration anyway (as a load
        // that may trap).
        if op_guarded(cx, v, pcx) && !runs_first(cx, v, stamp, start, count, pcx) {
            return false;
        }
        if op == Op::Load {
            // (0.25.4: at a static's, a slot's or a string's address made
            // in the loop too, which hoist_loop then moves with it: a
            // static Vec's ptr and len, middle::vecfacts)
            let a = (*cx.insts.add(v as usize)).a;
            if !defined_outside(cx, a, stamp) && !is_address_op((*cx.insts.add(a as usize)).op) {
                return false;
            }
            let mut offset = (*cx.insts.add(v as usize)).imm;
            let base = address_base(cx, (*cx.insts.add(v as usize)).a, &mut offset);
            let size = type_size((*cx.insts.add(v as usize)).ty, pcx);
            // (0.25.4: or a Vec's header in a reference parameter's
            // referent: middle::vecfacts)
            if root_of(cx, base) == 0 && !in_param_vec_header(cx, base, offset, size, pcx) {
                return false;
            }
            // (0.25) Run in the preheader, it runs where the loop may not
            // have: only an access known inside its object (a slot's or a
            // static's field, not an element at a variable index, valid
            // only under its bounds check), or one that runs in the first
            // iteration anyway.
            if !in_object_bounds(cx, (*cx.insts.add(v as usize)).a, (*cx.insts.add(v as usize)).imm,
                size, pcx)
                && !runs_first(cx, v, stamp, start, count, pcx) {
                return false;
            }
            // (through a copy of the list's header: cx is free for the call,
            // which reads the IR and moves no list)
            let loop_body = cx.loop_body;
            return !blocks_may_write(cx,
                &loop_body.as_slice()[start as usize..(start + count) as usize], base, offset,
                size, pcx);
        }
        if op.is_call() {
            return call_invariant(cx, v, stamp, start, count, pcx);
        }
        if !op.is_pure() && !op.is_vector() && op != Op::Sel {
            return false;
        }
        defined_outside(cx, (*cx.insts.add(v as usize)).a, stamp)
            && defined_outside(cx, (*cx.insts.add(v as usize)).b, stamp)
            && defined_outside(cx, (*cx.insts.add(v as usize)).c, stamp)
    }
}

// (0.19) The target features operation v needs to be encodable: an
// intrinsic's (its table's); on x86-64, AVX for any 256-bit value, which
// only a ymm register holds (its load and store are vmovdqu, its move
// vmovdqa, its constant a ymm load). AArch64 has no such operation: its
// 256-bit vectors are legalized into halves, NEON is the baseline.
pub fn op_features(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        let mut need: i64 = 0;
        if op == Op::Intr {
            need = (pcx.intrs[(*cx.insts.add(v as usize)).imm as usize]).features;
        }
        if get_x86() {
            let ty = if op == Op::Store { (*cx.insts.add(v as usize)).imm2 }
                else { (*cx.insts.add(v as usize)).ty };
            if ty > 0 && is_vector(ty, pcx) && type_size(ty, pcx) == 32 {
                need = need | (1 << FT_AVX);
            }
        }
        need
    }
}

// (0.19) Whether operation v needs a feature (op_features) that the
// function as a whole does not know (the build's, its declaration's,
// those it needs from every caller): it is then under a has/detect guard
// (its own, or the caller's it was inlined into), and must not run where
// the guard has not been tested (docs/design/arch.md §5.2, the
// no-speculation line): not hoisted by LICM unless it runs in every
// iteration, not speculated into a select by if-conversion or isel.
pub fn op_guarded(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let need = op_features(cx, v, pcx);
        if need == 0 {
            return false;
        }
        let f = (*get_irfuncs().add(cx.ir_cur as usize)).f;
        let known = made_build_features(pcx) | fn_needs(f, pcx);
        (need & !known) != 0
    }
}

// (0.16) Whether call v (in loop l's body, blocks marked `stamp`) may move
// to the preheader: a direct call with a scalar result, READNONE, its
// arguments defined outside; and either WILLRETURN, NOPANIC and (0.25)
// BOUNDED (it may run where the loop would not have run it: returning is
// not enough, a call that returns after 2^62 steps hangs the program the
// loop ends), or certain to run in the
// loop's first iteration before anything a panic or a stop would make
// visible (then it runs once, earlier, with the same arguments).
fn call_invariant(cx: &mut FnCtx<Comp>, v: i64, stamp: i64, start: i64, count: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        if op != Op::Call && op != Op::CallC || (*cx.insts.add(v as usize)).ty == 0
            || (*cx.insts.add(v as usize)).c != 0 {
            return false;
        }
        let attrs = call_attrs(cx, v, pcx);
        if (attrs & ATTR_READNONE) == 0 {
            return false;
        }
        for i in 0..(*cx.insts.add(v as usize)).nargs {
            let ir_arg_v = ir_arg(cx, v, i);
            let defined_outside_v = defined_outside(cx, ir_arg_v, stamp);
            if !defined_outside_v {
                return false;
            }
        }
        let speculable = ATTR_WILLRETURN | ATTR_NOPANIC | ATTR_BOUNDED;
        if (attrs & speculable) == speculable {
            return true;
        }
        runs_first(cx, v, stamp, start, count, pcx)
    }
}

// Whether v runs in every iteration that completes, and in the first one
// before anything visible: its block dominates every block of the loop
// that leaves it or goes back to its header, and the instructions that
// may run before it in an iteration are not calls that may panic, stop,
// loop forever or write (I/O included).
fn runs_first(cx: &mut FnCtx<Comp>, v: i64, stamp: i64, start: i64, count: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let b = (*cx.insts.add(v as usize)).block;
        let quiet = ATTR_WILLRETURN | ATTR_NOPANIC | ATTR_READONLY;
        for i in start..start + count {
            let x = (cx.loop_body[i as usize]);
            let mut leaves = false;
            for k in 0..succ_count(cx, x) {
                let s = succ(cx, x, k);
                if (*cx.blocks.add(s as usize)).mark != stamp
                    || s == (cx.loop_body[start as usize]) {
                    leaves = true;
                }
            }
            if leaves && !dominates(cx, b, x) {
                return false;
            }
            if x != b && dominates(cx, b, x) {
                continue;
            }
            // (An inner loop before v may run forever.)
            for k in 0..succ_count(cx, x) {
                let s = succ(cx, x, k);
                if s != (cx.loop_body[start as usize]) && dominates(cx, s, x) {
                    return false;
                }
            }
            // Before v (all of x, or b up to v).
            let mut w = (*cx.blocks.add(x as usize)).first;
            while w != 0 && w != v {
                if (*cx.insts.add(w as usize)).op.is_call()
                    && (call_attrs(cx, w, pcx) & quiet) != quiet {
                    return false;
                }
                w = (*cx.insts.add(w as usize)).next;
            }
        }
        true
    }
}

pub fn run_licm(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        // First give every loop a preheader (splitting edges changes the
        // blocks, so the loops are found again until no split is needed).
        let mut rounds: i64 = 0;
        loop {
            build_dom_tree(cx, fi);
            find_loops(cx, fi);
            let mut split = false;
            for l in 0..cx.loops.len() as i64 / 3 {
                let stamp = mark_loop(cx, fi, l);
                let h = (cx.loops[(3 * l) as usize]);
                if preheader(cx, fi, h, stamp, false, pcx) == 0
                    && preheader(cx, fi, h, stamp, true, pcx) != 0 {
                    split = true;
                }
            }
            rounds += 1;
            if !split {
                break;
            }
            if rounds > 4 {
                // Give up on the remaining splits; the loop info must be
                // fresh for hoisting.
                build_dom_tree(cx, fi);
                find_loops(cx, fi);
                break;
            }
        }
        find_escaping_slots(cx, fi, pcx);
        let mut changed = false;
        let loop_count = cx.loops.len() as i64 / 3;
        // Innermost (smallest) loops first.
        let mut done = alloc_array::<i64>(loop_count + 1);
        for _ in 0..loop_count {
            let mut best: i64 = -1;
            for l in 0..loop_count {
                if (*done.add(l as usize)) == 0
                    && (best < 0
                        || (cx.loops[(3 * l + 2) as usize])
                        < (cx.loops[(3 * best + 2) as usize])) {
                    best = l;
                }
            }
            (*done.add(best as usize)) = 1;
            if hoist_loop(cx, fi, best, pcx) {
                changed = true;
            }
        }
        free(done as *mut u8);
        if changed {
            resolve_all(cx, fi);
        }
        changed
    }
}

// Marks the body of loop l with a stamp of its own (and only it); returns
// the stamp.
fn mark_loop(cx: &mut FnCtx<Comp>, fi: i64, l: i64) -> i64 {
    unsafe {
        let start = (cx.loops[(3 * l + 1) as usize]);
        let count = (cx.loops[(3 * l + 2) as usize]);
        let stamp = 100 + l;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (*cx.blocks.add(b as usize)).mark == stamp {
                (*cx.blocks.add(b as usize)).mark = 0;
            }
        }
        for i in start..start + count {
            { let at_ix = (cx.loop_body[i as usize]) as usize;
                (*cx.blocks.add(at_ix)).mark = stamp };
        }
        stamp
    }
}

fn hoist_loop(cx: &mut FnCtx<Comp>, fi: i64, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let h = (cx.loops[(3 * l) as usize]);
        let start = (cx.loops[(3 * l + 1) as usize]);
        let count = (cx.loops[(3 * l + 2) as usize]);
        let stamp = mark_loop(cx, fi, l);
        let pre = preheader(cx, fi, h, stamp, false, pcx);
        if pre == 0 {
            return false;
        }
        let mut moved_any = false;
        let mut moved = true;
        while moved {
            moved = false;
            // In layout order, so operands are seen before their users.
            for k in 0..cx.order.len() as i64 {
                let b = (cx.order[k as usize]);
                if (*cx.blocks.add(b as usize)).mark != stamp {
                    continue;
                }
                let mut v = (*cx.blocks.add(b as usize)).first;
                while v != 0 {
                    let next = (*cx.insts.add(v as usize)).next;
                    ir_resolve_operands(cx, v);
                    if is_invariant(cx, v, stamp, start, count, pcx) {
                        // (a load's address made in the loop: is_invariant)
                        let a = (*cx.insts.add(v as usize)).a;
                        if (*cx.insts.add(v as usize)).op == Op::Load
                            && !defined_outside(cx, a, stamp) {
                            ir_unlink(cx, a);
                            ir_append(cx, pre, a);
                        }
                        ir_unlink(cx, v);
                        ir_append(cx, pre, v);
                        moved = true;
                        moved_any = true;
                    }
                    v = next;
                }
            }
        }
        moved_any
    }
}
