    P_SIMPLIFY_CFG, P_SROA, P_TAIL_RECURSION, P_THREAD_TAGS, P_TRIVIAL_PHIS, P_UNROLL_RUNTIME,
    P_VECTORIZE, T_ATTRS, T_GLOBAL_DCE, T_HEAP, T_INLINE, T_IPCP, T_LICM, T_LOOPS, T_PROMOTE,
    T_SCALAR, T_SLP, T_TRE, pass_done, timer_add, timer_now,
};
