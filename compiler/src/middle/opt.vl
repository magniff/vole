use crate::middle::inline::{
    get_fn_size, set_fn_size, compute_sccs, count_call_sites, forget_fn_caches, func_size, init_fn_caches,
    inline_rounds, inlined_everywhere, ir_callee, optimize_with_leaves, simplify_inlining_leaves,
    start_inlining_budget,
};
