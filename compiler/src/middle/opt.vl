// Resolves every operand of every instruction of function `fi` (after
// replacements).
pub fn resolve_all(cx: &mut FnCtx, fi: i64) {
    unsafe {
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                ir_resolve_operands(cx, v);
                v = (*cx.insts.add(v as usize)).next;
            }
            if (*cx.blocks.add(b as usize)).cond != 0 {
                (*cx.blocks.add(b as usize)).cond = ir_val(cx, (*cx.blocks.add(b as usize)).cond);
            }
        }
    }
}

// ---- Predecessors and phis ----

// Removes predecessor `pred` (at index `index`) from block `b`, with the
// matching phi operands.
pub fn remove_pred_at(cx: &mut FnCtx, b: i64, index: i64) {
    unsafe {
        let preds = &(*cx.blocks.add(b as usize)).preds as *mut IntVec;
        for i in index..(*preds).count - 1 {
            (*(*preds).data.add(i as usize)) = (*(*preds).data.add((i + 1) as usize));
        }
        (*preds).count -= 1;
        let mut phi = (*cx.blocks.add(b as usize)).first;
        while phi != 0 && (*cx.insts.add(phi as usize)).op == Op::Phi {
            let base = (*cx.insts.add(phi as usize)).args;
            for i in index..(*cx.insts.add(phi as usize)).nargs - 1 {
                (*cx.args.data.add((base + i) as usize)) = (*cx.args.data.add((base + i + 1) as usize));
            }
            (*cx.insts.add(phi as usize)).nargs -= 1;
            phi = (*cx.insts.add(phi as usize)).next;
        }
    }
}

pub fn remove_pred(cx: &mut FnCtx, b: i64, pred: i64) {
    let index = pred_index(cx, b, pred);
    if index >= 0 {
        remove_pred_at(cx, b, index);
    }
}

// Appends predecessor `pred` to block `b`; each phi gets `pred_operand`'s
// operand for it (the phi's operand for predecessor `like`).
pub fn add_pred_like(cx: &mut FnCtx, b: i64, pred: i64, like: i64) {
    unsafe {
        let like_index = pred_index(cx, b, like);
        (*cx.blocks.add(b as usize)).preds.push(pred);
        let mut phi = (*cx.blocks.add(b as usize)).first;
        while phi != 0 && (*cx.insts.add(phi as usize)).op == Op::Phi {
            let n = (*cx.insts.add(phi as usize)).nargs;
            let start = cx.args.count;
            for i in 0..n {
                cx.args.push((*cx.args.data.add(((*cx.insts.add(phi as usize)).args + i) as usize)));
                cx.argty.push(0);
            }
            cx.args.push((*cx.args.data.add(((*cx.insts.add(phi as usize)).args + like_index) as usize)));
            cx.argty.push(0);
            (*cx.insts.add(phi as usize)).args = start;
            (*cx.insts.add(phi as usize)).nargs = n + 1;
            phi = (*cx.insts.add(phi as usize)).next;
        }
    }
}

// Removes block `b` from the function: from its successors' predecessor
// lists, and its instructions from their blocks.
pub fn remove_block(cx: &mut FnCtx, b: i64) {
    unsafe {
        for i in 0..succ_count(cx, b) {
            let succ_v = succ(cx, b, i);
            remove_pred(cx, succ_v, b);
        }
        (*cx.blocks.add(b as usize)).removed = 1;
        (*cx.blocks.add(b as usize)).term = Term::None;
        let mut v = (*cx.blocks.add(b as usize)).first;
        while v != 0 {
            let next = (*cx.insts.add(v as usize)).next;
            (*cx.insts.add(v as usize)).block = 0;
            (*cx.insts.add(v as usize)).prev = 0;
            (*cx.insts.add(v as usize)).next = 0;
            v = next;
        }
        (*cx.blocks.add(b as usize)).first = 0;
        (*cx.blocks.add(b as usize)).last = 0;
    }
}

// Removes the blocks the entry does not reach. Returns whether any was.
pub fn remove_unreachable(cx: &mut FnCtx, fi: i64) -> bool {
    layout_order(cx, fi);
    let mut changed = false;
    unsafe {
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed == 0 && (*cx.blocks.add(b as usize)).order < 0 {
                remove_block(cx, b);
                changed = true;
            }
        }
    }
    changed
}

// Replaces phis whose operands are one value (or the phi itself) by that
// value, until none is left.
pub fn remove_trivial_phis(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    let mut any = false;
    let mut changed = true;
    while changed {
        changed = false;
        unsafe {
            for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
                let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
                if (*cx.blocks.add(b as usize)).removed != 0 {
                    continue;
                }
                let mut phi = (*cx.blocks.add(b as usize)).first;
                while phi != 0 && (*cx.insts.add(phi as usize)).op == Op::Phi {
                    let next = (*cx.insts.add(phi as usize)).next;
                    let mut same: i64 = 0;
                    let mut trivial = true;
                    for k in 0..(*cx.insts.add(phi as usize)).nargs {
                        let ir_arg_v = ir_arg(cx, phi, k);
                        let operand = ir_val(cx, ir_arg_v);
                        if operand == same || operand == phi {
                            continue;
                        }
                        if same != 0 {
                            trivial = false;
                            break;
                        }
                        same = operand;
                    }
                    if trivial {
                        if same == 0 {
                            ir_enter(cx, fi, pcx);
                            same = ssa_undef(cx, (*cx.insts.add(phi as usize)).ty, pcx);
                        }
                        ir_replace(cx, phi, same);
                        changed = true;
                        any = true;
                    }
                    phi = next;
                }
            }
        }
    }
    if any {
        resolve_all(cx, fi);
    }
    any
}

// ---- Dominators ----

fn intersect(cx: &mut FnCtx, b1: i64, b2: i64) -> i64 {
    unsafe {
        let mut x = b1;
        let mut y = b2;
        let mut steps: i64 = 0;
        while x != y {
            steps += 1;
            if steps > 100000000 {
                die(c"internal error: dominators do not converge");
            }
            while (*cx.blocks.add(x as usize)).order > (*cx.blocks.add(y as usize)).order {
                x = (*cx.blocks.add(x as usize)).idom;
            }
            while (*cx.blocks.add(y as usize)).order > (*cx.blocks.add(x as usize)).order {
                y = (*cx.blocks.add(y as usize)).idom;
            }
        }
        x
    }
}

// BLOCKS[b].idom for every reachable block (the entry is its own); also
// lays out the blocks (BLOCKS[b].order, ORDER) in reverse post-order.
pub fn compute_dominators(cx: &mut FnCtx, fi: i64) {
    unsafe {
        layout_order(cx, fi);
        for i in 0..cx.order.count {
            { let at_ix = (*cx.order.data.add(i as usize)) as usize; (*cx.blocks.add(at_ix)).idom = 0 };
        }
        let entry = (*get_irfuncs().add(fi as usize)).entry;
        (*cx.blocks.add(entry as usize)).idom = entry;
        let mut changed = true;
        while changed {
            changed = false;
            for i in 1..cx.order.count {
                let b = (*cx.order.data.add(i as usize));
                let mut new_idom: i64 = 0;
                for k in 0..(*cx.blocks.add(b as usize)).preds.count {
                    let p = (*(*cx.blocks.add(b as usize)).preds.data.add(k as usize));
                    if (*cx.blocks.add(p as usize)).order < 0 || (*cx.blocks.add(p as usize)).idom == 0 {
                        continue;
                    }
                    new_idom = if new_idom == 0 { p } else { intersect(cx, p, new_idom) };
                }
                if new_idom != (*cx.blocks.add(b as usize)).idom {
                    (*cx.blocks.add(b as usize)).idom = new_idom;
                    changed = true;
                }
            }
        }
    }
}

// Whether block a dominates block b (both reachable).
pub fn dominates(cx: &mut FnCtx, a: i64, b: i64) -> bool {
    let mut x = b;
    loop {
        if x == a {
            return true;
        }
        let up = unsafe { (*cx.blocks.add(x as usize)).idom };
        if up == x || up == 0 {
            return false;
        }
        x = up;
    }
}

// ---- CFG simplification ----

// Whether blocks x and y (two of them) hold nothing and jump to one block,
// whose phis take the same value from both.
fn same_forward(cx: &mut FnCtx, x: i64, y: i64) -> bool {
    unsafe {
        if x == y || (*cx.blocks.add(x as usize)).first != 0 || (*cx.blocks.add(y as usize)).first != 0
            || (*cx.blocks.add(x as usize)).term != Term::Jump || (*cx.blocks.add(y as usize)).term != Term::Jump
            || (*cx.blocks.add(x as usize)).s0 != (*cx.blocks.add(y as usize)).s0
            || (*cx.blocks.add(x as usize)).preds.count != 1 || (*cx.blocks.add(y as usize)).preds.count != 1 {
            return false;
        }
        let t = (*cx.blocks.add(x as usize)).s0;
        let ix = pred_index(cx, t, x);
        let iy = pred_index(cx, t, y);
        let mut phi = (*cx.blocks.add(t as usize)).first;
        while phi != 0 && (*cx.insts.add(phi as usize)).op == Op::Phi {
            let ir_arg_v = ir_arg(cx, phi, ix);
            let ir_val_v = ir_val(cx, ir_arg_v);
            let ir_arg_v1 = ir_arg(cx, phi, iy);
            let ir_val_v1 = ir_val(cx, ir_arg_v1);
            if ir_val_v != ir_val_v1 {
                return false;
            }
            phi = (*cx.insts.add(phi as usize)).next;
        }
        true
    }
}

// Merges blocks into their only predecessor when it has no other
// successor, and threads jumps through empty blocks. Returns whether
// anything changed.
pub fn simplify_cfg(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut changed = false;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            // A branch with both edges to one block is a jump.
            if (*cx.blocks.add(b as usize)).term == Term::Branch && (*cx.blocks.add(b as usize)).s0 == (*cx.blocks.add(b as usize)).s1 {
                let s = (*cx.blocks.add(b as usize)).s0;
                remove_pred(cx, s, b);
                (*cx.blocks.add(b as usize)).term = Term::Jump;
                (*cx.blocks.add(b as usize)).cond = 0;
                (*cx.blocks.add(b as usize)).s1 = 0;
                changed = true;
            }
            // A branch on a constant is a jump.
            if (*cx.blocks.add(b as usize)).term == Term::Branch && (*cx.insts.add((*cx.blocks.add(b as usize)).cond as usize)).op == Op::Const {
                let taken = if (*cx.insts.add((*cx.blocks.add(b as usize)).cond as usize)).imm != 0 { (*cx.blocks.add(b as usize)).s0 }
                    else { (*cx.blocks.add(b as usize)).s1 };
                let dropped = if taken == (*cx.blocks.add(b as usize)).s0 { (*cx.blocks.add(b as usize)).s1 }
                    else { (*cx.blocks.add(b as usize)).s0 };
                remove_pred(cx, dropped, b);
                (*cx.blocks.add(b as usize)).term = Term::Jump;
                (*cx.blocks.add(b as usize)).cond = 0;
                (*cx.blocks.add(b as usize)).s0 = taken;
                (*cx.blocks.add(b as usize)).s1 = 0;
                changed = true;
            }
            // (0.14) So is a branch to two empty blocks that go on to one
            // block, where its phis take the same value from both (what a
            // threaded comparison of -1, 0 and 1 leaves).
            if (*cx.blocks.add(b as usize)).term == Term::Branch
                && same_forward(cx, (*cx.blocks.add(b as usize)).s0, (*cx.blocks.add(b as usize)).s1) {
                let dropped = (*cx.blocks.add(b as usize)).s1;
                remove_pred(cx, dropped, b);
                (*cx.blocks.add(b as usize)).term = Term::Jump;
                (*cx.blocks.add(b as usize)).cond = 0;
                (*cx.blocks.add(b as usize)).s1 = 0;
                changed = true;
            }
            // So is a switch on a constant, or with one successor.
            if (*cx.blocks.add(b as usize)).term == Term::Switch
                && ((*cx.insts.add((*cx.blocks.add(b as usize)).cond as usize)).op == Op::Const || (*cx.blocks.add(b as usize)).nsucc == 1) {
                let taken = if (*cx.blocks.add(b as usize)).nsucc == 1 { (*cx.blocks.add(b as usize)).s0 }
                    else { switch_target(cx, b, (*cx.insts.add((*cx.blocks.add(b as usize)).cond as usize)).imm) };
                switch_to_jump(cx, b, taken);
                changed = true;
            }
        }
        if changed {
            remove_unreachable(cx, fi);
        }
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            if merge_into_pred(cx, fi, b) || thread_jump(cx, fi, b) {
                changed = true;
            }
        }
        if changed {
            resolve_all(cx, fi);
            remove_trivial_phis(cx, fi, pcx);
        }
        changed
    }
}

// Turns switch b into a jump to `taken` (one of its successors).
pub fn switch_to_jump(cx: &mut FnCtx, b: i64, taken: i64) {
    unsafe {
        for i in 0..(*cx.blocks.add(b as usize)).nsucc {
            let s = succ(cx, b, i);
            if s != taken {
                remove_pred(cx, s, b);
            }
        }
        (*cx.blocks.add(b as usize)).term = Term::Jump;
        (*cx.blocks.add(b as usize)).cond = 0;
        (*cx.blocks.add(b as usize)).s0 = taken;
        (*cx.blocks.add(b as usize)).s1 = 0;
    }
}

// Block b has one predecessor p, which jumps to it: move b's instructions
// to the end of p.
fn merge_into_pred(cx: &mut FnCtx, fi: i64, b: i64) -> bool {
    unsafe {
        if (*cx.blocks.add(b as usize)).preds.count != 1 || b == (*get_irfuncs().add(fi as usize)).entry {
            return false;
        }
        let p = (*(*cx.blocks.add(b as usize)).preds.data.add(0));
        if p == b || (*cx.blocks.add(p as usize)).term != Term::Jump {
            return false;
        }
        // Phis of a block with one predecessor are that operand.
        let mut v = (*cx.blocks.add(b as usize)).first;
        while v != 0 && (*cx.insts.add(v as usize)).op == Op::Phi {
            let next = (*cx.insts.add(v as usize)).next;
            let ir_arg_v = ir_arg(cx, v, 0);
            let ir_val_v = ir_val(cx, ir_arg_v);
            ir_replace(cx, v, ir_val_v);
            v = next;
        }
        v = (*cx.blocks.add(b as usize)).first;
        while v != 0 {
            let next = (*cx.insts.add(v as usize)).next;
            ir_unlink(cx, v);
            ir_append(cx, p, v);
            v = next;
        }
        copy_terminator(cx, p, b);
        for i in 0..succ_count(cx, b) {
            let s = succ(cx, b, i);
            let index = pred_index(cx, s, b);
            (*(*cx.blocks.add(s as usize)).preds.data.add(index as usize)) = p;
        }
        (*cx.blocks.add(b as usize)).term = Term::None;
        (*cx.blocks.add(b as usize)).removed = 1;
        (*cx.blocks.add(b as usize)).preds.count = 0;
        true
    }
}

// Block b is empty (no instructions) and jumps to s: its predecessors can
// go to s directly, when s has no phis.
fn thread_jump(cx: &mut FnCtx, fi: i64, b: i64) -> bool {
    unsafe {
        if (*cx.blocks.add(b as usize)).first != 0 || (*cx.blocks.add(b as usize)).term != Term::Jump || b == (*get_irfuncs().add(fi as usize)).entry {
            return false;
        }
        let s = (*cx.blocks.add(b as usize)).s0;
        if s == b {
            return false;
        }
        let first = (*cx.blocks.add(s as usize)).first;
        if first != 0 && (*cx.insts.add(first as usize)).op == Op::Phi {
            return false;
        }
        if (*cx.blocks.add(b as usize)).preds.count == 0 {
            return false;
        }
        for i in 0..(*cx.blocks.add(b as usize)).preds.count {
            let p = (*(*cx.blocks.add(b as usize)).preds.data.add(i as usize));
            if (*cx.blocks.add(p as usize)).term == Term::Switch && is_succ(cx, p, s) {
                return false;
            }
        }
        for i in 0..(*cx.blocks.add(b as usize)).preds.count {
            let p = (*(*cx.blocks.add(b as usize)).preds.data.add(i as usize));
            redirect_succ(cx, p, b, s);
            (*cx.blocks.add(s as usize)).preds.push(p);
        }
        remove_pred(cx, s, b);
        (*cx.blocks.add(b as usize)).term = Term::None;
        (*cx.blocks.add(b as usize)).removed = 1;
        (*cx.blocks.add(b as usize)).preds.count = 0;
        true
    }
}

// ---- Dead code elimination ----

// Removes the instructions whose values are not used, transitively (mark
// and sweep from the instructions with side effects and the terminators).
pub fn eliminate_dead_code(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut work = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                (*cx.insts.add(v as usize)).mark = 0;
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                if has_effect(cx, v, pcx) {
                    mark_live(cx, v, &mut work);
                }
                v = (*cx.insts.add(v as usize)).next;
            }
            if (*cx.blocks.add(b as usize)).cond != 0 {
                mark_live(cx, (*cx.blocks.add(b as usize)).cond, &mut work);
            }
        }
        while work.count > 0 {
            let v = work.pop();
            for k in 0..ir_operand_count(cx, v) {
                let operand = ir_operand(cx, v, k);
                if operand != 0 {
                    mark_live(cx, operand, &mut work);
                }
            }
        }
        free(work.data as *mut u8);
        let mut changed = false;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let next = (*cx.insts.add(v as usize)).next;
                if (*cx.insts.add(v as usize)).mark == 0 {
                    ir_unlink(cx, v);
                    changed = true;
                }
                v = next;
            }
        }
        changed
    }
}

fn mark_live(cx: &mut FnCtx, v: i64, work: &mut IntVec) {
    unsafe {
        if (*cx.insts.add(v as usize)).mark == 0 {
            (*cx.insts.add(v as usize)).mark = 1;
            work.push(v);
        }
    }
}

// ---- The pipeline ----

// Cleanup that every IR function gets before code generation.
pub fn cleanup_function(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    resolve_all(cx, fi);
    remove_unreachable(cx, fi);
    remove_trivial_phis(cx, fi, pcx);
    resolve_all(cx, fi);
    verify_func(cx, fi, c"lowering, inlining and cleanup", pcx);
}

// (0.17) The -O1 pipeline of one function (PER_FUNCTION), after the
// program's leaves (simplify_inlining_leaves): the small leaves' calls
// inlined, the scalar pipeline.
pub fn optimize_function(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    optimize_with_leaves(cx, fi, pcx);
}

// After inlining into fi: the cleanup and the scalar pipeline.
pub fn optimize_after_inlining(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    cleanup_function(cx, fi, pcx);
    simplify_function(cx, fi, pcx);
}

// The scalar pipeline (-O1), twice: constants, peepholes, control flow,
// value numbering, dead code.
pub fn simplify_function(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    for round in 0..2 {
        sccp(cx, fi, pcx);
        verify_func(cx, fi, c"sccp", pcx);
        instcombine(cx, fi, pcx);
        verify_func(cx, fi, c"instcombine", pcx);
        if round == 0 && elide_copies(cx, fi, pcx) {
            verify_func(cx, fi, c"copy elision", pcx);
        }
        if round == 0 && run_sroa(cx, fi, pcx) {
            verify_func(cx, fi, c"sroa", pcx);
        }
        if round == 0 && promote_constant_slots(cx, fi, pcx) {
            verify_func(cx, fi, c"constant slots", pcx);
        }
        simplify_cfg(cx, fi, pcx);
        verify_func(cx, fi, c"simplify_cfg", pcx);
        run_gvn(cx, fi, pcx);
        verify_func(cx, fi, c"gvn", pcx);
        eliminate_dead_code(cx, fi, pcx);
        verify_func(cx, fi, c"dead code elimination", pcx);
        simplify_cfg(cx, fi, pcx);
        verify_func(cx, fi, c"simplify_cfg", pcx);
        if round == 0 && thread_tags(cx, fi, pcx) {
            verify_func(cx, fi, c"threading on tags", pcx);
        }
    }
    remove_trivial_phis(cx, fi, pcx);
}

pub fn optimize_program(cx: &mut FnCtx, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.fn_live = alloc_array::<i64>(pcx.irfunc_count + 1);
        for fi in 0..pcx.irfunc_count {
            (*pcx.fn_live.add(fi as usize)) = 1;
        }
        // (0.18.1) No entry facts in a function an indirect call may enter.
        strip_taken(cx, pcx);
        drop_unreachable_std(cx, pcx);
        // (0.18.1) The code cache (back::codecache).
        cc_begin(pcx);
        // (0.18.1) The tasks' threads (middle::parallel), and each function's
        // cleanup on them.
        parallel_begin(cx, pcx);
        cleanup_all(cx, pcx);
        phase_time(c"cleanup", pcx);
        if pcx.opt_level == 0 {
            return;
        }
        let mut t = timer_now(pcx);
        // (0.17) -O1: small leaf functions inlined (inline.vl)
        if pcx.opt_level == 1 {
            simplify_inlining_leaves(cx, pcx);
            timer_add(T_SCALAR, t, pcx);
            phase_time(c"small leaves", pcx);
            return;
        }
        simplify_all(cx, pcx);
        timer_add(T_SCALAR, t, pcx);
        phase_time(c"scalar pipeline", pcx);
        if pcx.opt_level < 2 {
            return;
        }
        t = timer_now(pcx);
        // -O2: interprocedural constants, then bottom-up over the call graph's
        // components: tail recursion, inlining, the loop passes, scalar
        // promotion and loop-invariant code motion, and each component's
        // attributes (docs/optimizer.md, 0.6).
        pcx.fn_scc = alloc_array::<i64>(pcx.irfunc_count + 1);
        set_fn_size(alloc_array::<i64>(pcx.irfunc_count + 1));
        pcx.fn_calls = alloc_array::<i64>(pcx.irfunc_count + 1);
        pcx.fn_address = alloc_array::<i64>(pcx.irfunc_count + 1);
        init_fn_caches(pcx);
        init_attrs(pcx);
        count_call_sites(cx, pcx);
        // The functions whose address the program takes stay in it, even when
        // every call through the address is made direct (see
        // remove_dead_functions).
        pcx.fn_taken = alloc_array::<i64>(pcx.irfunc_count + 1);
        set_deferred(alloc_array::<i64>(pcx.irfunc_count + 1));
        for fi in 0..pcx.irfunc_count {
            (*pcx.fn_taken.add(fi as usize)) = (*pcx.fn_address.add(fi as usize));
        }
        compute_sccs(cx, pcx);
        propagate_constants(cx, pcx);
        for fi in 0..pcx.irfunc_count {
            ir_enter(cx, fi, pcx);
            (*get_fn_size().add(fi as usize)) = func_size(cx, fi);
        }
        start_inlining_budget(pcx);
        timer_add(T_IPCP, t, pcx);
        phase_time(c"interprocedural constants, components", pcx);
        // (0.18.1: each component once the components it calls are done,
        // middle::parallel; one thread takes them in SCC_ORDER, as 0.17 did)
        optimize_components(cx, pcx);
        phase_time(c"components, bottom up", pcx);
        t = timer_now(pcx);
        remove_dead_functions(cx, pcx);
        timer_add(T_GLOBAL_DCE, t, pcx);
        phase_time(c"dead functions", pcx);
        // The functions whose loop passes waited for their callers, and that
        // are still called somewhere, then SLP (finish_function): when each
        // is emitted (0.18.1), or here for the IR printers.
        if pcx.emit_ir || pcx.emit_mir {
            for fi in 0..pcx.irfunc_count {
                deferred_loops(cx, fi, pcx);
            }
            for fi in 0..pcx.irfunc_count {
                slp_function(cx, fi, pcx);
            }
        }
        if pcx.print_attrs {
            print_attrs(pcx);
        }
    }
}

// (0.18.1) The bottom-up pipeline of function fi, of its component's task
// (middle::parallel): tail recursion, inlining, heap to stack, the loop
// passes (or not yet, DEFERRED), its size.
pub fn optimize_component_function(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        let mut t = timer_now(pcx);
        if eliminate_tail_recursion(cx, fi, pcx) {
            cleanup_function(cx, fi, pcx);
            simplify_function(cx, fi, pcx);
        }
        timer_add(T_TRE, t, pcx);
        t = timer_now(pcx);
        inline_rounds(cx, fi, pcx);
        // (0.18.1) the checks of its requires, inlined at its entry, as facts
        entry_assumes(cx, fi, pcx);
        timer_add(T_INLINE, t, pcx);
        t = timer_now(pcx);
        if heap_to_stack(cx, fi, pcx) {
            simplify_function(cx, fi, pcx);
        } else if repeated_pure_calls(cx, fi, pcx) {
            // (0.16: merged now that the callees' attributes are known)
            run_gvn(cx, fi, pcx);
            eliminate_dead_code(cx, fi, pcx);
        }
        timer_add(T_HEAP, t, pcx);
        if inlined_everywhere(fi, pcx) {
            (*get_deferred().add(fi as usize)) = 1;
        } else {
            loop_pipeline(cx, fi, pcx);
        }
        t = timer_now(pcx);
        (*get_fn_size().add(fi as usize)) = func_size(cx, fi);
        ir_shrink(cx);
        // (asked before, through a call made direct, it is asked again)
        forget_fn_caches(fi);
        timer_add(T_ATTRS, t, pcx);
    }
}

// (0.18.1) -O2: function fi's loop passes, when they waited for its
// callers (DEFERRED) and it is still called.
pub fn deferred_loops(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if (*get_deferred().add(fi as usize)) != 0 && (*pcx.fn_live.add(fi as usize)) != 0 {
            ir_enter(cx, fi, pcx);
            loop_pipeline(cx, fi, pcx);
        }
    }
}

// (0.18.1) -O2: function fi's SLP vectorization (0.11: last, on the code
// as it will be emitted: stores packed earlier would hide their values
// from the loads of the functions they are inlined into).
pub fn slp_function(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let t = timer_now(pcx);
        // (0.18.1) the facts of entry_assumes gone before the code is made
        if (*pcx.fn_live.add(fi as usize)) != 0 {
            ir_enter(cx, fi, pcx);
            drop_assumes(cx, fi, pcx);
        }
        if (*pcx.fn_live.add(fi as usize)) != 0 && slp_vectorize(cx, fi, pcx) {
            ir_enter(cx, fi, pcx);
            resolve_all(cx, fi);
            eliminate_dead_code(cx, fi, pcx);
            verify_func(cx, fi, c"SLP vectorization", pcx);
        }
        timer_add(T_SLP, t, pcx);
    }
}

// Functions whose loop passes wait until inlining is done (see
// inlined_everywhere).
static mut DEFERRED: *mut i64 = 0 as *mut i64;

// The loop passes, LICM and scalar promotion of function fi, each followed
// by the scalar pipeline when it changed something.
fn loop_pipeline(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    let mut t = timer_now(pcx);
    if optimize_loops(cx, fi, pcx) {
        simplify_function(cx, fi, pcx);
    }
    timer_add(T_LOOPS, t, pcx);
    t = timer_now(pcx);
    if run_licm(cx, fi, pcx) {
        resolve_all(cx, fi);
        verify_func(cx, fi, c"licm", pcx);
        simplify_function(cx, fi, pcx);
    }
    timer_add(T_LICM, t, pcx);
    // After LICM: the addresses of slots and statics are out of the
    // loops by then.
    t = timer_now(pcx);
    if promote_loop_memory(cx, fi, pcx) {
        simplify_function(cx, fi, pcx);
    }
    timer_add(T_PROMOTE, t, pcx);
}

// -O2's loop passes (loops.vl and the files after it), before LICM.
// Returns whether anything changed.
fn optimize_loops(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    ir_enter(cx, fi, pcx);
    resolve_all(cx, fi);
    seal_all(cx, fi);
    simplify_cfg(cx, fi, pcx);
    // Between the passes a light cleanup only; the scalar pipeline runs
    // once after them (in optimize_program).
    let mut changed = false;
    if count_loop_exits(cx, fi, pcx) {
        changed = true;
        light_cleanup(cx, fi, pcx);
    }
    if rotate_loops(cx, fi, pcx) {
        changed = true;
        light_cleanup(cx, fi, pcx);
    }
    if transform_loops(cx, fi, pcx) {
        changed = true;
        light_cleanup(cx, fi, pcx);
    }
    if fold_by_ranges(cx, fi, pcx) {
        changed = true;
        light_cleanup(cx, fi, pcx);
    }
    // (0.15: small branches in innermost loops, selects for the
    // vectorizer and the unroller)
    // (0.16: again while it converts, a few times: a branch whose arms
    // were converted may be a diamond itself then, the tree of an
    // inlined comparator's `<`)
    let mut rounds: i64 = 0;
    while rounds < 4 && if_convert_loops(cx, fi, pcx) {
        changed = true;
        light_cleanup(cx, fi, pcx);
        rounds += 1;
    }
    // (0.10: after the checks the ranges remove, before strength
    // reduction rewrites the addresses)
    let vectorized = vectorize_loops(cx, fi, pcx);
    if vectorized {
        changed = true;
        light_cleanup(cx, fi, pcx);
    }
    // (0.11: the loops the vectorizer left to be unrolled whole, which
    // their checks kept transform_loops from before the ranges)
    let mut unrolled = false;
    if cx.unroll_whole {
        unrolled = transform_loops(cx, fi, pcx);
        // (and the LCSSA phis of the loops it left)
        resolve_all(cx, fi);
        remove_trivial_phis(cx, fi, pcx);
        changed = true;
        light_cleanup(cx, fi, pcx);
    }
    // (0.11: the loops the vectorizer left, in its frame; the loop forest
    // it found is current when it changed nothing)
    if unroll_runtime_loops(cx, fi, !vectorized && !unrolled && pcx.vectorize, pcx) {
        changed = true;
        light_cleanup(cx, fi, pcx);
    }
    if reduce_and_unswitch(cx, fi, pcx) {
        changed = true;
    }
    if aggressive_dce(cx, fi, pcx) {
        changed = true;
        verify_func(cx, fi, c"aggressive dead code elimination", pcx);
    }
    if changed {
        resolve_all(cx, fi);
        verify_func(cx, fi, c"loop passes", pcx);
    }
    changed
}

// Unused values and trivial control flow, between the loop passes.
fn light_cleanup(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    resolve_all(cx, fi);
    eliminate_dead_code(cx, fi, pcx);
    simplify_cfg(cx, fi, pcx);
    remove_trivial_phis(cx, fi, pcx);
    seal_all(cx, fi);
    verify_func(cx, fi, c"cleanup", pcx);
}

// Global dead code elimination: functions nobody calls or takes the
// address of (other than main and the extern "C" definitions) are not
// emitted, transitively. A function whose address the program took is
// kept even when every call through it was made direct and inlined: a
// function used as a value is part of what the program is (and of what
// the tests look at).
fn remove_dead_functions(cx: &mut FnCtx, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut changed = true;
        while changed {
            changed = false;
            count_call_sites(cx, pcx);
            for fi in 0..pcx.irfunc_count {
                if (*pcx.fn_live.add(fi as usize)) != 0 && (*pcx.fn_calls.add(fi as usize)) == 0 && (*pcx.fn_address.add(fi as usize)) == 0
                    && (*pcx.fn_taken.add(fi as usize)) == 0 && !fn_is_global((*get_irfuncs().add(fi as usize)).f, pcx) {
                    (*pcx.fn_live.add(fi as usize)) = 0;
                    changed = true;
                }
            }
        }
    }
}

// (0.14) std's functions the program cannot reach are not optimized or
// emitted, at every level: std grew with 0.14 (iterators, sort_by, input),
// and its non-generic functions, all lowered, cost most of the time of
// compiling a small program. The roots are every function not from std
// (a program's own unused functions stay, as before); a std function is
// reachable when a reachable function calls it or takes its address.
fn drop_unreachable_std(cx: &mut FnCtx, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.std_module < 0 {
            return;
        }
        let reach = alloc_array::<i64>(pcx.irfunc_count + 1);
        let mut work = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for fi in 0..pcx.irfunc_count {
            (*reach.add(fi as usize)) = 0;
            let f = (*get_irfuncs().add(fi as usize)).f;
            if fn_is_global(f, pcx) || !within_std(module_of(pcx.fns[f as usize].node, pcx), pcx) {
                (*reach.add(fi as usize)) = 1;
                work.push(fi);
            }
        }
        while work.count > 0 {
            work.count -= 1;
            let fi = (*work.data.add(work.count as usize));
            ir_enter(cx, fi, pcx);
            for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
                let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
                if (*cx.blocks.add(b as usize)).removed != 0 {
                    continue;
                }
                let mut v = (*cx.blocks.add(b as usize)).first;
                while v != 0 {
                    let mut g = ir_callee(cx, v, pcx);
                    if (*cx.insts.add(v as usize)).op == Op::FAddr && (*pcx.fn_ir.add((*cx.insts.add(v as usize)).imm as usize)) != 0 {
                        g = (*pcx.fn_ir.add((*cx.insts.add(v as usize)).imm as usize)) - 1;
                    }
                    if g >= 0 && (*reach.add(g as usize)) == 0 {
                        (*reach.add(g as usize)) = 1;
                        work.push(g);
                    }
                    v = (*cx.insts.add(v as usize)).next;
                }
            }
        }
        for fi in 0..pcx.irfunc_count {
            if (*reach.add(fi as usize)) == 0 {
                (*pcx.fn_live.add(fi as usize)) = 0;
            }
        }
        free(work.data as *mut u8);
        free(reach as *mut u8);
    }
}

// (0.28.0) DEFERRED's accessors: every use of it is one of them.
pub fn get_deferred() -> *mut i64 {
    // UNSAFE: the per-function deferred-loops flag, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: allocated by optimize_program on the main thread; entry fi
    // written only by fi's component task (optimize_component_function,
    // get_facts) and read by fi's own emission task (deferred_loops) in a
    // later phase and by fi's own codecache records (own_fp, put_facts);
    // one task per function per phase, phases ordered by MUTEX
    unsafe { DEFERRED }
}

pub fn set_deferred(v: *mut i64) {
    // UNSAFE: the per-function deferred-loops flag, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: allocated by optimize_program on the main thread; entry fi
    // written only by fi's component task (optimize_component_function,
    // get_facts) and read by fi's own emission task (deferred_loops) in a
    // later phase and by fi's own codecache records (own_fp, put_facts);
    // one task per function per phase, phases ordered by MUTEX
    unsafe {
        DEFERRED = v;
    }
}
