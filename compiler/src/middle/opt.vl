    T_ATTRS, T_GLOBAL_DCE, T_HEAP, T_INLINE, T_IPCP, T_LICM, T_LOOPS, T_PROMOTE, T_SCALAR, T_SLP,
    T_TRE, timer_add, timer_now,
};
use crate::front::modules::{module_of, within_std};
use crate::gen0::gen::fn_is_global;
use crate::middle::adce::aggressive_dce;
use crate::middle::copies::elide_copies;
use crate::middle::ctx::FnCtx;
use crate::middle::entryfacts::{drop_assumes, entry_assumes, strip_taken};
use crate::middle::exits::count_loop_exits;
use crate::middle::fold::instcombine;
use crate::middle::fold::lattice::sccp;
use crate::middle::gvn::run_gvn;
use crate::middle::gvn_calls::repeated_pure_calls;
