// Loop strength reduction and loop unswitching (0.4).
//
// Strength reduction: in an innermost loop, the address of a load or a
// store that is an affine function of an induction variable i (64-bit
// arithmetic: k + s*i + c1*b1 + c2*b2, with b1 and b2 loop-invariant) and
// costs a multiplication or a shift becomes a pointer induction variable:
// a new header phi starting at the address for the first iteration and
// advancing by s*step at the latch. Addresses that differ by a constant
// share one pointer (the difference folds into the access's offset). All
// of it is arithmetic modulo 2^64, as the addresses were.
//
// Unswitching: a branch inside a small innermost loop on a condition
// defined outside it: the loop is cloned, the preheader branches on the
// condition to the original (where the branch is now always taken one way)
// or the copy (the other way).

use crate::base::{IntVec, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_BOOL, TY_U64, int_bits, is_integer};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::{const_before, is_const, op_before};
use crate::middle::ir::{
    Term, get_irfuncs, ir_append, ir_arg, ir_enter, ir_make, ir_prepend, ir_set_arg, ir_val,
};
use crate::middle::ir::Op::{Add, Const, Conv, Load, Mul, Phi, Shl, Store, Sub};
use crate::middle::ir::cfg::pred_index;
use crate::middle::ir::verify::verify_func;
use crate::middle::loops::{
    add_pred_values, canonicalize_loops, clone_map, clone_region, form_lcssa, innermost_loop,
    invariant_in, is_canonical, is_innermost, loop_block, loop_count, loop_exits, loop_header,
    loop_inst_count, loop_latch, loop_preheader, loop_size, mark_loop_blocks,
};
use crate::middle::opt::{resolve_all, simplify_cfg};
use crate::middle::scev::{append_const, append_inst, iv_start, iv_step};

const LSR_MAX_POINTERS: i64 = 4;
const UNSWITCH_MAX_SIZE: i64 = 48;

// An affine form: AF[0] = k, AF[1] = s, then the terms (b1, c1), (b2, c2)
// (b = 0: none), then (v, m): the value is k + c1*b1 + c2*b2 + (s + m*v)*i
// (v invariant: a stride known at run time only).
const AF_SIZE: i64 = 8;

fn af_set(af: *mut i64, k: i64, s: i64, b1: i64, c1: i64, b2: i64, c2: i64) {
    unsafe {
        (*af.add(0)) = k;
        (*af.add(1)) = s;
        (*af.add(2)) = b1;
        (*af.add(3)) = c1;
        (*af.add(4)) = b2;
        (*af.add(5)) = c2;
        (*af.add(6)) = 0;
        (*af.add(7)) = 0;
    }
}

// Adds term (b, c) to af; false when there is no room.
fn af_add_term(af: *mut i64, b: i64, c: i64) -> bool {
    unsafe {
        if b == 0 || c == 0 {
            return true;
        }
        if (*af.add(2)) == b {
            (*af.add(3)) = (*af.add(3)) + c;
            return true;
        }
        if (*af.add(4)) == b {
            (*af.add(5)) = (*af.add(5)) + c;
            return true;
        }
        if (*af.add(2)) == 0 || (*af.add(3)) == 0 {
            (*af.add(2)) = b;
            (*af.add(3)) = c;
            return true;
        }
        if (*af.add(4)) == 0 || (*af.add(5)) == 0 {
            (*af.add(4)) = b;
            (*af.add(5)) = c;
            return true;
        }
        false
    }
}

// af = x + m * y.
fn af_combine(af: *mut i64, x: *mut i64, y: *mut i64, m: i64) -> bool {
    unsafe {
        af_set(&mut *af, (*x.add(0)) + m * (*y.add(0)), (*x.add(1)) + m * (*y.add(1)), (*x.add(2)),
            (*x.add(3)), (*x.add(4)), (*x.add(5)));
        if (*x.add(7)) != 0 && (*y.add(7)) != 0 && (*x.add(6)) != (*y.add(6)) {
            return false;
        }
        (*af.add(6)) = if (*x.add(7)) != 0 { (*x.add(6)) } else { (*y.add(6)) };
        (*af.add(7)) = (*x.add(7)) + m * (*y.add(7));
        af_add_term(af, (*y.add(2)), m * (*y.add(3)))
            && af_add_term(af, (*y.add(4)), m * (*y.add(5)))
    }
}

fn af_scale(af: *mut i64, m: i64) {
    unsafe {
        (*af.add(0)) = (*af.add(0)) * m;
        (*af.add(1)) = (*af.add(1)) * m;
        (*af.add(3)) = (*af.add(3)) * m;
        (*af.add(5)) = (*af.add(5)) * m;
        (*af.add(7)) = (*af.add(7)) * m;
    }
}

// The affine form of v in loop l over induction variable iv; *cost counts
// the multiplications and shifts in it. False when it is not affine.
fn affine_of(cx: &mut FnCtx<Comp>, l: i64, iv: i64, v: i64, af: *mut i64, cost: &mut i64,
    depth: i64) -> bool {
    unsafe {
        let x = ir_val(cx, v);
        if x == iv {
            af_set(&mut *af, 0, 1, 0, 0, 0, 0);
            return true;
        }
        let ty = (*cx.insts.add(x as usize)).ty;
        if !is_integer(ty) || int_bits(ty) != 64 || depth > 8 {
            return false;
        }
        if is_const(cx, x) {
            af_set(&mut *af, (*cx.insts.add(x as usize)).imm, 0, 0, 0, 0, 0);
            return true;
        }
        if invariant_in(cx, l, x) {
            af_set(&mut *af, 0, 0, x, 1, 0, 0);
            return true;
        }
        let op = (*cx.insts.add(x as usize)).op;
        let mut fa: [i64; 8] = [0i64; 8];
        let mut fb: [i64; 8] = [0i64; 8];
        if op == Add || op == Sub {
            if !affine_of(cx, l, iv, (*cx.insts.add(x as usize)).a, &mut fa[0], cost, depth + 1)
                || !affine_of(cx, l, iv, (*cx.insts.add(x as usize)).b, &mut fb[0], cost, depth + 1) {
                return false;
            }
            return af_combine(af, &mut fa[0], &mut fb[0], if op == Add { 1 } else { -1 });
        }
        if op == Mul || op == Shl {
            let b = ir_val(cx, (*cx.insts.add(x as usize)).b);
            let a = ir_val(cx, (*cx.insts.add(x as usize)).a);
            let mut m: i64 = 0;
            let mut operand = a;
            if op == Shl && is_const(cx, b) {
                let k = (*cx.insts.add(b as usize)).imm & 63;
                m = 1 << k as u64;
            } else if op == Mul && is_const(cx, b) {
                m = (*cx.insts.add(b as usize)).imm;
            } else if op == Mul && is_const(cx, a) {
                m = (*cx.insts.add(a as usize)).imm;
                operand = b;
            } else if op == Mul && (invariant_in(cx, l, b) || invariant_in(cx, l, a)) {
                // By a stride known at run time: the operand must be k + s*i.
                let stride = if invariant_in(cx, l, b) { b } else { a };
                let other = if stride == b { a } else { b };
                if !affine_of(cx, l, iv, other, af, cost, depth + 1) || (*af.add(2)) != 0
                    || (*af.add(4)) != 0
                    || (*af.add(7)) != 0 {
                    return false;
                }
                let k = (*af.add(0));
                let sc = (*af.add(1));
                af_set(&mut *af, 0, 0, stride, k, 0, 0);
                (*af.add(6)) = stride;
                (*af.add(7)) = sc;
                *cost = *cost + 1;
                return true;
            } else {
                return false;
            }
            if !affine_of(cx, l, iv, operand, af, cost, depth + 1) {
                return false;
            }
            af_scale(af, m);
            *cost = *cost + 1;
            return true;
        }
        if op == Conv && is_integer((*cx.insts.add(x as usize)).imm2)
            && int_bits((*cx.insts.add(x as usize)).imm2) == 64 {
            return affine_of(cx, l, iv, (*cx.insts.add(x as usize)).a, af, cost, depth + 1);
        }
        false
    }
}

// Appends c1*b1 + c2*b2 + k (as u64) to block b; returns the value.
fn materialize_affine(cx: &mut FnCtx<Comp>, b: i64, af: *mut i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut value = append_const(cx, b, k, TY_U64, pcx);
        for t in 0..2 {
            let base = (*af.add((2 + 2 * t) as usize));
            let c = (*af.add((3 + 2 * t) as usize));
            if base == 0 || c == 0 {
                continue;
            }
            let mut term = base;
            if c != 1 {
                let append_const_v = append_const(cx, b, c, TY_U64, pcx);
                term = append_inst(cx, b, Mul, TY_U64, base, append_const_v,
                    pcx);
            }
            value = append_inst(cx, b, Add, TY_U64, value, term, pcx);
        }
        value
    }
}

// Strength reduction of the addresses in innermost loop l.
fn reduce_loop(cx: &mut FnCtx<Comp>, fi: i64, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let pre = loop_preheader(cx, l);
        let latch = loop_latch(cx, l);
        if pre == 0 || latch == 0 || (*cx.blocks.add(h as usize)).preds.count != 2 {
            return false;
        }
        ir_enter(cx, fi, pcx);
        // The induction variable: the first 64-bit header phi with a constant
        // step.
        let mut iv: i64 = 0;
        let mut step: i64 = 0;
        let mut phi = (*cx.blocks.add(h as usize)).first;
        while phi != 0 && (*cx.insts.add(phi as usize)).op == Phi {
            let mut s: i64 = 0;
            if int_bits((*cx.insts.add(phi as usize)).ty) == 64 && iv_step(cx, l, phi, &mut s)
                && s != 0 {
                iv = phi;
                step = s;
                break;
            }
            phi = (*cx.insts.add(phi as usize)).next;
        }
        if iv == 0 {
            return false;
        }
        // Candidates: (access, group, k); groups: their form (6 each).
        let mut cands = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut groups = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..loop_size(cx, l) {
            let mut v = { let at_ix = loop_block(cx, l, i) as usize; (*cx.blocks.add(at_ix)) }.first;
            while v != 0 {
                let op = (*cx.insts.add(v as usize)).op;
                if op == Load || op == Store {
                    let addr = ir_val(cx, (*cx.insts.add(v as usize)).a);
                    let mut af: [i64; 8] = [0i64; 8];
                    let mut cost: i64 = 0;
                    if !invariant_in(cx, l, addr) && addr != iv
                        && affine_of(cx, l, iv, addr, &mut af[0], &mut cost, 0) && cost > 0
                        && (af[1] != 0 || af[7] != 0) {
                        let mut g: i64 = -1;
                        for k in 0..groups.count / AF_SIZE {
                            let mut same = true;
                            for m in 1..AF_SIZE {
                                if (*groups.data.add((AF_SIZE * k + m) as usize))
                                    != af[m as usize] {
                                    same = false;
                                }
                            }
                            if same {
                                g = k;
                            }
                        }
                        if g < 0 && groups.count / AF_SIZE < LSR_MAX_POINTERS {
                            g = groups.count / AF_SIZE;
                            for k in 0..AF_SIZE {
                                groups.push(af[k as usize]);
                            }
                        }
                        if g >= 0 {
                            cands.push(v);
                            cands.push(g);
                            cands.push(af[0]);
                        }
                    }
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        let ngroups = groups.count / AF_SIZE;
        let pre_index = pred_index(cx, h, pre);
        let latch_index = pred_index(cx, h, latch);
        let start = iv_start(cx, l, iv);
        for g in 0..ngroups {
            let af = groups.data.add((AF_SIZE * g) as usize) as *mut i64;
            let s = (*af.add(1));
            // The smallest k of the group is the pointer's.
            let mut k0: i64 = 0;
            let mut first = true;
            for c in 0..cands.count / 3 {
                if (*cands.data.add((3 * c + 1) as usize)) == g
                    && (first || (*cands.data.add((3 * c + 2) as usize)) < k0) {
                    k0 = (*cands.data.add((3 * c + 2) as usize));
                    first = false;
                }
            }
            // Start: the form at the induction variable's start.
            let base = materialize_affine(cx, pre, af, k0, pcx);
            // The coefficient of the induction variable, s + m*v.
            let mut coef = append_const(cx, pre, s, TY_U64, pcx);
            if (*af.add(7)) != 0 {
                let append_const_v = append_const(cx, pre, (*af.add(7)), TY_U64, pcx);
                let sym = append_inst(cx, pre, Mul, TY_U64, (*af.add(6)),
                    append_const_v, pcx);
                coef = append_inst(cx, pre, Add, TY_U64, coef, sym, pcx);
            }
            let scaled = append_inst(cx, pre, Mul, TY_U64, start, coef, pcx);
            let init = append_inst(cx, pre, Add, TY_U64, base, scaled, pcx);
            let append_const_v1 = append_const(cx, pre, step, TY_U64, pcx);
            let stride = append_inst(cx, pre, Mul, TY_U64, coef,
                append_const_v1, pcx);
            let ptr = ir_make(cx, Phi, TY_U64, 0, 0, 0, pcx);
            (*cx.insts.add(ptr as usize)).args = cx.args.count;
            (*cx.insts.add(ptr as usize)).nargs = 2;
            cx.args.push(0);
            cx.argty.push(0);
            cx.args.push(0);
            cx.argty.push(0);
            ir_prepend(cx, h, ptr);
            let next = append_inst(cx, latch, Add, TY_U64, ptr, stride, pcx);
            ir_set_arg(cx, ptr, pre_index, init);
            ir_set_arg(cx, ptr, latch_index, next);
            for c in 0..cands.count / 3 {
                if (*cands.data.add((3 * c + 1) as usize)) != g {
                    continue;
                }
                let v = (*cands.data.add((3 * c) as usize));
                let d = (*cands.data.add((3 * c + 2) as usize)) - k0;
                let mut addr = ptr;
                if d != 0 {
                    let const_before_v = const_before(cx, v, d, TY_U64, pcx);
                    addr = op_before(cx, v, Add, TY_U64, ptr, const_before_v,
                        pcx);
                }
                (*cx.insts.add(v as usize)).a = addr;
            }
        }
        free(cands.data as *mut u8);
        free(groups.data as *mut u8);
        ngroups > 0
    }
}

// ---- Unswitching ----

// Unswitches innermost loop l (canonical, in LCSSA form) on the first
// branch of its blocks on an invariant condition. Returns whether it did.
fn unswitch_loop(cx: &mut FnCtx<Comp>, fi: i64, l: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let h = loop_header(cx, l);
        let pre = loop_preheader(cx, l);
        if pre == 0 || loop_latch(cx, l) == 0 || loop_inst_count(cx, l) > UNSWITCH_MAX_SIZE {
            return false;
        }
        let mut at: i64 = 0;
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            if (*cx.blocks.add(b as usize)).term == Term::Branch
                && (*cx.blocks.add(b as usize)).s0 != (*cx.blocks.add(b as usize)).s1 {
                let c = ir_val(cx, (*cx.blocks.add(b as usize)).cond);
                if !is_const(cx, c) && invariant_in(cx, l, c) {
                    at = b;
                    break;
                }
            }
        }
        if at == 0 {
            return false;
        }
        let c = ir_val(cx, (*cx.blocks.add(at as usize)).cond);
        ir_enter(cx, fi, pcx);
        loop_exits(cx, l);
        let mut exits = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..cx.lp_list.count {
            exits.push((*cx.lp_list.data.add(i as usize)));
        }
        let stamp = mark_loop_blocks(cx, l);
        let mut region = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..cx.lp_list2.count {
            region.push((*cx.lp_list2.data.add(i as usize)));
        }
        clone_region(cx, fi, &mut region, stamp, pcx);
        // The exits get the copy's exiting blocks as predecessors, with the
        // copies of their phis' operands.
        for e in 0..exits.count {
            let x = (*exits.data.add(e as usize));
            let n = (*cx.blocks.add(x as usize)).preds.count;
            for k in 0..n {
                let p = (*(*cx.blocks.add(x as usize)).preds.data.add(k as usize));
                if (*cx.lp_seen.add(p as usize)) != stamp {
                    continue;
                }
                let first = cx.lp_values.count;
                let mut phi = (*cx.blocks.add(x as usize)).first;
                while phi != 0 && (*cx.insts.add(phi as usize)).op == Phi {
                    let ir_arg_v = ir_arg(cx, phi, k);
                    let ir_val_v = ir_val(cx, ir_arg_v);
                    let clone_map_v = clone_map(cx, ir_val_v, stamp);
                    cx.lp_values.push(clone_map_v);
                    phi = (*cx.insts.add(phi as usize)).next;
                }
                add_pred_values(cx, x, (*cx.blocks.add(p as usize)).aux, &mut cx.lp_values, first);
                cx.lp_values.truncate(first);
            }
        }
        // The preheader chooses; each copy's branch is decided.
        let ch = (*cx.blocks.add(h as usize)).aux;
        (*cx.blocks.add(pre as usize)).term = Term::Branch;
        (*cx.blocks.add(pre as usize)).cond = c;
        (*cx.blocks.add(pre as usize)).s0 = h;
        (*cx.blocks.add(pre as usize)).s1 = ch;
        let t = ir_make(cx, Const, TY_BOOL, 0, 0, 1, pcx);
        ir_append(cx, at, t);
        (*cx.blocks.add(at as usize)).cond = t;
        let cat = (*cx.blocks.add(at as usize)).aux;
        let f = ir_make(cx, Const, TY_BOOL, 0, 0, 0, pcx);
        ir_append(cx, cat, f);
        (*cx.blocks.add(cat as usize)).cond = f;
        free(exits.data as *mut u8);
        free(region.data as *mut u8);
        true
    }
}

// Whether small loop l branches on a condition defined outside it.
fn has_invariant_branch(cx: &mut FnCtx<Comp>, l: i64) -> bool {
    unsafe {
        if loop_inst_count(cx, l) > UNSWITCH_MAX_SIZE {
            return false;
        }
        for i in 0..loop_size(cx, l) {
            let b = loop_block(cx, l, i);
            if (*cx.blocks.add(b as usize)).term == Term::Branch
                && (*cx.blocks.add(b as usize)).s0 != (*cx.blocks.add(b as usize)).s1 {
                let c = ir_val(cx, (*cx.blocks.add(b as usize)).cond);
                if !is_const(cx, c) && invariant_in(cx, l, c) {
                    return true;
                }
            }
        }
        false
    }
}

// Strength reduction and unswitching over the innermost loops of fi.
pub fn reduce_and_unswitch(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut changed = false;
        canonicalize_loops(cx, fi, pcx);
        let mut headers = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for l in 0..loop_count(cx) {
            if is_innermost(cx, l)
                && loop_header(cx, l) != (*get_irfuncs().add(fi as usize)).entry {
                headers.push(loop_header(cx, l));
            }
        }
        // Unswitching, one loop at a time (the loops are found again after
        // each), at most 4 per function.
        let mut unswitched: i64 = 0;
        for i in 0..headers.count {
            if unswitched >= 4 {
                break;
            }
            canonicalize_loops(cx, fi, pcx);
            let l = innermost_loop(cx, (*headers.data.add(i as usize)));
            if l < 0 || loop_header(cx, l) != (*headers.data.add(i as usize))
                || !is_canonical(cx, l)
                || !has_invariant_branch(cx, l) {
                continue;
            }
            form_lcssa(cx, fi, l, pcx);
            resolve_all(cx, fi);
            if unswitch_loop(cx, fi, l, pcx) {
                unswitched += 1;
                changed = true;
                resolve_all(cx, fi);
                simplify_cfg(cx, fi, pcx);
                verify_func(cx, fi, c"unswitching", pcx);
            }
        }
        canonicalize_loops(cx, fi, pcx);
        for l in 0..loop_count(cx) {
            if is_innermost(cx, l) && loop_header(cx, l) != (*get_irfuncs().add(fi as usize)).entry
                && is_canonical(cx, l)
                && reduce_loop(cx, fi, l, pcx) {
                changed = true;
            }
        }
        free(headers.data as *mut u8);
        if changed {
            resolve_all(cx, fi);
            verify_func(cx, fi, c"loop strength reduction", pcx);
        }
        changed
    }
}
