// (0.25.4) What the optimizer knows of std's Vec (docs/design/
// modernize-0254.md §2, step 2): two facts for the alias analysis
// (gvn.vl's may_alias), with which GVN forwards a Vec's ptr and len
// across the stores of a loop, LICM hoists them, and the vectorizer
// (vectorize/mod.vl, hoist_invariant_loads) sees an element's address
// affine in the induction variable. docs/optimizer.md, "0.25.4: Vec facts".
//
// 1. A let parameter's Vec header does not change during the call. The
//    referent of a let parameter (`v: Vec<T>`, a `&T` to the optimizer) is
//    lent read-only for the call (the law of exclusivity): no store
//    reaches the ptr, len and cap of a std Vec in it, reached from the
//    parameter through std's wrappers of a Vec (String, Buf, PathBuf,
//    BinaryHeap, MinHeap: sealed, changed by inout methods only). Not
//    through other structs, sealed ones either: a let method of a Mutex
//    writes the value inside through a raw pointer (std::sync), and so may
//    any struct's own unsafe code. Only when the
//    function never writes through the parameter itself or passes it on
//    (param_written: `&v as *Vec<T>` is accepted in unsafe code) and the
//    own pass ran in error mode (noalias_active). Calls were covered
//    already (gvn.vl, param_frozen); this adds the stores.
// 2. A Vec's buffer does not hold its own header. An access at an
//    address made from the `ptr` loaded from a Vec's header, plus offsets
//    (an element's), is not at that header's ptr, len or cap: the buffer
//    is a block the Vec owns, and a Vec is never inside what it owns. The
//    header must be at a place whose type says where the Vec is: a
//    reference parameter's referent, a static of this program, a frame
//    slot. Another Vec's buffer may hold this header (a Vec<Vec<T>>), so
//    the fact is about the same header only.
//
// What unsafe code must keep for these (guide unsafe): it changes no Vec
// lent let while the call runs, through a raw pointer either; it makes no
// address of a Vec's header from its buffer's pointer.
use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::within_std;
use crate::front::types::{TY_U64, TyKind, fn_param, get_fields, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::is_const;
use crate::middle::gvn::{
    PC_NONE, PC_SHARED, address_base, noalias_active, param_class, param_written, root_of,
};
use crate::middle::ir::get_irfuncs;
use crate::middle::ir::Op::{Add, GAddr, Load, Param, Slot};

// Finds std's Vec and its wrappers (before the tasks run:
// middle::parallel, prepare_tasks).
pub fn init_vec_facts(pcx: &mut Ctx<Comp>) {
    pcx.vec_tmpl = 0;
    let vec = intern_c(c"Vec", pcx);
    let names = [
        intern_c(c"String", pcx), intern_c(c"Buf", pcx), intern_c(c"PathBuf", pcx),
        intern_c(c"BinaryHeap", pcx), intern_c(c"MinHeap", pcx)];
    for k in 0..5 {
        pcx.wraps[k as usize] = 0;
    }
    for s in 0..pcx.structs.len() as i64 {
        if pcx.structs[s as usize].tmpl != 0
            || !within_std(pcx.structs[s as usize].module, pcx) {
            continue;
        }
        if pcx.structs[s as usize].name == vec && pcx.structs[s as usize].generic != 0 {
            pcx.vec_tmpl = s + 1;
        }
        for k in 0..5 {
            if pcx.structs[s as usize].name == names[k as usize] {
                pcx.wraps[k as usize] = s + 1;
            }
        }
    }
}

// Whether struct s (an instance) is one of std's wrappers of a Vec
// (String, Buf, PathBuf, BinaryHeap, MinHeap): sealed, every change
// through an inout method. Not every sealed std struct: a Mutex (sealed
// in 0.25.4) changes its value from a let method, through a raw pointer.
fn vec_wrapper(s: i64, pcx: &Ctx<Comp>) -> bool {
    // (an instance's template; a struct with no parameters is its own)
    let t = if pcx.structs[s as usize].tmpl != 0 { pcx.structs[s as usize].tmpl }
        else { s + 1 };
    pcx.wraps[0] != 0
        && (t == pcx.wraps[0] || t == pcx.wraps[1] || t == pcx.wraps[2] || t == pcx.wraps[3]
            || t == pcx.wraps[4])
}

// Where [offset, + size) of a value of type t lies in the header (ptr,
// len, cap) of a std Vec inside it, through struct fields and array
// elements (`wrappers`: through std's wrappers of a Vec only): the header's
// offset in t + 1, or 0.
pub fn vec_header_in(t0: i64, offset: i64, size: i64, wrappers: bool, pcx: &Ctx<Comp>) -> i64 {
    let mut t = t0;
    let mut off = offset;
    let mut at: i64 = 0;
    // UNSAFE: the checker's raw tables of types, structs and fields.
    // SAFETY: read only; t is a type id, s a struct id and f a field index
    // of s, all made by the checker; the tables do not change while the
    // optimizer runs.
    unsafe {
        for _ in 0..8 {
            if t <= 0 || off < 0 || size <= 0 {
                return 0;
            }
            let kind = pcx.types[t as usize].kind;
            if kind == TyKind::Struct {
                let s = pcx.types[t as usize].a;
                if pcx.vec_tmpl != 0 && pcx.structs[s as usize].tmpl == pcx.vec_tmpl {
                    // (ptr, len, cap: the first three fields)
                    let end = (*get_fields().add((pcx.structs[s as usize].fields + 2) as usize)).offset + 8;
                    return if off + size <= end { at + 1 } else { 0 };
                }
                if wrappers && !vec_wrapper(s, pcx) {
                    return 0;
                }
                let mut next: i64 = 0;
                for i in 0..pcx.structs[s as usize].field_count {
                    let f = pcx.structs[s as usize].fields + i;
                    let fo = (*get_fields().add(f as usize)).offset;
                    if off >= fo
                        && off + size <= fo + type_size((*get_fields().add(f as usize)).ty, pcx) {
                        next = (*get_fields().add(f as usize)).ty;
                        at += fo;
                        off -= fo;
                        break;
                    }
                }
                t = next;
            } else if kind == TyKind::Array && !wrappers {
                let elem = pcx.types[t as usize].a;
                let es = type_size(elem, pcx);
                if es <= 0 {
                    return 0;
                }
                let k = off / es;
                at += k * es;
                off -= k * es;
                t = elem;
            } else {
                return 0;
            }
        }
        0
    }
}

// (0.29) vec_header_in, kept for the task by (type, offset, size): the
// alias analysis asks the same few places of the same few types at every
// store and call, and the answer is a walk of the type's fields.
pub fn vec_header_at(cx: &mut FnCtx<Comp>, t: i64, off: i64, size: i64, wrappers: bool,
    pcx: &Ctx<Comp>) -> i64 {
    if t <= 0 || off < 0 || off >= (1 << 24) || size <= 0 || size > 64 {
        return vec_header_in(t, off, size, wrappers, pcx);
    }
    let key = (t << 32) | (off << 8) | (size << 1) | (if wrappers { 1 } else { 0 });
    let h = ((t * 31 + off) & 63) as usize;
    if cx.vh_key[h] == key {
        return cx.vh_val[h];
    }
    let r = vec_header_in(t, off, size, wrappers, pcx);
    cx.vh_key[h] = key;
    cx.vh_val[h] = r;
    r
}

// (0.29) Whether [off, off + size) of a value of type t may touch the
// header of a std Vec that vec_header_in finds in it (through struct
// fields and array elements); size < 0: any part of the value. For a
// write whose place in t is known: which Vec headers it may change
// (middle::callfacts).
pub fn touches_header(t: i64, off: i64, size: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || pcx.vec_tmpl == 0 {
        return false;
    }
    if depth > 8 {
        return true;
    }
    let kind = pcx.types[t as usize].kind;
    if kind == TyKind::Struct {
        let s = pcx.types[t as usize].a;
        // UNSAFE: the checker's raw table of fields.
        // SAFETY: read only; s is a struct id the checker made and every
        // index a field of s; the table does not change while the
        // optimizer runs.
        unsafe {
            if pcx.structs[s as usize].tmpl == pcx.vec_tmpl {
                // (ptr, len, cap: the first three fields)
                let end = (*get_fields().add((pcx.structs[s as usize].fields + 2) as usize)).offset + 8;
                return size < 0 || off < end;
            }
            for i in 0..pcx.structs[s as usize].field_count {
                let f = pcx.structs[s as usize].fields + i;
                let fo = (*get_fields().add(f as usize)).offset;
                let ft = (*get_fields().add(f as usize)).ty;
                if size < 0 {
                    if touches_header(ft, 0, -1, depth + 1, pcx) {
                        return true;
                    }
                    continue;
                }
                if fo >= off + size || fo + type_size(ft, pcx) <= off {
                    continue;
                }
                let inside = if off > fo { off - fo } else { 0 };
                if touches_header(ft, inside, off + size - fo - inside, depth + 1, pcx) {
                    return true;
                }
            }
        }
        return false;
    }
    if kind == TyKind::Array {
        let elem = pcx.types[t as usize].a;
        let es = type_size(elem, pcx);
        if es <= 0 {
            return false;
        }
        if size < 0 || off / es != (off + size - 1) / es {
            return touches_header(elem, 0, -1, depth + 1, pcx);
        }
        return touches_header(elem, off % es, size, depth + 1, pcx);
    }
    false
}

// The type of the memory object at `base` (an address with no offset of
// its own): a reference parameter's referent, a static's of this
// program, a frame slot's; 0 when not known.
pub fn memory_type(cx: &mut FnCtx<Comp>, base: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: the checker's tables (STRUCTS, FIELDS, TYPES, STATICS: raw
    // statics) and the IR's, reached through the raw *FnCtx.
    // SAFETY: read only; every index is a type, struct, static or value id
    // the checker or the IR made, in its table; the tables do not change
    // while the optimizer runs (prepare_tasks laid every type out).
    unsafe {
        let op = (cx.insts[base as usize]).op;
        if op == Param {
            let k = (cx.insts[base as usize]).imm;
            if k < 0 || (cx.insts[base as usize]).ty != TY_U64
                || (cx.insts[base as usize]).imm2 != 0
                || param_class(cx, k, pcx) == PC_NONE {
                return 0;
            }
            let t = fn_param((*get_irfuncs().add(cx.irf as usize)).f, k, pcx);
            return if pcx.types[t as usize].kind == TyKind::Ptr { pcx.types[t as usize].a }
                else { 0 };
        }
        if op == GAddr {
            let st = (*pcx.sym_static.add((cx.insts[base as usize]).imm as usize)) - 1;
            if st < 0 || pcx.statics[st as usize].linkage == 1 {
                return 0;
            }
            return pcx.statics[st as usize].ty;
        }
        if op == Slot {
            let s = (cx.insts[base as usize]).imm;
            let t = (cx.slots[s as usize]).ty;
            if t <= 0 || type_size(t, pcx) > (cx.slots[s as usize]).size {
                return 0;
            }
            return t;
        }
        0
    }
}

// Whether [base + off, + size) is a let parameter's Vec header that
// nothing writes during the call (fact 1): a let parameter (`&T`, T Freeze:
// gvn::param_class_of, 0.26.1) the
// function never writes through nor passes on, under the own pass's
// error mode, the range in a std Vec's header reached through std's
// sealed structs. (The cheap tests first: may_alias asks often.)
fn frozen_header(cx: &mut FnCtx<Comp>, base: i64, off: i64, size: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: the checker's tables (STRUCTS, FIELDS, TYPES, STATICS: raw
    // statics) and the IR's, reached through the raw *FnCtx.
    // SAFETY: read only; every index is a type, struct, static or value id
    // the checker or the IR made, in its table; the tables do not change
    // while the optimizer runs (prepare_tasks laid every type out).
    unsafe {
        let k = (cx.insts[base as usize]).imm;
        if k < 0 || (cx.insts[base as usize]).ty != TY_U64
            || (cx.insts[base as usize]).imm2 != 0 || param_class(cx, k, pcx) != PC_SHARED
            || !noalias_active(crate::middle::gvn::optimized_fn(cx), pcx) {
            return false;
        }
        let t = fn_param((*get_irfuncs().add(cx.irf as usize)).f, k, pcx);
        pcx.types[t as usize].kind == TyKind::Ptr
            && vec_header_at(cx, pcx.types[t as usize].a, off, size, true, pcx) != 0
            && !param_written(cx, k + 1, pcx)
    }
}

// (0.25.4) The size of a reference parameter's referent when `base` is
// one (a `&T` or `&mut T`, not a slice's pointer), else -1: such a
// parameter points to a live T for the whole call, so an access inside it
// may run anywhere in the function (LICM's preheader).
pub fn ref_param_size(cx: &mut FnCtx<Comp>, base: i64, pcx: &Ctx<Comp>) -> i64 {
    // UNSAFE: the checker's tables (STRUCTS, FIELDS, TYPES, STATICS: raw
    // statics) and the IR's, reached through the raw *FnCtx.
    // SAFETY: read only; every index is a type, struct, static or value id
    // the checker or the IR made, in its table; the tables do not change
    // while the optimizer runs (prepare_tasks laid every type out).
    unsafe {
        if (cx.insts[base as usize]).op != Param {
            return -1;
        }
        let t = memory_type(cx, base, pcx);
        if t <= 0 { -1 } else { type_size(t, pcx) }
    }
}

// Whether [base + off, + size) is in the header of a std Vec in the
// referent of reference parameter `base`: what LICM hoists of a
// parameter's memory (only a Vec's header: other memory a let parameter
// reaches may change under it, a Mutex's value).
pub fn in_param_vec_header(cx: &mut FnCtx<Comp>, base: i64, off: i64, size: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: the checker's tables (STRUCTS, FIELDS, TYPES, STATICS: raw
    // statics) and the IR's, reached through the raw *FnCtx.
    // SAFETY: read only; every index is a type, struct, static or value id
    // the checker or the IR made, in its table; the tables do not change
    // while the optimizer runs (prepare_tasks laid every type out).
    unsafe {
        if pcx.vec_tmpl == 0 || (cx.insts[base as usize]).op != Param {
            return false;
        }
        let t = memory_type(cx, base, pcx);
        t > 0 && vec_header_at(cx, t, off, size, false, pcx) != 0
    }
}

// The load of a pointer that address `v` is made from through additions
// (one side of each the pointer, the other an offset), or 0.
pub fn buffer_load(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    // UNSAFE: the checker's tables (STRUCTS, FIELDS, TYPES, STATICS: raw
    // statics) and the IR's, reached through the raw *FnCtx.
    // SAFETY: read only; every index is a type, struct, static or value id
    // the checker or the IR made, in its table; the tables do not change
    // while the optimizer runs (prepare_tasks laid every type out).
    unsafe {
        let mut x = v;
        for _ in 0..16 {
            let op = (cx.insts[x as usize]).op;
            if op == Load {
                return if (cx.insts[x as usize]).ty == TY_U64 { x } else { 0 };
            }
            if op != Add || (cx.insts[x as usize]).ty != TY_U64 {
                return 0;
            }
            if is_const(cx, (cx.insts[x as usize]).b) {
                x = (cx.insts[x as usize]).a;
                continue;
            }
            let la = buffer_load(cx, (cx.insts[x as usize]).a);
            let lb = buffer_load(cx, (cx.insts[x as usize]).b);
            if (la == 0) == (lb == 0) {
                return 0;
            }
            return if la != 0 { la } else { lb };
        }
        0
    }
}

// Whether bases a and b are the same memory object's start.
pub fn same_object(cx: &mut FnCtx<Comp>, a: i64, b: i64) -> bool {
    // UNSAFE: the checker's tables (STRUCTS, FIELDS, TYPES, STATICS: raw
    // statics) and the IR's, reached through the raw *FnCtx.
    // SAFETY: read only; every index is a type, struct, static or value id
    // the checker or the IR made, in its table; the tables do not change
    // while the optimizer runs (prepare_tasks laid every type out).
    unsafe {
        if a == b {
            return true;
        }
        let op = (cx.insts[a as usize]).op;
        op == (cx.insts[b as usize]).op && (op == GAddr || op == Slot || op == Param)
            && (cx.insts[a as usize]).imm == (cx.insts[b as usize]).imm
            && (cx.insts[a as usize]).imm2 == (cx.insts[b as usize]).imm2
    }
}

// Whether [base + off, + size) is apart from an access at base `other`
// by the facts above (may_alias asks when a root is unknown): a let
// parameter's Vec header, which nothing writes (fact 1), or a Vec header
// that `other`, in its own buffer, cannot reach (fact 2).
pub fn vec_apart(cx: &mut FnCtx<Comp>, base: i64, off: i64, size: i64, other: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: the checker's tables (STRUCTS, FIELDS, TYPES, STATICS: raw
    // statics) and the IR's, reached through the raw *FnCtx.
    // SAFETY: read only; every index is a type, struct, static or value id
    // the checker or the IR made, in its table; the tables do not change
    // while the optimizer runs (prepare_tasks laid every type out).
    unsafe {
        if pcx.vec_tmpl == 0 {
            return false;
        }
        let op = (cx.insts[base as usize]).op;
        if op != Param && op != GAddr && op != Slot {
            return false;
        }
        if op == Param && frozen_header(cx, base, off, size, pcx) {
            return true;
        }
        // Fact 2: `other` made from a pointer loaded from this same
        // object, at the start of the Vec header holding the range.
        let l = buffer_load(cx, other);
        if l == 0 {
            return false;
        }
        let mut o = (cx.insts[l as usize]).imm;
        let hb = address_base(cx, (cx.insts[l as usize]).a, &mut o);
        if !same_object(cx, hb, base) || root_of(cx, other) != 0 {
            return false;
        }
        let t = memory_type(cx, base, pcx);
        t > 0 && vec_header_at(cx, t, off, size, false, pcx) == o + 1
    }
}
