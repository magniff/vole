// SSA construction during lowering (Braun et al., see mod.vl): the
// current definition of each variable in each block, phis made on reads
// in unsealed blocks and completed when the block is sealed, trivial phis
// removed. Also HMap, the hash map the definitions are kept in (used by
// other passes too).

use crate::base::{alloc_array, free, memset};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, fn_entry, ir_arg, ir_make, ir_prepend, ir_replace, ir_type, ir_val};

// An open-addressing hash map from i64 keys (never 0) to i64 values.
#[derive(Clone, Copy)] pub struct HMap {
    pub keys: *mut i64, pub vals: *mut i64, pub size: i64, pub count: i64,
}

impl HMap {
    fn slot(self, key: i64) -> i64 {
        let mask = self.size - 1;
        let mut slot = ((key as u64).wrapping_mul(11400714819323198485u64) >> 20) as i64 & mask;
        // UNSAFE: the keys are behind a raw pointer: HMap is a Copy header
        // over two arrays (the compiler's own map, older than std's
        // HashMap), held by value in the contexts' fields all over the
        // compiler, so its arrays cannot be Vecs before those fields are.
        // SAFETY: get and put call this only with size > 0 (get returns
        // first when size is 0; put rehashes first, and rehash makes size
        // at least 256), and rehash is the only place keys and size are
        // set, together: keys has `size` zeroed-or-written entries. size is
        // a power of two (256 doubled), so `slot & mask` is below size.
        // The loop ends: put keeps (count + 1) * 2 <= size, so a zero key
        // is always there. Not checked by the type: a copy of the header
        // taken before a put that rehashes holds the freed arrays; the
        // owners keep one header (a field, a local) and read through it.
        while unsafe {
            (*self.keys.add(slot as usize)) != 0 && (*self.keys.add(slot as usize)) != key
        } {
            slot = (slot + 1) & mask;
        }
        slot
    }

    pub fn get(self, key: i64) -> i64 {
        // UNSAFE: the keys and values are behind raw pointers (slot's
        // comment says why).
        // SAFETY: size > 0 here (checked first), so keys and vals are
        // rehash's arrays of `size` entries, and slot's result is below
        // size (slot's comment).
        unsafe {
            if self.size == 0 {
                return 0;
            }
            let slot = self.slot(key);
            if (*self.keys.add(slot as usize)) == key { (*self.vals.add(slot as usize)) } else { 0 }
        }
    }

    pub fn put(&mut self, key: i64, value: i64) {
        // UNSAFE: the keys and values are behind raw pointers (slot's
        // comment says why).
        // SAFETY: after the rehash below size is at least 256 and more
        // than twice the count, so keys and vals are rehash's arrays of
        // `size` entries with a free slot, and slot's result is below
        // size. `&mut self` is the map's one header (slot's comment).
        unsafe {
            if (self.count + 1) * 2 > self.size {
                self.rehash();
            }
            let slot = self.slot(key);
            if (*self.keys.add(slot as usize)) == 0 {
                self.count += 1;
                (*self.keys.add(slot as usize)) = key;
            }
            (*self.vals.add(slot as usize)) = value;
        }
    }

    fn rehash(&mut self) {
        // UNSAFE: the map's arrays are raw allocations, made and freed
        // here (slot's comment says why they are not Vecs).
        // SAFETY: old_keys and old_vals are the arrays the last rehash
        // made, of old_size entries (the fields are set only here, and
        // release clears them together), read below old_size and freed
        // once, after the last read; they are not freed when old_size is 0
        // (never allocated). The new arrays have `size` zeroed entries
        // (alloc_array), and the puts into them cannot rehash again: the
        // old count is at most old_size / 2, a quarter of size.
        unsafe {
            let old_keys = self.keys;
            let old_vals = self.vals;
            let old_size = self.size;
            let mut size = old_size * 2;
            if size < 256 {
                size = 256;
            }
            self.keys = alloc_array::<i64>(size);
            self.vals = alloc_array::<i64>(size);
            self.size = size;
            self.count = 0;
            for i in 0..old_size {
                if (*old_keys.add(i as usize)) != 0 {
                    self.put((*old_keys.add(i as usize)), (*old_vals.add(i as usize)));
                }
            }
            if old_size > 0 {
                free(old_keys as *mut u8);
                free(old_vals as *mut u8);
            }
        }
    }

    pub fn clear(&mut self) {
        if self.size > 0 {
            // UNSAFE: the keys are a raw allocation (slot's comment), zeroed
            // with C's memset.
            // SAFETY: size > 0, so keys is rehash's array of `size` i64s:
            // size * 8 bytes are its own.
            unsafe { memset(self.keys as *mut u8, 0, (self.size * 8) as u64); }
        }
        self.count = 0;
    }

    // (0.29) Gives the map's arrays back: the map is empty after, and can
    // be used again. For a map that is a local (a context's maps live as
    // long as the context).
    pub fn release(&mut self) {
        if self.size > 0 {
            // UNSAFE: the map's arrays are raw allocations (slot's comment).
            // SAFETY: size > 0, so keys and vals are rehash's arrays, freed
            // once: the fields are cleared below, and `&mut self` is the
            // map's one header (a copy taken before would dangle: slot's
            // comment).
            unsafe {
                free(self.keys as *mut u8);
                free(self.vals as *mut u8);
            }
        }
        self.keys = 0 as *mut i64;
        self.vals = 0 as *mut i64;
        self.size = 0;
        self.count = 0;
    }
}

// ---- SSA construction ----

fn def_key(var_id: i64, b: i64) -> i64 {
    ((var_id + 1) << 32) | b
}

fn var_type(cx: &mut FnCtx<Comp>, var_id: i64, pcx: &Ctx<Comp>) -> i64 {
    if var_id < pcx.locals.len() as i64 {
        return ir_type(pcx.locals[var_id as usize].ty, pcx);
    }
    (cx.synth_ty[(var_id - pcx.locals.len() as i64) as usize])
}

pub fn new_synth_var(cx: &mut FnCtx<Comp>, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    cx.synth_ty.push(ty);
    pcx.locals.len() as i64 + cx.synth_ty.len() as i64 - 1
}

pub fn ssa_write(cx: &mut FnCtx<Comp>, var_id: i64, b: i64, value: i64) {
    cx.defs.put(def_key(var_id, b), value);
}

pub fn ssa_read(cx: &mut FnCtx<Comp>, var_id: i64, b: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = cx.defs.get(def_key(var_id, b));
    if v != 0 {
        return ir_val(cx, v);
    }
    ssa_read_recursive(cx, var_id, b, pcx)
}

// An undefined value of type `ty`: 0, placed in the entry block.
pub fn ssa_undef(cx: &mut FnCtx<Comp>, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = ir_make(cx, Op::Const, ty, 0, 0, 0, pcx);
    ir_prepend(cx, fn_entry(cx, cx.irf), v);
    v
}

fn new_phi(cx: &mut FnCtx<Comp>, var_id: i64, b: i64, pcx: &Ctx<Comp>) -> i64 {
    let var_type_v = var_type(cx, var_id, pcx);
    let phi = ir_make(cx, Op::Phi, var_type_v, 0, 0, 0, pcx);
    ir_prepend(cx, b, phi);
    phi
}

fn ssa_read_recursive(cx: &mut FnCtx<Comp>, var_id: i64, b: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut value: i64 = 0;
    let preds = (cx.blocks[b as usize]).preds.len() as i64;
    if (cx.blocks[b as usize]).sealed == 0 {
        value = new_phi(cx, var_id, b, pcx);
        cx.incomplete.push(var_id);
        cx.incomplete.push(value);
        cx.incomplete.push((cx.blocks[b as usize]).incomplete);
        (cx.blocks[b as usize]).incomplete = cx.incomplete.len() as i64 / 3;
    } else if preds == 1 {
        value = ssa_read(cx, var_id, ((cx.blocks[b as usize]).preds[0]), pcx);
    } else if preds == 0 {
        let var_type_v = var_type(cx, var_id, pcx);
        value = ssa_undef(cx, var_type_v, pcx);
    } else {
        let phi = new_phi(cx, var_id, b, pcx);
        ssa_write(cx, var_id, b, phi);
        value = add_phi_operands(cx, var_id, phi, pcx);
    }
    ssa_write(cx, var_id, b, value);
    value
}

fn add_phi_operands(cx: &mut FnCtx<Comp>, var_id: i64, phi: i64, pcx: &Ctx<Comp>) -> i64 {
    let b = (cx.insts[phi as usize]).block;
    let mark = cx.ssa_stack.len() as i64;
    for i in 0..(cx.blocks[b as usize]).preds.len() as i64 {
        let pred = ((cx.blocks[b as usize]).preds[i as usize]);
        let value = ssa_read(cx, var_id, pred, pcx);
        cx.ssa_stack.push(value);
    }
    let count = cx.ssa_stack.len() as i64 - mark;
    (cx.insts[phi as usize]).args = cx.args.len() as i64;
    (cx.insts[phi as usize]).nargs = count;
    for i in 0..count {
        cx.args.push((cx.ssa_stack[(mark + i) as usize]));
        cx.argty.push(0);
    }
    cx.ssa_stack.truncate(mark as usize);
    try_remove_trivial_phi(cx, phi, pcx)
}

// A phi whose operands are all the same value (or itself) is that value.
fn try_remove_trivial_phi(cx: &mut FnCtx<Comp>, phi: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut same: i64 = 0;
    for i in 0..(cx.insts[phi as usize]).nargs {
        let ir_arg_v = ir_arg(cx, phi, i);
        let operand = ir_val(cx, ir_arg_v);
        if operand == same || operand == phi {
            continue;
        }
        if same != 0 {
            return phi;
        }
        same = operand;
    }
    if same == 0 {
        same = ssa_undef(cx, (cx.insts[phi as usize]).ty, pcx);
    }
    ir_replace(cx, phi, same);
    same
}

pub fn ir_seal(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) {
    let mut entry = (cx.blocks[b as usize]).incomplete;
    while entry != 0 {
        let at = (entry - 1) * 3;
        let var_id = (cx.incomplete[at as usize]);
        let phi = (cx.incomplete[(at + 1) as usize]);
        add_phi_operands(cx, var_id, phi, pcx);
        entry = (cx.incomplete[(at + 2) as usize]);
    }
    (cx.blocks[b as usize]).incomplete = 0;
    (cx.blocks[b as usize]).sealed = 1;
}
