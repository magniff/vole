use crate::front::features::fn_needs;
use crate::front::lexer::Tok;
use crate::front::types::{
    TY_BOOL, TY_I64, TY_NEVER, TY_U64, TyKind, field_offset, fn_param, get_enums, int_bits,
    is_compound, is_integer, is_signed, is_slice, is_vector, is_void, tuple_offset, type_size,
    variant_field_offset,
};
use crate::gen0::gen::expr::panic_kind;
use crate::gen0::target::arith_panic_kind;
use crate::middle::ctx::FnCtx;
use crate::middle::entryfacts::lower_entry_facts;
use crate::middle::ir::{
    Cond, Op, Term, emit_ir, get_irfuncs, ir_binary, ir_cmp, ir_const, ir_enter, ir_load,
    ir_new_block, ir_new_func, ir_offset, ir_shrink, ir_slot_addr, ir_store, ir_type,
};
