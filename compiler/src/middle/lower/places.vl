use crate::places::shim::drop_shim_fn;

// ---- Which functions ----

// Function f (its Fn node: item) lowered from its kept body: false when
// it has none, or one with something this file does not lower (the AST
// walk lowers it then).
pub fn lower_places_function(cx: &mut FnCtx<Comp>, item: i64, f: i64, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    if !take_body(f, false, pbody, pcx) {
        return false;
    }
    lower_body(cx, item, f, pbody, pcx);
    free_body(f, pcx);
    true
}

// Function f's kept body held for a code generator (this file, or gen0's
// places.vl), its blocks ordered (RPO) and scanned (scan_body); counted
// by the reason when it cannot be (none kept, a drop that does not run, a
// statement kind not handled), and then not held. The
// caller frees a body held (free_body). `types_only`: the scan makes the
// locals' and places' types only, not what the SSA lowering needs (where
// each local is used, which are borrowed): gen0's.
pub fn take_body(f: i64, types_only: bool, pbody: &mut Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if !load_body(f, pbody, pcx) {
        pcx.pl_no_body += 1;
        return false;
    }
    compute_rpo(pbody);
    let reason = scan_body(types_only, pbody, pcx);
    if reason != 0 {
        if reason < 0 {
            pcx.pl_drop += 1;
        } else {
            pcx.pl_kind += 1;
            while pcx.kind_counts.len() as i64 <= reason {
                pcx.kind_counts.push(0);
            }
            pcx.kind_counts[reason as usize] += 1;
        }
        free_body(f, pcx);
        return false;
    }
    pcx.pl_lowered += 1;
    true
}

// `places lowering: N functions; AST: no body N, drop N, kind K N...` on
// stderr (--time-passes).
pub fn lower_stats(pcx: &Ctx<Comp>) {
    let out = buf_new();
    buf_str(out, c"places lowering: ");
    buf_int(out, pcx.pl_lowered);
    buf_str(out, c" functions from the IR; from the AST: no body ");
    buf_int(out, pcx.pl_no_body);
    buf_str(out, c", drop ");
    buf_int(out, pcx.pl_drop);
    buf_str(out, c", kind ");
    buf_int(out, pcx.pl_kind);
    for k in 0..pcx.kind_counts.len() as i64 {
        if pcx.kind_counts[k as usize] > 0 {
            buf_str(out, c" (");
            buf_int(out, k);
            buf_str(out, c": ");
            buf_int(out, pcx.kind_counts[k as usize]);
            buf_str(out, c")");
        }
    }
    buf_str(out, c"\n");
    buf_write_fd(out, STDERR);
}

// ---- Types ----

// The type of local l (erased: the code generators see no distinct type).
pub fn local_type(l: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.l_ty[l as usize]
}

// The type of place (l, p): l's through each projection (a PJ_FIELD after
// a PJ_VARIANT is the variant's field), erased.
pub fn place_ty(l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if p == 0 {
        return pcx.l_ty[l as usize];
    }
    if pcx.pj_root[p as usize] == l {
        return pcx.pj_ty[p as usize];
    }
    let parent = proj_parent(p, pbody);
    let k = proj_kind(p, pbody);
    let v = proj_val(p, pbody);
    let mut t: i64 = 0;
    if k == PJ_FIELD && parent > 0 && proj_kind(parent, pbody) == PJ_VARIANT {
        t = erase_type(crate::front::types::variant_field(proj_val(parent, pbody), v, pcx), pcx);
    } else {
        t = place_ty(l, parent, pbody, pcx);
        if k != PJ_VARIANT {
            t = erase_type(crate::places::ir::step_type(t, k, v, pcx), pcx);
        }
    }
    pcx.pj_root[p as usize] = l;
    pcx.pj_ty[p as usize] = t;
    t
}

// The type of operand i at `ops`.
pub fn op_type(ops: i64, i: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let k = op_kind(ops, i, pbody);
    if k == OK_COPY || k == OK_MOVE || k == OK_PLACE {
        return place_ty(op_a(ops, i, pbody), op_b(ops, i, pbody), pbody, pcx);
    }
    if k == OK_UNIT {
        return crate::places::ir::unit_ty();
    }
    erase_type(op_b(ops, i, pbody), pcx)
}

// ---- The body ----

fn lower_body(cx: &mut FnCtx<Comp>, item: i64, f: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // UNSAFE: cx is the lowering's raw context pointer, NODES, IRFUNCS and the
    // lowering's tables are static mut (lower/mod.vl's lower_function does the same).
    // SAFETY: cx points at lower_program's live FnCtx for the whole call; item is
    // the function's node and f its FNS index, both below their tables' counts;
    // lowering is single-threaded.
    unsafe {
        pcx.ir_loc = if pcx.ir_locs { pcx.nodes[item as usize].start + 1 } else { 0 };
        pcx.ir_expr_loc = 0;
        let ir_new_func_v = ir_new_func(cx, f, item, pcx);
        ir_enter(cx, ir_new_func_v, pcx);
        // (an empty map is zero already)
        if cx.defs.count > 0 {
            cx.defs.clear();
        }
        let entry = ir_new_block(cx);
        (*get_irfuncs().add(cx.irf as usize)).entry = entry;
        (*cx.blocks.add(entry as usize)).sealed = 1;
        pcx.ir_cur = entry;
        let synth_mark = cx.synth_ty.len() as i64;
        let ret = pcx.fns[f as usize].ret;
        let c = fn_uses_c(f, pcx);
        if conv_returns_through_pointer(cx, c, ret, pcx) {
            (*get_irfuncs().add(cx.irf as usize)).result_ptr = emit_ir(cx, Op::Param, TY_U64, 0, 0,
                -1, pcx);
        }
        place_locals(cx, false, pbody, pcx);
        // (0.18.1) -O2: its checked requires as facts (middle::entryfacts),
        // which reads the parameters as the AST's locals (bound by lower_param)
        let facts = pcx.opt_level >= 2 && crate::front::contracts::desugar::entry_pre(f, pcx) >= 0;
        for i in 0..pcx.fns[f as usize].param_count {
            let ty = fn_param(f, i, pcx);
            let ast_local = pcx.nodes[child(item, i, pcx) as usize].x;
            // (a parameter `_` has no AST local: it is bound all the same, its
            // drop reads it)
            if is_void(ty) {
                continue;
            }
            lower_param(cx, i, i + 1, ast_local, ty, c, facts, pbody, pcx);
        }
        place_locals(cx, true, pbody, pcx);
        if facts {
            lower_entry_facts(cx, item, f, pcx);
        }
        if (fn_needs(f, pcx) & !own_features()) != 0 {
            // (0.19) never called: no body (as mod.vl's lower_function)
            ir_terminate(cx, pcx.ir_cur, Term::Unreach, 0, 0, 0);
        } else {
            lower_blocks(cx, pbody, pcx);
        }
        if (*cx.blocks.add(pcx.ir_cur as usize)).term == Term::None {
            ir_terminate(cx, pcx.ir_cur, Term::Unreach, 0, 0, 0);
        }
        cx.synth_ty.truncate(synth_mark);
        pcx.ir_loc = 0;
        ir_shrink(cx);
    }
}

// Each local's type, SSA variable or storage: a scalar never borrowed
// whole is an SSA variable; the others get a slot (in the entry block,
// so that its address dominates every use), but for the parameters
// (lower_param) and statics (their address at each use). In two rounds
// (0.26.2): the SSA variables before the parameters (`slots` false, no
// IR), the slots after them, so that the entry block starts with its
// parameters, as the AST lowering's did (ipo.vl's propagate_constants
// reads the leading ones).
fn place_locals(cx: &mut FnCtx<Comp>, slots: bool, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let n = local_count(pbody);
    if !slots {
        pcx.l_var.clear();
        pcx.l_addr.clear();
        for _ in 0..n {
            pcx.l_var.push(-1);
            pcx.l_addr.push(0);
        }
    }
    for l in 0..n {
        let ty = pcx.l_ty[l as usize];
        let borrowed = pcx.l_borrowed[l as usize] != 0;
        if is_void(ty) || has_flag(l, LF_STATIC, pbody) {
            continue;
        }
        if !borrowed && !is_compound(ty, pcx) {
            if !slots {
                pcx.l_var[l as usize] = new_synth_var(cx, ir_type(ty, pcx), pcx);
            }
            continue;
        }
        if !slots || l >= 1 && l <= pbody.params {
            continue;
        }
        // (the result made in place, through the result pointer)
        // UNSAFE: IRFUNCS is the IR's raw table of functions, cx a raw pointer.
        // SAFETY: cx.irf is the function being lowered, made by ir_new_func.
        let rp = unsafe { (*get_irfuncs().add(cx.irf as usize)).result_ptr };
        if l == 0 && rp != 0 {
            pcx.l_addr[0] = rp;
            continue;
        }
        pcx.l_addr[l as usize] = {
            let at_arg1 = new_slot_for(cx, ty, pcx); ir_slot_addr(cx, at_arg1, pcx)
        };
    }
}

// Whether projection list p has a `*` in it.
pub fn through_deref(p: i64, pbody: &Body<Comp>) -> bool {
    let mut q = p;
    while q > 0 {
        if proj_kind(q, pbody) == PJ_DEREF {
            return true;
        }
        q = proj_parent(q, pbody);
    }
    false
}

// Parameter i (local l, AST local ast_local) of type ty, as mod.vl's
// lower_function binds it: its pieces stored into a slot, or its value (a
// compound one's address, the caller's copy). The AST local is bound too,
// for lower_entry_facts' call.
fn lower_param(cx: &mut FnCtx<Comp>, i: i64, l: i64, ast_local: i64, ty: i64, c: bool, facts: bool,
    pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // UNSAFE: cx is the lowering's raw context pointer; its abi_piece and insts
    // arrays are raw (as in mod.vl's lower_function, which this follows).
    // SAFETY: cx points at the live FnCtx; k is below abi_piece_count, set by
    // conv_classify just above, and piece was just emitted into insts.
    unsafe {
        let kind = conv_classify(cx, c, ty, pcx);
        let mut value: i64 = 0;
        if kind == AbiClass::Pieces {
            let new_slot_for_v = new_slot_for(cx, ty, pcx);
            let slot = ir_slot_addr(cx, new_slot_for_v, pcx);
            for k in 0..cx.abi_piece_count {
                let piece = emit_ir(cx, Op::Param, cx.abi_piece_ty[k as usize], 0, 0, i, pcx);
                (*cx.insts.add(piece as usize)).imm2 = k + 1;
                ir_store(cx, cx.abi_piece_ty[k as usize], slot, piece,
                    cx.abi_piece_offset[k as usize], pcx);
            }
            value = slot;
        } else {
            value = emit_ir(cx, Op::Param, ir_type(ty, pcx), 0, 0, i, pcx);
            if kind == AbiClass::Stack {
                (*cx.insts.add(value as usize)).imm2 = -1;
            }
        }
        if facts && ast_local >= 0 {
            crate::middle::lower::need_promote(pcx);
            bind_local(cx, ast_local, value, ty, true, pcx);
        }
        if l >= local_count(pbody) {
            return;
        }
        if pcx.l_var[l as usize] >= 0 {
            let arg_v = pcx.l_var[l as usize];
            let need_value_v = need_value(cx, value, ty, pcx);
            ssa_write(cx, arg_v, pcx.ir_cur, need_value_v);
        } else if is_compound(ty, pcx) {
            pcx.l_addr[l as usize] = value;
        } else if pcx.l_addr[l as usize] == 0 {
            let new_slot_for_v1 = new_slot_for(cx, ty, pcx);
            // (a scalar parameter borrowed whole: a slot of its own)
            let addr = ir_slot_addr(cx, new_slot_for_v1, pcx);
            ir_store(cx, ir_type(ty, pcx), addr, value, 0, pcx);
            pcx.l_addr[l as usize] = addr;
        }
    }
}

// The blocks in reverse postorder: each block's statements, then its
// terminator; a block is sealed once its last predecessor is lowered.
fn lower_blocks(cx: &mut FnCtx<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let nb = block_count(pbody);
    pcx.b_mid.clear();
    pcx.b_left.clear();
    pcx.lower_fwd.clear();
    for b in 0..nb {
        pcx.b_mid.push(0);
        pcx.b_left.push(0);
        pcx.lower_fwd.push(b);
    }
    // (an empty block that jumps on is its target's: no block of its own)
    for i in 0..pbody.rpo.len() {
        let b = pbody.rpo[i];
        let mut t = b;
        let mut steps: i64 = 0;
        while steps < 64 && is_forward(t, pbody) {
            t = pbody.stmts[block_term(t, pbody) as usize].a;
            steps += 1;
        }
        if steps < 64 {
            pcx.lower_fwd[b as usize] = t;
        }
    }
    for i in 0..pbody.rpo.len() {
        let b = pbody.rpo[i];
        if pcx.lower_fwd[b as usize] != b {
            continue;
        }
        for k in 0..crate::places::ir::succ_count(b, pbody) {
            { let at_ix = pcx.lower_fwd[crate::places::ir::succ(b, k, pbody) as usize] as usize;
                pcx.b_left[at_ix] += 1 };
        }
    }
    // (the entry's jump to bb0)
    let first = pcx.lower_fwd[pbody.rpo[0] as usize];
    pcx.b_left[first as usize] += 1;
    let mid_v = mid(cx, first, pcx);
    lower_jump(cx, mid_v, pcx);
    done_edge(cx, first, pcx);
    for i in 0..pbody.rpo.len() {
        let b = pbody.rpo[i];
        if pcx.lower_fwd[b as usize] != b {
            continue;
        }
        pcx.ir_cur = mid(cx, b, pcx);
        let start = block_start(b, pbody);
        for j in 0..block_len(b, pbody) {
            lower_stmt(cx, start + j, pbody, pcx);
        }
        lower_term(cx, block_term(b, pbody), pbody, pcx);
        for k in 0..crate::places::ir::succ_count(b, pbody) {
            done_edge(cx, pcx.lower_fwd[crate::places::ir::succ(b, k, pbody) as usize], pcx);
        }
    }
}

// Whether block b has no statement that does anything and ends in a jump
// elsewhere.
pub fn is_forward(b: i64, pbody: &Body<Comp>) -> bool {
    let term = pbody.stmts[block_term(b, pbody) as usize];
    if term.kind != TK_GOTO || term.a == b {
        return false;
    }
    let start = block_start(b, pbody);
    for j in 0..block_len(b, pbody) {
        let k = pbody.stmts[(start + j) as usize].kind;
        if k != SK_LIVE && k != SK_DEAD && k != SK_NOP {
            return false;
        }
    }
    true
}

// Block b's block in the IR (forwarded), made on its first use: the IR's
// blocks are in the order the AST walk makes them (a jump's target after
// the blocks of the statements before it), as --emit-ir prints them.
fn mid(cx: &mut FnCtx<Comp>, b: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let t = pcx.lower_fwd[b as usize];
    if pcx.b_mid[t as usize] == 0 {
        pcx.b_mid[t as usize] = ir_new_block(cx);
    }
    pcx.b_mid[t as usize]
}

// An edge into block b lowered: b is sealed after its last one.
fn done_edge(cx: &mut FnCtx<Comp>, b: i64, pcx: &mut Ctx<Comp>) {
    pcx.b_left[b as usize] -= 1;
    if pcx.b_left[b as usize] == 0 {
        let mid_v = mid(cx, b, pcx);
        ir_seal(cx, mid_v, pcx);
    }
}

// ---- Places and operands ----

// Whether type t is a raw pointer (not a reference, 0.17).
fn is_raw_pointer(t: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.types[t as usize].kind == TyKind::Ptr && !crate::front::types::is_ref(t, pcx)
}

// The address of place (l, p). With --check-unsafe, an access through a
// raw pointer is checked, at the statement's position: a `*` of one, the
// whole pointee (as the AST lowering's lower_addr checks `*p`), and an
// element of one (`p[i]`).
fn place_addr(cx: &mut FnCtx<Comp>, l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    if p == 0 {
        if has_flag(l, LF_STATIC, pbody) {
            return static_address(cx, pbody.locals[l as usize].src, pcx);
        }
        return pcx.l_addr[l as usize];
    }
    let parent = proj_parent(p, pbody);
    let k = proj_kind(p, pbody);
    let v = proj_val(p, pbody);
    if k == PJ_DEREF {
        let pointer = place_value(cx, l, parent, pbody, pcx);
        if pcx.check_unsafe {
            let pointer_ty = place_ty(l, parent, pbody, pcx);
            if is_raw_pointer(pointer_ty, pcx) {
                let ir_const_v = ir_const(cx, type_size(pcx.types[pointer_ty as usize].a, pcx),
                    TY_U64, pcx);
                crate::middle::lower::calls::raw_check_at(cx, pcx.raw_pos, pointer,
                    ir_const_v, pcx);
            }
        }
        return pointer;
    }
    if k == PJ_VARIANT {
        return place_addr(cx, l, parent, pbody, pcx);
    }
    let pt = place_ty(l, parent, pbody, pcx);
    if k == PJ_FIELD || k == PJ_UNION {
        let base = place_addr(cx, l, parent, pbody, pcx);
        if parent > 0 && proj_kind(parent, pbody) == PJ_VARIANT {
            return ir_offset(cx, base, variant_field_offset(proj_val(parent, pbody), v, pcx), pcx);
        }
        let tk = pcx.types[pt as usize].kind;
        if tk == TyKind::Struct {
            return ir_offset(cx, base, field_offset(pcx.types[pt as usize].a, v, pcx), pcx);
        }
        if tk == TyKind::Tuple {
            return ir_offset(cx, base, tuple_offset(pt, v, pcx), pcx);
        }
        // (a slice's pointer and length)
        return ir_offset(cx, base, v * 8, pcx);
    }
    let elem_size = type_size(pcx.types[pt as usize].a, pcx);
    if k == PJ_CONST {
        let place_addr_v = place_addr(cx, l, parent, pbody, pcx);
        return ir_offset(cx, place_addr_v, v * elem_size, pcx);
    }
    // PJ_INDEX: element v (a local) of an array, a slice's buffer or a
    // pointer's
    let mut base: i64 = 0;
    if pcx.types[pt as usize].kind == TyKind::Ptr {
        base = place_value(cx, l, parent, pbody, pcx);
    } else if is_slice(pt, pcx) {
        let place_addr_v1 = place_addr(cx, l, parent, pbody, pcx);
        base = ir_load(cx, TY_U64, place_addr_v1, 0, pcx);
    } else {
        base = place_addr(cx, l, parent, pbody, pcx);
    }
    let index = place_value(cx, v, 0, pbody, pcx);
    let mut scaled = index;
    if elem_size != 1 {
        let ir_const_v1 = ir_const(cx, elem_size, TY_U64, pcx);
        scaled = ir_binary(cx, Op::Mul, TY_U64, index, ir_const_v1, pcx);
    }
    let at = ir_binary(cx, Op::Add, TY_U64, base, scaled, pcx);
    // (a raw pointer's element: checked, as lower_addr's `p[i]`)
    if pcx.check_unsafe && is_raw_pointer(pt, pcx) {
        let ir_const_v2 = ir_const(cx, elem_size, TY_U64, pcx);
        crate::middle::lower::calls::raw_check_at(cx, pcx.raw_pos, at,
            ir_const_v2, pcx);
    }
    at
}

// The value of place (l, p): an SSA use, a load, or a compound value's
// address.
fn place_value(cx: &mut FnCtx<Comp>, l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let ty = place_ty(l, p, pbody, pcx);
    if is_void(ty) {
        return 0;
    }
    if p == 0 && pcx.l_var[l as usize] >= 0 {
        if pcx.l_blk[l as usize] >= 0 {
            return need_value(cx, pcx.l_val[l as usize], ty, pcx);
        }
        return ssa_read(cx, pcx.l_var[l as usize], pcx.ir_cur, pcx);
    }
    let addr = place_addr(cx, l, p, pbody, pcx);
    if is_compound(ty, pcx) {
        return addr;
    }
    ir_load(cx, ir_type(ty, pcx), addr, 0, pcx)
}

// Place (l, p) = value (of the place's type; a compound one's address,
// copied).
fn write_place(cx: &mut FnCtx<Comp>, l: i64, p: i64, value: i64, pbody: &Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    let ty = place_ty(l, p, pbody, pcx);
    if is_void(ty) || ty == TY_NEVER {
        return;
    }
    if p == 0 && pcx.l_var[l as usize] >= 0 {
        if pcx.l_blk[l as usize] >= 0 {
            pcx.l_val[l as usize] = need_value(cx, value, ty, pcx);
            return;
        }
        let arg_v = pcx.l_var[l as usize];
        let need_value_v = need_value(cx, value, ty, pcx);
        ssa_write(cx, arg_v, pcx.ir_cur, need_value_v);
        return;
    }
    let place_addr_v = place_addr(cx, l, p, pbody, pcx);
    store_value(cx, place_addr_v, 0, value, ty, pcx);
}

// The value of operand i at `ops`.
fn operand(cx: &mut FnCtx<Comp>, ops: i64, i: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let k = op_kind(ops, i, pbody);
    let a = op_a(ops, i, pbody);
    let b = op_b(ops, i, pbody);
    if k == OK_COPY || k == OK_MOVE {
        return place_value(cx, a, b, pbody, pcx);
    }
    if k == OK_PLACE {
        return place_addr(cx, a, b, pbody, pcx);
    }
    if k == OK_INT {
        let t = erase_type(b, pcx);
        return ir_const(cx, a, ir_type(t, pcx), pcx);
    }
    if k == OK_FLOAT {
        let t = erase_type(b, pcx);
        return ir_const(cx, float_const(f64_of_bits(a), t), t, pcx);
    }
    if k == OK_STR {
        return string_value(cx, a, pcx);
    }
    if k == OK_CSTR {
        return emit_ir(cx, Op::SAddr, TY_U64, 0, 0, a, pcx);
    }
    if k == OK_FN {
        return emit_ir(cx, Op::FAddr, TY_U64, 0, 0, a, pcx);
    }
    if k == OK_CONST {
        return ir_const(cx, const_value(a, pcx), ir_type(erase_type(b, pcx), pcx), pcx);
    }
    0
}

// Whether operand i is a temporary's whole value, which a call may take
// over without a copy (as the AST walk's is_fresh).
pub fn op_fresh(ops: i64, i: i64, pbody: &Body<Comp>) -> bool {
    let k = op_kind(ops, i, pbody);
    if k != OK_COPY && k != OK_MOVE || op_b(ops, i, pbody) != 0 {
        return false;
    }
    let l = op_a(ops, i, pbody);
    has_flag(l, LF_TEMP, pbody) && !has_flag(l, LF_BORROWED, pbody)
}

// Binds AST node e to operand i (operand_expr reads it): a place's value,
// a constant's, or a unit's none (its expression, a call, was evaluated by
// the statement before: lowering it again would run it twice). A check's
// site, an RT_SITE value, is left to the AST's constant (lower_expr).
fn bind(cx: &mut FnCtx<Comp>, e: i64, ops: i64, i: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let k = op_kind(ops, i, pbody);
    if k == OK_UNIT {
        pcx.bound_nodes.push(e);
        pcx.bound_values.push(0);
        return;
    }
    if is_site(e, pcx) {
        return;
    }
    pcx.bound_nodes.push(e);
    let pcx_arg = operand(cx, ops, i, pbody, pcx);
    pcx.bound_values.push(pcx_arg);
}

// Whether AST node e is a check's site (0.18.1: an RT_SITE id).
pub fn is_site(e: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.nodes[e as usize].kind == NodeKind::Int
        && (pcx.nodes[e as usize].p & crate::front::ast::INT_SITE) != 0
        && pcx.nodes[e as usize].a != 0
}

fn unbind(pcx: &mut Ctx<Comp>) {
    pcx.bound_nodes.clear();
    pcx.bound_values.clear();
}

// ---- Statements ----

fn lower_stmt(cx: &mut FnCtx<Comp>, at: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let s = pbody.stmts[at as usize];
    let k = s.kind;
    if k == SK_LIVE || k == SK_DEAD || k == SK_NOP || k == SK_MENTION {
        return;
    }
    if pcx.ir_locs && s.node > 0 {
        pcx.ir_loc = pcx.nodes[s.node as usize].start + 1;
        pcx.ir_expr_loc = 0;
    }
    if s.node > 0 {
        pcx.raw_pos = pcx.nodes[s.node as usize].start;
    }
    if is_dead_block(cx, pcx.ir_cur) {
        return;
    }
    if k == SK_ASSIGN {
        lower_assign(cx, s, pbody, pcx);
    } else if k == SK_CALL {
        lower_call_stmt(cx, s, pbody, pcx);
    } else if k == SK_INTRINSIC {
        lower_intrinsic_stmt(cx, s, pbody, pcx);
    } else if k == SK_DROP {
        lower_drop(cx, s, pbody, pcx);
    } else if k == SK_ASSERT {
        // AK_BOUNDS: the index, as unsigned, below the length
        let idx = operand(cx, s.ops, 0, pbody, pcx);
        let len = operand(cx, s.ops, 1, pbody, pcx);
        let pcx_site6 = site_of(s.d, 0, pcx);
        let ir_cmp_v = ir_cmp(cx, Cond::Lt, TY_U64, idx, len, pcx);
        lower_check(cx, ir_cmp_v,
            panic_kind(op_type(s.ops, 0, pbody, pcx), false), idx, len, 0, pcx,
            pcx_site6, 0);
    }
}

// `drop(P)` kept: its type's drop shim called with `&mut P`; under a flag
// (DS_FLAG, flag local d): only when the flag is true. An opened drop
// does nothing itself (its parts' drops follow it), a removed one is gone.
fn lower_drop(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if s.c != DS_KEPT && s.c != DS_FLAG {
        return;
    }
    let f = drop_shim_fn(full_place_type(s.a, s.b, pbody, pcx), pcx);
    if f < 0 {
        return;
    }
    let mut after: i64 = 0;
    if s.c == DS_FLAG {
        let run = ir_new_block(cx);
        after = ir_new_block(cx);
        let place_value_v = place_value(cx, s.d, 0, pbody, pcx);
        lower_branch(cx, place_value_v, run, after, pcx);
        ir_seal(cx, run, pcx);
        pcx.ir_cur = run;
    }
    if s.node > 0 {
        crate::middle::checkalloc::site_before_drop(cx,
            crate::places::print::drop_pos(s.node, pcx), pcx);
    }
    let addr = place_addr(cx, s.a, s.b, pbody, pcx);
    let conv = call_conv(f, 0, pcx);
    let mark = cx.ssa_stack.len() as i64;
    push_call_arg(cx, conv, 0, addr,
        crate::middle::lower::calls::call_param_ty(conv, 0, TY_U64, pcx), false, pcx);
    emit_call_of(cx, conv, 0, mark, 0, pcx);
    if after != 0 {
        lower_jump(cx, after, pcx);
        ir_seal(cx, after, pcx);
        pcx.ir_cur = after;
    }
}

pub fn token_of(bo: i64) -> Tok {
    if bo == BO_ADD { Tok::Plus } else if bo == BO_SUB { Tok::Minus }
    else if bo == BO_MUL { Tok::Star } else if bo == BO_DIV { Tok::Slash }
    else if bo == BO_REM { Tok::Percent } else if bo == BO_AND { Tok::Amp }
    else if bo == BO_OR { Tok::Pipe } else if bo == BO_XOR { Tok::Caret }
    else if bo == BO_SHL { Tok::Shl } else if bo == BO_SHR { Tok::Shr }
    else if bo == BO_EQ { Tok::EqEq } else if bo == BO_NE { Tok::BangEq }
    else if bo == BO_LT { Tok::Lt } else if bo == BO_LE { Tok::LtEq }
    else if bo == BO_GT { Tok::Gt } else { Tok::GtEq }
}

fn lower_assign(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let rv = s.c;
    let dl = s.a;
    let dp = s.b;
    let dt = place_ty(dl, dp, pbody, pcx);
    if rv == RV_USE {
        let first = cx.inst_count;
        let operand_v = operand(cx, s.ops, 0, pbody, pcx);
        write_place(cx, dl, dp, operand_v, pbody, pcx);
        // (0.17: a move of a whole local, COPY_MOVE; copies.vl)
        if op_kind(s.ops, 0, pbody) == OK_MOVE && op_b(s.ops, 0, pbody) == 0 && dp == 0 {
            crate::middle::copies::note_move_copies(cx, first, pcx);
        }
    } else if rv == RV_REF {
        let operand_v1 = operand(cx, s.ops, 0, pbody, pcx);
        write_place(cx, dl, dp, operand_v1, pbody, pcx);
    } else if rv == RV_BINARY {
        let ot = op_type(s.ops, 0, pbody, pcx);
        if is_vector(ot, pcx) {
            lower_vector_assign(cx, s, dt, pbody, pcx);
            return;
        }
        let a = operand(cx, s.ops, 0, pbody, pcx);
        let b = operand(cx, s.ops, 1, pbody, pcx);
        if s.d == BO_DIV || s.d == BO_REM {
            lower_division_checks(cx, s, ot, a, b, pbody, pcx);
        }
        let lower_operator_v = lower_operator(cx, token_of(s.d), ot, dt, a, b, pcx);
        write_place(cx, dl, dp, lower_operator_v, pbody,
            pcx);
    } else if rv == RV_CHECKED {
        let lower_checked_v = lower_checked(cx, s, dt, pbody, pcx);
        write_place(cx, dl, dp, lower_checked_v, pbody, pcx);
    } else if rv == RV_UNARY {
        if is_vector(dt, pcx) {
            bind(cx, pcx.nodes[s.e as usize].b, s.ops, 0, pbody, pcx);
            let v = lower_vector_negate(cx, pcx.nodes[s.e as usize].b, dt, pcx);
            unbind(pcx);
            write_place(cx, dl, dp, v, pbody, pcx);
            return;
        }
        let tok = if s.d == UO_NEG { Tok::Minus } else if s.d == UO_NOT { Tok::Bang }
            else { Tok::Tilde };
        let operand_v2 = operand(cx, s.ops, 0, pbody, pcx);
        let lower_unop_v = lower_unop(cx, tok, dt, operand_v2, pcx);
        write_place(cx, dl, dp, lower_unop_v,
            pbody, pcx);
    } else if rv == RV_CAST {
        let v = operand(cx, s.ops, 0, pbody, pcx);
        let lower_cast_v = lower_cast(cx, v, op_type(s.ops, 0, pbody, pcx), erase_type(s.d, pcx),
            pcx);
        write_place(cx, dl, dp,
            lower_cast_v, pbody,
            pcx);
    } else if rv == RV_DISCR {
        let discriminant_v = discriminant(cx, s.ops, pbody, pcx);
        write_place(cx, dl, dp, discriminant_v, pbody, pcx);
    } else if rv == RV_LEN {
        let t = op_type(s.ops, 0, pbody, pcx);
        if pcx.types[t as usize].kind == TyKind::Array {
            let ir_const_v = ir_const(cx, pcx.types[t as usize].b, TY_U64, pcx);
            write_place(cx, dl, dp, ir_const_v, pbody, pcx);
        } else {
            let operand_v3 = operand(cx, s.ops, 0, pbody, pcx);
            let ir_load_v = ir_load(cx, TY_U64, operand_v3, 8, pcx);
            write_place(cx, dl, dp,
                ir_load_v, pbody, pcx);
        }
    } else if rv == RV_AGG {
        lower_aggregate(cx, s, dt, pbody, pcx);
    } else if rv == RV_REPEAT {
        lower_repeat(cx, s, dt, pbody, pcx);
    } else if rv == RV_SLICE {
        let lower_slice_v = lower_slice(cx, s, pbody, pcx);
        write_place(cx, dl, dp, lower_slice_v, pbody, pcx);
    }
}

// (0.26.3, decision 6) A checked rvalue (RV_CHECKED): the operation and
// the branch to Rust's panic at its node when it overflows (a shift's
// amount is checked first).
fn lower_checked(cx: &mut FnCtx<Comp>, s: PStmt, dt: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let site = site_of(s.e, 0, pcx);
    let ot = op_type(s.ops, 0, pbody, pcx);
    let x = operand(cx, s.ops, 0, pbody, pcx);
    if s.nops == 1 {
        let v = lower_unop(cx, Tok::Minus, dt, x, pcx);
        let kind = arith_panic_kind(UO_NEG, true, false, pcx);
        if is_signed(dt) {
            overflow_branch(cx, Op::Neg, dt, x, 0, kind, site, pcx);
        } else {
            let ir_type_v = ir_type(dt, pcx);
            let ir_const_v1 = ir_const(cx, 0, dt, pcx);
            let ir_cmp_v = ir_cmp(cx, Cond::Eq, ir_type_v, x, ir_const_v1, pcx);
            arith_check(cx,
                ir_cmp_v, kind,
                site, pcx);
        }
        return v;
    }
    let y = operand(cx, s.ops, 1, pbody, pcx);
    if s.d == BO_SHL || s.d == BO_SHR {
        let ir_const_v = ir_const(cx, int_bits(ot), TY_U64, pcx);
        let ok = ir_cmp(cx, Cond::Lt, TY_U64, y, ir_const_v, pcx);
        arith_check(cx, ok, arith_panic_kind(s.d, false, false, pcx), site, pcx);
        return lower_operator(cx, token_of(s.d), ot, dt, x, y, pcx);
    }
    let r = lower_operator(cx, token_of(s.d), ot, dt, x, y, pcx);
    let op = if s.d == BO_ADD { Op::Add } else if s.d == BO_SUB { Op::Sub } else { Op::Mul };
    overflow_branch(cx, op, ot, x, y, arith_panic_kind(s.d, false, false, pcx), site,
        pcx);
    r
}

// (0.26.3, decision 6) The checks of an integer `a / b` or `a % b`
// (RV_BINARY), at every level: b is not 0, and (signed) not a MIN / -1,
// each a branch to Rust's panic at its node. A constant divisor needs
// neither, or only the second when it is -1.
fn lower_division_checks(cx: &mut FnCtx<Comp>, s: PStmt, ot: i64, a: i64, b: i64,
    pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if !is_integer(ot) {
        return;
    }
    let site = site_of(s.e, 0, pcx);
    let k = op_kind(s.ops, 1, pbody);
    let known = k == OK_INT || k == OK_CONST;
    let value: i64 = if k
        == OK_INT { wrap_int(op_a(s.ops, 1, pbody), erase_type(op_b(s.ops, 1, pbody), pcx)) }
        else if k == OK_CONST { const_value(op_a(s.ops, 1, pbody), pcx) } else { 0 };
    if !known || value == 0 {
        let ir_type_v2 = ir_type(ot, pcx);
        let ir_const_v2 = ir_const(cx, 0, ot, pcx);
        let ir_cmp_v = ir_cmp(cx, Cond::Ne, ir_type_v2, b, ir_const_v2, pcx);
        arith_check(cx, ir_cmp_v,
            arith_panic_kind(s.d, false, true, pcx), site, pcx);
    }
    if is_signed(ot) && (!known || value == -1) {
        let min = (0 - 1) << (int_bits(ot) - 1) as u64;
        let ir_type_v = ir_type(ot, pcx);
        let ir_const_v = ir_const(cx, min, ot, pcx);
        let not_min = ir_cmp(cx, Cond::Ne, ir_type_v, a, ir_const_v, pcx);
        let ir_type_v1 = ir_type(ot, pcx);
        let ir_const_v1 = ir_const(cx, 0 - 1, ot, pcx);
        let not_minus_one = ir_cmp(cx, Cond::Ne, ir_type_v1, b,
            ir_const_v1, pcx);
        let ir_binary_v = ir_binary(cx, Op::Or, TY_BOOL, not_min, not_minus_one, pcx);
        arith_check(cx, ir_binary_v,
            arith_panic_kind(s.d, false, false, pcx), site, pcx);
    }
}

// A binary operation on vectors (its node: the Binary, or the Assign of
// `v op= x`), by vector.vl's lowering, its operands bound.
fn lower_vector_assign(cx: &mut FnCtx<Comp>, s: PStmt, dt: i64, pbody: &Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    let n = s.e;
    if pcx.nodes[n as usize].kind == NodeKind::Assign {
        let value = pcx.nodes[n as usize].c;
        bind(cx, value, s.ops, 1, pbody, pcx);
        let mut hi: i64 = 0;
        let v = vector_assign_value(cx, value, &mut hi, pcx);
        unbind(pcx);
        let token_of_v = token_of(s.d);
        let place_addr_v = place_addr(cx, s.a, s.b, pbody, pcx);
        vector_assign_store(cx, token_of_v, dt, place_addr_v, v, hi,
            pcx);
        return;
    }
    bind(cx, pcx.nodes[n as usize].b, s.ops, 0, pbody, pcx);
    bind(cx, pcx.nodes[n as usize].c, s.ops, 1, pbody, pcx);
    let v = lower_vector_binary(cx, pcx.nodes[n as usize].op, pcx.nodes[n as usize].b,
        pcx.nodes[n as usize].c, dt, pcx);
    unbind(pcx);
    write_place(cx, s.a, s.b, v, pbody, pcx);
}

// The discriminant of place ops[0], an enum: a scalar enum's value, the
// null niche's test, else the tag in memory.
fn discriminant(cx: &mut FnCtx<Comp>, ops: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    // UNSAFE: the checker's ENUMS and VARIANTS are static mut, cx is the
    // lowering's raw context pointer.
    // SAFETY: t is the checked enum type of operand 0, so TYPES[t].a is an ENUMS
    // index; v stays below VARIANT_COUNT; set was just emitted into cx.insts.
    unsafe {
        let t = op_type(ops, 0, pbody, pcx);
        let e = pcx.types[t as usize].a;
        let tag = (*get_enums().add(e as usize)).tag;
        if !is_compound(t, pcx) {
            return place_value(cx, op_a(ops, 0, pbody), op_b(ops, 0, pbody), pbody, pcx);
        }
        let addr = operand(cx, ops, 0, pbody, pcx);
        if enum_niche(e, pcx) {
            // (the variant with the pointer when it is not null)
            let mut some: i64 = 0;
            let mut none: i64 = 0;
            for v in 0..pcx.variants.len() as i64 {
                if pcx.variants[v as usize].enum_id == e {
                    if pcx.variants[v as usize].field_count == 1 {
                        some = wrap_int(pcx.variants[v as usize].discr, tag);
                    } else {
                        none = wrap_int(pcx.variants[v as usize].discr, tag);
                    }
                }
            }
            let word = ir_load(cx, TY_U64, addr, 0, pcx);
            let ir_type_v = ir_type(tag, pcx);
            let ir_const_v2 = ir_const(cx, 0, TY_U64, pcx);
            let ir_cmp_v = ir_cmp(cx, Cond::Ne, TY_U64, word, ir_const_v2, pcx);
            let set = emit_ir(cx, Op::Conv, ir_type_v,
                ir_cmp_v, 0, 0, pcx);
            (*cx.insts.add(set as usize)).imm2 = TY_BOOL;
            if some == 1 && none == 0 {
                return set;
            }
            let ir_type_v1 = ir_type(tag, pcx);
            let ir_const_v = ir_const(cx, some - none, tag, pcx);
            let diff = ir_binary(cx, Op::Mul, ir_type_v1, set,
                ir_const_v, pcx);
            let ir_type_v2 = ir_type(tag, pcx);
            let ir_const_v1 = ir_const(cx, none, tag, pcx);
            return ir_binary(cx, Op::Add, ir_type_v2, diff, ir_const_v1,
                pcx);
        }
        ir_load(cx, ir_type(tag, pcx), addr, 0, pcx)
    }
}

// An aggregate into its place: built there, or, when an operand reads
// the place's local (`p = P { x: p.y, .. }`), in a new slot then copied.
fn lower_aggregate(cx: &mut FnCtx<Comp>, s: PStmt, dt: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // UNSAFE: the checker's ENUMS and VARIANTS are static mut, struct_field
    // returns a raw pointer into the checker's field table.
    // SAFETY: dt is the place's checked type (an enum's for a variant, so
    // TYPES[dt].a is an ENUMS index); s.e is the builder's variant of that enum;
    // i is below the struct's field count (the builder makes one operand a field).
    unsafe {
        let ak = s.d;
        if ak == AK_VARIANT && !is_compound(dt, pcx) {
            let v = s.e;
            let ir_const_v = ir_const(cx, wrap_int(pcx.variants[v as usize].discr,
                (*get_enums().add(pcx.types[dt as usize].a as usize)).tag), ir_type(dt, pcx), pcx);
            write_place(cx, s.a, s.b, ir_const_v, pbody, pcx);
            return;
        }
        let mut in_place = s.b == 0 && pcx.l_var[s.a as usize] < 0
            && !has_flag(s.a, LF_STATIC, pbody);
        for i in 0..s.nops {
            let k = op_kind(s.ops, i, pbody);
            if (k == OK_COPY || k == OK_MOVE || k == OK_PLACE) && op_a(s.ops, i, pbody) == s.a {
                in_place = false;
            }
        }
        let base = if in_place { place_addr(cx, s.a, 0, pbody, pcx) }
            else {
                let new_slot_for_v = new_slot_for(cx, dt, pcx);
                ir_slot_addr(cx, new_slot_for_v, pcx)
            };
        if ak == AK_VARIANT {
            let v = s.e;
            let tag = (*get_enums().add(pcx.types[dt as usize].a as usize)).tag;
            if enum_niche(pcx.types[dt as usize].a, pcx) {
                if s.nops == 1 {
                    let operand_v = operand(cx, s.ops, 0, pbody, pcx);
                    store_value(cx, base, 0, operand_v,
                        op_type(s.ops, 0, pbody, pcx), pcx);
                } else {
                    let ir_const_v1 = ir_const(cx, 0, TY_U64, pcx);
                    ir_store(cx, TY_U64, base, ir_const_v1, 0, pcx);
                }
            } else {
                for i in 0..s.nops {
                    let variant_field_offset_v = variant_field_offset(v, i, pcx);
                    let operand_v1 = operand(cx, s.ops, i, pbody, pcx);
                    store_value(cx, base, variant_field_offset_v,
                        operand_v1,
                        erase_type(crate::front::types::variant_field(v, i, pcx), pcx), pcx);
                }
                let ir_const_v2 = ir_const(cx, wrap_int(pcx.variants[v as usize].discr, tag), tag,
                    pcx);
                ir_store(cx, tag, base,
                    ir_const_v2, 0, pcx);
            }
        } else {
            for i in 0..s.nops {
                let mut offset: i64 = 0;
                let mut elem_ty: i64 = 0;
                if ak == AK_STRUCT || ak == AK_CLOSURE {
                    let st = pcx.types[dt as usize].a;
                    offset = field_offset(st, i, pcx);
                    elem_ty = erase_type((*crate::front::types::struct_field(st, i, pcx)).ty, pcx);
                } else if ak == AK_TUPLE {
                    offset = tuple_offset(dt, i, pcx);
                    elem_ty = erase_type(crate::front::types::type_elem(dt, i, pcx), pcx);
                } else {
                    elem_ty = erase_type(pcx.types[dt as usize].a, pcx);
                    offset = i * type_size(elem_ty, pcx);
                }
                // (a union literal's fields not written: `const ()`)
                if op_kind(s.ops, i, pbody) == OK_UNIT {
                    continue;
                }
                let operand_v2 = operand(cx, s.ops, i, pbody, pcx);
                store_value(cx, base, offset, operand_v2, elem_ty, pcx);
            }
        }
        if !in_place {
            write_place(cx, s.a, s.b, base, pbody, pcx);
        }
    }
}

// `[x; n]` into its place (as expr.vl's lower_repeat): x stored n times,
// by a loop past four.
fn lower_repeat(cx: &mut FnCtx<Comp>, s: PStmt, dt: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let elem_ty = erase_type(pcx.types[dt as usize].a, pcx);
    let count = pcx.types[dt as usize].b;
    let elem_size = type_size(elem_ty, pcx);
    let value = operand(cx, s.ops, 0, pbody, pcx);
    let in_place = s.b == 0 && pcx.l_var[s.a as usize] < 0 && !has_flag(s.a, LF_STATIC, pbody);
    let base = if in_place { place_addr(cx, s.a, 0, pbody, pcx) }
        else {
            let new_slot_for_v = new_slot_for(cx, dt, pcx); ir_slot_addr(cx, new_slot_for_v, pcx)
        };
    if count > 0 && !is_void(elem_ty) && elem_size > 0 {
        if count <= 4 {
            for i in 0..count {
                store_value(cx, base, i * elem_size, value, elem_ty, pcx);
            }
        } else {
            let cursor = new_synth_var(cx, TY_U64, pcx);
            ssa_write(cx, cursor, pcx.ir_cur, base);
            let end = ir_offset(cx, base, count * elem_size, pcx);
            let body = ir_new_block(cx);
            let exit = ir_new_block(cx);
            lower_jump(cx, body, pcx);
            pcx.ir_cur = body;
            let at = ssa_read(cx, cursor, body, pcx);
            store_value(cx, at, 0, value, elem_ty, pcx);
            let next = ir_offset(cx, at, elem_size, pcx);
            ssa_write(cx, cursor, pcx.ir_cur, next);
            let ir_cmp_v = ir_cmp(cx, Cond::Ne, TY_U64, next, end, pcx);
            lower_branch(cx, ir_cmp_v, body, exit, pcx);
            ir_seal(cx, body, pcx);
            ir_seal(cx, exit, pcx);
            pcx.ir_cur = exit;
        }
    }
    if !in_place {
        write_place(cx, s.a, s.b, base, pbody, pcx);
    }
}

// `base[lo..hi]`: the base (a pointer's value, a slice's or an array's
// address), the bounds (absent: OK_UNIT), checked (expr.vl's
// slice_of_values).
fn lower_slice(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let bt = op_type(s.ops, 0, pbody, pcx);
    let value = if pcx.types[bt as usize].kind
        == TyKind::Ptr {
        place_value(cx, op_a(s.ops, 0, pbody), op_b(s.ops, 0, pbody), pbody, pcx)
    }
        else { operand(cx, s.ops, 0, pbody, pcx) };
    let mut bound_ty = TY_U64;
    let mut lo: i64 = 0;
    if op_kind(s.ops, 1, pbody) != OK_UNIT {
        lo = operand(cx, s.ops, 1, pbody, pcx);
        bound_ty = op_type(s.ops, 1, pbody, pcx);
    } else {
        lo = ir_const(cx, 0, TY_U64, pcx);
    }
    let mut hi: i64 = 0;
    if op_kind(s.ops, 2, pbody) != OK_UNIT {
        hi = operand(cx, s.ops, 2, pbody, pcx);
        bound_ty = op_type(s.ops, 2, pbody, pcx);
    }
    slice_of_values(cx, s.d, bt, value, lo, hi, bound_ty, pcx)
}

// ---- Calls and intrinsics ----

// A call: by the AST's lower_call of its node with the operands bound
// (its intrinsics, bit counts, atomics, contracts and convention), or, for
// one the builder made, by the convention's helpers.
fn lower_call_stmt(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let n = s.node;
    let f = s.c;
    let mut value: i64 = 0;
    if pcx.ir_call_locs && n > 0 {
        pcx.ir_expr_loc = pcx.nodes[n as usize].start + 1;
    }
    let skip: i64 = if f < 0 { 1 } else { 0 };
    // (a compound result made in its destination: a whole local whose
    // storage nothing borrows, not a parameter's)
    let dest = call_dest(s.a, s.b, pbody, pcx);
    pcx.result_dest = dest;
    if n > 0 && pcx.nodes[n as usize].kind == NodeKind::Call && pcx.nodes[n as usize].x - 1 == f
        && pcx.nodes[n as usize].count + skip == s.nops {
        if f < 0 {
            bind(cx, pcx.nodes[n as usize].a, s.ops, 0, pbody, pcx);
        }
        for i in 0..pcx.nodes[n as usize].count {
            bind(cx, child(n, i, pcx), s.ops, i + skip, pbody, pcx);
        }
        value = lower_call(cx, n, pcx);
        unbind(pcx);
    } else {
        let callee_ty: i64 = if f < 0 { op_type(s.ops, 0, pbody, pcx) } else { 0 };
        let conv = call_conv(f, callee_ty, pcx);
        let mark = cx.ssa_stack.len() as i64;
        for i in skip..s.nops {
            let ty = crate::middle::lower::calls::call_param_ty(conv, i - skip,
                op_type(s.ops, i, pbody, pcx), pcx);
            let operand_v = operand(cx, s.ops, i, pbody, pcx);
            push_call_arg(cx, conv, i - skip, operand_v, ty,
                op_fresh(s.ops, i, pbody), pcx);
        }
        let callee: i64 = if f < 0 { operand(cx, s.ops, 0, pbody, pcx) } else { 0 };
        value = emit_call_of(cx, conv, callee, mark, n, pcx);
    }
    pcx.result_dest = 0;
    if dest == 0 || value != dest {
        write_place(cx, s.a, s.b, value, pbody, pcx);
    }
}

// (0.26.2) A check's failing path, the places IR's: the builder branches
// on each conjunct (s.e) of a requires, ensures, invariant or assert and
// makes this block for its false, then `unreachable`; ops[0] is that
// false, ops[1] the site, ops[2..] the shown values (0 to 3, of any
// integer width: widened to 64 bits). Only the message's text is the
// AST's (calls.vl's contract_failure_at).
fn lower_contract_failure(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // (the site: a `$pre` function's SITE parameter, or the check's own,
    // an RT_SITE value: the AST's constant, as bind leaves it)
    let mut site: i64 = 0;
    let site_kind = op_kind(s.ops, 1, pbody);
    if site_kind == OK_COPY || site_kind == OK_MOVE {
        let site_ty = op_type(s.ops, 1, pbody, pcx);
        let operand_v = operand(cx, s.ops, 1, pbody, pcx);
        site = need_value(cx, operand_v, site_ty, pcx);
        if site_ty != TY_I64 {
            site = lower_cast(cx, site, site_ty, TY_I64, pcx);
        }
    } else {
        let lower_expr_v = crate::middle::lower::expr::lower_expr(cx, child(s.d, 1, pcx), pcx);
        site = need_value(cx,
            lower_expr_v, TY_I64, pcx);
    }
    let mut values: [i64; 3] = [0i64; 3];
    for i in 0..s.nops - 2 {
        let ty = op_type(s.ops, i + 2, pbody, pcx);
        let operand_v1 = operand(cx, s.ops, i + 2, pbody, pcx);
        let mut v = need_value(cx, operand_v1, ty, pcx);
        let wide = if is_signed(ty) { TY_I64 } else { TY_U64 };
        if ty != wide {
            v = lower_cast(cx, v, ty, wide, pcx);
        }
        values[i as usize] = v;
    }
    crate::middle::lower::calls::contract_failure_at(cx, s.d, s.e, site, values[0], values[1],
        values[2], pcx);
}

fn lower_intrinsic_stmt(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let n = s.d;
    if s.c == IK_PANIC {
        let operand_v = operand(cx, s.ops, 0, pbody, pcx);
        let value = lower_cast(cx, operand_v,
            op_type(s.ops, 0, pbody, pcx), TY_I64, pcx);
        let pcx_site7 = site_of(n, 0, pcx);
        lower_panic(cx, pcx.nodes[n as usize].x, value, pcx, pcx_site7);
        return;
    }
    let mut value: i64 = 0;
    if s.c == IK_CONTRACT {
        lower_contract_failure(cx, s, pbody, pcx);
        return;
    }
    if s.c == IK_VECTOR {
        let mut j: i64 = 0;
        if pcx.nodes[n as usize].a != 0 {
            bind(cx, pcx.nodes[n as usize].a, s.ops, 0, pbody, pcx);
            j = 1;
        }
        for i in 0..pcx.nodes[n as usize].count {
            bind(cx, child(n, i, pcx), s.ops, i + j, pbody, pcx);
        }
        value = lower_vecop(cx, n, pcx);
    } else {
        // IK_ARCH: std::arch's intrinsics, by lower_call (which lowers the
        // ones its table has a form for, and calls the others)
        for i in 0..pcx.nodes[n as usize].count {
            bind(cx, child(n, i, pcx), s.ops, i, pbody, pcx);
        }
        value = lower_call(cx, n, pcx);
    }
    unbind(pcx);
    write_place(cx, s.a, s.b, value, pbody, pcx);
}

// ---- Terminators ----

fn lower_term(cx: &mut FnCtx<Comp>, at: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let s = pbody.stmts[at as usize];
    let k = s.kind;
    if pcx.ir_locs && s.node > 0 {
        pcx.ir_loc = pcx.nodes[s.node as usize].start + 1;
        pcx.ir_expr_loc = 0;
    }
    if s.node > 0 {
        pcx.raw_pos = pcx.nodes[s.node as usize].start;
    }
    if k == TK_GOTO {
        // (a jump to the return block, which has nothing else: the return
        // itself, as the AST walk lowers each `return`: no join of the
        // results, and the copy to the result pointer ends a returning
        // block, middle/copies.vl)
        let t = s.a;
        if block_len(t, pbody) == 0
            && pbody.stmts[block_term(t, pbody) as usize].kind == TK_RETURN {
            lower_ret(cx, pbody, pcx);
            return;
        }
        let mid_v = mid(cx, t, pcx);
        lower_jump(cx, mid_v, pcx);
    } else if k == TK_SWITCH {
        lower_switch(cx, s, pbody, pcx);
    } else if k == TK_RETURN {
        lower_ret(cx, pbody, pcx);
    } else {
        ir_terminate(cx, pcx.ir_cur, Term::Unreach, 0, 0, 0);
    }
}

// `return`: _0 is the result (built in place through the result pointer,
// or returned by mod.vl's lower_return).
fn lower_ret(cx: &mut FnCtx<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if is_dead_block(cx, pcx.ir_cur) {
        ir_terminate(cx, pcx.ir_cur, Term::Unreach, 0, 0, 0);
        return;
    }
    // UNSAFE: IRFUNCS is the IR's raw table of functions.
    // SAFETY: cx.irf is the function being lowered, made by ir_new_func.
    let rp = unsafe { (*get_irfuncs().add(cx.irf as usize)).result_ptr };
    if rp != 0 {
        // UNSAFE: as above.
        // SAFETY: as above.
        let f = unsafe { (*get_irfuncs().add(cx.irf as usize)).f };
        let result: i64 = if crate::base::target::get_x86() && fn_uses_c(f, pcx) { rp } else { 0 };
        ir_terminate(cx, pcx.ir_cur, Term::Ret, result, 0, 0);
        return;
    }
    let place_value_v = place_value(cx, 0, 0, pbody, pcx);
    lower_return(cx, place_value_v, pcx);
    // (lower_return leaves a dead block current)
    ir_terminate(cx, pcx.ir_cur, Term::Unreach, 0, 0, 0);
}

// `switch op [v: b, .., otherwise: c]`: a bool's a branch, else a Switch.
fn lower_switch(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let ty = op_type(s.ops, 0, pbody, pcx);
    let v = operand(cx, s.ops, 0, pbody, pcx);
    let otherwise = mid(cx, s.c, pcx);
    if s.b == 1 && pbody.targets[s.a as usize] == 0 && ty == TY_BOOL {
        let when_false = mid(cx, pbody.targets[(s.a + 1) as usize], pcx);
        // (both ways forwarded to one block: a jump, no branch to one
        // block twice)
        if when_false == otherwise {
            lower_jump(cx, otherwise, pcx);
        } else {
            lower_branch(cx, v, otherwise, when_false, pcx);
        }
        return;
    }
    if is_dead_block(cx, pcx.ir_cur) {
        ir_terminate(cx, pcx.ir_cur, Term::Unreach, 0, 0, 0);
        return;
    }
    // (one Switch: the (value, block) pairs on the SSA stack)
    let mark = cx.ssa_stack.len() as i64;
    for i in 0..s.b {
        cx.ssa_stack.push(pbody.targets[(s.a + 2 * i) as usize]);
        let mid_v = mid(cx, pbody.targets[(s.a + 2 * i + 1) as usize], pcx);
        cx.ssa_stack.push(mid_v);
    }
    ir_switch(cx, pcx.ir_cur, v, otherwise, mark);
}

// The address a call with destination (l, p) builds its compound result
// in: a whole local's slot when nothing borrows it (the callee cannot see
// it before it returns), else 0.
fn call_dest(l: i64, p: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let ty = pcx.l_ty[l as usize];
    if p != 0 || !is_compound(ty, pcx) || pcx.l_var[l as usize] >= 0
        || pcx.l_borrowed[l as usize] != 0
        || has_flag(l, LF_STATIC, pbody) || l >= 1 && l <= pbody.params {
        return 0;
    }
    pcx.l_addr[l as usize]
}

// Notes a use or write of local l in block b.
fn seen_in(l: i64, b: i64, pcx: &mut Ctx<Comp>) {
    if pcx.l_blk[l as usize] == -1 {
        pcx.l_blk[l as usize] = b;
    } else if pcx.l_blk[l as usize] != b {
        pcx.l_blk[l as usize] = -2;
    }
}

// Notes the locals place (l, p) names (its index locals too) in block b.
fn place_seen(l: i64, p: i64, b: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    seen_in(l, b, pcx);
    let mut q = p;
    while q > 0 {
        if proj_kind(q, pbody) == PJ_INDEX {
            seen_in(proj_val(q, pbody), b, pcx);
        }
        q = proj_parent(q, pbody);
    }
}

// The one pass over the body held before it is lowered, its reachable
// blocks (RPO) only: each local's type (erased, L_TY), the block it is used
// in (L_BLK: -2 several; the result and the parameters are written in the
// entry), whether it is borrowed whole (L_BORROWED: the place of an
// RV_REF, or the base of an RV_SLICE, with no `*` in it; a pointer
// slicing's base is read); and what keeps the body from being lowered
// here: 0 nothing, -1 a drop that runs, else a code for the statement
// (kind * 100 + its subkind).
fn scan_body(types_only: bool, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let n = local_count(pbody);
    pcx.l_ty.clear();
    pcx.l_blk.clear();
    pcx.l_val.clear();
    pcx.l_borrowed.clear();
    for l in 0..n {
        let pcx_arg = erase_type(pbody.locals[l as usize].ty, pcx);
        pcx.l_ty.push(pcx_arg);
    }
    if !types_only {
        for l in 0..n {
            pcx.l_blk.push(if l <= pbody.params { -2 } else { -1 });
            pcx.l_val.push(0);
            pcx.l_borrowed.push(0);
        }
    }
    pcx.pj_ty.clear();
    pcx.pj_root.clear();
    for _ in 0..pbody.projs.len() as i64 {
        pcx.pj_ty.push(0);
        pcx.pj_root.push(-1);
    }
    for i in 0..pbody.rpo.len() {
        let b = pbody.rpo[i];
        let start = block_start(b, pbody);
        for j in 0..block_len(b, pbody) + 1 {
            let at = start + j;
            let k = pbody.stmts[at as usize].kind;
            let c = pbody.stmts[at as usize].c;
            let ops = pbody.stmts[at as usize].ops;
            let nops = pbody.stmts[at as usize].nops;
            if k == SK_ASSIGN {
                let e = pbody.stmts[at as usize].e;
                // (a vector operation the builder made has no node)
                if (c == RV_BINARY || c == RV_UNARY) && e == 0
                    && is_vector(op_type(ops, 0, pbody, pcx), pcx) {
                    return k * 100 + c;
                }
                if !types_only && (c == RV_REF || c == RV_SLICE) {
                    let l = op_a(ops, 0, pbody);
                    let p = op_b(ops, 0, pbody);
                    if !through_deref(p, pbody)
                        && (c == RV_REF
                            || { let at_ix = place_ty(l, p, pbody, pcx) as usize; pcx.types[at_ix] }.kind != TyKind::Ptr) {
                        pcx.l_borrowed[l as usize] = 1;
                    }
                }
            } else if k == SK_DROP {
                // (a drop that runs: its place's address goes to the shim; a
                // shim made for its type, places/shim.vl)
                if c == DS_KEPT || c == DS_FLAG {
                    let t = crate::places::ir::full_place_type(pbody.stmts[at as usize].a,
                        pbody.stmts[at as usize].b, pbody, pcx);
                    if drop_shim_fn(t, pcx) < 0 && crate::places::glue::has_glue(t, pcx) {
                        return -1;
                    }
                    if !types_only && !through_deref(pbody.stmts[at as usize].b, pbody) {
                        pcx.l_borrowed[pbody.stmts[at as usize].a as usize] = 1;
                    }
                } else if c != DS_REMOVED && c != DS_OPEN {
                    return -1;
                }
            } else if k == SK_INTRINSIC {
                if c != IK_VECTOR && c != IK_ARCH && c != IK_PANIC && c != IK_CONTRACT {
                    return k * 100 + c;
                }
            } else if k == SK_ASSERT {
                if c != AK_BOUNDS {
                    return k * 100 + c;
                }
            }
            if types_only {
                continue;
            }
            if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC || k == SK_DROP
                || k == SK_MENTION {
                place_seen(pbody.stmts[at as usize].a, pbody.stmts[at as usize].b, b, pbody, pcx);
            }
            for o in 0..nops {
                let ok = op_kind(ops, o, pbody);
                if ok == OK_COPY || ok == OK_MOVE || ok == OK_PLACE {
                    place_seen(op_a(ops, o, pbody), op_b(ops, o, pbody), b, pbody, pcx);
                }
            }
        }
    }
    0
}
