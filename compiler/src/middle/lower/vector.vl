// Lowering vector expressions (0.10).
//
// A vector expression's value is an address, as for other compound types;
// its operations load their operands (once, in order: the value is taken
// before the next operand is evaluated, as -O0 copies it), compute with
// the vector instructions, and store the result into a new slot. Scalar
// replacement turns those slots into values.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{
    VK_FROM_BITS, VK_LANE, VK_LOAD, VK_NEW, VK_SELECT, VK_SPLAT, VK_STORE, VK_SUM, child,
};
use crate::front::contracts::sites::site_of;
use crate::front::lexer::Tok;
use crate::front::parser::exprs::is_comparison;
use crate::front::types::{
    TY_I64, TY_U64, is_float, is_slice, type_size, vec_elem, vec_lanes, vector_half,
};
use crate::gen0::target::{PANIC_INDEX_SIGNED, PANIC_RANGE_SIGNED};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Cond, Op, cond_of_token, emit_ir, ir_binary, ir_cmp, ir_const, ir_load, ir_slot_addr, ir_store,
    ir_type,
};
use crate::middle::lower::new_slot_for;
use crate::middle::lower::calls::lower_check;
use crate::middle::lower::expr::{arith_op, operand_value};

// The value of vector expression e (of its vector type).
pub fn vec_operand(cx: &mut FnCtx, e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let addr = operand_value(cx, e, pcx);
    ir_load(cx, pcx.nodes[e as usize].ty, addr, 0, pcx)
}

// The address of a new slot holding vector `value`.
pub fn vec_result(cx: &mut FnCtx, value: i64, vt: i64, pcx: &Ctx<Comp>) -> i64 {
    let new_slot_for_v = new_slot_for(cx, vt, pcx);
    let base = ir_slot_addr(cx, new_slot_for_v, pcx);
    ir_store(cx, vt, base, value, 0, pcx);
    base
}

// a <token> b on vectors of type vt; the result of type `result_ty`.
pub fn vector_operator(cx: &mut FnCtx, token: Tok, vt: i64, result_ty: i64, a: i64, b: i64,
    pcx: &Ctx<Comp>) -> i64 {
    if is_comparison(token) {
        let v = emit_ir(cx, Op::VCmp, result_ty, a, b, 0, pcx);
        unsafe {
            (*cx.insts.add(v as usize)).cond = cond_of_token(token);
            (*cx.insts.add(v as usize)).imm2 = vt;
        }
        return v;
    }
    emit_ir(cx, Op::VBin, vt, a, b, arith_op(token) as i64, pcx)
}

// The first element's address and the length of the slice or array of
// type ty at `value` (its address), read when called.
pub fn lower_elements(cx: &mut FnCtx, ty: i64, value: i64, len: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    if is_slice(ty, pcx) {
        *len = ir_load(cx, TY_U64, value, 8, pcx);
        return ir_load(cx, TY_U64, value, 0, pcx);
    }
    *len = ir_const(cx, pcx.types[ty as usize].b, TY_U64, pcx);
    value
}

// The address of lanes index..index + lanes of s (checked). s is
// evaluated first, to its address; a slice's pointer and length are read
// after the index, as in `s[i]`.
fn lower_vector_address(cx: &mut FnCtx, s: i64, index: i64, vt: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut len: i64 = 0;
    let value = operand_value(cx, s, pcx);
    let idx = operand_value(cx, index, pcx);
    let base = lower_elements(cx, pcx.nodes[s as usize].ty, value, &mut len, pcx);
    let lanes = vec_lanes(vt, pcx);
    let ir_const_v = ir_const(cx, lanes, TY_I64, pcx);
    let end = ir_binary(cx, Op::Add, TY_I64, idx, ir_const_v, pcx);
    let ir_const_v1 = ir_const(cx, lanes, TY_I64, pcx);
    let room = ir_binary(cx, Op::Sub, TY_I64, len, ir_const_v1, pcx);
    let pcx_site8 = site_of(index, 0, pcx);
    let ir_cmp_v = ir_cmp(cx, Cond::Le, TY_I64, idx, room, pcx);
    lower_check(cx, ir_cmp_v, PANIC_RANGE_SIGNED, idx, end,
        len, pcx, pcx_site8, 0);
    let pcx_site9 = site_of(index, 0, pcx);
    let ir_const_v2 = ir_const(cx, 0, TY_I64, pcx);
    let ir_cmp_v1 = ir_cmp(cx, Cond::Ge, TY_I64, idx, ir_const_v2, pcx);
    lower_check(cx, ir_cmp_v1,
        PANIC_RANGE_SIGNED, idx, end, len, pcx, pcx_site9, 0);
    let size = type_size(vec_elem(vt, pcx), pcx);
    let ir_const_v3 = ir_const(cx, size, TY_U64, pcx);
    let ir_binary_v = ir_binary(cx, Op::Mul, TY_U64, idx, ir_const_v3, pcx);
    ir_binary(cx, Op::Add, TY_U64, base,
        ir_binary_v, pcx)
}

// The lane index `index` (an expression), checked against vt's lanes.
fn lower_lane_index(cx: &mut FnCtx, index: i64, vt: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let idx = operand_value(cx, index, pcx);
    let lanes = ir_const(cx, vec_lanes(vt, pcx), TY_U64, pcx);
    let pcx_site10 = site_of(index, 0, pcx);
    let ir_cmp_v = ir_cmp(cx, Cond::Lt, TY_U64, idx, lanes, pcx);
    lower_check(cx, ir_cmp_v, PANIC_INDEX_SIGNED, idx, lanes,
        0, pcx, pcx_site10, 0);
    idx
}

// The constant value of IR value v when it is a lane of a vector of
// `lanes` lanes (-1 when not a constant).
fn const_lane(cx: &mut FnCtx, v: i64, lanes: i64) -> i64 {
    unsafe {
        if (*cx.insts.add(v as usize)).op == Op::Const && (*cx.insts.add(v as usize)).imm >= 0
            && (*cx.insts.add(v as usize)).imm < lanes {
            return (*cx.insts.add(v as usize)).imm;
        }
        -1
    }
}

pub fn lower_vecop(cx: &mut FnCtx, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let kind = pcx.nodes[n as usize].x;
    let vt = pcx.nodes[n as usize].y;
    if is_wide(vt, pcx) {
        return lower_wide_vecop(cx, n, pcx);
    }
    let elem = vec_elem(vt, pcx);
    let lanes = vec_lanes(vt, pcx);
    let esize = type_size(elem, pcx);
    if kind == VK_NEW || kind == VK_SPLAT {
        let first = operand_value(cx, child(n, 0, pcx), pcx);
        let mut v = emit_ir(cx, Op::VSplat, vt, first, 0, 0, pcx);
        if kind == VK_NEW {
            for i in 1..lanes {
                let x = operand_value(cx, child(n, i, pcx), pcx);
                v = emit_ir(cx, Op::VIns, vt, v, x, i, pcx);
            }
        }
        return vec_result(cx, v, vt, pcx);
    }
    if kind == VK_FROM_BITS {
        // (0.19) a register-preserving conversion (the allocator gives
        // the result its operand's register)
        let e = child(n, 0, pcx);
        let a = vec_operand(cx, e, pcx);
        let vec_cast_v = vec_cast(cx, a, pcx.nodes[e as usize].ty, vt, pcx);
        return vec_result(cx, vec_cast_v, vt, pcx);
    }
    if kind == VK_LOAD {
        let addr = lower_vector_address(cx, child(n, 0, pcx), child(n, 1, pcx), vt, pcx);
        let ir_load_v = ir_load(cx, vt, addr, 0, pcx);
        return vec_result(cx, ir_load_v, vt, pcx);
    }
    let a = vec_operand(cx, pcx.nodes[n as usize].a, pcx);
    if kind == VK_STORE {
        let addr = lower_vector_address(cx, child(n, 0, pcx), child(n, 1, pcx), vt, pcx);
        ir_store(cx, vt, addr, a, 0, pcx);
        return 0;
    }
    if kind == VK_SUM {
        return emit_ir(cx, Op::VSum, ir_type(elem, pcx), a, 0, 0, pcx);
    }
    if kind == VK_SELECT {
        let x = vec_operand(cx, child(n, 0, pcx), pcx);
        let y = vec_operand(cx, child(n, 1, pcx), pcx);
        let ty = pcx.nodes[child(n, 0, pcx) as usize].ty;
        let vec_select_v = vec_select(cx, ty, a, x, y, pcx);
        return vec_result(cx, vec_select_v, ty, pcx);
    }
    let idx = lower_lane_index(cx, child(n, 0, pcx), vt, pcx);
    let lane = const_lane(cx, idx, lanes);
    if kind == VK_LANE {
        if lane >= 0 {
            return emit_ir(cx, Op::VExt, ir_type(elem, pcx), a, 0, lane, pcx);
        }
        let base = vec_result(cx, a, vt, pcx);
        let ir_const_v = ir_const(cx, esize, TY_U64, pcx);
        let ir_binary_v = ir_binary(cx, Op::Mul, TY_U64, idx, ir_const_v,
            pcx);
        let at = ir_binary(cx, Op::Add, TY_U64, base,
            ir_binary_v, pcx);
        return ir_load(cx, ir_type(elem, pcx), at, 0, pcx);
    }
    // VK_WITH
    let x = operand_value(cx, child(n, 1, pcx), pcx);
    if lane >= 0 {
        let emit_ir_v = emit_ir(cx, Op::VIns, vt, a, x, lane, pcx);
        return vec_result(cx, emit_ir_v, vt, pcx);
    }
    let base = vec_result(cx, a, vt, pcx);
    let ir_const_v1 = ir_const(cx, esize, TY_U64, pcx);
    let ir_binary_v1 = ir_binary(cx, Op::Mul, TY_U64, idx, ir_const_v1, pcx);
    let at = ir_binary(cx, Op::Add, TY_U64, base,
        ir_binary_v1, pcx);
    ir_store(cx, ir_type(elem, pcx), at, x, 0, pcx);
    base
}

// Vector value a of type `from` as type `to` (the same size): the value
// itself, or a register-preserving Conv.
fn vec_cast(cx: &mut FnCtx, a: i64, from: i64, to: i64, pcx: &Ctx<Comp>) -> i64 {
    if from == to {
        return a;
    }
    let c = emit_ir(cx, Op::Conv, to, a, 0, 0, pcx);
    unsafe { (*cx.insts.add(c as usize)).imm2 = from; }
    c
}

// (mask m) select x or y, vectors of type ty.
fn vec_select(cx: &mut FnCtx, ty: i64, m: i64, x: i64, y: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = emit_ir(cx, Op::VSel, ty, m, x, 0, pcx);
    unsafe { (*cx.insts.add(v as usize)).c = y; }
    v
}

// ---- 256-bit vectors (0.19) ----
//
// No function has 256-bit registers yet (none on AArch64; on x86-64 the
// avx ones are T5's), so lowering legalizes a 256-bit vector into its two
// 128-bit halves (vector_half): every operation is two, on the halves at
// offsets 0 and 16, and its value is two SSA values (scalar replacement
// takes a 256-bit slot as two leaves, back/abi.vl). The back ends never
// see a 256-bit type.

pub fn is_wide(vt: i64, pcx: &Ctx<Comp>) -> bool {
    type_size(vt, pcx) == 32
}

// The halves of 256-bit vector expression e: the low one, the high one in
// *hi (both read before anything after e is evaluated).
fn wide_operand(cx: &mut FnCtx, e: i64, hi: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    let addr = operand_value(cx, e, pcx);
    let half = vector_half(pcx.nodes[e as usize].ty, pcx);
    let lo = ir_load(cx, half, addr, 0, pcx);
    *hi = ir_load(cx, half, addr, 16, pcx);
    lo
}

// The address of a new slot holding the 256-bit vector of halves lo, hi.
fn wide_result(cx: &mut FnCtx, lo: i64, hi: i64, vt: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let new_slot_for_v = new_slot_for(cx, vt, pcx);
    let base = ir_slot_addr(cx, new_slot_for_v, pcx);
    let half = vector_half(vt, pcx);
    ir_store(cx, half, base, lo, 0, pcx);
    ir_store(cx, half, base, hi, 16, pcx);
    base
}

// lhs <token> rhs on vector expressions (of any width): the address of the
// result, of type result_ty.
pub fn lower_vector_binary(cx: &mut FnCtx, token: Tok, lhs: i64, rhs: i64, result_ty: i64,
    pcx: &mut Ctx<Comp>)
    -> i64 {
    let vt = pcx.nodes[lhs as usize].ty;
    if !is_wide(vt, pcx) {
        let a = vec_operand(cx, lhs, pcx);
        let b = vec_operand(cx, rhs, pcx);
        let vector_operator_v = vector_operator(cx, token, vt, result_ty, a, b, pcx);
        return vec_result(cx, vector_operator_v, result_ty,
            pcx);
    }
    let mut ah: i64 = 0;
    let mut bh: i64 = 0;
    let al = wide_operand(cx, lhs, &mut ah, pcx);
    let bl = wide_operand(cx, rhs, &mut bh, pcx);
    let half = vector_half(vt, pcx);
    let rhalf = vector_half(result_ty, pcx);
    let lo = vector_operator(cx, token, half, rhalf, al, bl, pcx);
    let hi = vector_operator(cx, token, half, rhalf, ah, bh, pcx);
    wide_result(cx, lo, hi, result_ty, pcx)
}

// -operand, a vector of type ty: the address of the result.
pub fn lower_vector_negate(cx: &mut FnCtx, operand: i64, ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if !is_wide(ty, pcx) {
        let a = vec_operand(cx, operand, pcx);
        let emit_ir_v = emit_ir(cx, Op::VNeg, ty, a, 0, 0, pcx);
        return vec_result(cx, emit_ir_v, ty, pcx);
    }
    let mut hi: i64 = 0;
    let lo = wide_operand(cx, operand, &mut hi, pcx);
    let half = vector_half(ty, pcx);
    let emit_ir_v1 = emit_ir(cx, Op::VNeg, half, lo, 0, 0, pcx);
    let emit_ir_v2 = emit_ir(cx, Op::VNeg, half, hi, 0, 0, pcx);
    wide_result(cx, emit_ir_v1,
        emit_ir_v2, ty, pcx)
}

// The value of `value`, the right side of a compound assignment to a
// vector (a 256-bit one's high half in *hi).
pub fn vector_assign_value(cx: &mut FnCtx, value: i64, hi: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    if is_wide(pcx.nodes[value as usize].ty, pcx) {
        return wide_operand(cx, value, hi, pcx);
    }
    vec_operand(cx, value, pcx)
}

// The vector at addr (of type ty) <token>= v (hi: a 256-bit one's high
// half).
pub fn vector_assign_store(cx: &mut FnCtx, token: Tok, ty: i64, addr: i64, v: i64, hi: i64,
    pcx: &mut Ctx<Comp>) {
    if !is_wide(ty, pcx) {
        let old = ir_load(cx, ty, addr, 0, pcx);
        let vector_operator_v = vector_operator(cx, token, ty, ty, old, v, pcx);
        ir_store(cx, ty, addr, vector_operator_v, 0, pcx);
        return;
    }
    let half = vector_half(ty, pcx);
    for k in 0..2 {
        let old = ir_load(cx, half, addr, 16 * k, pcx);
        let vector_operator_v1 = vector_operator(cx, token, half, half, old, if k == 0 { v }
            else { hi }, pcx);
        ir_store(cx, half, addr, vector_operator_v1, 16 * k, pcx);
    }
}

// A VecOp on a 256-bit vector type: its operations on the halves.
fn lower_wide_vecop(cx: &mut FnCtx, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let kind = pcx.nodes[n as usize].x;
    let vt = pcx.nodes[n as usize].y;
    let half = vector_half(vt, pcx);
    let elem = vec_elem(vt, pcx);
    let lanes = vec_lanes(vt, pcx);
    let hl = lanes / 2;
    let esize = type_size(elem, pcx);
    if kind == VK_NEW || kind == VK_SPLAT {
        let first = operand_value(cx, child(n, 0, pcx), pcx);
        let mut lo = emit_ir(cx, Op::VSplat, half, first, 0, 0, pcx);
        if kind == VK_SPLAT {
            return wide_result(cx, lo, lo, vt, pcx);
        }
        for i in 1..hl {
            let operand_value_v = operand_value(cx, child(n, i, pcx), pcx);
            lo = emit_ir(cx, Op::VIns, half, lo, operand_value_v, i,
                pcx);
        }
        let next = operand_value(cx, child(n, hl, pcx), pcx);
        let mut hi = emit_ir(cx, Op::VSplat, half, next, 0, 0, pcx);
        for i in hl + 1..lanes {
            let operand_value_v1 = operand_value(cx, child(n, i, pcx), pcx);
            hi = emit_ir(cx, Op::VIns, half, hi, operand_value_v1,
                i - hl, pcx);
        }
        return wide_result(cx, lo, hi, vt, pcx);
    }
    if kind == VK_FROM_BITS {
        let e = child(n, 0, pcx);
        let mut hi: i64 = 0;
        let lo = wide_operand(cx, e, &mut hi, pcx);
        let from = vector_half(pcx.nodes[e as usize].ty, pcx);
        let vec_cast_v = vec_cast(cx, lo, from, half, pcx);
        let vec_cast_v1 = vec_cast(cx, hi, from, half, pcx);
        return wide_result(cx, vec_cast_v,
            vec_cast_v1, vt, pcx);
    }
    if kind == VK_LOAD {
        let addr = lower_vector_address(cx, child(n, 0, pcx), child(n, 1, pcx), vt, pcx);
        let ir_load_v = ir_load(cx, half, addr, 0, pcx);
        let ir_load_v1 = ir_load(cx, half, addr, 16, pcx);
        return wide_result(cx, ir_load_v, ir_load_v1,
            vt, pcx);
    }
    let mut ah: i64 = 0;
    let al = wide_operand(cx, pcx.nodes[n as usize].a, &mut ah, pcx);
    if kind == VK_STORE {
        let addr = lower_vector_address(cx, child(n, 0, pcx), child(n, 1, pcx), vt, pcx);
        ir_store(cx, half, addr, al, 0, pcx);
        ir_store(cx, half, addr, ah, 16, pcx);
        return 0;
    }
    if kind == VK_SUM {
        if is_float(elem) {
            // (pairwise, as -O0 sums: the low half's sum plus the high's)
            let a = emit_ir(cx, Op::VSum, ir_type(elem, pcx), al, 0, 0, pcx);
            let b = emit_ir(cx, Op::VSum, ir_type(elem, pcx), ah, 0, 0, pcx);
            return ir_binary(cx, Op::Add, ir_type(elem, pcx), a, b, pcx);
        }
        let both = emit_ir(cx, Op::VBin, half, al, ah, Op::Add as i64, pcx);
        return emit_ir(cx, Op::VSum, ir_type(elem, pcx), both, 0, 0, pcx);
    }
    if kind == VK_SELECT {
        let ty = pcx.nodes[child(n, 0, pcx) as usize].ty;
        let mut xh: i64 = 0;
        let mut yh: i64 = 0;
        let xl = wide_operand(cx, child(n, 0, pcx), &mut xh, pcx);
        let yl = wide_operand(cx, child(n, 1, pcx), &mut yh, pcx);
        let th = vector_half(ty, pcx);
        let vec_select_v = vec_select(cx, th, al, xl, yl, pcx);
        let vec_select_v1 = vec_select(cx, th, ah, xh, yh, pcx);
        return wide_result(cx, vec_select_v,
            vec_select_v1, ty, pcx);
    }
    let idx = lower_lane_index(cx, child(n, 0, pcx), vt, pcx);
    let lane = const_lane(cx, idx, lanes);
    if kind == VK_LANE {
        if lane >= 0 {
            return emit_ir(cx, Op::VExt, ir_type(elem, pcx), if lane < hl { al } else { ah }, 0,
                lane % hl, pcx);
        }
        let base = wide_result(cx, al, ah, vt, pcx);
        let ir_const_v = ir_const(cx, esize, TY_U64, pcx);
        let ir_binary_v = ir_binary(cx, Op::Mul, TY_U64, idx, ir_const_v,
            pcx);
        let at = ir_binary(cx, Op::Add, TY_U64, base,
            ir_binary_v, pcx);
        return ir_load(cx, ir_type(elem, pcx), at, 0, pcx);
    }
    // VK_WITH
    let x = operand_value(cx, child(n, 1, pcx), pcx);
    if lane >= 0 {
        if lane < hl {
            let emit_ir_v = emit_ir(cx, Op::VIns, half, al, x, lane, pcx);
            return wide_result(cx, emit_ir_v, ah, vt, pcx);
        }
        let emit_ir_v1 = emit_ir(cx, Op::VIns, half, ah, x, lane - hl, pcx);
        return wide_result(cx, al, emit_ir_v1, vt, pcx);
    }
    let base = wide_result(cx, al, ah, vt, pcx);
    let ir_const_v1 = ir_const(cx, esize, TY_U64, pcx);
    let ir_binary_v1 = ir_binary(cx, Op::Mul, TY_U64, idx, ir_const_v1, pcx);
    let at = ir_binary(cx, Op::Add, TY_U64, base,
        ir_binary_v1, pcx);
    ir_store(cx, ir_type(elem, pcx), at, x, 0, pcx);
    base
}
