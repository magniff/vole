// Lowering: each function's places-IR body (places.vl; 0.26.2: the AST
// lowering is gone) to the IR of ir.vl, building SSA form on
// the fly (Braun, Buchwald, Hack, Leißa, Mallon, Zwinkau: "Simple and
// Efficient Construction of Static Single Assignment Form", CC 2013).
//
// SSA variables are the scalar locals whose address is never taken (the
// others live in frame slots), and synthetic variables. A block is
// sealed once all its predecessors are known; reading a variable in an
// unsealed block makes an incomplete phi, completed when the block is
// sealed.
//
// Semantics are those of the 0.1 code generator (gen.vl): the same
// evaluation order, the same calling convention (compound arguments are
// passed as a pointer to a private copy, compound results through a
// result pointer), and the same arithmetic.

pub mod calls;
mod expr;
pub mod places;
pub mod ssa;
mod vector;
mod arch;
pub mod atomic;

use crate::back::abi::{conv_classify, conv_returns_through_pointer, fn_uses_c};
use crate::base::{alloc_array, intern_c};
use crate::base::target::X86;
use crate::front::ast::{NODES, NodeKind, child};
use crate::front::ast::NodeKind::{
    Array, Call, Fn, Ident, Index, Range, Repeat, Str, StructLit, Tuple, Unary, VariantLit,
};
use crate::front::check::{LOCALS, LOCAL_COUNT, Res};
use crate::front::lexer::Tok;
use crate::front::types::{
    FNS, TY_I64, TY_U64, align_to, is_compound, is_void, type_align, type_size,
};
use crate::gen0::gen::MAIN_SYM;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    CUR, INLINE_COPY_MAX, IRFUNCS, Op, Term, emit_ir, init_ir, ir_const, ir_load, ir_new_block,
    ir_new_slot, ir_slot_addr, ir_store, ir_type,
};
use crate::middle::ir::cfg::ir_terminate;
use crate::middle::lower::calls::{push_arg, take_args};
use crate::middle::lower::expr::need_value;
use crate::middle::lower::ssa::{LOCAL_ADDR, PROMOTE};

use ssa::ssa_write;

// ---- Blocks during lowering ----

// A block that no edge reaches (code after `return`, `break`, ...).
fn is_dead_block(cx: sink *FnCtx, b: i64) -> bool {
    unsafe {
        cx.blocks[b].sealed != 0 && cx.blocks[b].preds.count == 0 && b != IRFUNCS[cx.irf].entry
    }
}

fn start_dead_block(cx: sink *FnCtx) {
    let b = ir_new_block(cx);
    unsafe { cx.blocks[b].sealed = 1; }
    CUR = b;
}

// Ends the current block with a jump (no edge from a dead block).
fn lower_jump(cx: sink *FnCtx, target: i64) {
    if is_dead_block(cx, CUR) {
        ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
    } else {
        ir_terminate(cx, CUR, Term::Jump, 0, target, 0);
    }
}

fn lower_branch(cx: sink *FnCtx, cond: i64, if_true: i64, if_false: i64) {
    if is_dead_block(cx, CUR) {
        ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
    } else {
        ir_terminate(cx, CUR, Term::Branch, cond, if_true, if_false);
    }
}

// ---- The program ----

// Lowers every function to IR.
pub fn lower_program(cx: sink *FnCtx, program: i64) {
    init_ir(cx);
    PROMOTE = 0 as *i64;
    LOCAL_ADDR = alloc_array::<i64>(LOCAL_COUNT + 1);
    // (0.26.1: PROMOTE is made when a lowering of the AST's expressions
    // first needs it, places.vl)
    for i in 0..NODES[program].count {
        let item = child(program, i);
        if NODES[item].kind == Fn {
            // (0.26.1: from its kept places-IR body, places.vl; 0.26.2: only)
            if !crate::middle::lower::places::lower_places_function(cx, item, NODES[item].x - 1) {
                crate::middle::lower::places::lower_stats();
                crate::base::die(c"places: a function not lowered from its body");
            }
        }
    }
    // (0.26.1) The drop shims, functions of FNS but not program items
    // (places/shim.vl), from their kept bodies
    {
        for id in 0..crate::places::shim::shim_count() {
            let f = crate::places::shim::shim_fn(id);
            if f >= 0 {
                let item = crate::places::front::fn_node(f);
                if !crate::middle::lower::places::lower_places_function(cx, item, f) {
                    crate::middle::lower::places::lower_stats();
                    crate::base::die(c"places: a drop shim not lowered from its body");
                }
            }
        }
    }
}

// PROMOTE, made once a program: a scalar local whose address is never
// taken is an SSA variable; the others live in memory.
pub fn need_promote() {
    // UNSAFE: PROMOTE is a raw array the SSA builder reads (ssa.vl), LOCALS the
    // checker's static mut table.
    // SAFETY: PROMOTE is allocated here with LOCAL_COUNT + 1 entries, and every
    // index is a local below LOCAL_COUNT (the loop, and an Ident's local).
    unsafe {
        if PROMOTE != 0 as *i64 {
            return;
        }
        PROMOTE = alloc_array::<i64>(LOCAL_COUNT + 1);
        for local in 0..LOCAL_COUNT {
            let ty = LOCALS[local].ty;
            PROMOTE[local] = if is_void(ty) || is_compound(ty) { 0 } else { 1 };
        }
        for n in 1..NODES.len() as i64 {
            if NODES[n].kind == Unary && NODES[n].op == Tok::Amp {
                let operand = NODES[n].b;
                if NODES[operand].kind == Ident && NODES[operand].res == Res::Local {
                    PROMOTE[NODES[operand].y] = 0;
                }
            }
        }
    }
}

fn lower_return(cx: sink *FnCtx, value: i64) {
    unsafe {
        let f = IRFUNCS[cx.irf].f;
        let ret = FNS[f].ret;
        var result = 0;
        let c = fn_uses_c(f);
        if conv_returns_through_pointer(cx, c, ret) {
            lower_copy(cx, IRFUNCS[cx.irf].result_ptr, value, type_size(ret));
            if X86 && c {
                // Returned in rax, as C does.
                result = IRFUNCS[cx.irf].result_ptr;
            }
        } else if is_compound(ret) {
            // Returned in registers: its pieces, read from a multiple of 8
            // bytes, packed for the RET.
            var addr = need_value(cx, value, ret);
            if type_size(ret) % 8 != 0 && cx.insts[addr].op != Op::Slot {
                let copy = ir_slot_addr(cx, new_slot_for(cx, ret));
                lower_copy(cx, copy, addr, type_size(ret));
                addr = copy;
            }
            conv_classify(cx, c, ret);
            let count = cx.abi_piece_count;
            var tys: [i64; 4] = [0; 4];
            var offsets: [i64; 4] = [0; 4];
            for k in 0..count {
                tys[k] = cx.abi_piece_ty[k];
                offsets[k] = cx.abi_piece_offset[k];
            }
            let mark = cx.ssa_stack.count;
            for k in 0..count {
                push_arg(cx, ir_load(cx, tys[k], addr, offsets[k]), tys[k]);
            }
            result = emit_ir(cx, Op::Pack, 0, 0, 0, 0);
            take_args(cx, result, mark);
        } else if is_void(ret) {
            // `main` without a result exits with 0.
            if FNS[f].name == MAIN_SYM {
                result = ir_const(cx, 0, TY_I64);
            }
        } else {
            result = need_value(cx, value, ret);
        }
        if !is_dead_block(cx, CUR) {
            ir_terminate(cx, CUR, Term::Ret, result, 0, 0);
        } else {
            ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
        }
        start_dead_block(cx);
    }
}

// ---- Statements and bindings ----

// Expressions whose compound value is a new temporary, which a binding or
// an argument may take over without copying.
pub fn is_fresh(n: i64) -> bool {
    match NODES[n].kind {
        StructLit | Tuple | Array | Repeat
            | Call | Str | VariantLit => true,
        Index => NODES[NODES[n].b].kind == Range,
        _ => false,
    }
}

// Binds local `local` (of type `ty`) to `value` (the address of a compound
// value, taken over when `fresh`).
fn bind_local(cx: sink *FnCtx, local: i64, value: i64, ty: i64, fresh: bool) {
    unsafe {
        if is_void(ty) {
            return;
        }
        if PROMOTE[local] != 0 {
            ssa_write(cx, local, CUR, need_value(cx, value, ty));
            return;
        }
        if is_compound(ty) && fresh {
            LOCAL_ADDR[local] = value;
            return;
        }
        let addr = ir_slot_addr(cx, new_slot_for(cx, ty));
        if is_compound(ty) {
            lower_copy(cx, addr, value, type_size(ty));
        } else {
            ir_store(cx, ir_type(ty), addr, need_value(cx, value, ty), 0);
        }
        LOCAL_ADDR[local] = addr;
    }
}

// A frame slot for a value of type `ty`; compound values get a multiple of
// 8 bytes, so that they can be read and written in 8-byte pieces.
fn new_slot_for(cx: sink *FnCtx, ty: i64) -> i64 {
    let size = if is_compound(ty) { align_to(type_size(ty), 8) } else { type_size(ty) };
    let slot = ir_new_slot(cx, size, type_align(ty));
    unsafe { cx.slots[slot].ty = ty; }
    slot
}

// Copies `size` bytes from `src` to `dst`.
fn lower_copy(cx: sink *FnCtx, dst: i64, src: i64, size: i64) {
    unsafe {
        if size == 0 {
            return;
        }
        if size <= INLINE_COPY_MAX {
            let v = emit_ir(cx, Op::Copy, 0, dst, src, size);
            cx.insts[v].imm2 = 0;
            return;
        }
        let mark = cx.ssa_stack.count;
        push_arg(cx, dst, TY_U64);
        push_arg(cx, src, TY_U64);
        push_arg(cx, ir_const(cx, size, TY_U64), TY_U64);
        let call = emit_ir(cx, Op::CallC, 0, 0, 0, intern_c(c"memcpy"));
        take_args(cx, call, mark);
    }
}

// ---- Assignment ----
