// Lowering the calls of std::arch's intrinsics (0.19, docs/design/arch.md
// §5.1): by the table's IR form, so that the optimizer sees them.
//
//   vbin.OP vcmp.C vsplat vext  0.10's vector operation (on the `work`
//                               type when the signature's are others:
//                               x86's __m128i), with casts around it
//   cast                        a register-preserving CONV
//   load, store                 the slice's bounds check, then a LOAD or a
//                               STORE of the vector
//   bits.K                      BITS on AArch64; elsewhere the call of its
//                               body (std's function)
//   feat                        a constant where the feature is known or
//                               foreign, else CPUFEAT (expanded late)
//   intr                        INTR: its register parameters as a, b, c,
//                               its immediates in imm2
// An intrinsic of another architecture is never generated: its call is
// dead code (under a constant-false has/detect), lowered as unreachable.
// It reads the tables and the front end's notes only (read-only once the
// front end is done).

use crate::arch::{
    FORM_BITS, FORM_CAST, FORM_FEAT, FORM_INTR, FORM_INTR_MEM, FORM_LOAD, FORM_LOAD_DUP, FORM_STORE,
    FORM_VBIN, FORM_VCMP, FORM_VEXT, FORM_VINS, FORM_VNEG, FORM_VSEL, FORM_VSPLAT, FORM_VSUM,
    MEM_LOAD, intr_param_is_const, intr_with_imm, intrinsic_is_foreign,
};
use crate::base::die;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::ast::child;
use crate::front::consteval::const_eval;
use crate::front::contracts::sites::site_of;
use crate::front::features::{feature_call_bit, feature_call_value};
use crate::front::types::{
    TY_BOOL, TY_I64, TY_U64, is_compound, is_vector, is_void, tuple_offset, type_elem, type_size,
    vector_half,
};
use crate::gen0::target::PANIC_RANGE_SIGNED;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Cond, Op, Term, emit_ir, ir_binary, ir_cmp, ir_const, ir_load, ir_slot_addr, ir_store, ir_type,
};
use crate::middle::ir::cfg::ir_terminate;
use crate::middle::lower::{new_slot_for, start_dead_block};
use crate::middle::lower::calls::lower_check;
use crate::middle::lower::expr::{need_value, operand_value};
use crate::middle::lower::vector::{lower_elements, vec_operand, vec_result};

// lower_intrinsic's answer for a call it leaves to lower_call (a bits.*
// intrinsic where its body is called).
pub const NOT_LOWERED: i64 = -1;

// Call n of intrinsic id (its declaration is function f): its value (an
// address for a vector), or NOT_LOWERED.
pub fn lower_intrinsic(cx: &mut FnCtx<Comp>, n: i64, f: i64, id: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let ret = pcx.fns[f as usize].ret;
        let form = (pcx.intrs[id as usize]).form;
        if intrinsic_is_foreign(id, pcx) {
            ir_terminate(cx, pcx.ir_cur, Term::Unreach, 0, 0, 0);
            start_dead_block(cx, pcx);
            return placeholder(cx, ret, pcx);
        }
        if form == FORM_FEAT {
            let value = feature_call_value(n, pcx);
            if value >= 0 {
                return ir_const(cx, value, TY_BOOL, pcx);
            }
            return emit_ir(cx, Op::CpuFeat, TY_BOOL, 0, 0, feature_call_bit(n, pcx), pcx);
        }
        if form == FORM_BITS {
            if get_x86() {
                return NOT_LOWERED;
            }
            let operand_value_v = operand_value(cx, child(n, 0, pcx), pcx);
            let x = need_value(cx, operand_value_v, TY_U64, pcx);
            return emit_ir(cx, Op::Bits, TY_I64, x, 0, (pcx.intrs[id as usize]).form_arg, pcx);
        }
        if (form == FORM_LOAD || form == FORM_STORE)
            && pcx.fns[f as usize].param_count < (pcx.intrs[id as usize]).nparams {
            // (0.19 T1) a raw:: pointer form: the pointer, then the vector
            // to store
            let p = operand_value(cx, child(n, (pcx.intrs[id as usize]).mem_param, pcx), pcx);
            if form == FORM_LOAD {
                let ir_load_v = ir_load(cx, ret, p, 0, pcx);
                return vec_result(cx, ir_load_v, ret, pcx);
            }
            let v_arg = child(n, (pcx.intrs[id as usize]).mem_param + 1, pcx);
            let arg_v = pcx.nodes[v_arg as usize].ty;
            let vec_operand_v = vec_operand(cx, v_arg, pcx);
            ir_store(cx, arg_v, p, vec_operand_v, 0, pcx);
            return 0;
        }
        if form == FORM_LOAD {
            let addr = memory_address(cx, n, id, pcx);
            let ir_load_v1 = ir_load(cx, ret, addr, 0, pcx);
            return vec_result(cx, ir_load_v1, ret, pcx);
        }
        if form == FORM_STORE {
            // (s, i, then the vector: the arguments' order)
            let s = (pcx.intrs[id as usize]).mem_param;
            let value = operand_value(cx, child(n, s, pcx), pcx);
            let idx = operand_value(cx, child(n, s + 1, pcx), pcx);
            let v_arg = child(n, s + 2, pcx);
            let v = vec_operand(cx, v_arg, pcx);
            let pcx_site1 = site_of(child(n, s + 1, pcx), 0, pcx);
            let addr = checked_address(cx, pcx.nodes[child(n, s, pcx) as usize].ty, value, idx,
                (pcx.intrs[id as usize]).mem_bytes, pcx, pcx_site1);
            ir_store(cx, pcx.nodes[v_arg as usize].ty, addr, v, 0, pcx);
            return 0;
        }
        if form == FORM_LOAD_DUP {
            // (T6) one element, checked (or at a raw:: pointer), splat
            let elem = pcx.types[ret as usize].a;
            let mut addr: i64 = 0;
            if pcx.fns[f as usize].param_count < (pcx.intrs[id as usize]).nparams {
                addr = operand_value(cx, child(n, (pcx.intrs[id as usize]).mem_param, pcx),
                    pcx);
            } else {
                addr = memory_address(cx, n, id, pcx);
            }
            let x = ir_load(cx, elem, addr, 0, pcx);
            let emit_ir_v = emit_ir(cx, Op::VSplat, ret, x, 0, 0, pcx);
            return vec_result(cx, emit_ir_v, ret, pcx);
        }
        if form == FORM_INTR_MEM {
            return lower_pair_memory(cx, n, f, id, pcx);
        }
        if form == FORM_VNEG {
            let vec_operand_v1 = vec_operand(cx, child(n, 0, pcx), pcx);
            let v = emit_ir(cx, Op::VNeg, ret, vec_operand_v1, 0, 0,
                pcx);
            return vec_result(cx, v, ret, pcx);
        }
        if form == FORM_VSUM {
            let ir_type_v = ir_type(ret, pcx);
            let vec_operand_v2 = vec_operand(cx, child(n, 0, pcx), pcx);
            return emit_ir(cx, Op::VSum, ir_type_v,
                vec_operand_v2, 0, 0, pcx);
        }
        if form == FORM_VINS {
            // (x, v, lane)
            let ex = child(n, 0, pcx);
            let operand_value_v1 = operand_value(cx, ex, pcx);
            let x = need_value(cx, operand_value_v1, pcx.nodes[ex as usize].ty, pcx);
            let v = vec_operand(cx, child(n, 1, pcx), pcx);
            let lane = const_eval(child(n, 2, pcx), pcx);
            let emit_ir_v1 = emit_ir(cx, Op::VIns, ret, v, x, lane, pcx);
            return vec_result(cx, emit_ir_v1, ret, pcx);
        }
        if form == FORM_VSEL {
            // (mask a, b, c): b's bits where a's are set, c's elsewhere
            let em = child(n, 0, pcx);
            let vec_operand_v3 = vec_operand(cx, em, pcx);
            let m = as_type(cx, vec_operand_v3, pcx.nodes[em as usize].ty, ret, pcx);
            let b = vec_operand(cx, child(n, 1, pcx), pcx);
            let c = vec_operand(cx, child(n, 2, pcx), pcx);
            let v = emit_ir(cx, Op::VSel, ret, m, b, 0, pcx);
            (cx.insts[v as usize]).c = c;
            return vec_result(cx, v, ret, pcx);
        }
        if form == FORM_CAST && type_size(ret, pcx) == 32 {
            // (0.19 T5) A 256-bit cast copies its bytes as two halves: a
            // 256-bit register is an AVX one, and a cast needs no feature.
            let addr = operand_value(cx, child(n, 0, pcx), pcx);
            let half = vector_half(ret, pcx);
            let lo = ir_load(cx, half, addr, 0, pcx);
            let hi = ir_load(cx, half, addr, 16, pcx);
            let new_slot_for_v = new_slot_for(cx, ret, pcx);
            let base = ir_slot_addr(cx, new_slot_for_v, pcx);
            ir_store(cx, half, base, lo, 0, pcx);
            ir_store(cx, half, base, hi, 16, pcx);
            return base;
        }
        if form == FORM_CAST {
            let e = child(n, 0, pcx);
            let v = vec_operand(cx, e, pcx);
            let as_type_v = as_type(cx, v, pcx.nodes[e as usize].ty, ret, pcx);
            return vec_result(cx, as_type_v, ret, pcx);
        }
        let work = work_type(id, ret, pcx);
        if form == FORM_VSPLAT {
            let x = operand_value(cx, child(n, 0, pcx), pcx);
            let v = emit_ir(cx, Op::VSplat, work, x, 0, 0, pcx);
            let as_type_v1 = as_type(cx, v, work, ret, pcx);
            return vec_result(cx, as_type_v1, ret, pcx);
        }
        if form == FORM_VEXT {
            let e = child(n, 0, pcx);
            let a = vec_operand(cx, e, pcx);
            let lane = const_eval(child(n, 1, pcx), pcx);
            return emit_ir(cx, Op::VExt, ir_type(ret, pcx), a, 0, lane, pcx);
        }
        if form == FORM_VBIN || form == FORM_VCMP {
            let ea = child(n, 0, pcx);
            let eb = child(n, 1, pcx);
            let va = vec_operand(cx, ea, pcx);
            let a = as_type(cx, va, pcx.nodes[ea as usize].ty, work, pcx);
            let vb = vec_operand(cx, eb, pcx);
            let b = as_type(cx, vb, pcx.nodes[eb as usize].ty, work, pcx);
            let mut v: i64 = 0;
            if form == FORM_VBIN {
                v = emit_ir(cx, Op::VBin, work, a, b, (pcx.intrs[id as usize]).form_arg, pcx);
            } else {
                v = emit_ir(cx, Op::VCmp, work, a, b, 0, pcx);
                let raw = (pcx.intrs[id as usize]).form_arg;
                (cx.insts[v as usize]).cond = raw as Cond;
                (cx.insts[v as usize]).imm2 = work;
            }
            let as_type_v2 = as_type(cx, v, work, ret, pcx);
            return vec_result(cx, as_type_v2, ret, pcx);
        }
        if form != FORM_INTR {
            die(c"internal error: an intrinsic of a form not lowered yet (0.19 Phase 0)");
        }
        // INTR: the register parameters in order, the immediates packed.
        let mut operands: [i64; 3] = [0i64, 0, 0];
        let mut count: i64 = 0;
        let mut imm2: i64 = 0;
        let mut ci: i64 = 0;
        for k in 0..(pcx.intrs[id as usize]).nparams {
            let e = child(n, k, pcx);
            if intr_param_is_const(id, k, pcx) {
                imm2 = intr_with_imm(imm2, ci, const_eval(e, pcx));
                ci += 1;
                continue;
            }
            if count == 3 {
                die(c"internal error: an INTR of more than three register operands");
            }
            let ty = pcx.nodes[e as usize].ty;
            operands[count as usize] = if is_vector(ty, pcx) { vec_operand(cx, e, pcx) }
                else {
                    let operand_value_v2 = operand_value(cx, e, pcx);
                    need_value(cx, operand_value_v2, ty, pcx)
                };
            count += 1;
        }
        let rt: i64 = if is_void(ret) { 0 } else { ir_type(ret, pcx) };
        let v = emit_ir(cx, Op::Intr, rt, operands[0], operands[1], id, pcx);
        (cx.insts[v as usize]).c = operands[2];
        (cx.insts[v as usize]).imm2 = imm2;
        if is_compound(ret, pcx) {
            return vec_result(cx, v, ret, pcx);
        }
        v
    }
}

// (T6) An `intr.mem` intrinsic, vld2q_T or vst2q_T: two registers loaded
// from 32 bytes and deinterleaved (two vector loads, then the uzp1/uzp2
// permutes), or interleaved and stored (zip1/zip2, two vector stores):
// the instructions' count of the hardware's ld2/st2 and its moves, every
// one visible to the optimizer. -O0 writes ld2/st2 (gen0/gen/arch.vl).
fn lower_pair_memory(cx: &mut FnCtx<Comp>, n: i64, f: i64, id: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let p1 = (pcx.intrs[id as usize]).part1;
        let p2 = (pcx.intrs[id as usize]).part2;
        if p1 < 0 || p2 < 0 {
            die(c"internal error: an intr.mem intrinsic without its permutes");
        }
        let raw = pcx.fns[f as usize].param_count < (pcx.intrs[id as usize]).nparams;
        let s = (pcx.intrs[id as usize]).mem_param;
        if (pcx.intrs[id as usize]).mem == MEM_LOAD {
            let ret = pcx.fns[f as usize].ret;
            let vt = type_elem(ret, 0, pcx);
            let addr = if raw { operand_value(cx, child(n, s, pcx), pcx) }
                else { memory_address(cx, n, id, pcx) };
            let lo = ir_load(cx, vt, addr, 0, pcx);
            let hi = ir_load(cx, vt, addr, type_size(vt, pcx), pcx);
            let r0 = emit_ir(cx, Op::Intr, vt, lo, hi, p1, pcx);
            let r1 = emit_ir(cx, Op::Intr, vt, lo, hi, p2, pcx);
            let new_slot_for_v = new_slot_for(cx, ret, pcx);
            let slot = ir_slot_addr(cx, new_slot_for_v, pcx);
            ir_store(cx, vt, slot, r0, 0, pcx);
            ir_store(cx, vt, slot, r1, tuple_offset(ret, 1, pcx), pcx);
            return slot;
        }
        // (s, i, then the pair: the arguments' order, as a store)
        let v_arg = child(n, if raw { s + 1 } else { s + 2 }, pcx);
        let tt = pcx.nodes[v_arg as usize].ty;
        let vt = type_elem(tt, 0, pcx);
        if raw {
            let addr = operand_value(cx, child(n, s, pcx), pcx);
            let pair = operand_value(cx, v_arg, pcx);
            let a = ir_load(cx, vt, pair, 0, pcx);
            let b = ir_load(cx, vt, pair, tuple_offset(tt, 1, pcx), pcx);
            store_pair(cx, vt, addr, a, b, p1, p2, pcx);
            return 0;
        }
        let value = operand_value(cx, child(n, s, pcx), pcx);
        let idx = operand_value(cx, child(n, s + 1, pcx), pcx);
        let pair = operand_value(cx, v_arg, pcx);
        let a = ir_load(cx, vt, pair, 0, pcx);
        let b = ir_load(cx, vt, pair, tuple_offset(tt, 1, pcx), pcx);
        let pcx_site2 = site_of(child(n, s + 1, pcx), 0, pcx);
        let addr = checked_address(cx, pcx.nodes[child(n, s, pcx) as usize].ty, value, idx,
            (pcx.intrs[id as usize]).mem_bytes, pcx, pcx_site2);
        store_pair(cx, vt, addr, a, b, p1, p2, pcx);
        0
    }
}

// zip1(a, b) and zip2(a, b) (intrinsics p1, p2) at addr and after it.
fn store_pair(cx: &mut FnCtx<Comp>, vt: i64, addr: i64, a: i64, b: i64, p1: i64, p2: i64,
    pcx: &Ctx<Comp>) {
    let z0 = emit_ir(cx, Op::Intr, vt, a, b, p1, pcx);
    let z1 = emit_ir(cx, Op::Intr, vt, a, b, p2, pcx);
    ir_store(cx, vt, addr, z0, 0, pcx);
    ir_store(cx, vt, addr, z1, type_size(vt, pcx), pcx);
}

// The type a generic form computes in: the table's `work` (x86's
// `vcmp.eq:v16i8`), else the result's.
fn work_type(id: i64, ret: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let w = (pcx.intrs[id as usize]).work;
        if w != 0 {
            return (pcx.sym_primitive[w as usize]);
        }
        ret
    }
}

// Vector v of type `from` as type `to` (the same bits).
fn as_type(cx: &mut FnCtx<Comp>, v: i64, from: i64, to: i64, pcx: &Ctx<Comp>) -> i64 {
    if from == to {
        return v;
    }
    let c = emit_ir(cx, Op::Conv, to, v, 0, 0, pcx);
    unsafe { (cx.insts[c as usize]).imm2 = from; }
    c
}

// What a dead call yields: an unused slot's address for a compound
// result, a zero for a scalar one.
fn placeholder(cx: &mut FnCtx<Comp>, ret: i64, pcx: &Ctx<Comp>) -> i64 {
    if is_void(ret) {
        return 0;
    }
    if is_compound(ret, pcx) {
        let s = new_slot_for(cx, ret, pcx);
        return ir_slot_addr(cx, s, pcx);
    }
    ir_const(cx, 0, ir_type(ret, pcx), pcx)
}

// The checked address of a memory form's bytes: its slice parameter and
// the index after it.
fn memory_address(cx: &mut FnCtx<Comp>, n: i64, id: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let s = (pcx.intrs[id as usize]).mem_param;
        let value = operand_value(cx, child(n, s, pcx), pcx);
        let idx = operand_value(cx, child(n, s + 1, pcx), pcx);
        let pcx_site3 = site_of(child(n, s + 1, pcx), 0, pcx);
        checked_address(cx, pcx.nodes[child(n, s, pcx) as usize].ty, value, idx,
            (pcx.intrs[id as usize]).mem_bytes, pcx, pcx_site3)
    }
}

// The address of element idx of the slice (or array) of type ty at
// `value`, checked that `bytes` bytes from it are in it: as 0.10's
// v.load(s, i), `0 <= idx` and `idx + bytes / elem <= len`.
fn checked_address(cx: &mut FnCtx<Comp>, ty: i64, value: i64, idx: i64, bytes: i64,
    pcx: &mut Ctx<Comp>, site: i64) -> i64 {
    let mut len: i64 = 0;
    let base = lower_elements(cx, ty, value, &mut len, pcx);
    let esize = type_size(pcx.types[ty as usize].a, pcx);
    let count = bytes / esize;
    let ir_const_v = ir_const(cx, count, TY_I64, pcx);
    let end = ir_binary(cx, Op::Add, TY_I64, idx, ir_const_v, pcx);
    let ir_const_v1 = ir_const(cx, count, TY_I64, pcx);
    let room = ir_binary(cx, Op::Sub, TY_I64, len, ir_const_v1, pcx);
    let ir_cmp_v = ir_cmp(cx, Cond::Le, TY_I64, idx, room, pcx);
    lower_check(cx, ir_cmp_v, PANIC_RANGE_SIGNED, idx, end,
        len, pcx, site, 0);
    let ir_const_v3 = ir_const(cx, 0, TY_I64, pcx);
    let ir_cmp_v1 = ir_cmp(cx, Cond::Ge, TY_I64, idx, ir_const_v3, pcx);
    lower_check(cx, ir_cmp_v1,
        PANIC_RANGE_SIGNED, idx, end, len, pcx, site, 0);
    let ir_const_v2 = ir_const(cx, esize, TY_U64, pcx);
    let scale = ir_binary(cx, Op::Mul, TY_U64, idx, ir_const_v2, pcx);
    ir_binary(cx, Op::Add, TY_U64, base, scale, pcx)
}
