// Lowering expressions: lower_expr lowers an operand the places-IR
// lowering did not bind (places.vl): a literal, a check's site or a name
// (0.26.2: the AST lowering of the other expressions, of statements and
// of control flow is gone). Here too: the bound operands of the calls',
// intrinsics' and vector operations' lowerings, casts, and string
// values.

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{INT_SITE, NodeKind};
use crate::front::ast::NodeKind::{Array, Bool, CStr, Char, Float, Ident, Int, Str, Unit};
use crate::front::check::{Res, type_error};
use crate::front::consteval::{const_value, f64_of_bits, float_const, wrap_int};
use crate::front::contracts::sites::site_of;
use crate::front::lexer::{Tok, str_at};
use crate::front::parser::exprs::is_comparison;
use crate::front::types::{
    TY_BOOL, TY_F32, TY_NEVER, TY_U64, TyKind, int_bits, is_compound, is_float, is_integer,
    is_slice, is_void, scalar_type, type_size,
};
use crate::gen0::gen::expr::panic_kind;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Cond, Op, RT_SITE, Term, cond_of_token, emit_ir, ir_binary, ir_cmp, ir_const, ir_load,
    ir_offset, ir_rtid, ir_slot_addr, ir_store, ir_type,
};
use crate::middle::ir::cfg::ir_terminate;
use crate::middle::lower::{is_dead_block, lower_copy, new_slot_for, start_dead_block};
use crate::middle::lower::calls::{lower_check, push_arg, raw_check, static_address, take_args};
use crate::middle::lower::ssa::{ssa_read, ssa_undef};

// ---- Expressions ----

// `value`, or an undefined value of type `ty` when there is none (in code
// after a diverging expression).
pub fn need_value(cx: &mut FnCtx<Comp>, value: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    if value != 0 || is_void(ty) {
        return value;
    }
    ssa_undef(cx, ir_type(ty, pcx), pcx)
}

// (0.26.1) An operand of a call, an intrinsic or a vector operation,
// expression e: the one point where those lowerings read their operands,
// so that the places-IR lowering gives them its operands' values instead
// of the AST's (lower_call, arch.vl, vector.vl, atomic.vl). `operand_expr`
// is lower_expr's value (0 when there is none), `operand_value` its value
// of e's type.
pub fn operand_expr(cx: &mut FnCtx<Comp>, e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.bound_nodes.len() > 0 {
        for k in 0..pcx.bound_nodes.len() {
            if pcx.bound_nodes[k] == e {
                return pcx.bound_values[k];
            }
        }
    }
    lower_expr(cx, e, pcx)
}

pub fn operand_value(cx: &mut FnCtx<Comp>, e: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let operand_expr_v = operand_expr(cx, e, pcx);
    need_value(cx, operand_expr_v, pcx.nodes[e as usize].ty, pcx)
}

fn load_scalar(cx: &mut FnCtx<Comp>, addr: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    if is_compound(ty, pcx) {
        return addr;
    }
    if is_void(ty) {
        return 0;
    }
    ir_load(cx, ir_type(ty, pcx), addr, 0, pcx)
}

pub fn lower_expr(cx: &mut FnCtx<Comp>, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.ir_call_locs {
        pcx.ir_expr_loc = pcx.nodes[n as usize].start + 1;
    }
    let value = lower_expr_inner(cx, n, pcx);
    if pcx.nodes[n as usize].ty == TY_NEVER {
        if !is_dead_block(cx, pcx.ir_cur) {
            ir_terminate(cx, pcx.ir_cur, Term::Unreach, 0, 0, 0);
            start_dead_block(cx, pcx);
        }
        return 0;
    }
    value
}

fn lower_expr_inner(cx: &mut FnCtx<Comp>, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let ty = pcx.nodes[n as usize].ty;
    match { pcx.nodes[n as usize].kind } {
        // (0.18.1: a check's site, an RTID value)
        Int if (pcx.nodes[n as usize].p & INT_SITE) != 0 && pcx.nodes[n as usize].a != 0 => {
            ir_rtid(cx, RT_SITE, pcx.nodes[n as usize].a, ir_type(ty, pcx), pcx)
        }
        Int | Char => ir_const(cx, wrap_int(pcx.nodes[n as usize].a, ty), ir_type(ty, pcx), pcx),
        Float => ir_const(cx, float_const(f64_of_bits(pcx.nodes[n as usize].a), ty), ty, pcx),
        Bool => ir_const(cx, pcx.nodes[n as usize].a, TY_BOOL, pcx),
        Unit => 0,
        Str => lower_string(cx, n, pcx),
        CStr => emit_ir(cx, Op::SAddr, TY_U64, 0, 0, pcx.nodes[n as usize].a, pcx),
        Ident => lower_ident(cx, n, pcx),
        _ => type_error(n, c"internal error: unexpected node in IR lowering", pcx),
    }
}

fn lower_string(cx: &mut FnCtx<Comp>, n: i64, pcx: &Ctx<Comp>) -> i64 {
    string_value(cx, pcx.nodes[n as usize].a, pcx)
}

// (0.26.1) String literal s (its id): a new slot holding its pointer and
// length.
pub fn string_value(cx: &mut FnCtx<Comp>, s: i64, pcx: &Ctx<Comp>) -> i64 {
    let new_slot_for_v = new_slot_for(cx, pcx.ty_string, pcx);
    let base = ir_slot_addr(cx, new_slot_for_v, pcx);
    let emit_ir_v = emit_ir(cx, Op::SAddr, TY_U64, 0, 0, s, pcx);
    ir_store(cx, TY_U64, base, emit_ir_v, 0, pcx);
    let ir_const_v = ir_const(cx, str_at(s).len() as i64, TY_U64, pcx);
    ir_store(cx, TY_U64, base, ir_const_v, 8, pcx);
    base
}

fn lower_ident(cx: &mut FnCtx<Comp>, n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let ty = pcx.nodes[n as usize].ty;
        let resolution = pcx.nodes[n as usize].res;
        let index = pcx.nodes[n as usize].y;
        if resolution == Res::Local {
            if is_void(ty) {
                return 0;
            }
            if (*pcx.promote.add(index as usize)) != 0 {
                return ssa_read(cx, index, pcx.ir_cur, pcx);
            }
            return load_scalar(cx, (*pcx.local_addr.add(index as usize)), ty, pcx);
        }
        if resolution == Res::Const {
            return ir_const(cx, const_value(index, pcx), ir_type(ty, pcx), pcx);
        }
        if resolution == Res::Static {
            let static_address_v = static_address(cx, pcx.nodes[n as usize].a, pcx);
            return load_scalar(cx, static_address_v, ty, pcx);
        }
        emit_ir(cx, Op::FAddr, TY_U64, 0, 0, index, pcx)
    }
}

// ---- Operators ----

pub fn arith_op(token: Tok) -> Op {
    match token {
        Tok::Plus => Op::Add,
        Tok::Minus => Op::Sub,
        Tok::Star => Op::Mul,
        Tok::Slash => Op::Div,
        Tok::Percent => Op::Rem,
        Tok::Amp => Op::And,
        Tok::Pipe => Op::Or,
        Tok::Caret => Op::Xor,
        Tok::Shl => Op::Shl,
        _ => Op::Shr,
    }
}

// a <token> b, for operands of type `operand_ty` and a result of type `ty`.
pub fn lower_operator(cx: &mut FnCtx<Comp>, token: Tok, operand_ty: i64, ty: i64, a: i64, b: i64,
    pcx: &mut Ctx<Comp>) -> i64 {
    if is_comparison(token) {
        return ir_cmp(cx, cond_of_token(token), ir_type(operand_ty, pcx), a, b, pcx);
    }
    if is_float(ty) && token == Tok::Percent {
        let mark = cx.ssa_stack.len() as i64;
        push_arg(cx, a, ty);
        push_arg(cx, b, ty);
        let call = emit_ir(cx, Op::CallC, ty, 0, 0,
            intern_c(if ty == TY_F32 { c"fmodf" } else { c"fmod" }, pcx), pcx);
        take_args(cx, call, mark);
        return call;
    }
    // (0.26.3, decision 6) an 8- or 16-bit shift's amount modulo its bits,
    // as Rust's release arithmetic (the machine's shift takes it modulo 32)
    if (token == Tok::Shl || token == Tok::Shr) && is_integer(ty) && int_bits(ty) < 32 {
        let mask = ir_const(cx, int_bits(ty) - 1, ty, pcx);
        let arith_op_v = arith_op(token);
        let ir_type_v = ir_type(ty, pcx);
        let ir_binary_v = ir_binary(cx, Op::And, ir_type(ty, pcx), b, mask, pcx);
        return ir_binary(cx, arith_op_v, ir_type_v, a,
            ir_binary_v, pcx);
    }
    ir_binary(cx, arith_op(token), ir_type(ty, pcx), a, b, pcx)
}

// (0.26.1) <token> value, `-`, `!` or `~` on a scalar, of type `ty`.
pub fn lower_unop(cx: &mut FnCtx<Comp>, token: Tok, ty: i64, value: i64, pcx: &Ctx<Comp>) -> i64 {
    if token == Tok::Minus {
        return emit_ir(cx, Op::Neg, ir_type(ty, pcx), value, 0, 0, pcx);
    }
    if token == Tok::Bang {
        return emit_ir(cx, Op::Not, TY_BOOL, value, 0, 0, pcx);
    }
    emit_ir(cx, Op::BNot, ir_type(ty, pcx), value, 0, 0, pcx)
}

pub fn ir_conv(cx: &mut FnCtx<Comp>, value: i64, from: i64, to: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = emit_ir(cx, Op::Conv, to, value, 0, 0, pcx);
    unsafe { (cx.insts[v as usize]).imm2 = from; }
    v
}

// `value as to`, value of checker type `checker_from` (the one function
// both lowerings convert with).
pub fn lower_cast(cx: &mut FnCtx<Comp>, value: i64, checker_from: i64, to: i64, pcx: &Ctx<Comp>) -> i64 {
    let from = scalar_type(checker_from, pcx);
    if from == TY_NEVER || from == to || from == TY_BOOL {
        return value;
    }
    let operand = need_value(cx, value, from, pcx);
    if is_float(from) || is_float(to) {
        return ir_conv(cx, operand, ir_type(from, pcx), ir_type(to, pcx), pcx);
    }
    // Integers and pointers: truncate or extend to `to`.
    if !is_integer(to) || int_bits(to) == 64 {
        return operand;
    }
    ir_conv(cx, operand, ir_type(from, pcx), to, pcx)
}

// ---- Enums and slices ----

// (0.26.1) The slice `base[lo..hi]` (node n: inclusive or not, its site),
// of the base of type base_ty at `value` (a pointer's value; a slice's or
// an array's address), its bounds lo and hi (0: none, its length) of type
// bound_ty: checked unless the base is a pointer, in a new slot.
pub fn slice_of_values(cx: &mut FnCtx<Comp>, n: i64, base_ty: i64, value: i64, lo: i64, hi0: i64,
    bound_ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let inclusive = pcx.nodes[pcx.nodes[n as usize].b as usize].c != 0;
        let elem_size = type_size(pcx.types[base_ty as usize].a, pcx);
        let mut hi = hi0;
        let mut pointer = value;
        let mut length: i64 = 0;
        if pcx.types[base_ty as usize].kind == TyKind::Ptr {
            pointer = value;
        } else if is_slice(base_ty, pcx) {
            pointer = ir_load(cx, TY_U64, value, 0, pcx);
            length = ir_load(cx, TY_U64, value, 8, pcx);
        } else if pcx.types[base_ty as usize].kind == TyKind::Array {
            length = ir_const(cx, pcx.types[base_ty as usize].b, TY_U64, pcx);
        }
        if hi == 0 {
            hi = length;
        }
        let mut end = hi;
        if inclusive {
            let ir_const_v = ir_const(cx, 1, TY_U64, pcx);
            end = ir_binary(cx, Op::Add, TY_U64, hi, ir_const_v, pcx);
        }
        if pcx.types[base_ty as usize].kind != TyKind::Ptr {
            let kind = panic_kind(bound_ty, true);
            let pcx_site4 = site_of(n, 0, pcx);
            let ir_cmp_v = ir_cmp(cx, if inclusive { Cond::Lt } else { Cond::Le }, TY_U64, hi,
                length, pcx);
            lower_check(cx,
                ir_cmp_v,
                kind, lo, end, length, pcx, pcx_site4, 0);
            let pcx_site5 = site_of(n, 0, pcx);
            let ir_cmp_v1 = ir_cmp(cx, Cond::Le, TY_U64, lo, end, pcx);
            lower_check(cx, ir_cmp_v1, kind, lo, end, length,
                pcx, pcx_site5, 0);
        }
        let mut scaled = lo;
        if elem_size != 1 {
            let ir_const_v1 = ir_const(cx, elem_size, TY_U64, pcx);
            scaled = ir_binary(cx, Op::Mul, TY_U64, lo, ir_const_v1,
                pcx);
        }
        let start = ir_binary(cx, Op::Add, TY_U64, pointer, scaled, pcx);
        if pcx.types[base_ty as usize].kind == TyKind::Ptr {
            let count = ir_binary(cx, Op::Sub, TY_U64, end, lo, pcx);
            let ir_const_v2 = ir_const(cx, elem_size, TY_U64, pcx);
            let ir_binary_v = ir_binary(cx, Op::Mul, TY_U64, count,
                ir_const_v2, pcx);
            raw_check(cx, n, start,
                ir_binary_v,
                pcx);
        }
        let new_slot_for_v = new_slot_for(cx, pcx.nodes[n as usize].ty, pcx);
        let result = ir_slot_addr(cx, new_slot_for_v, pcx);
        ir_store(cx, TY_U64, result, start, 0, pcx);
        // (0.25.5) a slice from 0 (`p[0..n]`, as Vec's as_slice takes for each
        // `v[i]`): its length is the end, with no `end - 0` (the fold of `x - 0`
        // keeps it when x is an i64 and the length a u64)
        let from_zero = (cx.insts[lo as usize]).op == Op::Const
            && (cx.insts[lo as usize]).imm == 0;
        let arg_v = if from_zero { end } else { ir_binary(cx, Op::Sub, TY_U64, end, lo, pcx) };
        ir_store(cx, TY_U64, result,
            arg_v, 8, pcx);
        result
    }
}

// ---- Aggregates ----

// Stores `value` (of checker type `ty`) at addr + offset.
pub fn store_value(cx: &mut FnCtx<Comp>, addr: i64, offset: i64, value: i64, ty: i64,
    pcx: &mut Ctx<Comp>) {
    if is_void(ty) {
        return;
    }
    let v = need_value(cx, value, ty, pcx);
    if is_compound(ty, pcx) {
        let ir_offset_v = ir_offset(cx, addr, offset, pcx);
        lower_copy(cx, ir_offset_v, v, type_size(ty, pcx), pcx);
    } else {
        ir_store(cx, ir_type(ty, pcx), addr, v, offset, pcx);
    }
}
