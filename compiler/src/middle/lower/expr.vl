// Lowering expressions: lower_expr lowers an operand the places-IR
// lowering did not bind (places.vl): a literal, a check's site or a name
// (0.26.2: the AST lowering of the other expressions, of statements and
// of control flow is gone). Here too: the bound operands of the calls',
// intrinsics' and vector operations' lowerings, casts, and string
// values.

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::front::ast::{INT_SITE, NODES, NodeKind};
use crate::front::ast::NodeKind::{Array, Bool, CStr, Char, Float, Ident, Int, Str, Unit};
use crate::front::check::{Res, type_error};
use crate::front::consteval::{const_value, f64_of_bits, float_const, wrap_int};
use crate::front::contracts::sites::site_of;
use crate::front::lexer::{Tok, str_at};
use crate::front::parser::exprs::is_comparison;
use crate::front::types::{
    TYPES, TY_BOOL, TY_F32, TY_NEVER, TY_STRING, TY_U64, TyKind, int_bits, is_compound, is_float,
    is_integer, is_signed, is_slice, is_void, scalar_type, type_size,
};
use crate::gen0::gen::expr::panic_kind;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    CUR, Cond, IR_CALL_LOCS, IR_EXPR_LOC, Op, RT_SITE, Term, cond_of_token, emit_ir, ir_binary,
    ir_cmp, ir_const, ir_load, ir_offset, ir_rtid, ir_slot_addr, ir_store, ir_type,
};
use crate::middle::ir::cfg::ir_terminate;
use crate::middle::lower::{is_dead_block, lower_copy, new_slot_for, start_dead_block};
use crate::middle::lower::calls::{
    lower_check, lower_overflow_check, push_arg, raw_check, static_address, take_args,
};
use crate::middle::lower::ssa::{LOCAL_ADDR, PROMOTE, ssa_read, ssa_undef};

// ---- Expressions ----

// `value`, or an undefined value of type `ty` when there is none (in code
// after a diverging expression).
pub fn need_value(cx: sink *FnCtx, value: i64, ty: i64) -> i64 {
    if value != 0 || is_void(ty) {
        return value;
    }
    ssa_undef(cx, ir_type(ty))
}

// (0.26.1) An operand of a call, an intrinsic or a vector operation,
// expression e: the one point where those lowerings read their operands,
// so that the places-IR lowering gives them its operands' values instead
// of the AST's (lower_call, arch.vl, vector.vl, atomic.vl). `operand_expr`
// is lower_expr's value (0 when there is none), `operand_value` its value
// of e's type.
pub fn operand_expr(cx: sink *FnCtx, e: i64) -> i64 {
    if BOUND_NODES.len() as i64 > 0 {
        for k in 0..BOUND_NODES.len() as i64 {
            if BOUND_NODES[k] == e {
                return BOUND_VALUES[k];
            }
        }
    }
    lower_expr(cx, e)
}

// (0.26.1) The operands the places-IR lowering has bound (places.vl,
// bind_operand): AST node BOUND_NODES[k] is the value BOUND_VALUES[k]
// while a call, an intrinsic or a vector operation of the IR is lowered
// by the AST's lowering of its node.
pub static var BOUND_NODES: Vec<i64, Comp> = Vec::new_in(Comp {});
pub static var BOUND_VALUES: Vec<i64, Comp> = Vec::new_in(Comp {});

pub fn operand_value(cx: sink *FnCtx, e: i64) -> i64 {
    need_value(cx, operand_expr(cx, e), NODES[e].ty)
}

fn load_scalar(cx: sink *FnCtx, addr: i64, ty: i64) -> i64 {
    if is_compound(ty) {
        return addr;
    }
    if is_void(ty) {
        return 0;
    }
    ir_load(cx, ir_type(ty), addr, 0)
}

pub fn lower_expr(cx: sink *FnCtx, n: i64) -> i64 {
    if IR_CALL_LOCS {
        IR_EXPR_LOC = NODES[n].start + 1;
    }
    let value = lower_expr_inner(cx, n);
    if NODES[n].ty == TY_NEVER {
        if !is_dead_block(cx, CUR) {
            ir_terminate(cx, CUR, Term::Unreach, 0, 0, 0);
            start_dead_block(cx);
        }
        return 0;
    }
    value
}

fn lower_expr_inner(cx: sink *FnCtx, n: i64) -> i64 {
    unsafe {
        let ty = NODES[n].ty;
        match NODES[n].kind {
            // (0.18.1: a check's site, an RTID value)
            Int if (NODES[n].p & INT_SITE) != 0 && NODES[n].a != 0 => {
                ir_rtid(cx, RT_SITE, NODES[n].a, ir_type(ty))
            }
            Int | Char => ir_const(cx, wrap_int(NODES[n].a, ty), ir_type(ty)),
            Float => ir_const(cx, float_const(f64_of_bits(NODES[n].a), ty), ty),
            Bool => ir_const(cx, NODES[n].a, TY_BOOL),
            Unit => 0,
            Str => lower_string(cx, n),
            CStr => emit_ir(cx, Op::SAddr, TY_U64, 0, 0, NODES[n].a),
            Ident => lower_ident(cx, n),
            _ => type_error(n, c"internal error: unexpected node in IR lowering"),
        }
    }
}

fn lower_string(cx: sink *FnCtx, n: i64) -> i64 {
    string_value(cx, NODES[n].a)
}

// (0.26.1) String literal s (its id): a new slot holding its pointer and
// length.
pub fn string_value(cx: sink *FnCtx, s: i64) -> i64 {
    let base = ir_slot_addr(cx, new_slot_for(cx, TY_STRING));
    ir_store(cx, TY_U64, base, emit_ir(cx, Op::SAddr, TY_U64, 0, 0, s), 0);
    ir_store(cx, TY_U64, base, ir_const(cx, str_at(s).len as i64, TY_U64), 8);
    base
}

fn lower_ident(cx: sink *FnCtx, n: i64) -> i64 {
    unsafe {
        let ty = NODES[n].ty;
        let resolution = NODES[n].res;
        let index = NODES[n].y;
        if resolution == Res::Local {
            if is_void(ty) {
                return 0;
            }
            if PROMOTE[index] != 0 {
                return ssa_read(cx, index, CUR);
            }
            return load_scalar(cx, LOCAL_ADDR[index], ty);
        }
        if resolution == Res::Const {
            return ir_const(cx, const_value(index), ir_type(ty));
        }
        if resolution == Res::Static {
            return load_scalar(cx, static_address(cx, NODES[n].a), ty);
        }
        emit_ir(cx, Op::FAddr, TY_U64, 0, 0, index)
    }
}

// ---- Operators ----

pub fn arith_op(token: Tok) -> Op {
    match token {
        Tok::Plus => Op::Add,
        Tok::Minus => Op::Sub,
        Tok::Star => Op::Mul,
        Tok::Slash => Op::Div,
        Tok::Percent => Op::Rem,
        Tok::Amp => Op::And,
        Tok::Pipe => Op::Or,
        Tok::Caret => Op::Xor,
        Tok::Shl => Op::Shl,
        _ => Op::Shr,
    }
}

// a <token> b, for operands of type `operand_ty` and a result of type `ty`.
// (0.26.2, a prototype) site: the operation's, for its overflow check.
pub fn lower_operator(cx: sink *FnCtx, token: Tok, operand_ty: i64, ty: i64, a: i64, b: i64,
    site: i64 = 0) -> i64 {
    if is_comparison(token) {
        return ir_cmp(cx, cond_of_token(token), ir_type(operand_ty), a, b);
    }
    if is_float(ty) && token == Tok::Percent {
        let mark = unsafe { cx.ssa_stack.count };
        push_arg(cx, a, ty);
        push_arg(cx, b, ty);
        let call = emit_ir(cx, Op::CallC, ty, 0, 0,
            intern_c(if ty == TY_F32 { c"fmodf" } else { c"fmod" }));
        take_args(cx, call, mark);
        return call;
    }
    let op = arith_op(token);
    let r = ir_binary(cx, op, ir_type(ty), a, b);
    lower_overflow_check(cx, op, ty, a, b, site);
    r
}

// (0.26.1) <token> value, `-`, `!` or `~` on a scalar, of type `ty`.
// (0.26.2, a prototype) site: the operation's, for its overflow check (-1:
// none, as for a literal's sign).
pub fn lower_unop(cx: sink *FnCtx, token: Tok, ty: i64, value: i64, site: i64 = -1) -> i64 {
    if token == Tok::Minus {
        let r = emit_ir(cx, Op::Neg, ir_type(ty), value, 0, 0);
        if site >= 0 && is_signed(ty) {
            lower_overflow_check(cx, Op::Neg, ty, value, 0, site);
        }
        return r;
    }
    if token == Tok::Bang {
        return emit_ir(cx, Op::Not, TY_BOOL, value, 0, 0);
    }
    emit_ir(cx, Op::BNot, ir_type(ty), value, 0, 0)
}

pub fn ir_conv(cx: sink *FnCtx, value: i64, from: i64, to: i64) -> i64 {
    let v = emit_ir(cx, Op::Conv, to, value, 0, 0);
    unsafe { cx.insts[v].imm2 = from; }
    v
}

// `value as to`, value of checker type `checker_from` (the one function
// both lowerings convert with).
pub fn lower_cast(cx: sink *FnCtx, value: i64, checker_from: i64, to: i64) -> i64 {
    let from = scalar_type(checker_from);
    if from == TY_NEVER || from == to || from == TY_BOOL {
        return value;
    }
    let operand = need_value(cx, value, from);
    if is_float(from) || is_float(to) {
        return ir_conv(cx, operand, ir_type(from), ir_type(to));
    }
    // Integers and pointers: truncate or extend to `to`.
    if !is_integer(to) || int_bits(to) == 64 {
        return operand;
    }
    ir_conv(cx, operand, ir_type(from), to)
}

// ---- Enums and slices ----

// (0.26.1) The slice `base[lo..hi]` (node n: inclusive or not, its site),
// of the base of type base_ty at `value` (a pointer's value; a slice's or
// an array's address), its bounds lo and hi (0: none, its length) of type
// bound_ty: checked unless the base is a pointer, in a new slot.
pub fn slice_of_values(cx: sink *FnCtx, n: i64, base_ty: i64, value: i64, lo: i64, hi0: i64,
    bound_ty: i64) -> i64 {
    unsafe {
        let inclusive = NODES[NODES[n].b].c != 0;
        let elem_size = type_size(TYPES[base_ty].a);
        var hi = hi0;
        var pointer = value;
        var length = 0;
        if TYPES[base_ty].kind == TyKind::Ptr {
            pointer = value;
        } else if is_slice(base_ty) {
            pointer = ir_load(cx, TY_U64, value, 0);
            length = ir_load(cx, TY_U64, value, 8);
        } else if TYPES[base_ty].kind == TyKind::Array {
            length = ir_const(cx, TYPES[base_ty].b, TY_U64);
        }
        if hi == 0 {
            hi = length;
        }
        var end = hi;
        if inclusive {
            end = ir_binary(cx, Op::Add, TY_U64, hi, ir_const(cx, 1, TY_U64));
        }
        if TYPES[base_ty].kind != TyKind::Ptr {
            let kind = panic_kind(bound_ty, true);
            lower_check(cx,
                ir_cmp(cx, if inclusive { Cond::Lt } else { Cond::Le }, TY_U64, hi, length), kind,
                lo, end, length, site_of(n, 0));
            lower_check(cx, ir_cmp(cx, Cond::Le, TY_U64, lo, end), kind, lo, end, length,
                site_of(n, 0));
        }
        var scaled = lo;
        if elem_size != 1 {
            scaled = ir_binary(cx, Op::Mul, TY_U64, lo, ir_const(cx, elem_size, TY_U64));
        }
        let start = ir_binary(cx, Op::Add, TY_U64, pointer, scaled);
        if TYPES[base_ty].kind == TyKind::Ptr {
            let count = ir_binary(cx, Op::Sub, TY_U64, end, lo);
            raw_check(cx, n, start,
                ir_binary(cx, Op::Mul, TY_U64, count, ir_const(cx, elem_size, TY_U64)));
        }
        let result = ir_slot_addr(cx, new_slot_for(cx, NODES[n].ty));
        ir_store(cx, TY_U64, result, start, 0);
        // (0.25.5) a slice from 0 (`p[0..n]`, as Vec's as_slice takes for each
        // `v[i]`): its length is the end, with no `end - 0` (the fold of `x - 0`
        // keeps it when x is an i64 and the length a u64)
        let from_zero = cx.insts[lo].op == Op::Const && cx.insts[lo].imm == 0;
        ir_store(cx, TY_U64, result,
            if from_zero { end } else { ir_binary(cx, Op::Sub, TY_U64, end, lo) }, 8);
        result
    }
}

// ---- Aggregates ----

// Stores `value` (of checker type `ty`) at addr + offset.
pub fn store_value(cx: sink *FnCtx, addr: i64, offset: i64, value: i64, ty: i64) {
    if is_void(ty) {
        return;
    }
    let v = need_value(cx, value, ty);
    if is_compound(ty) {
        lower_copy(cx, ir_offset(cx, addr, offset), v, type_size(ty));
    } else {
        ir_store(cx, ir_type(ty), addr, v, offset);
    }
}
