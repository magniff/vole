// Lowering calls (arguments as the callee's convention takes them, compound
// results through a result pointer) and the run-time checks: the branch to
// a panic when a check fails, panics, and with --check-unsafe the checks of
// raw-pointer accesses.

use crate::arch::intrinsic_of_fn;
use crate::back::abi::{
    AbiClass, conv_classify, conv_returns_through_pointer, fn_type_uses_c, fn_uses_c, variadic_kind,
};
use crate::base::{IntVec, die, free, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::X86;
use crate::front::ast::{NODE_RAW, child};
use crate::front::contracts::checks::{check_message, check_values};
use crate::front::modules::{item_symbol, within_std};
use crate::front::threadlocal::{symbol_is_thread_local, tls_addr_fn};
use crate::front::types::{
    TY_BOOL, TY_F32, TY_F64, TY_I64, TY_U64, fn_param, is_compound, is_void, scalar_type, type_elem,
    type_size,
};
use crate::gen0::target::{make_rt_note_sym, make_rt_panic_sym, message_kind};
use crate::middle::checkalloc::site_before_call;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    BITS_LEADING, BITS_ONES, BITS_TRAILING, IRFUNCS, Op, RT_KIND, RT_SITE, Term, VARIADIC_PIECE,
    emit_ir, ir_const, ir_load, ir_new_block, ir_rtid, ir_slot_addr, ir_store, ir_type,
};
use crate::middle::ir::cfg::ir_terminate;
use crate::middle::lower::{is_fresh, lower_branch, lower_copy, new_slot_for, start_dead_block};
use crate::middle::lower::arch::{NOT_LOWERED, lower_intrinsic};
use crate::middle::lower::atomic::{atomic_intrinsic, lower_atomic_call};
use crate::middle::lower::expr::{ir_conv, need_value, operand_expr, operand_value};
use crate::middle::lower::ssa::ir_seal;
use crate::middle::unsafecheck::{check_function, redirect_alloc, site_string};
use crate::tools::query::checks::note_check;

// ---- Calls ----

pub fn push_arg(cx: inout FnCtx, value: i64, ty: i64) {
    cx.ssa_stack.push(value);
    cx.ssa_stack.push(ty);
}

// Moves the arguments pushed since `mark` into call `call`.
pub fn take_args(cx: inout FnCtx, call: i64, mark: i64) {
    unsafe {
        let count = (cx.ssa_stack.count - mark) / 2;
        cx.insts[call].args = cx.args.count;
        cx.insts[call].nargs = count;
        for i in 0..count {
            cx.args.push(cx.ssa_stack.data[mark + 2 * i]);
            cx.argty.push(cx.ssa_stack.data[mark + 2 * i + 1]);
        }
        cx.ssa_stack.count = mark;
    }
}

// (0.21) The address of static `sym` (its symbol): GADDR, or for a
// thread-local this thread's copy, std::thread::__tls_addr(GADDR, size)
// (front/threadlocal.vl).
pub fn static_address(cx: sink *FnCtx, sym: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let g = emit_ir(cx, Op::GAddr, TY_U64, 0, 0, sym, pcx);
        if !symbol_is_thread_local(sym, pcx) {
            return g;
        }
        let f = tls_addr_fn(&pcx);
        if f < 0 {
            die(c"internal error: a thread-local without std::thread");
        }
        let size = type_size(pcx.statics[pcx.sym_static[sym] - 1].ty, pcx);
        let mark = cx.ssa_stack.count;
        push_arg(&*cx, g, TY_U64);
        push_arg(&*cx, ir_const(cx, size, TY_I64, pcx), TY_I64);
        let call = emit_ir(cx, Op::Call, TY_U64, 0, 0, f, pcx);
        take_args(&*cx, call, mark);
        call
    }
}

// (0.16) The count std's function f makes (BITS_ONES, BITS_LEADING,
// BITS_TRAILING) when its call is a BITS instruction here, else -1:
// count_ones, leading_zeros and trailing_zeros, on AArch64.
fn bits_kind(f: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if X86 || f < 0 || !within_std(pcx.fns[f].module, pcx) || pcx.fns[f].param_count != 1 {
            return -1;
        }
        let name = pcx.fns[f].name;
        let m = pcx.fns[f].module;
        if name == item_symbol(m, intern_c(c"count_ones", &pcx), &pcx) {
            return BITS_ONES;
        }
        if name == item_symbol(m, intern_c(c"leading_zeros", &pcx), &pcx) {
            return BITS_LEADING;
        }
        if name == item_symbol(m, intern_c(c"trailing_zeros", &pcx), &pcx) {
            return BITS_TRAILING;
        }
        -1
    }
}

// (0.20) Whether f is std::num::mul_hi, whose call is a MULH instruction
// here (unsigned, imm 0: the high half of the 128-bit product), on
// AArch64; elsewhere its body (four 32-bit products).
fn is_std_mul_hi(f: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        if X86 || f < 0 || !within_std(pcx.fns[f].module, pcx) || pcx.fns[f].param_count != 2 {
            return false;
        }
        pcx.fns[f].name == item_symbol(pcx.fns[f].module, intern_c(c"mul_hi", &pcx), &pcx)
    }
}

pub fn lower_call(cx: inout FnCtx, n: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let callee = pcx.nodes[n].a;
        // (--check-unsafe: malloc and the like go through the runtime)
        let direct = redirect_alloc(pcx.nodes[n].x - 1, pcx.fns[IRFUNCS[cx.irf].f].module, &pcx);
        // (0.19: std::arch's intrinsics, by their table's IR form)
        let intr = intrinsic_of_fn(direct, pcx);
        if intr >= 0 {
            let value = lower_intrinsic(&cx, n, direct, intr, &pcx);
            if value != NOT_LOWERED {
                return value;
            }
        }
        let kind = bits_kind(direct, &pcx);
        if kind >= 0 {
            let x = need_value(&cx, operand_expr(&cx, child(n, 0, pcx), &pcx), TY_U64, pcx);
            return emit_ir(&cx, Op::Bits, TY_I64, x, 0, kind, pcx);
        }
        if is_std_mul_hi(direct, &pcx) {
            // (0.20) std::num::mul_hi: one umulh
            let a = need_value(&cx, operand_expr(&cx, child(n, 0, pcx), &pcx), TY_U64, pcx);
            let b = need_value(&cx, operand_expr(&cx, child(n, 1, pcx), &pcx), TY_U64, pcx);
            return emit_ir(&cx, Op::MulH, TY_U64, a, b, 0, pcx);
        }
        // (0.21: std's atomic intrinsics, ATOMIC and FENCE)
        let akind = atomic_intrinsic(direct, pcx);
        if akind >= 0 {
            return lower_atomic_call(&cx, n, direct, akind, &pcx);
        }
        let conv = call_conv(direct, if direct >= 0 { 0 } else { pcx.nodes[callee].ty }, pcx);
        let mark = cx.ssa_stack.count;
        for i in 0..pcx.nodes[n].count {
            let arg = child(n, i, pcx);
            let ty = call_param_ty(conv, i, pcx.nodes[arg].ty, pcx);
            push_call_arg(&cx, conv, i, operand_expr(&cx, arg, &pcx), ty, is_fresh(arg, pcx), &pcx);
        }
        var callee_value = 0;
        if direct < 0 {
            callee_value = operand_value(&cx, callee, &pcx);
        }
        emit_call_of(&cx, conv, callee_value, mark, n, &pcx)
    }
}

// (0.26.1) A call's convention: its function (FNS; -1 for a call of a
// function value, of type callee_ty), its parameters' count, its result's
// type, whether it is variadic and whether it takes C's convention. The
// ABI part of a call, from either lowering: call_conv, then each argument
// with push_call_arg, then emit_call_of.
pub struct CallConv {
    pub direct: i64, pub callee_ty: i64, pub param_count: i64, pub ret: i64, pub variadic: bool,
    pub c: bool,
}

pub fn call_conv(direct: i64, callee_ty: i64, pcx: Ctx<Comp>) -> CallConv {
    // UNSAFE: FNS and TYPES are the checker's raw tables of functions and types.
    // SAFETY: direct is a function the checker resolved (below FN_COUNT), callee_ty a
    // function type of the checked call; both tables are read only after checking.
    unsafe {
        if direct >= 0 {
            return CallConv {
                direct, callee_ty: 0, param_count: pcx.fns[direct].param_count,
                ret: pcx.fns[direct].ret,
                variadic: pcx.fns[direct].variadic, c: fn_uses_c(direct, pcx),
            };
        }
        CallConv {
            direct, callee_ty, param_count: pcx.types[callee_ty].count, ret: pcx.types[callee_ty].a,
            variadic: false, c: fn_type_uses_c(callee_ty, pcx),
        }
    }
}

// The type argument i is passed as: its parameter's, or for a variadic
// one past them, its own (arg_ty).
pub fn call_param_ty(conv: CallConv, i: i64, arg_ty: i64, pcx: Ctx<Comp>) -> i64 {
    if i >= conv.param_count {
        return arg_ty;
    }
    if conv.direct >= 0 { fn_param(conv.direct, i, pcx) } else { type_elem(conv.callee_ty, i, pcx) }
}

// Argument i of a call, `value` (0 when it has none) of type ty, pushed as
// the convention passes it: a compound one copied unless it is `fresh` (a
// new temporary), in pieces or by its address; a variadic f32 promoted.
pub fn push_call_arg(cx: inout FnCtx, conv: CallConv, i: i64, value0: i64, ty0: i64, fresh: bool,
    pcx: inout Ctx<Comp>) {
    if is_void(ty0) {
        return;
    }
    var ty = ty0;
    var value = need_value(&cx, value0, ty, pcx);
    let extra = conv.variadic && i >= conv.param_count;
    if is_compound(ty, pcx) {
        if !fresh {
            let copy = ir_slot_addr(&cx, new_slot_for(&cx, ty, pcx), pcx);
            lower_copy(&cx, copy, value, type_size(ty, pcx), &pcx);
            value = copy;
        }
        let kind = if extra { variadic_kind(&cx, ty, pcx) }
            else { conv_classify(&cx, conv.c, ty, pcx) };
        if kind == AbiClass::Pieces {
            // Its pieces, read from the (new) slot; a variadic one's
            // first piece carries its type (see call_locations).
            // UNSAFE: cx is the lowering's raw *FnCtx; its ABI piece tables are fields of it.
            // SAFETY: cx points at the function's live context for the whole lowering, and
            // conv_classify just filled abi_piece_count (at most 4) pieces.
            unsafe {
                for k in 0..cx.abi_piece_count {
                    let piece = ir_load(&cx, cx.abi_piece_ty[k], value, cx.abi_piece_offset[k],
                        pcx);
                    var arg_ty = cx.abi_piece_ty[k];
                    if extra {
                        arg_ty = if k == 0 { 0 - ty } else { VARIADIC_PIECE };
                    }
                    push_arg(&cx, piece, arg_ty);
                }
            }
            return;
        }
        push_arg(&cx, value, if extra { 0 - ty } else { ty });
        return;
    }
    if extra && ty == TY_F32 {
        // C's default promotion.
        value = ir_conv(&cx, value, TY_F32, TY_F64, pcx);
        ty = TY_F64;
    }
    let arg_ty = scalar_type(ty, pcx);
    push_arg(&cx, value, if extra { 0 - arg_ty } else { arg_ty });
}

// The call of a call whose arguments were pushed since `mark` (callee_value
// the function value of an indirect one), for call node n (its
// --check-alloc site): its value (a compound result's address; 0 for
// none).
pub fn emit_call_of(cx: inout FnCtx, conv: CallConv, callee_value: i64, mark: i64, n: i64,
    pcx: inout Ctx<Comp>)
    -> i64 {
    // UNSAFE: cx is the lowering's raw *FnCtx (its instructions and ABI piece tables).
    // SAFETY: cx points at the function's live context for the whole lowering; call is
    // the instruction emit_ir just made, and conv_classify fills at most 4 pieces.
    unsafe {
        let ret = conv.ret;
        let c = conv.c;
        var result_ptr = 0;
        if is_compound(ret, pcx) {
            result_ptr = if pcx.result_dest != 0 { pcx.result_dest }
                else { ir_slot_addr(&cx, new_slot_for(&cx, ret, pcx), pcx) };
        }
        pcx.result_dest = 0;
        let result_ty = if is_compound(ret, pcx) { 0 } else { ir_type(ret, pcx) };
        // (0.16: --check-alloc's allocation site, the arguments lowered)
        site_before_call(&cx, n, &pcx);
        var call = 0;
        if conv.direct >= 0 {
            call = emit_ir(&cx, Op::Call, result_ty, 0, 0, conv.direct, pcx);
        } else {
            call = emit_ir(&cx, Op::CallI, result_ty, callee_value, 0, conv.callee_ty, pcx);
        }
        let in_registers = is_compound(ret, pcx) && !conv_returns_through_pointer(&cx, c, ret, pcx);
        cx.insts[call].c = if in_registers { 0 } else { result_ptr };
        take_args(&cx, call, mark);
        if in_registers {
            // Its pieces, from the result registers (PIECE instructions right
            // after the call), stored into the result's slot.
            conv_classify(&cx, c, ret, pcx);
            let count = cx.abi_piece_count;
            var pieces: [i64; 4] = [0; 4];
            for k in 0..count {
                pieces[k] = emit_ir(&cx, Op::Piece, cx.abi_piece_ty[k], call, 0, k, pcx);
            }
            for k in 0..count {
                ir_store(&cx, cx.abi_piece_ty[k], result_ptr, pieces[k], cx.abi_piece_offset[k],
                    pcx);
            }
        }
        if is_compound(ret, pcx) {
            return result_ptr;
        }
        if result_ty == 0 {
            return 0;
        }
        call
    }
}

// ---- Checks ----

// Continues when `ok` holds; otherwise calls the run-time helper (see
// emit_panic) with kind, a, b and c, which does not return. (0.18) site:
// the check's site (front/contracts/sites.vl; 0: none), whose position
// the helper prints first; `site_value`: the site as a value instead (a
// requires' call site, a parameter of its check), or 0.
pub fn lower_check(cx: inout FnCtx, ok: i64, kind: i64, a: i64, b: i64, c: i64,
    pcx: inout Ctx<Comp>, site: i64 = 0, site_value: i64 = 0) {
    pcx.panic_used = true;
    let pass = ir_new_block(&cx);
    let fail = ir_new_block(&cx);
    lower_branch(&cx, ok, pass, fail, pcx);
    ir_seal(&cx, fail, pcx);
    pcx.ir_cur = fail;
    rt_panic_call(&cx, kind, a, b, c, site, site_value, &pcx);
    ir_seal(&cx, pass, pcx);
    pcx.ir_cur = pass;
}

// (0.26.3, decision 6) The check that `a <op> b` (op Add, Sub, Mul, or Neg
// with b 0, signed) does not overflow integer type `ty` (a checker type):
// an OVF (middle/ir: the range pass and the folder decide it, AArch64
// fuses it with its operation) and a branch to the panic of `kind`, Rust's
// message, at `site` when it holds.
pub fn overflow_branch(cx: inout FnCtx, op: Op, ty: i64, a: i64, b: i64, kind: i64, site: i64,
    pcx: inout Ctx<Comp>) {
    pcx.panic_used = true;
    let ovf = emit_ir(&cx, Op::Ovf, TY_BOOL, a, b, (op as i64) | (ir_type(ty, pcx) << 8), pcx);
    let pass = ir_new_block(&cx);
    let fail = ir_new_block(&cx);
    lower_branch(&cx, ovf, fail, pass, pcx);
    ir_seal(&cx, fail, pcx);
    pcx.ir_cur = fail;
    rt_panic_call(&cx, kind, 0, 0, 0, site, 0, &pcx, census_to(pass, pcx));
    ir_seal(&cx, pass, pcx);
    pcx.ir_cur = pass;
}

// (0.26.3, decision 6) Continues when `ok` holds; otherwise Rust's
// arithmetic panic of `kind` at `site` (lower_check's, but noted and
// passed by under $VOLE_OVF_CENSUS).
pub fn arith_check(cx: inout FnCtx, ok: i64, kind: i64, site: i64, pcx: inout Ctx<Comp>) {
    pcx.panic_used = true;
    let pass = ir_new_block(&cx);
    let fail = ir_new_block(&cx);
    lower_branch(&cx, ok, pass, fail, pcx);
    ir_seal(&cx, fail, pcx);
    pcx.ir_cur = fail;
    rt_panic_call(&cx, kind, 0, 0, 0, site, 0, &pcx, census_to(pass, pcx));
    ir_seal(&cx, pass, pcx);
    pcx.ir_cur = pass;
}

// (0.26.3, measuring) The block a failed arithmetic check goes on to
// under $VOLE_OVF_CENSUS (AArch64), else -1: it panics.
fn census_to(pass: i64, pcx: Ctx<Comp>) -> i64 {
    if pcx.ovf_census && !X86 { pass } else { 0 - 1 }
}

// (0.18) The call of the run-time helper in the current (failing) block,
// which ends it. (0.26.3, measuring) `note_to`: a block, rt.note called
// instead ($VOLE_OVF_CENSUS: it returns) and a jump there.
pub fn rt_panic_call(cx: inout FnCtx, kind: i64, a: i64, b: i64, c: i64, site: i64, site_value: i64,
    pcx: inout Ctx<Comp>, note_to: i64 = -1) {
    pcx.panic_used = true;
    note_check(cx.irf, site, kind, &pcx);
    let mark = cx.ssa_stack.count;
    // (0.18.1: a kind past the fixed ones and a site are RTID values, which
    // the join numbers)
    push_arg(&cx, if kind >= 4 { ir_rtid(&cx, RT_KIND, kind, TY_U64, &pcx) } else {
        ir_const(&cx, kind, TY_U64, pcx)
    }, TY_U64);
    push_arg(&cx, if a != 0 { a } else { ir_const(&cx, 0, TY_U64, pcx) }, TY_U64);
    push_arg(&cx, if b != 0 { b } else { ir_const(&cx, 0, TY_U64, pcx) }, TY_U64);
    push_arg(&cx, if c != 0 { c } else { ir_const(&cx, 0, TY_U64, pcx) }, TY_U64);
    push_arg(&cx, if site_value != 0 { site_value } else if site != 0 {
        ir_rtid(&cx, RT_SITE, site, TY_U64, &pcx)
    } else {
        ir_const(&cx, 0, TY_U64, pcx)
    }, TY_U64);
    let call = emit_ir(&cx, Op::CallC, 0, 0, 0, if note_to >= 0 { make_rt_note_sym(&pcx) } else {
        make_rt_panic_sym(&pcx)
    }, pcx);
    take_args(&cx, call, mark);
    if note_to >= 0 {
        ir_terminate(&cx, pcx.ir_cur, Term::Jump, 0, note_to, 0);
    } else {
        ir_terminate(&cx, pcx.ir_cur, Term::Unreach, 0, 0, 0);
    }
}

// (0.26.2) The failing path of conjunct conj of contract check n, its
// shown values a, b, c and its site the IR's (places.vl's
// lower_contract_failure): the message, from the AST's text, and the
// helper called.
pub fn contract_failure_at(cx: inout FnCtx, n: i64, conj: i64, site: i64, a: i64, b: i64,
    c: i64, pcx: inout Ctx<Comp>) {
    // UNSAFE: ops is a raw IntVec this function owns; NODES and IRFUNCS are raw
    // tables.
    // SAFETY: ops' data is made by check_values and freed once here; n is the
    // check's call node, cx.irf the function being lowered.
    unsafe {
        let check = pcx.nodes[child(n, 2, pcx)].a;
        var ops = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        check_values(n, conj, &ops, pcx);
        let kind = message_kind(check_message(check, conj, ops, IRFUNCS[cx.irf].f, &pcx), &pcx);
        free(ops.data as *u8);
        rt_panic_call(&cx, kind, a, b, c, 0, site, &pcx);
    }
}

// A failed `n as E`: the run-time helper with the value; does not return.
// (0.18) site: as lower_check's.
pub fn lower_panic(cx: inout FnCtx, kind: i64, a: i64, pcx: inout Ctx<Comp>, site: i64 = 0) {
    rt_panic_call(&cx, kind, a, 0, 0, site, 0, &pcx);
    start_dead_block(&cx, &pcx);
}

// ---- The checking mode (0.10) ----

// With --check-unsafe: the check of `size` bytes (an IR value) at addr,
// for the raw-pointer access n.
pub fn raw_check(cx: inout FnCtx, n: i64, addr: i64, size: i64, pcx: inout Ctx<Comp>) {
    if !pcx.check_unsafe {
        return;
    }
    // UNSAFE: NODES is the parser's raw table of nodes.
    // SAFETY: n is a node of the function being lowered, below the node count;
    // read only, single-threaded.
    unsafe {
        if (pcx.nodes[n].p & NODE_RAW) != 0 {
            raw_check_at(&cx, pcx.nodes[n].start, addr, size, &pcx);
        }
    }
}

// (0.26.2) With --check-unsafe: the check of `size` bytes at addr, for a
// raw-pointer access at source position pos (the places IR's: its
// statement's).
pub fn raw_check_at(cx: inout FnCtx, pos: i64, addr: i64, size: i64, pcx: inout Ctx<Comp>) {
    // UNSAFE: cx is the lowering's raw context pointer; FNS and IRFUNCS are
    // raw tables.
    // SAFETY: cx points at the live FnCtx, cx.irf its function's entry, whose
    // f is below FN_COUNT; lowering is single-threaded.
    unsafe {
        let m = pcx.fns[IRFUNCS[cx.irf].f].module;
        if !pcx.check_unsafe || m == pcx.check_module || m == pcx.profile_module {
            return;
        }
        let f = check_function(&pcx);
        if f < 0 {
            return;
        }
        let mark = cx.ssa_stack.count;
        push_arg(&cx, addr, TY_U64);
        push_arg(&cx, size, TY_U64);
        push_arg(&cx, emit_ir(&cx, Op::SAddr, TY_U64, 0, 0, site_string(pos, &pcx), pcx),
            pcx.ty_u8_ptr);
        let call = emit_ir(&cx, Op::Call, 0, 0, 0, f, pcx);
        take_args(&cx, call, mark);
    }
}
