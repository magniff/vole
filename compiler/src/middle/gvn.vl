// Global value numbering: a walk of the dominator tree with a scoped hash
// table of the pure instructions seen on the way down; an instruction
// equal to one that dominates it is replaced by it. Within each block,
// redundant loads are removed and stored values forwarded to later loads,
// with a simple alias analysis (see may_alias).

// The dominator tree: children of the block at layout index k are
// DOM_CHILD[DOM_START[k] .. DOM_START[k + 1]] (blocks).
use crate::back::abi::fn_uses_c;
use crate::base::{IntVec, alloc_array, find_sym, free, intern_c, table_reset};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{REF_MUT, REF_SHARED, TY_U64, TyKind, fn_param, is_integer, type_size};
use crate::middle::callfacts::{call_keeps_header, header_place, header_writes};
use crate::middle::ctx::FnCtx;
use crate::middle::egraph::{egraph_rewrite, egraph_start};
use crate::middle::fold::is_const;
use crate::middle::gvn_calls::{call_numbering, inherit_into};
use crate::middle::ipo::{ATTR_READNONE, ATTR_READONLY, call_attrs, call_writes};
use crate::middle::ir::{
    Cond, Op, Term, get_irfuncs, ir_arg, ir_insert_before, ir_make, ir_operand, ir_operand_count,
    ir_replace, ir_resolve_operands, ir_set_operand, ir_unlink, ir_val,
};
use crate::middle::ir::Op::{
    Add, And, CallC, Cmp, Const, Conv, Copy, GAddr, Load, Mul, Or, Phi, SAddr, Slot, Store, Xor,
};
use crate::middle::ir::atomic::is_barrier;
use crate::middle::opt::{compute_dominators, resolve_all};
use crate::middle::sroa::constant_load;
use crate::middle::vecfacts::{ref_param_size, vec_apart};

pub fn build_dom_tree(cx: &mut FnCtx<Comp>, fi: i64) {
    compute_dominators(cx, fi);
    let n = cx.order.len() as i64;
    table_reset(&mut cx.dom_start, (n + 2) as usize, 0);
    table_reset(&mut cx.dom_child, (n + 1) as usize, 0);
    for i in 1..n {
        let b = (cx.order[i as usize]);
        (cx.dom_start[(cx.blocks[(cx.blocks[b as usize]).idom as usize]).order as usize]) += 1;
    }
    let mut total: i64 = 0;
    for k in 0..n + 1 {
        let count = (cx.dom_start[k as usize]);
        (cx.dom_start[k as usize]) = total;
        total += count;
    }
    let mut fill: Vec<i64, Comp> = Vec::new_in(Comp {});
    fill.resize((n + 1) as usize, 0);
    for i in 1..n {
        let b = (cx.order[i as usize]);
        let parent = (cx.blocks[(cx.blocks[b as usize]).idom as usize]).order;
        (cx.dom_child[
            ((cx.dom_start[parent as usize]) + (fill[parent as usize])) as usize]) = b;
        (fill[parent as usize]) += 1;
    }
}

// ---- The value table ----

fn is_gvn_op(op: Op) -> bool {
    op.is_remat() || op.is_pure() || op.is_vector() || op == Op::Sel
}

pub fn is_commutative_op(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    let op = (cx.insts[v as usize]).op;
    if op == Cmp {
        return (cx.insts[v as usize]).cond == Cond::Eq
            || (cx.insts[v as usize]).cond == Cond::Ne;
    }
    op == Add || op == Mul || op == And || op == Or || op == Xor
}

// The canonical order of commutative operands: constants on the right
// (where the targets have immediate forms), others by value id.
pub fn operands_out_of_order(cx: &mut FnCtx<Comp>, a: i64, b: i64) -> bool {
    let a_const = is_const(cx, a);
    let b_const = is_const(cx, b);
    if a_const != b_const {
        return a_const;
    }
    a > b
}

fn gvn_hash(cx: &mut FnCtx<Comp>, v: i64) -> u64 {
    let mut h: u64 = 1469598103934665603;
    h = (h ^ (cx.insts[v as usize]).op as u64).wrapping_mul(1099511628211u64);
    h = (h ^ (cx.insts[v as usize]).cond as u64).wrapping_mul(1099511628211u64);
    h = (h ^ (cx.insts[v as usize]).ty as u64).wrapping_mul(1099511628211u64);
    h = (h ^ (cx.insts[v as usize]).a as u64).wrapping_mul(1099511628211u64);
    h = (h ^ (cx.insts[v as usize]).b as u64).wrapping_mul(1099511628211u64);
    h = (h ^ (cx.insts[v as usize]).c as u64).wrapping_mul(1099511628211u64);
    h = (h ^ (cx.insts[v as usize]).imm as u64).wrapping_mul(1099511628211u64);
    h = (h ^ (cx.insts[v as usize]).imm2 as u64).wrapping_mul(1099511628211u64);
    if (cx.insts[v as usize]).op.is_call() {
        // (0.16) a call numbered by its callee and arguments
        for i in 0..(cx.insts[v as usize]).nargs {
            h = (h ^ ir_arg(cx, v, i) as u64).wrapping_mul(1099511628211u64);
        }
    }
    h ^ (h >> 29)
}

fn gvn_equal(cx: &mut FnCtx<Comp>, v: i64, w: i64) -> bool {
    if !((cx.insts[v as usize]).op == (cx.insts[w as usize]).op
        && (cx.insts[v as usize]).cond == (cx.insts[w as usize]).cond
        && (cx.insts[v as usize]).ty == (cx.insts[w as usize]).ty
        && (cx.insts[v as usize]).a == (cx.insts[w as usize]).a
        && (cx.insts[v as usize]).b == (cx.insts[w as usize]).b
        && (cx.insts[v as usize]).c == (cx.insts[w as usize]).c
        && (cx.insts[v as usize]).imm == (cx.insts[w as usize]).imm
        && (cx.insts[v as usize]).imm2 == (cx.insts[w as usize]).imm2) {
        return false;
    }
    if (cx.insts[v as usize]).op.is_call() {
        if (cx.insts[v as usize]).nargs != (cx.insts[w as usize]).nargs
            || (cx.insts[v as usize]).c != (cx.insts[w as usize]).c {
            return false;
        }
        for i in 0..(cx.insts[v as usize]).nargs {
            if ir_arg(cx, v, i) != ir_arg(cx, w, i) {
                return false;
            }
        }
    }
    true
}

// (0.17: the table is as large as this function needs, GVN_SIZE, in an
// allocation kept from call to call, GVN_CAP: clearing the largest
// function's table for every function was a few percent of -O2. The
// value found for an expression does not depend on the size: the table
// holds no two equal entries.)
fn gvn_reset(cx: &mut FnCtx<Comp>, capacity: i64) {
    let mut size: i64 = 1024;
    while size < capacity * 2 {
        size *= 2;
    }
    table_reset(&mut cx.gvn_table, size as usize, 0);
    cx.gvn_size = size;
    cx.gvn_count = 0;
    cx.gvn_log.clear();
}

// The equal value already in the table, or 0 after adding v.
pub fn gvn_find_or_add(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let mask = (cx.gvn_size - 1) as u64;
    let mut slot = gvn_hash(cx, v) & mask;
    while (cx.gvn_table[slot as usize]) != 0 {
        let w = (cx.gvn_table[slot as usize]);
        if gvn_equal(cx, v, w) {
            return w;
        }
        slot = (slot + 1) & mask;
    }
    (cx.gvn_table[slot as usize]) = v;
    cx.gvn_log.push(slot as i64);
    0
}

// Removes the entries added after `mark` (most recent first, which keeps
// the linear probing chains intact).
fn gvn_undo(cx: &mut FnCtx<Comp>, mark: i64) {
    while cx.gvn_log.len() as i64 > mark {
        let slot = cx.gvn_log.pop().unwrap();
        (cx.gvn_table[slot as usize]) = 0;
    }
}

// ---- Alias analysis ----
//
// An address is a base plus a constant offset (address_base); the base
// points into a memory object, its root (root_of): a frame slot, a static,
// or constant data (string literals and promoted constant arrays, never
// written), through additions of constant or variable offsets; or into
// unknown memory (root 0). Distinct objects never overlap; within one
// object, byte ranges are compared when both offsets are known. A slot
// whose address only serves loads, stores, copies and address arithmetic
// is private: no pointer from elsewhere, and no call, reaches it. Vole
// has no type-based aliasing rule: raw pointers may be cast freely.

// The base of address `v` and its constant offset: (x + c1) + c2 is x at
// c1 + c2.
pub fn address_base(cx: &mut FnCtx<Comp>, v: i64, offset: &mut i64) -> i64 {
    let mut base = v;
    while (cx.insts[base as usize]).op == Add
        && (cx.insts[base as usize]).ty == TY_U64
        && is_const(cx, (cx.insts[base as usize]).b) {
        *offset += (cx.insts[(cx.insts[base as usize]).b as usize]).imm;
        base = (cx.insts[base as usize]).a;
    }
    base
}

static mut MEMCPY_SYM: i64 = 0;

// Whether v is a copy too: a call of memcpy of a constant size (the
// lowering of copies over INLINE_COPY_MAX bytes).
fn is_memcpy(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    (cx.insts[v as usize]).op == CallC
        && (cx.insts[v as usize]).imm == memcpy_sym(pcx)
        && (cx.insts[v as usize]).nargs == 3
        && { let at_arg1 = ir_val(cx, ir_arg(cx, v, 2)); is_const(cx, at_arg1) }
}

// (0.27.0) The symbol memcpy, read: made before the tasks run (init_syms),
// found before (-1 while no symbol is the name).
fn memcpy_sym(pcx: &Ctx<Comp>) -> i64 {
    if get_memcpy_sym() != 0 { get_memcpy_sym() } else { find_sym(b"memcpy", pcx) }
}

// (0.18.1) The symbols is_memcpy compares with, made before the tasks run
// (middle::parallel: interning grows the program's table).
pub fn init_syms(pcx: &mut Ctx<Comp>) {
    if get_memcpy_sym() == 0 {
        set_memcpy_sym(intern_c(c"memcpy", pcx));
    }
    crate::middle::vecfacts::init_vec_facts(pcx);
}

// The destination, source and size of copy v (Op::Copy or memcpy).
pub fn copy_dst(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    if (cx.insts[v as usize]).op == Copy { (cx.insts[v as usize]).a }
    else { let ir_arg_v = ir_arg(cx, v, 0); ir_val(cx, ir_arg_v) }
}

pub fn copy_src(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    if (cx.insts[v as usize]).op == Copy { (cx.insts[v as usize]).b }
    else { let ir_arg_v = ir_arg(cx, v, 1); ir_val(cx, ir_arg_v) }
}

pub fn copy_size(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    if (cx.insts[v as usize]).op == Copy { (cx.insts[v as usize]).imm }
    else {
        let ir_arg_v = ir_arg(cx, v, 2); let ir_val_v = ir_val(cx, ir_arg_v);
        (cx.insts[ir_val_v as usize]).imm
    }
}

pub fn is_copy(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    (cx.insts[v as usize]).op == Copy || is_memcpy(cx, v, pcx)
}

fn is_object_op(op: Op) -> bool {
    op == Slot || op == GAddr || op == SAddr
}

// The memory object address `v` points into (see above), or 0.
pub fn root_of(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let mut x = v;
    for _ in 0..64 {
        let op = (cx.insts[x as usize]).op;
        if is_object_op(op) {
            return x;
        }
        if op != Add || (cx.insts[x as usize]).ty != TY_U64 {
            return 0;
        }
        if is_const(cx, (cx.insts[x as usize]).b) {
            x = (cx.insts[x as usize]).a;
            continue;
        }
        let ra = root_of(cx, (cx.insts[x as usize]).a);
        let rb = root_of(cx, (cx.insts[x as usize]).b);
        if ra != 0 && rb == 0 {
            return ra;
        }
        if rb != 0 && ra == 0 {
            return rb;
        }
        return 0;
    }
    0
}

// Marks the frame slots of function `fi` whose address escapes: used other
// than by loads, stores, copies and address arithmetic.
pub fn find_escaping_slots(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        for i in 0..(*get_irfuncs().add(fi as usize)).slots.len() as i64 {
            (cx.slots[((*get_irfuncs().add(fi as usize)).slots[i as usize]) as usize]).escapes = 0;
        }
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let op = (cx.insts[v as usize]).op;
                for k in 0..ir_operand_count(cx, v) {
                    let operand = ir_operand(cx, v, k);
                    if operand == 0 {
                        continue;
                    }
                    let allowed = ((op == Load || op == Store) && k == 0)
                        || (op == Copy && k <= 1)
                        || (op == Add && k <= 1 && (cx.insts[v as usize]).ty == TY_U64)
                        || ((k == 3 || k == 4) && is_memcpy(cx, v, pcx));
                    if !allowed {
                        mark_escape(cx, operand);
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
            if (cx.blocks[b as usize]).cond != 0 {
                mark_escape(cx, (cx.blocks[b as usize]).cond);
            }
        }
    }
}

fn mark_escape(cx: &mut FnCtx<Comp>, operand: i64) {
    let root = root_of(cx, operand);
    if root != 0 && (cx.insts[root as usize]).op == Slot {
        { let at_ix = (cx.insts[root as usize]).imm as usize;
            (cx.slots[at_ix]).escapes = 1 };
    }
}

// The memory object of a root: a frame slot, a static, constant data
// (negative, apart), or 0.
fn object_of(cx: &mut FnCtx<Comp>, root: i64) -> i64 {
    if root == 0 {
        return 0;
    }
    let op = (cx.insts[root as usize]).op;
    if op == Slot {
        return (cx.insts[root as usize]).imm;
    }
    if op == GAddr {
        return -1 - (cx.insts[root as usize]).imm;
    }
    // Constant data, by string id.
    -(1 << 40) - (cx.insts[root as usize]).imm
}

// (0.25) Whether `size` bytes at address `v` + `offset` lie inside one
// memory object on every path: a frame slot, or a static of this program,
// at a constant offset within its size. Such an access is safe to run
// where the program would not have (LICM's preheader, promotion's); an
// address with a variable part, `a[i]`'s, is valid only where its bounds
// check passed, so its access never moves above it.
pub fn in_object_bounds(cx: &mut FnCtx<Comp>, v: i64, offset: i64, size: i64, pcx: &Ctx<Comp>) -> bool {
    let mut off = offset;
    let base = address_base(cx, v, &mut off);
    let object = object_size(cx, base, pcx);
    size > 0 && off >= 0 && off <= object && size <= object - off
}

// (0.25) The size of the memory object `root` is (root_of): a frame slot's,
// or a static's of this program (not a C one's: its type is a
// declaration's); -1 when not known.
pub fn object_size(cx: &mut FnCtx<Comp>, root: i64, pcx: &Ctx<Comp>) -> i64 {
    let op = (cx.insts[root as usize]).op;
    if op == Slot {
        return (cx.slots[(cx.insts[root as usize]).imm as usize]).size;
    }
    if op == GAddr {
        let st = (pcx.sym_static[(cx.insts[root as usize]).imm as usize]) - 1;
        if st < 0 || pcx.statics[st as usize].linkage == 1 {
            return -1;
        }
        return type_size(pcx.statics[st as usize].ty, pcx);
    }
    // (0.25.4) A reference parameter's referent, live for the call.
    ref_param_size(cx, root, pcx)
}

fn is_constant_memory(cx: &mut FnCtx<Comp>, root: i64) -> bool {
    root != 0 && (cx.insts[root as usize]).op == SAddr
}

pub fn is_private_root(cx: &mut FnCtx<Comp>, root: i64) -> bool {
    root != 0 && (cx.insts[root as usize]).op == Slot
        && (cx.slots[(cx.insts[root as usize]).imm as usize]).escapes == 0
}

fn is_private_slot(cx: &mut FnCtx<Comp>, base: i64) -> bool {
    let root_of_v = root_of(cx, base);
    is_private_root(cx, root_of_v)
}

// Whether a call may write the memory at base: not when it is private or
// constant.
pub fn call_may_write(cx: &mut FnCtx<Comp>, base: i64, pcx: &Ctx<Comp>) -> bool {
    let root = root_of(cx, base);
    !is_private_root(cx, root) && !is_constant_memory(cx, root) && !param_frozen(cx, base, pcx)
}

// Parameter classes (param_class).
pub const PC_NONE: i64 = 0;
pub const PC_EXCLUSIVE: i64 = 1;
pub const PC_SHARED: i64 = 2;

// Whether function f's reference parameters' facts may be used: the own
// pass ran in error mode (the optimizer runs only when it found no
// error) and, for a rust-edition body, the borrow checker found it clean
// (borrowck.md D17.7: the own pass is quiet there; a body with errors
// or a deferred closure body gets no facts, so `f(&mut x, &mut x)` never
// reaches the optimizer with them).
// RULE: D17.7
pub fn noalias_active(f: i64, pcx: &Ctx<Comp>) -> bool {
    !pcx.noalias_off
        && (!rust_body(f, pcx) || crate::places::borrowck::borrowck_clean(f, pcx))
}

// Whether function f is a rust-edition body (regions.vl rust_fn, read
// without the position cache: its module is not std's).
fn rust_body(f: i64, pcx: &Ctx<Comp>) -> bool {
    !crate::front::modules::within_std(crate::places::front::fn_module(f, pcx), pcx)
}

// The function being optimized.
pub fn optimized_fn(cx: &mut FnCtx<Comp>) -> i64 {
    // UNSAFE: IRFUNCS is the middle end's raw table of functions.
    // SAFETY: cx.irf is the index of the function being optimized, set by
    // the pass driver before any pass reads cx.
    unsafe { (*get_irfuncs().add(cx.irf as usize)).f }
}

// The class of parameter k of the function being optimized.
pub fn param_class(cx: &mut FnCtx<Comp>, k: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { param_class_of((*get_irfuncs().add(cx.irf as usize)).f, k, pcx) }
}

// The class of parameter k of function f, by its type: PC_EXCLUSIVE
// (`&mut T`, `&mut [T]`), PC_SHARED (`&T`, `[T]` of a Freeze T) or PC_NONE.
fn param_class_of(f: i64, k: i64, pcx: &Ctx<Comp>) -> i64 {
    if f < 0 || k < 0 || k >= pcx.fns[f as usize].param_count || fn_uses_c(f, pcx) {
        return PC_NONE;
    }
    let t = fn_param(f, k, pcx);
    if t <= 0 {
        return PC_NONE;
    }
    let kind = pcx.types[t as usize].kind;
    // (0.26.1: a shared view of what is not Freeze, a cell, changes
    // through it and through its aliases: no fact; `&mut T` stays
    // exclusive, as in Rust)
    if kind == TyKind::Slice {
        return if pcx.types[t as usize].b == REF_MUT { PC_EXCLUSIVE }
            else if crate::front::cells::is_freeze(pcx.types[t as usize].a, pcx) { PC_SHARED }
            else { PC_NONE };
    }
    if kind != TyKind::Ptr {
        return PC_NONE;
    }
    if pcx.types[t as usize].b == REF_MUT {
        PC_EXCLUSIVE
    }
    else if pcx.types[t as usize].b == REF_SHARED
        && crate::front::cells::is_freeze(pcx.types[t as usize].a, pcx) {
        PC_SHARED
    } else {
        PC_NONE
    }
}

// Whether function f's reference parameters give the optimizer facts it
// can use: an exclusive one and another (the facts are about pairs, and a
// static). Its loop passes then run before it is inlined (inline.vl,
// inlined_everywhere), while the parameters are still there.
pub fn has_ref_facts(f: i64, pcx: &Ctx<Comp>) -> bool {
    if !noalias_active(f, pcx) {
        return false;
    }
    let mut refs: i64 = 0;
    let mut exclusive = false;
    for k in 0..pcx.fns[f as usize].param_count {
        let class = param_class_of(f, k, pcx);
        if class != PC_NONE {
            refs += 1;
        }
        if class == PC_EXCLUSIVE {
            exclusive = true;
        }
    }
    exclusive && refs >= 2
}

// The reference parameter (its index + 1) address v points into, through
// additions, or 0: a `&T`/`&mut T` parameter, or the pointer (the first
// piece) of a slice parameter.
pub fn param_root(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut x = v;
        for _ in 0..64 {
            let op = (cx.insts[x as usize]).op;
            if op == Op::Param {
                let k = (cx.insts[x as usize]).imm;
                if k < 0 || (cx.insts[x as usize]).ty != TY_U64 {
                    return 0;
                }
                let class = param_class(cx, k, pcx);
                if class == PC_NONE {
                    return 0;
                }
                let f = (*get_irfuncs().add(cx.irf as usize)).f;
                let slice = pcx.types[fn_param(f, k, pcx) as usize].kind == TyKind::Slice;
                if slice && (cx.insts[x as usize]).imm2 != 1
                    || !slice && (cx.insts[x as usize]).imm2 != 0 {
                    return 0;
                }
                return k + 1;
            }
            if op != Add || (cx.insts[x as usize]).ty != TY_U64 {
                return 0;
            }
            if is_const(cx, (cx.insts[x as usize]).b) {
                x = (cx.insts[x as usize]).a;
                continue;
            }
            let pa = param_root(cx, (cx.insts[x as usize]).a, pcx);
            let pb = param_root(cx, (cx.insts[x as usize]).b, pcx);
            if pa != 0 && pb == 0 {
                return pa;
            }
            if pb != 0 && pa == 0 {
                return pb;
            }
            return 0;
        }
        0
    }
}

// Whether parameter p (index + 1) has a fact here: exclusive, or shared and
// never written through by the function (a write through `[T]` is
// own.readonly's; until it is checked, such a parameter is left raw).
fn param_kept_apart(cx: &mut FnCtx<Comp>, p: i64, pcx: &Ctx<Comp>) -> bool {
    let class = param_class(cx, p - 1, pcx);
    class == PC_EXCLUSIVE || class == PC_SHARED && !param_written(cx, p, pcx)
}

// Whether bases b1 and b2 point into memory that 0.17's parameter rules
// keep apart: two different reference parameters, or one and a static.
pub fn params_disjoint(cx: &mut FnCtx<Comp>, b1: i64, b2: i64, pcx: &Ctx<Comp>) -> bool {
    if !noalias_active(optimized_fn(cx), pcx) {
        return false;
    }
    let p1 = param_root(cx, b1, pcx);
    let p2 = param_root(cx, b2, pcx);
    if p1 == 0 && p2 == 0 || p1 == p2 {
        return false;
    }
    if p1 != 0 && p2 != 0 {
        return param_kept_apart(cx, p1, pcx) && param_kept_apart(cx, p2, pcx);
    }
    let p = if p1 == 0 { p2 } else { p1 };
    let other = if p1 == 0 { root_of(cx, b1) } else { root_of(cx, b2) };
    other != 0 && (cx.insts[other as usize]).op == GAddr && param_kept_apart(cx, p, pcx)
}

// Whether the function being optimized may write through parameter p
// (index + 1): a store or copy into it, or the parameter passed to a call
// (or stored, compared... used other than as an address). A bit per
// parameter, recomputed when the function or its instructions change.
pub fn param_written(cx: &mut FnCtx<Comp>, p: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if cx.ro_fn != cx.irf || cx.ro_stamp != cx.insts.len() as i64 {
            cx.ro_fn = cx.irf;
            cx.ro_stamp = cx.insts.len() as i64;
            cx.ro_written = 0;
            for i in 0..(*get_irfuncs().add(cx.irf as usize)).blocks.len() as i64 {
                let b = ((*get_irfuncs().add(cx.irf as usize)).blocks[i as usize]);
                if (cx.blocks[b as usize]).removed != 0 {
                    continue;
                }
                let mut v = (cx.blocks[b as usize]).first;
                while v != 0 {
                    let op = (cx.insts[v as usize]).op;
                    for k in 0..ir_operand_count(cx, v) {
                        let operand = ir_operand(cx, v, k);
                        if operand == 0 {
                            continue;
                        }
                        let read = (op == Load && k == 0) || (op == Copy && k == 1)
                            || (op == Add && (cx.insts[v as usize]).ty == TY_U64) || op == Cmp;
                        if !read {
                            let q = param_root(cx, operand, pcx);
                            if q > 0 && q < 63 {
                                cx.ro_written = cx.ro_written | (1 << (q - 1));
                            }
                        }
                    }
                    v = (cx.insts[v as usize]).next;
                }
            }
        }
        p >= 63 || (cx.ro_written & (1 << (p - 1))) != 0
    }
}

// Whether no call of the function can write the memory at base: a
// reference parameter the function passes to no call and writes nowhere
// (an exclusive one is reached through nothing else; a shared one is
// frozen for the call).
fn param_frozen(cx: &mut FnCtx<Comp>, base: i64, pcx: &Ctx<Comp>) -> bool {
    if !noalias_active(optimized_fn(cx), pcx) {
        return false;
    }
    let p = param_root(cx, base, pcx);
    p != 0 && !param_written(cx, p, pcx)
}

// Whether [base1 + off1, + size1) and [base2 + off2, + size2) may overlap,
// for an access that writes one of them (constant memory is never
// written).
pub fn may_alias(cx: &mut FnCtx<Comp>, base1: i64, off1: i64, size1: i64, base2: i64, off2: i64,
    size2: i64, pcx: &Ctx<Comp>) -> bool {
    if base1 == base2 {
        return off1 < off2 + size2 && off2 < off1 + size1;
    }
    if params_disjoint(cx, base1, base2, pcx) {
        return false;
    }
    let r1 = root_of(cx, base1);
    let r2 = root_of(cx, base2);
    if is_constant_memory(cx, r1) || is_constant_memory(cx, r2) {
        return false;
    }
    if r1 != 0 && r2 != 0 {
        if object_of(cx, r1) != object_of(cx, r2) {
            return false;
        }
        if base1 == r1 && base2 == r2 {
            return off1 < off2 + size2 && off2 < off1 + size1;
        }
        return true;
    }
    // A private slot is only reached through itself.
    if is_private_root(cx, r1) || is_private_root(cx, r2) {
        return false;
    }
    // (0.25.4) A Vec's header and its own buffer; a let parameter's Vec
    // (middle::vecfacts).
    !vec_apart(cx, base1, off1, size1, base2, pcx)
        && !vec_apart(cx, base2, off2, size2, base1, pcx)
}

// ---- Memory values ----
//
// Known memory contents (AVAIL): (base, offset, size, type, value), 5 per
// entry; a load of a known location is its value. Copies whose
// destination still holds their source (COPIES): (destination base,
// offset, size, source address, copy), 5 per entry; a load from such a
// destination reads the source instead. Stores not yet read in this block
// (PENDING): (base, offset, size, store), 4 per entry; a store overwritten
// before it is read is dead. Writes kill what they may overlap; calls kill
// what is neither private nor constant.

const AVAIL_MAX: i64 = 256;
// The values of an AVAIL entry: the five, and (0.29) whether the location
// is a Vec header a call's summary can speak of (callfacts::header_place:
// 0 not asked yet, 1 it is, 2 it is not).
const AVAIL_W: i64 = 6;

// Removes entry i (of `width` values) from list l.
fn list_remove(l: &mut Vec<i64, Comp>, i: i64, width: i64) {
    for k in 0..width {
        (l[(i + k) as usize]) = (l[(l.len() as i64 - width + k) as usize]);
    }
    l.truncate((l.len() as i64 - width) as usize);
}

// A write of [base + offset, + size).
fn avail_kill(cx: &mut FnCtx<Comp>, base: i64, offset: i64, size: i64, pcx: &Ctx<Comp>) {
    let mut i: i64 = 0;
    while i < cx.avail.len() as i64 {
        let (b, o, s) = (cx.avail[i as usize], cx.avail[(i + 1) as usize],
            cx.avail[(i + 2) as usize]);
        if may_alias(cx, base, offset, size, b, o, s, pcx) {
            list_remove(&mut cx.avail, i, AVAIL_W);
        } else {
            i += AVAIL_W;
        }
    }
    i = 0;
    while i < cx.gvn_copies.len() as i64 {
        let (b, o, s) = (cx.gvn_copies[i as usize], cx.gvn_copies[(i + 1) as usize],
            cx.gvn_copies[(i + 2) as usize]);
        let mut src_offset: i64 = 0;
        let src = address_base(cx, cx.gvn_copies[(i + 3) as usize], &mut src_offset);
        if may_alias(cx, base, offset, size, b, o, s, pcx)
            || may_alias(cx, base, offset, size, src, src_offset, s, pcx) {
            list_remove(&mut cx.gvn_copies, i, 5);
        } else {
            i += 5;
        }
    }
}

// A call may write any memory but private slots and constants.
// (0.29) Unless call v's callee leaves a Vec's header there: `hw` is its
// summary (callfacts::header_writes; 0 when nothing is known of it, and for
// a barrier).
fn avail_kill_call(cx: &mut FnCtx<Comp>, v: i64, hw: i64, pcx: &Ctx<Comp>) {
    let mut i: i64 = 0;
    while i < cx.avail.len() as i64 {
        let base = cx.avail[i as usize];
        let mut kill = call_may_write(cx, base, pcx);
        if kill && hw != 0 {
            let off = cx.avail[(i + 1) as usize];
            let size = cx.avail[(i + 2) as usize];
            let mut place = cx.avail[(i + 5) as usize];
            if place == 0 {
                place = if header_place(cx, base, off, size, pcx) { 1 } else { 2 };
                cx.avail[(i + 5) as usize] = place;
            }
            kill = place != 1 || !call_keeps_header(cx, v, base, off, size, hw, pcx);
        }
        if kill {
            list_remove(&mut cx.avail, i, AVAIL_W);
        } else {
            i += AVAIL_W;
        }
    }
    i = 0;
    while i < cx.gvn_copies.len() as i64 {
        let mut src_offset: i64 = 0;
        let src = address_base(cx, (cx.gvn_copies[(i + 3) as usize]),
            &mut src_offset);
        if call_may_write(cx, (cx.gvn_copies[i as usize]), pcx)
            || call_may_write(cx, src, pcx) {
            list_remove(&mut cx.gvn_copies, i, 5);
        } else {
            i += 5;
        }
    }
}

fn avail_add(cx: &mut FnCtx<Comp>, base: i64, offset: i64, size: i64, ty: i64, value: i64) {
    if cx.avail.len() as i64 >= AVAIL_MAX * AVAIL_W {
        list_remove(&mut cx.avail, 0, AVAIL_W);
    }
    cx.avail.push(base);
    cx.avail.push(offset);
    cx.avail.push(size);
    cx.avail.push(ty);
    cx.avail.push(value);
    cx.avail.push(0);
}

fn avail_find(cx: &mut FnCtx<Comp>, base: i64, offset: i64, ty: i64) -> i64 {
    let mut i: i64 = 0;
    while i < cx.avail.len() as i64 {
        if cx.avail[i as usize] == base && cx.avail[(i + 1) as usize] == offset
            && cx.avail[(i + 3) as usize] == ty {
            return cx.avail[(i + 4) as usize];
        }
        i += AVAIL_W;
    }
    0
}

// A read of [base + offset, + size): the stores it may read are no longer
// dead when overwritten.
fn pending_read(cx: &mut FnCtx<Comp>, base: i64, offset: i64, size: i64, pcx: &Ctx<Comp>) {
    let mut i: i64 = 0;
    while i < cx.pending.len() as i64 {
        let (b, o, s) = (cx.pending[i as usize], cx.pending[(i + 1) as usize],
            cx.pending[(i + 2) as usize]);
        if may_alias(cx, base, offset, size, b, o, s, pcx) {
            list_remove(&mut cx.pending, i, 4);
        } else {
            i += 4;
        }
    }
}

// A write of [base + offset, + size): the pending stores it covers are
// dead.
fn pending_overwrite(cx: &mut FnCtx<Comp>, base: i64, offset: i64, size: i64) -> bool {
    let mut changed = false;
    let mut i: i64 = 0;
    while i < cx.pending.len() as i64 {
        let (b, o, s) = (cx.pending[i as usize], cx.pending[(i + 1) as usize],
            cx.pending[(i + 2) as usize]);
        if b == base && o >= offset && o + s <= offset + size {
            ir_unlink(cx, cx.pending[(i + 3) as usize]);
            list_remove(&mut cx.pending, i, 4);
            changed = true;
        } else {
            i += 4;
        }
    }
    changed
}

// Memory effects of instruction v; returns whether anything changed.
fn memory_step(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    let op = (cx.insts[v as usize]).op;
    if op == Load {
        let ty = (cx.insts[v as usize]).ty;
        let size = type_size(ty, pcx);
        let mut offset = (cx.insts[v as usize]).imm;
        let mut base = address_base(cx, (cx.insts[v as usize]).a, &mut offset);
        let mut changed = false;
        // From the source of a copy that still holds.
        let mut i: i64 = 0;
        while i < cx.gvn_copies.len() as i64 {
            let (b, o, s) = (cx.gvn_copies[i as usize], cx.gvn_copies[(i + 1) as usize],
                cx.gvn_copies[(i + 2) as usize]);
            if b == base && offset >= o && offset + size <= o + s {
                (cx.insts[v as usize]).a = cx.gvn_copies[(i + 3) as usize];
                (cx.insts[v as usize]).imm = offset - o;
                offset = (cx.insts[v as usize]).imm;
                base = address_base(cx, (cx.insts[v as usize]).a, &mut offset);
                changed = true;
                break;
            }
            i += 5;
        }
        let known = avail_find(cx, base, offset, ty);
        if known != 0 {
            ir_replace(cx, v, known);
            return true;
        }
        // From constant data at a known offset: a constant.
        if (cx.insts[base as usize]).op == SAddr {
            let mut ok = false;
            let value = constant_load((cx.insts[base as usize]).imm, offset, ty, &mut ok,
                pcx);
            if ok {
                let c = ir_make(cx, Const, ty, 0, 0, value, pcx);
                ir_insert_before(cx, v, c);
                ir_replace(cx, v, c);
                return true;
            }
        }
        pending_read(cx, base, offset, size, pcx);
        avail_add(cx, base, offset, size, ty, v);
        return changed;
    }
    if op == Store {
        let ty = (cx.insts[v as usize]).imm2;
        let size = type_size(ty, pcx);
        let mut offset = (cx.insts[v as usize]).imm;
        let base = address_base(cx, (cx.insts[v as usize]).a, &mut offset);
        // Storing what the location holds already: nothing to do.
        if avail_find(cx, base, offset, ty) == (cx.insts[v as usize]).b
            && (cx.insts[v as usize]).b != 0 {
            ir_unlink(cx, v);
            return true;
        }
        let changed = pending_overwrite(cx, base, offset, size);
        avail_kill(cx, base, offset, size, pcx);
        avail_add(cx, base, offset, size, ty, (cx.insts[v as usize]).b);
        cx.pending.push(base);
        cx.pending.push(offset);
        cx.pending.push(size);
        cx.pending.push(v);
        return changed;
    }
    if is_copy(cx, v, pcx) {
        let size = copy_size(cx, v);
        let mut src_offset: i64 = 0;
        let copy_src_v = copy_src(cx, v);
        let src = address_base(cx, copy_src_v, &mut src_offset);
        let mut offset: i64 = 0;
        let copy_dst_v = copy_dst(cx, v);
        let base = address_base(cx, copy_dst_v, &mut offset);
        pending_read(cx, src, src_offset, size, pcx);
        let changed = pending_overwrite(cx, base, offset, size);
        avail_kill(cx, base, offset, size, pcx);
        if !may_alias(cx, base, offset, size, src, src_offset, size, pcx) {
            cx.gvn_copies.push(base);
            cx.gvn_copies.push(offset);
            cx.gvn_copies.push(size);
            let copy_src_v1 = copy_src(cx, v);
            cx.gvn_copies.push(copy_src_v1);
            cx.gvn_copies.push(v);
        }
        return changed;
    }
    if op.is_call() {
        // It may read anything but private slots (unless its attributes
        // say it reads nothing), and write it (unless they say it writes
        // nothing; see ipo.vl).
        let attrs = call_attrs(cx, v, pcx);
        if attrs & ATTR_READNONE == 0 {
            let mut i: i64 = 0;
            while i < cx.pending.len() as i64 {
                if !is_private_slot(cx, (cx.pending[i as usize])) {
                    list_remove(&mut cx.pending, i, 4);
                } else {
                    i += 4;
                }
            }
        }
        if attrs & ATTR_READONLY == 0 {
            avail_kill_call(cx, v, header_writes(attrs), pcx);
        }
    }
    if is_barrier(cx, v) {
        // (0.21) An atomic or a fence reads and writes all shared memory
        // (docs/design/concurrency.md §4.2, O1): no store before it is
        // dead, no value is forwarded across it.
        let mut i: i64 = 0;
        while i < cx.pending.len() as i64 {
            if !is_private_slot(cx, (cx.pending[i as usize])) {
                list_remove(&mut cx.pending, i, 4);
            } else {
                i += 4;
            }
        }
        avail_kill_call(cx, 0, 0, pcx);
    }
    false
}

// The writes of block b, applied to AVAIL (for a block between a block and
// one it dominates).
pub fn apply_block_kills(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) {
    let mut v = (cx.blocks[b as usize]).first;
    while v != 0 {
        let op = (cx.insts[v as usize]).op;
        if op == Store {
            let mut offset = (cx.insts[v as usize]).imm;
            let ir_val_v = ir_val(cx, (cx.insts[v as usize]).a);
            let base = address_base(cx, ir_val_v, &mut offset);
            avail_kill(cx, base, offset, type_size((cx.insts[v as usize]).imm2, pcx), pcx);
        } else if is_copy(cx, v, pcx) {
            let mut offset: i64 = 0;
            let copy_dst_v = copy_dst(cx, v);
            let ir_val_v1 = ir_val(cx, copy_dst_v);
            let base = address_base(cx, ir_val_v1, &mut offset);
            let copy_size_v = copy_size(cx, v);
            avail_kill(cx, base, offset, copy_size_v, pcx);
        } else if op.is_call() {
            let attrs = call_attrs(cx, v, pcx);
            if attrs & ATTR_READONLY == 0 {
                avail_kill_call(cx, v, header_writes(attrs), pcx);
            }
        } else if is_barrier(cx, v) {
            avail_kill_call(cx, 0, 0, pcx);
        }
        v = (cx.insts[v as usize]).next;
    }
}

// ---- Dead stores to private slots ----

// Removes the stores and copies into private slots that nothing reads.
fn remove_unread_slot_writes(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let n = cx.slots.len() as i64 + 1;
        let read = alloc_array::<i64>(n);
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let op = (cx.insts[v as usize]).op;
                let mut from: i64 = 0;
                if op == Load {
                    from = root_of(cx, (cx.insts[v as usize]).a);
                } else if is_copy(cx, v, pcx) {
                    let copy_src_v = copy_src(cx, v);
                    from = root_of(cx, copy_src_v);
                }
                if from != 0 && (cx.insts[from as usize]).op == Slot {
                    (*read.add((cx.insts[from as usize]).imm as usize)) = 1;
                }
                v = (cx.insts[v as usize]).next;
            }
        }
        let mut changed = false;
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.len() as i64 {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let next = (cx.insts[v as usize]).next;
                let op = (cx.insts[v as usize]).op;
                if op == Store || is_copy(cx, v, pcx) {
                    let arg_v = if op == Store { (cx.insts[v as usize]).a }
                        else { copy_dst(cx, v) };
                    let to = root_of(cx,
                        arg_v);
                    if is_private_root(cx, to)
                        && (*read.add((cx.insts[to as usize]).imm as usize)) == 0 {
                        ir_unlink(cx, v);
                        changed = true;
                    }
                }
                v = next;
            }
        }
        free(read as *mut u8);
        changed
    }
}

// ---- The walk ----

pub fn run_gvn(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        resolve_all(cx, fi);
        egraph_start(cx);
        build_dom_tree(cx, fi);
        find_escaping_slots(cx, fi, pcx);
        let mut count: i64 = 0;
        for i in 0..cx.order.len() as i64 {
            { let at_ix = (cx.order[i as usize]) as usize;
                (cx.blocks[at_ix]).mark = 0 };
            let mut v = (cx.blocks[(cx.order[i as usize]) as usize]).first;
            while v != 0 {
                count += 1;
                v = (cx.insts[v as usize]).next;
            }
        }
        gvn_reset(cx, count);
        let mut changed = false;
        // What each block on the stack knows at its end: (start, count) in
        // `saved`.
        let mut saved = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        // Explicit stack of (layout index, child position, log mark, saved
        // start, saved count).
        let mut stack = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        cx.avail.clear();
        cx.eq_map.clear();
        // (EQ_MAP's length when each block of the stack but the entry was
        // entered.)
        let mut eq_marks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        gvn_block(cx, (cx.order[0]), &mut changed, pcx);
        stack.push(0);
        stack.push(0);
        stack.push(0);
        stack.push(saved.len() as i64);
        for i in 0..cx.avail.len() as i64 {
            saved.push((cx.avail[i as usize]));
        }
        stack.push(cx.avail.len() as i64);
        while stack.len() as i64 > 0 {
            let top = stack.len() as i64 - 5;
            let k = (stack[top as usize]);
            let next = (stack[(top + 1) as usize]);
            if (cx.dom_start[k as usize]) + next < (cx.dom_start[(k + 1) as usize]) {
                (stack[(top + 1) as usize]) = next + 1;
                let child = (cx.dom_child[((cx.dom_start[k as usize]) + next) as usize]);
                let mark = cx.gvn_log.len() as i64;
                cx.avail.clear();
                let start = (stack[(top + 3) as usize]);
                let n = (stack[(top + 4) as usize]);
                for i in 0..n {
                    cx.avail.push((saved[(start + i) as usize]));
                }
                if !inherit_into(cx, (cx.order[k as usize]), child, pcx) {
                    cx.avail.clear();
                }
                eq_marks.push(cx.eq_map.len() as i64);
                learn_equality(cx, child, pcx);
                gvn_block(cx, child, &mut changed, pcx);
                stack.push((cx.blocks[child as usize]).order);
                stack.push(0);
                stack.push(mark);
                stack.push(saved.len() as i64);
                for i in 0..cx.avail.len() as i64 {
                    saved.push((cx.avail[i as usize]));
                }
                stack.push(cx.avail.len() as i64);
            } else {
                gvn_undo(cx, (stack[(top + 2) as usize]));
                saved.truncate((stack[(top + 3) as usize]));
                stack.truncate(stack.len() as i64 - 5);
                if eq_marks.len() as i64 > 0 {
                    cx.eq_map.truncate(eq_marks.pop() as usize);
                }
            }
        }
        free(eq_marks.data as *mut u8);
        free(stack.data as *mut u8);
        free(saved.data as *mut u8);
        if remove_unread_slot_writes(cx, fi, pcx) {
            changed = true;
        }
        if changed {
            resolve_all(cx, fi);
        }
        changed
    }
}

// ---- Equalities (0.11) ----
//
// Below the edge where `x == y` holds (the true way of a branch on
// x == y, the false way of x != y, into a block with no other
// predecessor), y is x: uses of y in the blocks that edge dominates (but
// phis) take x instead, a constant when one side is one, else the older
// value. Through conversions of one width: conv(a) == conv(b) is a == b.
// Integers only (float equality holds between 0.0 and -0.0). This is how
// `if a.len != b.len { return false; }` lets the range analysis see that
// an index below a.len is below b.len.

const EQ_MAX: i64 = 32;

fn learn_equality(cx: &mut FnCtx<Comp>, c: i64, pcx: &Ctx<Comp>) {
    if (cx.blocks[c as usize]).preds.len() as i64 != 1
        || cx.eq_map.len() as i64 >= 2 * EQ_MAX {
        return;
    }
    let p = ((cx.blocks[c as usize]).preds[0]);
    if (cx.blocks[p as usize]).term != Term::Branch
        || (cx.blocks[p as usize]).s0 == (cx.blocks[p as usize]).s1
        || (cx.blocks[p as usize]).cond == 0 {
        return;
    }
    let cmp = ir_val(cx, (cx.blocks[p as usize]).cond);
    if (cx.insts[cmp as usize]).op != Cmp
        || !is_integer((cx.insts[cmp as usize]).imm2) {
        return;
    }
    let eq = (cx.insts[cmp as usize]).cond == Cond::Eq
        && (cx.blocks[p as usize]).s0 == c;
    let ne = (cx.insts[cmp as usize]).cond == Cond::Ne
        && (cx.blocks[p as usize]).s1 == c;
    if !eq && !ne {
        return;
    }
    let a = ir_val(cx, (cx.insts[cmp as usize]).a);
    let b = ir_val(cx, (cx.insts[cmp as usize]).b);
    add_equality(cx, a, b);
    if (cx.insts[a as usize]).op == Conv && (cx.insts[b as usize]).op == Conv
        && is_integer((cx.insts[a as usize]).ty)
        && (cx.insts[a as usize]).ty == (cx.insts[b as usize]).ty
        && (cx.insts[a as usize]).imm2 == (cx.insts[b as usize]).imm2
        && is_integer((cx.insts[a as usize]).imm2)
        && type_size((cx.insts[a as usize]).imm2, pcx)
        == type_size((cx.insts[a as usize]).ty, pcx) {
        let ir_val_v = ir_val(cx, (cx.insts[a as usize]).a);
        let ir_val_v1 = ir_val(cx, (cx.insts[b as usize]).a);
        add_equality(cx, ir_val_v, ir_val_v1);
    }
}

fn add_equality(cx: &mut FnCtx<Comp>, a: i64, b: i64) {
    if a == b || (cx.insts[a as usize]).ty != (cx.insts[b as usize]).ty
        || (is_const(cx, a) && is_const(cx, b)) {
        return;
    }
    // y goes, x stays: a constant, or the older value.
    let mut x = a;
    let mut y = b;
    if is_const(cx, y) || (!is_const(cx, x) && x > y) {
        x = b;
        y = a;
    }
    cx.eq_map.push(y);
    cx.eq_map.push(x);
}

fn equal_value(cx: &mut FnCtx<Comp>, w: i64) -> i64 {
    let mut k = cx.eq_map.len() as i64;
    while k > 0 {
        k -= 2;
        if (cx.eq_map[k as usize]) == w {
            return (cx.eq_map[(k + 1) as usize]);
        }
    }
    w
}

// Whether instruction v (a store, a copy or a call) may write memory a
// READONLY call reads: anything but the caller's private slots.
fn writes_for_calls(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    let op = (cx.insts[v as usize]).op;
    if op == Store {
        let mut offset: i64 = 0;
        let address_base_v = address_base(cx, (cx.insts[v as usize]).a, &mut offset);
        let is_private_slot_v = is_private_slot(cx, address_base_v);
        return !is_private_slot_v;
    }
    if is_copy(cx, v, pcx) {
        let mut offset: i64 = 0;
        let copy_dst_v = copy_dst(cx, v);
        let address_base_v1 = address_base(cx, copy_dst_v, &mut offset);
        let is_private_slot_v1 = is_private_slot(cx,
            address_base_v1);
        return !is_private_slot_v1;
    }
    op.is_call() && call_writes(cx, v, pcx) || is_barrier(cx, v)
}

fn gvn_block(cx: &mut FnCtx<Comp>, b: i64, changed: &mut bool, pcx: &Ctx<Comp>) {
    cx.gvn_copies.clear();
    cx.pending.clear();
    cx.ro_calls.clear();
    let mut v = (cx.blocks[b as usize]).first;
    while v != 0 {
        let next = (cx.insts[v as usize]).next;
        ir_resolve_operands(cx, v);
        if cx.eq_map.len() as i64 > 0 && (cx.insts[v as usize]).op != Phi {
            for k in 0..ir_operand_count(cx, v) {
                let w = ir_operand(cx, v, k);
                if w != 0 {
                    let x = equal_value(cx, w);
                    if x != w {
                        ir_set_operand(cx, v, k, x);
                        *changed = true;
                    }
                }
            }
        }
        let op = (cx.insts[v as usize]).op;
        if is_gvn_op(op) {
            if is_commutative_op(cx, v)
                && operands_out_of_order(cx, (cx.insts[v as usize]).a,
                    (cx.insts[v as usize]).b) {
                let a = (cx.insts[v as usize]).a;
                (cx.insts[v as usize]).a = (cx.insts[v as usize]).b;
                (cx.insts[v as usize]).b = a;
            }
            let w = gvn_find_or_add(cx, v);
            if w != 0 {
                ir_replace(cx, v, w);
                *changed = true;
            } else if pcx.egraph {
                // (0.9: the rewrite rules, see egraph.vl)
                let best = egraph_rewrite(cx, v, pcx);
                if best != v {
                    ir_replace(cx, v, best);
                    *changed = true;
                }
            }
        } else {
            let numbering: i64 = if op.is_call() { call_numbering(cx, v, pcx) } else { 0 };
            let mut w: i64 = 0;
            if numbering == 1 {
                w = gvn_find_or_add(cx, v);
            } else if numbering == 2 {
                for i in 0..cx.ro_calls.len() as i64 {
                    if gvn_equal(cx, v, (cx.ro_calls[i as usize])) {
                        w = (cx.ro_calls[i as usize]);
                    }
                }
            }
            if w != 0 {
                ir_replace(cx, v, w);
                *changed = true;
            } else {
                if cx.ro_calls.len() as i64 > 0 && writes_for_calls(cx, v, pcx) {
                    cx.ro_calls.clear();
                }
                if numbering == 2 {
                    cx.ro_calls.push(v);
                }
                if memory_step(cx, v, pcx) {
                    *changed = true;
                }
            }
        }
        v = next;
    }
    if (cx.blocks[b as usize]).cond != 0 {
        let ir_val_v = ir_val(cx, (cx.blocks[b as usize]).cond);
        (cx.blocks[b as usize]).cond = equal_value(cx, ir_val_v);
    }
}

// (0.28.0) MEMCPY_SYM's accessors: every use of it is one of them.
fn get_memcpy_sym() -> i64 {
    // UNSAFE: the memcpy symbol GVN compares with, a process-wide static
    // mut the tasks read; Rust has no safe access to a static mut
    // SAFETY: written only by gvn::init_syms (only while 0), whose only
    // caller is prepare_tasks on the main thread before pool_start's
    // pthread_create; tasks only read it (memcpy_sym)
    unsafe { MEMCPY_SYM }
}

fn set_memcpy_sym(v: i64) {
    // UNSAFE: the memcpy symbol GVN compares with, a process-wide static
    // mut the tasks read; Rust has no safe access to a static mut
    // SAFETY: written only by gvn::init_syms (only while 0), whose only
    // caller is prepare_tasks on the main thread before pool_start's
    // pthread_create; tasks only read it (memcpy_sym)
    unsafe {
        MEMCPY_SYM = v;
    }
}
