// Failure traces (0.17, `--trace`): the calls that led to a failed check.
//
// Built at -O1 and -O2, on the IR just after lowering (as profile.vl's
// counters): each function of the program (not std's, not the runtimes')
// keeps a frame on a shadow stack, the runtime's FRAMES (4096 entries, a
// ring: deeper calls write over the outermost) at index DEPTH:
//
//     entry:       d = DEPTH; DEPTH = d + 1; FRAMES[d & 4095] = "FILE:LINE  NAME"
//     each call:   FRAMES[d & 4095] = "FILE:LINE  NAME" of the call's statement
//     each return: DEPTH = d
//
// so a frame names the statement its function is running (the last call
// made, or the entry): a failed check is a call (rt.panic), and std's
// failures (unwrap, panic) are calls of std functions. The cost: a store
// per call (consecutive calls of one statement in a block: one), a few
// instructions per entry and return. Without --trace nothing changes.
//
// On a failure, the runtime's `dump` prints the frames, innermost first,
// after the message: rt.panic calls it (gen0's runtime), std::panic's call
// of `panic_note` (the note "build with --trace") becomes a call of it.
// `start`, called first in main, also makes SIGINT, SIGALRM (a time limit:
// `volec test`'s), SIGTERM and SIGSEGV print the frames before the
// program stops.

use crate::back::dwarf::file_and_line;
use crate::base::{buf_byte, buf_bytes, buf_new, buf_slice, buf_str, intern_c, out_path, sym_name};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::add_string;
use crate::front::modules::file_made;
use crate::front::types::{TY_I64, TY_U64};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Op, Term, fn_block, fn_block_count, fn_entry, ir_append, ir_enter, ir_insert_before, ir_make,
};

// The runtime, the module __trace.
pub fn trace_runtime_source(out: i64) {
    buf_str(out, c"extern \"C\" {\n");
    buf_str(out, c"    fn write(fd: i32, data: *const u8, count: u64) -> i64;\n");
    buf_str(out, c"    fn strlen(s: *const u8) -> u64;\n");
    buf_str(out, c"    fn signal(sig: i32, handler: extern \"C\" fn(i32)) -> u64;\n");
    buf_str(out, c"    #[link_name = \"signal\"]\n");
    buf_str(out, c"    fn signal_default(sig: i32, handler: u64) -> u64;\n");
    buf_str(out, c"    fn raise(sig: i32) -> i32;\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub static mut DEPTH: i64 = 0;\n");
    buf_str(out, c"pub static mut FRAMES: [*const u8; 4096] = [0 as *const u8; 4096];\n");
    buf_str(out, c"fn put(s: *const u8) {\n");
    buf_str(out, c"    unsafe {\n");
    buf_str(out, c"        write(2, s, strlen(s));\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"fn put_int(n: i64) {\n");
    buf_str(out, c"    let mut digits: [u8; 24] = [0; 24];\n");
    buf_str(out, c"    let mut i: usize = 22;\n");
    buf_str(out, c"    let mut v = if n < 0 { 0 - n } else { n };\n");
    buf_str(out, c"    loop {\n");
    buf_str(out, c"        digits[i] = b'0' + (v % 10) as u8;\n");
    buf_str(out, c"        v = v / 10;\n");
    buf_str(out, c"        if v == 0 {\n");
    buf_str(out, c"            break;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        i -= 1;\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"    put(&digits[i] as *const u8);\n");
    buf_str(out, c"}\n");
    buf_str(out, c"fn frame(i: i64) {\n");
    buf_str(out, c"    unsafe {\n");
    buf_str(out, c"        put(c\"  \");\n");
    buf_str(out, c"        put(FRAMES[(i & 4095) as usize]);\n");
    buf_str(out, c"        put(c\"\\n\");\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"// (extern \"C\": always emitted, for rt.panic to call)\n");
    buf_str(out, c"pub extern \"C\" fn __vole_trace_dump() {\n");
    buf_str(out, c"    unsafe {\n");
    buf_str(out, c"        let d = DEPTH;\n");
    buf_str(out, c"        if d <= 0 {\n");
    buf_str(out, c"            return;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        put(c\"trace, innermost call first:\\n\");\n");
    buf_str(out, c"        let low = if d > 4096 { d - 4096 } else { 0 };\n");
    buf_str(out, c"        let mut i = d - 1;\n");
    buf_str(out, c"        while i >= low {\n");
    buf_str(out, c"            if d - 1 - i == 20 && i - low > 8 {\n");
    buf_str(out, c"                put(c\"  ... \");\n");
    buf_str(out, c"                put_int(i - low - 3);\n");
    buf_str(out, c"                put(c\" more\\n\");\n");
    buf_str(out, c"                i = low + 3;\n");
    buf_str(out, c"            }\n");
    buf_str(out, c"            frame(i);\n");
    buf_str(out, c"            i -= 1;\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        if low > 0 {\n");
    buf_str(out, c"            put(c\"  ... \");\n");
    buf_str(out, c"            put_int(low);\n");
    buf_str(out, c"            put(c\" outer calls not kept\\n\");\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"extern \"C\" fn stopped(sig: i32) {\n");
    buf_str(out, c"    unsafe {\n");
    buf_str(out, c"        put(c\"stopped by signal \");\n");
    buf_str(out, c"        put_int(sig as i64);\n");
    buf_str(out, c"        if sig == 14 {\n");
    buf_str(out, c"            put(c\" (SIGALRM: a time limit)\");\n");
    buf_str(out, c"        } else if sig == 2 {\n");
    buf_str(out, c"            put(c\" (SIGINT)\");\n");
    buf_str(out, c"        } else if sig == 15 {\n");
    buf_str(out, c"            put(c\" (SIGTERM)\");\n");
    buf_str(out, c"        } else if sig == 11 {\n");
    buf_str(out, c"            put(c\" (SIGSEGV: an invalid memory access)\");\n");
    buf_str(out, c"        }\n");
    buf_str(out, c"        put(c\"\\n\");\n");
    buf_str(out, c"        __vole_trace_dump();\n");
    buf_str(out, c"        signal_default(sig, 0);\n");
    buf_str(out, c"        raise(sig);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
    buf_str(out, c"pub fn start() {\n");
    buf_str(out, c"    unsafe {\n");
    buf_str(out, c"        signal(2, stopped);\n");
    buf_str(out, c"        signal(14, stopped);\n");
    buf_str(out, c"        signal(15, stopped);\n");
    buf_str(out, c"        signal(11, stopped);\n");
    buf_str(out, c"    }\n");
    buf_str(out, c"}\n");
}

// Whether IR function fi keeps a frame: a function of the program's own
// files (not of a synthesized source: std, the runtimes, C imports).
fn traced(fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let start = pcx.nodes[pcx.ir_item[fi as usize] as usize].start;
        let file = file_and_line(start, pcx) >> 32;
        !file_made(file, pcx)
    }
}

// The site string "FILE:LINE  NAME" of position pos (0: the function's
// own position) in function fi.
fn site(fi: i64, pos: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let at = if pos > 0 { pos }
            else { pcx.nodes[pcx.ir_item[fi as usize] as usize].start };
        let fl = file_and_line(at, pcx);
        let b = buf_new();
        buf_str(b, out_path(fl >> 32, pcx));
        buf_byte(b, b':');
        crate::base::buf_int(b, fl & 4294967295);
        buf_bytes(b, b"  ");
        let name = sym_name(pcx.fns[pcx.ir_fn[fi as usize] as usize].name, pcx);
        let mut len: i64 = 0;
        while (*name.add(len as usize)) != 0 {
            len += 1;
        }
        let s = std::slice::from_raw_parts(name.add((0) as usize), (len - (0)) as usize);
        let mut i: i64 = 0;
        while i < len {
            let past: i64 = if s[i as usize] == b'.' && i + 1 < len && s[(i + 1) as usize] == b'G' {
                instance_args(s, i + 2, b)
            } else {
                0
            };
            if past > 0 {
                i = past;
            } else if s[i as usize] == b'.' {
                buf_bytes(b, b"::");
                i += 1;
            } else {
                buf_byte(b, s[i as usize]);
                i += 1;
            }
        }
        add_string(buf_slice(b))
    }
}

// (0.26.3) An instance's arguments, generic_symbol's codes at s[at..] up
// to a `.` or the end, written `<Gpa>` to out (`Ring.GN7std.Gpa.push` is
// `Ring<Gpa>::push`); the position after them, or 0 (nothing written)
// for a code it does not read.
fn instance_args(s: &[u8], at: i64, out: i64) -> i64 {
    let t = buf_new();
    let mut k = at;
    let mut n: i64 = 0;
    while k < s.len() as i64 && s[k as usize] != b'.' {
        buf_bytes(t, if n == 0 { b"<" } else { b", " });
        k = type_code(s, k, t);
        if k == 0 {
            return 0;
        }
        n += 1;
    }
    if n == 0 {
        return 0;
    }
    buf_byte(t, b'>');
    buf_bytes(out, buf_slice(t));
    k
}

// One type of mangle_type's code at s[k..] (primitives, pointers,
// slices, named types by their last part), written to out; the position
// after it, or 0.
fn type_code(s: &[u8], k: i64, out: i64) -> i64 {
    if k >= s.len() as i64 {
        return 0;
    }
    let c = s[k as usize];
    if c == b'P' {
        buf_byte(out, b'*');
        return type_code(s, k + 1, out);
    }
    if c == b'S' {
        buf_byte(out, b'[');
        let e = type_code(s, k + 1, out);
        buf_byte(out, b']');
        return e;
    }
    if c == b'N' {
        let mut n: i64 = 0;
        let mut e = k + 1;
        while e < s.len() as i64 && s[e as usize] >= b'0' && s[e as usize] <= b'9' {
            n = n * 10 + (s[e as usize] - b'0') as i64;
            e += 1;
        }
        if e == k + 1 || e + n > s.len() as i64 {
            return 0;
        }
        let mut from = e;
        for j in e..e + n {
            if s[j as usize] == b'.' {
                from = j + 1;
            }
        }
        buf_bytes(out, &s[from as usize..(e + n) as usize]);
        return e + n;
    }
    let codes = "asilhtjmfdb";
    let types = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool"];
    for j in 0..codes.len() {
        if codes[j] == c {
            buf_bytes(out, types[j].as_bytes());
            return k + 1;
        }
    }
    0
}

// The site string of position pos in function fi, one per line: `lines`
// holds the lines made (file_and_line), `sids` their strings.
fn site_of(fi: i64, pos: i64, lines: &mut Vec<i64, Comp>, sids: &mut Vec<i64, Comp>,
    pcx: &Ctx<Comp>) -> i64 {
    let line = file_and_line(pos, pcx);
    for j in 0..lines.len() as i64 {
        if (lines[j as usize]) == line {
            return (sids[j as usize]);
        }
    }
    let sid = site(fi, pos, pcx);
    lines.push(line);
    sids.push(sid);
    sid
}

// The first instruction of block b after its phis and parameters (0: none).
fn body_start(cx: &mut FnCtx<Comp>, b: i64) -> i64 {
    let mut v = (cx.blocks[b as usize]).first;
    while v != 0
        && ((cx.insts[v as usize]).op == Op::Phi
            || (cx.insts[v as usize]).op == Op::Param) {
        v = (cx.insts[v as usize]).next;
    }
    v
}

// Puts the instructions of `list` before instruction `at` (0: at the end
// of block b).
fn put_before(cx: &mut FnCtx<Comp>, b: i64, at: i64, list: &[i64]) {
    for i in 0..list.len() as i64 {
        if at == 0 {
            ir_append(cx, b, (list[i as usize]));
        } else {
            ir_insert_before(cx, at, (list[i as usize]));
        }
    }
}

// FRAMES[slot] = the string `sid`, before `at` in block b.
fn store_site(cx: &mut FnCtx<Comp>, b: i64, at: i64, slot: i64, sid: i64, pcx: &Ctx<Comp>) {
    let s = ir_make(cx, Op::SAddr, TY_U64, 0, 0, sid, pcx);
    let st = ir_make(cx, Op::Store, 0, slot, s, 0, pcx);
    (cx.insts[st as usize]).imm2 = TY_U64;
    let mut list: Vec<i64, Comp> = Vec::new_in(Comp {});
    list.push(s);
    list.push(st);
    put_before(cx, b, at, &list);
}

// A call of `callee` (an FNS index) with no arguments, before `at`.
fn call_before(cx: &mut FnCtx<Comp>, b: i64, at: i64, callee: i64, pcx: &Ctx<Comp>) {
    let call = ir_make(cx, Op::Call, 0, 0, 0, callee, pcx);
    (cx.insts[call as usize]).args = cx.args.len() as i64;
    (cx.insts[call as usize]).nargs = 0;
    let mut list: Vec<i64, Comp> = Vec::new_in(Comp {});
    list.push(call);
    put_before(cx, b, at, &list);
}

fn instrument_function(cx: &mut FnCtx<Comp>, fi: i64, depth_sym: i64, frames_sym: i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        let entry = fn_entry(cx, fi);
        if (cx.blocks[entry as usize]).preds.len() as i64 > 0 {
            // (an entry that is also a loop's header would push each time)
            return;
        }
        let at = body_start(cx, entry);
        let g = ir_make(cx, Op::GAddr, TY_U64, 0, 0, depth_sym, pcx);
        let d = ir_make(cx, Op::Load, TY_I64, g, 0, 0, pcx);
        let one = ir_make(cx, Op::Const, TY_I64, 0, 0, 1, pcx);
        let d1 = ir_make(cx, Op::Add, TY_I64, d, one, 0, pcx);
        let st = ir_make(cx, Op::Store, 0, g, d1, 0, pcx);
        (cx.insts[st as usize]).imm2 = TY_I64;
        let base = ir_make(cx, Op::GAddr, TY_U64, 0, 0, frames_sym, pcx);
        let mask = ir_make(cx, Op::Const, TY_I64, 0, 0, 4095, pcx);
        let m = ir_make(cx, Op::And, TY_I64, d, mask, 0, pcx);
        let three = ir_make(cx, Op::Const, TY_I64, 0, 0, 3, pcx);
        let off = ir_make(cx, Op::Shl, TY_I64, m, three, 0, pcx);
        let slot = ir_make(cx, Op::Add, TY_U64, base, off, 0, pcx);
        let mut list: Vec<i64, Comp> = Vec::new_in(Comp {});
        let parts: [i64; 11] = [g, d, one, d1, st, base, mask, m, three, off, slot];
        for i in 0..11 {
            list.push(parts[i as usize]);
        }
        put_before(cx, entry, at, &list);
        store_site(cx, entry, at, slot, site(fi, 0, pcx), pcx);
        // The sites of the calls (one string per line), the returns.
        let mut lines: Vec<i64, Comp> = Vec::new_in(Comp {});
        let mut sids: Vec<i64, Comp> = Vec::new_in(Comp {});
        let nblocks = fn_block_count(cx, fi);
        for k in 0..nblocks {
            { let at_b = fn_block(cx, fi, k) as usize; cx.blocks[at_b].aux = k + 1; }
        }
        for k in 0..nblocks {
            let b = fn_block(cx, fi, k);
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut last: i64 = -1;
            // A loop's header (a predecessor after it): its statement, each
            // time round (where a loop without calls runs, when stopped).
            let mut back = false;
            for p in 0..(cx.blocks[b as usize]).preds.len() as i64 {
                back = back
                    || (cx.blocks[((cx.blocks[b as usize]).preds[p as usize]) as usize]).aux
                    > k;
            }
            if back {
                let mut w = (cx.blocks[b as usize]).first;
                while w != 0 && (cx.inst_loc[w as usize]) == 0 {
                    w = (cx.insts[w as usize]).next;
                }
                if w != 0 {
                    let pos = (cx.inst_loc[w as usize]) - 1;
                    last = file_and_line(pos, pcx);
                    let body_start_v = body_start(cx, b);
                    store_site(cx, b, body_start_v, slot,
                        site_of(fi, pos, &mut lines, &mut sids, pcx), pcx);
                }
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let next = (cx.insts[v as usize]).next;
                if (cx.insts[v as usize]).op.is_call()
                    && (cx.inst_loc[v as usize]) > 0 {
                    let pos = (cx.inst_loc[v as usize]) - 1;
                    let line = file_and_line(pos, pcx);
                    if line != last {
                        store_site(cx, b, v, slot, site_of(fi, pos, &mut lines, &mut sids, pcx),
                            pcx);
                        last = line;
                    }
                }
                v = next;
            }
            if (cx.blocks[b as usize]).term == Term::Ret {
                let g2 = ir_make(cx, Op::GAddr, TY_U64, 0, 0, depth_sym, pcx);
                let restore = ir_make(cx, Op::Store, 0, g2, d, 0, pcx);
                (cx.insts[restore as usize]).imm2 = TY_I64;
                ir_append(cx, b, g2);
                ir_append(cx, b, restore);
            }
        }
        for k in 0..nblocks {
            { let at_b = fn_block(cx, fi, k) as usize; cx.blocks[at_b].aux = 0; }
        }
    }
}

// --trace: every function's frame; main starts the runtime; std::panic
// dumps the frames.
pub fn trace_after_lowering(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        if !pcx.trace {
            return;
        }
        let depth_sym = intern_c(c"__trace.DEPTH", pcx);
        let frames_sym = intern_c(c"__trace.FRAMES", pcx);
        let start = ({ let at_ix = intern_c(c"__trace::start", pcx) as usize; pcx.sym_fn[at_ix] }) - 1;
        let dump = ({
            let at_ix = intern_c(c"__trace::__vole_trace_dump", pcx) as usize; pcx.sym_fn[at_ix]
        }) - 1;
        if (pcx.sym_static[depth_sym as usize]) == 0
            || (pcx.sym_static[frames_sym as usize]) == 0 || start < 0
            || dump < 0 {
            return;
        }
        let mut note = ({
            let at_ix = intern_c(c"std::panic_note", pcx) as usize; pcx.sym_fn[at_ix]
        }) - 1;
        let panic = ({ let at_ix = intern_c(c"std::panic", pcx) as usize; pcx.sym_fn[at_ix] }) - 1;
        // (0.28.0) std2 has it in std::panic, called by what every panic
        // ends in (PanicBuf::emit), which is no one function to name
        let anywhere = note < 0;
        if anywhere {
            note = ({
                let at_ix = intern_c(c"std::panic::panic_note", pcx) as usize; pcx.sym_fn[at_ix]
            }) - 1;
        }
        for fi in 0..pcx.irfunc_count {
            let f = pcx.ir_fn[fi as usize];
            if pcx.fns[f as usize].module == pcx.trace_module {
                continue;
            }
            if note >= 0 && (f == panic || anywhere) {
                // std::panic's note: the frames instead.
                ir_enter(cx, fi, pcx);
                for k in 0..fn_block_count(cx, fi) {
                    let mut v = (cx.blocks[fn_block(cx, fi, k) as usize]).first;
                    while v != 0 {
                        if (cx.insts[v as usize]).op == Op::Call
                            && (cx.insts[v as usize]).imm == note {
                            (cx.insts[v as usize]).imm = dump;
                        }
                        v = (cx.insts[v as usize]).next;
                    }
                }
            }
            if traced(fi, pcx) {
                instrument_function(cx, fi, depth_sym, frames_sym, pcx);
            }
            if pcx.fns[f as usize].name == pcx.main_sym {
                ir_enter(cx, fi, pcx);
                let entry = fn_entry(cx, fi);
                let body_start_v = body_start(cx, entry);
                call_before(cx, entry, body_start_v, start, pcx);
            }
        }
    }
}

// The runtime's `dump` (an FNS index) when it is emitted, for rt.panic
// to call; -1: none (no --trace, or nothing reaches it).
pub fn trace_dump_fn(pcx: &mut Ctx<Comp>) -> i64 {
    if !pcx.trace {
        return -1;
    }
    let f = ({
        let at_ix = intern_c(c"__trace::__vole_trace_dump", pcx) as usize; pcx.sym_fn[at_ix]
    }) - 1;
    if f < 0 || (pcx.fn_ir[f as usize]) == 0 || pcx.fn_live.len() == 0
        || (pcx.fn_live[((pcx.fn_ir[f as usize]) - 1) as usize]) == 0 {
        return -1;
    }
    f
}
