// Equality saturation, acyclic (0.9): an e-graph over the pure integer
// operations, in the manner of Cranelift's aegraph, built during GVN's
// walk of the dominator tree (gvn.vl).
//
// GVN's table already hash-conses the pure instructions: an instruction
// equal to one that dominates it is that one. Here each value also has an
// e-class: the values known to be equal to it. When an instruction is new
// to the table, the rewrite rules (RULES, below) are matched against it,
// their patterns' operands against every member of the operands' classes;
// each match builds its right-hand side from existing classes (through
// the table, so equal nodes are shared; new ones are inserted before the
// instruction) and joins it to the instruction's class. Nodes only refer to
// values that already exist, so the graph stays acyclic and needs no
// rebuilding. Then extraction picks the class's cheapest member (by
// operation costs, its operands' best costs added) to stand for the
// instruction; the members not picked are dead code, which the next pass
// removes.
//
// The rules are written in a small language, parsed once into patterns:
//
//   (add (add x c1) c2) => (add x (+ c1 c2))
//   (mul x c1) if (pow2 c1) => (shl x (log2 c1))
//
// `x`, `y` match any value (the same name: the same class), names starting
// with `c` a constant, a number a constant of that value; operations are
// add sub mul and or xor shl neg bnot, eq and ne (comparisons); the
// commutative ones (add mul and or xor eq ne) match their operands either
// way round. A right-hand side may compute constants: (+ a b), (- a b),
// (* a b), (& a b), (| a b), (^ a b), (negc a), (log2 a), wrapped to the
// type. Every rule is checked by `volec --check-rules`: both sides
// evaluated on random values (edge values included) at every integer
// width, with the folding semantics of the optimizer (fold.vl), which
// are the language's.

use std::alloc::Allocator;

use crate::base::{STDOUT, buf_byte, buf_bytes, buf_int, buf_new, buf_str, buf_write_fd};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::consteval::wrap_int;
use crate::front::types::{
    TY_BOOL, TY_I16, TY_I32, TY_I64, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, is_integer,
};
use crate::gen0::target::log2;
use crate::middle::ctx::FnCtx;
use crate::middle::fold::{fold_compare, fold_fields};
use crate::middle::gvn::{gvn_find_or_add, is_commutative_op, operands_out_of_order};
use crate::middle::ir::{Cond, Op, ir_insert_before, ir_make, ir_replace};
use crate::middle::ir::Op::{Add, And, BNot, Cmp, Const, Mul, Neg, Or, Shl, Sub, Xor};

// ---- The rules ----

const RULE_COUNT: i64 = 31;

fn rule_text(i: i64) -> &'static [u8] {
    let rules: [&[u8]; 31] = [
        b"(add (add x c1) c2) => (add x (+ c1 c2))",
        b"(sub x c1) => (add x (negc c1))",
        b"(mul (mul x c1) c2) => (mul x (* c1 c2))",
        b"(and (and x c1) c2) => (and x (& c1 c2))",
        b"(or (or x c1) c2) => (or x (| c1 c2))",
        b"(xor (xor x c1) c2) => (xor x (^ c1 c2))",
        b"(sub (add x y) y) => x",
        b"(add (sub x y) y) => x",
        b"(sub x (sub x y)) => y",
        b"(sub (sub x y) x) => (neg y)",
        b"(xor (xor x y) y) => x",
        b"(and (or x y) x) => x",
        b"(or (and x y) x) => x",
        b"(add (mul x c1) x) => (mul x (+ c1 1))",
        b"(sub (mul x c1) x) => (mul x (- c1 1))",
        b"(mul x c1) if (pow2 c1) => (shl x (log2 c1))",
        b"(eq (add x c1) c2) => (eq x (- c2 c1))",
        b"(ne (add x c1) c2) => (ne x (- c2 c1))",
        b"(eq (xor x c1) c2) => (eq x (^ c1 c2))",
        b"(ne (xor x c1) c2) => (ne x (^ c1 c2))",
        b"(eq (sub x y) 0) => (eq x y)",
        b"(ne (sub x y) 0) => (ne x y)",
        b"(neg (sub x y)) => (sub y x)",
        b"(neg (neg x)) => x",
        b"(bnot (bnot x)) => x",
        b"(add x (neg y)) => (sub x y)",
        b"(sub x (neg y)) => (add x y)",
        b"(add (bnot x) 1) => (neg x)",
        b"(bnot (neg x)) => (add x -1)",
        b"(and x (bnot x)) => 0",
        b"(xor x (bnot x)) => -1",
    ];
    rules[i as usize]
}

// Pattern nodes: kind, operation (an Op, or a constant operator), its
// condition (eq, ne), operands a and b, a variable's index or a literal.
const K_OP: i64 = 1;
const K_VAR: i64 = 2;
const K_CVAR: i64 = 3;
const K_LIT: i64 = 4;
const K_CEXPR: i64 = 5;

// Constant operators of right-hand sides.
const C_ADD: i64 = 1;
const C_SUB: i64 = 2;
const C_MUL: i64 = 3;
const C_AND: i64 = 4;
const C_OR: i64 = 5;
const C_XOR: i64 = 6;
const C_NEG: i64 = 7;
const C_LOG2: i64 = 8;

// (0.29) The rules, parsed: the compilation context's (Ctx.rules), made
// with it and only read after.
pub struct Rules<A: Allocator> {
    // Pattern nodes.
    pub p_kind: Vec<i64, A>,
    pub p_op: Vec<i64, A>,
    pub p_cond: Vec<i64, A>,
    pub p_a: Vec<i64, A>,
    pub p_b: Vec<i64, A>,
    pub p_val: Vec<i64, A>,
    // Per rule: left and right patterns, the guarded constant variable (-1:
    // no guard), the variable count.
    pub r_lhs: Vec<i64, A>,
    pub r_rhs: Vec<i64, A>,
    pub r_guard: Vec<i64, A>,
    pub r_vars: Vec<i64, A>,
    // (0.17) The rules whose left side is operation op:
    // r_by_op[r_by_op_start[op] .. r_by_op_start[op + 1]], in order
    // (egraph_rewrite went through all of them for every instruction).
    pub r_by_op: Vec<i64, A>,
    pub r_by_op_start: [i64; 65],
}

// The parser's state: the text of the rule being parsed, the position,
// its variables' names (a name's length and first two bytes), and how many
// of them the left side has (the right side may use no other).
struct RuleParser<'a, A: Allocator> {
    text: &'a [u8],
    pos: usize,
    vars: Vec<i64, A>,
    vars_now: i64,
}

fn rule_error(message: &str, text: &[u8]) -> ! {
    eprintln("error: {message}{}", str::from_utf8(text).unwrap());
    std::process::exit(1)
}

fn is_word_byte(c: u8) -> bool {
    c != 0 && c != b' ' && c != b'(' && c != b')'
}

impl<'a> RuleParser<'a, Comp> {
    // The byte at position i (0 past the end).
    fn at(&self, i: usize) -> u8 {
        if i < self.text.len() { self.text[i] } else { 0 }
    }

    fn skip_space(&mut self) {
        while self.at(self.pos) == b' ' {
            self.pos += 1;
        }
    }

    // The word at the position; the position moves past it.
    fn word(&mut self) -> &'a [u8] {
        self.skip_space();
        let start = self.pos;
        while is_word_byte(self.at(self.pos)) {
            self.pos += 1;
        }
        if self.pos == start {
            rule_error("internal error: a rewrite rule is malformed: ", self.text);
        }
        &self.text[start..self.pos]
    }

    // The variable named `name`, numbered in order of appearance.
    fn variable(&mut self, name: &[u8]) -> i64 {
        let second: i64 = if name.len() > 1 { name[1] as i64 } else { 0 };
        let key = (name.len() as i64) * 65536 + (name[0] as i64) * 256 + second;
        for i in 0..self.vars.len() {
            if self.vars[i] == key {
                return i as i64;
            }
        }
        self.vars.push(key);
        self.vars.len() as i64 - 1
    }

    fn pattern(&mut self, rhs: bool, rules: &mut Rules<Comp>) -> i64 {
        self.skip_space();
        if self.at(self.pos) != b'(' {
            let w = self.word();
            let c = w[0];
            if c == b'-' || (c >= b'0' && c <= b'9') {
                let mut value: i64 = 0;
                let negative = c == b'-';
                let first: usize = if negative { 1 } else { 0 };
                for i in first..w.len() {
                    value = value * 10 + (w[i] - b'0') as i64;
                }
                return new_pattern(rules, K_LIT, 0, 0, 0, if negative { 0 - value } else { value });
            }
            let var_id = self.variable(w);
            if rhs && var_id >= self.vars_now {
                rule_error("internal error: a rewrite rule's right side has a new variable: ",
                    self.text);
            }
            return new_pattern(rules, if c == b'c' { K_CVAR } else { K_VAR }, 0, 0, 0, var_id);
        }
        self.pos += 1;
        let w = self.word();
        let mut kind = K_OP;
        let mut op: i64 = 0;
        let mut cond: i64 = 0;
        let mut arity: i64 = 2;
        if w == b"add" { op = Add as i64; }
        else if w == b"sub" { op = Sub as i64; }
        else if w == b"mul" { op = Mul as i64; }
        else if w == b"and" { op = And as i64; }
        else if w == b"or" { op = Or as i64; }
        else if w == b"xor" { op = Xor as i64; }
        else if w == b"shl" { op = Shl as i64; }
        else if w == b"neg" { op = Neg as i64; arity = 1; }
        else if w == b"bnot" { op = BNot as i64; arity = 1; }
        else if w == b"eq" { op = Cmp as i64; cond = Cond::Eq as i64; }
        else if w == b"ne" { op = Cmp as i64; cond = Cond::Ne as i64; }
        else {
            kind = K_CEXPR;
            if w == b"+" { op = C_ADD; }
            else if w == b"-" { op = C_SUB; }
            else if w == b"*" { op = C_MUL; }
            else if w == b"&" { op = C_AND; }
            else if w == b"|" { op = C_OR; }
            else if w == b"^" { op = C_XOR; }
            else if w == b"negc" { op = C_NEG; arity = 1; }
            else if w == b"log2" { op = C_LOG2; arity = 1; }
            else { rule_error("internal error: unknown operation in a rewrite rule: ", self.text); }
        }
        let a = self.pattern(rhs, rules);
        let b: i64 = if arity == 2 { self.pattern(rhs, rules) } else { -1 };
        self.skip_space();
        if self.at(self.pos) != b')' {
            rule_error("internal error: expected ')' in a rewrite rule: ", self.text);
        }
        self.pos += 1;
        let p = new_pattern(rules, kind, op, a, b, 0);
        rules.p_cond[p as usize] = cond;
        p
    }
}

fn new_pattern(rules: &mut Rules<Comp>, kind: i64, op: i64, a: i64, b: i64, val: i64) -> i64 {
    rules.p_kind.push(kind);
    rules.p_op.push(op);
    rules.p_cond.push(0);
    rules.p_a.push(a);
    rules.p_b.push(b);
    rules.p_val.push(val);
    rules.p_kind.len() as i64 - 1
}

// The rules, parsed (once, for the compilation context).
pub fn rules_new() -> Rules<Comp> {
    let mut rules = Rules {
        p_kind: Vec::new_in(Comp {}), p_op: Vec::new_in(Comp {}), p_cond: Vec::new_in(Comp {}),
        p_a: Vec::new_in(Comp {}), p_b: Vec::new_in(Comp {}), p_val: Vec::new_in(Comp {}),
        r_lhs: Vec::new_in(Comp {}), r_rhs: Vec::new_in(Comp {}), r_guard: Vec::new_in(Comp {}),
        r_vars: Vec::new_in(Comp {}), r_by_op: Vec::new_in(Comp {}), r_by_op_start: [0i64; 65],
    };
    for r in 0..RULE_COUNT {
        let mut p = RuleParser {
            text: rule_text(r), pos: 0, vars: Vec::new_in(Comp {}), vars_now: 1000,
        };
        let lhs = p.pattern(false, &mut rules);
        let mut guard: i64 = -1;
        let at = p.word();
        if at == b"if" {
            p.skip_space();
            p.pos += 1;
            if p.word() != b"pow2" {
                rule_error("internal error: unknown guard in a rewrite rule: ", p.text);
            }
            let v = p.word();
            guard = p.variable(v);
            p.skip_space();
            p.pos += 1;
            if p.word() != b"=>" {
                rule_error("internal error: expected '=>' in a rewrite rule: ", p.text);
            }
        } else if at != b"=>" {
            rule_error("internal error: expected '=>' in a rewrite rule: ", p.text);
        }
        p.vars_now = p.vars.len() as i64;
        let rhs = p.pattern(true, &mut rules);
        if rules.p_kind[lhs as usize] != K_OP {
            rule_error("internal error: a rewrite rule's left side is not an operation: ", p.text);
        }
        rules.r_lhs.push(lhs);
        rules.r_rhs.push(rhs);
        rules.r_guard.push(guard);
        rules.r_vars.push(p.vars.len() as i64);
    }
    // (0.17) The rules by the operation of their left side, in order.
    for op in 0..64 {
        rules.r_by_op_start[op as usize] = rules.r_by_op.len() as i64;
        for r in 0..RULE_COUNT {
            if rules.p_op[rules.r_lhs[r as usize] as usize] == op {
                rules.r_by_op.push(r);
            }
        }
    }
    rules.r_by_op_start[64] = rules.r_by_op.len() as i64;
    rules
}

// ---- E-classes ----
//
// The e-classes are directional, as in Cranelift: when a rule shows
// instruction v equal to w (which dominates v), w and its own members
// join v's class, but v does not join w's (w's other users may not be
// dominated by v). Per value (by id, valid when its stamp is this run's):
// its members (a run in ALTS; none recorded: the value alone) and the
// best cost found for it.

pub fn egraph_start(cx: &mut FnCtx<Comp>) {
    cx.run += 1;
    cx.alts.clear();
}

fn ec_touch(cx: &mut FnCtx<Comp>, v: i64) {
    while cx.ec_stamp.len() as i64 <= v {
        cx.ec_stamp.push(0);
        cx.ec_start.push(0);
        cx.ec_len.push(0);
        cx.ec_cost.push(0);
    }
    if (cx.ec_stamp[v as usize]) != cx.run {
        (cx.ec_stamp[v as usize]) = cx.run;
        (cx.ec_start[v as usize]) = 0;
        (cx.ec_len[v as usize]) = 0;
        (cx.ec_cost[v as usize]) = 0;
    }
}

fn member_count(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    ec_touch(cx, v);
    if (cx.ec_len[v as usize]) == 0 { 1 } else { (cx.ec_len[v as usize]) }
}

fn member(cx: &mut FnCtx<Comp>, v: i64, i: i64) -> i64 {
    if (cx.ec_len[v as usize]) == 0 { v }
    else { (cx.alts[((cx.ec_start[v as usize]) + i) as usize]) }
}

fn is_member(cx: &mut FnCtx<Comp>, v: i64, w: i64) -> bool {
    let n = member_count(cx, v);
    for i in 0..n {
        if member(cx, v, i) == w {
            return true;
        }
    }
    false
}

// Whether v and w are known equal.
fn same_value(cx: &mut FnCtx<Comp>, v: i64, w: i64) -> bool {
    v == w || is_member(cx, v, w) || is_member(cx, w, v)
}

fn op_cost(op: Op) -> i64 {
    match op {
        Const => 0,
        Mul => 3,
        Op::Div | Op::Rem => 20,
        _ => 1,
    }
}

// The cost of node m: its operation's, with its operands' best.
fn node_cost(cx: &mut FnCtx<Comp>, m: i64) -> i64 {
    let mut cost = op_cost((cx.insts[m as usize]).op);
    let a = (cx.insts[m as usize]).a;
    let b = (cx.insts[m as usize]).b;
    if a != 0 {
        ec_touch(cx, a);
        cost += (cx.ec_cost[a as usize]);
    }
    if b != 0 {
        ec_touch(cx, b);
        cost += (cx.ec_cost[b as usize]);
    }
    cost
}

// ---- Matching ----

fn undo_to(cx: &mut FnCtx<Comp>, mark: i64) {
    while cx.trail.len() as i64 > mark {
        cx.bind[cx.trail.pop().unwrap() as usize] = 0;
    }
}

fn bind(cx: &mut FnCtx<Comp>, var_id: i64, v: i64) -> bool {
    if cx.bind[var_id as usize] == 0 {
        cx.bind[var_id as usize] = v;
        cx.trail.push(var_id);
        return true;
    }
    same_value(cx, cx.bind[var_id as usize], v)
}

fn is_commutative_pattern(p: i64, pcx: &Ctx<Comp>) -> bool {
    let op = (pcx.rules.p_op[p as usize]);
    op == Add as i64 || op == Mul as i64 || op == And as i64 || op == Or as i64 || op == Xor as i64
        || op == Cmp as i64
}

// Whether pattern p matches value v (of integer type ty): a member of
// v's class, for an operation.
fn pmatch(cx: &mut FnCtx<Comp>, p: i64, v: i64, ty: i64, pcx: &Ctx<Comp>) -> bool {
    let kind = (pcx.rules.p_kind[p as usize]);
    if kind == K_VAR {
        return bind(cx, (pcx.rules.p_val[p as usize]), v);
    }
    if kind == K_CVAR || kind == K_LIT {
        let c = const_member(cx, v);
        if c == 0 {
            return false;
        }
        if kind == K_LIT {
            return (cx.insts[c as usize]).imm
                == wrap_int((pcx.rules.p_val[p as usize]), ty);
        }
        return bind(cx, (pcx.rules.p_val[p as usize]), c);
    }
    let op = (pcx.rules.p_op[p as usize]);
    let is_cmp = op == Cmp as i64;
    let n = member_count(cx, v);
    for k in 0..n {
        let m = member(cx, v, k);
        let mop = (cx.insts[m as usize]).op;
        if mop as i64 == op && (if is_cmp {
            (cx.insts[m as usize]).cond as i64 == (pcx.rules.p_cond[p as usize])
                && (cx.insts[m as usize]).ty == TY_BOOL
        } else {
            (cx.insts[m as usize]).ty == ty
        }) {
            let child_ty = if is_cmp { (cx.insts[m as usize]).imm2 } else { ty };
            if is_integer(child_ty) {
                let mark = cx.trail.len() as i64;
                if pmatch(cx, (pcx.rules.p_a[p as usize]), (cx.insts[m as usize]).a,
                    child_ty, pcx)
                    && ((pcx.rules.p_b[p as usize]) < 0
                        || pmatch(cx, (pcx.rules.p_b[p as usize]),
                            (cx.insts[m as usize]).b, child_ty, pcx)) {
                    return true;
                }
                undo_to(cx, mark);
                if (pcx.rules.p_b[p as usize]) >= 0 && is_commutative_pattern(p, pcx) {
                    if pmatch(cx, (pcx.rules.p_a[p as usize]),
                        (cx.insts[m as usize]).b, child_ty, pcx)
                        && pmatch(cx, (pcx.rules.p_b[p as usize]),
                            (cx.insts[m as usize]).a, child_ty, pcx) {
                        return true;
                    }
                    undo_to(cx, mark);
                }
            }
        }
    }
    false
}

// A constant member of v's class, or 0.
fn const_member(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let n = member_count(cx, v);
    for k in 0..n {
        let m = member(cx, v, k);
        if (cx.insts[m as usize]).op == Const {
            return m;
        }
    }
    0
}

// ---- Building right-hand sides ----

// (0.17) The constant `x <op> y`, folded as the instruction ir_make would
// build for it (0.29: by its fields; before, through a scratch instruction
// one past the function's last).
fn fold2(cx: &mut FnCtx<Comp>, op: Op, ty: i64, x: i64, y: i64) -> i64 {
    fold_fields(op, Cond::Eq, ty, 0, 0, x, y)
}

// The value of constant expression p (of type ty), with BIND's constants.
fn const_value_of(cx: &mut FnCtx<Comp>, p: i64, ty: i64, consts: &[i64; 8], pcx: &Ctx<Comp>) -> i64 {
    let kind = (pcx.rules.p_kind[p as usize]);
    if kind == K_LIT {
        return wrap_int((pcx.rules.p_val[p as usize]), ty);
    }
    if kind == K_CVAR {
        return consts[(pcx.rules.p_val[p as usize]) as usize];
    }
    let x = const_value_of(cx, (pcx.rules.p_a[p as usize]), ty, consts, pcx);
    let op = (pcx.rules.p_op[p as usize]);
    if op == C_NEG {
        return fold2(cx, Neg, ty, x, 0);
    }
    if op == C_LOG2 {
        return log2(x);
    }
    let y = const_value_of(cx, (pcx.rules.p_b[p as usize]), ty, consts, pcx);
    let fop = if op == C_ADD { Add } else if op == C_SUB { Sub } else if op == C_MUL { Mul }
        else if op == C_AND { And } else if op == C_OR { Or } else { Xor };
    fold2(cx, fop, ty, x, y)
}

// A node (op, ty, a, b) before instruction `at`: an equal one the table
// knows, or a new one.
fn make_node(cx: &mut FnCtx<Comp>, at: i64, op: Op, cond: i64, ty: i64, operand_ty: i64, a: i64,
    b: i64, imm: i64, pcx: &Ctx<Comp>) -> i64 {
    let n = ir_make(cx, op, ty, a, b, imm, pcx);
    if op == Cmp {
        (cx.insts[n as usize]).cond = if cond == Cond::Ne as i64 { Cond::Ne }
            else { Cond::Eq };
        (cx.insts[n as usize]).imm2 = operand_ty;
    }
    if b != 0 && is_commutative_op(cx, n) && operands_out_of_order(cx, a, b) {
        (cx.insts[n as usize]).a = b;
        (cx.insts[n as usize]).b = a;
    }
    ir_insert_before(cx, at, n);
    let w = gvn_find_or_add(cx, n);
    if w != 0 {
        ir_replace(cx, n, w);
        return w;
    }
    ec_touch(cx, n);
    (cx.ec_cost[n as usize]) = node_cost(cx, n);
    n
}

fn build(cx: &mut FnCtx<Comp>, at: i64, p: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    let kind = (pcx.rules.p_kind[p as usize]);
    if kind == K_VAR || kind == K_CVAR {
        return cx.bind[(pcx.rules.p_val[p as usize]) as usize];
    }
    if kind == K_LIT || kind == K_CEXPR {
        // (the bound constants, by value: the context is free for the calls)
        let consts = cx.consts;
        let value = const_value_of(cx, p, ty, &consts, pcx);
        return make_node(cx, at, Const, 0, ty, 0, 0, 0, value, pcx);
    }
    let op = (pcx.rules.p_op[p as usize]);
    let is_cmp = op == Cmp as i64;
    let child_ty = if is_cmp { cx.build_cmp_ty } else { ty };
    let a = build(cx, at, (pcx.rules.p_a[p as usize]), child_ty, pcx);
    let b: i64 = if (pcx.rules.p_b[p as usize])
        >= 0 { build(cx, at, (pcx.rules.p_b[p as usize]), child_ty, pcx) } else { 0 };
    let iop = op_of(op);
    make_node(cx, at, iop, (pcx.rules.p_cond[p as usize]),
        if is_cmp { TY_BOOL } else { ty }, child_ty, a, b, 0, pcx)
}

fn op_of(op: i64) -> Op {
    if op == Add as i64 { return Add; }
    if op == Sub as i64 { return Sub; }
    if op == Mul as i64 { return Mul; }
    if op == And as i64 { return And; }
    if op == Or as i64 { return Or; }
    if op == Xor as i64 { return Xor; }
    if op == Shl as i64 { return Shl; }
    if op == Neg as i64 { return Neg; }
    if op == BNot as i64 { return BNot; }
    Cmp
}

fn is_pow2(x: i64) -> bool {
    x > 0 && (x & (x - 1)) == 0
}

// The rules on instruction v (new to GVN's table, its operands resolved):
// returns the value standing for it (v itself, or a cheaper equal one).
pub fn egraph_rewrite(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    let op = (cx.insts[v as usize]).op;
    let is_cmp = op == Cmp;
    let ty = (cx.insts[v as usize]).ty;
    let operand_ty = if is_cmp { (cx.insts[v as usize]).imm2 } else { ty };
    ec_touch(cx, v);
    (cx.ec_cost[v as usize]) = node_cost(cx, v);
    if !is_integer(operand_ty)
        || (is_cmp && (cx.insts[v as usize]).cond != Cond::Eq
            && (cx.insts[v as usize]).cond != Cond::Ne) {
        return v;
    }
    cx.found.clear();
    cx.found.push(v);
    let o = op as i64;
    if o >= 64 {
        return v;
    }
    for ri in pcx.rules.r_by_op_start[o as usize]..pcx.rules.r_by_op_start[(o + 1) as usize] {
        let r = (pcx.rules.r_by_op[ri as usize]);
        let lhs = (pcx.rules.r_lhs[r as usize]);
        for i in 0..8 {
            cx.bind[i as usize] = 0;
        }
        cx.trail.clear();
        if !pmatch(cx, lhs, v, ty, pcx) {
            continue;
        }
        // The constants bound, as values of their type.
        for i in 0..(pcx.rules.r_vars[r as usize]) {
            cx.consts[i as usize] = if cx.bind[i as usize] != 0
                && (cx.insts[cx.bind[i as usize] as usize]).op
                == Const { (cx.insts[cx.bind[i as usize] as usize]).imm }
                else { 0 };
        }
        let guard = (pcx.rules.r_guard[r as usize]);
        if guard >= 0 && !is_pow2(cx.consts[guard as usize]) {
            continue;
        }
        cx.build_cmp_ty = operand_ty;
        let w = build(cx, v, (pcx.rules.r_rhs[r as usize]), ty, pcx);
        if (cx.insts[w as usize]).ty != ty {
            continue;
        }
        // w and its members join v's class.
        let n = member_count(cx, w);
        for k in 0..n {
            let m = member(cx, w, k);
            let mut known = false;
            for j in 0..cx.found.len() as i64 {
                if (cx.found[j as usize]) == m {
                    known = true;
                }
            }
            if !known {
                cx.found.push(m);
            }
        }
    }
    if cx.found.len() as i64 == 1 {
        return v;
    }
    (cx.ec_start[v as usize]) = cx.alts.len() as i64;
    (cx.ec_len[v as usize]) = cx.found.len() as i64;
    for j in 0..cx.found.len() as i64 {
        cx.alts.push((cx.found[j as usize]));
    }
    // Extraction: the cheapest member (v on a tie).
    let mut best = v;
    let mut best_cost = (cx.ec_cost[v as usize]);
    for j in 1..cx.found.len() as i64 {
        let m = (cx.found[j as usize]);
        ec_touch(cx, m);
        if (cx.ec_cost[m as usize]) < best_cost {
            best = m;
            best_cost = (cx.ec_cost[m as usize]);
        }
    }
    (cx.ec_cost[v as usize]) = best_cost;
    best
}

// ---- Checking the rules (volec --check-rules) ----

fn rand64(pcx: &mut Ctx<Comp>) -> i64 {
    pcx.rng = pcx.rng ^ (pcx.rng << 13);
    pcx.rng = pcx.rng ^ (pcx.rng >> 7);
    pcx.rng = pcx.rng ^ (pcx.rng << 17);
    pcx.rng as i64
}

// A random value of type ty: often small, or at an edge.
fn random_value(ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let k = rand64(pcx) & 7;
    let raw: i64 = if k == 0 {
        0
    } else if k == 1 {
        -1
    } else if k == 2 {
        1
    } else if k == 3 {
        (rand64(pcx) & 15) - 8
    } else if k == 4 {
        1 << ((rand64(pcx) & 63) as u64)
    } else if k == 5 {
        (1i64 << ((rand64(pcx) & 63) as u64)).wrapping_sub(1)
    } else {
        rand64(pcx)
    };
    wrap_int(raw, ty)
}

// Pattern p evaluated with EVAL_VARS (integers of type ty; comparisons as
// 0 or 1).
fn eval_pattern(cx: &mut FnCtx<Comp>, p: i64, ty: i64, cmp_ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let kind = (pcx.rules.p_kind[p as usize]);
    if kind == K_VAR || kind == K_CVAR {
        return pcx.eval_vars[(pcx.rules.p_val[p as usize]) as usize];
    }
    if kind == K_LIT || kind == K_CEXPR {
        return const_value_of(cx, p, ty, &pcx.eval_vars, pcx);
    }
    let op = (pcx.rules.p_op[p as usize]);
    if op == Cmp as i64 {
        let x = eval_pattern(cx, (pcx.rules.p_a[p as usize]), cmp_ty, cmp_ty, pcx);
        let y = eval_pattern(cx, (pcx.rules.p_b[p as usize]), cmp_ty, cmp_ty, pcx);
        let cond = if (pcx.rules.p_cond[p as usize]) == Cond::Ne as i64 { Cond::Ne }
            else { Cond::Eq };
        return fold_compare(cond, cmp_ty, x, y) as i64;
    }
    let x = eval_pattern(cx, (pcx.rules.p_a[p as usize]), ty, cmp_ty, pcx);
    let y: i64 = if (pcx.rules.p_b[p as usize])
        >= 0 { eval_pattern(cx, (pcx.rules.p_b[p as usize]), ty, cmp_ty, pcx) }
        else { 0 };
    fold2(cx, op_of(op), ty, x, y)
}

// Checks every rule on random values at every integer width; prints a
// line per failure and a summary; returns the number of failures.
pub fn check_rules(cx: &mut FnCtx<Comp>, trials: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let types: [i64; 8] = [TY_I8, TY_I16, TY_I32, TY_I64, TY_U8, TY_U16, TY_U32, TY_U64];
    let out = buf_new();
    let mut failures: i64 = 0;
    let mut checked: i64 = 0;
    for r in 0..RULE_COUNT {
        let lhs = (pcx.rules.r_lhs[r as usize]);
        let is_cmp = (pcx.rules.p_op[lhs as usize]) == Cmp as i64;
        for t in 0..8 {
            let ty = types[t as usize];
            let value_ty = if is_cmp { TY_BOOL } else { ty };
            let mut failed = false;
            for _ in 0..trials {
                for i in 0..(pcx.rules.r_vars[r as usize]) {
                    pcx.eval_vars[i as usize] = random_value(ty, pcx);
                }
                let guard = (pcx.rules.r_guard[r as usize]);
                if guard >= 0 && !is_pow2(pcx.eval_vars[guard as usize]) {
                    pcx.eval_vars[guard as usize] = wrap_int(1 << ((rand64(pcx) & 7) as u64),
                        ty);
                    if !is_pow2(pcx.eval_vars[guard as usize]) {
                        continue;
                    }
                }
                checked += 1;
                let left = eval_pattern(cx, lhs, value_ty, ty, pcx);
                let right = eval_pattern(cx, (pcx.rules.r_rhs[r as usize]), value_ty, ty,
                    pcx);
                if left != right && !failed {
                    failed = true;
                    failures += 1;
                    buf_str(out, c"rule failed: ");
                    buf_bytes(out, rule_text(r));
                    buf_str(out, c" (type ");
                    buf_int(out, t);
                    buf_str(out, c", variables");
                    for i in 0..(pcx.rules.r_vars[r as usize]) {
                        buf_byte(out, b' ');
                        buf_int(out, pcx.eval_vars[i as usize]);
                    }
                    buf_str(out, c": ");
                    buf_int(out, left);
                    buf_str(out, c" vs ");
                    buf_int(out, right);
                    buf_str(out, c")\n");
                }
            }
        }
    }
    buf_str(out, c"rewrite rules: ");
    buf_int(out, RULE_COUNT);
    buf_str(out, c" rules, ");
    buf_int(out, checked);
    buf_str(out, c" checks, ");
    buf_int(out, failures);
    buf_str(out, c" failed\n");
    buf_write_fd(out, STDOUT);
    failures
}
