// Equality saturation, acyclic (0.9): an e-graph over the pure integer
// operations, in the manner of Cranelift's aegraph, built during GVN's
// walk of the dominator tree (gvn.vl).
//
// GVN's table already hash-conses the pure instructions: an instruction
// equal to one that dominates it is that one. Here each value also has an
// e-class: the values known to be equal to it. When an instruction is new
// to the table, the rewrite rules (RULES, below) are matched against it,
// their patterns' operands against every member of the operands' classes;
// each match builds its right-hand side from existing classes (through
// the table, so equal nodes are shared; new ones are inserted before the
// instruction) and joins it to the instruction's class. Nodes only refer to
// values that already exist, so the graph stays acyclic and needs no
// rebuilding. Then extraction picks the class's cheapest member (by
// operation costs, its operands' best costs added) to stand for the
// instruction; the members not picked are dead code, which the next pass
// removes.
//
// The rules are written in a small language, parsed once into patterns:
//
//   (add (add x c1) c2) => (add x (+ c1 c2))
//   (mul x c1) if (pow2 c1) => (shl x (log2 c1))
//
// `x`, `y` match any value (the same name: the same class), names starting
// with `c` a constant, a number a constant of that value; operations are
// add sub mul and or xor shl neg bnot, eq and ne (comparisons); the
// commutative ones (add mul and or xor eq ne) match their operands either
// way round. A right-hand side may compute constants: (+ a b), (- a b),
// (* a b), (& a b), (| a b), (^ a b), (negc a), (log2 a), wrapped to the
// type. Every rule is checked by `volec --check-rules`: both sides
// evaluated on random values (edge values included) at every integer
// width, with the folding semantics of the optimizer (fold.vl), which
// are the language's.

use crate::base::{IntVec, STDOUT, buf_byte, buf_int, buf_new, buf_str, buf_write_fd, die2, strlen};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::consteval::wrap_int;
use crate::front::types::{
    TY_BOOL, TY_I16, TY_I32, TY_I64, TY_I8, TY_U16, TY_U32, TY_U64, TY_U8, is_integer,
};
use crate::gen0::target::log2;
use crate::middle::ctx::FnCtx;
use crate::middle::fold::{fold_compare, fold_fields};
use crate::middle::gvn::{gvn_find_or_add, is_commutative_op, operands_out_of_order};
use crate::middle::ir::{Cond, Op, ir_insert_before, ir_make, ir_replace};
use crate::middle::ir::Op::{Add, And, BNot, Cmp, Const, Mul, Neg, Or, Shl, Sub, Xor};

// ---- The rules ----

const RULE_COUNT: i64 = 31;

fn rule_text(i: i64) -> *mut u8 {
    let rules: [*mut u8; 31] = [
        c"(add (add x c1) c2) => (add x (+ c1 c2))",
        c"(sub x c1) => (add x (negc c1))",
        c"(mul (mul x c1) c2) => (mul x (* c1 c2))",
        c"(and (and x c1) c2) => (and x (& c1 c2))",
        c"(or (or x c1) c2) => (or x (| c1 c2))",
        c"(xor (xor x c1) c2) => (xor x (^ c1 c2))",
        c"(sub (add x y) y) => x",
        c"(add (sub x y) y) => x",
        c"(sub x (sub x y)) => y",
        c"(sub (sub x y) x) => (neg y)",
        c"(xor (xor x y) y) => x",
        c"(and (or x y) x) => x",
        c"(or (and x y) x) => x",
        c"(add (mul x c1) x) => (mul x (+ c1 1))",
        c"(sub (mul x c1) x) => (mul x (- c1 1))",
        c"(mul x c1) if (pow2 c1) => (shl x (log2 c1))",
        c"(eq (add x c1) c2) => (eq x (- c2 c1))",
        c"(ne (add x c1) c2) => (ne x (- c2 c1))",
        c"(eq (xor x c1) c2) => (eq x (^ c1 c2))",
        c"(ne (xor x c1) c2) => (ne x (^ c1 c2))",
        c"(eq (sub x y) 0) => (eq x y)",
        c"(ne (sub x y) 0) => (ne x y)",
        c"(neg (sub x y)) => (sub y x)",
        c"(neg (neg x)) => x",
        c"(bnot (bnot x)) => x",
        c"(add x (neg y)) => (sub x y)",
        c"(sub x (neg y)) => (add x y)",
        c"(add (bnot x) 1) => (neg x)",
        c"(bnot (neg x)) => (add x -1)",
        c"(and x (bnot x)) => 0",
        c"(xor x (bnot x)) => -1",
    ];
    rules[i as usize]
}

// Pattern nodes: kind, operation (an Op, or a constant operator), its
// condition (eq, ne), operands a and b, a variable's index or a literal.
const K_OP: i64 = 1;
const K_VAR: i64 = 2;
const K_CVAR: i64 = 3;
const K_LIT: i64 = 4;
const K_CEXPR: i64 = 5;

// Constant operators of right-hand sides.
const C_ADD: i64 = 1;
const C_SUB: i64 = 2;
const C_MUL: i64 = 3;
const C_AND: i64 = 4;
const C_OR: i64 = 5;
const C_XOR: i64 = 6;
const C_NEG: i64 = 7;
const C_LOG2: i64 = 8;

static mut P_KIND: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut P_OP: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut P_COND: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut P_A: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut P_B: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut P_VAL: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };

// Per rule: left and right patterns, the guarded constant variable (-1:
// no guard), the variable count.
static mut R_LHS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut R_RHS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut R_GUARD: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut R_VARS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut RULES_READY: bool = false;

// The parser's state: the text, the position, the variable names (C
// strings' first two bytes) of the rule being parsed.
static mut PT: *mut u8 = 0 as *mut u8;
static mut PP: i64 = 0;
static mut PVARS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };

fn rule_error(message: *mut u8) -> ! {
    die2(message, get_pt())
}

fn skip_space() {
    while unsafe { (*get_pt().add(get_pp() as usize)) == b' ' } {
        set_pp(get_pp() + (1));
    }
}

fn is_word_byte(c: u8) -> bool {
    c != 0 && c != b' ' && c != b'(' && c != b')'
}

// The word at PP: its start; PP moves past it.
fn word() -> i64 {
    unsafe {
        skip_space();
        let start = get_pp();
        while is_word_byte((*get_pt().add(get_pp() as usize))) {
            set_pp(get_pp() + (1));
        }
        if get_pp() == start {
            rule_error(c"internal error: a rewrite rule is malformed: ");
        }
        start
    }
}

fn word_is(start: i64, text: *mut u8) -> bool {
    unsafe {
        let n = strlen(text) as i64;
        if get_pp() - start != n {
            return false;
        }
        for i in 0..n {
            if (*get_pt().add((start + i) as usize)) != (*text.add(i as usize)) {
                return false;
            }
        }
        true
    }
}

fn new_pattern(kind: i64, op: i64, a: i64, b: i64, val: i64) -> i64 {
    { let mut p_kind_copy = get_p_kind(); p_kind_copy.push(kind); set_p_kind(p_kind_copy); }
    { let mut p_op_copy = get_p_op(); p_op_copy.push(op); set_p_op(p_op_copy); }
    { let mut p_cond_copy = get_p_cond(); p_cond_copy.push(0); set_p_cond(p_cond_copy); }
    { let mut p_a_copy = get_p_a(); p_a_copy.push(a); set_p_a(p_a_copy); }
    { let mut p_b_copy = get_p_b(); p_b_copy.push(b); set_p_b(p_b_copy); }
    { let mut p_val_copy = get_p_val(); p_val_copy.push(val); set_p_val(p_val_copy); }
    get_p_kind().len() as i64 - 1
}

// The variable named by the word at [start, PP), numbered in order of
// appearance.
fn variable(start: i64) -> i64 {
    unsafe {
        let second: i64 = if get_pp() - start > 1 { (*get_pt().add((start + 1) as usize)) as i64 }
            else { 0 };
        let key = (get_pp() - start) * 65536 + ((*get_pt().add(start as usize)) as i64) * 256 + second;
        for i in 0..get_pvars().len() as i64 {
            if (get_pvars()[i as usize]) == key {
                return i;
            }
        }
        { let mut pvars_copy = get_pvars(); pvars_copy.push(key); set_pvars(pvars_copy); }
        get_pvars().len() as i64 - 1
    }
}

fn parse_pattern(rhs: bool) -> i64 {
    unsafe {
        skip_space();
        if (*get_pt().add(get_pp() as usize)) != b'(' {
            let start = word();
            let c = (*get_pt().add(start as usize));
            if c == b'-' || (c >= b'0' && c <= b'9') {
                let mut value: i64 = 0;
                let mut i = start;
                let negative = c == b'-';
                if negative {
                    i += 1;
                }
                while i < get_pp() {
                    value = value * 10 + ((*get_pt().add(i as usize)) - b'0') as i64;
                    i += 1;
                }
                return new_pattern(K_LIT, 0, 0, 0, if negative { 0 - value } else { value });
            }
            let var_id = variable(start);
            if rhs && var_id >= get_r_vars_now() {
                rule_error(c"internal error: a rewrite rule's right side has a new variable: ");
            }
            return new_pattern(if c == b'c' { K_CVAR } else { K_VAR }, 0, 0, 0, var_id);
        }
        set_pp(get_pp() + (1));
        let start = word();
        let mut kind = K_OP;
        let mut op: i64 = 0;
        let mut cond: i64 = 0;
        let mut arity: i64 = 2;
        if word_is(start, c"add") { op = Add as i64; }
        else if word_is(start, c"sub") { op = Sub as i64; }
        else if word_is(start, c"mul") { op = Mul as i64; }
        else if word_is(start, c"and") { op = And as i64; }
        else if word_is(start, c"or") { op = Or as i64; }
        else if word_is(start, c"xor") { op = Xor as i64; }
        else if word_is(start, c"shl") { op = Shl as i64; }
        else if word_is(start, c"neg") { op = Neg as i64; arity = 1; }
        else if word_is(start, c"bnot") { op = BNot as i64; arity = 1; }
        else if word_is(start, c"eq") { op = Cmp as i64; cond = Cond::Eq as i64; }
        else if word_is(start, c"ne") { op = Cmp as i64; cond = Cond::Ne as i64; }
        else {
            kind = K_CEXPR;
            if word_is(start, c"+") { op = C_ADD; }
            else if word_is(start, c"-") { op = C_SUB; }
            else if word_is(start, c"*") { op = C_MUL; }
            else if word_is(start, c"&") { op = C_AND; }
            else if word_is(start, c"|") { op = C_OR; }
            else if word_is(start, c"^") { op = C_XOR; }
            else if word_is(start, c"negc") { op = C_NEG; arity = 1; }
            else if word_is(start, c"log2") { op = C_LOG2; arity = 1; }
            else { rule_error(c"internal error: unknown operation in a rewrite rule: "); }
        }
        let a = parse_pattern(rhs);
        let b: i64 = if arity == 2 { parse_pattern(rhs) } else { -1 };
        skip_space();
        if (*get_pt().add(get_pp() as usize)) != b')' {
            rule_error(c"internal error: expected ')' in a rewrite rule: ");
        }
        set_pp(get_pp() + (1));
        let p = new_pattern(kind, op, a, b, 0);
        (get_p_cond()[p as usize]) = cond;
        p
    }
}

static mut R_VARS_NOW: i64 = 0;

// (0.17) The rules whose left side is operation op:
// R_BY_OP[R_BY_OP_START[op] .. R_BY_OP_START[op + 1]], in order
// (egraph_rewrite went through all of them for every instruction).
static mut R_BY_OP: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut R_BY_OP_START: [i64; 65] = [0i64; 65];

pub fn init_rules() {
    if get_rules_ready() {
        return;
    }
    set_rules_ready(true);
    for r in 0..RULE_COUNT {
        set_pt(rule_text(r));
        set_pp(0);
        { let mut pvars_copy = get_pvars(); pvars_copy.clear(); set_pvars(pvars_copy); }
        set_r_vars_now(1000);
        let lhs = parse_pattern(false);
        let mut guard: i64 = -1;
        let at = word();
        if word_is(at, c"if") {
            skip_space();
            set_pp(get_pp() + (1));
            let pred = word();
            if !word_is(pred, c"pow2") {
                rule_error(c"internal error: unknown guard in a rewrite rule: ");
            }
            let v = word();
            guard = variable(v);
            skip_space();
            set_pp(get_pp() + (1));
            let arrow = word();
            if !word_is(arrow, c"=>") {
                rule_error(c"internal error: expected '=>' in a rewrite rule: ");
            }
        } else if !word_is(at, c"=>") {
            rule_error(c"internal error: expected '=>' in a rewrite rule: ");
        }
        set_r_vars_now(get_pvars().len() as i64);
        let rhs = parse_pattern(true);
        if (get_p_kind()[lhs as usize]) != K_OP {
            rule_error(c"internal error: a rewrite rule's left side is not an operation: ");
        }
        { let mut r_lhs_copy = get_r_lhs(); r_lhs_copy.push(lhs); set_r_lhs(r_lhs_copy); }
        { let mut r_rhs_copy = get_r_rhs(); r_rhs_copy.push(rhs); set_r_rhs(r_rhs_copy); }
        { let mut r_guard_copy = get_r_guard(); r_guard_copy.push(guard);
            set_r_guard(r_guard_copy); }
        { let mut r_vars_copy = get_r_vars(); r_vars_copy.push(get_pvars().len() as i64);
            set_r_vars(r_vars_copy); }
    }
    // (0.17) The rules by the operation of their left side, in order.
    for op in 0..64 {
        { let mut r_by_op_start_copy = get_r_by_op_start();
            r_by_op_start_copy[op as usize] = get_r_by_op().len() as i64;
            set_r_by_op_start(r_by_op_start_copy); }
        for r in 0..RULE_COUNT {
            if (get_p_op()[(get_r_lhs()[r as usize]) as usize]) == op {
                { let mut r_by_op_copy = get_r_by_op(); r_by_op_copy.push(r);
                    set_r_by_op(r_by_op_copy); }
            }
        }
    }
    { let mut r_by_op_start_copy = get_r_by_op_start();
        r_by_op_start_copy[64] = get_r_by_op().len() as i64;
        set_r_by_op_start(r_by_op_start_copy); }
}

// ---- E-classes ----
//
// The e-classes are directional, as in Cranelift: when a rule shows
// instruction v equal to w (which dominates v), w and its own members
// join v's class, but v does not join w's (w's other users may not be
// dominated by v). Per value (by id, valid when its stamp is this run's):
// its members (a run in ALTS; none recorded: the value alone) and the
// best cost found for it.

pub fn egraph_start(cx: &mut FnCtx<Comp>) {
    init_rules();
    cx.run += 1;
    cx.alts.clear();
}

fn ec_touch(cx: &mut FnCtx<Comp>, v: i64) {
    while cx.ec_stamp.len() as i64 <= v {
        cx.ec_stamp.push(0);
        cx.ec_start.push(0);
        cx.ec_len.push(0);
        cx.ec_cost.push(0);
    }
    if (cx.ec_stamp[v as usize]) != cx.run {
        (cx.ec_stamp[v as usize]) = cx.run;
        (cx.ec_start[v as usize]) = 0;
        (cx.ec_len[v as usize]) = 0;
        (cx.ec_cost[v as usize]) = 0;
    }
}

fn member_count(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    ec_touch(cx, v);
    if (cx.ec_len[v as usize]) == 0 { 1 } else { (cx.ec_len[v as usize]) }
}

fn member(cx: &mut FnCtx<Comp>, v: i64, i: i64) -> i64 {
    if (cx.ec_len[v as usize]) == 0 { v }
    else { (cx.alts[((cx.ec_start[v as usize]) + i) as usize]) }
}

fn is_member(cx: &mut FnCtx<Comp>, v: i64, w: i64) -> bool {
    let n = member_count(cx, v);
    for i in 0..n {
        if member(cx, v, i) == w {
            return true;
        }
    }
    false
}

// Whether v and w are known equal.
fn same_value(cx: &mut FnCtx<Comp>, v: i64, w: i64) -> bool {
    v == w || is_member(cx, v, w) || is_member(cx, w, v)
}

fn op_cost(op: Op) -> i64 {
    match op {
        Const => 0,
        Mul => 3,
        Op::Div | Op::Rem => 20,
        _ => 1,
    }
}

// The cost of node m: its operation's, with its operands' best.
fn node_cost(cx: &mut FnCtx<Comp>, m: i64) -> i64 {
    unsafe {
        let mut cost = op_cost((cx.insts[m as usize]).op);
        let a = (cx.insts[m as usize]).a;
        let b = (cx.insts[m as usize]).b;
        if a != 0 {
            ec_touch(cx, a);
            cost += (cx.ec_cost[a as usize]);
        }
        if b != 0 {
            ec_touch(cx, b);
            cost += (cx.ec_cost[b as usize]);
        }
        cost
    }
}

// ---- Matching ----

fn undo_to(cx: &mut FnCtx<Comp>, mark: i64) {
    while cx.trail.len() as i64 > mark {
        cx.bind[cx.trail.pop() as usize] = 0;
    }
}

fn bind(cx: &mut FnCtx<Comp>, var_id: i64, v: i64) -> bool {
    if cx.bind[var_id as usize] == 0 {
        cx.bind[var_id as usize] = v;
        cx.trail.push(var_id);
        return true;
    }
    same_value(cx, cx.bind[var_id as usize], v)
}

fn is_commutative_pattern(p: i64) -> bool {
    let op = (get_p_op()[p as usize]);
    op == Add as i64 || op == Mul as i64 || op == And as i64 || op == Or as i64 || op == Xor as i64
        || op == Cmp as i64
}

// Whether pattern p matches value v (of integer type ty): a member of
// v's class, for an operation.
fn pmatch(cx: &mut FnCtx<Comp>, p: i64, v: i64, ty: i64) -> bool {
    unsafe {
        let kind = (get_p_kind()[p as usize]);
        if kind == K_VAR {
            return bind(cx, (get_p_val()[p as usize]), v);
        }
        if kind == K_CVAR || kind == K_LIT {
            let c = const_member(cx, v);
            if c == 0 {
                return false;
            }
            if kind == K_LIT {
                return (cx.insts[c as usize]).imm
                    == wrap_int((get_p_val()[p as usize]), ty);
            }
            return bind(cx, (get_p_val()[p as usize]), c);
        }
        let op = (get_p_op()[p as usize]);
        let is_cmp = op == Cmp as i64;
        let n = member_count(cx, v);
        for k in 0..n {
            let m = member(cx, v, k);
            let mop = (cx.insts[m as usize]).op;
            if mop as i64 == op && (if is_cmp {
                (cx.insts[m as usize]).cond as i64 == (get_p_cond()[p as usize])
                    && (cx.insts[m as usize]).ty == TY_BOOL
            } else {
                (cx.insts[m as usize]).ty == ty
            }) {
                let child_ty = if is_cmp { (cx.insts[m as usize]).imm2 } else { ty };
                if is_integer(child_ty) {
                    let mark = cx.trail.len() as i64;
                    if pmatch(cx, (get_p_a()[p as usize]), (cx.insts[m as usize]).a,
                        child_ty)
                        && ((get_p_b()[p as usize]) < 0
                            || pmatch(cx, (get_p_b()[p as usize]),
                                (cx.insts[m as usize]).b, child_ty)) {
                        return true;
                    }
                    undo_to(cx, mark);
                    if (get_p_b()[p as usize]) >= 0 && is_commutative_pattern(p) {
                        if pmatch(cx, (get_p_a()[p as usize]),
                            (cx.insts[m as usize]).b, child_ty)
                            && pmatch(cx, (get_p_b()[p as usize]),
                                (cx.insts[m as usize]).a, child_ty) {
                            return true;
                        }
                        undo_to(cx, mark);
                    }
                }
            }
        }
        false
    }
}

// A constant member of v's class, or 0.
fn const_member(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let n = member_count(cx, v);
    for k in 0..n {
        let m = member(cx, v, k);
        if unsafe { (cx.insts[m as usize]).op == Const } {
            return m;
        }
    }
    0
}

// ---- Building right-hand sides ----

// (0.17) The constant `x <op> y`, folded as the instruction ir_make would
// build for it (0.29: by its fields; before, through a scratch instruction
// one past the function's last).
fn fold2(cx: &mut FnCtx<Comp>, op: Op, ty: i64, x: i64, y: i64) -> i64 {
    fold_fields(op, Cond::Eq, ty, 0, 0, x, y)
}

// The value of constant expression p (of type ty), with BIND's constants.
fn const_value_of(cx: *mut FnCtx<Comp>, p: i64, ty: i64, consts: *mut i64) -> i64 {
    unsafe {
        let kind = (get_p_kind()[p as usize]);
        if kind == K_LIT {
            return wrap_int((get_p_val()[p as usize]), ty);
        }
        if kind == K_CVAR {
            return (*consts.add((get_p_val()[p as usize]) as usize));
        }
        let x = const_value_of(cx, (get_p_a()[p as usize]), ty, consts);
        let op = (get_p_op()[p as usize]);
        if op == C_NEG {
            return fold2(&mut *cx, Neg, ty, x, 0);
        }
        if op == C_LOG2 {
            return log2(x);
        }
        let y = const_value_of(cx, (get_p_b()[p as usize]), ty, consts);
        let fop = if op == C_ADD { Add } else if op == C_SUB { Sub } else if op == C_MUL { Mul }
            else if op == C_AND { And } else if op == C_OR { Or } else { Xor };
        fold2(&mut *cx, fop, ty, x, y)
    }
}

// A node (op, ty, a, b) before instruction `at`: an equal one the table
// knows, or a new one.
fn make_node(mut cx: *mut FnCtx<Comp>, at: i64, op: Op, cond: i64, ty: i64, operand_ty: i64, a: i64,
    b: i64, imm: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let n = ir_make(&mut *cx, op, ty, a, b, imm, pcx);
        if op == Cmp {
            (cx.insts[n as usize]).cond = if cond == Cond::Ne as i64 { Cond::Ne }
                else { Cond::Eq };
            (cx.insts[n as usize]).imm2 = operand_ty;
        }
        if b != 0 && is_commutative_op(&mut *cx, n) && operands_out_of_order(&mut *cx, a, b) {
            (cx.insts[n as usize]).a = b;
            (cx.insts[n as usize]).b = a;
        }
        ir_insert_before(&mut *cx, at, n);
        let w = gvn_find_or_add(&mut *cx, n);
        if w != 0 {
            ir_replace(&mut *cx, n, w);
            return w;
        }
        ec_touch(&mut *cx, n);
        (cx.ec_cost[n as usize]) = node_cost(&mut *cx, n);
        n
    }
}

fn build(cx: &mut FnCtx<Comp>, at: i64, p: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    let kind = (get_p_kind()[p as usize]);
    if kind == K_VAR || kind == K_CVAR {
        return cx.bind[(get_p_val()[p as usize]) as usize];
    }
    if kind == K_LIT || kind == K_CEXPR {
        return make_node(cx, at, Const, 0, ty, 0, 0, 0,
            const_value_of(cx, p, ty, cx.consts.as_mut_ptr() as *mut i64), pcx);
    }
    let op = (get_p_op()[p as usize]);
    let is_cmp = op == Cmp as i64;
    let child_ty = if is_cmp { cx.build_cmp_ty } else { ty };
    let a = build(cx, at, (get_p_a()[p as usize]), child_ty, pcx);
    let b: i64 = if (get_p_b()[p as usize])
        >= 0 { build(cx, at, (get_p_b()[p as usize]), child_ty, pcx) } else { 0 };
    let iop = op_of(op);
    make_node(cx, at, iop, (get_p_cond()[p as usize]),
        if is_cmp { TY_BOOL } else { ty }, child_ty, a, b, 0, pcx)
}

fn op_of(op: i64) -> Op {
    if op == Add as i64 { return Add; }
    if op == Sub as i64 { return Sub; }
    if op == Mul as i64 { return Mul; }
    if op == And as i64 { return And; }
    if op == Or as i64 { return Or; }
    if op == Xor as i64 { return Xor; }
    if op == Shl as i64 { return Shl; }
    if op == Neg as i64 { return Neg; }
    if op == BNot as i64 { return BNot; }
    Cmp
}

fn is_pow2(x: i64) -> bool {
    x > 0 && (x & (x - 1)) == 0
}

// The rules on instruction v (new to GVN's table, its operands resolved):
// returns the value standing for it (v itself, or a cheaper equal one).
pub fn egraph_rewrite(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        let is_cmp = op == Cmp;
        let ty = (cx.insts[v as usize]).ty;
        let operand_ty = if is_cmp { (cx.insts[v as usize]).imm2 } else { ty };
        ec_touch(cx, v);
        (cx.ec_cost[v as usize]) = node_cost(cx, v);
        if !is_integer(operand_ty)
            || (is_cmp && (cx.insts[v as usize]).cond != Cond::Eq
                && (cx.insts[v as usize]).cond != Cond::Ne) {
            return v;
        }
        cx.found.clear();
        cx.found.push(v);
        let o = op as i64;
        if o >= 64 {
            return v;
        }
        for ri in get_r_by_op_start()[o as usize]..get_r_by_op_start()[(o + 1) as usize] {
            let r = (get_r_by_op()[ri as usize]);
            let lhs = (get_r_lhs()[r as usize]);
            for i in 0..8 {
                cx.bind[i as usize] = 0;
            }
            cx.trail.clear();
            if !pmatch(cx, lhs, v, ty) {
                continue;
            }
            // The constants bound, as values of their type.
            for i in 0..(get_r_vars()[r as usize]) {
                cx.consts[i as usize] = if cx.bind[i as usize] != 0
                    && (cx.insts[cx.bind[i as usize] as usize]).op
                    == Const { (cx.insts[cx.bind[i as usize] as usize]).imm }
                    else { 0 };
            }
            let guard = (get_r_guard()[r as usize]);
            if guard >= 0 && !is_pow2(cx.consts[guard as usize]) {
                continue;
            }
            cx.build_cmp_ty = operand_ty;
            let w = build(cx, v, (get_r_rhs()[r as usize]), ty, pcx);
            if (cx.insts[w as usize]).ty != ty {
                continue;
            }
            // w and its members join v's class.
            let n = member_count(cx, w);
            for k in 0..n {
                let m = member(cx, w, k);
                let mut known = false;
                for j in 0..cx.found.len() as i64 {
                    if (cx.found[j as usize]) == m {
                        known = true;
                    }
                }
                if !known {
                    cx.found.push(m);
                }
            }
        }
        if cx.found.len() as i64 == 1 {
            return v;
        }
        (cx.ec_start[v as usize]) = cx.alts.len() as i64;
        (cx.ec_len[v as usize]) = cx.found.len() as i64;
        for j in 0..cx.found.len() as i64 {
            cx.alts.push((cx.found[j as usize]));
        }
        // Extraction: the cheapest member (v on a tie).
        let mut best = v;
        let mut best_cost = (cx.ec_cost[v as usize]);
        for j in 1..cx.found.len() as i64 {
            let m = (cx.found[j as usize]);
            ec_touch(cx, m);
            if (cx.ec_cost[m as usize]) < best_cost {
                best = m;
                best_cost = (cx.ec_cost[m as usize]);
            }
        }
        (cx.ec_cost[v as usize]) = best_cost;
        best
    }
}

// ---- Checking the rules (volec --check-rules) ----

fn rand64(pcx: &mut Ctx<Comp>) -> i64 {
    pcx.rng = pcx.rng ^ (pcx.rng << 13);
    pcx.rng = pcx.rng ^ (pcx.rng >> 7);
    pcx.rng = pcx.rng ^ (pcx.rng << 17);
    pcx.rng as i64
}

// A random value of type ty: often small, or at an edge.
fn random_value(ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let k = rand64(pcx) & 7;
    let raw: i64 = if k == 0 {
        0
    } else if k == 1 {
        -1
    } else if k == 2 {
        1
    } else if k == 3 {
        (rand64(pcx) & 15) - 8
    } else if k == 4 {
        1 << ((rand64(pcx) & 63) as u64)
    } else if k == 5 {
        (1i64 << ((rand64(pcx) & 63) as u64)).wrapping_sub(1)
    } else {
        rand64(pcx)
    };
    wrap_int(raw, ty)
}

// Pattern p evaluated with EVAL_VARS (integers of type ty; comparisons as
// 0 or 1).
fn eval_pattern(cx: &mut FnCtx<Comp>, p: i64, ty: i64, cmp_ty: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let kind = (get_p_kind()[p as usize]);
    if kind == K_VAR || kind == K_CVAR {
        return pcx.eval_vars[(get_p_val()[p as usize]) as usize];
    }
    if kind == K_LIT || kind == K_CEXPR {
        return const_value_of(cx, p, ty, pcx.eval_vars.as_mut_ptr() as *mut i64);
    }
    let op = (get_p_op()[p as usize]);
    if op == Cmp as i64 {
        let x = eval_pattern(cx, (get_p_a()[p as usize]), cmp_ty, cmp_ty, pcx);
        let y = eval_pattern(cx, (get_p_b()[p as usize]), cmp_ty, cmp_ty, pcx);
        let cond = if (get_p_cond()[p as usize]) == Cond::Ne as i64 { Cond::Ne }
            else { Cond::Eq };
        return fold_compare(cond, cmp_ty, x, y) as i64;
    }
    let x = eval_pattern(cx, (get_p_a()[p as usize]), ty, cmp_ty, pcx);
    let y: i64 = if (get_p_b()[p as usize])
        >= 0 { eval_pattern(cx, (get_p_b()[p as usize]), ty, cmp_ty, pcx) }
        else { 0 };
    fold2(cx, op_of(op), ty, x, y)
}

// Checks every rule on random values at every integer width; prints a
// line per failure and a summary; returns the number of failures.
pub fn check_rules(cx: &mut FnCtx<Comp>, trials: i64, pcx: &mut Ctx<Comp>) -> i64 {
    init_rules();
    let types: [i64; 8] = [TY_I8, TY_I16, TY_I32, TY_I64, TY_U8, TY_U16, TY_U32, TY_U64];
    let out = buf_new();
    let mut failures: i64 = 0;
    let mut checked: i64 = 0;
    for r in 0..RULE_COUNT {
        let lhs = (get_r_lhs()[r as usize]);
        let is_cmp = (get_p_op()[lhs as usize]) == Cmp as i64;
        for t in 0..8 {
            let ty = types[t as usize];
            let value_ty = if is_cmp { TY_BOOL } else { ty };
            let mut failed = false;
            for _ in 0..trials {
                for i in 0..(get_r_vars()[r as usize]) {
                    pcx.eval_vars[i as usize] = random_value(ty, pcx);
                }
                let guard = (get_r_guard()[r as usize]);
                if guard >= 0 && !is_pow2(pcx.eval_vars[guard as usize]) {
                    pcx.eval_vars[guard as usize] = wrap_int(1 << ((rand64(pcx) & 7) as u64),
                        ty);
                    if !is_pow2(pcx.eval_vars[guard as usize]) {
                        continue;
                    }
                }
                checked += 1;
                let left = eval_pattern(cx, lhs, value_ty, ty, pcx);
                let right = eval_pattern(cx, (get_r_rhs()[r as usize]), value_ty, ty,
                    pcx);
                if left != right && !failed {
                    failed = true;
                    failures += 1;
                    buf_str(out, c"rule failed: ");
                    buf_str(out, rule_text(r));
                    buf_str(out, c" (type ");
                    buf_int(out, t);
                    buf_str(out, c", variables");
                    for i in 0..(get_r_vars()[r as usize]) {
                        buf_byte(out, b' ');
                        buf_int(out, pcx.eval_vars[i as usize]);
                    }
                    buf_str(out, c": ");
                    buf_int(out, left);
                    buf_str(out, c" vs ");
                    buf_int(out, right);
                    buf_str(out, c")\n");
                }
            }
        }
    }
    buf_str(out, c"rewrite rules: ");
    buf_int(out, RULE_COUNT);
    buf_str(out, c" rules, ");
    buf_int(out, checked);
    buf_str(out, c" checks, ");
    buf_int(out, failures);
    buf_str(out, c" failed\n");
    buf_write_fd(out, STDOUT);
    failures
}

// (0.28.0) P_KIND's accessors: every use of it is one of them.
fn get_p_kind() -> IntVec {
    // UNSAFE: the e-graph's rewrite rules (parsed once), a process-wide
    // static mut the tasks read; Rust has no safe access to a static mut
    // SAFETY: written only inside init_rules after its RULES_READY test
    // (RULES_READY = true, then the parse; the parser fns parse_pattern,
    // new_pattern, variable, word, skip_space are called only from
    // init_rules and each other), so only by init_rules' first call, which
    // is the main thread's: check_rules in build or prepare_tasks in
    // parallel_begin, before pool_start's pthread_create; a task's
    // init_rules (egraph_start <- run_gvn) then only reads RULES_READY and
    // returns, and the rewriter only reads the tables; the assembler thread
    // never reaches the egraph
    unsafe { P_KIND }
}

fn set_p_kind(v: IntVec) {
    // UNSAFE: the e-graph's rewrite rules (parsed once), a process-wide
    // static mut the tasks read; Rust has no safe access to a static mut
    // SAFETY: written only inside init_rules after its RULES_READY test
    // (RULES_READY = true, then the parse; the parser fns parse_pattern,
    // new_pattern, variable, word, skip_space are called only from
    // init_rules and each other), so only by init_rules' first call, which
    // is the main thread's: check_rules in build or prepare_tasks in
    // parallel_begin, before pool_start's pthread_create; a task's
    // init_rules (egraph_start <- run_gvn) then only reads RULES_READY and
    // returns, and the rewriter only reads the tables; the assembler thread
    // never reaches the egraph
    unsafe {
        P_KIND = v;
    }
}

