        cx.task_phase = 0;
        cx.task_rank = 0;
        cx.cur_comp = -1;
        std::ptr::write(&mut cx.comp_dec, Vec::new_in(Comp {}));
        cx.comp_growth = 0;
        cx.vec_loops = 0;
        cx.v_why = 0 as *mut u8;
        cx.v_why_inst = 0;
        cx.v_unroll = 0;
        cx.vec_tests = 0;
        cx.vec_skipped = 0;
        std::ptr::write(&mut cx.inl_bmap, Vec::new_in(Comp {}));
        std::ptr::write(&mut cx.inl_imap, Vec::new_in(Comp {}));
        cx.scratch_buf = -1;
        cx.cc = 0 as *mut CcCtx;
        std::ptr::write(&mut cx.text_rtids, Vec::new_in(Comp {}));
        cx
    }
}

// A new context: its fields at the statics' initial values, and buffers
// of its own (serial code only: buf_new grows the program's table).
pub fn fnctx_new() -> *mut FnCtx<Comp> {
    unsafe {
        let cx = fnctx_fields();
        cx.code = buf_new();
        cx.asm = buf_new();
        cx.scratch_buf = buf_new();
        cx
    }
}

// (testing, middle::parallel) A new context with cx's buffers and scratch
// text: one per task, made while other tasks run (so without buf_new).
pub fn fnctx_new_with(cx: &mut FnCtx<Comp>) -> *mut FnCtx<Comp> {
    unsafe {
        let code = cx.code;
        let asm = cx.asm;
        let scratch = cx.scratch_buf;
        let n = fnctx_fields();
        n.code = code;
        n.asm = asm;
        n.scratch_buf = scratch;
        // (the code cache's state, which each task begins anew)
        n.cc = cx.cc;
        n
    }
}

pub fn main_cx(pcx: &mut Ctx<Comp>) -> *mut FnCtx<Comp> {
    if pcx.main_cx == 0 as *mut FnCtx<Comp> {
        pcx.main_cx = fnctx_new();
    }
    pcx.main_cx
}
