        std::ptr::write(&mut cx.lp_blocks, Vec::new_in(Comp {}));
        std::ptr::write(&mut cx.lp_of, Vec::new_in(Comp {}));
        cx.lp_nblocks = 0;
        std::ptr::write(&mut cx.lp_seen, Vec::new_in(Comp {}));
        cx.lp_stamp = 0;
        std::ptr::write(&mut cx.lp_list, Vec::new_in(Comp {}));
        std::ptr::write(&mut cx.lp_list2, Vec::new_in(Comp {}));
        std::ptr::write(&mut cx.lp_values, Vec::new_in(Comp {}));
        std::ptr::write(&mut cx.rotated, Vec::new_in(Comp {}));
        std::ptr::write(&mut cx.copies_uses, Vec::new_in(Comp {}));
