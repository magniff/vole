// volec: the vole compiler, written in vole. This file is the root
// of its module tree and the driver; the modules are in a folder per phase
// (see compiler/README.md): tokens -> AST -> modules and names -> checked
// AST -> -O0's code generator, or (-O1, -O2) SSA IR -> the optimizer ->
// instruction selection -> register allocation -> assembly.
//
// The command line:
//
//   volec [--target T] [-O0|-O1|-O2] <file.vl>... [-o out.s]
//                                   compile the files (one program) to
//                                   assembly for target T (default: the
//                                   host): aarch64-macos, aarch64-linux,
//                                   x86_64-linux or x86_64-macos, at an
//                                   optimization level
//                                   (default -O2; see docs/optimizer.md)
//   --emit-ir                       write the optimized IR instead
//   --verify-ir                     check the IR after every pass
//   --print-after-all               print the IR after every pass (stderr)
//   --print-attrs                   print the inferred function
//                                   attributes (-O2, stderr)
//   --time-passes                   print the CPU time of each phase
//                                   (stderr)
//   -g                              debug information: DWARF line tables
//                                   (0.11; see dwarf.vl)
//   --emit-imports                  write what `import`ed C headers declare
//                                   (as vole source) instead
//   --emit-header                   write the program's C header instead
//   -I DIR                          a directory for `import`ed C headers
//   --no-vectorize                  no loop vectorization (0.10: to
//                                   compare)
//   --no-unroll-runtime             no unrolling of loops whose trip count
//                                   is known at run time only (0.11: to
//                                   compare)
//   --no-slp                        no SLP vectorization (0.11: to compare)
//   --no-ifconv                     no if-conversion in loops (0.15: to
//                                   compare)
//   --profile-generate FILE         instrument the program: it writes its
//                                   blocks' counts to FILE at exit (0.10)
//   --profile-use FILE              optimize with the counts of FILE (0.10)
//   --check-unsafe                  check unsafe code's raw-pointer accesses
//                                   against the heap blocks at run time (0.10)
//   --no-egraph                     no rewrite rules in GVN (0.9: to
//                                   compare)
//   volec --check-rules          check the rewrite rules on random
//                                   values (0.9)
//   --deny-warnings                 make warnings errors (0.9)
//   --diagnostics=short             one line per error or warning:
//                                   `file:line:col: error[kind] message |
//                                   help: ...` (0.11; =human: the default)
//   volec --fix-unsafe <root.vl>
//                                   wrap the unsafe operations outside
//                                   `unsafe` in unsafe blocks, in place
//                                   (0.11: `fix --only unsafe`)
//   volec --fix-imports <root.vl>
//                                   rewrite 0.7's imports, in place (0.11:
//                                   `fix --only imports`)
//   volec query def|show|refs|callers|items|stats|deps|unused|impact ...
//                                   questions about a program, from the
//                                   front end (0.11; query.vl,
//                                   plan.vl, docs/query.md)
//   volec edit patch|replace|insert|delete|wrap|new-file NAME ..., volec undo
//                                   change a program by name, atomically
//                                   (0.11; edit.vl, docs/refactor.md)
//   volec check [ROOT]           the front end's errors, one per line
//   volec fix [ROOT]             every machine-applicable fix (fix.vl)
//   volec lint --max-lines N     the files over N lines
//   volec guide [TOPIC|--list]   the language guide (0.13; guide/,
//                                   compiler/guide/)
//   volec same-output OLD        OLD's output and this compiler's, on a
//                                   corpus (sameout.vl)
//   volec --tokens <file.vl>   print the tokens of one file
//   volec lsp                    the language server: LSP over stdin
//                                   and stdout (0.24; tools/lsp/, docs/lsp.md)
//   volec --version              print the release and the host target

// Basics: the C library, arrays, buffers, symbols, files, errors, timers.
mod base;
// The front end: tokens, C imports and headers, std, the AST, modules,
// types, the checker.
mod front;
// The middle end (-O1, -O2): the IR, lowering to SSA, the passes.
mod middle;
// The back end: instruction selection, register allocation, emission,
// machine code, object files.
mod back;
// -O0's code generator and its target interface.
mod gen0;
// The tools on the front end (0.11): query, edit, refactor, fix, same-output.
mod tools;
// The language guide for newcomers (0.13): `volec guide`.
mod guide;
// CPU intrinsics and target features (0.19): std::arch, its tables.
mod arch;
// The command line on std::cli (0.25): a build's options, the layer on argv.
mod cli;

// The standard library, named here in the root: 0.5.0, which builds this
// compiler, reads std only when the files of the command line name it.

use crate::arch::ARCH_USED;
use crate::arch::features::build_features;
use crate::back::codecache::cc_args;
use crate::back::dwarf::DEBUG_INFO;
use crate::back::objfile::{OUTPUT_MODE, OUT_EXECUTABLE, output_mode_of};
use crate::back::objfile::output::link_args_given;
use crate::base::{
    FILES, FILE_COUNT, STDERR, STDOUT, alloc_zeroed, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, die, die2, load_sources, streq,
};
use crate::base::diag::{DIAG_PROG, DIAG_SHORT, ERRORS_AS_DUMP, ERR_KIND, ok_line_setup, print_ok};
use crate::base::json::DIAG_JSON;
use crate::base::target::{
    T_AARCH64_LINUX, T_AARCH64_MACOS, T_X86_64_LINUX, T_X86_64_MACOS, set_target, target_is_linux,
    target_name,
};
use crate::base::timer::{T_LOAD, timer_add, timer_now};
use crate::cli::build::usage;
use crate::front::cheader::EMIT_HEADER;
use crate::front::cimport::import_c_headers;
use crate::front::effects::{EFFECTS_WANTED, PRINT_EFFECTS};
use crate::front::lexer::{dump_tokens, init_lexer, lex_range};
use crate::front::modules::load_modules;
use crate::front::own::{is_values_option, values_option};
use crate::front::stdalloc::{CHECK_ALLOC_LINUX, CHECK_ALLOC_MODE};
use crate::gen0::gen::{EMIT_IR, EMIT_MIR, compile_program};
use crate::middle::ctx::main_cx;
use crate::middle::effects_verify::VERIFY_EFFECTS;
use crate::middle::egraph::check_rules;
use crate::middle::ir::{IR_CALL_LOCS, IR_LOCS};
use crate::middle::opt::OPT_LEVEL;
use crate::middle::parallel::{phase_time, vec_stat};
use crate::middle::profile::{PROFILE_GENERATE, PROFILE_USE};
use crate::middle::trace::TRACE;
use crate::middle::unsafecheck::CHECK_UNSAFE;
use crate::tools::batch::run_batch;
use crate::tools::commands::run_command;
use crate::tools::fix::command::run_fix_alias;
use crate::tools::help::{is_help, run_help};

extern "C" {
    fn uname(info: *u8) -> i32;
    fn isatty(fd: i32) -> i32;
}

// The release this source is; see docs/releases.md.
pub fn version() -> *u8 {
    c"0.24.0"
}

// struct utsname: sysname is the first field on every system; machine is
// the fifth, and the fields are 256 bytes long on macOS, 65 on Linux.
const UTSNAME_SIZE: i64 = 2048;
const MACOS_UTS_FIELD: i64 = 256;
const LINUX_UTS_FIELD: i64 = 65;

// The target of the machine this compiler runs on, or 0 when it has no
// backend for it.
pub fn host_target() -> i64 {
    unsafe {
        let info = alloc_zeroed(UTSNAME_SIZE);
        if uname(info) != 0 {
            return 0;
        }
        var field = 0;
        if streq(info, c"Darwin") {
            field = MACOS_UTS_FIELD;
        } else if streq(info, c"Linux") {
            field = LINUX_UTS_FIELD;
        } else {
            return 0;
        }
        let machine = &info[4 * field];
        let x86 = streq(machine, c"x86_64");
        if field == MACOS_UTS_FIELD {
            if streq(machine, c"arm64") {
                return T_AARCH64_MACOS;
            }
            return if x86 { T_X86_64_MACOS } else { 0 };
        }
        if x86 { T_X86_64_LINUX } else if streq(machine, c"aarch64") { T_AARCH64_LINUX } else { 0 }
    }
}

fn print_version() {
    unsafe {
        let out = buf_new();
        buf_str(out, c"volec ");
        buf_str(out, version());
        let host = host_target();
        buf_str(out, c" (host: ");
        buf_str(out, if host == 0 { c"unsupported" } else { target_name(host) });
        buf_str(out, c")\n");
        buf_write_fd(out, STDOUT);
    }
}

fn main(argc: i32, argv: **u8, gpa: Gpa) -> i32 {
    unsafe {
        // (0.15) `--json`, anywhere: diagnostics and output as JSON lines
        // (base::diag::DIAG_JSON), for every command; taken out of argv.
        DIAG_PROG = argv[0];
        // (0.21) VOLE_X read as VOLE_X, and winning
        crate::base::env_aliases();
        ok_line_setup();
        // (0.20: a migration's children read the program as it does)
        crate::front::conv::syntax_from_env();
        var argc = argc;
        var k = 1;
        while k < argc as i64 {
            // (0.17: --values=off|report|warn|error, front/own, for every
            // command that checks)
            // (0.20: --syntax=0.20|mixed, front/conv: the spelling read)
            let values = values_option(argv[k]) || crate::front::conv::syntax_option(argv[k]);
            // (`fix --values`, the migration: the fix\x27s own option)
            let fix_values = streq(argv[k], c"--values") && argc >= 2 && streq(argv[1], c"fix");
            if !values && !fix_values && is_values_option(argv[k]) {
                die2(c"unknown option (expected --values=off, report, warn or error): ", argv[k]);
            }
            if streq(argv[k], c"--json") || values {
                if !values {
                    DIAG_JSON = true;
                }
                for m in k..argc as i64 - 1 {
                    argv[m] = argv[m + 1];
                }
                argc -= 1;
            } else {
                k += 1;
            }
        }
        // (0.15: `--help` on every command, tools/help.vl; guide and
        // `query --help` have their own)
        if argc >= 2 && (is_help(argv[1]) || streq(argv[1], c"help")) {
            return run_help(argc as i64, argv) as i32;
        }
        for k in 2..argc as i64 {
            if is_help(argv[k]) && !streq(argv[1], c"guide")
                && !(k == 2 && streq(argv[1], c"query")) {
                return run_help(argc as i64, argv) as i32;
            }
        }
        // The tools (0.11): query, edit, undo, check, fix, the refactorings
        // ... (commands.vl); 0.15: several in one call, batch.
        let status = run_command(argc as i64, argv, gpa);
        if status >= 0 {
            return status as i32;
        }
        if argc >= 2 && streq(argv[1], c"batch") {
            return run_batch(argc as i64, argv, gpa) as i32;
        }
        // (0.8's --fix-imports and 0.9's --fix-unsafe: `fix --only`)
        for k in 1..argc as i64 {
            if streq(argv[k], c"--fix-imports") {
                return run_fix_alias(argc as i64, argv, 1, gpa) as i32;
            }
            if streq(argv[k], c"--fix-unsafe") {
                return run_fix_alias(argc as i64, argv, 8, gpa) as i32;
            }
        }
        // (0.15) A build prints its errors as `check` does, one per line,
        // when stderr is not a terminal (an agent, a script, a pipe);
        // `--diagnostics=human` or `=short` says which.
        DIAG_SHORT = isatty(STDERR) == 0;
        // (0.18.1: the options, for the code cache's key, back::codecache)
        cc_args(argc as i64, argv);
        // (0.25: the options, on std::cli: cli/build.vl)
        let build = crate::cli::build::read_build(argc as i64, argv, gpa);
        if build.instead == 2 {
            return if check_rules(main_cx(), 2000) == 0 { 0 } else { 1 };
        }
        if build.instead == 1 {
            print_version();
            return 0;
        }
        let inputs = build.inputs;
        var output = build.output;
        let output_given = build.output_given;
        let tokens_only = build.tokens_only;
        var target = build.target;
        let include_dirs = build.include_dirs;
        let emit_imports = build.emit_imports;
        let vec_stats = build.vec_stats;
        if inputs.count == 0 {
            usage();
        }
        // (0.18.1) --emit-ir and --emit-mir without -o print to stdout ("-";
        // gen0::gen::write_dump): agents in the 0.18 eval looked for the IR
        // on stdout and found a.o next to the source.
        if (EMIT_IR || EMIT_MIR) && !output_given {
            output = c"-";
        }
        if PROFILE_GENERATE != 0 as *u8 && OPT_LEVEL == 0 {
            die(c"--profile-generate needs -O1 or -O2");
        }
        if CHECK_UNSAFE && OPT_LEVEL == 0 {
            die(c"--check-unsafe needs -O1 or -O2");
        }
        // (-O0's generator has no frames to trace: --trace builds at -O1)
        if TRACE && OPT_LEVEL == 0 {
            OPT_LEVEL = 1;
        }
        IR_LOCS = DEBUG_INFO || TRACE;
        IR_CALL_LOCS = TRACE;
        // (-O0 optimizes nothing: a profile changes nothing there.)
        if OPT_LEVEL == 0 {
            PROFILE_USE = 0 as *u8;
        }
        // (0.16: the optimizer, --verify-effects, --print-effects and
        // --check-alloc read the effects; else only a program declaring
        // some needs them, front::effects::check::effects_declared)
        EFFECTS_WANTED = OPT_LEVEL > 0 || EMIT_IR || EMIT_MIR || VERIFY_EFFECTS || PRINT_EFFECTS
            || CHECK_ALLOC_MODE;
        // (0.25) --time-passes and VOLE_PHASE_TIMES count from here: reading,
        // lexing, the modules and the C imports, before compile_program.
        let t_load = timer_now();
        phase_time(0 as *u8);
        ERR_KIND = c"tokenizer error";
        load_sources(inputs.data as **u8, inputs.count);
        ERRORS_AS_DUMP = tokens_only;
        init_lexer();
        let user_files = FILE_COUNT;
        for f in 0..user_files {
            lex_range(FILES[f].start, FILES[f].end, tokens_only && f + 1 == user_files);
        }
        // (the checking Gpa's system constants, part of std's text)
        CHECK_ALLOC_LINUX = target_is_linux(if target == 0 { host_target() } else { target });
        // (0.19: std's sections of the target's detection, stdsections.vl)
        set_target(if target == 0 { host_target() } else { target });
        if !tokens_only {
            ERR_KIND = c"module error";
            load_modules();
            ERR_KIND = c"tokenizer error";
        }
        if tokens_only {
            let out = buf_new();
            dump_tokens(out, FILES[0].start);
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if target == 0 {
            target = host_target();
            if target == 0 {
                die(c"no backend for this host; pass --target aarch64-macos, aarch64-linux, x86_64-linux or x86_64-macos");
            }
        }
        set_target(target);
        // (0.19: -C's errors, once the target is known)
        if ARCH_USED {
            build_features();
        }
        if OUTPUT_MODE < 0 {
            OUTPUT_MODE = output_mode_of(output);
        }
        if link_args_given() && OUTPUT_MODE != OUT_EXECUTABLE && !EMIT_HEADER {
            die(c"-l, -L, objects, archives and C files are for the link: name an executable (-o prog), not an object (.o, -c) or assembly (.s, -S)");
        }
        import_c_headers(target, include_dirs, emit_imports, output);
        lex_range(FILES[FILE_COUNT - 1].end, FILES[FILE_COUNT - 1].end, true);
        timer_add(T_LOAD, t_load);
        phase_time(c"read, lex and modules");
        compile_program(main_cx(), output);
        // (0.18.1) the success line: `ok: built prog` (base::diag::print_ok)
        let done = buf_new();
        buf_str(done,
            if OUTPUT_MODE == OUT_EXECUTABLE && !EMIT_HEADER && !EMIT_IR && !EMIT_MIR { c"built " }
            else { c"wrote " });
        buf_str(done, output);
        if !streq(output, c"-") {
            print_ok(buf_slice(done));
        }
        if vec_stats {
            let b = buf_new();
            buf_str(b, c"vector loops ");
            buf_int(b, vec_stat(0));
            buf_str(b, c", overlap tests ");
            buf_int(b, vec_stat(1));
            buf_str(b, c", tests dropped by noalias ");
            buf_int(b, vec_stat(2));
            buf_str(b, c"\n");
            buf_write_fd(b, STDERR);
        }
        0
    }
}
