// UNSAFE: C's uname, the system and machine this compiler runs on.
// SAFETY: <sys/utsname.h>'s prototype; it fills a struct utsname, which
// host_target gives it room for.
extern "C" {
    fn uname(info: *mut u8) -> i32;
}

// The release this source is; see docs/releases.md.
pub fn version() -> *mut u8 {
    c"0.28.0"
}

// struct utsname: sysname is the first field on every system; machine is
// the fifth, and the fields are 256 bytes long on macOS, 65 on Linux.
const UTSNAME_SIZE: i64 = 2048;
const MACOS_UTS_FIELD: i64 = 256;
const LINUX_UTS_FIELD: i64 = 65;

// The target of the machine this compiler runs on, or 0 when it has no
// backend for it.
pub fn host_target() -> i64 {
    let info = alloc_zeroed(UTSNAME_SIZE);
    // UNSAFE: uname is C's, given a raw block
    // SAFETY: info is a block of UTSNAME_SIZE zero bytes, more than a
    // struct utsname on macOS (5 fields of 256 bytes) and on Linux (6
    // of 65): uname writes only inside it, each field NUL-terminated
    if unsafe { uname(info) } != 0 {
        return 0;
    }
    let mut field: i64 = 0;
    if streq(info, c"Darwin") {
        field = MACOS_UTS_FIELD;
    } else if streq(info, c"Linux") {
        field = LINUX_UTS_FIELD;
    } else {
        return 0;
    }
    // UNSAFE: the address of the struct's fifth field
    // SAFETY: 4 * field is at most 1024, inside the block of
    // UTSNAME_SIZE (2048) bytes; the bytes from there are a
    // NUL-terminated string that uname wrote, or zeros
    let machine = unsafe { info.add((4 * field) as usize) };
    let x86 = streq(machine, c"x86_64");
    if field == MACOS_UTS_FIELD {
        if streq(machine, c"arm64") {
            return T_AARCH64_MACOS;
        }
        return if x86 { T_X86_64_MACOS } else { 0 };
    }
    if x86 { T_X86_64_LINUX } else if streq(machine, c"aarch64") { T_AARCH64_LINUX } else { 0 }
}

fn print_version() {
    let out = buf_new();
    buf_str(out, c"volec ");
    buf_str(out, version());
    let host = host_target();
    buf_str(out, c" (host: ");
    buf_str(out, if host == 0 { c"unsupported" } else { target_name(host) });
    buf_str(out, c")\n");
    buf_write_fd(out, STDOUT);
}

fn main(gpa: Gpa) -> i32 {
    let mut wgx = WgslCx { arena: Arena::new_in(gpa) };
    let mut pcx = ctx_new();
    let mut tcx = tcx_new();
    // (0.25.2) The command line: std::env's arguments, each a word (one
    // that is not UTF-8 is refused: a path, an option, a NAME are text).
    let mut given: Vec<&str, Gpa> = Vec::new_in(gpa);
    for a in env::args_os() {
        match str::from_utf8(a) {
            Ok(s) => given.push(s),
            Err(_) => die(c"an argument is not UTF-8 (volec reads its command line as text)"),
        }
    }
    pcx.diag_prog = c_of(given[0]);
    // (0.21) VOLE_X read as VOLE_X, and winning
    crate::base::env_aliases();
    ok_line_setup(&mut pcx);
    // (0.25.5) $VOLE_STD_TREE: where std's files are (front/stdtree.vl)
    crate::front::stdtree::std_tree_env(gpa, &mut pcx);
    // (0.26.0) the arena `embed wgsl` blocks are checked on (front/embed)
    crate::front::embed::wgsl::wgsl_init(gpa, &mut wgx);
    // (0.20: a migration's children read the program as it does)
    crate::front::conv::syntax_from_env(&mut pcx);
    // (0.15) `--json`, anywhere: diagnostics and output as JSON lines
    // (base::diag::DIAG_JSON), for every command; taken out of the line.
    // (0.25.2: these are read before the Command tree, cli/tree.vl: they
    // act before any command reads its line, help, a batch's lines and the
    // code cache's key, with their own messages; docs/design/cli.md)
    let mut words: Vec<&str, Gpa> = Vec::new_in(gpa);
    words.push(given[0]);
    // (0.25.3) `--color=auto|always|never`, for every command, but not
    // after `--` (a program's own arguments): base::term.
    let mut color = COLOR_AUTO;
    let mut dashes = false;
    for k in 1..given.len() {
        let w = given[k];
        // (0.29.0) `--edition`: the option went with the second edition
        if !dashes && (w == "--edition" || w.starts_with("--edition=")) {
            crate::base::die(c"unknown option '--edition': there is one language (0.28.0) and no edition to choose; leave the option out");
        }
        // (0.25.4: the words after `--` are a program's, as they are:
        // `volec run -- --json`)
        if dashes {
            words.push(w);
            continue;
        }
        let mode = color_mode_of(w.as_bytes());
        if mode == -2 {
            die2(c"unknown option (expected --color=auto, always or never): ", c_of(w));
        }
        if mode >= 0 {
            color = mode;
            continue;
        }
        if w == "--" {
            dashes = true;
        }
        // (0.20: --syntax=0.20|mixed, front/conv: the spelling read)
        // (0.26.0: --places, --emit-places, --verify-places,
        // --places-diff: places/mod.vl)
        let values = crate::front::conv::syntax_option(w, &mut pcx)
            || crate::places::places_option(w, &mut pcx)
            || crate::base::diag::allow_option(w, &mut pcx)
            || crate::base::diag::max_errors_option(w, &mut pcx);
        if w == "--json" || values {
            if !values {
                set_diag_json(true);
            }
        } else {
            words.push(w);
        }
    }
    // (NO_COLOR, set and not empty: no colour, unless --color=always)
    let no_color = match std::env::var_in("NO_COLOR", gpa) {
        Ok(s) => s.len() > 0,
        Err(_) => false,
    };
    term_setup(color, no_color, &mut pcx);
    let line = Line { words: words.as_slice() };
    // (0.15: `--help` on every command, tools/help.vl; guide and
    // `query --help` have their own)
    let first = line.word(1);
    if line.len() >= 2 && (is_help(first) || first == "help") {
        return run_help(line) as i32;
    }
    for k in 2..line.len() {
        // (0.25.4: not after `--`, a program's own `--help`)
        if line.word(k) == "--" {
            break;
        }
        if is_help(line.word(k)) && first != "guide" && !(k == 2 && first == "query") {
            return run_help(line) as i32;
        }
    }
    // (0.25.4) `volec run [DIR] [-- ARGS]`: DIR/main.vl built into the
    // cache (when changed), then run (cli/run.vl).
    if first == "run" {
        return crate::cli::run::run(line, gpa, &mut pcx, &mut wgx) as i32;
    }
    // (0.27.5) `volec --edition rust __std2-index FILE`: std2's units, for
    // embed.sh (front/modules/std2lazy.vl). RULE: Z5.2
    if first == "__std2-index" && line.len() == 3 {
        return crate::front::modules::std2lazy::index_command(line.word(2), &mut pcx) as i32;
    }
    // (0.27.7) `volec __selftest freeze`: a write to a frozen buffer stops
    // the compiler (base: buf_done, src-buffer.md; tests/selftest.sh)
    if first == "__selftest" && line.len() == 3 && line.word(2) == "freeze" {
        return crate::base::freeze_selftest() as i32;
    }
    // The tools (0.11): query, edit, undo, check, fix, the refactorings
    // ... (commands.vl); 0.15: several in one call, batch.
    let status = run_command(line, true, gpa, &mut tcx, &mut pcx, &mut wgx);
    if status >= 0 {
        return status as i32;
    }
    // (0.8's --fix-imports and 0.9's --fix-unsafe: `fix --only`)
    let fixed = run_alias(line, gpa, &mut tcx, &mut pcx, &mut wgx);
    if fixed >= 0 {
        return fixed as i32;
    }
    build(line, gpa, &mut tcx, &mut pcx, &mut wgx) as i32
}

// A build's line (`volec FILE.vl... [OPTIONS]`, or the one `volec run`
// makes, cli/run.vl): its exit status, once the output is written; an
// error ends the program (exit 1).
pub fn build(line: Line<'_>, gpa: Gpa, tcx: &mut Tcx<Comp>, pcx: &mut Ctx<Comp>,
    wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    // UNSAFE: the main function context, reached through its raw pointer (main_cx)
    // SAFETY: main_cx returns the context made once for the process and never freed; each `&mut
    // *main_cx(pcx)` is made on the main thread for one call (check_rules, compile_program) and
    // no other reference to that context is in use during it: the tasks' contexts are their own
    unsafe {
        // (0.15) A build prints its errors as `check` does, one per line,
        // when stderr is not a terminal (an agent, a script, a pipe);
        // `--diagnostics=human` or `=short` says which.
        // (0.25.3: a terminal's form when base::term says, else as before)
        pcx.diag_short = !stderr_is_terminal() && !pcx.rich;
        // (0.18.1: the options, for the code cache's key, back::codecache)
        cc_args(line, pcx);
        // (0.25: the options, on std::cli: cli/build.vl)
        let build = crate::cli::build::read_build(line, gpa, pcx);
        if build.instead == 2 {
            return if check_rules(&mut *main_cx(pcx), 2000, pcx) == 0 { 0 } else { 1 };
        }
        if build.instead == 1 {
            print_version();
            return 0;
        }
        let inputs = build.inputs;
        let mut output = build.output;
        let output_given = build.output_given;
        let tokens_only = build.tokens_only;
        let mut target = build.target;
        let include_dirs = build.include_dirs;
        let emit_imports = build.emit_imports;
        let vec_stats = build.vec_stats;
        if inputs.len() as i64 == 0 {
            usage();
        }
        // (0.25.3) `volec build main.vl`: a command word that is no file
        let hint = not_a_command(line, (inputs[0]) as *mut u8, tcx, pcx);
        if hint >= 0 {
            return hint;
        }
        // (0.18.1) --emit-ir and --emit-mir without -o print to stdout ("-";
        // gen0::gen::write_dump): agents in the 0.18 eval looked for the IR
        // on stdout and found a.o next to the source.
        if (pcx.emit_ir || pcx.emit_mir) && !output_given {
            output = c"-";
        }
        if pcx.profile_generate != 0 as *mut u8 && pcx.opt_level == 0 {
            die(c"--profile-generate needs -O1 or -O2");
        }
        if pcx.check_unsafe && pcx.opt_level == 0 {
            die(c"--check-unsafe needs -O1 or -O2");
        }
        // (0.26.3) the overflow checks, by the level given (not the one
        // --trace or a test build raises it to)
        pcx.overflow_checks = if pcx.overflow_flag >= 0 { pcx.overflow_flag == 1 }
            else { pcx.opt_level == 0 };
        pcx.ovf_census = pcx.overflow_checks && crate::base::env_is_set(c"VOLE_OVF_CENSUS");
        // (-O0's generator has no frames to trace: --trace builds at -O1)
        if pcx.trace && pcx.opt_level == 0 {
            pcx.opt_level = 1;
        }
        // (0.25.5: --vec-stats=FN names each loop by its line)
        pcx.ir_locs = pcx.debug_info || pcx.trace || pcx.vec_stats_fn != 0 as *mut u8;
        pcx.ir_call_locs = pcx.trace;
        // (-O0 optimizes nothing: a profile changes nothing there.)
        if pcx.opt_level == 0 {
            pcx.profile_use = 0 as *mut u8;
        }
        // (0.16: the optimizer, --verify-effects, --print-effects and
        // --check-alloc read the effects; else only a program declaring
        // some needs them, front::effects::check::effects_declared)
        pcx.effects_wanted = pcx.opt_level > 0 || pcx.emit_ir || pcx.emit_mir || pcx.verify_effects
            || pcx.print_effects || get_check_alloc_mode();
        // (0.25) --time-passes and VOLE_PHASE_TIMES count from here: reading,
        // lexing, the modules and the C imports, before compile_program.
        // (0.25.3: the phases on a terminal, base::term)
        let compiling = buf_new();
        if !streq(output, c"-") {
            term_build(output, compiling, pcx);
        }
        let t_load = timer_now(pcx);
        phase_time(0 as *mut u8, pcx);
        pcx.err_kind = c"tokenizer error";
        load_sources(inputs.as_slice(), pcx);
        pcx.errors_as_dump = tokens_only;
        init_lexer(pcx);
        let user_files = pcx.files.len() as i64;
        for f in 0..user_files {
            lex_range(pcx.files[f as usize].start, pcx.files[f as usize].end,
                tokens_only && f + 1 == user_files, pcx);
        }
        // (the checking Gpa's system constants, part of std's text)
        set_check_alloc_linux(target_is_linux(if target == 0 { host_target() } else { target }));
        // (0.19: std's sections of the target's detection, stdsections.vl)
        set_target(if target == 0 { host_target() } else { target }, pcx);
        if !tokens_only {
            pcx.err_kind = c"module error";
            crate::front::modules::std2lazy::set_build();
            load_modules(pcx);
            pcx.err_kind = c"tokenizer error";
        }
        if tokens_only {
            let out = buf_new();
            dump_tokens(out, pcx.files[0].start, pcx);
            buf_write_fd(out, STDOUT);
            return 0;
        }
        if target == 0 {
            target = host_target();
            if target == 0 {
                die(c"no backend for this host; pass --target aarch64-macos, aarch64-linux, x86_64-linux or x86_64-macos");
            }
        }
        set_target(target, pcx);
        buf_fmt(compiling,
            format_args("{} (-O{opt_level}, {})",
                str::from_utf8(&cstr((inputs[0]) as *mut u8)).unwrap(),
                str::from_utf8(&cstr(target_name(target))).unwrap(), opt_level = pcx.opt_level));
        // (0.19: -C's errors, once the target is known)
        if pcx.arch_used {
            build_features(pcx);
        }
        if pcx.output_mode < 0 {
            pcx.output_mode = output_mode_of(output);
        }
        if link_args_given(pcx) && pcx.output_mode != OUT_EXECUTABLE && !pcx.emit_header {
            die(c"-l, -L, objects, archives and C files are for the link: name an executable (-o prog), not an object (.o, -c) or assembly (.s, -S)");
        }
        import_c_headers(target, include_dirs.as_slice(), emit_imports, output, pcx);
        lex_range(pcx.files[(pcx.files.len() as i64 - 1) as usize].end,
            pcx.files[(pcx.files.len() as i64 - 1) as usize].end, true, pcx);
        timer_add(T_LOAD, t_load, pcx);
        phase_time(c"read, lex and modules", pcx);
        compile_program(&mut *main_cx(pcx), output, pcx, wgx);
        // (0.18.1) the success line: `ok: built prog` (base::diag::print_ok)
        let done = buf_new();
        buf_str(done,
            if pcx.output_mode == OUT_EXECUTABLE && !pcx.emit_header && !pcx.emit_ir
                && !pcx.emit_mir { c"built " }
            else { c"wrote " });
        buf_str(done, output);
        if pcx.rich && !streq(output, c"-") {
            build_finished(pcx.warnings_shown, pcx);
        } else if !streq(output, c"-") {
            print_ok(&buf_copy(done), pcx);
        }
        if vec_stats {
            let b = buf_new();
            buf_str(b, c"vector loops ");
            buf_int(b, vec_stat(0, pcx));
            buf_str(b, c", overlap tests ");
            buf_int(b, vec_stat(1, pcx));
            buf_str(b, c", tests dropped by noalias ");
            buf_int(b, vec_stat(2, pcx));
            buf_str(b, c"\n");
            buf_write_fd(b, STDERR);
        }
        0
    }
}
