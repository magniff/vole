use crate::front::stdalloc::{CHECK_ALLOC_LINUX, CHECK_ALLOC_MODE};
use crate::gen0::gen::{EMIT_IR, EMIT_MIR, compile_program};
use crate::middle::ctx::main_cx;
use crate::middle::effects_verify::VERIFY_EFFECTS;
use crate::middle::egraph::check_rules;
use crate::middle::ir::{IR_CALL_LOCS, IR_LOCS};
use crate::middle::opt::OPT_LEVEL;
use crate::middle::parallel::{phase_time, vec_stat};
use crate::middle::profile::{PROFILE_GENERATE, PROFILE_USE};
use crate::middle::trace::TRACE;
