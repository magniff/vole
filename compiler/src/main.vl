    FILES, STDERR, STDOUT, alloc_zeroed, buf_fmt, buf_int, buf_new, buf_slice, buf_str,
    buf_write_fd, cstr, die, die2, load_sources, streq,
};
use crate::base::diag::{
    DIAG_PROG, DIAG_SHORT, ERRORS_AS_DUMP, ERR_KIND, WARNINGS_SHOWN, ok_line_setup, print_ok,
};
use crate::base::json::DIAG_JSON;
use crate::base::target::{
    T_AARCH64_LINUX, T_AARCH64_MACOS, T_X86_64_LINUX, T_X86_64_MACOS, set_target, target_is_linux,
    target_name,
};
use crate::base::term::{
    COLOR_AUTO, RICH, build_finished, color_mode_of, stderr_is_terminal, term_build, term_setup,
};
use crate::base::timer::{T_LOAD, timer_add, timer_now};
use crate::cli::c_of;
use crate::cli::build::usage;
use crate::cli::hint::not_a_command;
use crate::cli::line::Line;
use crate::front::cheader::EMIT_HEADER;
use crate::front::cimport::import_c_headers;
use crate::front::effects::{EFFECTS_WANTED, PRINT_EFFECTS};
use crate::front::lexer::{dump_tokens, init_lexer, lex_range};
