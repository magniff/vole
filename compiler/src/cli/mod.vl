// volec's command line on std::cli (0.25; 0.25.2: one Command tree).
// main reads std::env's arguments into a Line (line.vl: the words, and
// their parse on the tree, a Call); tree.vl is the tree, of the commands'
// leaves (each command's arguments, next to it); build.vl is a build's
// options, the tree's root; query.vl `query`'s options.
//
// std::cli is the previous release's (0.25.2's, which builds this
// compiler: Arg::num_values, default_missing, allow_hyphen_values, last,
// global; Matches::indices_of). What it has no rule for is made up in
// line.vl and tree.vl (docs/design/cli.md, 0.25.3).

pub mod build;
// (0.25.3) a build's first word that reads as a command
pub mod hint;
pub mod line;
pub mod query;
// (0.25.4) `volec run [DIR]`: built into the cache, then run
pub mod run;
pub mod tree;

use std::Option;
use std::string::str;

use crate::base::{buf_bytes, buf_new};
use crate::tools::proc::buf_cstr;

// s as a C string: a copy, NUL-terminated.
pub fn c_of(s: str) -> *u8 {
    let b = buf_new();
    buf_bytes(b, s.as_bytes());
    buf_cstr(b)
}

// The option a MissingValue error is about, from its text as written: the
// long name (`--out`: "out") or the short one, the last of a cluster
// (`-go`: "o").
pub fn short_of(text: str) -> str {
    match text.strip_prefix("--") {
        Option::Some(long) => long,
        Option::None => {
            let b = text.as_bytes();
            if b.len as i64 < 2 { "" } else { str::from_utf8(b[b.len as i64 - 1..]).unwrap_or("") }
        }
    }
}
