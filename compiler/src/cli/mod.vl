// volec's command line on std::cli (0.25): the layer between C's argv and
// std::cli's Command, and the commands' definitions (build.vl: a build's
// options; events.vl: the other commands' options, in argv's order).
// std::cli is the previous release's (0.25.1's, which builds this
// compiler: its API is 0.24's), so what it lacks is made up here, small.
// 0.25.2's std::cli has most of it (Arg::num_values, default_missing,
// allow_hyphen_values, last, global; docs/design/cli.md): this layer
// moves onto them when 0.26 builds the compiler.
//
//   ArgvIter          argv[from..] as std::cli's arguments (`str`s viewing
//                     argv), and the spellings std::cli has no rule for
//                     rewritten on the way: `-framework` (one dash, a long
//                     name), an option that may have a value or not
//                     (`--stats`, `--stats=functions`), an option with two
//                     values (`--overlay PATH COPY`)
//   argv_index        which argv element a value views: the order of values
//                     of different options (`-l`, `-L` and objects, linked
//                     in their order), which std::cli does not keep
//   c_of              a value as the C string the compiler keeps
//   short_of          the option an error is about (std::cli's CliError
//                     keeps it private)
//   parse_lenient     a parse that goes on after an error, the token taken
//                     out (the commands report the last bad option, with
//                     the NAMEs given, in their try: lines)
//   a dash word       (`query grep '-> bool'`): a word with one '-' that
//                     is none of the command's short options is a NAME, as
//                     before; ArgvIter gives it without its '-' (a
//                     positional to std::cli) and `whole` gives it back
//
// Each command's definition and its errors' mapping (to the `error CODE:
// message` and `try:` lines the command printed before, and its exit
// status) are next to its parsing.

pub mod build;
pub mod events;
pub mod query;

use std::{Allocator, Iterator, Option};
use std::cli::{CliErrorKind, Command, Matches};
use std::string::str;

use crate::base::{buf_bytes, buf_new, strlen};
use crate::tools::proc::buf_cstr;

// argv[from..n] as arguments for Command::parse_in, after `name` (the
// program's name std::cli skips). Rewrites, when `build` is set: `-framework`
// to `--framework`, `--stats` to `--stats=all`, `--print-checks` to
// `--print-checks=`, and `--overlay PATH COPY` to `--overlay PATH
// --overlay-copy COPY`.
pub struct ArgvIter {
    argv: **u8,
    i: i64,
    n: i64,
    name: str,
    first: bool,
    build: bool,
    // after an option of two values (`--overlay`): 1 when the first is
    // next, 2 when `second` is
    overlay: i64,
    // the options of two values (` --overlay `), and the option the second
    // value is given as (`--overlay-copy`, `--2nd`)
    twos: str,
    second: str,
    // dash words given as positionals, but these (` -i -C `)
    dash_words: bool,
    shorts: str,
    // argv's indices left out
    skip: Option<Vec<i64>>,
}

impl ArgvIter {
    pub fn new(argv: **u8, from: i64, n: i64, name: str, build: bool) -> ArgvIter {
        ArgvIter {
            argv: argv, i: from, n: n, name: name, first: true, build: build, overlay: 0,
            twos: if build { " --overlay " } else { "" }, second: "--overlay-copy",
            dash_words: false, shorts: "", skip: Option::None,
        }
    }

    // Words with one '-' are positionals but `shorts`, the command's short
    // options as written (` -i -C `).
    pub fn with_dash_words(sink self, shorts: str) -> ArgvIter {
        self.dash_words = true;
        self.shorts = shorts;
        self
    }

    // `--overlay PATH COPY` as for a build: `--overlay PATH --overlay-copy
    // COPY`.
    pub fn with_overlay(sink self) -> ArgvIter {
        self.twos = " --overlay ";
        self.second = "--overlay-copy";
        self
    }

    // Options of two values (` --rename --type `): `--rename A B` as
    // `--rename A --2nd B` (an option `2nd` of the command).
    pub fn with_twos(sink self, twos: str) -> ArgvIter {
        self.twos = twos;
        self.second = "--2nd";
        self
    }

    pub fn skipping(sink self, skip: sink Vec<i64>) -> ArgvIter {
        self.skip = Option::Some(skip);
        self
    }
}

impl Iterator for ArgvIter {
    type Item = str;

    fn next(inout self) -> Option<str> {
        if self.first {
            self.first = false;
            return Option::Some(self.name);
        }
        if self.overlay == 2 && self.i < self.n {
            self.overlay = 0;
            return Option::Some(self.second);
        }
        while self.i < self.n && skips(self.skip, self.i) {
            self.i += 1;
        }
        if self.i >= self.n {
            return Option::None;
        }
        let s = arg_str(arg_at(self.argv, self.i));
        self.i += 1;
        if self.dash_words && self.overlay == 0 && is_dash_word(s, self.shorts) {
            // (`whole` gives it back with its '-')
            return Option::Some(s.strip_prefix("-").unwrap());
        }
        if self.overlay == 1 {
            self.overlay = 2;
            return Option::Some(s);
        }
        if self.overlay == 0 && self.twos.len() > 0 && in_words(s, self.twos) {
            self.overlay = 1;
        }
        if self.build {
            if s == "-framework" {
                return Option::Some("--framework");
            }
            if s == "--stats" {
                return Option::Some("--stats=all");
            }
            if s == "--print-checks" {
                return Option::Some("--print-checks=");
            }
        }
        Option::Some(s)
    }
}

// Whether k is one of skip's.
fn skips(skip: Option<Vec<i64>>, k: i64) -> bool {
    match skip {
        Option::Some(v) => v.contains(k),
        Option::None => false,
    }
}

// argv[k], 0 <= k < argc.
pub fn arg_at(argv: **u8, k: i64) -> *u8 {
    // UNSAFE: argv is C's array of the arguments, a raw pointer: no bounds
    // to check it against.
    // SAFETY: the callers index it below argc, the count main was given
    // with it; it lives as long as the program.
    unsafe { argv[k] }
}

// The bytes of a C string, without its NUL (argv's, or c_of's).
pub fn c_bytes(p: *u8) -> [u8] {
    // UNSAFE: a C string's length is where its NUL is, through a raw
    // pointer.
    // SAFETY: p is an element of argv or a copy c_of made (or a literal):
    // not null, NUL-terminated, never freed.
    unsafe { p[0..strlen(p) as i64] }
}

// A C string as a str viewing it (one that is not UTF-8: empty).
pub fn arg_str(p: *u8) -> str {
    str::from_utf8(c_bytes(p)).unwrap_or("")
}

// Whether C string p starts with '-' (an option, or `-` alone).
pub fn dashed(p: *u8) -> bool {
    let b = c_bytes(p);
    b.len > 0 && b[0] == '-'
}

// Whether C string p starts with `--`.
pub fn double_dashed(p: *u8) -> bool {
    let b = c_bytes(p);
    b.len > 1 && b[0] == '-' && b[1] == '-'
}

// s as a C string: a copy, NUL-terminated.
pub fn c_of(s: str) -> *u8 {
    let b = buf_new();
    buf_bytes(b, s.as_bytes());
    buf_cstr(b)
}

// The index of the element of argv[0..argc] that s views (a value, or an
// option as written), or -1 (a default, a rewritten spelling).
pub fn argv_index(argc: i64, argv: **u8, s: str) -> i64 {
    let at = s.as_bytes().ptr as i64;
    for k in 0..argc {
        let p = arg_at(argv, k);
        let start = p as i64;
        if at >= start && at <= start + c_bytes(p).len {
            return k;
        }
    }
    -1
}

// The argv element that s views, whole (`--emit-ir=x` for its `--emit-ir`),
// or s.
pub fn whole_arg(argc: i64, argv: **u8, s: str) -> str {
    let k = argv_index(argc, argv, s);
    if k < 0 { s } else { arg_str(arg_at(argv, k)) }
}

// The option a MissingValue error is about, from its text as written: the
// long name (`--out`: "out") or the short one, the last of a cluster
// (`-go`: "o").
pub fn short_of(text: str) -> str {
    match text.strip_prefix("--") {
        Option::Some(long) => long,
        Option::None => {
            let b = text.as_bytes();
            if b.len < 2 { "" } else { str::from_utf8(b[b.len - 1..]).unwrap_or("") }
        }
    }
}

// Whether s is one of the words of list (` --a --b `).
fn in_words(s: str, list: str) -> bool {
    for w in list.split(' ') {
        if w.len() > 0 && w == s {
            return true;
        }
    }
    false
}

// Whether s is a word with one '-' (`-x`, `-> bool`) that is none of
// shorts (` -i -C `).
fn is_dash_word(s: str, shorts: str) -> bool {
    let b = s.as_bytes();
    if b.len < 2 || b[0] != '-' || b[1] == '-' {
        return false;
    }
    for w in shorts.split(' ') {
        if w == s {
            return false;
        }
    }
    true
}

// A value as given: a dash word with its '-' back.
pub fn whole(argc: i64, argv: **u8, v: str) -> str {
    let k = argv_index(argc, argv, v);
    if k < 0 {
        return v;
    }
    let p = arg_at(argv, k);
    if v.as_bytes().ptr as i64 == p as i64 + 1 && dashed(p) {
        return arg_str(p);
    }
    v
}

// A value as given, as a C string: argv's own when it is a whole element
// of argv, else a copy.
pub fn c_val(argc: i64, argv: **u8, v: str) -> *u8 {
    let w = whole(argc, argv, v);
    let k = argv_index(argc, argv, w);
    if k >= 0 {
        let p = arg_at(argv, k);
        if w.as_bytes().ptr as i64 == p as i64 && w.len() == c_bytes(p).len {
            return p;
        }
    }
    c_of(w)
}

// What parse_lenient took out last: its kind, the token whole, its index.
pub struct Bad {
    pub kind: CliErrorKind,
    pub text: *u8,
    pub at: i64,
}

// No error.
pub fn no_bad() -> Bad {
    Bad { kind: CliErrorKind::Help, text: 0 as *u8, at: -1 }
}

// Parses it (an ArgvIter made by make, given the tokens to leave out)
// with cmd, the Matches on a; on an error the token it is about is taken
// out and the rest parsed again: `bad` is the last error (its at < 0:
// none).
pub fn parse_lenient<A: Allocator, F: FnMut(Vec<i64>) -> ArgvIter>(cmd: Command, argc: i64,
    argv: **u8, make: F, a: A, bad: inout Bad, gpa: Gpa) -> Matches<A> {
    var f = make;
    var skip: Vec<i64> = Vec::new_in(gpa);
    var all = false;
    loop {
        match cmd.parse_in(f(skip), a) {
            Ok(m) => return m,
            Err(e) => {
                let k = argv_index(argc, argv, e.text);
                if all {
                    std::panic_str("volec: the command line does not parse without its arguments");
                }
                if k < 0 || skip.contains(k) {
                    all = true;
                    // (nothing to take out: every token but the name)
                    for j in 1..argc {
                        skip.push(j);
                    }
                } else {
                    bad.kind = e.kind;
                    bad.text = arg_at(argv, k);
                    bad.at = k;
                    skip.push(k);
                }
            }
        }
    }
}
