// A build's command line (0.25, on std::cli): `volec [OPTIONS] FILE.vl...
// [x.c|x.o|x.a|-l NAME|-L DIR]... [-o OUT]`. The options set the
// compiler's globals; what main needs after them is a Build. Errors keep
// 0.24's text and status (1): a missing value prints the usage line, an
// option that is no option is read as a file (`error: cannot read
// --bogus`), as before.

use std::alloc::ArenaScope; use std::alloc::Arena;
use std::cli::Arg; use std::cli::CliError; use std::cli::CliErrorKind; use std::cli::Command;
use std::cli::Matches;

use crate::arch::features::arch_option;
use crate::back::codecache::cc_option;
use crate::back::objfile::{OUT_ASM, OUT_OBJECT};
use crate::back::objfile::output::{
    add_framework, add_link_arg, add_link_include, is_link_input, set_linker,
};
use crate::base::{IntVec, buf_copy, buf_new, buf_str, die, die2};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::print_diagnostic;
use crate::base::target::target_of_name;
use crate::base::timer::{counters_open, passes_open};
use crate::cli::{c_of, short_of};
use crate::cli::line::Line;
use crate::front::stdalloc::{get_check_alloc_mode, set_check_alloc_mode};
use crate::middle::parallel::parse_jobs;

// What a build's command line gives main, the globals aside.
#[derive(Clone, Copy)] pub struct Build {
    pub inputs: IntVec,
    pub output: *const u8,
    pub output_given: bool,
    pub tokens_only: bool,
    pub target: i64,
    pub include_dirs: IntVec,
    pub emit_imports: bool,
    pub vec_stats: bool,
    // what to do instead of a build: 0 none, 1 --version, 2 --check-rules
    pub instead: i64,
}

// The usage line a build's error prints (exit 1).
pub fn usage() -> ! {
    die(c"usage: volec [--target aarch64-macos|aarch64-linux|x86_64-linux|x86_64-macos] [-O0|-O1|-O2] [-g] [--emit-ir] [--verify-ir] [--emit-imports] [--emit-header] [-I dir] [--deny-warnings] [--diagnostics=short|human] [--json] <file.vl>... [x.c|x.o|x.a|-l name|-L dir]... [-S|--emit-asm|-c] [-o out.o|out.s|program] | volec guide [TOPIC|--list] (the language) | volec query|edit|undo|check|fix|fmt|lint|same-output|explain ... (docs/query.md, docs/refactor.md, docs/fmt.md) | volec --tokens <file.vl> | volec --version")
}

// A flag of a build: `--NAME`.
fn flag<'a>(name: &'a str, help: &'a str) -> Arg<'a> {
    Arg::flag(name).help(help)
}

// A one-letter option or flag of a build: `-x`, no long form.
fn short_only(a: Arg<'_>, c: u8) -> Arg<'_> {
    a.short(c as char).long("")
}

// Every option of a build.
pub fn build_command(gpa: Gpa) -> Command<'static, Gpa> {
    Command::new_in("volec", gpa)
        .about("compile FILE.vl... (one program) to an executable, an object or assembly")
        .arg(Arg::positional("input").multiple()
            .help("the program's files, and objects, archives and C files for the link"))
        .arg(short_only(Arg::option("out"), b'o').value_name("FILE")
            .help("the output: a program, FILE.o (an object), FILE.s (assembly) [default: a.o]"))
        .arg(Arg::option("target").value_name("T")
            .help("aarch64-macos, aarch64-linux, x86_64-linux or x86_64-macos [default: the host]"))
        .arg(short_only(Arg::option("opt"), b'O').value_name("LEVEL")
            .help("the optimization level, 0, 1 or 2: -O0 (default -O2; docs/optimizer.md)"))
        .arg(short_only(Arg::option("cpu"), b'C').value_name("KEY=VALUE")
            .help("target-cpu=NAME|native, target-feature=+x,-y (docs/design/arch.md)"))
        .arg(short_only(Arg::option("jobs"), b'j').value_name("N")
            .help("the threads code generation may use (the output is the same)"))
        .arg(flag("emit-asm", "write assembly (as an output named .s)").short(b'S' as char))
        .arg(short_only(Arg::flag("object"), b'c').help("write an object"))
        .arg(short_only(Arg::flag("debug"), b'g').help("debug information: DWARF line tables"))
        .arg(short_only(Arg::option("include"), b'I').value_name("DIR")
            .help("a directory for `import`ed C headers"))
        .arg(short_only(Arg::option("lib"), b'l').value_name("NAME").help("a library for the link"))
        .arg(short_only(Arg::option("libdir"), b'L').value_name("DIR")
            .help("a directory of libraries for the link"))
        .arg(Arg::option("framework").value_name("NAME")
            .help("-framework NAME: a macOS framework for the link"))
        .arg(Arg::option("linker").value_name("NAME")
            .help("--linker=system|cc|internal: the system's linker run directly (the default), through cc, or the compiler's own"))
        .arg(Arg::option("diagnostics").value_name("FORM")
            .help("--diagnostics=short|human: one line per error (the default when stderr is no terminal) or the long form"))
        .arg(flag("deny-warnings", "make warnings errors"))
        .arg(Arg::option("allow").value_name("CODE")
            .help("--allow=CODE[,CODE]: report no warning of that code or family (`--allow=borrowck`), repeatable"))
        .arg(Arg::option("deny").value_name("CODE")
            .help("--deny=CODE[,CODE]: a warning of that code or family is an error (`--deny=unsafe`: with `volec check`, each unsafe site without its comments and each unsafe block with nothing unsafe inside), repeatable"))
        .arg(Arg::option("max-errors").value_name("N")
            .help("--max-errors=N: stop after N errors, not 50 (0: report every error)"))
        .arg(Arg::option("color").value_name("WHEN")
            .help("--color=auto|always|never: colour and progress on a terminal (auto: when stderr is one, and NO_COLOR is not set)"))
        .arg(flag("verbose", "a failed link: its command and the linker's whole text"))
        .arg(flag("tokens", "print the tokens of one file"))
        .arg(flag("version", "print the release and the host target"))
        .arg(flag("emit-ir", "write the optimized IR instead (stdout without -o)"))
        .arg(flag("emit-mir", "write the machine IR instead (stdout without -o)"))
        .arg(flag("emit-header", "write the program's C header instead"))
        .arg(flag("emit-imports",
            "write what `import`ed C headers declare (as vole source) instead"))
        .arg(flag("verify-ir", "check the IR after every pass"))
        .arg(flag("print-after-all", "print the IR after every pass (stderr)"))
        .arg(flag("print-attrs", "print the inferred function attributes (-O2, stderr)"))
        .arg(Arg::option("time-passes").value_name("WHAT").default_missing("time")
            .help("--time-passes: the CPU time of each phase (stderr); --time-passes=instructions: the instructions retired; =passes: and those of each optimizer pass (docs/optimizer.md)"))
        .arg(flag("trace", "failure traces: a crash prints its line and callers"))
        .arg(Arg::option("atomics").value_name("KIND")
            .help(
                "--atomics=lse|llsc: AArch64 atomics as LSE instructions or exclusive-pair loops"))
        .arg(flag("verify-regalloc", "check the register allocation"))
        .arg(flag("print-regalloc", "print the register allocation"))
        .arg(Arg::option("stats").value_name("WHAT").default_missing("all")
            .help("--stats: the code's sizes; --stats=functions: each function's"))
        .arg(Arg::option("overflow-checks").value_name("ON")
            .help("--overflow-checks=on|off: Rust's checks of + - * and the shifts, which panic on overflow [default: on at -O0, off at -O1 and -O2]"))
        .arg(flag("no-ifconv", "no if-conversion in loops (to compare)"))
        .arg(flag("no-vectorize", "no loop vectorization (to compare)"))
        .arg(flag("no-unroll-runtime",
            "no unrolling of loops whose trip count is known at run time only (to compare)"))
        .arg(flag("no-slp", "no SLP vectorization (to compare)"))
        .arg(flag("no-egraph", "no rewrite rules in GVN (to compare)"))
        .arg(flag("no-noalias", "no facts from reference parameters (to measure them)"))
        .arg(flag("check-unsafe",
            "check unsafe code's raw-pointer accesses at run time (-O1, -O2)"))
        .arg(flag("check-alloc", "the checking general-purpose allocator"))
        .arg(flag("verify-effects", "check the effects against the IR (-O1, -O2)"))
        .arg(flag("print-effects", "print every function's effects"))
        .arg(Arg::option("vec-stats").value_name("FN").default_missing("")
            .help("--vec-stats: the vectorizer's counts (stderr); --vec-stats=FN: a line for each loop of function FN, vectorized or the first reason it was not (-O2)"))
        .arg(Arg::option("profile-generate").value_name("FILE")
            .help("instrument the program: it writes its blocks' counts to FILE at exit"))
        .arg(Arg::option("profile-use").value_name("FILE").help("optimize with the counts of FILE"))
        .arg(Arg::option("overlay").num_values(2 as usize).value_name("PATH COPY")
            .help("PATH read from COPY"))
        .arg(Arg::option("print-checks").value_name("FILTER").default_missing("")
            .help("print the run-time checks left after the optimizer (--print-checks=FILTER)"))
        .arg(flag("no-positions", "the run-time checks without their positions"))
        .arg(flag("debug-contracts", "the contracts checked in debug form"))
        .arg(flag("test-build", "the tests, with a test main (what `volec test` builds)"))
        .arg(flag("coverage", "a counter per block, for `volec fuzz`"))
        .arg(flag("check-rules", "check the rewrite rules on random values"))
        .arg(flag("allow-unsafe", "removed in 0.10"))
        .arg(flag("no-cache", "no code cache"))
        .arg(Arg::option("cache").value_name("ON").help("--cache=on|off: the code cache"))
}

// Each value of option name is one of choices (`on|off`); one that is
// none is read as a file, as before (`error: cannot read --linker=ld`,
// `cannot read -O3`), a value given apart as the option (`-O main.vl`:
// `cannot read -O`). A value's word is its index (read_build gives
// std::cli the line's words).
fn values_in(line: Line<'_>, m: &Matches<'_, &ArenaScope<'_, Gpa>>, name: &str, choices: &str,
    spelling: &str) {
    let values = m.values(name);
    let places = m.indices_of(name);
    for j in 0..values.len() {
        let mut ok = false;
        for c in choices.split('|') {
            ok = ok || c == values[j];
        }
        if !ok {
            let whole = line.word(places[j]);
            die2(c"cannot read ",
                c_of(if whole.len() == values[j].len() { spelling } else { whole }));
        }
    }
}

// (0.25.5) --time-passes=instructions where the system will not count
// them: Linux's perf_event_open refused (perf_event_paranoid above 2, or
// a container's seccomp profile).
fn instructions_refused(pcx: &mut Ctx<Comp>) -> ! {
    let t = buf_new();
    buf_str(t, c"error[time.instructions]: the instructions retired cannot be read here\n");
    buf_str(t, c"  = help: the system's counter refused this process (Linux: perf_event_open, which /proc/sys/kernel/perf_event_paranoid above 2 or a container's seccomp profile forbids); --time-passes counts CPU time\n");
    buf_str(t, c"  = try: volec --time-passes FILE.vl -c -o /dev/null\n");
    print_diagnostic(-1, &buf_copy(t), pcx);
    std::process::exit(1i32)
}

// The build's error for e (exit 1).
fn build_error(line: Line<'_>, e: CliError<'_>) -> ! {
    match e.kind {
        CliErrorKind::MissingValue => {
            let name = short_of(e.text);
            if name == "j" {
                die(c"-j wants a number of threads: -j4, or -j 1 for one")
            }
            if name == "C" {
                die(c"-C takes target-cpu=NAME or target-feature=+x,-y (docs/design/arch.md)")
            }
            usage()
        }
        _ => {
            // (the word of the error, `--bogus=x` for its `--bogus`)
            let k = line.at(e.text);
            die2(c"cannot read ", c_of(if k < 0 { e.text } else { line.word(k) }))
        }
    }
}

// Whether `-c` is given after the last `-S` (or `--emit-asm`): the last
// of them is the output's kind.
fn object_last(line: Line<'_>) -> bool {
    let mut object = false;
    for k in 1..line.len() {
        let s = line.word(k);
        if s == "-c" {
            object = true;
        } else if s == "-S" || s == "--emit-asm" {
            object = false;
        }
    }
    object
}

// Sets the globals of m's options and gives the rest.
fn apply(line: Line<'_>, m: &Matches<'_, &ArenaScope<'_, Gpa>>, pcx: &mut Ctx<Comp>) -> Build {
    let mut b = Build {
        inputs: IntVec { data: 0 as *mut i64, count: 0, cap: 0 }, output: c"a.o",
        output_given: false,
        tokens_only: m.flag("tokens"), target: 0,
        include_dirs: IntVec { data: 0 as *mut i64, count: 0, cap: 0 }, emit_imports: false,
        vec_stats: false, instead: 0,
    };
    if m.flag("no-cache") {
        cc_option(c"--no-cache", pcx);
    }
    values_in(line, m, "cache", "on|off", "--cache");
    for &v in m.values("cache") {
        cc_option(if v == "on" { c"--cache=on" } else { c"--cache=off" }, pcx);
    }
    match m.get("out") {
        Option::Some(v) => {
            b.output = c_of(v);
            b.output_given = true;
        }
        Option::None => {}
    }
    for &v in m.values("target") {
        b.target = target_of_name(c_of(v));
        if b.target == 0 {
            die2(c"unknown target (expected aarch64-macos, aarch64-linux, x86_64-linux or x86_64-macos): ", c_of(v));
        }
    }
    // (0.19) `-C target-cpu=NAME|native`, `-C target-feature=+x,-y`
    // (arch/features.vl)
    for &v in m.values("cpu") {
        if !arch_option(c_of(v), pcx) {
            die(c"-C takes target-cpu=NAME or target-feature=+x,-y (docs/design/arch.md)");
        }
    }
    values_in(line, m, "opt", "0|1|2", "-O");
    for &v in m.values("opt") {
        pcx.opt_level = (v.as_bytes()[0] - b'0') as i64;
    }
    // (0.26.3) --overflow-checks=on|off over the level's default
    values_in(line, m, "overflow-checks", "on|off", "--overflow-checks");
    for &v in m.values("overflow-checks") {
        pcx.overflow_flag = if v == "on" { 1 } else { 0 };
    }
    // (0.18.1) -j N or -jN: the threads code generation may use (the
    // output is the same whatever their number; middle::parallel).
    for &v in m.values("jobs") {
        pcx.jobs = parse_jobs(v);
        if pcx.jobs < 1 {
            die(c"-j wants a number of threads: -j4, or -j 1 for one");
        }
    }
    if m.flag("emit-asm") || m.flag("object") {
        pcx.output_mode = if m.flag("object") && (!m.flag("emit-asm") || object_last(line)) {
            OUT_OBJECT
        } else {
            OUT_ASM
        };
    }
    pcx.emit_ir = pcx.emit_ir || m.flag("emit-ir");
    pcx.emit_mir = pcx.emit_mir || m.flag("emit-mir");
    pcx.print_after_all = pcx.print_after_all || m.flag("print-after-all");
    pcx.print_attrs = pcx.print_attrs || m.flag("print-attrs");
    // (0.25.5) --time-passes=instructions: the instructions retired
    // (0.29) --time-passes=passes: and those of each optimizer pass
    values_in(line, m, "time-passes", "time|instructions|passes", "--time-passes");
    for &v in m.values("time-passes") {
        pcx.time_passes = true;
        if v == "instructions" || v == "passes" {
            pcx.time_instructions = true;
            if !counters_open(pcx) {
                instructions_refused(pcx);
            }
        }
        if v == "passes" {
            passes_open(pcx);
        }
    }
    pcx.debug_info = pcx.debug_info || m.flag("debug");
    // (0.17) `--overlay PATH COPY`: PATH is read from COPY (as
    // check's; volec probe builds a program so).
    for &v in m.values("overlay") {
        pcx.overlay.push(c_of(v) as i64);
    }
    // (0.17) Failure traces (middle/trace.vl).
    pcx.trace = pcx.trace || m.flag("trace");
    pcx.verify_ir = pcx.verify_ir || m.flag("verify-ir");
    // (0.21) AArch64 atomics: LSE instructions or exclusive-pair loops
    // (the target's default: LSE on macOS, loops on Linux).
    values_in(line, m, "atomics", "lse|llsc", "--atomics");
    for &v in m.values("atomics") {
        pcx.a64_lse_flag = if v == "lse" { 1 } else { 0 };
    }
    // (0.25) The linker (back::objfile::output): the system's, run
    // directly (the default), through cc, or the compiler's own.
    values_in(line, m, "linker", "system|cc|internal", "--linker");
    for &v in m.values("linker") {
        set_linker(c_of(v), pcx);
    }
    pcx.verify_regalloc = pcx.verify_regalloc || m.flag("verify-regalloc");
    values_in(line, m, "stats", "all|functions", "--stats");
    for &v in m.values("stats") {
        pcx.stats = if v == "all" { 1 } else { 2 };
    }
    pcx.print_regalloc = pcx.print_regalloc || m.flag("print-regalloc");
    for &v in m.values("include") {
        b.include_dirs.push(c_of(v) as i64);
        add_link_include(c_of(v), pcx);
    }
    // (0.25) `-framework NAME`: a macOS framework for the link (Linux
    // leaves it out), as an extern block's #[link(framework = ...)].
    for &v in m.values("framework") {
        add_framework(v.as_bytes(), pcx);
    }
    // (0.16) For the link: `-l NAME`, `-L DIR` (or -lNAME, -LDIR),
    // objects, archives, shared libraries and C files, given to cc
    // in their order (back::objfile::output): in the line's order.
    let libs = m.values("lib");
    let dirs = m.values("libdir");
    let inputs = m.values("input");
    let lib_at = m.indices_of("lib");
    let dir_at = m.indices_of("libdir");
    let input_at = m.indices_of("input");
    let mut li: i64 = 0;
    let mut di: i64 = 0;
    let mut ii: i64 = 0;
    loop {
        let at_l = if li < libs.len() as i64 { lib_at[li as usize] } else { line.len() };
        let at_d = if di < dirs.len() as i64 { dir_at[di as usize] } else { line.len() };
        let at_i = if ii < inputs.len() as i64 { input_at[ii as usize] } else { line.len() };
        if li >= libs.len() as i64 && di >= dirs.len() as i64 && ii >= inputs.len() as i64 {
            break;
        }
        if li < libs.len() as i64 && at_l <= at_d && at_l <= at_i {
            add_link_arg(b'l', c_of(libs[li as usize]), pcx);
            li += 1;
        } else if di < dirs.len() as i64 && at_d <= at_i {
            add_link_arg(b'L', c_of(dirs[di as usize]), pcx);
            di += 1;
        } else {
            let p = c_of(inputs[ii as usize]);
            if is_link_input(p) {
                add_link_arg(b' ', p, pcx);
            } else {
                b.inputs.push(p as i64);
            }
            ii += 1;
        }
    }
    pcx.emit_header = pcx.emit_header || m.flag("emit-header");
    b.emit_imports = m.flag("emit-imports");
    if m.flag("no-ifconv") {
        pcx.ifconv = false;
    }
    if m.flag("no-vectorize") {
        pcx.vectorize = false;
    }
    if m.flag("no-unroll-runtime") {
        pcx.unroll_runtime = false;
    }
    if m.flag("no-slp") {
        pcx.slp = false;
    }
    // (0.18: --print-checks[=FILTER], --no-positions, --debug-contracts,
    // --test-build, --coverage; front/contracts/flags.vl)
    match m.get("print-checks") {
        Option::Some(v) => pcx.print_checks = c_of(v),
        Option::None => {}
    }
    pcx.no_positions = pcx.no_positions || m.flag("no-positions");
    pcx.debug_contracts = pcx.debug_contracts || m.flag("debug-contracts");
    pcx.test_build = pcx.test_build || m.flag("test-build");
    // (0.28.0) A test build reads std whole: the harness written after
    // the program is read (front/tests: `<test>`) reaches std::test, whose
    // properties and fuzz targets need u64's built-in impls and more that
    // a program without them never names; the lazy build failed and was
    // made again whole (rerun_eager): twice the time, and no `ok:` line.
    if pcx.test_build {
        crate::front::modules::stdlazy::set_eager(true);
    }
    pcx.coverage = pcx.coverage || m.flag("coverage");
    pcx.check_unsafe = pcx.check_unsafe || m.flag("check-unsafe");
    // (0.16: the checking general-purpose allocator: std's Gpa is
    // compiler/std/alloc_check.vl)
    set_check_alloc_mode(get_check_alloc_mode() || m.flag("check-alloc"));
    // (0.17: reference parameters' facts off, to measure them;
    // middle/gvn.vl)
    pcx.noalias_off = pcx.noalias_off || m.flag("no-noalias");
    // (0.25.5) --vec-stats=FN: each loop of FN, vectorized or why not
    for &v in m.values("vec-stats") {
        b.vec_stats = true;
        if v.len() > 0 {
            pcx.vec_stats_fn = c_of(v);
        }
    }
    // (0.16: the effects checked against the IR, -O1 and -O2; every
    // function's effects, after checking)
    pcx.verify_effects = pcx.verify_effects || m.flag("verify-effects");
    pcx.print_effects = pcx.print_effects || m.flag("print-effects");
    match m.get("profile-use") {
        Option::Some(v) => pcx.profile_use = c_of(v),
        Option::None => {}
    }
    match m.get("profile-generate") {
        Option::Some(v) => pcx.profile_generate = c_of(v),
        Option::None => {}
    }
    if m.flag("no-egraph") {
        pcx.egraph = false;
    }
    pcx.deny_warnings = pcx.deny_warnings || m.flag("deny-warnings");
    pcx.link_verbose = m.flag("verbose");
    values_in(line, m, "diagnostics", "short|human", "--diagnostics");
    for &v in m.values("diagnostics") {
        pcx.diag_short = v == "short";
    }
    if m.flag("allow-unsafe") {
        // 0.9's option is gone: no bootstrap interface passes it to
        // 0.10 (see volec-0.10 in bootstrap/releases.toml).
        die(c"--allow-unsafe was removed in 0.10: unsafe operations outside unsafe code are errors; `volec fix --only unsafe` puts them in unsafe blocks");
    }
    if m.flag("check-rules") {
        b.instead = 2;
    } else if m.flag("version") {
        b.instead = 1;
    }
    b
}

// A build's command line, words 1.. of line: the globals set, the rest
// given; an error ends the program (exit 1). The Matches are on an arena.
// (The root of volec's Command tree, cli/tree.vl, is this Command; a
// build's line is read with it alone: a word of a build that names a
// command, `volec test`... after a FILE, stays a FILE.) std::cli reads the
// line's words, `-framework` as `--framework` (it has no long option of
// one '-'), so that a value's index is its word's.
pub fn read_build(line: Line<'_>, gpa: Gpa, pcx: &mut Ctx<Comp>) -> Build {
    let cmd = build_command(gpa);
    Arena::new_in(gpa).scope(|s| ({ let a = s; {
        let mut args: Vec<&str, &ArenaScope<'_, Gpa>> = Vec::new_in(a);
        args.push("volec");
        for k in 1..line.len() {
            let w = line.word(k);
            args.push(if w == "-framework" { "--framework" } else { w });
        }
        match cmd.parse_in(args.iter().copied(), a) {
            Ok(m) => apply(line, &m, pcx),
            Err(e) => build_error(line, e),
        }
    } }))
}
