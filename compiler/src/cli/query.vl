// `volec query CMD ...`'s options (0.25, on std::cli; 0.25.2: a leaf of
// volec's Command tree, cli/tree.vl). They set the query's globals; the
// NAMEs and ROOT, and the last bad option, go back to run_query_inner,
// which reports it as before (`error query.usage: unknown option '--cnt'`,
// `--in needs a FILE or MODULE`, with the try: line of the NAMEs given). A
// word with one '-' that is no option is a NAME (`query grep '-> bool'`);
// a valued option's value may not start with '-'.

use std::Vec;
use std::string::str;

use crate::base::IntVec;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{Call, EV_MISSING, EV_WORD, Leaf, Opt, flag, is_opt, option, short_option};
use crate::tools::ctx::Tcx;
use crate::tools::query::parse_count;
use crate::tools::query::grep::{G_CODE, G_COMMENT, G_STRING};

// What the options leave to run_query_inner.
pub struct QueryArgs {
    // the NAMEs (C strings, argv's), ROOT among them
    pub args: IntVec,
    // --root ROOT
    pub root: *u8,
    // the last bad option as written (0: none); bad_value: it lacks its
    // value (or the value is no number), else it is unknown
    pub bad: *u8,
    pub bad_value: bool,
}

// The options of `query CMD` (`views`: --why is a flag).
pub fn query_leaf(views: bool, gpa: Gpa) -> Leaf<Gpa> {
    var o: Vec<Opt, Gpa> = Vec::new_in(gpa);
    o.push(option("root", "ROOT", "the program's root file"));
    o.push(option("in", "FILE|MODULE|ITEM", "only the uses there"));
    o.push(option("kind", "KIND,...",
        "read, write, call, init, type, use, mod, pat, def; items: fn, method, struct, const, ..."));
    // (0.25.3) items' filters (show.vl)
    o.push(option("find", "WORD", "items: those whose name holds WORD (any case if lowercase)"));
    o.push(flag("names", "items: a line each, its kind and full name"));
    o.push(option("limit", "N", "at most N lines"));
    o.push(option("budget", "TOKENS", "the answer cut to about N tokens"));
    o.push(option("over", "N", "stats: the items over N lines"));
    o.push(option("max-lines", "N", "deps: the module's size to plan for"));
    o.push(option("writes", "TABLE", "callees: the functions that write TABLE"));
    o.push(option("has", "EFFECT", "effects: the functions with EFFECT"));
    if views {
        o.push(flag("why", "why each result views what it does"));
    } else {
        o.push(option("why", "EFFECT", "why it has EFFECT (effects), FEATURE (features)"));
    }
    o.push(option("std-tree", "DIR", "std from its files in DIR"));
    o.push(short_option("C", "OPTION", "features: the build's -C"));
    o.push(flag("count", "how many, per file"));
    o.push(flag("summary", "unsafe: the counts by class, module, file"));
    o.push(flag("no-std", "unsafe: the program's sites, not std's"));
    o.push(flag("unjustified", "unsafe: the sites without UNSAFE:/SAFETY: comments"));
    o.push(flag("transitive", "callees: what they call too"));
    o.push(flag("exact", "the NAME as written, not its end"));
    o.push(flag("all", "everything, no limit or budget"));
    o.push(flag("time-passes", "the time of each phase (stderr)"));
    o.push(flag("with-comments", "show: the comments above"));
    o.push(flag("comments", "grep: in comments; items: the banners"));
    o.push(flag("undeclared", "items: the rust edition's undeclared pub functions (E3.6)"));
    o.push(flag("code", "grep: in code"));
    o.push(flag("strings", "grep: in string literals"));
    o.push(flag("word", "grep: a whole word"));
    var i = flag("ignore-case", "grep: any case");
    i.short = 'i';
    o.push(i);
    Leaf::new(o, "name")
}

// The last bad option so far: (its word's index, its text, whether it lacks
// its value).
struct Worst {
    at: i64,
    text: *u8,
    value: bool,
}

fn note(w: inout Worst, at: i64, text: *u8, value: bool) {
    if at >= w.at {
        w.at = at;
        w.text = text;
        w.value = value;
    }
}

// The value of option `name` (spelled `--name`), when it has one that
// does not start with '-' (else noted as bad).
fn value_of(c: Call<Gpa>, name: str, spelled: *u8, w: inout Worst) -> *u8 {
    var out = 0 as *u8;
    for ev in c.evs.iter() {
        if !is_opt(ev, name) {
            continue;
        }
        if ev.text.len() == 0 || ev.text.as_bytes()[0] == '-' {
            note(&w, ev.at - 1, spelled, true);
        } else {
            out = ev.value;
        }
    }
    out
}

// A count option's value (-1: not given, or bad and noted).
fn count_of(c: Call<Gpa>, name: str, spelled: *u8, w: inout Worst) -> i64 {
    var n = -1;
    for ev in c.evs.iter() {
        if !is_opt(ev, name) {
            continue;
        }
        let x = if ev.text.len() == 0 || ev.text.as_bytes()[0] == '-' { -1 }
            else { parse_count(ev.value) };
        if x < 0 {
            note(&w, ev.at - 1, spelled, true);
        } else {
            n = x;
        }
    }
    n
}

fn apply(c: Call<Gpa>, views: bool, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> QueryArgs {
    var w = Worst { at: -1, text: 0 as *u8, value: false };
    match c.last_error() {
        Option::Some(bad) => note(&w, bad.at, bad.value, bad.kind == EV_MISSING),
        Option::None => {}
    }
    tcx.opt_count = tcx.opt_count || c.m.flag("count");
    tcx.opt_transitive = tcx.opt_transitive || c.m.flag("transitive");
    tcx.opt_exact = tcx.opt_exact || c.m.flag("exact");
    tcx.opt_all = tcx.opt_all || c.m.flag("all");
    // (0.25.3: query unsafe, tools/query/unsafe_audit.vl)
    tcx.opt_summary = tcx.opt_summary || c.m.flag("summary");
    tcx.opt_no_std = tcx.opt_no_std || c.m.flag("no-std");
    tcx.opt_unjustified = tcx.opt_unjustified || c.m.flag("unjustified");
    pcx.time_passes = pcx.time_passes || c.m.flag("time-passes");
    tcx.with_comments = tcx.with_comments || c.m.flag("with-comments");
    tcx.opt_undeclared = tcx.opt_undeclared || c.m.flag("undeclared");
    if c.m.flag("comments") {
        tcx.opt_where |= G_COMMENT;
        tcx.opt_banners = true;
    }
    if c.m.flag("code") {
        tcx.opt_where |= G_CODE;
    }
    if c.m.flag("strings") {
        tcx.opt_where |= G_STRING;
    }
    tcx.opt_word = tcx.opt_word || c.m.flag("word");
    // (0.21: VOLE and Vole too)
    tcx.opt_nocase = tcx.opt_nocase || c.m.flag("ignore-case");
    // (0.17: `query views --why`, a flag)
    if views {
        tcx.opt_views_why = tcx.opt_views_why || c.m.flag("why");
    }
    // (0.19: -C, the build's features, for `query features`)
    for ev in c.evs.iter() {
        if is_opt(ev, "C") {
            crate::arch::features::arch_option(ev.value, &pcx);
        }
    }
    let given_in = value_of(c, "in", c"--in", &w);
    if given_in != 0 as *u8 {
        pcx.opt_in = given_in;
    }
    let root = value_of(c, "root", c"--root", &w);
    tcx.show_opt_names = tcx.show_opt_names || c.m.flag("names");
    let find = value_of(c, "find", c"--find", &w);
    if find != 0 as *u8 {
        tcx.opt_find = find;
    }
    let kind = value_of(c, "kind", c"--kind", &w);
    if kind != 0 as *u8 {
        tcx.opt_kind = kind;
    }
    let writes = value_of(c, "writes", c"--writes", &w);
    if writes != 0 as *u8 {
        tcx.opt_writes = writes;
    }
    let has = value_of(c, "has", c"--has", &w);
    if has != 0 as *u8 {
        tcx.opt_has = has;
    }
    if !views {
        let why = value_of(c, "why", c"--why", &w);
        if why != 0 as *u8 {
            tcx.opt_why = why;
        }
    }
    // (0.17: std from its files; front/stdtree.vl)
    let tree = value_of(c, "std-tree", c"--std-tree", &w);
    if tree != 0 as *u8 {
        pcx.std_tree = tree;
    }
    let limit = count_of(c, "limit", c"--limit", &w);
    if limit >= 0 {
        tcx.opt_limit = limit;
    }
    let over = count_of(c, "over", c"--over", &w);
    if over >= 0 {
        tcx.opt_over = over;
    }
    let budget = count_of(c, "budget", c"--budget", &w);
    if budget >= 0 {
        tcx.opt_budget = budget;
    }
    let lines = count_of(c, "max-lines", c"--max-lines", &w);
    if lines >= 0 {
        tcx.opt_max_lines = lines;
    }
    var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for ev in c.evs.iter() {
        if ev.kind == EV_WORD {
            args.push(ev.value as i64);
        }
    }
    QueryArgs { args: args, root: root, bad: w.text, bad_value: w.value }
}

// `volec query CMD ARGS...`: the Call's (words 3.. of its line).
pub fn read_query(c: Call<Gpa>, tcx: inout Tcx<Comp>, pcx: inout Ctx<Comp>) -> QueryArgs {
    apply(c, c.word(2) == "views", &tcx, &pcx)
}
