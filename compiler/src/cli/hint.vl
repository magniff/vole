// A build's first word that is no file and reads as a command (0.25.3).
// `volec build main.vl -o x` read `build` as a file to compile (`error:
// cannot read build`). A first word that is none of volec's commands, has
// no `.` or `/`, and names no file is said to be so, with the line to
// write instead: a build has no command word (`try: volec main.vl -o x`),
// and a near-miss of a command is that command (`chek`: `check`; 0.25.4:
// `exec`: `run`, which builds and runs). Its code is cli.not-a-command
// (exit 2).

use crate::base::{buf_byte, buf_bytes, buf_copy, buf_new, buf_str, c_eq};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::edit_distance;
use crate::cli::line::Line;
use crate::cli::tree::tops;
use crate::tools::ctx::Tcx;
use crate::tools::query::diagnostics::{diag, put_word, write_diags};

// Whether something is at path.
fn readable(path: &[u8]) -> bool {
    std::fs::exists(str::from_utf8(path).unwrap()).unwrap_or(false)
}

// Whether s ends with suffix.
fn ends(s: &[u8], suffix: &[u8]) -> bool {
    s.len() >= suffix.len() && s[(s.len() as i64 - suffix.len() as i64) as usize..] == suffix
}

// The program a file makes by default: its name without directory and .vl.
fn stem(path: &[u8]) -> &[u8] {
    let mut from = path.len() as i64;
    while from > 0 && path[(from - 1) as usize] != b'/' {
        from -= 1;
    }
    let to = if ends(path, b".vl") { path.len() as i64 - 3 } else { path.len() as i64 };
    if to > from { &path[from as usize..to as usize] } else { b"main" }
}

// The command `word` is closest to, when it is near one (a letter or two
// off), or "".
fn near_command(word: &str) -> &str {
    let mut best: &str = "";
    let mut best_d: i64 = if word.len() <= 4 { 2 } else { 3 };
    for t in tops() {
        let d = edit_distance(word.as_bytes(), t.as_bytes());
        if d < best_d {
            best = t;
            best_d = d;
        }
    }
    best
}

// `try: volec` (as it was run).
fn put_try(out: i64, pcx: &Ctx<Comp>) {
    buf_str(out, c"try: ");
    buf_str(out, if pcx.diag_prog == 0 as *mut u8 { c"volec" } else { pcx.diag_prog });
}

// A build without the command word: words 2.. of line, then `-o STEM`
// when no output is given (main.vl when no file is).
fn put_build(out: i64, line: Line<'_>) {
    let mut file: &[u8] = b"";
    let mut output = false;
    for k in 2..line.len() {
        let w = line.word(k).as_bytes();
        if ends(w, b".vl") && file.len() == 0 {
            file = w;
        }
        if w == b"-o" || w == b"-c" || w == b"-S" || w == b"--emit-asm" {
            output = true;
        }
    }
    if file.len() == 0 {
        put_word(out, b"main.vl");
    }
    for k in 2..line.len() {
        put_word(out, line.word(k).as_bytes());
    }
    if !output {
        put_word(out, b"-o");
        put_word(out, stem(if file.len() == 0 { b"main.vl" } else { file }));
    }
}

// When word 1 of a build's line (`first`, its first input) is no file and
// reads as a command: the error said, and its exit status (2); else -1.
pub fn not_a_command(line: Line<'_>, first: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let w = line.word(1);
    let b = w.as_bytes();
    if line.len() < 2 || !c_eq(first, b) || b.len() == 0 || b[0] == b'-' {
        return -1;
    }
    for i in 0..b.len() {
        if b[i] == b'.' || b[i] == b'/' {
            return -1;
        }
    }
    if readable(b) {
        return -1;
    }
    let out = diag(c"error", c"cli.not-a-command", tcx);
    buf_byte(out, b'\'');
    buf_bytes(out, b);
    buf_str(out, c"' is not a volec command or a file");
    if w == "build" || w == "compile" || w == "make" {
        buf_str(out, c": a build names its files, with no command word\n");
        put_try(out, pcx);
        put_build(out, line);
    } else if w == "version" {
        buf_byte(out, b'\n');
        put_try(out, pcx);
        buf_str(out, c" --version");
    } else {
        // (a near-miss of a command, or one of another tool's)
        let mut cmd = near_command(w);
        if w == "format" {
            cmd = "fmt";
        } else if w == "exec" || w == "start" {
            // (0.25.4: `volec run [DIR]` builds and runs)
            cmd = "run";
        } else if w == "doc" || w == "docs" || w == "learn" {
            cmd = "guide";
        }
        let program = buf_new();
        buf_bytes(program, b);
        buf_str(program, c".vl");
        if cmd.len() > 0 {
            buf_str(out, c"; did you mean '");
            buf_bytes(out, cmd.as_bytes());
            buf_str(out, c"'?\n");
            put_try(out, pcx);
            put_word(out, cmd.as_bytes());
            for k in 2..line.len() {
                put_word(out, line.word(k).as_bytes());
            }
        } else if readable(&buf_copy(program)) {
            buf_byte(out, b'\n');
            put_try(out, pcx);
            put_word(out, &buf_copy(program));
            for k in 2..line.len() {
                put_word(out, line.word(k).as_bytes());
            }
            put_word(out, b"-o");
            put_word(out, b);
        } else {
            buf_byte(out, b'\n');
            put_try(out, pcx);
            buf_str(out, c" --help");
        }
    }
    buf_byte(out, b'\n');
    write_diags(tcx);
    2
}
