// A command line as std::cli parsed it, in argv's order (0.25): the
// commands whose meaning depends on the order of their options (`edit
// patch NAME --old A --new B --in OTHER --old C --new D`: the pairs after
// `--in` are OTHER's; `each --new follows its --old`) read these events in
// order, as they read argv before. A command lists its options in a table
// of Opts; `command_of` makes the std::cli Command, `events` parses
// (going on after an error: the error is an event too, where it is) and
// puts each flag, option value, word and error in argv's order.
//
// (std::cli 0.24 keeps each option's values, not their order among other
// options; a value's place is found by the argv element it views, a
// flag's by its spelling at a place no value, word or error has.)

use crate::base::IntVec;
use crate::cli::{ArgvIter, arg_str, argv_index, c_val, short_of, whole};
use std::{Gpa, Option, ScopedArena, Vec, arena_scope};
use std::cli::{Arg, CliErrorKind, Command, Matches};
use std::string::str;

pub const FLAG: i64 = 0;
pub const OPTION: i64 = 1;

// An option of a command: `--NAME` (and `-S` when short is S), a flag or
// an option with a value.
#[derive(Clone)]
pub struct Opt {
    pub name: str,
    pub short: u8,
    pub kind: i64,
    pub value_name: str,
    pub help: str,
}

// A flag `--name`.
pub fn flag(name: str, help: str) -> Opt {
    Opt { name: name, short: 0, kind: FLAG, value_name: "", help: help }
}

// An option `--name VALUE`.
pub fn option(name: str, value_name: str, help: str) -> Opt {
    Opt { name: name, short: 0, kind: OPTION, value_name: value_name, help: help }
}

// An option with a one-letter form only, `-c VALUE` (its name: `c`).
pub fn short_option(c: str, value_name: str, help: str) -> Opt {
    Opt { name: c, short: c.as_bytes()[0], kind: OPTION, value_name: value_name, help: help }
}

// The Command of name (`edit patch`) with opts and the words `word`.
pub fn command_of(name: str, about: str, opts: Vec<Opt>, word: str, gpa: Gpa) -> Command {
    var cmd = Command::new_in(name, gpa).about(about);
    for o in opts.iter() {
        if o.name == word {
            // (Matches would give the option's values for the words)
            std::panic_str("volec: a command's words are named as one of its options");
        }
        var a = if o.kind == FLAG { Arg::flag(o.name) } else { Arg::option(o.name) };
        a = a.help(o.help);
        if o.value_name.len() > 0 {
            a = a.value_name(o.value_name);
        }
        if o.short != 0 {
            a = a.short(o.short);
            if o.name.len() == 1 {
                a = a.long("");
            }
        }
        cmd = cmd.arg(a);
    }
    cmd.arg(Arg::positional(word).multiple())
}

// What an event is.
pub const EV_FLAG: i64 = 0;
pub const EV_OPTION: i64 = 1;
pub const EV_WORD: i64 = 2;
// an option that is none (`--bogus`, `--dry-run=1`): value is the token
pub const EV_UNKNOWN: i64 = 3;
// an option without its value at the end: name is its name
pub const EV_MISSING: i64 = 4;

// One flag, option, word or error of a command line, at argv[at].
#[derive(Clone)]
pub struct Ev {
    pub at: i64,
    pub kind: i64,
    // the option's name (an Opt's), "" for a word or an unknown option
    pub name: str,
    // the option's value or the word (argv's own C string when whole, a
    // dash word with its '-'), the unknown option as given
    pub value: *u8,
}

// Whether v holds k.
fn holds(v: IntVec, k: i64) -> bool {
    for j in 0..v.count {
        if unsafe { v.data[j] } == k {
            return true;
        }
    }
    false
}

fn collect(argc: i64, argv: **u8, from: i64, opts: Vec<Opt>, word: str, m: Matches<ScopedArena>,
    errs: IntVec, out: inout Vec<Ev>) {
    // the places taken: values, words, errors
    var taken = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for k in 0..errs.count / 2 {
        let at = unsafe { errs.data[2 * k] };
        let kind = unsafe { errs.data[2 * k + 1] };
        taken.push(at);
        let tok = unsafe { argv[at] };
        if kind == 1 {
            out.push(Ev { at: at, kind: EV_MISSING, name: short_of(arg_str(tok)), value: tok });
        } else {
            out.push(Ev { at: at, kind: EV_UNKNOWN, name: "", value: tok });
        }
    }
    for o in opts.iter() {
        if o.kind == OPTION {
            for v in m.values(o.name) {
                let at = argv_index(argc, argv, whole(argc, argv, v));
                taken.push(at);
                out.push(Ev { at: at, kind: EV_OPTION, name: o.name, value: c_val(argc, argv, v) });
            }
        }
    }
    for v in m.values(word) {
        let at = argv_index(argc, argv, whole(argc, argv, v));
        taken.push(at);
        out.push(Ev { at: at, kind: EV_WORD, name: "", value: c_val(argc, argv, v) });
    }
    for o in opts.iter() {
        if o.kind == FLAG && m.count(o.name) > 0 {
            for k in from..argc {
                if holds(taken, k) {
                    continue;
                }
                let s = arg_str(unsafe { argv[k] });
                let b = s.as_bytes();
                let long = b.len == o.name.len() + 2
                    && s.strip_prefix("--").unwrap_or("") == o.name;
                let short = o.short != 0 && b.len == 2 && b[0] == '-' && b[1] == o.short;
                if long || short {
                    out.push(Ev { at: k, kind: EV_FLAG, name: o.name, value: unsafe { argv[k] } });
                }
            }
        }
    }
    // in argv's order (an insertion sort: a command line is short)
    for i in 1..out.len() {
        var j = i;
        while j > 0 && out[j - 1].at > out[j].at {
            let (at, kind, name, value) = (out[j - 1].at, out[j - 1].kind, out[j - 1].name,
                out[j - 1].value);
            out[j - 1] = Ev {
                at: out[j].at, kind: out[j].kind, name: out[j].name, value: out[j].value
            };
            out[j] = Ev { at: at, kind: kind, name: name, value: value };
            j -= 1;
        }
    }
}

// argv[from..argc] parsed with opts and the words `word` (a word with one
// '-' is a word but `shorts`, ` -i -C `): every event in argv's order.
pub fn events(name: str, opts: Vec<Opt>, word: str, shorts: str, argc: i64, argv: **u8,
    from: i64, gpa: Gpa) -> Vec<Ev> {
    events_in(name, opts, word, shorts, argc, argv, from, false, gpa)
}

// events, with `--overlay PATH COPY` read as options overlay and
// overlay-copy (an Opt each) when `overlay`.
pub fn events_in(name: str, opts: Vec<Opt>, word: str, shorts: str, argc: i64, argv: **u8,
    from: i64, overlay: bool, gpa: Gpa) -> Vec<Ev> {
    events_twos(name, opts, word, shorts, argc, argv, from,
        if overlay { " --overlay " } else { "" }, gpa)
}

// events, with options of two values (` --rename --type `, or ` --overlay
// `): `--rename A B` as an option rename (A) then an option `2nd` (B), an
// Opt of opts too (`--overlay`'s: `overlay-copy`).
pub fn events_twos(name: str, opts: Vec<Opt>, word: str, shorts: str, argc: i64, argv: **u8,
    from: i64, twos: str, gpa: Gpa) -> Vec<Ev> {
    let cmd = command_of(name, "", opts.clone(), word, gpa);
    var out: Vec<Ev> = Vec::new_in(gpa);
    arena_scope(gpa, |a| {
        // the errors: (argv index, 1 a missing value | 0 any other)
        var errs = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var skip = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        loop {
            var it = ArgvIter::new(argv, from, argc, name, false).with_dash_words(shorts)
                .skipping(skip);
            if twos == " --overlay " {
                it = it.with_overlay();
            } else if twos.len() > 0 {
                it = it.with_twos(twos);
            }
            match cmd.parse_in(it, a) {
                Ok(m) => {
                    collect(argc, argv, from, opts.clone(), word, m, errs, &out);
                    break;
                }
                Err(e) => {
                    let k = argv_index(argc, argv, e.text);
                    if k < from || holds(skip, k) {
                        std::panic_str("volec: an error of the command line at no argument");
                    }
                    skip.push(k);
                    errs.push(k);
                    errs.push(if e.kind == CliErrorKind::MissingValue { 1 } else { 0 });
                }
            }
        }
    });
    out
}

// The C string's text.
pub fn text(p: *u8) -> str {
    arg_str(p)
}

// Whether ev is option or flag `name`.
pub fn is(ev: Ev, name: str) -> bool {
    (ev.kind == EV_FLAG || ev.kind == EV_OPTION || ev.kind == EV_MISSING) && ev.name == name
}

// An Option of the value of ev, for `match`.
pub fn value_of(ev: Ev) -> Option<*u8> {
    if ev.kind == EV_OPTION { Option::Some(ev.value) } else { Option::None }
}
