// A command line and its parse on volec's Command tree (0.25.2; 0.25.3:
// on 0.25.2's std::cli).
//
// A Line is the words of a command line, the program's name first:
// std::env::args()'s (main), or a batch's or a script's line. Its words
// are std::cli's arguments as they are; a value's place in the line is
// its index among them (Matches::indices_of): the order of different
// options' values (`edit patch`'s pairs after `--in`, the link's `-l`,
// `-L` and objects).
//
// `parse` reads a line with the tree (tree.vl) along a path of commands
// named at fixed places (`volec query refs ...`: words 1 and 2), as volec
// read them before; it goes on after an error (the word is taken out and
// the rest read again: std::cli stops at the first), so a command still
// reports its first, or last, bad option with what else it was given.
// The Call it gives a command holds the Matches of its own level and its
// arguments in the line's order (Ev): its flags, option values, words and
// errors.

use std::{Gpa, Option, Vec};
use std::cli::{CliErrorKind, Command, Matches};
use std::string::str;

use crate::base::{IntVec, buf_bytes, buf_new, cstr};
use crate::cli::{c_of, short_of};
use crate::tools::proc::buf_cstr;

// A command's arguments in the line's order (0.25): the commands whose
// meaning depends on the order of their options (`edit patch NAME --old A
// --new B --in OTHER --old C --new D`: the pairs after `--in` are OTHER's;
// `each --new follows its --old`) read these events in order. A command
// lists its options in a table of Opts (its Leaf); parse (below) puts each
// flag, option value, word and error in the line's order.

pub const FLAG: i64 = 0;
pub const OPTION: i64 = 1;

// An option of a command: `--NAME` (and `-S` when short is S), a flag or
// an option with a value (`values` of them each time: 2 for `--overlay
// PATH COPY`, Arg::num_values). `shared`: one of the options the editing
// commands share (tools::edit::cli::edit_opts), `edit`'s global ones.
#[derive(Clone)]
pub struct Opt {
    pub name: str,
    pub short: u8,
    pub kind: i64,
    pub value_name: str,
    pub help: str,
    pub values: i64,
    pub shared: bool,
}

// A flag `--name`.
pub fn flag(name: str, help: str) -> Opt {
    Opt {
        name: name, short: 0, kind: FLAG, value_name: "", help: help, values: 0, shared: false,
    }
}

// An option `--name VALUE`.
pub fn option(name: str, value_name: str, help: str) -> Opt {
    Opt {
        name: name, short: 0, kind: OPTION, value_name: value_name, help: help, values: 1,
        shared: false,
    }
}

// An option of two values, `--name A B` (`--overlay PATH COPY`): its
// values one event each, in order.
pub fn pair(name: str, value_name: str, help: str) -> Opt {
    Opt {
        name: name, short: 0, kind: OPTION, value_name: value_name, help: help, values: 2,
        shared: false,
    }
}

// An option with a one-letter form only, `-c VALUE` (its name: `c`).
pub fn short_option(c: str, value_name: str, help: str) -> Opt {
    Opt {
        name: c, short: c.as_bytes()[0], kind: OPTION, value_name: value_name, help: help,
        values: 1, shared: false,
    }
}

// What an event is.
pub const EV_FLAG: i64 = 0;
// a value of an option (each of an option of two values); of a leaf's
// `last`, the words after `--`
pub const EV_OPTION: i64 = 1;
pub const EV_WORD: i64 = 2;
// an option that is none (`--bogus`, `--dry-run=1`): value is the token
pub const EV_UNKNOWN: i64 = 3;
// an option without its value at the end: name is its name
pub const EV_MISSING: i64 = 4;

// One flag, option, word or error of a command line, at its word `at`.
#[derive(Clone)]
pub struct Ev {
    pub at: i64,
    pub kind: i64,
    // the option's name (an Opt's), "" for a word or an unknown option
    pub name: str,
    // the option's value or the word, the unknown option as given; and as
    // a C string, for the compiler's tables
    pub text: str,
    pub value: *u8,
}

// Whether ev is option or flag `name`.
pub fn is(ev: Ev, name: str) -> bool {
    (ev.kind == EV_FLAG || ev.kind == EV_OPTION || ev.kind == EV_MISSING) && ev.name == name
}

// An Option of the value of ev, for `match`.
pub fn value_of(ev: Ev) -> Option<*u8> {
    if ev.kind == EV_OPTION { Option::Some(ev.value) } else { Option::None }
}

// Whether ev is flag `name`.
pub fn is_flag(ev: Ev, name: str) -> bool {
    ev.kind == EV_FLAG && ev.name == name
}

// Whether ev is a value of option `name`.
pub fn is_opt(ev: Ev, name: str) -> bool {
    ev.kind == EV_OPTION && ev.name == name
}

// Whether ev is option `name` without its value (at the end).
pub fn is_missing(ev: Ev, name: str) -> bool {
    ev.kind == EV_MISSING && ev.name == name
}

// A table of options, empty, for a command's `push`es.
pub fn table(gpa: Gpa) -> Vec<Opt> {
    Vec::new_in(gpa)
}

// ev's option as `--NAME` (a C string): for a command line made again
// (`--timeout=5` is `--timeout 5` there).
pub fn long_of(ev: Ev) -> *u8 {
    let b = buf_new();
    buf_bytes(b, "--".as_bytes());
    buf_bytes(b, ev.name.as_bytes());
    buf_cstr(b)
}

// The words of a command line, the program's name first.
#[derive(Clone)]
pub struct Line {
    pub words: [str],
}

impl Line {
    // The number of words (the program's name counted).
    pub fn len(self) -> i64 {
        self.words.len
    }

    // Word k, or "" past the end.
    pub fn word(self, k: i64) -> str {
        if k >= 0 && k < self.words.len { self.words[k] } else { "" }
    }

    // Word k as a C string (a copy), for the compiler's tables.
    pub fn c(self, k: i64) -> *u8 {
        c_of(self.word(k))
    }

    // Whether a word after the program's name is w.
    pub fn has(self, w: str) -> bool {
        for k in 1..self.words.len {
            if self.words[k] == w {
                return true;
            }
        }
        false
    }

    // The index of the word that s views (an error's text: std::cli's
    // CliError gives the argument as written, not its index), or -1.
    pub fn at(self, s: str) -> i64 {
        let p = s.as_bytes().ptr as i64;
        for k in 0..self.words.len {
            let w = self.words[k].as_bytes();
            let start = w.ptr as i64;
            if p >= start && p <= start + w.len {
                return k;
            }
        }
        -1
    }
}

// A C string's text as a word of a line (a batch's or a script's words;
// one that is not UTF-8: "").
pub fn word_of(p: *u8) -> str {
    str::from_utf8(cstr(p)).unwrap_or("")
}

// The line's words as C strings (copies), for a static (which holds no
// views) and for running the command again.
pub fn c_words(line: Line) -> IntVec {
    var out = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for w in line.words {
        out.push(c_of(w) as i64);
    }
    out
}

// Word k of words (c_words'), a C string.
pub fn c_word_at(words: IntVec, k: i64) -> *u8 {
    let p = words.get(k);
    // UNSAFE: an IntVec (the compiler's own array) holds the C strings'
    // pointers as integers.
    // SAFETY: p is one c_words (or a caller of exec_words) pushed: a C
    // string's pointer, never freed.
    unsafe { p as *u8 }
}

// How a command's arguments are read (its leaf of the tree): its options,
// the name of its words (a positional that takes a word starting with '-'
// that is none of its options: `query grep '-> bool'`), and the name of
// the words after `--` ("": none; `probe ... -- ARGS`, Arg::last), whose
// events are EV_OPTIONs of that name.
#[derive(Clone)]
pub struct Leaf {
    pub opts: Vec<Opt>,
    pub word: str,
    pub last: str,
}

impl Leaf {
    // A leaf of opts, its words named word.
    pub fn new(opts: sink Vec<Opt>, word: str) -> Leaf {
        Leaf { opts: opts, word: word, last: "" }
    }

    // With the words after `--` named last.
    pub fn with_last(sink self, last: str) -> Leaf {
        self.last = last;
        self
    }
}

// A leaf of no options and no words (a command that reads none).
pub fn no_leaf(gpa: Gpa) -> Leaf {
    Leaf::new(Vec::new_in(gpa), "word")
}

// A command's arguments, parsed: its line, the index of its first
// argument, the Matches of the line (`root`: the program's level, whose
// subcommand() is the command) and of the command's own level (`m`), and
// its arguments in the line's order.
pub struct Call {
    pub line: Line,
    pub from: i64,
    pub root: Matches,
    pub m: Matches,
    pub evs: Vec<Ev>,
    pub gpa: Gpa,
}

impl Call {
    // The program's name as a C string (PROG, the try: lines' first word).
    pub fn prog(self) -> *u8 {
        self.line.c(0)
    }

    // Word k of the line ("" past the end).
    pub fn word(self, k: i64) -> str {
        self.line.word(k)
    }

    // The last error among the arguments (EV_UNKNOWN, EV_MISSING), if any.
    pub fn last_error(self) -> Option<Ev> {
        var out: Option<Ev> = Option::None;
        for ev in self.evs.iter() {
            if ev.kind == EV_UNKNOWN || ev.kind == EV_MISSING {
                out = Option::Some(ev);
            }
        }
        out
    }
}

// The line read with tree, the commands top and sub ("": none) named at
// words 1 and 2 (or spelled otherwise: `refactor --script` is `refactor
// script`), the command's arguments from `from` on being leaf's: a Call.
// An error does not stop the reading: its word is left out and the rest
// read again, the error an event where it is.
pub fn parse(tree: Command, line: Line, top: str, sub: str, from: i64, leaf: Leaf, gpa: Gpa)
    -> Call {
    var errs: Vec<Ev> = Vec::new_in(gpa);
    var skip: Vec<i64> = Vec::new_in(gpa);
    loop {
        // std::cli's arguments: the program's name, the commands named, the
        // words from `from` on but those left out; at: each one's word
        // (-1: a command named otherwise)
        var args: Vec<str> = Vec::new_in(gpa);
        var at: Vec<i64> = Vec::new_in(gpa);
        args.push(line.word(0));
        at.push(0);
        if top.len() > 0 {
            args.push(top);
            at.push(-1);
        }
        if sub.len() > 0 {
            args.push(sub);
            at.push(-1);
        }
        for k in from..line.len() {
            if !skip.contains(k) {
                args.push(line.words[k]);
                at.push(k);
            }
        }
        match tree.parse_in(args.iter(), gpa) {
            Ok(m) => {
                // (top is a command: the root's subcommand)
                var level = match m.subcommand() {
                    Option::Some((_, s)) => s,
                    Option::None => std::panic_str("volec: a command named is not matched"),
                };
                if sub.len() > 0 {
                    level = match level.subcommand() {
                        Option::Some((_, s)) => s,
                        Option::None => std::panic_str("volec: a command named is not matched"),
                    };
                }
                let evs = events_of(line, from, at, leaf, level, errs, gpa);
                return Call { line: line, from: from, root: m, m: level, evs: evs, gpa: gpa };
            }
            Err(e) => {
                let k = line.at(e.text);
                if k < from || skip.contains(k) {
                    std::panic_str("volec: an error of the command line at no argument");
                }
                skip.push(k);
                let w = line.words[k];
                if e.kind == CliErrorKind::MissingValue {
                    errs.push(Ev {
                        at: k, kind: EV_MISSING, name: short_of(w), text: w, value: c_of(w),
                    });
                } else {
                    errs.push(Ev { at: k, kind: EV_UNKNOWN, name: "", text: w, value: c_of(w) });
                }
            }
        }
    }
}

// The word of argument i (at: parse's), or -1.
fn word_at(at: Vec<i64>, i: i64) -> i64 {
    if i >= 0 && i < at.len() { at[i] } else { -1 }
}

// The events of m (the command's level), errs among them, in the line's
// order: each flag, option value and word at its word (indices_of). A
// word `--name` before the line's `--` is an unknown option: the words'
// positional takes it (allow_hyphen_values takes any word that is none of
// the command's options), where std::cli would have reported it.
fn events_of(line: Line, from: i64, at: Vec<i64>, leaf: Leaf, m: Matches, errs: sink Vec<Ev>,
    gpa: Gpa) -> Vec<Ev> {
    var out = errs;
    // the words that are options' values (a `--` among them ends nothing)
    var valued: Vec<i64> = Vec::new_in(gpa);
    for o in leaf.opts.iter() {
        let places = m.indices_of(o.name);
        if o.kind == OPTION {
            let vs = m.values(o.name);
            for j in 0..places.len() {
                let k = word_at(at, places[j]);
                valued.push(k);
                out.push(Ev {
                    at: k, kind: EV_OPTION, name: o.name, text: vs[j], value: c_of(vs[j]),
                });
            }
        } else {
            for i in places {
                let k = word_at(at, i);
                out.push(Ev {
                    at: k, kind: EV_FLAG, name: o.name, text: line.word(k), value: line.c(k),
                });
            }
        }
    }
    var end = line.len();
    for k in from..line.len() {
        if line.words[k] == "--" && !valued.contains(k) {
            end = k;
            break;
        }
    }
    let words = m.values(leaf.word);
    let places = m.indices_of(leaf.word);
    for j in 0..places.len() {
        let k = word_at(at, places[j]);
        let w = words[j];
        let unknown = k < end && w.len() > 2 && w.starts_with("--");
        out.push(Ev {
            at: k, kind: if unknown { EV_UNKNOWN } else { EV_WORD }, name: "", text: w,
            value: c_of(w),
        });
    }
    if leaf.last.len() > 0 {
        let rest = m.values(leaf.last);
        let places = m.indices_of(leaf.last);
        for j in 0..places.len() {
            let k = word_at(at, places[j]);
            out.push(Ev {
                at: k, kind: EV_OPTION, name: leaf.last, text: rest[j], value: c_of(rest[j]),
            });
        }
    }
    // in the line's order (an insertion sort: a command line is short)
    for i in 1..out.len() {
        var j = i;
        while j > 0 && out[j - 1].at > out[j].at {
            out.swap(j - 1, j);
            j -= 1;
        }
    }
    out
}
