// `volec run [DIR] [OPTIONS] [-- ARGS...]` (0.25.4): the program whose root
// is DIR/main.vl (DIR: the current directory when none is given) built as
// a plain build builds it, with a build's options (-O, -l, -L, C files and
// objects, -framework, --check-alloc...; --target the host's only), then
// run: stdin, stdout and stderr its own, the words after `--` its
// arguments, its exit status volec's (128 + N when signal N ended it, as a
// shell says).
//
// The program is kept in volec's cache, never in DIR: CACHE/run/NAME-KEY/
// NAME, CACHE the tools' cache (./target/volec-cache, $VOLE_CACHE) or else
// $TMPDIR/volec-cache, which the code cache then uses too (incremental
// rebuilds); NAME the folder's name; KEY the root's absolute path and the
// options, hashed. It is built again only when a .vl file under DIR or a
// file of the link is newer, or another compiler runs: `volec test`'s
// up_to_date and install (tools/testrun/program.vl). `-o FILE` keeps a copy
// at FILE too.
//
// On a terminal the build's lines (`Compiling`, `Finished NAME in 0.4s`;
// `Finished` alone when nothing changed), then `Running NAME` (base::term);
// elsewhere (a pipe, an agent, a test) only the program's own output. With
// $VOLE_CACHE_TRACE (a file) a line `run fresh` or `run build`.

use std::alloc::ArenaScope; use std::alloc::Arena;
use std::fs::metadata; use std::fs::read_dir;

use crate::host_target;
use crate::back::codecache::hash::{hash_bytes, mix};
use crate::back::objfile::output::is_link_input;
use crate::base::{IntVec, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, cstr, die2};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::target_of_name;
use crate::base::term::run_status;
use crate::cli::c_of;
use crate::cli::build::build_command;
use crate::cli::line::Line;
use crate::front::embed::wgsl::WgslCx;
use crate::tools::ctx::{Tcx, tcx_new};
use crate::tools::proc::{
    absolute_path, buf_cstr, exec_words, keep_mode, make_dirs, remove_file, run_foreground,
};
use crate::tools::query::cache::{cache_dir_or, ident};
use crate::tools::query::diagnostics::{diag, put_word, write_diags};
use crate::tools::testrun::program::{install, up_to_date};

// What run's options say, words 2.. of its line before `--` (0: not given).
#[derive(Clone, Copy)] struct RunLine {
    // whether a build reads them (else the build's own error is given)
    parsed: bool,
    // the words that are neither options, their values nor files of the
    // link: the folder, a second one, a .vl file
    dir: *mut u8,
    second: *mut u8,
    dirs: i64,
    // (the folder's word in line)
    dir_at: i64,
    vl: *mut u8,
    vl_at: i64,
    // (the words of all those but the .vl files)
    extra: IntVec,
    // `-o FILE`'s FILE, `--target T`'s T, an option that makes no program
    out: *mut u8,
    target: *mut u8,
    refused: *mut u8,
}

// The options that make something else than a program to run.
fn refused_flags() -> [&'static str; 11] {
    ["object", "emit-asm", "emit-ir", "emit-mir", "emit-header", "emit-imports", "tokens",
        "version", "check-rules", "test-build", "coverage"]
}

// Words 2..end of line read as a build reads its options.
fn read_run(line: Line<'_>, end: i64, gpa: Gpa) -> RunLine {
    let cmd = build_command(gpa);
    Arena::new_in(gpa).scope(|s| ({ let a = s; {
        let mut args: Vec<&str, &ArenaScope<'_, Gpa>> = Vec::new_in(a);
        args.push("volec");
        for k in 2..end {
            let w = line.word(k);
            args.push(if w == "-framework" { "--framework" } else { w });
        }
        let mut r = RunLine {
            parsed: false, dir: 0 as *mut u8, second: 0 as *mut u8, dirs: 0, dir_at: -1,
            vl: 0 as *mut u8,
            vl_at: -1,
            extra: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
            out: 0 as *mut u8, target: 0 as *mut u8, refused: 0 as *mut u8,
        };
        match cmd.parse_in(args.iter().copied(), a) {
            Ok(m) => {
                r.parsed = true;
                let places = m.indices_of("input");
                let inputs = m.values("input");
                for j in 0..inputs.len() as i64 {
                    let p = inputs[j as usize];
                    let c = c_of(p);
                    if is_link_input(c) {
                        continue;
                    }
                    if p.ends_with(".vl") {
                        if r.vl == 0 as *mut u8 {
                            r.vl = c;
                            r.vl_at = places[j as usize] + 1;
                        }
                        continue;
                    }
                    r.extra.push(places[j as usize] + 1);
                    if r.dirs == 0 {
                        r.dir = c;
                        r.dir_at = places[j as usize] + 1;
                    } else if r.dirs == 1 {
                        r.second = c;
                    }
                    r.dirs += 1;
                }
                match m.get("out") {
                    Option::Some(v) => r.out = c_of(v),
                    Option::None => {}
                }
                match m.get("target") {
                    Option::Some(v) => r.target = c_of(v),
                    Option::None => {}
                }
                for f in refused_flags() {
                    let at = m.indices_of(f);
                    if r.refused == 0 as *mut u8 && at.len() as i64 > 0 {
                        r.refused = c_of(line.word(at[0] + 1));
                    }
                }
            }
            Err(_) => {}
        }
        r
    } }))
}

// Whether word k of line (before `--`) is left out of the build run
// makes: the folder's (word dir_at) or `-o FILE`'s (its -o is the cache's).
fn left_out(line: Line<'_>, k: i64, dir_at: i64) -> bool {
    if k == dir_at {
        return true;
    }
    let w = line.word(k);
    w == "-o" || (w.starts_with("-o") && w.len() > 2) || (k > 2 && line.word(k - 1) == "-o")
}

// `try: volec`, as it was run.
fn put_try(out: i64, pcx: &Ctx<Comp>) {
    buf_str(out, c"try: ");
    buf_str(out, if pcx.diag_prog == 0 as *mut u8 { c"volec" } else { pcx.diag_prog });
}

// ` run DIR` (DIR "": none), run's options from line (words 2..end but
// skip_at), then ` -- ` and the words that read as the program's
// arguments (`extra`, the other words that are no option; those after
// `--`).
fn put_run(out: i64, line: Line<'_>, end: i64, skip_at: i64, extra: IntVec, dir: &[u8]) {
    put_word(out, b"run");
    if dir.len() > 0 {
        put_word(out, dir);
    }
    for k in 2..end {
        if k != skip_at && !has(extra, k) {
            put_word(out, line.word(k).as_bytes());
        }
    }
    let mut dashes = false;
    for j in 0..extra.count {
        let k = extra.get(j);
        if k != skip_at {
            if !dashes {
                put_word(out, b"--");
                dashes = true;
            }
            put_word(out, line.word(k).as_bytes());
        }
    }
    for k in end + 1..line.len() {
        if !dashes {
            put_word(out, b"--");
            dashes = true;
        }
        put_word(out, line.word(k).as_bytes());
    }
}

// Whether v holds x.
fn has(v: IntVec, x: i64) -> bool {
    for j in 0..v.count {
        if v.get(j) == x {
            return true;
        }
    }
    false
}

// Whether s ends with suffix.
fn ends(s: &[u8], suffix: &[u8]) -> bool {
    s.len() >= suffix.len() && s[(s.len() as i64 - suffix.len() as i64) as usize..] == suffix
}

// The program's name a file makes: its name without folder and `.vl`.
fn stem(path: &[u8]) -> &[u8] {
    let mut from = path.len() as i64;
    while from > 0 && path[(from - 1) as usize] != b'/' {
        from -= 1;
    }
    let to = if ends(path, b".vl") { path.len() as i64 - 3 } else { path.len() as i64 };
    if to > from { &path[from as usize..to as usize] } else { b"main" }
}

// `try: volec FILE -o STEM && ./STEM ARGS`: a file's plain build, run.
fn put_try_file(out: i64, line: Line<'_>, end: i64, file: &[u8], given: *mut u8, pcx: &Ctx<Comp>) {
    put_try(out, pcx);
    put_word(out, file);
    for k in 2..end {
        let w = line.word(k).as_bytes();
        if w != file && w != b"run" && (given == 0 as *mut u8 || w != cstr(given)) {
            put_word(out, w);
        }
    }
    let s = stem(file);
    put_word(out, b"-o");
    put_word(out, s);
    buf_str(out, c" && ./");
    buf_bytes(out, s);
    for k in end + 1..line.len() {
        put_word(out, line.word(k).as_bytes());
    }
    buf_byte(out, b'\n');
}

// `DIR/NAME` (DIR "." left out).
fn join<'a>(dir: &'a [u8], name: &'a [u8]) -> &'a [u8] {
    let b = buf_new();
    if dir != b"." {
        buf_bytes(b, dir);
        if dir.len() > 0 && dir[(dir.len() as i64 - 1) as usize] != b'/' {
            buf_byte(b, b'/');
        }
    }
    buf_bytes(b, name);
    buf_slice(b)
}

// a then b.
fn concat<'a>(a: &'a [u8], b: &'a [u8]) -> &'a [u8] {
    let out = buf_new();
    buf_bytes(out, a);
    buf_bytes(out, b);
    buf_slice(out)
}

// The folder of a path (`.` for none).
fn folder_of(path: &[u8]) -> &[u8] {
    let mut i = path.len() as i64;
    while i > 0 && path[(i - 1) as usize] != b'/' {
        i -= 1;
    }
    if i == 0 { b"." } else if i == 1 { b"/" } else { &path[0..(i - 1) as usize] }
}

// The sorted names of dir's entries: its folders holding a main.vl
// (`subs`) and its .vl files.
fn entries(dir: &[u8], subs: &mut Vec<&[u8], Gpa>, files: &mut Vec<&[u8], Gpa>) {
    match read_dir(str::from_utf8(dir).unwrap()) {
        Ok(rd) => {
            let mut it = rd;
            loop {
                match it.next() {
                    Option::Some(Ok(e)) => {
                        let b = buf_new();
                        buf_bytes(b, e.file_name().as_bytes());
                        let name = buf_slice(b);
                        if name.len() == 0 || name[0] == b'.' {
                            continue;
                        }
                        if e.file_type().map(|t| t.is_dir()).unwrap_or(false)
                            && std::fs::exists(
                                str::from_utf8(join(join(dir, name), b"main.vl")).unwrap()).unwrap_or(false) {
                            subs.push(name);
                        } else if ends(name, b".vl") {
                            files.push(name);
                        }
                    }
                    Option::Some(Err(_)) => {}
                    Option::None => break,
                }
            }
        }
        Err(_) => {}
    }
    subs.sort_unstable();
    files.sort_unstable();
}

// run.no-main: dir (as given, `.`) is no folder, or one without main.vl.
fn no_main(line: Line<'_>, end: i64, r: RunLine, dir: &[u8], folder: bool, gpa: Gpa,
    tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let given = r.dir;
    let out = diag(c"error", c"run.no-main", tcx);
    buf_byte(out, b'\'');
    buf_bytes(out, dir);
    buf_str(out, if folder { c"' has no main.vl\n" } else { c"' is no folder\n" });
    buf_str(out, c"help: `volec run DIR` builds and runs the program whose root is DIR/main.vl (DIR: the current directory when none is given)\n");
    if !folder {
        let file = buf_new();
        buf_bytes(file, dir);
        buf_bytes(file, b".vl");
        if std::fs::exists(str::from_utf8(buf_slice(file)).unwrap()).unwrap_or(false) {
            put_try_file(out, line, end, buf_slice(file), given, pcx);
        }
        write_diags(tcx);
        return 2;
    }
    let mut subs: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    let mut files: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    entries(dir, &mut subs, &mut files);
    for k in 0..subs.len() {
        if k < 3 {
            put_try(out, pcx);
            put_run(out, line, end, r.dir_at, r.extra, join(dir, subs[k]));
            buf_byte(out, b'\n');
        }
    }
    if subs.len() == 0 && files.len() == 1 {
        put_try_file(out, line, end, join(dir, files[0]), given, pcx);
    } else if subs.len() == 0 && files.len() > 1 {
        let n = buf_new();
        buf_str(n, c"note: it holds ");
        crate::base::buf_int(n, files.len() as i64);
        buf_str(n, c" .vl files and no main.vl: build the root itself, `volec ROOT.vl -o prog`\n");
        buf_bytes(out, buf_slice(n));
    }
    write_diags(tcx);
    2
}

// run.file: a file given where run takes a folder.
fn file_given(line: Line<'_>, end: i64, r: RunLine, at: i64, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let file = c_of(line.word(at));
    let f = cstr(file);
    let out = diag(c"error", c"run.file", tcx);
    buf_byte(out, b'\'');
    buf_bytes(out, f);
    buf_str(out, c"' is a file: run takes the folder that holds main.vl\n");
    let dir = folder_of(f);
    if std::fs::exists(str::from_utf8(join(dir, b"main.vl")).unwrap()).unwrap_or(false) {
        put_try(out, pcx);
        put_run(out, line, end, at, r.extra, if dir == b"." { b"" } else { dir });
        buf_byte(out, b'\n');
    } else if ends(f, b".vl") {
        put_try_file(out, line, end, f, 0 as *mut u8, pcx);
    }
    write_diags(tcx);
    2
}

// run.args: a second folder, a program's argument without `--` before it.
fn second_dir(line: Line<'_>, end: i64, word: *mut u8, tcx: &mut Tcx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let out = diag(c"error", c"run.args", tcx);
    buf_byte(out, b'\'');
    buf_str(out, word);
    buf_str(out, c"' is a second folder, or the program's argument: run builds one program; its arguments go after --\n");
    put_try(out, pcx);
    put_word(out, b"run");
    for k in 2..end {
        let w = line.word(k).as_bytes();
        if w != cstr(word) {
            put_word(out, w);
        }
    }
    put_word(out, b"--");
    put_word(out, cstr(word));
    for k in end + 1..line.len() {
        put_word(out, line.word(k).as_bytes());
    }
    buf_byte(out, b'\n');
    write_diags(tcx);
    2
}

// run.option: an option that makes no program to run (`-c`, `-S`,
// `--emit-ir`, a target that is not the host's...).
fn refused(what: *mut u8, why: *mut u8, tcx: &mut Tcx<Comp>) -> i64 {
    let out = diag(c"error", c"run.option", tcx);
    buf_str(out, what);
    buf_str(out, why);
    buf_str(out, c"\nhelp: run builds a program for this machine and runs it; other outputs are a build's: `volec DIR/main.vl OPTIONS -o OUT`\n");
    write_diags(tcx);
    2
}

// $TMPDIR/volec-cache (/tmp without $TMPDIR).
fn tmp_cache(gpa: Gpa) -> *mut u8 {
    let b = buf_new();
    match std::env::var_in("TMPDIR", gpa) {
        Ok(t) => buf_bytes(b, t.as_bytes()),
        Err(_) => {}
    }
    if buf_slice(b).len() == 0 {
        buf_bytes(b, b"/tmp");
    }
    let s = buf_slice(b);
    if s[(s.len() as i64 - 1) as usize] != b'/' {
        buf_byte(b, b'/');
    }
    buf_bytes(b, b"volec-cache");
    buf_cstr(b)
}

// A line `word` in $VOLE_CACHE_TRACE's file, when it is set.
fn trace(word: &[u8], gpa: Gpa) {
    match std::env::var_in("VOLE_CACHE_TRACE", gpa) {
        Ok(p) => {
            let b = buf_new();
            buf_bytes(b, word);
            buf_byte(b, b'\n');
            let _ = std::fs::OpenOptions::new()
                .append(true)
                .create(true)
                .open(str::from_utf8(p.as_bytes()).unwrap())
                .and_then(|mut f| std::io::Write::write_all(&mut f, buf_slice(b).as_ref()));
        }
        Err(_) => {}
    }
}

// h as 16 hex digits.
fn put_hex(b: i64, h: u64) {
    for i in 0..16 {
        let d = ((h >> ((15 - i) * 4) as u64) & 15) as u8;
        buf_byte(b, if d < 10 { b'0' + d } else { b'a' + d - 10 });
    }
}

// Whether a file of the link among words 2..end (a C file, an object, an
// archive) is newer than the program at bin.
fn link_newer(line: Line<'_>, end: i64, bin: &[u8], dir_at: i64) -> bool {
    let built = match metadata(str::from_utf8(bin).unwrap()) {
        Ok(m) => m.modified().unwrap().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos(),
        Err(_) => return true,
    };
    for k in 2..end {
        let w = line.word(k).as_bytes();
        if !left_out(line, k, dir_at) && is_link_input(c_of(line.word(k))) {
            match metadata(str::from_utf8(w).unwrap()) {
                Ok(m) => {
                    if m
                        .modified()
                        .unwrap()
                        .duration_since(std::time::UNIX_EPOCH)
                        .unwrap()
                        .as_nanos() > built {
                        return true;
                    }
                }
                Err(_) => {}
            }
        }
    }
    false
}

// `volec run ...`: the program's exit status; 1 when it does not build, 2
// for run's own errors.
pub fn run(line: Line<'_>, gpa: Gpa, pcx: &mut Ctx<Comp>, wgx: &mut WgslCx<Arena<Gpa>>) -> i64 {
    let mut tcx = tcx_new();
    let mut end = line.len();
    for k in 2..line.len() {
        if line.word(k) == "--" {
            end = k;
            break;
        }
    }
    let r = read_run(line, end, gpa);
    if !r.parsed {
        // (the build's own error, exit 1: its options as a build reads them)
        let mut words: Vec<&str, Gpa> = Vec::new_in(gpa);
        for k in 0..end {
            if k != 1 {
                words.push(line.word(k));
            }
        }
        crate::cli::build::read_build(Line { words: words.as_slice() }, gpa, pcx);
        return 1;
    }
    if r.refused != 0 as *mut u8 {
        return refused(r.refused, c" makes no program to run", &mut tcx);
    }
    if r.target != 0 as *mut u8 {
        let t = target_of_name(r.target);
        if t != 0 && t != host_target() {
            let w = buf_new();
            buf_str(w, c"--target ");
            buf_str(w, r.target);
            return refused(buf_cstr(w),
                c": run runs the program here; a build makes it for another machine", &mut tcx);
        }
    }
    if r.vl != 0 as *mut u8 {
        return file_given(line, end, r, r.vl_at, &mut tcx, pcx);
    }
    if r.dirs > 1 {
        return second_dir(line, end, r.second, &mut tcx, pcx);
    }
    let dir: &[u8] = if r.dir == 0 as *mut u8 { b"." } else { cstr(r.dir) };
    match metadata(str::from_utf8(dir).unwrap()) {
        Ok(m) => {
            if !m.is_dir() {
                return file_given(line, end, r, r.dir_at, &mut tcx, pcx);
            }
        }
        Err(_) => return no_main(line, end, r, dir, false, gpa, &mut tcx, pcx),
    }
    let root = join(dir, b"main.vl");
    if !std::fs::exists(str::from_utf8(root).unwrap()).unwrap_or(false) {
        return no_main(line, end, r, dir, true, gpa, &mut tcx, pcx);
    }
    // Where the program is kept: CACHE/run/NAME-KEY/NAME.
    let b = buf_new();
    buf_bytes(b, root);
    let root_abs = cstr(absolute_path(buf_cstr(b)));
    let folder = folder_of(root_abs);
    let name = if folder == b"/" { b"main" } else { stem(folder) };
    let mut h = hash_bytes(root_abs.ptr, root_abs.len() as i64);
    for k in 2..end {
        if !left_out(line, k, r.dir_at) {
            let w = line.word(k).as_bytes();
            h = mix(h, hash_bytes(w.ptr, w.len() as i64));
        }
    }
    let base = cache_dir_or(tmp_cache(gpa), pcx);
    make_dirs(base);
    let d = buf_new();
    buf_str(d, absolute_path(base));
    buf_bytes(d, b"/run/");
    buf_bytes(d, name);
    buf_byte(d, b'-');
    put_hex(d, h);
    let bin_dir = buf_slice(d);
    make_dirs(buf_cstr(d));
    let bin = buf_cstr_of(join(bin_dir, name));
    // (NAME.build, NAME.key next to it, as `volec test`'s)
    let built = buf_cstr_of(join(bin_dir, concat(name, b".build")));
    let key_path = buf_cstr_of(join(bin_dir, concat(name, b".key")));
    // (the key: the compiler, whose bytes tools::query::cache::ident hashes)
    if pcx.prog == 0 as *mut u8 {
        pcx.prog = line.c(0);
    }
    let kb = buf_new();
    put_hex(kb, ident(pcx) as u64);
    buf_byte(kb, b'\n');
    let key = buf_slice(kb);
    let fresh = up_to_date(bin, key_path, key, buf_cstr_of(folder), pcx)
        && !link_newer(line, end, cstr(bin), r.dir_at);
    if fresh {
        trace(b"run fresh", gpa);
    } else {
        trace(b"run build", gpa);
        // (the build's lines name the program, not its path in the cache;
        // off a terminal they say nothing: no `ok: built`)
        pcx.shown_as = buf_cstr_of(name);
        pcx.ok_line = false;
        let mut words: Vec<&str, Gpa> = Vec::new_in(gpa);
        words.push(line.word(0));
        words.push(str::from_utf8(root).unwrap_or("main.vl"));
        for k in 2..end {
            if !left_out(line, k, r.dir_at) {
                words.push(line.word(k));
            }
        }
        words.push("-o");
        words.push(str::from_utf8(cstr(built)).unwrap_or(""));
        let status = crate::build(Line { words: words.as_slice() }, gpa, &mut tcx, pcx, wgx);
        if status != 0 {
            return status;
        }
        install(built, bin, key_path, key);
        remove_file(built);
    }
    if r.out != 0 as *mut u8 {
        match std::fs::copy(str::from_utf8(cstr(bin)).unwrap(),
            str::from_utf8(cstr(r.out)).unwrap()).map(|n| n as i64) {
            Ok(_) => keep_mode(bin, r.out),
            Err(_) => die2(c"cannot write ", r.out),
        }
    }
    run_status(fresh, name, pcx);
    // (the program's environment is volec's as it was given: VOLEC_NESTED,
    // which marks the volec processes this one starts, only when it was set)
    if !pcx.nested {
        // UNSAFE: std::env::remove_var is unsafe: the environment is not
        // guarded against other threads.
        // SAFETY: no other thread runs here: the build's code generation
        // and assembler threads were joined in compile_program
        // (middle::threads::pool_stop, asm_thread_finish), and run starts none.
        unsafe { std::env::remove_var("VOLEC_NESTED"); }
    }
    let mut argv = crate::base::IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    argv.push(bin as i64);
    for k in end + 1..line.len() {
        argv.push(c_of(line.word(k)) as i64);
    }
    run_foreground(exec_words(argv))
}

// bytes as a C string (a copy).
fn buf_cstr_of(bytes: &[u8]) -> *mut u8 {
    let b = buf_new();
    buf_bytes(b, bytes);
    buf_cstr(b)
}
