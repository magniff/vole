// The guide by piece (0.15): `guide --find WORDS` prints the paragraphs
// about WORDS (each under `# TOPIC#SECTION`), `guide TOPIC#SECTION` one
// section, `guide TOPIC#` the sections of a topic; `--budget N` keeps
// any of it to about N tokens. A paragraph is a run of lines between
// blank lines, a code block (and what follows it without a blank line)
// whole; a section starts at a `## ` heading. `explain WORDS` falls back
// on find (tools/explain).

use crate::base::{IntVec, buf_byte, buf_bytes, buf_new, buf_slice};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::guide::{render, render_doc};
use crate::guide::stdapi::{API_DOC, impl_name, item_name, std_api};
use crate::guide::text::{TOPIC_COUNT, topic_name, topic_summary};

// The budget of `--find` without --budget, in tokens.
pub const FIND_BUDGET: i64 = 1000;

fn lower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' { c - b'A' + b'a' } else { c }
}

fn line_end(s: &[u8], i: i64) -> i64 {
    let mut e = i;
    while e < s.len() as i64 && s[e as usize] != b'\n' {
        e += 1;
    }
    e
}

fn is_blank(s: &[u8]) -> bool {
    for i in 0..s.len() {
        if s[i] != b' ' && s[i] != b'\t' {
            return false;
        }
    }
    true
}

fn starts(s: &[u8], p: &[u8]) -> bool {
    s.len() >= p.len() && s[0..p.len()] == p
}

// Splits every topic into paragraphs (once).
fn split_all(pcx: &mut Ctx<Comp>) {
    if pcx.p_topic.count > 0 {
        return;
    }
    for t in 0..TOPIC_COUNT {
        let b = buf_new();
        render(t, b, pcx);
        let s = buf_slice(b);
        let mut sec: i64 = -1;
        let mut sec_end: i64 = -1;
        let mut i: i64 = 0;
        let mut start: i64 = -1;
        let mut fence = false;
        while i < s.len() as i64 {
            let e = line_end(s, i);
            let line = &s[i as usize..e as usize];
            if starts(line, b"```") {
                fence = !fence;
            }
            let blank = !fence && is_blank(line);
            let heading = !fence && (starts(line, b"## ") || starts(line, b"# "));
            if (blank || heading) && start >= 0 {
                add_paragraph(t, b, start, i, sec, sec_end, pcx);
                start = -1;
            }
            if heading {
                sec = i + (if starts(line, b"## ") { 3 } else { 2 });
                sec_end = e;
            } else if !blank && start < 0 {
                start = i;
            }
            i = e + 1;
        }
        if start >= 0 {
            add_paragraph(t, b, start, s.len() as i64, sec, sec_end, pcx);
        }
    }
}

fn add_paragraph(t: i64, b: i64, start: i64, end: i64, sec: i64, sec_end: i64, pcx: &mut Ctx<Comp>) {
    pcx.p_topic.push(t);
    pcx.p_buf.push(b);
    pcx.p_start.push(start);
    pcx.p_end.push(end);
    pcx.p_sec.push(sec);
    pcx.p_sec_end.push(sec_end);
}

// `TOPIC#section-slug` of paragraph p, to out.
fn put_where(out: i64, p: i64, pcx: &Ctx<Comp>) {
    unsafe {
        buf_bytes(out, topic_name((*pcx.p_topic.data.add(p as usize))));
        buf_byte(out, b'#');
        if (*pcx.p_sec.data.add(p as usize)) >= 0 {
            let s = buf_slice((*pcx.p_buf.data.add(p as usize)));
            put_slug(out,
                &s[
                    (*pcx.p_sec.data.add(p as usize)) as usize..(
                        *pcx.p_sec_end.data.add(p as usize)) as usize]);
        }
    }
}

// A heading as a slug: lower case, words joined by `-`, nothing but
// letters, digits and `-`.
fn put_slug(out: i64, h: &[u8]) {
    let mut dash = false;
    let mut any = false;
    for i in 0..h.len() {
        let c = lower(h[i]);
        if (c >= b'a' && c <= b'z') || (c >= b'0' && c <= b'9') {
            if dash && any {
                buf_byte(out, b'-');
            }
            buf_byte(out, c);
            dash = false;
            any = true;
        } else {
            dash = true;
        }
    }
}

// Whether text holds word (lower case already), ignoring case.
fn holds(text: &[u8], word: &[u8]) -> bool {
    if word.len() == 0 || word.len() > text.len() {
        return false;
    }
    let mut i: i64 = 0;
    while i + word.len() as i64 <= text.len() as i64 {
        // (0.21: a short word at the start of one: `read` is not in
        // `thread`; a longer one anywhere, `sha256` in `vsha256hq_u32`)
        if lower(text[i as usize]) == word[0]
            && (word.len() >= 5 || i == 0 || !word_byte(text[(i - 1) as usize])) {
            let mut k: i64 = 1;
            while k < word.len() as i64 && lower(text[(i + k) as usize]) == word[k as usize] {
                k += 1;
            }
            if k == word.len() as i64 {
                return true;
            }
        }
        i += 1;
    }
    false
}

// The occurrences of word (lower case already) in text, ignoring case.
fn count_in(text: &[u8], word: &[u8]) -> i64 {
    if word.len() == 0 || word.len() > text.len() {
        return 0;
    }
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i + word.len() as i64 <= text.len() as i64 {
        let mut k: i64 = 0;
        while k < word.len() as i64 && lower(text[(i + k) as usize]) == word[k as usize] {
            k += 1;
        }
        if k == word.len() as i64
            && (word.len() >= 5 || i == 0 || !word_byte(text[(i - 1) as usize])) {
            n += 1;
            i += word.len() as i64;
        } else {
            i += 1;
        }
    }
    n
}

// Words a question is made of that say nothing (`how to read a line`).
fn is_stop_word(w: &[u8]) -> bool {
    let stops = ["a", "an", "the", "to", "of", "in", "is", "how", "do", "i", "what", "and", "or",
        "on", "for", "with", "can", "my", "does"];
    for k in 0..19 {
        if w == stops[k as usize].as_bytes() {
            return true;
        }
    }
    false
}

// The words of `query` (lower case, without the quotes and punctuation
// around them; `a::b` and `[u8]` kept), as buffers.
fn words_of(query: &[u8], out: &mut IntVec) {
    let mut i: i64 = 0;
    while i < query.len() as i64 {
        while i < query.len() as i64
            && (query[i as usize] == b' ' || query[i as usize] == b'\t'
                || query[i as usize] == b'\n') {
            i += 1;
        }
        let mut e = i;
        while e < query.len() as i64 && query[e as usize] != b' ' && query[e as usize] != b'\t'
            && query[e as usize] != b'\n' {
            e += 1;
        }
        let mut a = i;
        let mut b = e;
        while a < b && !word_byte(query[a as usize]) && query[a as usize] != b'['
            && query[a as usize] != b'&'
            && query[a as usize] != b'*' {
            a += 1;
        }
        while b > a && !word_byte(query[(b - 1) as usize]) && query[(b - 1) as usize] != b']'
            && query[(b - 1) as usize] != b'!'
            && query[(b - 1) as usize] != b')' {
            b -= 1;
        }
        if b - a >= 2 || (b - a == 1 && word_byte(query[a as usize])) {
            let w = buf_new();
            for k in a..b {
                buf_byte(w, lower(query[k as usize]));
            }
            out.push(w);
        }
        i = e;
    }
    // (without the words that say nothing, unless nothing is left)
    unsafe {
        let mut kept: i64 = 0;
        for k in 0..out.count {
            if !is_stop_word(buf_slice((*out.data.add(k as usize)))) {
                kept += 1;
            }
        }
        if kept > 0 {
            let mut j: i64 = 0;
            for k in 0..out.count {
                let w = (*out.data.add(k as usize));
                if !is_stop_word(buf_slice(w)) {
                    (*out.data.add(j as usize)) = w;
                    j += 1;
                }
            }
            out.count = j;
        }
    }
}

fn word_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

fn is_code(s: &[u8]) -> bool {
    starts(s, b"```")
}

// (0.17) Whether name is the query word w (lower case), case aside.
fn same_name(name: &[u8], w: &[u8]) -> bool {
    if name.len() != w.len() || name.len() == 0 {
        return false;
    }
    for i in 0..name.len() {
        if lower(name[i]) != w[i] {
            return false;
        }
    }
    true
}

// (0.17) Whether a query word names item `name` (in the impl of type
// `owner`, "" outside one): `split_in`, `scanner`, `vec::push`.
fn names_item(w: &[u8], owner: &[u8], name: &[u8]) -> bool {
    let mut k = w.len() as i64 - 1;
    while k > 0 && !(w[k as usize] == b':' && w[(k - 1) as usize] == b':') {
        k -= 1;
    }
    if k > 0 {
        return same_name(owner, &w[0..(k - 1) as usize]) && same_name(name, &w[(k + 1) as usize..]);
    }
    same_name(name, w)
}

// (0.17) For `guide --find`: the std items the query's words name (a
// function or method: `split_in`, `push`, `vec::push`; a type or trait:
// `scanner`), each with its comment (a method under its impl's header; a
// type with its methods' signatures), into out within `budget` bytes;
// the bytes written.
fn std_items(words: IntVec, budget: i64, out: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let src = buf_new();
        std_api(src, API_DOC, pcx);
        let s = buf_slice(src);
        let piece = buf_new();
        let mut head: &[u8] = b"";
        let mut owner: &[u8] = b"";
        let mut head_put = false;
        let mut doc_from: i64 = -1;
        let mut i: i64 = 0;
        while i < s.len() as i64 {
            let e = line_end(s, i);
            let line = &s[i as usize..e as usize];
            let mut t = line;
            while t.len() > 0 && t[0] == b' ' {
                t = &t[1..];
            }
            if starts(t, b"//") {
                if doc_from < 0 {
                    doc_from = i;
                }
                i = e + 1;
                continue;
            }
            if starts(line, b"impl") && line.len() > 2
                && line[(line.len() as i64 - 1) as usize] == b'{' {
                head = line;
                owner = impl_name(line);
                head_put = false;
            } else if line == b"}" {
                if head_put {
                    buf_bytes(piece, b"}\n");
                }
                head = b"";
                owner = b"";
                head_put = false;
            } else {
                let it = item_name(t);
                let name = it.0;
                let mut hit = false;
                let mut whole = false;
                for k in 0..words.count {
                    let w = buf_slice((*words.data.add(k as usize)));
                    // (a word among others: only a name no prose has,
                    // `split_in`, `vec::push`; alone, any name: `sort`)
                    let named = words.count == 1 || holds(w, b"_") || holds(w, b"::");
                    if named && name.len() > 0 && names_item(w, owner, name) {
                        hit = true;
                    }
                    if named && head.len() > 0 && it.1 == false && same_name(owner, w) {
                        whole = true;
                    }
                }
                if (hit || whole) && head.len() > 0 && !head_put {
                    buf_bytes(piece, head);
                    buf_bytes(piece, b"\n");
                    head_put = true;
                }
                if hit && doc_from >= 0 {
                    buf_bytes(piece, &s[doc_from as usize..i as usize]);
                }
                if hit || whole {
                    buf_bytes(piece, line);
                    buf_bytes(piece, b"\n");
                }
            }
            doc_from = -1;
            i = e + 1;
        }
        let got = buf_slice(piece);
        if got.len() == 0 {
            return 0;
        }
        let mut n = got.len() as i64;
        if n + 16 > budget {
            n = budget - 40;
            while n > 0 && got[(n - 1) as usize] != b'\n' {
                n -= 1;
            }
        }
        if n <= 0 {
            return 0;
        }
        buf_bytes(out, b"# std#every-item\n```text\n");
        buf_bytes(out, &got[0..n as usize]);
        buf_bytes(out, b"```\n");
        n + 30
    }
}

// `guide --find QUERY`: the paragraphs holding all of its words first,
// then those holding most of them (at least 3 in 5), into out within
// `budget` bytes; the number found (0: none), and in *left those left
// out by the budget.
pub fn guide_find(query: &[u8], budget: i64, out: i64, left: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        split_all(pcx);
        let mut words = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        words_of(query, &mut words);
        *left = 0;
        if words.count == 0 {
            return 0;
        }
        let n = pcx.p_topic.count;
        let score = crate::base::alloc_array::<i64>(n + 1);
        let matched = crate::base::alloc_array::<i64>(n + 1);
        let mut picked = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        // (the whole query, as a phrase)
        let phrase = buf_new();
        for w in 0..words.count {
            if w > 0 {
                buf_byte(phrase, b' ');
            }
            buf_bytes(phrase, buf_slice((*words.data.add(w as usize))));
        }
        let mut best: i64 = 0;
        for p in 0..n {
            let text = &buf_slice((*pcx.p_buf.data.add(p as usize)))[
                (*pcx.p_start.data.add(p as usize)) as usize..(*pcx.p_end.data.add(p as usize)) as usize];
            let mut k: i64 = 0;
            let mut hits: i64 = 0;
            let place = buf_new();
            put_where(place, p, pcx);
            for w in 0..words.count {
                let c = count_in(text, buf_slice((*words.data.add(w as usize))));
                if c > 0 {
                    k += 1;
                    hits += if c > 5 { 5 } else { c };
                    // (a word of the topic or section name: about it)
                    if holds(buf_slice(place), buf_slice((*words.data.add(w as usize)))) {
                        hits += 5;
                    }
                    // (0.19: a word of the topic's summary, topics.txt: the
                    // topic is about it, as arch is about avx2 and popcount)
                    if holds(topic_summary((*pcx.p_topic.data.add(p as usize))),
                        buf_slice((*words.data.add(w as usize)))) {
                        hits += 6;
                    }
                }
            }
            (*matched.add(p as usize)) = k;
            (*score.add(p as usize)) = k * 100 + hits + (if words.count > 1
                && holds(text, buf_slice(phrase)) { 50 }
                else { 0 });
            if k > best {
                best = k;
            }
        }
        // (all the words when some paragraph has them all; else most)
        for p in 0..n {
            let k = (*matched.add(p as usize));
            if k > 0 && (k == words.count || (best < words.count && k * 5 >= words.count * 3)) {
                picked.push(p);
            }
        }
        // (the best first; in the guide's order among equals)
        for a in 1..picked.count {
            let mut b = a;
            while b > 0
                && (*score.add((*picked.data.add((b - 1) as usize)) as usize))
                < (*score.add((*picked.data.add(b as usize)) as usize)) {
                let t = (*picked.data.add(b as usize));
                (*picked.data.add(b as usize)) = (*picked.data.add((b - 1) as usize));
                (*picked.data.add((b - 1) as usize)) = t;
                b -= 1;
            }
        }
        // (0.17: the std items it names first, in half the budget at most;
        // the paragraphs then in the other half)
        let items = std_items(words, budget / 2, out, pcx);
        let mut room = if items > 0 { budget / 2 } else { budget };
        let mut shown: i64 = 0;
        let mut last_where = buf_new();
        for i in 0..picked.count {
            let p = (*picked.data.add(i as usize));
            let piece = buf_new();
            let w = buf_new();
            put_where(w, p, pcx);
            if buf_slice(w) != buf_slice(last_where) {
                buf_bytes(piece, b"# ");
                buf_bytes(piece, buf_slice(w));
                buf_byte(piece, b'\n');
            }
            let s = buf_slice((*pcx.p_buf.data.add(p as usize)));
            buf_bytes(piece,
                &s[
                    (*pcx.p_start.data.add(p as usize)) as usize..(*pcx.p_end.data.add(p as usize)) as usize]);
            // (a paragraph's example: the code block right after it)
            if !is_code(
                &s[
                    (*pcx.p_start.data.add(p as usize)) as usize..(*pcx.p_end.data.add(p as usize)) as usize]) && p + 1 < n
                && (*pcx.p_buf.data.add((p + 1) as usize)) == (*pcx.p_buf.data.add(p as usize))
                && is_code(
                    &s[
                        (*pcx.p_start.data.add((p + 1) as usize)) as usize..(
                            *pcx.p_end.data.add((p + 1) as usize)) as usize])
                && (*matched.add((p + 1) as usize)) < words.count {
                buf_bytes(piece,
                    &s[
                        (*pcx.p_start.data.add((p + 1) as usize)) as usize..(
                            *pcx.p_end.data.add((p + 1) as usize)) as usize]);
            }
            if buf_slice(piece).len() as i64 > room {
                *left = *left + 1;
                continue;
            }
            buf_bytes(out, buf_slice(piece));
            room -= buf_slice(piece).len() as i64;
            last_where = w;
            shown += 1;
        }
        // (0.16: none within the budget: the first one's place, and
        // find_command's try shows it)
        if shown == 0 && items == 0 && picked.count > 0 {
            pcx.find_over = buf_new();
            put_where(pcx.find_over, (*picked.data.add(0)), pcx);
            buf_bytes(out, b"# ");
            buf_bytes(out, buf_slice(pcx.find_over));
            buf_bytes(out, b"\n");
        }
        picked.count + (if items > 0 { 1 } else { 0 })
    }
}

// `guide TOPIC#SECTION` (topic t): the section whose heading's slug is
// `want` or starts with it (or holds it), from its heading to the next,
// into out; false when there is none. `TOPIC#`: the sections' names.
pub fn guide_section(t: i64, want0: &[u8], out: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let b = buf_new();
        render_doc(t, b, pcx);
        let s = buf_slice(b);
        let want = buf_new();
        put_slug(want, want0);
        let w = buf_slice(want);
        // The headings and their slugs.
        let mut heads = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut i: i64 = 0;
        let mut fence = false;
        while i < s.len() as i64 {
            let e = line_end(s, i);
            let line = &s[i as usize..e as usize];
            if starts(line, b"```") {
                fence = !fence;
            }
            if !fence && starts(line, b"## ") {
                heads.push(i);
            }
            i = e + 1;
        }
        if w.len() == 0 {
            for k in 0..heads.count {
                buf_bytes(out, topic_name(t));
                buf_byte(out, b'#');
                put_slug(out,
                    &s[((*heads.data.add(k as usize)) + 3) as usize..line_end(s,
                        (*heads.data.add(k as usize))) as usize]);
                buf_byte(out, b'\n');
            }
            return true;
        }
        // (the exact slug, else the first that starts with it, else holds it)
        let mut found: i64 = -1;
        for pass in 0..3 {
            for k in 0..heads.count {
                if found >= 0 {
                    break;
                }
                let slug = buf_new();
                put_slug(slug,
                    &s[((*heads.data.add(k as usize)) + 3) as usize..line_end(s,
                        (*heads.data.add(k as usize))) as usize]);
                let g = buf_slice(slug);
                if (pass == 0 && g == w) || (pass == 1 && starts(g, w))
                    || (pass == 2 && holds(g, w)) {
                    found = k;
                }
            }
        }
        if found < 0 {
            return false;
        }
        let from = (*heads.data.add(found as usize));
        let to = if found + 1 < heads.count { (*heads.data.add((found + 1) as usize)) }
            else { s.len() as i64 };
        buf_bytes(out, &s[from as usize..to as usize]);
        true
    }
}

// `try:` lines naming the first sections of topic t (prog: the
// compiler as it was run).
pub fn put_sections_try(err: i64, prog: *mut u8, t: i64, pcx: &mut Ctx<Comp>) {
    let names = buf_new();
    guide_section(t, b"", names, pcx);
    let s = buf_slice(names);
    let mut i: i64 = 0;
    let mut n: i64 = 0;
    while i < s.len() as i64 && n < 5 {
        let e = line_end(s, i);
        buf_bytes(err, b"try: ");
        crate::base::buf_str(err, prog);
        buf_bytes(err, b" guide ");
        buf_bytes(err, &s[i as usize..e as usize]);
        buf_byte(err, b'\n');
        i = e + 1;
        n += 1;
    }
}
