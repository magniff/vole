// Generated by compiler/guide/embed.sh from compiler/guide/syntax.md (do
// not edit): the guide's topic 'syntax'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Syntax\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The whole grammar is docs/grammar.md; this is what a program uses. It\n");
    buf_bytes(out, b"is Rust's, with the differences named here.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Lexical\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Comments: `// line`, `/* block, nesting */`. No doc-comment syntax:\n");
    buf_bytes(out, b"  `//` above an item is its comment.\n");
    buf_bytes(out, b"- Identifiers: ASCII letters, digits, `_`; `_` alone is the wildcard.\n");
    buf_bytes(out, b"  `r#type` is the identifier `type` (C names that are keywords).\n");
    buf_bytes(out, b"- Keywords are Rust's (`let mut`, `move`, `ref`, `match`, `impl`,\n");
    buf_bytes(out, b"  `where`, ...) plus `import` (a C header) and `union`. Reserved\n");
    buf_bytes(out, b"  (errors): `dyn`, `defer` (a guard with `Drop` does it), `@`. `var`,\n");
    buf_bytes(out, b"  `inout` and `sink`, MVS's words, are plain names here.\n");
    buf_bytes(out, b"- Integers: `42`, `1_000`, `0xff`, `0b1010`, with a type suffix `255u8`,\n");
    buf_bytes(out, "  `7i32`. Floats: `1.5`, `2e10`, `1.5f32`. `'a'`, `'\\n'`, `'\\u{e9}'` are\n".as_bytes());
    buf_bytes(out, b"  `char`s; `b'A'` is a `u8`. Strings: `\"a\\tb\\n\\\"q\\\"\\\\\"`, `\"\\x41\"`,\n");
    buf_bytes(out, "  `\"\\u{e9}\"`, a `&'static str`; `b\"a\\x41\"` a `&[u8]`; `c\"...\"` a\n".as_bytes());
    buf_bytes(out, b"  NUL-terminated `*const u8`. A backslash at the end of a line inside a\n");
    buf_bytes(out, b"  string continues it, leaving out the line break and the next line's\n");
    buf_bytes(out, b"  indentation. Not there yet: a line break inside `\"...\"`, raw strings\n");
    buf_bytes(out, b"  `r\"...\"` and `r#\"...\"#` (a raw text block, below, is one).\n");
    buf_bytes(out, b"- `f\"x = {x:>4}\"`, MVS's f-string, is `syntax.fstring`: a format\n");
    buf_bytes(out, b"  string, `println(\"x = {x:>4}\")`, writes it (`guide formatting`).\n");
    buf_bytes(out, b"- Text blocks, vole's, for text of several lines (WGSL, SQL, a usage\n");
    buf_bytes(out, b"  message): `\"\"\"` ending its line opens one, a line holding only blanks\n");
    buf_bytes(out, b"  and `\"\"\"` closes it, and the closing line's indentation is removed\n");
    buf_bytes(out, b"  from every line (a line indented less is `lex.text-block-indent`).\n");
    buf_bytes(out, b"  The line breaks after the opening `\"\"\"` and before the closing line\n");
    buf_bytes(out, b"  are not in the value; escapes work as in `\"...\"`. `r\"\"\"` is a raw\n");
    buf_bytes(out, b"  block: no escapes, a `\\` is a backslash. A text block at a format\n");
    buf_bytes(out, b"  position, `println(\"\"\"` .. `\"\"\", args)`, is a format string. A text\n");
    buf_bytes(out, b"  block is a `&'static str`, in a `const` too. `volec fmt` leaves its\n");
    buf_bytes(out, b"  lines as they are.\n");
    buf_bytes(out, b"- `include_str!(\"shader.wgsl\")` (or `include_str(..)`) is the file's\n");
    buf_bytes(out, b"  text as a string literal, read when the program is compiled (the path\n");
    buf_bytes(out, b"  relative to the file holding the call; UTF-8, else `embed.utf8`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"const USAGE: &str = \"\"\"\n");
    buf_bytes(out, b"    usage: tool [-v] FILE\n");
    buf_bytes(out, b"      -v  verbose\n");
    buf_bytes(out, b"    \"\"\";\n");
    buf_bytes(out, b"const PATTERN: &str = r\"\"\"\n");
    buf_bytes(out, b"    ^\\d+\\.\\d+$\n");
    buf_bytes(out, b"    \"\"\";\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    println(\"{USAGE}\");\n");
    buf_bytes(out, b"    println(\"{PATTERN} {}\", PATTERN.len());\n");
    buf_bytes(out, b"    let n = 2;\n");
    buf_bytes(out, b"    println(\"\"\"\n");
    buf_bytes(out, b"        \"{n}\" lines\n");
    buf_bytes(out, b"          {:>3}\n");
    buf_bytes(out, b"        \"\"\", n * 2);\n");
    buf_bytes(out, "    let c = '\\u{e9}';\n".as_bytes());
    buf_bytes(out, b"    println(\"{} {} {:?}\", c as u32, b'A', b\"a\\x41\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"usage: tool [-v] FILE\n");
    buf_bytes(out, b"  -v  verbose\n");
    buf_bytes(out, b"^\\d+\\.\\d+$ 10\n");
    buf_bytes(out, b"\"2\" lines\n");
    buf_bytes(out, b"    4\n");
    buf_bytes(out, b"233 65 [97, 65]\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Items\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::collections::HashMap;      // imports first, by convention\n");
    buf_bytes(out, b"import \"stdio.h\" as c;              // a C header\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"const LIMIT: i64 = 100;             // a constant expression\n");
    buf_bytes(out, b"const NAMES: [i64; 3] = [1, 2, 3];  // array constants too\n");
    buf_bytes(out, b"static mut COUNTER: i64 = 0;        // a global: unsafe to use\n");
    buf_bytes(out, b"static GREETING: &str = \"hi\";       // immutable: safe to read\n");
    buf_bytes(out, b"type Grid = [[u8; 8]; 8];           // an alias; `type P<T> = (T, T);`\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"pub struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, b"struct Wrapper<T> { inner: T }      // generic\n");
    buf_bytes(out, b"struct Meters(f64);                 // a tuple struct\n");
    buf_bytes(out, b"#[derive(Clone, Copy, PartialEq)]\n");
    buf_bytes(out, b"enum Dir { North, South }           // fieldless: casts with `as`\n");
    buf_bytes(out, b"enum Tok { Num(i64), Op(u8), End }  // tuple variants\n");
    buf_bytes(out, b"enum Ev { Key { code: u8, shift: bool }, Quit }   // struct-like variants\n");
    buf_bytes(out, b"#[repr(C)] union Bits { i: u32, f: f32 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"pub fn add(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, b"fn first<T: Copy>(s: &[T]) -> T { s[0] }\n");
    buf_bytes(out, b"fn ignore(_: i64) {}                 // `_` ignores an argument\n");
    buf_bytes(out, b"fn bump(mut n: i64) -> i64 { n += 1; n }  // a mutable copy of the argument\n");
    buf_bytes(out, b"fn twice(v: &mut Vec<i64, Gpa>) { v.push(v.len() as i64); } // called as twice(&mut v)\n");
    buf_bytes(out, b"unsafe fn raw(p: *const i64) -> i64 { *p }  // callers need unsafe\n");
    buf_bytes(out, b"fn hi(m: &mut HashMap<i64, i64, Gpa>) { m.insert(1, 2); } // the `use` above\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Point {\n");
    buf_bytes(out, b"    fn len2(&self) -> i64 { self.x * self.x + self.y * self.y }\n");
    buf_bytes(out, b"    fn move_by(&mut self, d: i64) { self.x += d; }               // p.move_by(1)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"trait Named { fn name(&self) -> &str; }\n");
    buf_bytes(out, b"impl Named for Point { fn name(&self) -> &str { \"point\" } }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"mod util { pub fn twice(x: i64) -> i64 { x * 2 } }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"extern \"C\" { fn abs(x: i32) -> i32; }\n");
    buf_bytes(out, b"extern \"C\" fn callback(x: i32) -> i32 { x + 1 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Items may come in any order and refer to each other; they are a\n");
    buf_bytes(out, b"module's (an item inside a function body is not there yet). Parameters\n");
    buf_bytes(out, b"and receivers are Rust's: `x: T` (by value: moved, or copied for a\n");
    buf_bytes(out, b"`Copy` type), `x: &T`, `x: &mut T` (the caller passes `&mut place`),\n");
    buf_bytes(out, b"`mut x: T` (a mutable copy); `&self`, `&mut self`, `self`. Attributes:\n");
    buf_bytes(out, b"`#[derive(..)]`, `#[repr(C)]`, `#[repr(C, packed)]`, `#[repr(C,\n");
    buf_bytes(out, b"align(16))]`, `#[repr(u8)]` (an enum's tag), `#[inline]`,\n");
    buf_bytes(out, b"`#[inline(never)]`, `#[cold]`, `#[deprecated(note = \"use g\")]` (each use\n");
    buf_bytes(out, b"is `warning item.deprecated` with the note), `#[thread_local]`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Statements and blocks\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let x = 1;                          // immutable\n");
    buf_bytes(out, b"let mut y: i64 = 2;                 // mutable, with a type\n");
    buf_bytes(out, b"let (a, mut b) = (3, 4);            // patterns that always match; `mut` per name\n");
    buf_bytes(out, b"b += 0;\n");
    buf_bytes(out, b"let r = &mut y;                     // a mutable borrow of y\n");
    buf_bytes(out, b"*r += x + a * b;                    // = += -= *= /= %= &= |= ^= <<= >>=\n");
    buf_bytes(out, b"{\n");
    buf_bytes(out, b"    let inner = y;                  // a block is an expression\n");
    buf_bytes(out, b"    println(\"{inner}\");\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"15\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`let x;` declares a binding that each path assigns once before it is\n");
    buf_bytes(out, b"read. A statement that starts with `if`, `match`, `loop`, `while`,\n");
    buf_bytes(out, b"`for`, `unsafe` or a block ends at its `}`: no `;` is needed, and it is\n");
    buf_bytes(out, b"never continued by an operator. The last expression of a block, without\n");
    buf_bytes(out, b"`;`, is the block's value. There is no `++`/`--`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Expressions and precedence\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"From loosest to tightest (all left-associative except where noted):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| operators | |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `=` `+=` `-=` ... | right; an assignment is `()` |\n");
    buf_bytes(out, b"| `\\|\\|` | |\n");
    buf_bytes(out, b"| `&&` | |\n");
    buf_bytes(out, b"| `==` `!=` `<` `>` `<=` `>=` | not chained: `a < b < c` is an error |\n");
    buf_bytes(out, b"| `\\|` then `^` then `&` | bits; `a \\| b == c` is `(a \\| b) == c` |\n");
    buf_bytes(out, b"| `<<` `>>` | arithmetic `>>` on signed, logical on unsigned |\n");
    buf_bytes(out, b"| `+` `-` | |\n");
    buf_bytes(out, b"| `*` `/` `%` | |\n");
    buf_bytes(out, b"| `as` | `-x as i64` is `(-x) as i64`; `a * b as f64` is `a * (b as f64)` |\n");
    buf_bytes(out, b"| prefix `-` `!` `*` `&` `&mut` | `!` is bool's not and an integer's bitwise not (`~` too, vole's); `*r` reads through a reference or a raw pointer |\n");
    buf_bytes(out, b"| `f()` `a[i]` `a[i..j]` `x.f` `x.0` `x.m()` `e?` | `*p.x` is `*(p.x)` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"No `**` (power: `x.pow(n)`), no ternary (`if c { a } else { b }` is an\n");
    buf_bytes(out, b"expression). `e?` is postfix, as tight as a call: `parse(s)?.len()`\n");
    buf_bytes(out, b"(`volec guide conversions`). `return`, `break`, `continue` have type `!`\n");
    buf_bytes(out, b"and fit anywhere: `let v = if ok { x } else { return 1 };`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"In an `if`, `while`, `match` or `for` head, `Name {` starts the body: put\n");
    buf_bytes(out, b"a struct literal there in parentheses, `if p == (P { x: 1 }) { ... }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Control flow\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Shape { Line(i64), Dot }\n");
    buf_bytes(out, b"enum Ev { Key { code: u8, shift: bool }, Quit }\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let n = 7;\n");
    buf_bytes(out, b"    let parity = if n % 2 == 0 { \"even\" } else { \"odd\" };\n");
    buf_bytes(out, b"    println(\"{parity}\");\n");
    buf_bytes(out, b"    let mut i = 0;\n");
    buf_bytes(out, b"    while i < 3 { i += 1; }\n");
    buf_bytes(out, b"    for k in 0..=2 { i += k; }\n");
    buf_bytes(out, b"    for ch in \"ab\".bytes() { i += ch as i64; }\n");
    buf_bytes(out, b"    let v = loop { i += 1; if i % 10 == 0 { break i; } };\n");
    buf_bytes(out, b"    'rows: for r in 0..3 {\n");
    buf_bytes(out, b"        for c in 0..3 {\n");
    buf_bytes(out, b"            if c == 1 { continue 'rows; }\n");
    buf_bytes(out, b"            if r == 2 { break 'rows; }\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let o: Option<i64> = Some(3);\n");
    buf_bytes(out, b"    if let Some(x) = o { i += x; } else if n > 0 { i -= 1; }\n");
    buf_bytes(out, b"    let mut stack: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    stack.push(1);\n");
    buf_bytes(out, b"    while let Some(top) = stack.pop() { i += top; }\n");
    buf_bytes(out, b"    let Some(t) = o else { return 1; };\n");
    buf_bytes(out, b"    let mut s = Shape::Line(1);\n");
    buf_bytes(out, b"    match &mut s { Shape::Line(n) => *n += 1, Shape::Dot => {} }\n");
    buf_bytes(out, b"    let e = Ev::Key { code: 3, shift: true };\n");
    buf_bytes(out, b"    let k = match e { Ev::Key { code, shift: true } => code as i64, Ev::Key { .. } => 0, Ev::Quit => -1 };\n");
    buf_bytes(out, b"    let m = match n { 0 => 0, 1..=5 | 9 => 1, x if x > 6 => 2, _ => 3 };\n");
    buf_bytes(out, b"    if let Shape::Line(ref q) = s { i += *q; }\n");
    buf_bytes(out, b"    let (a, mut bb) = (3, 4);\n");
    buf_bytes(out, b"    bb += a;\n");
    buf_bytes(out, b"    println(\"{v} {i} {t} {k} {m} {bb}\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"odd\n");
    buf_bytes(out, b"210 216 3 3 2 7\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`match`: arms are tried in order; a pattern may be a literal, a range\n");
    buf_bytes(out, b"`'a'..='z'`, alternatives `A | B`, a variant `E::V(x, _)` or `E::K {\n");
    buf_bytes(out, b"code, shift: true }` (`E::K { .. }` leaves the fields out), a tuple `(a,\n");
    buf_bytes(out, b"0)`, a binding (`n`, `ref n`, `mut n`), `_`, with a guard `x if x > 0`.\n");
    buf_bytes(out, b"The arms must cover every value; a match is an expression. Matching a\n");
    buf_bytes(out, b"reference binds references into it (Rust's default binding modes):\n");
    buf_bytes(out, b"`match &mut s { Shape::Line(n) => *n += 1, _ => {} }` changes the\n");
    buf_bytes(out, b"field. `let PAT = e else { return ..; };` binds or leaves. Matching an\n");
    buf_bytes(out, b"owned local by value moves its parts out.\n");
}
