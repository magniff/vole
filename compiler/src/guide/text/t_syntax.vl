use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Syntax\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The whole grammar is docs/grammar.md; this is what a program uses.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Lexical\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Comments: `// line`, `/* block, nesting */`. No doc-comment syntax:\n");
    buf_bytes(out, b"  `//` above an item is its comment.\n");
    buf_bytes(out, b"- Identifiers: ASCII letters, digits, `_`; `_` alone is the wildcard.\n");
    buf_bytes(out, b"  `r#type` is the identifier `type` (C names that are keywords).\n");
    buf_bytes(out, b"- Keywords: `as break const continue else enum extern false fn for if\n");
    buf_bytes(out, b"  impl import in let loop match mod pub return static struct trait true\n");
    buf_bytes(out, b"  type union unsafe use var while`; `inout` and `sink` (0.20) are words\n");
    buf_bytes(out, b"  where a convention, a binding or a closure starts, `where` (0.26.2)\n");
    buf_bytes(out, b"  where an item's bounds do. Reserved (errors): `defer` (`syntax.defer`,\n");
    buf_bytes(out, b"  removed in 0.26.2: a guard with `Drop` does it), `dyn`, `@`; `mut`\n");
    buf_bytes(out, b"  and `move` are Rust's spellings, each a `conv.rust` error naming\n");
    buf_bytes(out, b"  vole's (`var`, `sink ||`). `self`, `Self`, `super`, `crate` are names.\n");
    buf_bytes(out, b"- Integers: `42`, `1_000`, `0xff`, `0b1010`, with a type suffix\n");
    buf_bytes(out, b"  `255u8`, `7i32`. Floats: `1.5`, `2e10`, `1.5f32`. Chars: `'a'`, `'\\n'`,\n");
    buf_bytes(out, b"  `'\\x41'`, `'\\''` (one byte, a `u8`). Strings: `\"a\\tb\\n\\\"q\\\"\\\\\"`,\n");
    buf_bytes(out, "  `\"\\x41\"`, `\"\\u{e9}\"` (UTF-8 bytes); `c\"...\"` is NUL-terminated;\n".as_bytes());
    buf_bytes(out, b"  `f\"x = {x:>4}\"`, an f-string (0.15 to 0.26.2), is removed\n");
    buf_bytes(out, b"  (`syntax.fstring`, 0.26.3): a format string, `println(\"x = {x:>4}\")`,\n");
    buf_bytes(out, b"  writes it (`guide formatting`). A\n");
    buf_bytes(out, b"  backslash at the end of a line inside a string continues it, leaving\n");
    buf_bytes(out, b"  out the line break and the next line's indentation.\n");
    buf_bytes(out, b"- Text blocks (0.25.3), for text of several lines (WGSL, SQL, a usage\n");
    buf_bytes(out, b"  message): `\"\"\"` ending its line opens one, a line holding only\n");
    buf_bytes(out, b"  blanks and `\"\"\"` closes it, and the closing line's indentation is\n");
    buf_bytes(out, b"  removed from every line (a line indented less is\n");
    buf_bytes(out, b"  `lex.text-block-indent`). The line breaks after the opening `\"\"\"` and\n");
    buf_bytes(out, b"  before the closing line are not in the value; escapes work as in\n");
    buf_bytes(out, b"  `\"...\"`, a `\\` at a line's end joins it to the next. `r\"\"\"` is a raw\n");
    buf_bytes(out, b"  block: no escapes, a `\\` is a backslash; text with a line starting\n");
    buf_bytes(out, b"  with `\"\"\"` goes in `r#\"\"\"` .. `\"\"\"#`. A text block\n");
    buf_bytes(out, b"  at a format position, `println(\"\"\"` .. `\"\"\")` or `format_args(\"\"\"`\n");
    buf_bytes(out, b"  .. `\"\"\", args)`, is a format string: the same lines and dedent, with\n");
    buf_bytes(out, b"  holes (`{x}`, `{x:>4}`, `{{` for a brace) and quotes as text. A text block is a string\n");
    buf_bytes(out, b"  literal: a `[u8]` or a `str`, in a `const` too. `volec fmt` leaves its\n");
    buf_bytes(out, b"  lines as they are.\n");
    buf_bytes(out, b"- `include_str(\"shader.wgsl\")` is the file's text as a string literal,\n");
    buf_bytes(out, b"  read when the program is compiled (the path relative to the file\n");
    buf_bytes(out, b"  holding the call; UTF-8, else `embed.utf8`); `include_bytes(\"f.bin\")`\n");
    buf_bytes(out, b"  its bytes, a `[u8]`. Rust's `include_str!(..)` is the same call.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"const USAGE: [u8] = \"\"\"\n");
    buf_bytes(out, b"    usage: tool [-v] FILE\n");
    buf_bytes(out, b"      -v  verbose\n");
    buf_bytes(out, b"    \"\"\";\n");
    buf_bytes(out, b"const PATTERN: [u8] = r\"\"\"\n");
    buf_bytes(out, b"    ^\\d+\\.\\d+$\n");
    buf_bytes(out, b"    \"\"\";\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    println(USAGE);\n");
    buf_bytes(out, b"    println(\"{PATTERN} {}\", PATTERN.len);\n");
    buf_bytes(out, b"    let n = 2;\n");
    buf_bytes(out, b"    println(\"\"\"\n");
    buf_bytes(out, b"        \"{n}\" lines\n");
    buf_bytes(out, b"          {:>3}\n");
    buf_bytes(out, b"        \"\"\", n * 2);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"usage: tool [-v] FILE\n");
    buf_bytes(out, b"  -v  verbose\n");
    buf_bytes(out, b"^\\d+\\.\\d+$ 10\n");
    buf_bytes(out, b"\"2\" lines\n");
    buf_bytes(out, b"    4\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Items\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::HashMap;                   // imports first, by convention\n");
    buf_bytes(out, b"import \"stdio.h\" as c;              // a C header\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"const LIMIT: i64 = 100;             // a constant expression\n");
    buf_bytes(out, b"const NAMES: [i64; 3] = [1, 2, 3];  // array constants too\n");
    buf_bytes(out, b"static var COUNTER: i64 = 0;        // a global; safe to use\n");
    buf_bytes(out, b"type Grid = [[u8; 8]; 8];           // an alias; `type P<T> = (T, T);`\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"pub struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, b"struct Wrapper<T> { inner: T }      // generic\n");
    buf_bytes(out, b"enum Dir { North, South }           // fieldless: compares with ==, casts with `as`\n");
    buf_bytes(out, b"enum Tok { Num(i64), Op(u8), End }  // tuple variants\n");
    buf_bytes(out, b"enum Ev { Key { code: u8, shift: bool }, Quit }   // struct-like variants (0.17)\n");
    buf_bytes(out, b"#[repr(C)] union Bits { i: u32, f: f32 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"pub fn add(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, b"fn first<T>(s: [T]) -> T { s[0] }\n");
    buf_bytes(out, b"fn ignore(_: i64) {}                 // `_` ignores an argument\n");
    buf_bytes(out, b"fn bump(n: sink i64) -> i64 { n += 1; n }  // sink: the callee's own, mutable\n");
    buf_bytes(out, b"fn twice(v: inout Vec<i64, Gpa>) { v.push(v.len() as i64); } // inout: called as twice(&v)\n");
    buf_bytes(out, b"unsafe fn raw(p: *i64) -> i64 { p[0] }     // callers need unsafe\n");
    buf_bytes(out, b"fn hi(m: inout HashMap<i64, i64, Gpa>) { m.insert(1, 2); } // the `use` above\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Point {\n");
    buf_bytes(out, b"    fn len2(self) -> i64 { self.x * self.x + self.y * self.y }   // self: let\n");
    buf_bytes(out, b"    fn move_by(inout self, d: i64) { self.x += d; }               // p.move_by(1)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"trait Named { fn name(self) -> [u8]; }\n");
    buf_bytes(out, b"impl Named for Point { fn name(self) -> [u8] { \"point\" } }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"mod util { pub fn twice(x: i64) -> i64 { x * 2 } }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"extern \"C\" { fn abs(x: i32) -> i32; }\n");
    buf_bytes(out, b"extern \"C\" fn callback(x: i32) -> i32 { x + 1 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Items may come in any order and refer to each other. A parameter's\n");
    buf_bytes(out, b"convention is written before its type: `x: T` (let, the default: read\n");
    buf_bytes(out, b"only, a copy of a plain value or a borrow of an owned one), `x: inout T`\n");
    buf_bytes(out, b"(changed for the caller, who passes `&place`), `x: sink T` (the callee\n");
    buf_bytes(out, b"takes it; an owned argument moves). Receivers: `self`, `inout self`,\n");
    buf_bytes(out, b"`sink self`. Attributes:\n");
    buf_bytes(out, b"`#[repr(C)]`, `#[repr(C, packed)]`, `#[repr(C, align(16))]`,\n");
    buf_bytes(out, b"`#[repr(u8)]` (an enum's tag), `#[inline]`, `#[inline(never)]`,\n");
    buf_bytes(out, b"`#[cold]`, and (0.26.3) Rust's `#[deprecated(note = \"use g\")]` on any\n");
    buf_bytes(out, b"item, method or field: each use of it is `warning item.deprecated` with\n");
    buf_bytes(out, b"the note (`#[deprecated]` and `#[deprecated = \"use g\"]` too); any other\n");
    buf_bytes(out, b"is an error.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Statements and blocks\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let x = 1;                          // immutable\n");
    buf_bytes(out, b"var y: i64 = 2;                     // mutable, with a type\n");
    buf_bytes(out, b"let (a, var b) = (3, 4);            // patterns that always match; `var` per name\n");
    buf_bytes(out, b"b += 0;\n");
    buf_bytes(out, b"inout r = &y;                       // an access to y: r is used as y itself\n");
    buf_bytes(out, b"r += x + a * b;                     // = += -= *= /= %= &= |= ^= <<= >>=\n");
    buf_bytes(out, b"{\n");
    buf_bytes(out, b"    let inner = y;                  // a block is an expression\n");
    buf_bytes(out, b"    std::print_int(inner);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"println(\"\");\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"15\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The binding forms: `let x = e` (immutable: takes `e` when this\n");
    buf_bytes(out, b"function owns it, which moves an owned local; borrows a part it cannot\n");
    buf_bytes(out, b"take, such as `v[i]`), `var x = e` (mutable, always owns), `inout x =\n");
    buf_bytes(out, b"&place` (an exclusive access: reading `x` reads the place, `x = v` and\n");
    buf_bytes(out, b"`x.push(1)` change it; it is not re-pointed). There is no uninitialized\n");
    buf_bytes(out, b"`let x;`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A statement that starts with `if`, `match`, `loop`, `while`, `for`,\n");
    buf_bytes(out, b"`unsafe` or a block ends at its `}`: no `;` is needed, and it is never\n");
    buf_bytes(out, b"continued by an operator. The last expression of a block, without `;`,\n");
    buf_bytes(out, b"is the block's value. There is no `++`/`--`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Expressions and precedence\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"From loosest to tightest (all left-associative except where noted):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| operators | |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `=` `+=` `-=` ... | right; an assignment is `()` |\n");
    buf_bytes(out, b"| `\\|\\|` | |\n");
    buf_bytes(out, b"| `&&` | |\n");
    buf_bytes(out, b"| `==` `!=` `<` `>` `<=` `>=` | not chained: `a < b < c` is an error |\n");
    buf_bytes(out, b"| `\\|` then `^` then `&` | bits; `a \\| b == c` is `(a \\| b) == c` |\n");
    buf_bytes(out, b"| `<<` `>>` | arithmetic `>>` on signed, logical on unsigned |\n");
    buf_bytes(out, b"| `+` `-` | |\n");
    buf_bytes(out, b"| `*` `/` `%` | |\n");
    buf_bytes(out, b"| `as` | `-x as i64` is `(-x) as i64`; `a * b as f64` is `a * (b as f64)` |\n");
    buf_bytes(out, b"| prefix `-` `!` `~` `*` `&` | `!` on bool, `~` bitwise not; `&place` lends it inout; `*p` reads a raw pointer |\n");
    buf_bytes(out, b"| `f()` `a[i]` `a[i..j]` `x.f` `x.0` `x.m()` | `*p.x` is `*(p.x)` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"No `**` (power), no ternary (`if c { a } else { b }` is an\n");
    buf_bytes(out, b"expression). `e?` (0.15) is postfix, as tight as a call: `parse(s)?.len()`\n");
    buf_bytes(out, b"(`volec guide conversions`). `return`,\n");
    buf_bytes(out, b"`break`, `continue` have type `!` and fit anywhere:\n");
    buf_bytes(out, b"`let v = if ok { x } else { return 1 };`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"In an `if`, `while`, `match` or `for` head, `Name {` starts the body: put\n");
    buf_bytes(out, b"a struct literal there in parentheses, `if p == (P { x: 1 }) { ... }`\n");
    buf_bytes(out, b"(0.17: `Name { a: ...` with a field's colon is read as a literal there\n");
    buf_bytes(out, b"too).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Control flow\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let n = 7;\n");
    buf_bytes(out, b"    let parity = if n % 2 == 0 { \"even\" } else { \"odd\" };\n");
    buf_bytes(out, b"    println(parity);\n");
    buf_bytes(out, b"    var i = 0;\n");
    buf_bytes(out, b"    while i < 3 { i += 1; }\n");
    buf_bytes(out, b"    for k in 0..=2 { i += k; }          // 0..n excludes n, 0..=n includes it\n");
    buf_bytes(out, b"    for ch in \"ab\" { i += ch as i64; }  // slices and arrays, by value\n");
    buf_bytes(out, b"    let v = loop { i += 1; if i % 10 == 0 { break i; } };\n");
    buf_bytes(out, b"    rows: for r in 0..3 {\n");
    buf_bytes(out, b"        for c in 0..3 {\n");
    buf_bytes(out, b"            if c == 1 { continue :rows; }\n");
    buf_bytes(out, b"            if r == 2 { break :rows; }\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let o: Option<i64> = Some(3);\n");
    buf_bytes(out, b"    if let Some(x) = o { i += x; } else if n > 0 { i -= 1; }\n");
    buf_bytes(out, b"    var stack: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    stack.push(1);\n");
    buf_bytes(out, b"    while let Some(top) = stack.pop() { i += top; }\n");
    buf_bytes(out, b"    std::print_int(v);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"odd\n");
    buf_bytes(out, b"210\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`match`: arms are tried in order; a pattern may be a literal, a range\n");
    buf_bytes(out, b"`'a'..='z'`, alternatives `A | B`, a variant `E::V(x, _)` or `E::K {\n");
    buf_bytes(out, b"code, shift: true }` (`E::K { code, .. }` leaves the other fields out), a\n");
    buf_bytes(out, b"tuple `(a, 0)`, a binding (`n`), `_`, with a guard `n if n > 0`. The arms must\n");
    buf_bytes(out, b"cover every value; a match is an expression. `Some(var n)` binds a\n");
    buf_bytes(out, b"mutable copy. Matched through an access (a let parameter `e: E`), a\n");
    buf_bytes(out, b"pattern binds let accesses into it, used as values: `match e { E::A(n)\n");
    buf_bytes(out, b"=> n + 1, ... }`. `match &e` binds inout accesses, so an arm changes the\n");
    buf_bytes(out, b"field: `match &s { Shape::Line(n) => n += 1, _ => {} }`. Matching an\n");
    buf_bytes(out, b"owned local by value moves its parts out.\n");
}
