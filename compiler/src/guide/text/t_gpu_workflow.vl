// Generated by compiler/guide/embed.sh from compiler/guide/gpu-workflow.md (do
// not edit): the guide's topic 'gpu-workflow'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Working on a GPU example: shader, check, headless run\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The loop for a change to a program that uses `std::gpu` (the examples\n");
    buf_bytes(out, b"under `examples/gpu/`): edit, check, build, run without a window, look\n");
    buf_bytes(out, b"at the numbers. The API itself is `volec guide gpu` (long: ask for one\n");
    buf_bytes(out, b"section, `volec guide gpu#compute`, or `volec guide --find WORDS`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Where the shader is\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A shader is WGSL in an `embed wgsl` item: a block, `embed wgsl NAME {\n");
    buf_bytes(out, b".. }`, or a file beside the source, `embed wgsl NAME from \"x.wgsl\";`.\n");
    buf_bytes(out, b"`volec query grep 'embed wgsl' --root DIR/main.vl` lists a program's.\n");
    buf_bytes(out, b"A `.wgsl` file is a file of the program that embeds it: `volec query\n");
    buf_bytes(out, b"show x.wgsl` prints it (a long one: `query text x.wgsl:A-B`), `query\n");
    buf_bytes(out, b"grep TEXT --in x.wgsl` finds a line, and `volec edit patch x.wgsl\n");
    buf_bytes(out, b"--old A --new B` changes it, checked: an edit that breaks the shader\n");
    buf_bytes(out, b"is refused with its error.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Check after every shader edit\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The shader is checked with the program that embeds it, not alone:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec check examples/gpu/pathtrace/main.vl   # or, in the directory: volec check\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A clean check says what it read, `ok: 0 errors in\n");
    buf_bytes(out, b"examples/gpu/pathtrace/main.vl (9 files, 3 shaders)`; `0 shaders`, or\n");
    buf_bytes(out, b"another root, means it was not your program (`volec check` with no ROOT\n");
    buf_bytes(out, b"at the tree's root checks the compiler). A WGSL error is at the\n");
    buf_bytes(out, b"shader's own line: `trace.wgsl:51:34: error[wgsl.name] unknown name\n");
    buf_bytes(out, b"'x'`. An edit made without `volec edit` is checked by nobody: run\n");
    buf_bytes(out, b"`volec check --changed` (every program the changed files belong to).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Build and run headless\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec -O2 examples/gpu/pathtrace/main.vl -o pathtrace     # about a second\n");
    buf_bytes(out, b"./pathtrace --headless --samples 16 --size 96x64 --out shot.ppm\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`--headless` needs no display: the same pipelines draw into a surface\n");
    buf_bytes(out, b"that is read back, the program checks its own image (`render ok`,\n");
    buf_bytes(out, b"`reset ok`; exit 1 when a check fails) and `--out` writes a PPM. Start\n");
    buf_bytes(out, b"small (few samples, a small size): a run is then well under a second.\n");
    buf_bytes(out, b"`PROG --help` lists the options; each example's README has its command\n");
    buf_bytes(out, b"lines:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| example | where in its README | a first command |\n");
    buf_bytes(out, b"|---|---|---|\n");
    buf_bytes(out, b"| pathtrace | Headless verification, Reproducible benchmark | `--headless --samples 16 --size 96x64` |\n");
    buf_bytes(out, b"| life, galaxy | the top (the run commands) | `--headless --out x.ppm --size 960x600` |\n");
    buf_bytes(out, b"| fluid2d | The headless check | `--headless --check` |\n");
    buf_bytes(out, b"| voxel | Verification, Benchmark | `--headless --size 320x200 --out voxel.ppm` |\n");
    buf_bytes(out, b"| galaga, relativity | the top (the run commands) | `--headless` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Its tests are the cases whose name holds the example's:\n");
    buf_bytes(out, b"`tests/run.sh pathtrace`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Sweeping a parameter: do not edit the shader\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To try values of a number the shader reads, make it data:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- a uniform: a field of the `#[repr(wgsl)]` struct the program writes\n");
    buf_bytes(out, b"  each frame, set from a command-line option (`std::cli`); one build,\n");
    buf_bytes(out, b"  many runs;\n");
    buf_bytes(out, b"- a constant: a `const` named in the block's `with` is the shader's\n");
    buf_bytes(out, b"  `const` too, so one line of vole changes it (a rebuild a value).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"const BOUNCES: u32 = 4;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"embed wgsl TRACE with BOUNCES {\n");
    buf_bytes(out, b"    @group(0) @binding(0) var<storage, read_write> image: array<f32>;\n");
    buf_bytes(out, b"    @compute @workgroup_size(1) fn main() {\n");
    buf_bytes(out, b"        image[0] = f32(BOUNCES);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    println(\"{} bounces, shader embedded: {}\", BOUNCES, TRACE.src.len() > 0);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"4 bounces, shader embedded: true\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec guide gpu#shared-constants-and-structs` has the struct form.\n");
}
