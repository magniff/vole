// Generated by compiler/guide/embed.sh from compiler/guide/example.md (do
// not edit): the guide's topic 'example'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# A whole program\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"One complete program, written the way vole code is written: modules\n");
    buf_bytes(out, b"and `use`, enums with data and `match`, `Result` and `?`, `Vec`,\n");
    buf_bytes(out, b"`HashMap`, `String`, text as `&str`, a sort closure, format strings, the\n");
    buf_bytes(out, b"allocator passed down from `main`, and a test case. A program of this\n");
    buf_bytes(out, b"kind needs only what it shows: copy its patterns.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`stock` reads commands from stdin, one a line, and prints a line for\n");
    buf_bytes(out, b"each command it rejects and the report it is asked for. It has three\n");
    buf_bytes(out, b"files next to each other: `volec main.vl -o prog` builds them all.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole main.vl\n");
    buf_bytes(out, b"// stock: a ledger of items. Reads commands from stdin, one a line; prints\n");
    buf_bytes(out, b"// the report it is asked for, and a line for each command it rejects.\n");
    buf_bytes(out, b"mod command;\n");
    buf_bytes(out, b"mod store;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"use command::{Error, parse};\n");
    buf_bytes(out, b"use std::io;\n");
    buf_bytes(out, b"use store::Store;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let input = io::read_to_string_in(io::stdin(), gpa).unwrap(); // all of stdin, a String<Gpa>\n");
    buf_bytes(out, b"    let mut store = Store::new(gpa);            // it allocates: give it gpa\n");
    buf_bytes(out, b"    for (i, raw) in input.lines().enumerate() { // a line, without its '\\n'\n");
    buf_bytes(out, b"        let line = cut_comment(raw).trim();     // slices of input: no copies\n");
    buf_bytes(out, b"        if line.is_empty() {\n");
    buf_bytes(out, b"            continue;\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        if let Err(e) = run(&mut store, line, gpa) { // &mut: run may change store\n");
    buf_bytes(out, b"            println(\"line {}: {e}\", i + 1);     // Error has Display\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}                                               // store, then input, dropped (freed)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// One line: parsed, then applied; `?` passes the first Err up.\n");
    buf_bytes(out, b"fn run<'a>(store: &mut Store<'a, Gpa>, line: &'a str, gpa: Gpa) -> Result<(), Error<'a>> {\n");
    buf_bytes(out, b"    let cmd = parse(line, gpa)?;\n");
    buf_bytes(out, b"    store.apply(cmd)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// s up to its first '#'.\n");
    buf_bytes(out, b"fn cut_comment(s: &str) -> &str {\n");
    buf_bytes(out, b"    match s.find('#') {                         // an Option<usize>, a byte index\n");
    buf_bytes(out, b"        Some(i) => &s[..i],                     // a slice of s: &s[a..b], &s[a..]\n");
    buf_bytes(out, b"        None => s,\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole command.vl\n");
    buf_bytes(out, b"// A line of input as a Command, or the Error that rejects it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"use std::fmt;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// A field is private to its module unless `pub`: store.vl reads these.\n");
    buf_bytes(out, b"// 'a: an Item's name borrows the input. Clone: Vec::clone needs it.\n");
    buf_bytes(out, b"#[derive(Clone)]\n");
    buf_bytes(out, b"pub struct Item<'a> { pub name: &'a str, pub count: i64, pub price: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// Variants carry data, tuple-like or struct-like.\n");
    buf_bytes(out, b"pub enum Command<'a> {\n");
    buf_bytes(out, b"    Add(Item<'a>),\n");
    buf_bytes(out, b"    Sell { name: &'a str, count: i64 },\n");
    buf_bytes(out, b"    Report,\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"pub enum Error<'a> {\n");
    buf_bytes(out, b"    Unknown(&'a str),\n");
    buf_bytes(out, b"    Arity(&'a str, usize),\n");
    buf_bytes(out, b"    BadNumber(&'a str),\n");
    buf_bytes(out, b"    NoItem(&'a str),\n");
    buf_bytes(out, b"    Short(&'a str, i64),\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// What `{e}` in a format string prints.\n");
    buf_bytes(out, b"impl fmt::Display for Error<'_> {\n");
    buf_bytes(out, b"    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {\n");
    buf_bytes(out, b"        match self {\n");
    buf_bytes(out, b"            Error::Unknown(w) => write(f, \"unknown command {w}\"),\n");
    buf_bytes(out, b"            Error::Arity(w, n) => write(f, \"{w} takes {} arguments\", n - 1),\n");
    buf_bytes(out, b"            Error::BadNumber(w) => write(f, \"not a number: {w}\"),\n");
    buf_bytes(out, b"            Error::NoItem(name) => write(f, \"no item {name}\"),\n");
    buf_bytes(out, b"            Error::Short(name, have) => write(f, \"only {have} {name} left\"),\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// `add NAME COUNT PRICE`, `sell NAME COUNT` or `report`.\n");
    buf_bytes(out, b"pub fn parse<'a>(line: &'a str, gpa: Gpa) -> Result<Command<'a>, Error<'a>> {\n");
    buf_bytes(out, b"    let w: Vec<&str, Gpa> = line.split_whitespace().collect_in(gpa); // slices of line\n");
    buf_bytes(out, b"    let verb = w[0];\n");
    buf_bytes(out, b"    if verb == \"add\" {                          // a string literal is not a pattern yet\n");
    buf_bytes(out, b"        arity(&w, 4)?;\n");
    buf_bytes(out, b"        let item = Item { name: w[1], count: number(w[2])?, price: number(w[3])? };\n");
    buf_bytes(out, b"        Ok(Command::Add(item))\n");
    buf_bytes(out, b"    } else if verb == \"sell\" {\n");
    buf_bytes(out, b"        arity(&w, 3)?;\n");
    buf_bytes(out, b"        Ok(Command::Sell { name: w[1], count: number(w[2])? })\n");
    buf_bytes(out, b"    } else if verb == \"report\" {\n");
    buf_bytes(out, b"        Ok(Command::Report)\n");
    buf_bytes(out, b"    } else {\n");
    buf_bytes(out, b"        Err(Error::Unknown(verb))\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn arity<'a>(w: &[&'a str], n: usize) -> Result<(), Error<'a>> {\n");
    buf_bytes(out, b"    if w.len() != n {\n");
    buf_bytes(out, b"        return Err(Error::Arity(w[0], n));\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// A count or a price: a number, not negative.\n");
    buf_bytes(out, b"fn number(w: &str) -> Result<i64, Error> {\n");
    buf_bytes(out, b"    match w.parse::<i64>() {\n");
    buf_bytes(out, b"        Ok(n) if n >= 0 => Ok(n),\n");
    buf_bytes(out, b"        _ => Err(Error::BadNumber(w)),\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole store.vl\n");
    buf_bytes(out, b"// The items in stock, in the order they were first added.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"use command::{Command, Error, Item};\n");
    buf_bytes(out, b"use std::alloc::Allocator;\n");
    buf_bytes(out, b"use std::collections::HashMap;\n");
    buf_bytes(out, b"use std::fmt::Write;\n");
    buf_bytes(out, b"use std::hash::FixedState;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// A type that holds an allocator is generic over it.\n");
    buf_bytes(out, b"pub struct Store<'a, A: Allocator> {\n");
    buf_bytes(out, b"    items: Vec<Item<'a>, A>,\n");
    buf_bytes(out, b"    index: HashMap<&'a str, usize, A, FixedState>, // name -> its position in items\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl<'a> Store<'a, Gpa> {\n");
    buf_bytes(out, b"    pub fn new(gpa: Gpa) -> Store<'a, Gpa> {\n");
    buf_bytes(out, b"        Store { items: Vec::new_in(gpa), index: HashMap::new_in(gpa) }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    // No free: a Store drops its fields (items, then index) when it is dropped.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    pub fn apply(&mut self, cmd: Command<'a>) -> Result<(), Error<'a>> {\n");
    buf_bytes(out, b"        match cmd {\n");
    buf_bytes(out, b"            Command::Add(item) => match self.index.get(item.name) {\n");
    buf_bytes(out, b"                Some(&i) => {\n");
    buf_bytes(out, b"                    self.items[i].count += item.count;\n");
    buf_bytes(out, b"                    self.items[i].price = item.price;\n");
    buf_bytes(out, b"                }\n");
    buf_bytes(out, b"                None => {\n");
    buf_bytes(out, b"                    self.index.insert(item.name, self.items.len());\n");
    buf_bytes(out, b"                    self.items.push(item);\n");
    buf_bytes(out, b"                }\n");
    buf_bytes(out, b"            },\n");
    buf_bytes(out, b"            Command::Sell { name, count } => {\n");
    buf_bytes(out, b"                let i = *self.index.get(name).ok_or(Error::NoItem(name))?;\n");
    buf_bytes(out, b"                let have = self.items[i].count;\n");
    buf_bytes(out, b"                if have < count {\n");
    buf_bytes(out, b"                    return Err(Error::Short(name, have));\n");
    buf_bytes(out, b"                }\n");
    buf_bytes(out, b"                self.items[i].count = have - count;\n");
    buf_bytes(out, b"            }\n");
    buf_bytes(out, b"            Command::Report => self.report(),\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        Ok(())\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    // The items by value, highest first, ties by name; then the total.\n");
    buf_bytes(out, b"    fn report(&self) {\n");
    buf_bytes(out, b"        let gpa = *self.items.allocator();      // a Vec's allocator, to allocate with\n");
    buf_bytes(out, b"        let mut order = self.items.clone();     // a copy (in that allocator)\n");
    buf_bytes(out, b"        order.sort_by(|a, b| value(b).cmp(&value(a)).then(a.name.cmp(b.name)));\n");
    buf_bytes(out, b"        let mut out = String::new_in(gpa);\n");
    buf_bytes(out, b"        let mut total = 0;\n");
    buf_bytes(out, b"        for it in &order {\n");
    buf_bytes(out, b"            writeln(&mut out, \"{:<5}{:>3} x {:>2} = {}\", it.name, it.count, it.price, value(it)).unwrap();\n");
    buf_bytes(out, b"            total += value(it);\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        println(\"{out}total {total}\");\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn value(it: &Item) -> i64 {\n");
    buf_bytes(out, b"    it.count * it.price\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A test case is two files: the input in `tests/basic.in`, the expected\n");
    buf_bytes(out, b"output in `tests/basic.out`. `volec test` builds the program and runs\n");
    buf_bytes(out, b"every case (`test main.vl: 1 passed (1 case; -O0 and -O2 agree)`, or\n");
    buf_bytes(out, b"the first lines that differ):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```in\n");
    buf_bytes(out, b"# a day at the shop\n");
    buf_bytes(out, b"add pen 10 3\n");
    buf_bytes(out, b"add ink 4 12\n");
    buf_bytes(out, b"add cap 6 8   # caps arrived\n");
    buf_bytes(out, b"sell pen 3\n");
    buf_bytes(out, b"sell hat 1\n");
    buf_bytes(out, b"add pen x 2\n");
    buf_bytes(out, b"sell ink 9\n");
    buf_bytes(out, b"add ink 1 12\n");
    buf_bytes(out, b"refund pen 1\n");
    buf_bytes(out, b"sell cap\n");
    buf_bytes(out, b"report\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"line 6: no item hat\n");
    buf_bytes(out, b"line 7: not a number: x\n");
    buf_bytes(out, b"line 8: only 4 ink left\n");
    buf_bytes(out, b"line 10: unknown command refund\n");
    buf_bytes(out, b"line 11: sell takes 2 arguments\n");
    buf_bytes(out, b"ink    5 x 12 = 60\n");
    buf_bytes(out, b"cap    6 x  8 = 48\n");
    buf_bytes(out, b"pen    7 x  3 = 21\n");
    buf_bytes(out, b"total 129\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## What differs from Rust here\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- No macros: `println(\"line {}: {e}\", i + 1)`, `write(f, \"..\")` and\n");
    buf_bytes(out, b"  `writeln(&mut out, \"..\", args)` are functions with Rust's format\n");
    buf_bytes(out, b"  strings.\n");
    buf_bytes(out, b"- Nothing allocates without an allocator. `main` gets `gpa` and passes\n");
    buf_bytes(out, b"  it down. A function that allocates takes `gpa: Gpa`\n");
    buf_bytes(out, b"  (`collect_in(gpa)`, `String::new_in(gpa)`); one holding a `Vec` can\n");
    buf_bytes(out, b"  use `*v.allocator()`. The allocator is in the type: `Vec<&str, Gpa>`,\n");
    buf_bytes(out, b"  `String<Gpa>`, and a struct that holds one is generic over it\n");
    buf_bytes(out, b"  (`Store<'a, A: Allocator>`, used as `Store<'a, Gpa>`).\n");
    buf_bytes(out, b"- `match` has no string patterns yet: `if verb == \"add\"`.\n");
    buf_bytes(out, b"- `mod command;` in main.vl makes `command` a name every module of the\n");
    buf_bytes(out, b"  program imports from: `use command::{Command, Error, Item};` in\n");
    buf_bytes(out, b"  store.vl (Rust: `use crate::command::..`, which works here too).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The rest is Rust's: text is `&str`, slices of `input` that borrow it\n");
    buf_bytes(out, b"(`'a` on `Item`, `Command`, `Error` and `Store` says so), `&mut store`\n");
    buf_bytes(out, b"for the function that changes it, `Display` by hand, `sort_by` with an\n");
    buf_bytes(out, b"`Ordering` (`a.cmp(&b).then(..)`), and values dropped at the end of\n");
    buf_bytes(out, b"their scope (`volec guide memory`).\n");
}
