use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# A whole program (0.17)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"One complete program, written the way vole code is written: modules\n");
    buf_bytes(out, b"and `use`, enums with data and `match`, `Result` and `?`, `Vec`,\n");
    buf_bytes(out, b"`HashMap`, `String`, text as `[u8]`, a sort closure, format strings, the\n");
    buf_bytes(out, b"allocator passed down from `main`, and a test case. A program of this\n");
    buf_bytes(out, b"kind needs only what it shows: copy its patterns.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`stock` reads commands from stdin, one a line, and prints a line for\n");
    buf_bytes(out, b"each command it rejects and the report it is asked for. It has three\n");
    buf_bytes(out, b"files next to each other: `volec main.vl -o prog` builds them all.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole main.vl\n");
    buf_bytes(out, b"// stock: a ledger of items. Reads commands from stdin, one a line; prints\n");
    buf_bytes(out, b"// the report it is asked for, and a line for each command it rejects.\n");
    buf_bytes(out, b"mod command;\n");
    buf_bytes(out, b"mod store;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"use command::{Error, parse};\n");
    buf_bytes(out, b"use store::Store;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let input = read_stdin_in(gpa).unwrap();    // all of stdin, a Vec<u8, Gpa>\n");
    buf_bytes(out, b"    var store = Store::new(gpa);                // it allocates: give it gpa\n");
    buf_bytes(out, b"    var sc = Scanner::new(input.as_slice());\n");
    buf_bytes(out, b"    var line_no = 0;\n");
    buf_bytes(out, b"    while let Some(raw) = sc.next_line() {      // a line, without its '\\n'\n");
    buf_bytes(out, b"        line_no += 1;\n");
    buf_bytes(out, b"        let line = trim(cut_comment(raw));      // views into input: no copies\n");
    buf_bytes(out, b"        if line.len() == 0 {\n");
    buf_bytes(out, b"            continue;\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        if let Err(e) = run(&store, line, gpa) {    // &: run may change store\n");
    buf_bytes(out, b"            println(\"line {line_no}: {e}\");    // Error has Display\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}                                               // store, then input, dropped (freed)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// One line: parsed, then applied; `?` passes the first Err up.\n");
    buf_bytes(out, b"fn run(store: inout Store<Gpa>, line: [u8], gpa: Gpa) -> Result<(), Error> {\n");
    buf_bytes(out, b"    let cmd = parse(line, gpa)?;\n");
    buf_bytes(out, b"    store.apply(cmd)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// s up to its first '#'.\n");
    buf_bytes(out, b"fn cut_comment(s: [u8]) -> [u8] {\n");
    buf_bytes(out, b"    for i in 0..s.len() {\n");
    buf_bytes(out, b"        if s[i] == '#' {                        // '#' is a u8\n");
    buf_bytes(out, b"            return s[..i];                      // a slice of s: s[a..b], s[a..]\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    s\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole command.vl\n");
    buf_bytes(out, b"// A line of input as a Command, or the Error that rejects it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// A field is private to its module unless `pub` (0.26): store.vl reads\n");
    buf_bytes(out, b"// these. Clone: Vec::clone needs it (the derives: Eq, Ord, Hash, Debug,\n");
    buf_bytes(out, b"// Clone).\n");
    buf_bytes(out, b"#[derive(Clone)]\n");
    buf_bytes(out, b"pub struct Item { pub name: [u8], pub count: i64, pub price: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// Variants carry data, tuple-like or struct-like, as in Rust.\n");
    buf_bytes(out, b"pub enum Command {\n");
    buf_bytes(out, b"    Add(Item),\n");
    buf_bytes(out, b"    Sell { name: [u8], count: i64 },\n");
    buf_bytes(out, b"    Report,\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"pub enum Error {\n");
    buf_bytes(out, b"    Unknown([u8]),\n");
    buf_bytes(out, b"    Arity([u8], i64),\n");
    buf_bytes(out, b"    BadNumber([u8]),\n");
    buf_bytes(out, b"    NoItem([u8]),\n");
    buf_bytes(out, b"    Short([u8], i64),\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// What `{e}` in a format string prints.\n");
    buf_bytes(out, b"impl Display for Error {\n");
    buf_bytes(out, b"    fn fmt(self, f: inout Fmt) {\n");
    buf_bytes(out, b"        match self {\n");
    buf_bytes(out, b"            Error::Unknown(w) => f.write(\"unknown command {w}\"),\n");
    buf_bytes(out, b"            Error::Arity(w, n) => f.write(\"{w} takes {} arguments\", n - 1),\n");
    buf_bytes(out, b"            Error::BadNumber(w) => f.write(\"not a number: {w}\"),\n");
    buf_bytes(out, b"            Error::NoItem(name) => f.write(\"no item {name}\"),\n");
    buf_bytes(out, b"            Error::Short(name, have) => f.write(\"only {have} {name} left\"),\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// `add NAME COUNT PRICE`, `sell NAME COUNT` or `report`.\n");
    buf_bytes(out, b"pub fn parse(line: [u8], gpa: Gpa) -> Result<Command, Error> {\n");
    buf_bytes(out, b"    let words = split_whitespace_in(line, gpa); // Vec<[u8]>: views into line\n");
    buf_bytes(out, b"    let w = words.as_slice();                   // [[u8]]\n");
    buf_bytes(out, b"    let verb = w[0];\n");
    buf_bytes(out, b"    if verb == \"add\" {                          // text is compared with ==, not matched\n");
    buf_bytes(out, b"        arity(w, 4)?;\n");
    buf_bytes(out, b"        let item = Item { name: w[1], count: number(w[2])?, price: number(w[3])? };\n");
    buf_bytes(out, b"        Ok(Command::Add(item))\n");
    buf_bytes(out, b"    } else if verb == \"sell\" {\n");
    buf_bytes(out, b"        arity(w, 3)?;\n");
    buf_bytes(out, b"        Ok(Command::Sell { name: w[1], count: number(w[2])? })\n");
    buf_bytes(out, b"    } else if verb == \"report\" {\n");
    buf_bytes(out, b"        Ok(Command::Report)\n");
    buf_bytes(out, b"    } else {\n");
    buf_bytes(out, b"        Err(Error::Unknown(verb))\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn arity(w: [[u8]], n: i64) -> Result<(), Error> {\n");
    buf_bytes(out, b"    if w.len() as i64 != n {\n");
    buf_bytes(out, b"        return Err(Error::Arity(w[0], n));\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// A count or a price: a number, not negative.\n");
    buf_bytes(out, b"fn number(w: [u8]) -> Result<i64, Error> {\n");
    buf_bytes(out, b"    match parse_int(w) {\n");
    buf_bytes(out, b"        Ok(n) if n >= 0 => Ok(n),\n");
    buf_bytes(out, b"        _ => Err(Error::BadNumber(w)),\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole store.vl\n");
    buf_bytes(out, b"// The items in stock, in the order they were first added.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"use command::{Command, Error, Item};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"pub struct Store<A: Allocator> {\n");
    buf_bytes(out, b"    items: Vec<Item, A>,\n");
    buf_bytes(out, b"    index: HashMap<[u8], i64, A>,               // name -> its position in items\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Store<Gpa> {\n");
    buf_bytes(out, b"    pub fn new(gpa: Gpa) -> Store<Gpa> {\n");
    buf_bytes(out, b"        Store { items: Vec::new_in(gpa), index: HashMap::new_in(gpa) }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    // No free: a Store drops its fields (items, then index) when it is dropped.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    pub fn apply(inout self, cmd: Command) -> Result<(), Error> {\n");
    buf_bytes(out, b"        match cmd {\n");
    buf_bytes(out, b"            Command::Add(item) => match self.index.get(item.name) {\n");
    buf_bytes(out, b"                Some(i) => {\n");
    buf_bytes(out, b"                    self.items[i].count += item.count;\n");
    buf_bytes(out, b"                    self.items[i].price = item.price;\n");
    buf_bytes(out, b"                }\n");
    buf_bytes(out, b"                None => {\n");
    buf_bytes(out, b"                    self.index.insert(item.name, self.items.len() as i64);\n");
    buf_bytes(out, b"                    self.items.push(item);\n");
    buf_bytes(out, b"                }\n");
    buf_bytes(out, b"            },\n");
    buf_bytes(out, b"            Command::Sell { name, count } => {\n");
    buf_bytes(out, b"                let i = self.index.get(name).ok_or(Error::NoItem(name))?;\n");
    buf_bytes(out, b"                let have = self.items[i].count;\n");
    buf_bytes(out, b"                if have < count {\n");
    buf_bytes(out, b"                    return Err(Error::Short(name, have));\n");
    buf_bytes(out, b"                }\n");
    buf_bytes(out, b"                self.items[i].count = have - count;\n");
    buf_bytes(out, b"            }\n");
    buf_bytes(out, b"            Command::Report => self.report(),\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        Ok(())\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    // The items by value, highest first, ties by name; then the total.\n");
    buf_bytes(out, b"    fn report(self) {\n");
    buf_bytes(out, b"        let gpa = self.items.allocator();       // a Vec's allocator, to allocate with\n");
    buf_bytes(out, b"        var order = self.items.clone();         // a copy (in that allocator)\n");
    buf_bytes(out, b"        order.sort_by(|a, b| {                  // a, b: let Item; < 0: a goes first\n");
    buf_bytes(out, b"            let d = b.count * b.price - a.count * a.price;\n");
    buf_bytes(out, b"            if d != 0 { d } else { cmp_of(a.name, b.name) }\n");
    buf_bytes(out, b"        });\n");
    buf_bytes(out, b"        var out = String::new_in(gpa);          // as Rust's String\n");
    buf_bytes(out, b"        var total = 0;\n");
    buf_bytes(out, b"        for it in order {\n");
    buf_bytes(out, b"            out.push_fmt(\"{:<5}{:>3} x {:>2} = {}\\n\", it.name, it.count, it.price, value(it));\n");
    buf_bytes(out, b"            total += value(it);\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        out.push_str(\"total \");\n");
    buf_bytes(out, b"        out.push_fmt(total);\n");
    buf_bytes(out, b"        println(out.as_slice());\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn value(it: Item) -> i64 {\n");
    buf_bytes(out, b"    it.count * it.price\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A test case is two files: the input in `tests/basic.in`, the expected\n");
    buf_bytes(out, b"output in `tests/basic.out`. `volec test` builds the program and runs\n");
    buf_bytes(out, b"every case (`test main.vl: 1 passed (tests/)`, or the first lines that\n");
    buf_bytes(out, b"differ):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```in\n");
    buf_bytes(out, b"# a day at the shop\n");
    buf_bytes(out, b"add pen 10 3\n");
    buf_bytes(out, b"add ink 4 12\n");
    buf_bytes(out, b"add cap 6 8   # caps arrived\n");
    buf_bytes(out, b"sell pen 3\n");
    buf_bytes(out, b"sell hat 1\n");
    buf_bytes(out, b"add pen x 2\n");
    buf_bytes(out, b"sell ink 9\n");
    buf_bytes(out, b"add ink 1 12\n");
    buf_bytes(out, b"refund pen 1\n");
    buf_bytes(out, b"sell cap\n");
    buf_bytes(out, b"report\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"line 6: no item hat\n");
    buf_bytes(out, b"line 7: not a number: x\n");
    buf_bytes(out, b"line 8: only 4 ink left\n");
    buf_bytes(out, b"line 10: unknown command refund\n");
    buf_bytes(out, b"line 11: sell takes 2 arguments\n");
    buf_bytes(out, b"ink    5 x 12 = 60\n");
    buf_bytes(out, b"cap    6 x  8 = 48\n");
    buf_bytes(out, b"pen    7 x  3 = 21\n");
    buf_bytes(out, b"total 129\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## What differs from Rust here\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Text is `[u8]`, a view: `trim`, `split_whitespace_in`, `s[a..b]`\n");
    buf_bytes(out, b"  copy nothing. A name stays valid while the buffer it views lives,\n");
    buf_bytes(out, b"  here `input`, until `main` returns. Text is compared with `==` and `<`;\n");
    buf_bytes(out, b"  `match` has no string patterns.\n");
    buf_bytes(out, b"- Enum variants are tuple-like or struct-like; patterns as in Rust, with\n");
    buf_bytes(out, b"  guards (`Ok(n) if n >= 0`), `if let`, `while let`. `match self` on a\n");
    buf_bytes(out, b"  let `self` binds let accesses into it, used as their values (`w`,\n");
    buf_bytes(out, b"  `n - 1`).\n");
    buf_bytes(out, b"- `#[derive(Eq, Ord, Hash, Debug, Clone)]` (no `PartialEq`, no `Copy`\n");
    buf_bytes(out, b"  derive: a struct of numbers and views, as `Item`, copies; one holding a\n");
    buf_bytes(out, b"  `Vec`, `Buf` or `HashMap`, as `Store`, moves). `Display` is written by\n");
    buf_bytes(out, b"  hand, with `f.write(\"..\", args)`: `fn fmt(self, f: inout Fmt)`.\n");
    buf_bytes(out, b"- Nothing allocates without an allocator. `main` gets `gpa` and passes\n");
    buf_bytes(out, b"  it down. A function that allocates takes `gpa: Gpa`; one holding a\n");
    buf_bytes(out, b"  `Vec` can use `v.allocator()`. Nothing is freed by hand: a value is\n");
    buf_bytes(out, b"  dropped at the end of its scope (`volec guide memory`).\n");
    buf_bytes(out, b"- Parameters are let by default: read-only, borrowed for the call\n");
    buf_bytes(out, b"  (`value(it)`, `report(self)`). One that changes its argument says\n");
    buf_bytes(out, b"  `inout`, and the call marks it: `run(store: inout Store, ..)` is\n");
    buf_bytes(out, b"  called `run(&store, ..)`; `apply(inout self)` is called\n");
    buf_bytes(out, b"  `store.apply(cmd)` on a `var store`. A `sink` parameter takes the\n");
    buf_bytes(out, b"  value. Bindings: `let` (fixed), `var` (changes).\n");
    buf_bytes(out, b"- Comparators return an `i64` (negative: `a` first) and take their\n");
    buf_bytes(out, b"  elements let: `sort_by(|a, b| ..)`, `cmp_of(a, b)`.\n");
    buf_bytes(out, b"- `String<A>` is Rust's `String`: `push_str`, `push_fmt(\"..\", args)`,\n");
    buf_bytes(out, b"  `as_str()`, `as_slice()`.\n");
}
