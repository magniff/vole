// Generated by compiler/guide/embed.sh from compiler/guide/debug.md (do
// not edit): the guide's topic 'debug'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Debugging\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`query` and `edit` answer where code is and how to change it. These\n");
    buf_bytes(out, b"tools answer what the program does: where it failed, which values a line\n");
    buf_bytes(out, b"saw, which part of an input matters. None of them edits the source.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The recipe\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"1. Make the failure a test case: the input in `tests/NAME.in`, the\n");
    buf_bytes(out, b"   output it should give in `tests/NAME.out`. Then run `volec test\n");
    buf_bytes(out, b"   NAME`. Tests are built with `--trace`. A crash prints its line and\n");
    buf_bytes(out, b"   the calls that led to it, and a hang stopped by `--timeout S` prints\n");
    buf_bytes(out, b"   where it was running. For one run without a case: `volec test\n");
    buf_bytes(out, b"   --input FILE`.\n");
    buf_bytes(out, b"2. Read the trace. Its first frame, `FILE:LINE  function`, is the\n");
    buf_bytes(out, b"   failing statement. `volec query show FILE:LINE` prints its item.\n");
    buf_bytes(out, b"3. See the values without editing:\n");
    buf_bytes(out, b"   `volec probe FILE:LINE EXPR... -- ARGS` (or `--input FILE` for\n");
    buf_bytes(out, b"   stdin). It runs any program, an example too, from anywhere: the\n");
    buf_bytes(out, b"   FILE names its program (the nearest `main.vl` that declares it).\n");
    buf_bytes(out, b"   Probe the lines above the failure, then the callers in the trace. `--count FILE:LINE`\n");
    buf_bytes(out, b"   says how often a line runs (a loop that never ends, a branch never\n");
    buf_bytes(out, b"   taken).\n");
    buf_bytes(out, b"4. If the input is too big to reason about, shrink it:\n");
    buf_bytes(out, b"   `volec reduce FILE --until 'CMD'`.\n");
    buf_bytes(out, b"5. Fix the bug (`edit patch`), then run `volec test` again. In the\n");
    buf_bytes(out, b"   vole tree, each failing case is also run with\n");
    buf_bytes(out, b"   `target/tools/volec`. A case that fails there too\n");
    buf_bytes(out, b"   (`failing too`) was not broken by your change.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Failure traces\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec FILE.vl --trace -o prog` builds with a shadow stack: each\n");
    buf_bytes(out, b"function's frame records the statement it is running. A failed check\n");
    buf_bytes(out, b"prints the frames, innermost first:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"index out of bounds: index 0, length 0\n");
    buf_bytes(out, b"trace, innermost call first:\n");
    buf_bytes(out, b"  stats.vl:44  stats::best\n");
    buf_bytes(out, b"  main.vl:25  main\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The first frame is the line of the failing index (or `unwrap`, `panic`).\n");
    buf_bytes(out, b"The frames below it are the calls that led there, each at the line of its\n");
    buf_bytes(out, b"call. A program stopped by SIGALRM (`volec test --timeout`), SIGINT,\n");
    buf_bytes(out, b"SIGTERM or SIGSEGV prints `stopped by signal N` and the frames. A loop\n");
    buf_bytes(out, b"without calls shows its own line.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`--trace` builds at -O1 or -O2 (with -O0, at -O1). It costs a few\n");
    buf_bytes(out, b"instructions per call and per loop iteration: the compiler runs about\n");
    buf_bytes(out, b"25% slower when built with it, and its binary is larger. Without\n");
    buf_bytes(out, b"`--trace`, a failure is one line, its position and message:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn pick(v: &[i64], i: usize) -> i64 {\n");
    buf_bytes(out, b"    v[i]\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let v = [1, 2, 3];\n");
    buf_bytes(out, b"    println(\"{}\", pick(&v, v.len()));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out (exit 101)\n");
    buf_bytes(out, b"main.vl:2:5: index out of bounds: index 3, length 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec test` builds with `--trace` (`--no-trace` turns it off). A\n");
    buf_bytes(out, b"failing case shows the first lines of its stderr, so the trace appears\n");
    buf_bytes(out, b"in the summary.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## probe\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"$ volec probe stats.vl:46 i m 'v[i]' --input tests/ok.in\n");
    buf_bytes(out, b"probe stats.vl:46 (before `if v[i] > m {`): 2 times\n");
    buf_bytes(out, b"  #1  i = 1  m = 3  v[i] = 7\n");
    buf_bytes(out, b"  #2  i = 1  m = 3  v[i] = 7\n");
    buf_bytes(out, b"run: exit 0; stdout 4 lines (target/scratch/probe/main.vl/out)\n");
    buf_bytes(out, b"  | a best 7\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Each `FILE:LINE` starts a probe, and the expressions after it are\n");
    buf_bytes(out, b"printed each time it runs (the first 10 times; `--max N`). Where it goes\n");
    buf_bytes(out, b"depends on the line:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| the line | the probe |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| begins a statement | runs before it |\n");
    buf_bytes(out, b"| begins a `let` | runs after it: the new names are visible |\n");
    buf_bytes(out, b"| begins `while`, `for`, `loop` | runs at the start of the body, each time round |\n");
    buf_bytes(out, b"| opens a block (`} else {`, `X => {`, `fn f(x: T) {`) | runs at the start of that block |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Values are printed by type. Integers, floats and bool print as values,\n");
    buf_bytes(out, b"`&str` and `String` quoted, arrays and slices up to 16 elements, `Option` and tuples\n");
    buf_bytes(out, b"element by element, pointers as addresses. A struct uses Debug when it\n");
    buf_bytes(out, b"has it, else prints field by field. The program is built from copies of\n");
    buf_bytes(out, b"its files with the probes written in (`--overlay`), so line numbers stay\n");
    buf_bytes(out, b"the same, and with `--trace`. The copies, the build and the outputs are\n");
    buf_bytes(out, b"never in the program's source tree: `target/scratch/probe/NAME/` of the\n");
    buf_bytes(out, b"checkout (NAME: the root's path, `-` for `/`), else\n");
    buf_bytes(out, b"`$TMPDIR/volec-probe/NAME/`; the copies are removed after the run. Then it runs with `-- ARGS` and stdin from\n");
    buf_bytes(out, b"`--input FILE` (or the command's own stdin), within `--timeout S` (10).\n");
    buf_bytes(out, b"The report lists each probe's count and values, then the exit status,\n");
    buf_bytes(out, b"the start of stdout and stderr.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Several probes go in one run: `volec probe a.vl:10 x a.vl:20 y`.\n");
    buf_bytes(out, b"`--count FILE:LINE` counts runs without printing. A probe whose name is\n");
    buf_bytes(out, b"not in scope at its line is an error (`probe.expr`), so probe a later\n");
    buf_bytes(out, b"line for a value made later.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`probe` runs any vole program, not only a `tests/` case: the program is\n");
    buf_bytes(out, b"the one FILE belongs to (its `main.vl`, or `--root ROOT`), its\n");
    buf_bytes(out, b"arguments come after `--`. From the root of the tree, an example run with\n");
    buf_bytes(out, b"its own flags:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"$ volec probe examples/nes/check.vl:234 mode1 prg power -- --check\n");
    buf_bytes(out, b"probe examples/nes/check.vl:234 (before `cart.cpu_write(0x8000, 0x00);`): 1 time\n");
    buf_bytes(out, b"  #1  mode1 = true  prg = true  power = true\n");
    buf_bytes(out, b"run: exit 0; stdout 1 line (target/scratch/probe/examples-nes-main.vl/out)\n");
    buf_bytes(out, b"  | ok: 21 NES checks passed\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"In the vole tree the default program is the compiler itself. To see what\n");
    buf_bytes(out, b"it does when compiling a test:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"volec probe compiler/src/front/check/interp.vl:633 h t -- case.vl -o /tmp/p\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## reduce\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"$ volec reduce big.in --until './prog < {} > /dev/null 2>&1; test $? = 101'\n");
    buf_bytes(out, b"reduced big.in: 304 lines to 2 in 35 runs; written to big.in.min\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`{}` is the candidate's path. CMD must exit with 0 while the failure is\n");
    buf_bytes(out, b"still there: `./prog < {} | grep -q wrong` for wrong output,\n");
    buf_bytes(out, b"`test $? = 101` for a crash. For a compiler bug, use\n");
    buf_bytes(out, b"`target/volec {} -o /tmp/p 2>&1 | grep -q 'MESSAGE'`. Lines are left\n");
    buf_bytes(out, b"out in chunks, and the chunks are halved when none can go. A run that\n");
    buf_bytes(out, b"takes longer than `--timeout S` (5) counts as not failing.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Other questions\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| to know | run |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| who changes a field or static | `volec query refs Struct.field --kind write` |\n");
    buf_bytes(out, b"| who calls a function, transitively | `volec query callers NAME`, `query callees FN --transitive` |\n");
    buf_bytes(out, b"| whether optimization changes it | `volec test -O 0`, then `volec test` (-O2) |\n");
    buf_bytes(out, b"| which test a compiler change broke | `volec test FILTER` (vole tree): `new` vs `failing too` |\n");
    buf_bytes(out, b"| what an expression gives | `volec try 'STATEMENTS'` |\n");
}
