// Generated by compiler/guide/embed.sh from compiler/guide/how.md (do
// not edit): the guide's topic 'how'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# How to add an X\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Recipes for the changes made again and again (0.17): the files, the\n");
    buf_bytes(out, b"commands in order, the test, the docs. `volec guide how TASK` prints\n");
    buf_bytes(out, b"one; `volec query examples KIND` prints the items to start from, and\n");
    buf_bytes(out, b"`volec query similar NAME` the items like one you name (copy the\n");
    buf_bytes(out, b"nearest). In the vole repository (commands from its root):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `add-std-fn`: a std function or method\n");
    buf_bytes(out, b"- `add-std-module`: a std module (a file of compiler/std2)\n");
    buf_bytes(out, b"- `add-peephole`: an instruction-combining or e-graph rule\n");
    buf_bytes(out, b"- `add-pass`: an optimization pass\n");
    buf_bytes(out, b"- `add-diagnostic`: a compiler error, or a tool diagnostic with a code\n");
    buf_bytes(out, b"- `add-test`: a test case\n");
    buf_bytes(out, b"- `add-subcommand`: a `volec` command, or a `query` command\n");
    buf_bytes(out, b"- `add-guide-text`: a paragraph or an example in the guide\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"In a program of your own:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `add-module`: a module (a file) to a program\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## add-std-fn\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To add a std function or method.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"std is `compiler/std2/`: the module `std` (`std.vl`) and its modules\n");
    buf_bytes(out, b"(`std::fmt` in `fmt.vl`, `std::collections::hash_map` in\n");
    buf_bytes(out, b"`collections/hash_map.vl`); `compiler/std/embed.sh` builds it into the\n");
    buf_bytes(out, b"compiler (`compiler/src/front/stdsrc_rust.vl`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"1. Find where it goes: `volec query similar str::trim` (or\n");
    buf_bytes(out, b"   `Vec::swap`) prints its neighbours, with their files\n");
    buf_bytes(out, b"   (`compiler/std2/str.vl:334`); `volec query examples std-fn`.\n");
    buf_bytes(out, b"2. Add it in its file, next to its kin, with an editor (std is one text\n");
    buf_bytes(out, b"   to the compiler, `<std>`: `volec edit` does not write its files),\n");
    buf_bytes(out, b"   then `volec fmt FILE`. A function that allocates takes its\n");
    buf_bytes(out, b"   allocator: a constructor or an `_in` function with the allocator\n");
    buf_bytes(out, b"   last (`Vec::new_in(a)`, `s.to_vec_in(a)`). `volec check` of any\n");
    buf_bytes(out, b"   program then reads the edited files (`note check.std-files`), every\n");
    buf_bytes(out, b"   function of std.\n");
    buf_bytes(out, b"3. `compiler/std/embed.sh` (the commit hook runs it too).\n");
    buf_bytes(out, b"4. A test: `tests/run/std2_NAME.vl` with `// EXPECT:` lines (edge\n");
    buf_bytes(out, b"   cases: empty, too long, at the ends); see `add-test`.\n");
    buf_bytes(out, b"5. The guide: a sentence and a `vole` example with its `out` block in\n");
    buf_bytes(out, b"   `compiler/guide/std.md` (the API listing at its end is generated);\n");
    buf_bytes(out, b"   `compiler/guide/embed.sh`.\n");
    buf_bytes(out, b"6. `bootstrap/bootstrap.sh --dev --no-suite` (the compiler with the new\n");
    buf_bytes(out, b"   std), then `tests/run.sh std2_NAME guide`, `tests/run.sh -O 0\n");
    buf_bytes(out, b"   std2_NAME`; before reporting, `tests/affected.sh`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## add-std-module\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To add a std module (a file of `compiler/std2`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"1. The file, `compiler/std2/NAME.vl` (or `NAME/mod.vl`; a child of\n");
    buf_bytes(out, b"   `std::a` in `a/`), and its `mod NAME;` (or `pub mod NAME;`) line in\n");
    buf_bytes(out, b"   the parent's file: embed.sh finds the modules by those lines.\n");
    buf_bytes(out, b"2. A build reads only the units of std a program reaches (the index\n");
    buf_bytes(out, b"   embed.sh makes with the compiler, `std2_units`); `volec check` reads\n");
    buf_bytes(out, b"   all of std. So check with a build too: `bootstrap/bootstrap.sh --dev\n");
    buf_bytes(out, b"   --no-suite`, then `target/volec PROG.vl -o x` of a program that uses\n");
    buf_bytes(out, b"   the module. A build made again with std whole says so (`tests/run.sh`\n");
    buf_bytes(out, b"   counts them, `lazy std: N build(s)`; `VOLE_STD2_NORERUN=1` shows why).\n");
    buf_bytes(out, b"3. Tests and docs as for `add-std-fn`. `volec guide std`'s index has a\n");
    buf_bytes(out, b"   size limit (`tests/run.sh guide`: guide-std-index); a module with its\n");
    buf_bytes(out, b"   own topic, or one programs seldom name, leaves the index\n");
    buf_bytes(out, b"   (compiler/src/guide/stdapi.vl: `index_hides`).\n");
    buf_bytes(out, b"4. The transcripts: `tests/run.sh query refactor walkthrough lsp stdpos`.\n");
    buf_bytes(out, b"   They compare std's positions, counts and list of modules normalized\n");
    buf_bytes(out, b"   (tests/stdpos.awk), so only one about std itself (`## exact-std`) or\n");
    buf_bytes(out, b"   one whose output names the new items fails; rewrite it with its\n");
    buf_bytes(out, b"   runner's `-u` (`tests/query/run.sh -u NAME`), which keeps the std\n");
    buf_bytes(out, b"   numbers of a line that did not change otherwise, and read the diff.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## add-peephole\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To add an instruction-combining or e-graph rule.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An algebraic identity on constants and operations (`(x + c1) + c2`):\n");
    buf_bytes(out, b"a line of `crate::middle::egraph::rule_text`, such as\n");
    buf_bytes(out, b"`(neg (neg x)) => x` or `(mul x c1) if (pow2 c1) => (shl x (log2 c1))`;\n");
    buf_bytes(out, b"the array's length and `RULE_COUNT` grow by one, in the same edit\n");
    buf_bytes(out, b"(`volec edit patch rule_text --pairs FILE` with a `@@ RULE_COUNT`\n");
    buf_bytes(out, b"block for the second target, or `volec edit apply`). `volec --check-rules` tests every rule on\n");
    buf_bytes(out, b"random values (the suite runs it).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Anything else (a select, a negated comparison, an address): a function\n");
    buf_bytes(out, b"`combine_X(cx: &mut FnCtx, v: i64, pcx: &Ctx<Comp>) -> bool` in\n");
    buf_bytes(out, b"`compiler/src/middle/fold/mod.vl`,\n");
    buf_bytes(out, b"section \"Instruction combining\", called from `combine` on the\n");
    buf_bytes(out, b"instruction's op; true when it changed `v` (in place, or with\n");
    buf_bytes(out, b"`replace_same_type`, `make_const`, `op_before`). Templates: `volec\n");
    buf_bytes(out, b"query examples peephole`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Test: `tests/run/opt_NAME.vl`, a program with `// EXPECT:` and\n");
    buf_bytes(out, b"`// CHECK:` / `// CHECK-NOT:` lines on the optimized IR (`--emit-ir`;\n");
    buf_bytes(out, b"`tests/run/opt_egraph.vl`); `tests/run.sh opt_` at `-O 0`, `1`, `2`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## add-pass\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To add an optimization pass.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"1. `volec edit new-file compiler/src/middle/NAME.vl < text` (adds\n");
    buf_bytes(out, b"   the `mod` line): `pub fn NAME(cx: &mut FnCtx, fi: i64, pcx:\n");
    buf_bytes(out, b"   &Ctx<Comp>) -> bool`, true when it changed function `fi`. Templates: `volec query examples pass`\n");
    buf_bytes(out, b"   (`elide_copies`, `thread_tags`).\n");
    buf_bytes(out, b"2. Call it in `compiler/src/middle/opt.vl`: in `simplify_function`\n");
    buf_bytes(out, b"   (scalar, -O1 and -O2) as `if round == 0 && NAME(cx, fi, pcx) {\n");
    buf_bytes(out, b"   verify_func(cx, fi, c\"NAME\", pcx); }`, or in `optimize_loops` (-O2) as\n");
    buf_bytes(out, b"   `if NAME(cx, fi, pcx) { changed = true; light_cleanup(cx, fi, pcx); }`. `verify_func` checks the IR under\n");
    buf_bytes(out, b"   `--verify-ir` and prints it under `--print-after-all`.\n");
    buf_bytes(out, b"3. Test: `tests/run/opt_NAME.vl` with `// CHECK:` lines (see\n");
    buf_bytes(out, b"   `add-peephole`); `tests/run.sh opt_`; `tests/fuzz/run.sh` (random\n");
    buf_bytes(out, b"   programs at every level); `--time-passes` for its compile time.\n");
    buf_bytes(out, b"   An alias fact (two accesses that never overlap) also needs a case\n");
    buf_bytes(out, b"   that breaks if the fact is wrong: a write through another base (a\n");
    buf_bytes(out, b"   pointer kept in a static, another Vec's buffer) between the two\n");
    buf_bytes(out, b"   accesses, with no call between them (a call, or a write through the\n");
    buf_bytes(out, b"   same base, is handled before the fact is asked, so such a case passes\n");
    buf_bytes(out, b"   with a wrong fact too); `// FLAGS: --check-alloc` makes a stale read\n");
    buf_bytes(out, b"   fault. Show that it can fail: make the fact always say \"apart\",\n");
    buf_bytes(out, b"   `bootstrap/bootstrap.sh --dev --no-suite`, copy target/volec aside,\n");
    buf_bytes(out, b"   `volec undo`, and run `tests/run.sh -c MUTANT -n NAME`: it must fail.\n");
    buf_bytes(out, b"4. Docs: the module table of `compiler/src/middle/README.md`,\n");
    buf_bytes(out, b"   `docs/optimizer.md`. Before reporting: `tests/affected.sh` (and\n");
    buf_bytes(out, b"   `bench/run.sh`: no program may get slower).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## add-diagnostic\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To add a compiler error, or a tool diagnostic with a code.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A compiler error (`error[type error] ... | help: ...`), where the\n");
    buf_bytes(out, b"checker finds it: `err_begin(pos, pcx); err_str(c\"...\", pcx);\n");
    buf_bytes(out, b"err_sym(name, pcx); err_help(c\"try ...\", pcx); err_end(pcx);`\n");
    buf_bytes(out, b"(`err_end_soft(pcx)` goes on checking; `pcx` is the compiler's context,\n");
    buf_bytes(out, b"a parameter of every function that reports).\n");
    buf_bytes(out, b"Templates: `volec query examples diagnostic`. Test:\n");
    buf_bytes(out, b"`tests/run/err_NAME.vl` with `// ERROR: text` lines, the help line\n");
    buf_bytes(out, b"too (`// ERROR: help: ...`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A tool diagnostic (`error edit.not-source: ...` then `try:` lines):\n");
    buf_bytes(out, b"`let d = diag(c\"error\", c\"tool.code\", tcx); buf_str(d, c\"...\\n\");` then\n");
    buf_bytes(out, b"`try_end(try_begin(c\"cmd\", name, true, tcx, pcx))`: a command that runs as it is\n");
    buf_bytes(out, b"written. Then its `explain` entry: an `Explain { code, severity,\n");
    buf_bytes(out, b"means, fix, example }` in `crate::tools::explain::tools_table::TOOLS_TABLE`\n");
    buf_bytes(out, b"(or `refactor_table`), `TOOLS_COUNT` and the array's length one more,\n");
    buf_bytes(out, b"in one `edit apply`; the Diagnostics table of `docs/query.md` or\n");
    buf_bytes(out, b"`docs/refactor.md`. `tests/refactor/run.sh` fails on a code without an\n");
    buf_bytes(out, b"entry (a new tool's prefix, `run.`, goes into its list of prefixes,\n");
    buf_bytes(out, b"the `grep -rhoE` above `self_explain`, or its entries read as `not a\n");
    buf_bytes(out, b"code`). The prefixes are the\n");
    buf_bytes(out, b"`c\"(query|edit|...|run)\\.` list of that `grep -rhoE` in\n");
    buf_bytes(out, b"`tests/refactor/run.sh`. Test: a transcript (`tests/query/NAME.q`,\n");
    buf_bytes(out, b"`tests/refactor/NAME.t`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A `volec --help` row or a `volec CMD --help` text: 15 lines at most\n");
    buf_bytes(out, b"each (`tests/run.sh guide`, its `help-CMD` checks); `volec --help` has\n");
    buf_bytes(out, b"15 now, so a new row merges with another.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## add-test\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To add a test case.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- A program: `tests/run/CATEGORY_NAME.vl` (the category is the name\n");
    buf_bytes(out, b"  up to its first `_`: `std_`, `opt_`, `err_`...), or\n");
    buf_bytes(out, b"  `tests/run/NAME/main.vl` for several modules. Directives in `//`\n");
    buf_bytes(out, b"  comments: `EXPECT:` (stdout, a line each; holes `{num}`, `{int}`,\n");
    buf_bytes(out, b"  `{..}` for what varies), `EXPECT-PPM:` (an image; `volec guide\n");
    buf_bytes(out, b"  testing`), `STDIN:`, `ARGS:`,\n");
    buf_bytes(out, b"  `EXIT:`, `STDERR:`, `ERROR:` (compiling fails with that message),\n");
    buf_bytes(out, b"  `CHECK:` / `CHECK-NOT:` (the IR), `FLAGS:`; the header of\n");
    buf_bytes(out, b"  `tests/run.sh` lists them all. Cases compile with `--deny-warnings`.\n");
    buf_bytes(out, b"- Run it: `tests/run.sh NAME` (cases whose name holds NAME), with\n");
    buf_bytes(out, b"  `-O 0` and `-O 1` too; one case alone: `tests/run.sh -n NAME` (or\n");
    buf_bytes(out, b"  `'=NAME'`, quoted: zsh expands a bare `=NAME`, and nothing runs).\n");
    buf_bytes(out, b"- A tool: a transcript, `$ ARGS` lines and their output:\n");
    buf_bytes(out, b"  `tests/query/NAME.q` (on `tests/query/NAME/main.vl`),\n");
    buf_bytes(out, b"  `tests/refactor/NAME.t` (in a copy of `tests/refactor/NAME/`; `%`\n");
    buf_bytes(out, b"  lines run shell commands); `tests/query/run.sh -u` writes what the\n");
    buf_bytes(out, b"  commands print now (read the diff before keeping it).\n");
    buf_bytes(out, b"- Templates: `volec query examples test`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## add-subcommand\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To add a volec command, or a query command.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A command (`volec NAME ...`): its arguments, `pub fn NAME_leaf(gpa:\n");
    buf_bytes(out, b"Gpa) -> Leaf<'static, Gpa>` (a table of `flag`s and `option`s,\n");
    buf_bytes(out, b"`cli::line`), and `pub fn run_NAME(c: &Call<'_, Gpa>, tcx: &mut\n");
    buf_bytes(out, b"Tcx<Comp>, pcx: &mut Ctx<Comp>) -> i64` reading `c.evs` (its arguments\n");
    buf_bytes(out, b"in the line's order) or `c.m` (their Matches); diagnostics with `diag`,\n");
    buf_bytes(out, b"written with `write_diags(tcx)` before it returns. Its name in `tops` and its leaf\n");
    buf_bytes(out, b"in `leaf_of` (`compiler/src/cli/tree.vl`, volec's Command tree), and its\n");
    buf_bytes(out, b"line in `run_call` (`compiler/src/tools/commands.vl`): `if name ==\n");
    buf_bytes(out, b"\"NAME\" { return run_NAME(c, tcx, pcx); }` (`batch` runs it too). Its `--help`: a\n");
    buf_bytes(out, b"`Help { cmd: \"NAME\", text: \"...\" }` row in `compiler/src/tools/help.vl`\n");
    buf_bytes(out, b"(15 lines at most; `HELP_COUNT` and the array's length one more), and\n");
    buf_bytes(out, b"the command in the list `tests/guide/run.sh` checks `--help` for.\n");
    buf_bytes(out, b"Templates: `volec query examples subcommand` (`run_lint`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A query (`volec query NAME ...`): its name in `command_name`\n");
    buf_bytes(out, b"(`N_COMMANDS` one more), its branch in `answer`, its line in\n");
    buf_bytes(out, b"`put_usage` and in the `query` row of the help table; `volec query\n");
    buf_bytes(out, b"examples query-command`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Docs: `docs/query.md` or `docs/refactor.md`, the tables of\n");
    buf_bytes(out, b"`compiler/guide/tools.md` (then `compiler/guide/embed.sh`), the module\n");
    buf_bytes(out, b"table of `compiler/src/tools/README.md`. Test: a transcript (`add-test`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## add-guide-text\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To add a paragraph or an example in the guide.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The guide is `compiler/guide/TOPIC.md` (the topics and their order:\n");
    buf_bytes(out, b"`compiler/guide/topics.txt`). An example is a `vole` block, then an\n");
    buf_bytes(out, b"`out` block with what it prints (an `in` block before it: its stdin; an\n");
    buf_bytes(out, b"`err` block: it must fail to compile); each is compiled and run.\n");
    buf_bytes(out, b"`tests/guide/run.sh -f compiler/guide/TOPIC.md` checks one topic as you\n");
    buf_bytes(out, b"write it; then `compiler/guide/embed.sh`, `bootstrap/bootstrap.sh --dev\n");
    buf_bytes(out, b"--no-suite` and `tests/run.sh guide`. The core topic has a budget (the test says).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## add-module\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"To add a module (a file) to a program.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"1. `volec edit new-file shapes.vl < text` writes the file and adds\n");
    buf_bytes(out, b"   `mod shapes;` to its parent (`main.vl`); or `volec refactor\n");
    buf_bytes(out, b"   new-module crate::shapes` for an empty one.\n");
    buf_bytes(out, b"2. Items another module uses are `pub`; there they are named\n");
    buf_bytes(out, b"   `crate::shapes::area` or imported: `use crate::shapes::{Shape,\n");
    buf_bytes(out, b"   area};` (`volec fix --only imports` adds the lines a check asks\n");
    buf_bytes(out, b"   for).\n");
    buf_bytes(out, b"3. Items that should move there: `volec refactor move area Shape --to\n");
    buf_bytes(out, b"   crate::shapes` (their uses and imports follow).\n");
    buf_bytes(out, b"4. `volec check`; build with the root, `volec main.vl -o prog`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec guide modules` has the rules (paths, `pub`, `use`).\n");
}
