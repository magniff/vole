// Generated by compiler/guide/embed.sh from compiler/guide/conversions.md (do
// not edit): the guide's topic 'conversions'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Conversions and errors (0.15)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Widening between integers, `From`/`Into`, the `?` operator, `main`\n");
    buf_bytes(out, b"returning a `Result`, and std's convention for failure: Option means\n");
    buf_bytes(out, b"absent, Result means failed.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Widening\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A narrower integer becomes a wider one where a value of the wider type\n");
    buf_bytes(out, b"is expected: `let x: T = v`, assignment and `+=`, arguments, `return`,\n");
    buf_bytes(out, b"a block's last value, struct fields, variant payloads, array and tuple\n");
    buf_bytes(out, b"elements. It is lossless, so it is implicit; nothing else is:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- it widens: `i8 -> i16 -> i32 -> i64` and `u8 -> u16 -> u32 -> u64`\n");
    buf_bytes(out, b"  (the same signedness), and unsigned to a strictly wider signed type\n");
    buf_bytes(out, b"  (`u8 -> i16`, `u32 -> i64`); `usize` and `isize` are 64-bit types of\n");
    buf_bytes(out, b"  their own (0.26.2): `u8`..`u32` widen to `usize`, `i8`..`i32` and\n");
    buf_bytes(out, b"  `u8`..`u32` to `isize`, and `usize`/`u64` (`isize`/`i64`) take `x as T`\n");
    buf_bytes(out, b"  or `T::try_from(x)` (a `Result`, `Err(TryFromIntError)` when the value\n");
    buf_bytes(out, b"  does not fit);\n");
    buf_bytes(out, b"- it never converts int to float, `bool` to int, signed to unsigned, or\n");
    buf_bytes(out, b"  to a narrower type: write `x as T`;\n");
    buf_bytes(out, b"- it applies to a value, never inside another type: `*i32`, `[i32]`,\n");
    buf_bytes(out, b"  `Vec<i32, Gpa>`, `fn(i32)` stay what they are.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Where two integer types meet without an expected type (the operands of\n");
    buf_bytes(out, b"`+` or `<`, the branches of `if` and `match`, two arguments for one\n");
    buf_bytes(out, b"type parameter), the result is the wider one, if one widens to the\n");
    buf_bytes(out, b"other: `a_i32 + b_i64` is an `i64`, `max(a_i32, b_i64)` is\n");
    buf_bytes(out, b"`max::<i64>`. An expected type flows into the arithmetic, as it does for\n");
    buf_bytes(out, b"literals: `let t: i64 = a_i32 * b_i32` multiplies in `i64`, so the\n");
    buf_bytes(out, b"product cannot overflow `i32` first (C's bug, avoided).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn total(xs: [i32]) -> i64 {\n");
    buf_bytes(out, b"    var t: i64 = 0;\n");
    buf_bytes(out, b"    for x in xs { t += x; }              // each i32 widens\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let a: i32 = 2000000000;\n");
    buf_bytes(out, b"    let b: i32 = 2000000000;\n");
    buf_bytes(out, b"    let wide: i64 = a + b;               // computed in i64\n");
    buf_bytes(out, b"    let c: u32 = 1200;\n");
    buf_bytes(out, b"    let xs = [1i32, 2, 3];\n");
    buf_bytes(out, b"    std::print_int(wide);\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(total(xs[..]) + c);   // u32 + i64: an i64\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"4000000000 1206\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## From and Into\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Traits may have type parameters (0.15): `trait From<T> { fn from(x: T)\n");
    buf_bytes(out, b"-> Self; }` is std's. A type can implement it for several `T`s, one\n");
    buf_bytes(out, b"impl per trait, arguments and type; `T::from(x)` picks the impl by the\n");
    buf_bytes(out, b"type of `x`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Celsius { deg: i64 }\n");
    buf_bytes(out, b"struct Fahrenheit { deg: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl From<Celsius> for Fahrenheit {\n");
    buf_bytes(out, b"    fn from(c: Celsius) -> Fahrenheit { Fahrenheit { deg: c.deg * 9 / 5 + 32 } }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let f = Fahrenheit::from(Celsius { deg: 100 });\n");
    buf_bytes(out, b"    let g: Fahrenheit = Celsius { deg: -40 }.into();   // Into: From backwards\n");
    buf_bytes(out, b"    let n = i64::from(7i32);                           // widening is a From too\n");
    buf_bytes(out, b"    std::print_int(f.deg);\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(g.deg);\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(n);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"212 -40 7\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Implement `From`, never `Into`: `x.into()` is `U::from(x)` with `U`\n");
    buf_bytes(out, b"  the type expected there (`let y: U = x.into();`); without one it is an\n");
    buf_bytes(out, b"  error. `t: Into<U>` holds when `U: From<t>`.\n");
    buf_bytes(out, b"- `From` is there without an impl for the identity and for every\n");
    buf_bytes(out, b"  widening (`i64::from(x_i32)` is a cast).\n");
    buf_bytes(out, b"- Bounds take arguments: `fn f<T: From<i64>>(n: i64) -> T { T::from(n) }`.\n");
    buf_bytes(out, b"- Restrictions of generic traits: no default bodies; the operator traits\n");
    buf_bytes(out, b"  (`Add`, ...) stay without parameters; an impl names concrete types or\n");
    buf_bytes(out, b"  its own parameters (`impl<T> From<T> for Wrap<T>`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The ? operator\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`e?` on an `Option<T>` gives the `T`, or returns `None` from the\n");
    buf_bytes(out, b"function. On a `Result<T, E>` it gives the `T`, or returns `Err`: the\n");
    buf_bytes(out, b"error as it is when `E` is the function's error type `F`, widened when\n");
    buf_bytes(out, b"`E` widens to `F`, else `F::from(err)` through an `impl From<E> for F`.\n");
    buf_bytes(out, b"Inside a closure it returns from the closure (give it `-> T`). The\n");
    buf_bytes(out, b"drops run, as for `return`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::ParseIntError;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"enum AppError { Parse(ParseIntError), Negative(i64) }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl From<ParseIntError> for AppError {\n");
    buf_bytes(out, b"    fn from(e: ParseIntError) -> AppError { AppError::Parse(e) }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn checked(s: [u8]) -> Result<i64, AppError> {\n");
    buf_bytes(out, b"    let n = parse_int(s)?;               // an Err returns Err(AppError::from(e))\n");
    buf_bytes(out, b"    if n < 0 { return Err(AppError::Negative(n)); }\n");
    buf_bytes(out, b"    Ok(n)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn half(x: Option<i64>) -> Option<i64> {\n");
    buf_bytes(out, b"    let v = x?;                          // None returns None\n");
    buf_bytes(out, b"    Some(v / 2)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    match checked(\"42\") { Ok(n) => std::print_int(n), Err(_) => print(\"error\") }\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    match checked(\"4x\") {\n");
    buf_bytes(out, b"        Err(AppError::Parse(ParseIntError::InvalidDigit(at))) => std::print_int(at),\n");
    buf_bytes(out, b"        _ => print(\"?\"),\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    match checked(\"-3\") { Err(AppError::Negative(n)) => std::print_int(n), _ => print(\"?\") }\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(half(Some(8)).unwrap_or(-1) + half(None).unwrap_or(-1));\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"42 1 -3 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`?` on an Option in a function returning a Result needs the error\n");
    buf_bytes(out, b"named: `x.ok_or(AppError::Missing)?`. std's `Option` has `ok_or`, `map`,\n");
    buf_bytes(out, b"`and_then`, `unwrap_or_else`; `Result` has `map`, `map_err`, `err`,\n");
    buf_bytes(out, b"`ok`, `unwrap_or_else`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## main returning a Result\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`fn main() -> Result<(), E>` with `E: Debug` (`#[derive(Debug)]`): on\n");
    buf_bytes(out, b"`Err(e)` it prints `Error: ` and `e`'s Debug text on stderr and exits\n");
    buf_bytes(out, b"with 1, as Rust does.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[derive(Debug)]\n");
    buf_bytes(out, b"enum ConfigError { Missing, Bad(i64) }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn port(raw: i64) -> Result<i64, ConfigError> {\n");
    buf_bytes(out, b"    if raw == 0 { return Err(ConfigError::Missing); }\n");
    buf_bytes(out, b"    if raw < 0 { return Err(ConfigError::Bad(raw)); }\n");
    buf_bytes(out, b"    Ok(raw)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> Result<(), ConfigError> {\n");
    buf_bytes(out, b"    let p = port(8080)?;\n");
    buf_bytes(out, b"    println(\"port {p}\");\n");
    buf_bytes(out, b"    let q = port(-1)?;\n");
    buf_bytes(out, b"    println(\"port {q}\");\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out (exit 1)\n");
    buf_bytes(out, b"port 8080\n");
    buf_bytes(out, b"Error: Bad(-1)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## std's errors and input\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Option means absence (the end of the input, a key not found); a Result\n");
    buf_bytes(out, b"with an error enum means failure. std's input (0.15):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| function | returns | at the end, on failure |\n");
    buf_bytes(out, b"|---|---|---|\n");
    buf_bytes(out, b"| `read_line(&buf)` | `Result<bool, IoError>` | `Ok(false)` at the end; `Err(IoError::Read)` |\n");
    buf_bytes(out, b"| `read_stdin_in(gpa)` | `Result<Vec<u8, Gpa>, IoError>` | `Err(IoError::Read)` |\n");
    buf_bytes(out, b"| `parse_int(s)` | `Result<i64, ParseIntError>` | `Empty`, `InvalidDigit(at)` (the byte's index), `Overflow` |\n");
    buf_bytes(out, b"| `sc.next_int()` | `Result<i64, ScanError>` | `ScanError::End`, `ScanError::Parse(e)` |\n");
    buf_bytes(out, b"| `sc.next_token()`, `sc.next_line()` | `Option<[u8]>` | `None` at the end |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`pub enum IoError { Read, Write }`, `pub enum ParseIntError { Empty,\n");
    buf_bytes(out, b"InvalidDigit(i64), Overflow }`, `pub enum ScanError { End,\n");
    buf_bytes(out, b"Parse(ParseIntError) }`; each has Display and Debug.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::ScanError;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let input = read_stdin_in(gpa).unwrap();\n");
    buf_bytes(out, b"    var sc = Scanner::new(input.as_slice());\n");
    buf_bytes(out, b"    var sum = 0;\n");
    buf_bytes(out, b"    loop {\n");
    buf_bytes(out, b"        match sc.next_int() {\n");
    buf_bytes(out, b"            Ok(n) => sum += n,\n");
    buf_bytes(out, b"            Err(ScanError::End) => break,\n");
    buf_bytes(out, b"            Err(ScanError::Parse(_)) => println(\"skipped a token\"),\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    std::print_int(sum);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```in\n");
    buf_bytes(out, b"1 2 x 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"skipped a token\n");
    buf_bytes(out, b"6\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Code written for 0.14's API (Option and bool results) is moved by\n");
    buf_bytes(out, b"`volec fix --only std015`: `parse_int(s)` becomes\n");
    buf_bytes(out, b"`parse_int(s).ok()`, `sc.next_int()` `sc.next_int().ok()`,\n");
    buf_bytes(out, b"`read_line(b)` `read_line(b).unwrap_or(false)`, `read_stdin()`\n");
    buf_bytes(out, b"`read_stdin().unwrap()`. All four mean what they meant, but a read\n");
    buf_bytes(out, b"error, which `read_stdin().unwrap()` now reports (exit 101). (Allocation\n");
    buf_bytes(out, b"is explicit since 0.16, and a capability since 0.26.3: `guide\n");
    buf_bytes(out, b"allocators`.)\n");
}
