// Generated by compiler/guide/embed.sh from compiler/guide/conversions.md (do
// not edit): the guide's topic 'conversions'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Conversions and errors\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Integer conversions, `From`/`Into`, the `?` operator, and std's\n");
    buf_bytes(out, b"convention for failure: Option means absent, Result means failed.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Integers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`x as T` converts between any number types (truncating, wrapping or\n");
    buf_bytes(out, b"saturating as Rust's `as` does); `i64::from(x)` widens losslessly\n");
    buf_bytes(out, b"(`From` holds for every widening: `i8 -> i16 -> i32 -> i64`, `u8 -> u16\n");
    buf_bytes(out, b"-> u32 -> u64`, unsigned to a strictly wider signed type).\n");
    buf_bytes(out, b"`u8::try_from(x)` and `x.try_into()` narrow with a check: a\n");
    buf_bytes(out, b"`Result<u8, TryFromIntError>` (`std::num`), `Err` when the value does\n");
    buf_bytes(out, b"not fit.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"vole also widens by itself, where rustc says E0308: an `i32` where an\n");
    buf_bytes(out, b"`i64` goes, and two integer operands of different widths join to the\n");
    buf_bytes(out, b"wider (`a_i32 + b_i64` is an `i64`). Code meant to build with rustc too\n");
    buf_bytes(out, b"writes the `from` or the `as`, as the block below does. An index is a\n");
    buf_bytes(out, b"`usize` and is not widened to (`v[i as usize]`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## From and Into\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`trait From<T> { fn from(x: T) -> Self; }` is std's (Rust's). A type can\n");
    buf_bytes(out, b"implement it for several `T`s, one impl per trait, arguments and type;\n");
    buf_bytes(out, b"`T::from(x)` picks the impl by the type of `x`. Implement `From`, never\n");
    buf_bytes(out, b"`Into`: `x.into()` is `U::from(x)` with `U` the type expected there\n");
    buf_bytes(out, b"(`let y: U = x.into();`). Bounds take arguments: `fn f<T: From<i64>>(n:\n");
    buf_bytes(out, b"i64) -> T { T::from(n) }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The ? operator\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`e?` on an `Option<T>` gives the `T`, or returns `None` from the\n");
    buf_bytes(out, b"function. On a `Result<T, E>` it gives the `T`, or returns\n");
    buf_bytes(out, b"`Err(F::from(err))`, `F` the function's error type (`From<E> for E`\n");
    buf_bytes(out, b"holds, so the same type passes). Inside a closure it returns from the\n");
    buf_bytes(out, b"closure. The drops run, as for `return`. `?` on an Option in a function\n");
    buf_bytes(out, b"returning a Result needs the error named: `x.ok_or(AppError::Missing)?`.\n");
    buf_bytes(out, b"Option and Result have Rust's methods (`map`, `and_then`, `ok_or`,\n");
    buf_bytes(out, b"`unwrap_or`, `unwrap_or_else`, `map_err`, `ok`, `err`, `is_some`...).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::num::ParseIntError;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total(xs: &[i32]) -> i64 {\n");
    buf_bytes(out, b"    let mut t: i64 = 0;\n");
    buf_bytes(out, b"    for x in xs { t += i64::from(*x); }  // each i32 widened by From\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[derive(Debug)]\n");
    buf_bytes(out, b"enum AppError { Parse(ParseIntError), Negative(i64) }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl From<ParseIntError> for AppError {\n");
    buf_bytes(out, b"    fn from(e: ParseIntError) -> AppError { AppError::Parse(e) }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn checked(s: &str) -> Result<i64, AppError> {\n");
    buf_bytes(out, b"    let n: i64 = s.parse()?;            // an Err returns Err(AppError::from(e))\n");
    buf_bytes(out, b"    if n < 0 { return Err(AppError::Negative(n)); }\n");
    buf_bytes(out, b"    Ok(n)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn half(x: Option<i64>) -> Option<i64> {\n");
    buf_bytes(out, b"    let v = x?;                          // None returns None\n");
    buf_bytes(out, b"    Some(v / 2)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> Result<(), AppError> {\n");
    buf_bytes(out, b"    let a: i32 = 2000000000;\n");
    buf_bytes(out, b"    let b: i32 = 2000000000;\n");
    buf_bytes(out, b"    let wide = a as i64 + b as i64;\n");
    buf_bytes(out, b"    let c: u32 = 1200;\n");
    buf_bytes(out, b"    let xs = [1i32, 2, 3];\n");
    buf_bytes(out, b"    println(\"{wide} {}\", total(&xs) + i64::from(c));\n");
    buf_bytes(out, b"    println(\"{:?} {:?} {:?} {}\", checked(\"42\"), checked(\"4x\"), checked(\"-3\"), half(Some(8)).unwrap_or(-1) + half(None).unwrap_or(-1));\n");
    buf_bytes(out, b"    match checked(\"4x\") { Err(AppError::Parse(e)) => println(\"{e}\"), _ => {} }\n");
    buf_bytes(out, b"    println(\"{:?} {:?}\", u8::try_from(300i64).is_err(), u8::try_from(checked(\"7\")?));\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"4000000000 1206\n");
    buf_bytes(out, b"Ok(42) Err(Parse(ParseIntError { kind: InvalidDigit })) Err(Negative(-3)) 3\n");
    buf_bytes(out, b"invalid digit found in string\n");
    buf_bytes(out, b"true Ok(7)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `s.parse::<T>()` (or `let n: T = s.parse()?`) gives a `Result<T,\n");
    buf_bytes(out, b"  T::Err>`: `ParseIntError` (its `kind()`: `IntErrorKind::Empty`,\n");
    buf_bytes(out, b"  `InvalidDigit`, `PosOverflow`, `NegOverflow`), `ParseFloatError`,\n");
    buf_bytes(out, b"  `ParseBoolError`.\n");
    buf_bytes(out, b"- `main` returns nothing, an `i32` (its exit code) or a `Result<(), E>`\n");
    buf_bytes(out, b"  with `E: Debug`: an `Err(e)` prints `Error: ` and `{e:?}` on stderr,\n");
    buf_bytes(out, b"  and the program exits with 1.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Reading input\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::io::stdin()` reads standard input: `read_line(&mut s)` appends a\n");
    buf_bytes(out, b"line to a String (`Ok(0)` at the end), `lines_in(gpa)` iterates over\n");
    buf_bytes(out, b"them, and `io::read_to_string_in(io::stdin(), gpa)` reads it all\n");
    buf_bytes(out, b"(`guide io`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::io;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let input = io::read_to_string_in(io::stdin(), gpa).unwrap();\n");
    buf_bytes(out, b"    let mut sum = 0i64;\n");
    buf_bytes(out, b"    for tok in input.split_whitespace() {\n");
    buf_bytes(out, b"        match tok.parse::<i64>() {\n");
    buf_bytes(out, b"            Ok(n) => sum += n,\n");
    buf_bytes(out, b"            Err(e) => println(\"skipped {tok:?}: {:?}\", e.kind()),\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let mut line = String::new_in(gpa);\n");
    buf_bytes(out, b"    let n = io::stdin().read_line(&mut line).unwrap();\n");
    buf_bytes(out, b"    println(\"{sum} {n}\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```in\n");
    buf_bytes(out, b"1 2 x 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"skipped \"x\": InvalidDigit\n");
    buf_bytes(out, b"6 0\n");
    buf_bytes(out, b"```\n");
}
