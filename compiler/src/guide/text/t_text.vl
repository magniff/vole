    buf_bytes(out, b"## str and String\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`str` is UTF-8 text, Rust's: `&str` borrows it (a string literal is a\n");
    buf_bytes(out, b"`&'static str`), and `String<A>` owns its text, on an allocator:\n");
    buf_bytes(out, b"`String::new_in(gpa)`, `String::from_in(\"x\", gpa)`, `s.push_str(\"..\")`,\n");
    buf_bytes(out, b"`s.push(c)` (a `char`), `format_in(\"..\", args, gpa)`, `x.to_string_in(gpa)`.\n");
    buf_bytes(out, b"`&s` of a String goes where a `&str` does (Deref), and a String has its\n");
    buf_bytes(out, b"`str`'s methods. The methods are Rust's, and what they return borrows\n");
    buf_bytes(out, b"the text: `len` (bytes), `chars()` (`.rev()`), `char_indices()`,\n");
    buf_bytes(out, b"`bytes()`, `lines()`, `split(p)`, `splitn(n, p)`, `split_once(p)`,\n");
    buf_bytes(out, b"`rsplit_once`, `split_whitespace()`, `trim()` (and `_start`, `_end`,\n");
    buf_bytes(out, b"`_matches`), `strip_prefix(p)`, `starts_with(p)`, `ends_with`,\n");
    buf_bytes(out, b"`contains`, `find(p)` (an `Option<usize>`, a byte index), `rfind`,\n");
    buf_bytes(out, b"`matches(p)`, `parse::<T>()` (numbers, `bool`), `width()` (terminal\n");
    buf_bytes(out, b"columns), `graphemes(true)`. A pattern `p` is a `&str`, a `char` or a\n");
    buf_bytes(out, b"closure `|c: char| ..`. What allocates takes an allocator, Rust's name\n");
    buf_bytes(out, b"with `_in`: `to_uppercase_in(gpa)`, `to_lowercase_in`,\n");
    buf_bytes(out, b"`to_ascii_uppercase_in`, `replace_in(a, b, gpa)`, `repeat_in(n, gpa)`,\n");
    buf_bytes(out, b"`to_string_in(gpa)`, `to_owned_in(gpa)`, `.collect_in(gpa)`; the Rust\n");
    buf_bytes(out, b"form is `alloc.no_in`, which names the `_in` one (`volec fix --only\n");
    buf_bytes(out, b"alloc` writes it). Bytes become text checked: `std::str::from_utf8(b)`\n");
    buf_bytes(out, b"(a `Result<&str, _>`), `String::from_utf8(v)` (a `Vec<u8, A>`),\n");
    buf_bytes(out, b"`String::from_utf8_lossy_in(b, gpa)`; back: `s.as_bytes()`,\n");
    buf_bytes(out, b"`s.into_bytes()`. A byte slice has `starts_with` and `ends_with` too:\n");
    buf_bytes(out, b"`b\"name.vl\".ends_with(b\".vl\")`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn initials(name: &str, gpa: Gpa) -> String<Gpa> {\n");
    buf_bytes(out, b"    let mut out = String::new_in(gpa);\n");
    buf_bytes(out, b"    for w in name.split_whitespace() {\n");
    buf_bytes(out, b"        out.push(w.chars().next().unwrap());\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    out\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let line = \"  ada lovelace, 1815 \";\n");
    buf_bytes(out, b"    let (name, year) = line.trim().split_once(\", \").unwrap();\n");
    buf_bytes(out, b"    let born = year.parse::<i64>().unwrap();\n");
    buf_bytes(out, b"    let up = name.to_uppercase_in(gpa);\n");
