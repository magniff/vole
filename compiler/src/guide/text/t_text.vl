    buf_bytes(out, b"    println(\"{up} {short} {} {}\", 2026 - born, name.contains('l'));\n");
    buf_bytes(out, b"    let parts: Vec<&str, Gpa> = \"a,b,,c\".split(',').collect_in(gpa);\n");
    buf_bytes(out, b"    println(\"{parts:?} {}\", parts.len());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"ADA LOVELACE al 211 true\n");
    buf_bytes(out, b"[\"a\", \"b\", \"\", \"c\"] 4\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## String constants\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| form | what it is |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `const X: &str = \"...\";` | text: each use is the literal |\n");
    buf_bytes(out, b"| `const X: &[u8] = b\"...\";` | bytes; `include_str(\"f.wgsl\")` is a file's text, a `&'static str` |\n");
    buf_bytes(out, b"| `static X: &str = \"...\";` | text in a place, one address for every use, as any static |\n");
    buf_bytes(out, b"| `static X: [&str; N] = [\"a\", \"b\"];` | an array of them (`const` too): `X[i]` is one, `&X[..]` the slice |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"What turns one form into another:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| you have | you want | write |\n");
    buf_bytes(out, b"|---|---|---|\n");
    buf_bytes(out, b"| a `&str` | `&[u8]` | `s.as_bytes()` |\n");
    buf_bytes(out, b"| `&[u8]` | `&str` | `std::str::from_utf8(b)?`: checked, a `Result` |\n");
    buf_bytes(out, b"| `Vec<T, A>` | `&[T]` | `&v`, `v.as_slice()`, a borrow, no copy; a `String`: `s.as_str()` |\n");
    buf_bytes(out, b"| a format string | its text | `format_in(\"..\", args, gpa)`, a `String<A>`; `x.to_string_in(gpa)` for one value |\n");
    buf_bytes(out, b"| a slice | appended | `v.extend_from_slice(s)` to a `Vec`; `push_str(s)` to a `String` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`print`, `println` and `eprintln` take a format literal and its\n");
    buf_bytes(out, b"arguments, any `T: Display`, with no allocator; `panic(\"bad {x}\")` and\n");
    buf_bytes(out, b"`assert(c, \"bad {}\", x)` format their message the same way.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"const SHADER: &str = \"@compute @workgroup_size(1)\\nfn main() {}\\n\";\n");
    buf_bytes(out, b"const NAME: &str = \"vole\";\n");
    buf_bytes(out, b"static DAYS: [&str; 3] = [\"mon\", \"tue\", \"wed\"];\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let bytes: &[u8] = NAME.as_bytes();\n");
    buf_bytes(out, b"    let text = std::str::from_utf8(SHADER.as_bytes()).unwrap(); // checked\n");
    buf_bytes(out, b"    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.extend_from_slice(NAME.as_bytes());\n");
    buf_bytes(out, b"    v.extend_from_slice(DAYS[1].as_bytes());\n");
    buf_bytes(out, b"    let msg = format_in(\"{NAME}: {} days, {} bytes\", DAYS.len(), v.len(), gpa); // a String\n");
    buf_bytes(out, b"    println(\"{}\", msg);\n");
    buf_bytes(out, b"    println(\"{} {} {}\", bytes.len(), text.lines().count(), DAYS[..].len());\n");
    buf_bytes(out, b"    let s = String::from_utf8(v).unwrap();\n");
    buf_bytes(out, b"    if s.len() != 7 {\n");
    buf_bytes(out, b"        panic(\"{}\", msg);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"vole: 3 days, 7 bytes\n");
    buf_bytes(out, b"4 2 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Numbers as text without an allocator\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`format_in(\"{v:.2}\", gpa)` allocates a `String`; a loop that writes a\n");
    buf_bytes(out, b"number every frame (a UI's label) writes it into a stack buffer instead,\n");
    buf_bytes(out, b"through `std::fmt::Write`, Rust's: a type with `write_str` takes\n");
    buf_bytes(out, b"`write(&mut w, \"..\", args)`, and the formatting itself allocates\n");
    buf_bytes(out, b"nothing. `{:.0}` rounds a tie to the even digit (`2.5` is `2`), as\n");
    buf_bytes(out, b"Rust's.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::fmt::{self, Write};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// A label's text in a stack buffer: no allocator.\n");
    buf_bytes(out, b"struct Label { buf: [u8; 32], len: usize }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Write for Label {\n");
    buf_bytes(out, b"    fn write_str(&mut self, s: &str) -> fmt::Result {\n");
    buf_bytes(out, b"        let b = s.as_bytes();\n");
    buf_bytes(out, b"        if self.len + b.len() > 32 { return Err(fmt::Error); }\n");
    buf_bytes(out, b"        self.buf[self.len..self.len + b.len()].copy_from_slice(b);\n");
    buf_bytes(out, b"        self.len += b.len();\n");
    buf_bytes(out, b"        Ok(())\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Label {\n");
    buf_bytes(out, b"    fn as_str(&self) -> &str { std::str::from_utf8(&self.buf[..self.len]).unwrap() }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let mut l = Label { buf: [0; 32], len: 0 };\n");
    buf_bytes(out, b"    write(&mut l, \"{:.2} {:.0} {}\", 3.14159, 2.5, -42).unwrap();\n");
    buf_bytes(out, b"    println(\"{}\", l.as_str());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3.14 2 -42\n");
    buf_bytes(out, b"```\n");
}
