use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# text\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## str and String\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`str` is UTF-8 text, a view (`&str` is `str`, as `&[T]` is `[T]`); a\n");
    buf_bytes(out, "string literal is one where a `str` goes, and a `str` goes where a `[u8]`\n");
    buf_bytes(out, "does, for free. `String` owns its text, on an allocator:\n");
    buf_bytes(out, "`String::new_in(gpa)`, `String::from_in(\"x\", gpa)`, `s.push_str(\"..\")`,\n");
    buf_bytes(out, "`s.push(c)` (a code point, a `u32`: vole has no `char` yet),\n");
    buf_bytes(out, "`s.push_fmt(f\"{x}\")`, `to_string_in(f\"..\", gpa)`. A String has its\n");
    buf_bytes(out, "`str`'s methods (`s.trim()`), and `&s` goes where a `str` or `[u8]` does.\n");
    buf_bytes(out, "The methods are Rust's, and what they return views the text: `len`,\n");
    buf_bytes(out, "`chars()` (code points; `.rev()`), `char_indices()`, `bytes()`,\n");
    buf_bytes(out, "`lines()`, `split(p)`, `splitn(n, p)`, `split_once(p)`, `rsplit_once`,\n");
    buf_bytes(out, "`split_whitespace()`, `trim()` (and `_start`, `_end`, `_matches`),\n");
    buf_bytes(out, "`strip_prefix(p)`, `starts_with(p)`, `ends_with`, `contains`, `find(p)`\n");
    buf_bytes(out, "(an `Option<i64>`, a byte index), `rfind`, `matches(p)`, `parse::<T>()`\n");
    buf_bytes(out, "(numbers, `bool`), `width()` (terminal columns), `graphemes(true)`. A\n");
    buf_bytes(out, "pattern `p` is a `str` (`\", \"`), a byte (`','`) or a code point (`0x4e16\n");
    buf_bytes(out, "as u32`). What allocates takes an allocator, Rust's name with `_in`:\n");
    buf_bytes(out, "`to_uppercase_in(gpa)`, `to_lowercase_in`, `replace_in(a, b, gpa)`,\n");
    buf_bytes(out, "`repeat_in(n, gpa)`, `to_string_in(gpa)`, `.collect_in(gpa)`; the Rust\n");
    buf_bytes(out, "forms are errors naming them. Bytes become a `str` checked:\n");
    buf_bytes(out, "`str::from_utf8(b)?`, `String::from_utf8(v)?` (a `Vec<u8>`),\n");
    buf_bytes(out, "`String::from_buf(b)?`, `String::from_utf8_lossy_in(b, gpa)`; back:\n");
    buf_bytes(out, "`s.as_bytes()`, `s.into_bytes()`, `s.into_buf()`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "fn initials(name: str, gpa: Gpa) -> String {\n");
    buf_bytes(out, "    var out = String::new_in(gpa);\n");
    buf_bytes(out, "    for w in name.split_whitespace() {\n");
    buf_bytes(out, "        out.push(w.chars().next().unwrap());\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    out\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let line: str = \"  ada lovelace, 1815 \";\n");
    buf_bytes(out, "    let (name, year) = line.trim().split_once(\", \").unwrap();\n");
    buf_bytes(out, "    let born = year.parse::<i64>().unwrap();\n");
    buf_bytes(out, "    let up = name.to_uppercase_in(gpa);\n");
    buf_bytes(out, "    let short = initials(name, gpa);\n");
    buf_bytes(out, "    println(f\"{up} {short} {2026 - born} {name.contains('l')}\");\n");
    buf_bytes(out, "    let parts: Vec<str> = \"a,b,,c\".split(',').collect_in(gpa);\n");
    buf_bytes(out, "    println(f\"{parts:?} {parts.len()}\");\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "ADA LOVELACE al 211 true\n");
    buf_bytes(out, "[\"a\", \"b\", \"\", \"c\"] 4\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## String constants\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "String constants come in three forms:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| form | what it is |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `const X: [u8] = \"...\";` | bytes; a text block (`\"\"\"`, `guide syntax#lexical`), `include_str(\"f.wgsl\")` and `include_bytes(\"f.bin\")` too |\n");
    buf_bytes(out, "| `static X: str = \"...\";` | text: a `str` is a static's (`const X: str` is an error whose fix is this) |\n");
    buf_bytes(out, "| `static X: [str; N] = [\"a\", \"b\"];` | an array of them (`const` too): `X[i]` is one, `X[..]` the slice; `[str]`, without the length, is refused |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "What turns one form into another:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| you have | you want | write |\n");
    buf_bytes(out, "|---|---|---|\n");
    buf_bytes(out, "| a `str` (a literal, a static) | `[u8]` | nothing: a `str` goes where a `[u8]` does; `s.as_bytes()` says so |\n");
    buf_bytes(out, "| `[u8]` | `str` | `str::from_utf8(b)?`: checked, a `Result` |\n");
    buf_bytes(out, "| `Vec<T>`, `Buf` | `[T]`, `[u8]` | `v.as_slice()`, a view, no copy; a `String`: `s.as_str()` |\n");
    buf_bytes(out, "| an f-string | its text | `format_in(f\"..\", gpa)`, a `Buf` (`.as_slice()` views it); `to_string_in(f\"..\", gpa)`, a `String` |\n");
    buf_bytes(out, "| a slice | appended | `v.extend_from_slice(s)` to a `Vec`; `push_str(s)` to a `Buf` or `String` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`print`, `println` and `eprintln` take any `T: Display`: an f-string,\n");
    buf_bytes(out, "a number, a `str`, a `[u8]`, with no allocator. `panic(msg)` and\n");
    buf_bytes(out, "`assert`'s message take a `[u8]` (a `str` too), not an f-string:\n");
    buf_bytes(out, "`panic(format_in(f\"bad {x}\", gpa).as_slice())`; with no `gpa` at hand,\n");
    buf_bytes(out, "`eprintln(f\"bad {x}\")` and `std::process::exit(1)`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "const SHADER: [u8] = \"\"\"\n");
    buf_bytes(out, "    @compute @workgroup_size(1)\n");
    buf_bytes(out, "    fn main() {}\n");
    buf_bytes(out, "    \"\"\";\n");
    buf_bytes(out, "static NAME: str = \"vole\";\n");
    buf_bytes(out, "static DAYS: [str; 3] = [\"mon\", \"tue\", \"wed\"];\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) {\n");
    buf_bytes(out, "    let bytes: [u8] = NAME; // a str goes where [u8] does\n");
    buf_bytes(out, "    let text: str = str::from_utf8(SHADER).unwrap(); // bytes to str: checked\n");
    buf_bytes(out, "    var v: Vec<u8> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    v.extend_from_slice(NAME.as_bytes());\n");
    buf_bytes(out, "    v.extend_from_slice(DAYS[1]);\n");
    buf_bytes(out, "    let msg = format_in(f\"{NAME}: {DAYS.len()} days, {v.len()} bytes\", gpa); // a Buf\n");
    buf_bytes(out, "    println(msg.as_slice());\n");
    buf_bytes(out, "    println(f\"{bytes.len} {text.lines().count()} {DAYS[..].len()}\");\n");
    buf_bytes(out, "    if v.len() != 7 {\n");
    buf_bytes(out, "        panic(msg.as_slice()); // [u8], not an f-string\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "vole: 3 days, 7 bytes\n");
    buf_bytes(out, "4 2 3\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Numbers as text without an allocator\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`format_in(f\"{v:.2}\", gpa)` allocates a `Buf`; a loop that writes a\n");
    buf_bytes(out, "number every frame (a UI's label) writes it into a stack array instead.\n");
    buf_bytes(out, "`std::num::fmt_f64(v, decimals, &out)` (0.25.4) writes `{v:.N}`'s text\n");
    buf_bytes(out, "byte for byte at the end of a `[u8; 32]` and returns where it starts:\n");
    buf_bytes(out, "the exact value rounded to the nearest, a tie to the even digit (`2.5`\n");
    buf_bytes(out, "to 0 decimals is `2`, as C's `%.0f` and Rust's `{:.0}`), `-0.00`,\n");
    buf_bytes(out, "`NaN`, `inf`; `decimals` from 0 to `FIXED_DECIMALS_MAX` (20); a text\n");
    buf_bytes(out, "longer than 32 bytes is `{v:e}`'s. An `f32` is `fmt_f64(x as f64, ..)`.\n");
    buf_bytes(out, "`fmt_i64(v, &out)` and `fmt_u64` do the same for integers into a\n");
    buf_bytes(out, "`[u8; 20]` (`guide formatting#numbers`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::num::{fmt_f64, fmt_i64};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() {\n");
    buf_bytes(out, "    var out: [u8; 32] = [0; 32];\n");
    buf_bytes(out, "    let at = fmt_f64(3.14159, 2, &out);\n");
    buf_bytes(out, "    println(out[at..32]);\n");
    buf_bytes(out, "    let at2 = fmt_f64(-0.5, 0, &out);\n");
    buf_bytes(out, "    println(out[at2..32]);\n");
    buf_bytes(out, "    var digits: [u8; 20] = [0; 20];\n");
    buf_bytes(out, "    let i = fmt_i64(-42, &digits);\n");
    buf_bytes(out, "    println(digits[i..20]);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "3.14\n");
    buf_bytes(out, "-0\n");
    buf_bytes(out, "-42\n");
    buf_bytes(out, "```\n");
}
