pub fn text(out: i64) {
    buf_bytes(out, b"# Rust -> vole\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"What a Rust programmer reaches for, and what vole has instead.\n");
    buf_bytes(out, b"Vole is not Rust: its values are passed by convention (`let`,\n");
    buf_bytes(out, b"`inout`, `sink`), not by reference. A Rust habit compiles to an error\n");
    buf_bytes(out, b"more often than to something else, and each error names the fix.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Text\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `&str`, `String` | the same (0.20): `str` is UTF-8 text, a view (`&str` is `str`; a literal is one where one goes, and a `str` goes where `[u8]` does); `String` owns it, on an allocator: `String::new_in(gpa)`, `String::from_in(\"x\", gpa)`; `&s` of a String goes where a `str` does, and it has `str`'s methods (`guide text`) |\n");
    buf_bytes(out, b"| `String::new()`, `push_str`, `format!` | `String::new_in(gpa)`, `push_str`, `push(c)` (a `u32` code point: no `char` yet), `push_fmt(\"..\", args)`; `to_string_in(format_args(\"..\", args), gpa)`; `Vec<u8, A>` for bytes, `format_in(\"..\", args, gpa)` (a `String<A>`, as `format!` makes) |\n");
    buf_bytes(out, b"| `&[u8]` | `[u8]`: bytes; `str::from_utf8(b)?` makes a `str` of them (checked); `\"abc\"` is a `[u8]` where no `str` goes |\n");
    buf_bytes(out, b"| `s.len()` | the same, an `i64` |\n");
    buf_bytes(out, b"| `s == \"x\"`, `s < t` | the same (std's `Eq` and `Ord` for `[u8]`, by bytes) |\n");
    buf_bytes(out, b"| `&s[1..3]` | `s[1..3]` (checked) |\n");
    buf_bytes(out, b"| `s.as_bytes()[0]`, `b'a'` | `s[0]`, `'a'` (a `u8`) |\n");
    buf_bytes(out, b"| `CString`, `.as_ptr()` | `c\"text\"` (a `*u8`); a slice is not NUL-terminated |\n");
    buf_bytes(out, b"| `match s { \"a\" => .. }` | `if s == \"a\" { .. } else if ...` |\n");
    buf_bytes(out, b"| `x.to_string()`, `s.parse::<i64>()` | `to_string_in(x, gpa)`, `s.to_string_in(gpa)`; `s.parse::<i64>()` on a `str` (0.20; `std::parse_int(b)` on bytes) |\n");
    buf_bytes(out, b"| `s.trim()`, `s.split(',')`, `s.split_whitespace()`, `s.lines()` | the same on a `str` (0.20): views of `s`, no allocation; `.collect_in(gpa)` for a Vec; on bytes `std::trim(b)`, `std::split_in(b, ',', gpa)` |\n");
    buf_bytes(out, b"| `s.to_uppercase()`, `s.replace(a, b)` | `s.to_uppercase_in(gpa)`, `s.replace_in(a, b, gpa)`: the Rust form is `alloc.explicit`, its `try:` the `_in` form |\n");
    buf_bytes(out, b"| `std::fs::read_to_string(p)?`, `File::open(p)?`, `BufReader::new(f)` | `fs::read_to_string_in(p, gpa)?`; `File::open(p)?` and `BufReader::new(f)` as Rust's (no allocation); `r.lines_in(gpa)`, `r.read_line(&mut s)?` (`guide io`) |\n");
    buf_bytes(out, b"| `std::env::args()`, `Command::new(p).arg(a).output()` | `env::args()` (views, `.collect_in(gpa)`); `let mut c = Command::new(p); c.arg(a); c.output_in(gpa)?` (`arg` changes `c`: no chaining) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    var b = String::new_in(gpa);               // freed at the end of main\n");
    buf_bytes(out, b"    b.push_str(\"sum=\");\n");
    buf_bytes(out, b"    let parts = split_in(\"40,2\", ',', gpa);\n");
    buf_bytes(out, b"    var sum = 0;\n");
    buf_bytes(out, b"    for p in parts.as_slice() {\n");
    buf_bytes(out, b"        sum += parse_int(p).unwrap_or(0);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    b.push_fmt(sum);\n");
    buf_bytes(out, b"    println(b.as_slice());\n");
    buf_bytes(out, b"    if parse_int(\"4x\").is_err() { println(\"not a number\"); }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"sum=42\n");
    buf_bytes(out, b"not a number\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Parameters, ownership, memory\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Vole has no references to store: a parameter's convention says what\n");
    buf_bytes(out, b"the function does with its argument, and the argument is used as the\n");
    buf_bytes(out, b"value itself.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `x: &T`, `f(&x)` | `x: T` (let, the default: read-only), `f(x)` |\n");
    buf_bytes(out, b"| `x: &mut T`, `f(&mut x)` | `x: inout T`, `f(&x)`: `&` marks only an inout argument |\n");
    buf_bytes(out, b"| `x: T` (the callee owns it) | `x: sink T`, `f(x)` (moves; a plain value is copied) |\n");
    buf_bytes(out, b"| `mut x: T` | `x: sink T` (a sink parameter is the callee's, so mutable) |\n");
    buf_bytes(out, b"| `&self`, `&mut self`, `self`, `mut self` | `self`, `inout self`, `sink self`; calls lend the receiver: `v.push(1)` |\n");
    buf_bytes(out, b"| `let mut x` | `var x` (also `var` in patterns: `Some(var n)`) |\n");
    buf_bytes(out, b"| `let r = &mut x;` | `inout r = &x;`, passed on as `f(&r)` |\n");
    buf_bytes(out, b"| `let r = &x; f(r)` | `f(x)`: a let argument needs no reference |\n");
    buf_bytes(out, b"| `*r = v`, `*n + 1`, `(*p).f` | `r = v`, `n + 1`, `p.f`: an access is used as its value (`*` is only for raw pointers) |\n");
    buf_bytes(out, b"| `&T` / `&mut T` fields | `let T` / `inout T` fields: `struct P { q: inout Query }`, built with `q: &q` |\n");
    buf_bytes(out, b"| `&str`, `&[T]`, `&mut [T]` | `str` (0.20), `[T]` (read-only), `inout [T]` (writable) |\n");
    buf_bytes(out, b"| `move \\|\\| ..` | `sink \\|\\| ..` |\n");
    buf_bytes(out, b"| `static mut` | `static var` |\n");
    buf_bytes(out, b"| `match &mut x { .. }` | `match &x { .. }`: binds inout accesses |\n");
    buf_bytes(out, b"| moves, `Clone`, `Copy` | the same idea: an owned value (`Vec`, `Buf`, `HashMap`, a struct holding one) moves; `.clone()` copies; plain values copy (no `Copy` derive) |\n");
    buf_bytes(out, b"| `Drop`, RAII | dropped at the end of the scope, last first; `impl Drop for T { fn drop(inout self) }`; `drop(x)` |\n");
    buf_bytes(out, b"| lifetimes `'a`, `fn f<'a>(x: &'a str) -> &'a str` | none: each function's view summary is inferred (`query views NAME`); `#[views(s)]` pins one (`guide memory#slices`) |\n");
    buf_bytes(out, b"| the borrow checker | the own pass: `own.moved`, `own.conflict`, `own.escape`... each with `try:` lines (`volec explain own.conflict`) |\n");
    buf_bytes(out, b"| `Box<T>`, `Rc<T>`, `Arc<T>` | none: a `Vec<T, A>`, an index, or `malloc` in `unsafe` |\n");
    buf_bytes(out, b"| `Vec::new()`, the global allocator | `Vec::new_in(gpa)`: allocation is explicit (0.16); `gpa: Gpa` comes from `fn main(gpa: Gpa)` and is passed down; `arena_scope(gpa, \\|a\\| ..)` (`guide allocators`) |\n");
    buf_bytes(out, b"| `Option<&T>` | `Option<T>` of a copy, an index, or a one-element view `[T]` |\n");
    buf_bytes(out, b"| `&mut v[i]`, `m.get_mut(&k)` | `&v[i]` to an inout parameter, `v[i].f = x`; `m.get_mut(k)`: an `Option<[V]>`, a view of one element (`a[0].f += 1`) |\n");
    buf_bytes(out, b"| `*m.entry(k).or_insert(0) += 1` | `m.get_or_insert(k, 0)[0] += 1` |\n");
    buf_bytes(out, b"| `std::mem::take(&mut x)`, `replace` | `std::take(&x)`, `std::replace(&x, v)` |\n");
    buf_bytes(out, b"| `Mutex`, threads | none in vole (C's threads are C's business) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Each Rust spelling above is the error `conv.rust`, whose `try:` line\n");
    buf_bytes(out, b"writes the vole form. Pass a container to a function that changes it as\n");
    buf_bytes(out, b"`&v` to an `inout` parameter, to one that reads it as `v`; return a new\n");
    buf_bytes(out, b"one by value (the caller owns it):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn fill(v: inout Vec<i64, Gpa>, n: i64) { // v.push changes the caller's Vec\n");
    buf_bytes(out, b"    for i in 0..n { v.push(i * i); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn sum(v: Vec<i64, Gpa>) -> i64 { // let: reads it in place\n");
    buf_bytes(out, b"    var s = 0;\n");
    buf_bytes(out, b"    for x in v { s += x; }\n");
    buf_bytes(out, b"    s\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    fill(&v, 4);\n");
    buf_bytes(out, b"    inout r = &v;                        // an inout access in a local: passed on twice\n");
    buf_bytes(out, b"    fill(&r, 1);\n");
    buf_bytes(out, b"    fill(&r, 1);\n");
    buf_bytes(out, b"    std::print_int(v.len() as i64 + sum(v));\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"20\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`*T` is Rust's `*mut T` / `*const T`: dereferencing it needs `unsafe`,\n");
    buf_bytes(out, b"a parameter too (0.18.1); `&x` passed where a `*T` is wanted gives its\n");
    buf_bytes(out, b"address.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Errors and Option\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `x?` | the same (0.15), on `Option` and `Result`; the error goes through `From` |\n");
    buf_bytes(out, b"| `panic!(\"msg\")`, `unreachable!()` | `panic(\"msg\")`, `unreachable()` (0.17; exit 101), or `return` an error |\n");
    buf_bytes(out, b"| `.map()`, `.and_then()`, `.ok_or()`, `.map_err()` | the same (0.15), and `unwrap_or_else` |\n");
    buf_bytes(out, b"| `.unwrap()`, `.unwrap_or(d)`, `.is_some()`, `.is_none()` | the same |\n");
    buf_bytes(out, b"| `.is_ok()`, `.is_err()`, `.ok()` | the same |\n");
    buf_bytes(out, b"| `assert!(c)`, `debug_assert!` | `if !c { panic(\"...\"); }` |\n");
    buf_bytes(out, b"| `std::process::exit(n)` | `return n;` from `main`, or C's `exit` in `unsafe` |\n");
    buf_bytes(out, b"| `fn main() -> Result<(), E>` | the same (0.15): `Err(e)` prints `Error: ` and `e`'s Debug, exit 1 |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Error { Empty, TooBig(i64) }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn check(n: i64) -> Result<i64, Error> {\n");
    buf_bytes(out, b"    if n == 0 { return Err(Error::Empty); }\n");
    buf_bytes(out, b"    if n > 100 { return Err(Error::TooBig(n)); }\n");
    buf_bytes(out, b"    Ok(n * 2)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn twice_checked(n: i64) -> Result<i64, Error> {\n");
    buf_bytes(out, b"    let v = check(n)?;                    // Err(e) returns Err(e)\n");
    buf_bytes(out, b"    Ok(v + 1)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    match twice_checked(500) {\n");
    buf_bytes(out, b"        Ok(v) => std::print_int(v),\n");
    buf_bytes(out, b"        Err(Error::TooBig(n)) => { print(\"too big: \"); std::print_int(n); }\n");
    buf_bytes(out, b"        Err(Error::Empty) => print(\"empty\"),\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    std::print_int(twice_checked(4).unwrap());\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"too big: 500\n");
    buf_bytes(out, b"9\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Iteration and closures\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `for x in v.iter()`, `for x in &v` | the same (0.14), and `for x in v`: a copy of each element |\n");
    buf_bytes(out, b"| `for (i, x) in s.iter().enumerate()` | the same (0.14) |\n");
    buf_bytes(out, b"| `for x in v.iter_mut() { *x += 1 }` | `for i in 0..v.len() { v[i] += 1; }` |\n");
    buf_bytes(out, b"| `.map()`, `.filter()`, `.sum()`, `.collect()` | the same (0.14); `collect_in(gpa)` makes a `Vec` only (`guide iterators`) |\n");
    buf_bytes(out, b"| `\\|x\\| x + 1`, `move \\|\\|` | `\\|x\\| x + 1`, `sink \\|\\|` (takes what it captures); a `var` is captured inout, the rest by let access or copy (`guide closures`) |\n");
    buf_bytes(out, b"| `impl Fn(i64) -> i64`, `Box<dyn Fn>` | a generic parameter `F: Fn(i64) -> i64`; as a result, `-> impl Fn(i64) -> i64` in the rust edition (0.27.2.1) |\n");
    buf_bytes(out, b"| `(0..n).rev()` | the same (0.18.1) |\n");
    buf_bytes(out, b"| `.step_by(2)` | `while` with `i += 2` |\n");
    buf_bytes(out, b"| `sort()`, `sort_by(\\|a, b\\| ...)` | `std::sort(s)` (`T: Ord`; not stable); `v.sort_by(\\|a, b\\| b.cmp(a))` (0.14; `a`, `b`: let `T`) |\n");
    buf_bytes(out, b"| `v.sort_by_key(\\|x\\| x.k)`, `v.retain(..)`, `v.contains(&x)`, `v.first()` | the same on a `Vec` (0.18.1; `sort_by_key` is stable); `contains(x)` takes x by value |\n");
    buf_bytes(out, b"| `BinaryHeap<T>`; a min-heap `BinaryHeap<Reverse<T>>` | `BinaryHeap<T>`; `MinHeap<T>`, no `Reverse` (0.18.1, `guide std#heaps-priority-queues`) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A function value is `fn(A) -> R`, a plain function, no environment.\n");
    buf_bytes(out, b"Its parameters have conventions (`fn(inout Sum, i64)`); a\n");
    buf_bytes(out, b"function with `*T` parameters is a value like any other (an `unsafe fn`\n");
    buf_bytes(out, b"as a value is unsafe):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Sum { total: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn add(s: inout Sum, x: i64) { s.total += x; }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn each(xs: [i64], f: fn(inout Sum, i64), s: inout Sum) {\n");
    buf_bytes(out, b"    for x in xs { f(&s, x); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn square(x: i64) -> i64 { x * x }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn map_sum(xs: [i64], f: fn(i64) -> i64) -> i64 {\n");
    buf_bytes(out, b"    var t = 0;\n");
    buf_bytes(out, b"    for x in xs { t += f(x); }\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var s = Sum { total: 0 };\n");
    buf_bytes(out, b"    let xs = [1, 2, 3];\n");
    buf_bytes(out, b"    each(xs[..], add, &s);\n");
    buf_bytes(out, b"    std::print_int(s.total + map_sum(xs[..], square));\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"20\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Types and numbers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `usize` for lengths and indices | the same (0.26.2: `v.len()`, `s.len()`, `s.len`); indexing takes any integer type |\n");
    buf_bytes(out, b"| implicit widening `i32` -> `i64` | the same (0.15), lossless only; `i64::from(x)`; narrowing is `x as i32` |\n");
    buf_bytes(out, b"| `i32::MAX`, `u8::MIN` | the same (0.15), for the integer types |\n");
    buf_bytes(out, b"| overflow: panic in debug, wrap in release | the same (0.26.3): checked at -O0, wrapping at -O1 and -O2, `--overflow-checks=on\\|off`; `wrapping_*`, `checked_*`, `overflowing_*`, `saturating_*`, `Wrapping<T>` (`.value` for `.0`) |\n");
    buf_bytes(out, b"| `x / 0` panics | the same (0.26.3), and `MIN / -1`, at every level |\n");
    buf_bytes(out, b"| `!x` (bitwise not) | `~x` |\n");
    buf_bytes(out, b"| `f.sqrt()`, `f.sin()`, `f.powi(n)`, `f64::consts::PI`, `f64::EPSILON` | the same (0.25.2.1, `guide math`), in vole: no C, no `unsafe` |\n");
    buf_bytes(out, b"| `x.pow(n)`, `x.abs()`, `a.min(b)`, `x.clamp(lo, hi)`, `x.signum()` on integers | the same (0.25.2.2, `guide math#integers`); they overflow as `*` does |\n");
    buf_bytes(out, "| `char`, a non-ASCII `char` literal | `u8`, ASCII literals only; `\"\\u{e9}\"` in strings is UTF-8 bytes |\n".as_bytes());
    buf_bytes(out, b"| `()` | `()` |\n");
    buf_bytes(out, b"| `!` (never) | `!`: `fn fail() -> ! { ... }` |\n");
    buf_bytes(out, b"| `#[derive(PartialEq, Eq)]` | `==` is structural for structs, enums, tuples, arrays; `Vec`, `Buf`, `HashMap` by contents (0.15); `#[derive(Eq)]` checks it |\n");
    buf_bytes(out, b"| `#[derive(Clone, Copy, Debug, Default, Hash)]` | `#[derive(Clone, Debug, Hash, Ord)]` (0.15); every value copies, no `Copy`, no `Default` |\n");
    buf_bytes(out, b"| `impl Display`, `{:?}` | `impl Display for T { fn fmt(self, f: inout Fmt) {..} }`, `{x:?}` (0.15, `guide formatting`) |\n");
    buf_bytes(out, b"| `impl From<A> for B`, `.into()` | the same (0.15, `guide conversions`) |\n");
    buf_bytes(out, b"| `type A = B;` | the same (`type Pair<T> = (T, T);` too) |\n");
    buf_bytes(out, b"| `const fn` | none; `const` items take constant expressions |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Syntax\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `fn f(&self)`, `&mut self`, `self` | `fn f(self)`, `fn f(inout self)`, `fn f(sink self)`; `Self` works (`self: *T` is the raw pointer, 0.18.1) |\n");
    buf_bytes(out, b"| `let mut x = 0;` | `var x = 0;` |\n");
    buf_bytes(out, b"| `'a: loop { break 'a; }` | `a: loop { break :a; }` |\n");
    buf_bytes(out, b"| `let x;` then assign | `let x = ...;` always |\n");
    buf_bytes(out, b"| `let Some(x) = o else { .. };` | the same (0.18.1); the block must leave (`return`, `break`, `continue`, `panic`) |\n");
    buf_bytes(out, b"| `P { x, y }` shorthand, `..base` | the shorthand (0.15); no `..base` |\n");
    buf_bytes(out, b"| `where T: Ord` | the same (0.26.2), on a parameter of the item; `where I::Item: Ord` comes with the rust edition |\n");
    buf_bytes(out, b"| `pub(crate)`, `pub(super)`, `pub(in path)` | the same (0.26.2), on items, fields, `use` and `mod`; nothing is private to the module and its children (fields too, 0.26) |\n");
    buf_bytes(out, b"| `fn` inside a `fn` | items only at module level |\n");
    buf_bytes(out, b"| `macro_rules!`, `println!`, `vec!` | none: `println(\"{}\", x)`, a format string (0.26.2) |\n");
    buf_bytes(out, b"| default arguments (none in Rust) | `fn f(a: i64, b: i64 = 2)`, `f(1, b: 3)` (0.15) |\n");
    buf_bytes(out, b"| `impl<T, A: Allocator> Trait for Vec<T, A>` | the same (one impl per trait and type) |\n");
    buf_bytes(out, b"| `impl Trait` in argument position | the same (0.26.2): `fn f(x: impl Display)`; `-> impl Trait` comes with the rust edition |\n");
    buf_bytes(out, b"| `dyn Trait` | generics: `fn f<T: Trait>(x: T)` |\n");
    buf_bytes(out, b"| `#[test]`, proptest, cargo-fuzz | `#[test]`, `#[property]`, `#[fuzz]`, run by `volec test` and `volec fuzz` (0.18; guide testing) |\n");
    buf_bytes(out, b"| `assert!`, `debug_assert!`, contracts crates | `assert(c)`, `assert_eq(a, b)`; `requires`/`ensures` clauses (0.18; guide contracts) |\n");
    buf_bytes(out, b"| `use a::b::*;` | `use a::b::{c, d};` |\n");
    buf_bytes(out, b"| `x as T` | the same; `bool as i64` works, an integer to an enum is checked |\n");
    buf_bytes(out, b"| `if let ... else if let ...`, `while let` | the same |\n");
    buf_bytes(out, b"| `match` guards, `a \\| b`, `1..=9` | the same; no `x @ pat`, no slice patterns, no string patterns |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Modules and crates\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `mod m;` | the same: `m.vl` or `m/mod.vl` next to the file |\n");
    buf_bytes(out, b"| `use crate::a::b;`, `super::`, `self::` | the same |\n");
    buf_bytes(out, b"| `extern crate`, Cargo dependencies | none: one program from its files; C through headers |\n");
    buf_bytes(out, b"| `pub use` | the same |\n");
    buf_bytes(out, b"| `std::collections::HashMap` | `std::HashMap` |\n");
    buf_bytes(out, b"| `std::io::stdin().read_line(&mut s)` | `std::read_line(&buf)`: the line without its `'\\n'`; `Ok(false)` at the end of input |\n");
    buf_bytes(out, b"| `io::read_to_string(io::stdin())` | `std::read_stdin_in(gpa)`, a `Result<Vec<u8, Gpa>, IoError>`; `std::Scanner` for its tokens, numbers and lines |\n");
    buf_bytes(out, b"| `std::env::args()` | `fn main(argc: i32, argv: **u8) -> i32` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## unsafe and C\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `unsafe { }`, `unsafe fn` | the same |\n");
    buf_bytes(out, b"| `extern \"C\" { fn f(); }` | the same; or `import \"stdio.h\" as c;` then `c::printf` |\n");
    buf_bytes(out, b"| `#[repr(C)]`, `#[repr(u8)]` | the same; also `packed`, `align(N)` |\n");
    buf_bytes(out, b"| `extern \"C\" fn cb()` | the same; a plain `fn` is not a C callback |\n");
    buf_bytes(out, b"| `std::ptr::null()` | `0 as *T` |\n");
    buf_bytes(out, b"| `p.add(i)`, `p.offset(i)` | `p[i]`, `&p[i]` (unsafe); no pointer arithmetic |\n");
    buf_bytes(out, b"| `std::mem::size_of::<T>()` | `size_of(T)`, `align_of(T)` |\n");
    buf_bytes(out, b"| `libc::malloc` | `extern \"C\" { fn malloc(n: u64) -> *u8; }` or `import \"stdlib.h\" as c;` |\n");
}
