// Generated by compiler/guide/embed.sh from compiler/guide/rust.md (do
// not edit): the guide's topic 'rust'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Rust and vole: where they differ\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Vole's surface is Rust's: its syntax, ownership and moves, `&T` and\n");
    buf_bytes(out, b"`&mut T` under a borrow checker (NLL, rustc's rules and codes:\n");
    buf_bytes(out, b"`guide memory`), lifetimes, traits and generics, closures, patterns,\n");
    buf_bytes(out, b"`?`, and std's names. A Rust program is not a vole program in the\n");
    buf_bytes(out, b"places below, and only there; each is an error that names the fix, not\n");
    buf_bytes(out, b"another meaning.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Allocation is a capability\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Nothing allocates without an allocator. It is a value passed to what\n");
    buf_bytes(out, b"allocates, and a parameter of the type that owns memory; there is no\n");
    buf_bytes(out, b"global allocator and no default `A`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `fn main()` | `fn main(gpa: Gpa)`: the program's allocator, passed down (`fn main()` when nothing allocates) |\n");
    buf_bytes(out, b"| `Vec<T>`, `String`, `HashMap<K, V>`, `Box<T>` | `Vec<T, Gpa>`, `String<Gpa>`, `HashMap<K, V, Gpa>`, `Box<T, Gpa>`; generic code writes `A: Allocator` (`use std::alloc::Allocator`). `Vec<T>` is `alloc.default` |\n");
    buf_bytes(out, b"| `Vec::new()`, `String::new()`, `Box::new(x)`, `Arc::new(x)` | `Vec::new_in(gpa)`, `String::new_in(gpa)`, `Box::new_in(x, gpa)`, `Arc::new_in(x, gpa)`: the allocator last. `Vec::new()` is `alloc.no_in` |\n");
    buf_bytes(out, b"| `x.to_string()`, `format!(\"{a}-{b}\")`, `iter.collect()` | `x.to_string_in(gpa)`, `format_in(\"{a}-{b}\", gpa)`, `iter.collect_in(gpa)`: what returns owned memory ends in `_in` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn squares(n: i64, gpa: Gpa) -> Vec<i64, Gpa> {\n");
    buf_bytes(out, b"    (1..=n).map(|i| i * i).collect_in(gpa)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let v = squares(4, gpa);\n");
    buf_bytes(out, b"    let s = format_in(\"{v:?} sum {}\", v.iter().sum::<i64>(), gpa);\n");
    buf_bytes(out, b"    println(\"{s}\");\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"[1, 4, 9, 16] sum 30\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Arenas and the other allocators: `guide allocators`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## No macros\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Rust's macros are functions of the prelude, called without `!`:\n");
    buf_bytes(out, b"`print`, `println`, `eprintln`, `format_in`, `write`, `writeln`,\n");
    buf_bytes(out, b"`panic`, `assert`, `assert_eq`, `unreachable`, `todo`. The format\n");
    buf_bytes(out, b"string is a literal (`println(x)` is an error: `println(\"{}\", x)`).\n");
    buf_bytes(out, b"`vec![1, 2]` is an array or pushes; `matches!(x, P)` is `if let P = x`\n");
    buf_bytes(out, b"or a `match`; there is no `macro_rules!`. Attributes and\n");
    buf_bytes(out, b"`#[derive(Clone, Copy, PartialEq, Debug, ..)]` are Rust's.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Effects and contracts\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Vole adds two things to a signature, both checked.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- **Effects**: what a function may do, inferred for every function\n");
    buf_bytes(out, b"  and checked where one is declared: `#[pure]`, `#[no_alloc]`,\n");
    buf_bytes(out, b"  `#[no_io]`, `#[no_panic]`, `#[effects(io, static, panic)]`\n");
    buf_bytes(out, b"  (all it may have: `println`'s three). The effects are `alloc(A)`,\n");
    buf_bytes(out, b"  `io`, `static`, `panic`, `diverge` and `unsafe`; a panic is only\n");
    buf_bytes(out, b"  `panic` (`diverge` is a loop or a recursion that may not end).\n");
    buf_bytes(out, b"  `volec query effects NAME --why io` shows the chain (`guide\n");
    buf_bytes(out, b"  effects`).\n");
    buf_bytes(out, b"- **Contracts**: `requires COND else \"code: message\"` and `ensures\n");
    buf_bytes(out, b"  COND` (with `result`) after the signature. A caller that breaks a\n");
    buf_bytes(out, b"  `requires` stops at its own line with the message, exit 101 (`guide\n");
    buf_bytes(out, b"  contracts`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn half(x: i64) -> i64\n");
    buf_bytes(out, b"    requires x % 2 == 0 else \"half.odd: {x} is odd\"\n");
    buf_bytes(out, b"    ensures result * 2 == x\n");
    buf_bytes(out, b"{\n");
    buf_bytes(out, b"    x / 2\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[pure]\n");
    buf_bytes(out, b"fn square(x: i64) -> i64 {\n");
    buf_bytes(out, b"    x * x\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    println(\"{} {}\", half(8), square(3));\n");
    buf_bytes(out, b"    println(\"{}\", half(7));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out (exit 101)\n");
    buf_bytes(out, b"4 9\n");
    buf_bytes(out, b"main.vl:15:19: half.odd: 7 is odd\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Named arguments\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An argument may be written with its parameter's name, after the\n");
    buf_bytes(out, b"positional ones and in the parameters' order: `window(800, 600, title:\n");
    buf_bytes(out, b"\"demo\")`. It is the same call; a wrong name or order is an error.\n");
    buf_bytes(out, b"There are no default arguments: every argument is written.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn scale(x: i64, by: i64, shift: i64) -> i64 {\n");
    buf_bytes(out, b"    x * by + shift\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    println(\"{}\", scale(5, by: 3, shift: 1));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"16\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Numbers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- **Lossless integer widening is implicit**: an integer goes where a\n");
    buf_bytes(out, b"  wider one of the same signedness is wanted, and an unsigned one\n");
    buf_bytes(out, b"  where a wider signed one is (`u8` to `u16`, `i32` to `i64`, `u8` to\n");
    buf_bytes(out, b"  `i64`, `u32` to `usize`). Everything else is written: `x as i32`\n");
    buf_bytes(out, b"  narrows, `usize` to `i64` and `i32` to `u64` need `as`, and `f32` to\n");
    buf_bytes(out, b"  `f64` does too. `i64::from(a)` is accepted as in Rust.\n");
    buf_bytes(out, b"  An index is not widened to: it is a `usize`, as in Rust (`v[i as\n");
    buf_bytes(out, b"  usize]` of an `i: u32`).\n");
    buf_bytes(out, b"- **Overflow** panics at `-O0` (`attempt to add with overflow`) and\n");
    buf_bytes(out, b"  wraps at `-O2`, as Rust's debug and release builds do; `wrapping_add`\n");
    buf_bytes(out, b"  and its family always wrap.\n");
    buf_bytes(out, b"- `~x` is an error (`syntax.tilde`): an integer's complement is `!x`;\n");
    buf_bytes(out, b"  `volec fix --suggested` writes it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let small: u8 = 200;\n");
    buf_bytes(out, b"    let wide: i64 = small; // widening: no `as`\n");
    buf_bytes(out, b"    let v = [10, 20, 30];\n");
    buf_bytes(out, b"    let i: i64 = 2;\n");
    buf_bytes(out, b"    println(\"{} {} {}\", wide + 1, v[i as usize], small.wrapping_add(100));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"201 30 44\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Pointers and slices\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `*const T` and `*mut T` are one type until 0.29: either goes where\n");
    buf_bytes(out, b"  the other is wanted, with no cast (`let q: *mut i64 = p;` of a\n");
    buf_bytes(out, b"  `*const i64`), and diagnostics print it `*T`. A write through a\n");
    buf_bytes(out, b"  pointer declared `*const T` is still refused.\n");
    buf_bytes(out, b"- A slice has the fields `ptr` and `len` beside Rust's `as_ptr()` and\n");
    buf_bytes(out, b"  `len()` (until 0.29).\n");
    buf_bytes(out, b"- Raw pointers are for `unsafe` code, as in Rust (`guide unsafe`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## C\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- A C header is imported, not bound by hand: `import \"stdio.h\" as c;`\n");
    buf_bytes(out, b"  then `unsafe { c::puts(c\"text\"); }` (`c\"..\"` is a NUL-terminated\n");
    buf_bytes(out, b"  `*const u8`). `extern \"C\" { fn f(..); }` blocks and `#[link(name =\n");
    buf_bytes(out, b"  \"m\")]`, `#[link(framework = \"AppKit\")]` are Rust's (`guide\n");
    buf_bytes(out, b"  c-interop`).\n");
    buf_bytes(out, b"- An `extern` function named `write` hides the prelude's `write`\n");
    buf_bytes(out, b"  (the formatting function, Rust's `write!`): declare C's under another\n");
    buf_bytes(out, b"  name, `#[link_name = \"write\"] fn c_write(fd: i32, buf: *const u8, n:\n");
    buf_bytes(out, b"  usize) -> isize;`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## std\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"std has Rust's modules, names and signatures with the allocator\n");
    buf_bytes(out, b"written. Where it differs in shape:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `std::path::Path<'a>` is a value that borrows its text, not an\n");
    buf_bytes(out, b"  unsized type: `Path::new(\"a/b.txt\")` is a `Path`, a function takes\n");
    buf_bytes(out, b"  `p: Path<'a>`, and `p.file_name()` is an `Option<&str>` (there is no\n");
    buf_bytes(out, b"  `OsStr`: paths and arguments are UTF-8 text).\n");
    buf_bytes(out, b"- What owns memory takes the allocator there too: `Command::new_in(p,\n");
    buf_bytes(out, b"  gpa)`, then Rust's chain, `.arg(a).output()`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"What Rust's std has and vole's does not yet: `std::rc` (`Rc`, `Weak`),\n");
    buf_bytes(out, b"`VecDeque`, a slice's `join` and `concat`, `From<&str>` for a String\n");
    buf_bytes(out, b"(`\"x\".into()` is `String::from_in(\"x\", gpa)`), `Stdin::lock` (`guide\n");
    buf_bytes(out, b"conversions#reading-input`),\n");
    buf_bytes(out, b"`dyn`-based APIs (`Box<dyn Error>`, `Box<dyn Fn>`), `std::num::Wrapping`,\n");
    buf_bytes(out, b"`u8::is_ascii_whitespace`, a precision taken from an argument (`{:.*}`,\n");
    buf_bytes(out, b"`{:.p$}`), `Vec::try_push`, async and `std::future`. Vole's std adds\n");
    buf_bytes(out, b"`std::gpu`, `std::window` and `std::objc` (`guide gpu`, `guide\n");
    buf_bytes(out, b"window`), the arenas of `std::alloc`, and `embed wgsl` blocks with\n");
    buf_bytes(out, b"`#[repr(wgsl)]` structs.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Not in the language\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `dyn Trait`, trait objects | none (`dyn` is reserved): generics, `impl Trait`, or an enum of the cases |\n");
    buf_bytes(out, b"| `macro_rules!`, procedural macros | none |\n");
    buf_bytes(out, b"| `async`, `await` | none: threads (`guide threads`) |\n");
    buf_bytes(out, b"| const generics (`struct B<const N: usize>`) | none: the constant is an ordinary argument or field |\n");
    buf_bytes(out, b"| `-> Option<impl Tr>`, a trait method's `-> impl Tr`, `let x: impl Tr` | 0.29 (`edition.later`); `-> impl Tr` at the top of a result works |\n");
    buf_bytes(out, b"| `matches!(x, P)` | `match x { P => true, _ => false }` |\n");
    buf_bytes(out, b"| `let mut v = Vec::new_in(gpa);` typed by a later `v.push(x)` | the type is written: `let mut v: Vec<T, Gpa> = Vec::new_in(gpa);` |\n");
    buf_bytes(out, b"| a closure parameter `\\|&&x\\|`; `std::cmp::Reverse(k)` by its path | `\\|x\\| **x > 0`; `use std::cmp::Reverse;` then `Reverse(k)` |\n");
    buf_bytes(out, b"| crates, `Cargo.toml` | a program is its root file and its `mod x;` files (`guide modules`); std is the only library |\n");
}
