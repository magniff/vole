use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Iterators\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`Iterator` is a prelude trait with one required function and an\n");
    buf_bytes(out, b"associated type:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"trait Iterator {\n");
    buf_bytes(out, b"    type Item;\n");
    buf_bytes(out, b"    fn next(inout self) -> Option<Self::Item>;\n");
    buf_bytes(out, b"    // and, written once in std: map filter enumerate zip take\n");
    buf_bytes(out, b"    // fold for_each count sum min max collect\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"std's sources and adapters are small structs whose methods are\n");
    buf_bytes(out, b"`#[inline]`: a chain of them compiles to the loop written by hand (the\n");
    buf_bytes(out, b"same machine code at -O2, vectorized where the loop would be).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    for i in 1..=6 { v.push(i); }\n");
    buf_bytes(out, b"    std::print_int(v.iter().filter(|x| x % 2 == 0).map(|x| x * x).sum());\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(v.iter().map(|x| x * 10).max().unwrap());\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int((0..100).filter(|n| n % 7 == 0).count() as i64);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    for (i, x) in v.iter().enumerate().take(2) {\n");
    buf_bytes(out, b"        std::print_int(i * 100 + x);\n");
    buf_bytes(out, b"        print(\" \");\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    std::print_int(v.iter().zip(v.iter()).fold(0, |acc, (a, b)| acc + a * b));\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    var w = v.iter().map(|x| 7 - x).collect_in(gpa);       // a Vec<i64>\n");
    buf_bytes(out, b"    w.sort_by(|a, b| a.cmp(b));                         // a, b: let i64\n");
    buf_bytes(out, b"    for x in w { std::print_int(x); }\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"56 60 15\n");
    buf_bytes(out, b"1 102 91\n");
    buf_bytes(out, b"123456\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Sources\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| source | items |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `v.iter()` (a `Vec<T, A>`), `s.iter()` (a slice `[T]`; an array variable too, `a.iter()`) | each element, a copy |\n");
    buf_bytes(out, b"| `m.iter()`, `m.keys()`, `m.values()` (a `HashMap<K, V, A>`) | `(K, V)`, `K`, `V`, in slot order |\n");
    buf_bytes(out, b"| `a..b`, `a..=b` as a value: `(0..n).map(...)` | the integers; `0..=255u8` ends without overflow |\n");
    buf_bytes(out, b"| a type with `impl Iterator` | what its `next` returns |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`for x in E` takes a range, a slice or an array as before, an iterator,\n");
    buf_bytes(out, b"or anything with an `iter` method (`for x in v`, `for (k, n) in m`);\n");
    buf_bytes(out, b"items are let: a copy of a plain element, a read-only access to an owned\n");
    buf_bytes(out, b"one. To change elements, loop over the indices: `for i in 0..v.len() {\n");
    buf_bytes(out, b"v[i] *= 2; }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Adapters and consumers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `map(f)`, `filter(f)` (`f` takes the item by value: `|x| x > 0`, not\n");
    buf_bytes(out, b"  `|&x|`), `enumerate()` (items `(i64, Item)`), `zip(other)` (items\n");
    buf_bytes(out, b"  `(A, B)`, as long as both have one), `take(n)`.\n");
    buf_bytes(out, b"- `fold(init, |acc, x| ...)`, `for_each(f)`, `count()`, `sum()` (from\n");
    buf_bytes(out, b"  `0 as Item`), `min()` and `max()` (an `Option`), `collect()` (a `Vec`\n");
    buf_bytes(out, b"  of the items, dropped with its scope; there is no other target, and no\n");
    buf_bytes(out, b"  `collect::<Vec<_>>()`).\n");
    buf_bytes(out, b"- `sort_by(&s, |a, b| ...)` sorts in place by a comparison of two let `T`s\n");
    buf_bytes(out, b"  returning negative, zero or positive (`a.cmp(b)`; `b.cmp(a)`\n");
    buf_bytes(out, b"  descending); also `v.sort_by(...)` and `s.sort_by(...)`.\n");
    buf_bytes(out, b"- An adapter and a consumer take the iterator `sink` (0.25): an adapter\n");
    buf_bytes(out, b"  owns the one it wraps, so a chain is one value, and what it did not\n");
    buf_bytes(out, b"  reach drops with it; `it.count()` uses `it` up. `any`, `all`,\n");
    buf_bytes(out, b"  `position` and `find` take it `inout`: they stop at the item that\n");
    buf_bytes(out, b"  decides, and the rest stay in `it`. To call `next` yourself (`inout\n");
    buf_bytes(out, b"  self`), keep the iterator in a `var`.\n");
    buf_bytes(out, b"- Owned items (a `Vec<D, A>`'s `pop`, `map(|i| make(i))`) are dropped once:\n");
    buf_bytes(out, b"  by `for` at the end of each iteration unless moved, and by an adapter\n");
    buf_bytes(out, b"  or consumer that passes over them (`count`, the ones `filter`\n");
    buf_bytes(out, b"  rejects, `min`'s and `max`'s losers). The items of a borrowing iterator\n");
    buf_bytes(out, b"  (`v.iter()`, a map's `iter`, `keys`, `values`, a set's `iter`) are\n");
    buf_bytes(out, b"  copies of elements the container keeps: read them, or `.clone()` one\n");
    buf_bytes(out, b"  to keep it (`own.move_out` otherwise).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Your own iterator\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Countdown { n: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Iterator for Countdown {\n");
    buf_bytes(out, b"    type Item = i64;\n");
    buf_bytes(out, b"    fn next(inout self) -> Option<i64> {\n");
    buf_bytes(out, b"        if self.n == 0 { return None; }\n");
    buf_bytes(out, b"        self.n -= 1;\n");
    buf_bytes(out, b"        Some(self.n + 1)\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn first<I: Iterator>(it: sink I) -> Option<I::Item> {\n");
    buf_bytes(out, b"    it.next()                           // a sink parameter is the callee's: mutable\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total<I: Iterator<Item = i64>>(it: sink I) -> i64 {\n");
    buf_bytes(out, b"    it.sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let c = Countdown { n: 3 };\n");
    buf_bytes(out, b"    for x in c { std::print_int(x); }\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(total(Countdown { n: 4 }));\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(first(Countdown { n: 9 }).unwrap());\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"321 10 9\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `type Item = T;` in the impl is required; `Self::Item` and `I::Item`\n");
    buf_bytes(out, b"  (for a type parameter `I: Iterator`) name it. `I: Iterator<Item = i64>`\n");
    buf_bytes(out, b"  constrains it.\n");
    buf_bytes(out, b"- The defaults (`map`, `sum`...) come with the trait; one used with an\n");
    buf_bytes(out, b"  `Item` it does not fit (`sum` of `[u8]` items) is an error only when\n");
    buf_bytes(out, b"  it is called.\n");
    buf_bytes(out, b"- `exact_len()` (items left, or -1) and `at(k)` are hooks that let `zip`\n");
    buf_bytes(out, b"  and `enumerate` run as a counted loop; leave them out.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Not there: `iter_mut` (use indices: `v[i] += 1`), `rev`, `step_by`,\n");
    buf_bytes(out, b"`chain`, `flat_map`, `peekable`, `collect` into other types, `dyn\n");
    buf_bytes(out, b"Iterator`, returning an iterator built from a closure (0.15).\n");
}
