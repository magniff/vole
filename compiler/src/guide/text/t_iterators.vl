pub fn text(out: i64) {
    buf_bytes(out, b"# Iterators\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`Iterator` is a prelude trait with one required method and an\n");
    buf_bytes(out, b"associated type, Rust's:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"trait Iterator {\n");
    buf_bytes(out, b"    type Item;\n");
    buf_bytes(out, b"    fn next(&mut self) -> Option<Self::Item>;\n");
    buf_bytes(out, b"    // and, written once in std: map filter enumerate zip take rev chain\n");
    buf_bytes(out, b"    // fold for_each count sum min max collect_in ...\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"std's sources and adapters are small structs whose methods are\n");
    buf_bytes(out, b"`#[inline]`: a chain of them compiles to the loop written by hand (the\n");
    buf_bytes(out, b"same machine code at -O2, vectorized where the loop would be).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    for i in 1..=6 { v.push(i); }\n");
    buf_bytes(out, b"    let evens: i64 = v.iter().filter(|x| *x % 2 == 0).map(|x| x * x).sum();\n");
    buf_bytes(out, b"    let top = v.iter().map(|x| x * 10).max().unwrap();\n");
    buf_bytes(out, b"    println(\"{} {} {}\", evens, top, (0..100).filter(|n| n % 7 == 0).count());\n");
    buf_bytes(out, b"    for (i, x) in v.iter().enumerate().take(2) {\n");
    buf_bytes(out, b"        print(\"{} \", i as i64 * 100 + x);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"{}\", v.iter().zip(v.iter()).fold(0i64, |acc, (a, b)| acc + a * b));\n");
    buf_bytes(out, b"    let mut w: Vec<i64, Gpa> = v.iter().map(|x| 7 - x).collect_in(gpa);\n");
    buf_bytes(out, b"    w.sort_by(|a, b| a.cmp(b));\n");
    buf_bytes(out, b"    for x in &w { print(\"{x}\"); }\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"56 60 15\n");
    buf_bytes(out, b"1 102 91\n");
    buf_bytes(out, b"123456\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Sources\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| source | items |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `v.iter()`, `s.iter()` (a Vec, a slice, an array variable) | `&T`, each element borrowed |\n");
    buf_bytes(out, b"| `v.iter_mut()` | `&mut T`: `for x in v.iter_mut() { *x *= 2; }` |\n");
    buf_bytes(out, b"| `v.into_iter()`, `for x in v` | `T`, the Vec's elements moved out |\n");
    buf_bytes(out, b"| `m.iter()`, `m.keys()`, `m.values()` (a `HashMap<K, V, A>`) | `(&K, &V)`, `&K`, `&V` |\n");
    buf_bytes(out, b"| `a..b`, `a..=b` as a value: `(0..n).map(...)` | the integers; `0..=255u8` ends without overflow |\n");
    buf_bytes(out, b"| a type with `impl Iterator` | what its `next` returns |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`for x in E` takes what Rust's does: a range, an iterator, `&v` (`&T`\n");
    buf_bytes(out, b"items), `&mut v` (`&mut T`), `v` by value. An array's or a Vec's methods\n");
    buf_bytes(out, b"want a place: `[1, 2].iter()` of a temporary array is an error, bind it\n");
    buf_bytes(out, b"to a variable first.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Adapters and consumers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Rust's: `map`, `filter` (its closure takes `&Item`: `|x| **x > 0` over\n");
    buf_bytes(out, b"  `v.iter()`, or `.copied()` first), `enumerate` (items `(usize,\n");
    buf_bytes(out, b"  Item)`), `zip`, `take`, `skip`, `rev`, `step_by`, `chain`, `flat_map`,\n");
    buf_bytes(out, b"  `peekable`, `copied`, `cloned`, and `fold`, `for_each`, `count` (a\n");
    buf_bytes(out, b"  usize), `sum`, `min`, `max` (an `Option`), `any`, `all`, `position`,\n");
    buf_bytes(out, b"  `find`.\n");
    buf_bytes(out, b"- `collect_in(gpa)` collects into the type written where the value\n");
    buf_bytes(out, b"  goes (`let w: Vec<i64, Gpa> = it.collect_in(gpa);`): a Vec, a String,\n");
    buf_bytes(out, b"  a HashMap; `collect_in::<Vec<i64, Gpa>, _>(gpa)` says it in the call.\n");
    buf_bytes(out, b"- `v.sort()`, `v.sort_by(|a, b| a.cmp(b))` (`b.cmp(a)`: descending),\n");
    buf_bytes(out, b"  `v.sort_by_key(..)`, the `_unstable` forms.\n");
    buf_bytes(out, b"- A literal an adapter's result is added to needs its type where nothing\n");
    buf_bytes(out, b"  else gives it: `fold(0i64, ..)`, `(0..10i64).step_by(3).sum()`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Your own iterator\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Countdown { n: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Iterator for Countdown {\n");
    buf_bytes(out, b"    type Item = i64;\n");
    buf_bytes(out, b"    fn next(&mut self) -> Option<i64> {\n");
    buf_bytes(out, b"        if self.n == 0 { return None; }\n");
    buf_bytes(out, b"        self.n -= 1;\n");
    buf_bytes(out, b"        Some(self.n + 1)\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn first<I: Iterator>(mut it: I) -> Option<I::Item> {\n");
    buf_bytes(out, b"    it.next()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total<I: Iterator<Item = i64>>(it: I) -> i64 {\n");
    buf_bytes(out, b"    it.sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let c = Countdown { n: 3 };\n");
    buf_bytes(out, b"    for x in c { print(\"{x}\"); }\n");
    buf_bytes(out, b"    println(\" {} {}\", total(Countdown { n: 4 }), first(Countdown { n: 9 }).unwrap());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"321 10 9\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `type Item = T;` in the impl is required; `Self::Item` and `I::Item`\n");
    buf_bytes(out, b"  (for a type parameter `I: Iterator`) name it. `I: Iterator<Item = i64>`\n");
    buf_bytes(out, b"  constrains it.\n");
    buf_bytes(out, b"- The provided methods (`map`, `sum`...) come with the trait.\n");
    buf_bytes(out, b"- A function may return one: `fn evens(n: i64) -> impl Iterator<Item =\n");
    buf_bytes(out, b"  i64> { (0..n).filter(|x| x % 2 == 0) }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Not there: `dyn Iterator` (`dyn` is reserved).\n");
}
