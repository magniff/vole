use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Errors and their fixes\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec check`, and a build whose output is not a terminal (an\n");
    buf_bytes(out, b"agent's shell, a pipe; `--diagnostics=short` anywhere): one line per\n");
    buf_bytes(out, b"error, `FILE:LINE:COL: error[KIND] MESSAGE | help: HELP | note: NOTE |\n");
    buf_bytes(out, b"try: TRY`, every error of every file at once (up to 50), sorted by\n");
    buf_bytes(out, b"position. A `try:` (0.17) is text to use as it is: code to paste where\n");
    buf_bytes(out, b"the error is (`a as i32`, `std::trim(s)`, the missing match arms), a\n");
    buf_bytes(out, b"`use` line, or a `volec` command to run (`volec fix --only unsafe\n");
    buf_bytes(out, b"main.vl`, `volec edit new-file util.vl main.vl`); VALUE in it\n");
    buf_bytes(out, b"is yours to fill in.\n");
    buf_bytes(out, b"An error whose fix the compiler knows exactly (0.18: a did-you-mean with\n");
    buf_bytes(out, b"one name that near, a conversion, a path from `crate::`, a Rust type or\n");
    buf_bytes(out, b"label respelled, a missing `use` or `pub`, a missing `gpa` argument)\n");
    buf_bytes(out, b"also has `try: volec fix --suggested main.vl`: one command makes\n");
    buf_bytes(out, b"all of them, as one checked edit (`--dry-run` shows the diff, `volec\n");
    buf_bytes(out, b"undo` takes it back, `--at FILE:LINE` fixes one line's), then prints the\n");
    buf_bytes(out, b"errors left. Run it instead of editing those lines by hand or with sed.\n");
    buf_bytes(out, b"KIND is `tokenizer error`, `parser error`, `module error`, `type error`\n");
    buf_bytes(out, b"or `unsafe`. Fix the first errors first: a parser error can hide\n");
    buf_bytes(out, b"type errors in the same function. `volec query show FILE:LINE` prints\n");
    buf_bytes(out, b"the item at an error's position. Below: what a newcomer writes, the\n");
    buf_bytes(out, b"error (short form, without the position), and the fix.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Rust habits\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let s: String<Gpa> = String::new();\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[alloc.no_in] 'String::new' allocates from nothing: pass the allocator, last, to 'String::new_in' | help: this function's `gpa` is the allocator to pass\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`String` and `str` are std's (0.20, `guide text`); what allocates\n");
    buf_bytes(out, b"takes an allocator: `String::new_in(gpa)`, `s.to_uppercase_in(gpa)`.\n");
    buf_bytes(out, b"A Rust type vole does not have gets the type to write as its `try:`:\n");
    buf_bytes(out, b"`char` (`u8`), `Box`, `Rc` (`*T`), `VecDeque`, `RefCell`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::cmp::max;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] no 'cmp' in module 'std' | help: vole's std has no module 'cmp': std's items are all `std::NAME` too | try: use std::max;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"std has a few of Rust's modules (0.20: `std::collections::HashMap`,\n");
    buf_bytes(out, b"`std::fmt::Display`, `std::io::read_line`, `std::iter`, `std::ops`,\n");
    buf_bytes(out, b"`std::slice`, `std::num`, `std::convert`, `std::clone`, `std::string`,\n");
    buf_bytes(out, b"`std::fs`, `std::path`, `std::env`, `std::process`), and every item is\n");
    buf_bytes(out, b"`std::NAME` as well: `use std::{IoError, is_digit};` (`HashMap`,\n");
    buf_bytes(out, b"`read_line` and std's most used names are in the prelude: no `use`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { let s = \"  a \"; let t = s.trim(); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] no method 'trim' on type '[u8]' | help: 'trim' is no method: std's function `trim` takes the value as its first argument | try: trim(s)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`s` is a `[u8]` here: bytes. A `str` has `trim`, `split`, `parse` (0.20):\n");
    buf_bytes(out, b"`let s: str = \"  a \";`, or `\"  a \".trim()` on the literal itself. A\n");
    buf_bytes(out, b"method std has as a function (`trim`, `sort`, `parse` as `parse_int`,\n");
    buf_bytes(out, b"`split_whitespace` as `split_whitespace_in(s, gpa)`) gets the call to\n");
    buf_bytes(out, b"write; another unknown method, the type's nearest methods and `volec\n");
    buf_bytes(out, b"query items TYPE`, which lists them all.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`fn count(s: str)` takes a `str` (0.20: Rust's `&str` is `str`, as\n");
    buf_bytes(out, b"`&[T]` is `[T]`), and a literal, a `str` or a String goes there. A\n");
    buf_bytes(out, b"parameter is read-only by default (let: `s: str`, `v: Vec<i64, Gpa>`,\n");
    buf_bytes(out, b"nothing to write); `x: inout T` may change the caller's value, called\n");
    buf_bytes(out, b"with `&x`; `x: sink T` takes it. `*T` is the raw pointer.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"impl P { fn get(&self) -> i64 { self.x } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] expected identifier, got '&' | help: `self` for `&self`, `inout self` for `&mut self`, `sink self` for `self` (0.19: `self: &Self`, `self: &mut Self`, `self: Self`)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`fn get(self) -> i64`; `fn bump(inout self)` to change it, `fn\n");
    buf_bytes(out, b"finish(sink self)` to take it (`self: *P` is the raw pointer).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { let mut x = 1; x += 1; x as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[conv.rust] 'let mut' is Rust's spelling; a mutable binding is 'var x'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`var x = 1;`. Each of Rust's spellings is `conv.rust` with the\n");
    buf_bytes(out, b"replacement in its `try:` (`fix --suggested` makes them all): `&T` and\n");
    buf_bytes(out, b"`&mut T` in a type (`x: T`, `x: inout T`), `&mut x` (`&x`), `*r` on an\n");
    buf_bytes(out, b"access (`r`), `move ||` (`sink ||`), `static mut` (`static var`), `mut\n");
    buf_bytes(out, b"x: T` (`x: sink T`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { var x = 1; let r = &mut x; 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[conv.rust] '&mut x' is Rust's spelling; an inout argument (the callee may change it) is marked '&x'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`&x` lends `x` inout, to an `inout` parameter or an `inout r = &x;`\n");
    buf_bytes(out, b"local; nothing else takes `&`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"println!(\"{}\", 1);\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] 'println!' is a macro call: vole has no macros | help: write `println(\"{}\", 1)`\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Since 0.26.2 the call without its `!` takes the same format string\n");
    buf_bytes(out, b"(`volec guide formatting`). The help names what replaces `vec!`,\n");
    buf_bytes(out, b"`format!`, `assert!` and the others.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"'outer: for i in 0..3 { break 'outer; }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[tokenizer error] unterminated character literal | help: a label has no quote: `outer: loop { break :outer; }` | try: outer: for i in 0..3 { break :outer; }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Labels have no quote: `outer: for i in 0..3 { break :outer; }` (the\n");
    buf_bytes(out, b"try: line is yours, respelled).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let o: Option<i64> = Some(1);\n");
    buf_bytes(out, b"let Some(x) = o;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] refutable pattern in 'let'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`let Some(x) = o else { return 1; };` (0.18.1, the else block must\n");
    buf_bytes(out, b"leave), or `let x = match o { Some(x) => x, None => 0 };`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let n = 5;\n");
    buf_bytes(out, b"let m = !n;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] expected 'bool', got 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Bitwise not is `~n`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let big = i64::MAX();\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] no associated function 'MAX' in 'i64' | help: a constant, without (): 'i64::MAX'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`i64::MAX`, `u8::MIN`, ... are constants (0.15); integer types have no\n");
    buf_bytes(out, b"other associated items. Floats have Rust's (0.25.2.1): `f64::EPSILON`,\n");
    buf_bytes(out, b"`f64::MAX`, `f64::NAN`, `f64::consts::PI` (`guide math`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let s = \"add\";\n");
    buf_bytes(out, b"match s { \"add\" => println(\"a\"), _ => println(\"b\") }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] expected a pattern, got 'string literal'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`if s == \"add\" { ... }`: patterns are integers, bytes, bools, variants,\n");
    buf_bytes(out, b"tuples.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[derive(PartialEq, Debug)]\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot derive 'PartialEq' (derivable: Eq, Ord, Hash, Debug, Clone)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`#[derive(Eq, Ord, Hash, Debug, Clone)]` (0.15): Eq is Rust's PartialEq\n");
    buf_bytes(out, b"and Eq, Ord its PartialOrd and Ord; there is no Copy (every type copies).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f<I>(it: I) -> i64 where I: Iterator, I::Item: Ord { 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[where.unsupported] 'I::Item: Ord': a 'where' bound is on a type parameter of the item, and 'I::Item' is not one\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`where` (0.26.2) bounds the item's parameters: `I: Iterator<Item = X>, X: Ord`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    fn helper() -> i64 { 3 }\n");
    buf_bytes(out, b"    helper() as i32\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"items cannot be nested in blocks\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Move `helper` to the module level.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let x = 1;\n");
    buf_bytes(out, b"x = 2;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot assign to immutable variable 'x' | help: make it mutable: `var x`\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`var x = 1;`: a `let` binding does not change.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let a: i64 = 1;\n");
    buf_bytes(out, b"let b: i32 = a;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] expected 'i32', got 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Only widening is implicit (0.15: `i32` to `i64`, `u8` to `u32`, ...):\n");
    buf_bytes(out, b"narrowing is `a as i32`. The same for `1 + 1.0`, `u32` to `i32`, and\n");
    buf_bytes(out, b"for `main` returning an `i64` (`n as i32`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let b: u8 = 300;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] integer literal 300 does not fit in type 'u8'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"An unsuffixed literal takes the type the code around it gives: `if ok {\n");
    buf_bytes(out, b"line[i] } else { 0 }` is a `u8`, from the other branch; so are match arms\n");
    buf_bytes(out, b"and array elements beside a `u8`, and (0.25.4) an array of literals\n");
    buf_bytes(out, b"beside an array (`if down { ACCENT } else { [0.2, 0.5, 0.7, 1.0] }` is\n");
    buf_bytes(out, b"a `[f32; 4]` when `ACCENT` is). Alone, a literal is `i64` (`f64`), and a\n");
    buf_bytes(out, b"`let` of literals keeps that type: `let base = [0.2, 0.5, 0.7, 1.0];`\n");
    buf_bytes(out, b"beside a `[f32; 4]` is an error whose note names the `let` and its\n");
    buf_bytes(out, b"annotation, `let base: [f32; 4] = ...`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"const ORIGIN: (i64, i64) = (0, 0);\n");
    buf_bytes(out, b"fn main() -> i32 { 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] constant 'ORIGIN' has type '(i64, i64)'; constants must be integers, floats, bool or string literals | help: a `static` holds other values: `static ORIGIN: (i64, i64) = ...;`\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`const GREETING: [u8] = \"hello\";` is a constant (0.14).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let x = 1;\n");
    buf_bytes(out, b"if x { }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] expected 'bool', got 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`if x != 0`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let a = 1;\n");
    buf_bytes(out, b"if 0 < a < 2 { }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] comparison operators cannot be chained; use parentheses\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`if 0 < a && a < 2`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f() -> i64 { 1; }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] function 'f' body has type '()', expected 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The value is the last expression without `;`: `fn f() -> i64 { 1 }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let x: i64;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] 'let' without an initializer is not supported\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64, y: i64 }\n");
    buf_bytes(out, b"fn make() -> P { P { x: 1 } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] missing field 'y' in struct 'P' constructor\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, b"fn g() -> i64 { f(1) }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] function 'f' expects 2 arguments, got 1\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum E { A, B, C }\n");
    buf_bytes(out, b"fn f(e: E) -> i64 { match e { E::A => 1, E::B => 2 } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] non-exhaustive match: 'E::C' is not covered | help: add an arm for it (try:), or a wildcard arm '_ =>' | try: E::C => VALUE,\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The `try:` lists every missing pattern as an arm to paste (integers as\n");
    buf_bytes(out, b"ranges: `201..=255 => VALUE,`). An unreachable arm's help gives the line\n");
    buf_bytes(out, b"of the arm above that already matches all it matches.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f() -> i64 { 1 }\n");
    buf_bytes(out, b"fn main() -> i32 { 0 }\n");
    buf_bytes(out, b"fn f() -> i64 { 2 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"duplicate function 'f'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The help says where the other one is, and the two `try:` lines delete\n");
    buf_bytes(out, b"either (`volec edit delete main.vl:3 main.vl`); to change an item\n");
    buf_bytes(out, b"in place, `volec edit replace f < new.vl` instead of adding a second.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum E { A(i64), B }\n");
    buf_bytes(out, b"fn f(e: E) -> i64 { match e { A(x) => x, B => 0 } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] unknown variant 'A'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`E::A(x)`, or `use E::{A, B};` once.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Ev { Key { code: i64, shift: bool }, Quit }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let e = Ev::Key(1, false);\n");
    buf_bytes(out, b"    match e { Ev::Key(c, _) => c as i32, Ev::Quit => 0 }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] variant 'Ev::Key' has named fields; give them by name | try: Ev::Key { code: 1, shift: false }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A struct-like variant (0.17) is built and matched by name, as in Rust:\n");
    buf_bytes(out, b"`Ev::Key { code: 1, shift: false }`, `Ev::Key { code, .. } => code`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Ev { Key { code: i64, shift: bool }, Quit }\n");
    buf_bytes(out, b"fn code(e: Ev) -> i64 {\n");
    buf_bytes(out, b"    match e { Ev::Key { code } => code, Ev::Quit => 0 }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] the pattern of 'Ev::Key' does not mention field 'shift' | help: match it too, or end the pattern with '..' to leave the rest out | try: Ev::Key { code, .. }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Ev { Key { code: i64, shift: bool }, Quit }\n");
    buf_bytes(out, b"fn code(e: Ev) -> i64 { e.code }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot access field 'code' on type 'Ev' | help: a variant's fields are read through a pattern (no '.field' on an enum) | try: if let Ev::Key { code, .. } = e { ... }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Slices, Vec, std\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"var m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"let a = m[0];\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot index type 'HashMap<i64, i64, Gpa>'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`m.get(0)` (an Option), `m.insert(0, x)`. A `Vec` and a `Buf` index as\n");
    buf_bytes(out, b"their slice (0.17): `v[0]`, `v[0] = x`, `v[1..3]` are\n");
    buf_bytes(out, b"`v.as_slice()[0]`, ..., checked.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let n = 3;\n");
    buf_bytes(out, b"for x in n { }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] 'for' iterates over ranges, slices, arrays, iterators and types with an 'iter' method, got 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`for x in 0..n`. A type of yours iterates with `impl Iterator for T`, or\n");
    buf_bytes(out, b"an `iter` method returning one (`volec guide iterators`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A misspelt method, field or item gets the nearest name of its kind:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { var b = Buf::new_in(gpa); b.push_string(\"x\"); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] no method 'push_string' on type 'Buf<Gpa>' | help: did you mean 'push_str'?\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An array, a Vec or a Buf goes where a slice of its elements does:\n");
    buf_bytes(out, b"`sum(a)` for `fn sum(s: [i64])` (0.20; `sum(&v)` for `s: inout [T]`).\n");
    buf_bytes(out, b"An array's length is `a.len()`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let e: IoError = IoError::Read;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] unknown type 'IoError'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`use std::IoError;` (the prelude's names need no import: `volec guide\n");
    buf_bytes(out, b"modules`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct K { a: i64 }\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { let m: HashMap<K, i64> = HashMap::new_in(gpa); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] the trait 'Hash' is not implemented for 'K' | help: required by the bound 'K: Hash' of 'HashMap'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`impl Hash for K { fn hash(self) -> u64 { std::hash_u64(self.a as u64) } }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Closures and iterators (0.14)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let f = |x| x + 1;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot infer the type of closure parameter 'x'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`|x: i64| x + 1`: in a `let`, nothing says what `x` is; as an argument\n");
    buf_bytes(out, b"for `F: Fn(i64) -> i64` or `fn(i64) -> i64` the type comes from there.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn run(f: fn(i64) -> i64) -> i64 { f(1) }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let k = 2;\n");
    buf_bytes(out, b"    run(|x| x + k) as i32\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"make the parameter generic\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A closure that captures is no plain `fn`: `fn run<F: Fn(i64) -> i64>(f:\n");
    buf_bytes(out, b"F) -> i64`. One that captures nothing converts.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn apply<F: Fn(i64) -> i64>(f: F) -> i64 { let x = 1; f(x) }\n");
    buf_bytes(out, b"fn main() -> i32 { apply(|a: *i64| 1); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] expected 'i64', got '*i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A `*T` is a raw pointer, not a way to pass: a closure parameter is let\n");
    buf_bytes(out, b"as any other, so annotate the type the bound gives (`|a: i64|`), or\n");
    buf_bytes(out, b"leave it untyped.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn apply<F: Fn(i64)>(f: F) { f(1); }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var total = 0;\n");
    buf_bytes(out, b"    apply(|x| { total += x; });\n");
    buf_bytes(out, b"    total as i32\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"FnMut\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`Fn` takes closures that assign no captured variable: bound `F:\n");
    buf_bytes(out, b"FnMut(i64)` (and take it `f: sink F`, which may be called).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn apply<F: Fn(i64) -> i64>(f: F) -> i64 { f(1) }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let f = {\n");
    buf_bytes(out, b"        var j = 1;\n");
    buf_bytes(out, b"        |x: i64| x + j\n");
    buf_bytes(out, b"    };\n");
    buf_bytes(out, b"    apply(f) as i32\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"which does not live outside this block\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The closure captures the `var j` inout, and `j` ends with the block:\n");
    buf_bytes(out, b"`sink |x: i64| x + j` takes a copy, or declare `j` before the block.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## ?, conversions, arguments, formatting, derive (0.15)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn first(v: Option<i64>) -> i64 { let x = v?; x }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"'?' needs 'first' to return Option or Result; it returns 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Return `Option<i64>` (or `Result<i64, E>`), or `match` on the value.\n");
    buf_bytes(out, b"`?` on an Option inside a function returning a Result needs the error:\n");
    buf_bytes(out, b"`v.ok_or(MyError::Missing)?`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::ParseIntError;\n");
    buf_bytes(out, b"enum AppError { Bad }\n");
    buf_bytes(out, b"fn read(s: [u8]) -> Result<i64, AppError> { let n = parse_int(s)?; Ok(n) }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"'?' cannot convert the error 'ParseIntError' into 'AppError'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The help is the impl to add: `impl From<ParseIntError> for\n");
    buf_bytes(out, b"AppError { fn from(e: ParseIntError) -> AppError { ... } }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct M { m: i64 }\n");
    buf_bytes(out, b"impl Into<M> for i64 { fn into(self) -> M { M { m: self } } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"From\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Implement `From<i64> for M`; `Into` comes with it. `x.into()` needs the\n");
    buf_bytes(out, b"type it converts to: `let y: M = x.into();`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, b"fn main() -> i32 { f(b: 1, 2) as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"a positional argument after a named one: the named arguments come last\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Named arguments follow the positional ones, in the parameters' order\n");
    buf_bytes(out, b"(`f(1, c: 3, b: 2)` is an error whose `try:` is `f(1, b: 2, c: 3)`); a\n");
    buf_bytes(out, b"missing one without a default gets `try: f(1, b: VALUE)`, a misspelt\n");
    buf_bytes(out, b"name the nearest.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"trait T { fn f(x: i64 = 1) -> i64; }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"a default value is for a parameter of a function or an inherent method, not of a trait function\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Defaults go on trailing parameters of `fn` items and inherent methods,\n");
    buf_bytes(out, b"not on trait or extern functions, closures or `fn` types.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64, y: i64 }\n");
    buf_bytes(out, b"fn main() -> i32 { let x = 1; let p = P { x, y }; p.x as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"undefined variable 'y'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The shorthand `P { x, y }` takes locals of the fields' names: write\n");
    buf_bytes(out, b"`y: VALUE`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[derive(Debg)]\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"did you mean 'Debug'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Derivable: `Eq`, `Ord`, `Hash`, `Debug`, `Clone` (Display is written by\n");
    buf_bytes(out, b"hand). Deriving a trait and implementing it too is a coherence error\n");
    buf_bytes(out, b"whose help is `remove Ord from #[derive]`; deriving `Eq` needs `==` on\n");
    buf_bytes(out, b"every field.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"fn main() -> i32 { let p = P { x: 1 }; println(\"{p}\"); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"'P' does not implement Display\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Implement it (`impl Display for P { fn fmt(self, f: inout std::Fmt) {\n");
    buf_bytes(out, b"f.write(\"P({})\", self.x); } }`), or print with `{p:?}` and\n");
    buf_bytes(out, b"`#[derive(Debug)]`. Rust's `fn fmt(&self, f: &mut Formatter) ->\n");
    buf_bytes(out, b"fmt::Result` is `fn fmt(self, f: inout Fmt)`, with nothing to return.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { let x = 1; println(f\"x = {x + 1}\"); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"f-strings are removed (0.26.3)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`volec fix --only fstring --keep-braces FILE` rewrites them: a name\n");
    buf_bytes(out, b"stays in its hole, an expression becomes `{}` and an argument,\n");
    buf_bytes(out, b"`println(\"x = {}\", x + 1)`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Generics and traits\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn biggest<T>(a: sink T, b: sink T) -> T { if a > b { a } else { b } }\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"fn main() -> i32 { let p = biggest(P { x: 1 }, P { x: 2 }); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] comparison requires numeric type, got 'P' | note: in instantiation of 'biggest<P>'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A generic body is checked per use; the note names the instance.\n");
    buf_bytes(out, b"Implement `Ord` for `P`, or bound `T: Ord` to say what it needs.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"trait A { fn a(self) -> i64; fn b(self) -> i64; }\n");
    buf_bytes(out, b"struct S { }\n");
    buf_bytes(out, b"impl A for S { fn a(self) -> i64 { 1 } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] the impl of trait 'A' is missing 'b' | help: it has no default: write it in the impl\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"trait A { fn a(self) -> i64; }\n");
    buf_bytes(out, b"fn f(x: &dyn A) -> i64 { 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] 'dyn' is a reserved keyword\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"No trait objects: `fn f<T: A>(x: T)`, or an enum of the cases.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct K { n: i64 }\n");
    buf_bytes(out, b"impl Ord for K { fn cmp(self: *K, o: *K) -> i64 { 0 } }\n");
    buf_bytes(out, b"fn main() -> i32 { 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] 'cmp' does not have the signature trait 'Ord' declares: expected 'fn(K, K) -> i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"An impl takes what the trait declares, as let parameters: `fn cmp(self,\n");
    buf_bytes(out, b"o: K) -> i64` (`*K` is a raw pointer).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Modules and imports\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::*;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[module error] wildcard imports are not allowed\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`use std::{Buf, HashMap};`; `volec fix --only imports` writes them.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"mod m { pub fn helper() -> i64 { 1 } }\n");
    buf_bytes(out, b"fn main() -> i32 { helper() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] undefined variable 'helper' | help: add `use crate::m::helper;`\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Add the `use` line the help names, or run the `try:` line, `volec fix\n");
    buf_bytes(out, b"--suggested main.vl`, which adds every missing one (and makes the\n");
    buf_bytes(out, b"other errors' exact fixes; `fix --only imports`: the imports alone).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"In a module other than the root, a path starts in that module, or with\n");
    buf_bytes(out, b"a sibling module, or one of the root (0.17): `use table::Table;` and\n");
    buf_bytes(out, b"`table::f(x)` in check.vl are `crate::table::...` when `mod table;` is\n");
    buf_bytes(out, b"in main.vl. A module elsewhere (`crate::a::table`) is `unknown module\n");
    buf_bytes(out, b"'table'`, whose help says `crate::a::table::...` and whose `try:` is the\n");
    buf_bytes(out, b"`use` line so written (in code: `use crate::a::table;`). `mod util;` with no util.vl is\n");
    buf_bytes(out, b"`cannot find the file of module 'util'`, whose `try:` makes it:\n");
    buf_bytes(out, b"`volec edit new-file util.vl main.vl < util.vl` (the text on\n");
    buf_bytes(out, b"stdin; the `mod` line that is there stays). A `mod` line for a file that\n");
    buf_bytes(out, b"is next to a submodule's file belongs in the root.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { let text = read_to_string(); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] undefined variable 'read_to_string' | help: std reads stdin: `read_stdin_in(gpa)` (all of it, a Vec<u8>)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"std's items outside the prelude get their `use` line (`add `use\n");
    buf_bytes(out, b"std::is_digit;``) or the nearest std name; an unknown function with neither points to `volec\n");
    buf_bytes(out, b"guide std`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { let total = 1; std::print_int(totl); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] undefined variable 'totl' | help: did you mean 'total'?\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A module and an item of the same name both work, as in Rust: after `mod\n");
    buf_bytes(out, b"eval; use eval::eval;`, `eval(x)` calls the function and `eval::NAME`\n");
    buf_bytes(out, b"goes through the module.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"mod m { fn hidden() -> i64 { 1 } }\n");
    buf_bytes(out, b"fn main() -> i32 { m::hidden() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[item.private] 'hidden' is private | help: make it public: `pub fn hidden` at\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The help gives the declaration with `pub` and where it is (`volec fix\n");
    buf_bytes(out, b"--only pub` writes them all). Child modules see their parent's private items, not\n");
    buf_bytes(out, b"the reverse. A struct's fields too (0.26):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"mod m {\n");
    buf_bytes(out, b"    pub struct P { pub x: i64, y: i64 }\n");
    buf_bytes(out, b"    pub fn p() -> P { P { x: 1, y: 2 } }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"fn main() -> i32 { m::p().y as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[field.private] field 'y' of 'P' is private to module 'm' | help: make it public: 'pub y: i64' at\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## unsafe\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"extern \"C\" { fn abs(x: i32) -> i32; }\n");
    buf_bytes(out, b"fn main() -> i32 { abs(-3) }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] calling a C function is unsafe\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`unsafe { abs(-3) }`. The error's `try:`, `volec fix --only unsafe\n");
    buf_bytes(out, b"main.vl`, wraps every such place; the check hook prints it once at the\n");
    buf_bytes(out, b"head of its report, with how many errors it answers.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn helper() -> i64 { let v: Vec<i64, Gpa> = Vec::new(); v.len() as i64 }\n");
    buf_bytes(out, b"fn main() -> i32 { helper() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"add the parameter `gpa: Gpa` to 'helper' and pass it down\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Allocation is explicit (0.16; `alloc.no_in` since 0.26.3): the help\n");
    buf_bytes(out, b"says where the allocator comes from here (this function's `gpa`, main's\n");
    buf_bytes(out, b"parameter, or one to add). `volec fix --only alloc` writes the call\n");
    buf_bytes(out, b"when one allocator is in scope; here there is none, and the parameter\n");
    buf_bytes(out, b"is yours to add (`volec refactor signature`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var p = P { x: 1 };\n");
    buf_bytes(out, b"    let q: *P = &p;\n");
    buf_bytes(out, b"    q.x = 9;\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] access to a field through a raw pointer is unsafe\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A local declared `*P` holds a raw pointer. Use `p.x = 9;`, an inout\n");
    buf_bytes(out, b"local (`inout q = &p; q.x = 9;`, safe), or pass `&p` to a function\n");
    buf_bytes(out, b"taking `p: inout P`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"fn one() -> i64 { 1 }\n");
    buf_bytes(out, b"fn get(n: i64, p: inout P) -> i64 { n + p.x }\n");
    buf_bytes(out, b"fn main() -> i32 { get(one(), &P { x: one() }) as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot take address of non-lvalue expression\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`&` lends a place (a variable, a field, an element) inout. A let\n");
    buf_bytes(out, b"parameter takes a value as it is (`get(one(), P { x: 1 })` for `p: P`);\n");
    buf_bytes(out, b"for an inout one, `&f(x)` or `&P { x: 1 }` makes a temporary (0.18.1),\n");
    buf_bytes(out, b"unless something evaluated before it in the statement (`one()` here, a\n");
    buf_bytes(out, b"call) could see the difference: then name it first: `var t = P { x:\n");
    buf_bytes(out, b"one() }; get(one(), &t)`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn factorial(n: i64) -> i64 { if n < 2 { 1 } else { n * factorial(n - 1) } }\n");
    buf_bytes(out, b"fn main() -> i32 { let f = &factorial; f(5) as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot take the address of 'factorial': a function's name is already a pointer to it\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A function's name is a `fn(i64) -> i64` value: `let f = factorial;`,\n");
    buf_bytes(out, b"then `f(5)`; `(*f)(5)` is `f(5)` too. `fix --suggested` drops the `&`\n");
    buf_bytes(out, b"(the `*`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn first(p: *i64) -> i64 { p[1] }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] indexing a raw pointer is unsafe\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A pointer is one value; for many, take a slice `[i64]`. A Vec, Buf or\n");
    buf_bytes(out, b"slice parameter (`v: Vec<i64, Gpa>`, `v: inout Vec<i64, Gpa>`) indexes its\n");
    buf_bytes(out, b"elements, checked and safe; through a `*T` it needs `unsafe`. To write\n");
    buf_bytes(out, b"one number for the caller, take `out: inout i64` and write `out = acc`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn read(x: *i64) -> i64 { *x }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] dereference of a raw pointer is unsafe: `x` is a `*T` parameter\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A `*T` parameter is a raw pointer (0.18.1), as in Rust. Take it let,\n");
    buf_bytes(out, b"`x: i64` (`x: inout i64` when written through, called with `&n`;\n");
    buf_bytes(out, b"`volec fix --values` changes such parameters with their calls), or vouch for it in\n");
    buf_bytes(out, b"`unsafe { *x }` (`fix --only unsafe`). The same for a field access, a\n");
    buf_bytes(out, b"method call and an index through it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"unsafe fn danger() -> i64 { 1 }\n");
    buf_bytes(out, b"fn main() -> i32 { let f = danger; 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] using an `unsafe fn` as a value is unsafe\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Call it in `unsafe`, or wrap it in a safe `fn`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { std::print_cstr(c\"x\"); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] calling an `unsafe fn` is unsafe\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`std::panic`, `print_cstr` and `Buf::push_cstr` take C strings and are\n");
    buf_bytes(out, b"`unsafe fn`; for literals use `print(\"x\")`, `panic(\"x\")` (the prelude's,\n");
    buf_bytes(out, b"safe).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Conventions, moves and views (0.17, 0.20)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A parameter is let (read-only, the default), `inout` (it may change\n");
    buf_bytes(out, b"the caller's value: the call marks it `&x`) or `sink` (it takes the\n");
    buf_bytes(out, b"value). The call must say what the parameter says:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"fn bump(p: inout P) { p.x += 1; }\n");
    buf_bytes(out, b"fn main() -> i32 { var q = P { x: 1 }; bump(q); q.x as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[conv.marker] 'q' is lent inout here (the callee may change it): mark it '&q'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`bump(&q)`: `&` shows at the call what may change. When the callee only\n");
    buf_bytes(out, b"reads, the help's `volec refactor signature bump --convention p let`\n");
    buf_bytes(out, b"makes it a let parameter, with every call.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn total(v: Vec<i64>) -> i64 { v.len() }\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { let v: Vec<i64> = Vec::new_in(gpa); total(&v) as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[conv.marker_extra] '&' marks an argument the callee may change; 'v' is taken let or sink here (read, or moved): pass 'v'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`total(v)`: a let parameter borrows `v` for the call, unmarked, and `v`\n");
    buf_bytes(out, b"stays the caller's.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn fill(v: Vec<i64, Gpa>) { v.push(1); }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[own.readonly] writes through 'v'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A let parameter is read-only: take it `v: inout Vec<i64, Gpa>` and call\n");
    buf_bytes(out, b"`fill(&v)` (the `try:`, `volec refactor signature fill --convention\n");
    buf_bytes(out, b"v inout`, changes both); a slice to sort in place is `s: inout [T]`,\n");
    buf_bytes(out, b"passed as `&v` or `&a[..]`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn bump(n: inout i64) { n += 1; }\n");
    buf_bytes(out, b"fn main() -> i32 { let n = 1; bump(&n); n as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[own.readonly] '&n' changes 'n', a let binding: it is read-only\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"An inout access needs a mutable place: `&n`, `inout r = &n`, `match\n");
    buf_bytes(out, b"&n` and an `inout self` method (`v.push(x)`, `v[i] = x`) on a let\n");
    buf_bytes(out, b"binding, a let parameter or receiver, or an immutable static are\n");
    buf_bytes(out, b"errors. The `try:` says which: `var n = ...`, `x: inout T`, `inout\n");
    buf_bytes(out, b"self`, `static var N`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn keep(v: sink Vec<i64, Gpa>) -> usize { v.len() }\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { let v: Vec<i64, Gpa> = Vec::new_in(gpa); keep(v); v.len() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[own.moved] 'v' is used here after it moved into 'keep(sink v)'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A `sink` parameter takes the value; the caller's `v` is dead after the\n");
    buf_bytes(out, b"call. When `keep` only reads, make it let (`v: Vec<i64, Gpa>`: nothing\n");
    buf_bytes(out, b"moves; `refactor signature keep --convention v let`); else pass\n");
    buf_bytes(out, b"`keep(v.clone())` or use `v` before. An owned value also moves with\n");
    buf_bytes(out, b"`let w = v;`, `return v` and into a struct literal.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The own pass's errors (`own.*`) are one line each, with both positions,\n");
    buf_bytes(out, b"a `help:` with the fix and `try:` lines; `volec explain own.CODE` has\n");
    buf_bytes(out, b"each in full, `volec query own FILE:LINE:COL` the state of every\n");
    buf_bytes(out, b"local there.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct T<A: Allocator> { keys: Vec<i64, A> }\n");
    buf_bytes(out, b"impl T<Gpa> { fn rehash(inout self) { var old = self.keys; old.push(1); } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[own.move_out] cannot move 'self.keys' (Vec<i64, Gpa>) out of a reference\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`var old = self.keys.take();` leaves an empty Vec on the same allocator\n");
    buf_bytes(out, b"(`std::take(&x)` for a `Default` value, `std::replace(&x, v)`); `let\n");
    buf_bytes(out, b"old = self.keys;` reads it where it is (a `let` of a part borrows it).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"error[own.conflict] 'v.push(4)' may move v's elements while 'first' (4:17) views them; 'first' is used at 6:16\n");
    buf_bytes(out, b"error[own.conflict] 'v.push' may move v's elements while the 'for' at 7:1 iterates over them\n");
    buf_bytes(out, b"error[own.conflict] 'a' is lent inout to '&a' and inout again to '&a' in the same call\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A view (a slice, a let or inout access, a `for` over `v`) is still used\n");
    buf_bytes(out, b"after `v` changes, or one value is lent inout twice at once. Use the\n");
    buf_bytes(out, b"view before the change, or take it again after; keep an index (`for i\n");
    buf_bytes(out, b"in 0..v.len() { let x = v[i]; ... }`); copy a plain value out first\n");
    buf_bytes(out, b"(`let x = v[0];`); `v.swap(i, j)` for two elements; `let n =\n");
    buf_bytes(out, b"rng.next();` before `rng.big(n)`. `guide views` has the rules.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"error[own.escape] 'greet' returns a view of 'b', which is dropped when 'greet' returns\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Return the `Buf` (`-> Buf`, `b`), not `b.as_slice()`; the caller takes\n");
    buf_bytes(out, b"the view.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"error[own.readonly] changes 'v' (Vec<i64>), a copy the match on 'e' (2:26) binds: the change would not reach it, and could free memory it points to\n");
    buf_bytes(out, b"error[own.readonly] changes 'w' (Vec<i64>), a copy of an element 'vv.get(0)' reads: ...\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"(0.18.1) `match e`, `v.get(i)` and a `for` loop's element give a copy\n");
    buf_bytes(out, b"of an owned value that stays where it is: read it, do not change it.\n");
    buf_bytes(out, b"Match through an inout access instead (`match &e` binds `v` inout, for\n");
    buf_bytes(out, b"`e: inout E` or a `var e`), or change the element in place\n");
    buf_bytes(out, b"(`vv[0].push(1)`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## At run time\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A failed check prints its message on stderr and exits with code 101:\n");
    buf_bytes(out, b"`index out of bounds: index I, length N`, `slice range out of bounds:\n");
    buf_bytes(out, b"...`, `called unwrap on None`, `called unwrap on Err`, `invalid value V\n");
    buf_bytes(out, b"for enum E`. A note follows (0.17). A program built with `--trace`\n");
    buf_bytes(out, b"prints, instead, the failing line and the calls that led to it\n");
    buf_bytes(out, b"(`volec test` builds so; `guide debug`). Arithmetic never fails (it\n");
    buf_bytes(out, b"wraps; `/ 0` is 0). Runaway recursion is stopped by the operating system\n");
    buf_bytes(out, b"(a signal, no message).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Level { Low, High }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let v: Option<i64> = None;\n");
    buf_bytes(out, b"    std::print_int(v.unwrap_or(5));\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    let e = 3 as Level;\n");
    buf_bytes(out, b"    std::print_int(e as i64);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out (exit 101)\n");
    buf_bytes(out, b"5\n");
    buf_bytes(out, b"main.vl:7:13: invalid value 3 for enum Level\n");
    buf_bytes(out, b"```\n");
}
