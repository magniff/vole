// Generated by compiler/guide/embed.sh from compiler/guide/errors.md (do
// not edit): the guide's topic 'errors'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Errors and their fixes\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec check`, and a build whose output is not a terminal (an\n");
    buf_bytes(out, b"agent's shell, a pipe; `--diagnostics=short` anywhere): one line per\n");
    buf_bytes(out, b"error, `FILE:LINE:COL: error[KIND] MESSAGE | help: HELP | note: NOTE |\n");
    buf_bytes(out, b"try: TRY`, every error of every file at once (up to 50), sorted by\n");
    buf_bytes(out, b"position. A `try:` (0.17) is text to use as it is: code to paste where\n");
    buf_bytes(out, b"the error is (`a as i32`, `&v`, the missing match arms), a\n");
    buf_bytes(out, b"`use` line, or a `volec` command to run (`volec fix --only unsafe\n");
    buf_bytes(out, b"main.vl`, `volec edit new-file util.vl main.vl`); VALUE in it\n");
    buf_bytes(out, b"is yours to fill in.\n");
    buf_bytes(out, b"An error whose fix the compiler knows exactly (0.18: a did-you-mean with\n");
    buf_bytes(out, b"one name that near, a conversion, a path from `crate::`, a missing\n");
    buf_bytes(out, b"`use` or `pub`, a missing `gpa` argument)\n");
    buf_bytes(out, b"also has `try: volec fix --suggested main.vl`: one command makes\n");
    buf_bytes(out, b"all of them, as one checked edit (`--dry-run` shows the diff, `volec\n");
    buf_bytes(out, b"undo` takes it back, `--at FILE:LINE` fixes one line's), then prints the\n");
    buf_bytes(out, b"errors left. Run it instead of editing those lines by hand or with sed.\n");
    buf_bytes(out, b"KIND is `tokenizer error`, `parser error`, `module error`, `type error`,\n");
    buf_bytes(out, b"`unsafe`, or a code (`alloc.no_in`, `borrowck.conflict`: `volec explain\n");
    buf_bytes(out, b"CODE`). Fix the first errors first: a parser error can hide\n");
    buf_bytes(out, b"type errors in the same function. `volec query show FILE:LINE` prints\n");
    buf_bytes(out, b"the item at an error's position. Below: what a newcomer writes, the\n");
    buf_bytes(out, b"error (short form, without the position), and the fix.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Where vole is not Rust\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let s: String<Gpa> = String::new();\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[alloc.no_in] 'String::new' allocates from nothing: pass the allocator, last, to 'String::new_in' | help: this function's `gpa` is the allocator to pass\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Nothing allocates without an allocator: `String::new_in(gpa)`,\n");
    buf_bytes(out, b"`s.to_uppercase_in(gpa)`, `x.to_string_in(gpa)`, `it.collect_in(gpa)`,\n");
    buf_bytes(out, b"with `gpa` from `fn main(gpa: Gpa)`, passed down (`guide allocators`).\n");
    buf_bytes(out, b"`volec fix --only alloc` writes the `_in` form where one allocator is in\n");
    buf_bytes(out, b"scope.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let v: Vec<i64> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[alloc.default] 'Vec' names no allocator: its 'A' is written\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The allocator is part of the type: `Vec<i64, Gpa>`, `String<Gpa>`,\n");
    buf_bytes(out, b"`HashMap<K, V, Gpa, FixedState>`, `Box<T, Gpa>`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let m: std::collections::HashMap<i64, i64, Gpa> = std::collections::HashMap::new_in(gpa);\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[hash.default] 'HashMap' names no hasher: its 'S' is written, last\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The hasher is part of the type too, after the allocator, and has no\n");
    buf_bytes(out, b"default: `HashMap<i64, i64, Gpa, FixedState>`, `HashSet<T, Gpa,\n");
    buf_bytes(out, b"FixedState>` (in the prelude, as `Gpa`; what `new_in` makes; in an item\n");
    buf_bytes(out, b"generic over `S: BuildHasher`, its `S`). `volec fix --suggested` writes\n");
    buf_bytes(out, b"it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Parser { toks: Vec<u8, Gpa> }\n");
    buf_bytes(out, b"fn main() -> i32 { 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[alloc.field] the struct 'Parser' holds an allocator its parameters do not name: 'Gpa', in field 'toks'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`struct Parser<A: Allocator> { toks: Vec<u8, A> }` (`use\n");
    buf_bytes(out, b"std::alloc::Allocator;`), used as `Parser<Gpa>`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn name(s: String<Gpa>) -> usize { s.len() }\n");
    buf_bytes(out, b"fn main() -> i32 { name(\"x\") as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] expected 'String<Gpa>', got '&str'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A String owns its text, on an allocator: `String::from_in(\"x\", gpa)`. A\n");
    buf_bytes(out, b"function that only reads text takes `s: &str`, which a literal and a\n");
    buf_bytes(out, b"String's `&s` both go to.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"println!(\"{}\", 1);\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] 'println!' is a macro call: vole has no macros | help: write `println(\"{}\", 1)`\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The call without its `!` takes the same format string (`volec guide\n");
    buf_bytes(out, b"formatting`). The help names what replaces `vec!`,\n");
    buf_bytes(out, b"`format!`, `assert!` and the others.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let o: Option<i64> = Some(1);\n");
    buf_bytes(out, b"let Some(x) = o;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] refutable pattern in 'let'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`let Some(x) = o else { return 1; };` (0.18.1, the else block must\n");
    buf_bytes(out, b"leave), or `let x = match o { Some(x) => x, None => 0 };`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let big = i64::MAX();\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] no associated function 'MAX' in 'i64' | help: a constant, without (): 'i64::MAX'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`i64::MAX`, `u8::MIN`, ... are constants, as `f64::EPSILON`, `f64::MAX`,\n");
    buf_bytes(out, b"`f64::NAN` and `std::f64::consts::PI` (`guide math`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let s = \"add\";\n");
    buf_bytes(out, b"match s { \"add\" => println(\"a\"), _ => println(\"b\") }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] expected a pattern, got 'string literal'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`if s == \"add\" { ... }`: a string literal is not a pattern yet (integers,\n");
    buf_bytes(out, b"chars, bools, variants, tuples are).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    fn helper() -> i64 { 3 }\n");
    buf_bytes(out, b"    helper() as i32\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"items cannot be nested in blocks\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Move `helper` to the module level.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let x = 1;\n");
    buf_bytes(out, b"x = 2;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot assign to immutable variable 'x' | help: make it mutable: `let mut x`\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`let mut x = 1;`: a `let` binding does not change.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let a: i64 = 1;\n");
    buf_bytes(out, b"let b: i32 = a;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] expected 'i32', got 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Only widening is implicit (`i32` to `i64`, `u8` to `u32`, ...; Rust\n");
    buf_bytes(out, b"writes those too, `i64::from(a)`): narrowing is `a as i32`. The same for `1 + 1.0`, `u32` to `i32`, and\n");
    buf_bytes(out, b"for `main` returning an `i64` (`n as i32`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let v = [1, 2, 3];\n");
    buf_bytes(out, b"let i: i64 = 1;\n");
    buf_bytes(out, b"println(\"{}\", v[i]);\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] an index is a 'usize', got 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"An index is a `usize`, as in Rust, and nothing widens to it: `v[i as\n");
    buf_bytes(out, b"usize]` (`volec fix --suggested` writes it), or declare `i: usize`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let b: u8 = 300;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] integer literal 300 does not fit in type 'u8'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"An unsuffixed literal takes the type the code around it gives: `if ok {\n");
    buf_bytes(out, b"line[i] } else { 0 }` is a `u8`, from the other branch; so are match arms\n");
    buf_bytes(out, b"and array elements beside a `u8`, and an array of literals beside an\n");
    buf_bytes(out, b"array (`if down { ACCENT } else { [0.2, 0.5, 0.7, 1.0] }` is a `[f32;\n");
    buf_bytes(out, b"4]` when `ACCENT` is). Alone, a literal is `i32` (`f64`), and a `let` of\n");
    buf_bytes(out, b"literals keeps that type: `let base = [0.2, 0.5, 0.7, 1.0];`\n");
    buf_bytes(out, b"beside a `[f32; 4]` is an error whose note names the `let` and its\n");
    buf_bytes(out, b"annotation, `let base: [f32; 4] = ...`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let x = 1;\n");
    buf_bytes(out, b"if x { }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] expected 'bool', got 'i32'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`if x != 0`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let a = 1;\n");
    buf_bytes(out, b"if 0 < a < 2 { }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] comparison operators cannot be chained; use parentheses\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`if 0 < a && a < 2`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f() -> i64 { 1; }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] function 'f' body has type '()', expected 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The value is the last expression without `;`: `fn f() -> i64 { 1 }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64, y: i64 }\n");
    buf_bytes(out, b"fn make() -> P { P { x: 1 } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] missing field 'y' in struct 'P' constructor\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, b"fn g() -> i64 { f(1) }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] function 'f' expects 2 arguments, got 1\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum E { A, B, C }\n");
    buf_bytes(out, b"fn f(e: E) -> i64 { match e { E::A => 1, E::B => 2 } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] non-exhaustive match: 'E::C' is not covered | help: add an arm for it (try:), or a wildcard arm '_ =>' | try: E::C => VALUE,\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The `try:` lists every missing pattern as an arm to paste (integers as\n");
    buf_bytes(out, b"ranges: `201..=255 => VALUE,`). An unreachable arm's help gives the line\n");
    buf_bytes(out, b"of the arm above that already matches all it matches.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f() -> i64 { 1 }\n");
    buf_bytes(out, b"fn main() -> i32 { 0 }\n");
    buf_bytes(out, b"fn f() -> i64 { 2 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"duplicate function 'f'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The help says where the other one is, and the two `try:` lines delete\n");
    buf_bytes(out, b"either (`volec edit delete main.vl:3 main.vl`); to change an item\n");
    buf_bytes(out, b"in place, `volec edit replace f < new.vl` instead of adding a second.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum E { A(i64), B }\n");
    buf_bytes(out, b"fn f(e: E) -> i64 { match e { A(x) => x, B => 0 } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] unknown variant 'A'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`E::A(x)`, or `use E::{A, B};` once.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Ev { Key { code: i64, shift: bool }, Quit }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let e = Ev::Key(1, false);\n");
    buf_bytes(out, b"    match e { Ev::Key(c, _) => c as i32, Ev::Quit => 0 }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] variant 'Ev::Key' has named fields; give them by name | try: Ev::Key { code: 1, shift: false }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A struct-like variant is built and matched by name, as in Rust:\n");
    buf_bytes(out, b"`Ev::Key { code: 1, shift: false }`, `Ev::Key { code, .. } => code`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Ev { Key { code: i64, shift: bool }, Quit }\n");
    buf_bytes(out, b"fn code(e: Ev) -> i64 {\n");
    buf_bytes(out, b"    match e { Ev::Key { code } => code, Ev::Quit => 0 }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] the pattern of 'Ev::Key' does not mention field 'shift' | help: match it too, or end the pattern with '..' to leave the rest out | try: Ev::Key { code, .. }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Ev { Key { code: i64, shift: bool }, Quit }\n");
    buf_bytes(out, b"fn code(e: Ev) -> i64 { e.code }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot access field 'code' on type 'Ev' | help: a variant's fields are read through a pattern (no '.field' on an enum) | try: if let Ev::Key { code, .. } = e { ... }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Slices, Vec, std\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let n = 3;\n");
    buf_bytes(out, b"for x in n { }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] no method 'into_iter' on type 'i32'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`for x in 0..n`. A `for` takes an `IntoIterator`: a range, `&v`,\n");
    buf_bytes(out, b"`v.iter()`, a `HashMap`; a type of yours with `impl Iterator for T`\n");
    buf_bytes(out, b"(`volec guide iterators`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A misspelt method, field or item gets the nearest name of its kind:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { let mut b = String::new_in(gpa); b.push_string(\"x\"); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] no method 'push_string' on type 'String<Gpa>' | help: did you mean 'push_str'?\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { let m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] unknown type 'HashMap' | help: add `use std::collections::HashMap;`\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`use std::collections::HashMap;` (the prelude's names need no import:\n");
    buf_bytes(out, b"`volec guide modules`); `volec fix --suggested` adds the line.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::collections::HashMap;\n");
    buf_bytes(out, b"struct K { a: i64 }\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut m: HashMap<K, i64, Gpa, FixedState> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"    m.insert(K { a: 1 }, 2);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] the trait 'Hash' is not implemented for 'K' | help: required by the bound 'K: Hash' of 'HashMap::insert'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`#[derive(PartialEq, Eq, Hash)] struct K { a: i64 }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let c: char = 65u8;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[distinct.mix] '65u8' is 'u8' where 'char' goes\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`65u8 as char`; a byte literal is `b'A'`, a `char` `'A'`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Closures and iterators\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let f = |x| x + 1;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot infer the type of closure parameter 'x'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`|x: i64| x + 1`: in a `let`, nothing says what `x` is; as an argument\n");
    buf_bytes(out, b"for `F: Fn(i64) -> i64` or `fn(i64) -> i64` the type comes from there.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn run(f: fn(i64) -> i64) -> i64 { f(1) }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let k = 2;\n");
    buf_bytes(out, b"    run(|x| x + k) as i32\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"make the parameter generic\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A closure that captures is no plain `fn`: `fn run<F: Fn(i64) -> i64>(f:\n");
    buf_bytes(out, b"F) -> i64`. One that captures nothing converts.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn apply<F: Fn(i64)>(f: F) { f(1); }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let mut total = 0;\n");
    buf_bytes(out, b"    apply(|x| { total += x; });\n");
    buf_bytes(out, b"    total as i32\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"FnMut\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`Fn` takes closures that assign no captured variable: bound `F:\n");
    buf_bytes(out, b"FnMut(i64)` (and take it `mut f: F`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn apply<F: Fn(i64) -> i64>(f: F) -> i64 { f(1) }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let f = {\n");
    buf_bytes(out, b"        let j = 1;\n");
    buf_bytes(out, b"        |x: i64| x + j\n");
    buf_bytes(out, b"    };\n");
    buf_bytes(out, b"    apply(f) as i32\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[borrowck.dropped_borrowed] 'j' does not live long enough\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The closure borrows `j`, and `j` ends with the block: `move |x: i64| x +\n");
    buf_bytes(out, b"j` takes a copy, or declare `j` before the block.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## ?, conversions, arguments, formatting, derive\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn first(v: Option<i64>) -> i64 { let x = v?; x }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"'?' needs 'first' to return Option or Result; it returns 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Return `Option<i64>` (or `Result<i64, E>`), or `match` on the value.\n");
    buf_bytes(out, b"`?` on an Option inside a function returning a Result needs the error:\n");
    buf_bytes(out, b"`v.ok_or(MyError::Missing)?`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum AppError { Bad }\n");
    buf_bytes(out, b"fn read(s: &str) -> Result<i64, AppError> { let n: i64 = s.parse()?; Ok(n) }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"'?' cannot convert the error 'ParseIntError' into 'AppError'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The help is the impl to add: `impl From<ParseIntError> for\n");
    buf_bytes(out, b"AppError { fn from(e: ParseIntError) -> AppError { ... } }`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct M { m: i64 }\n");
    buf_bytes(out, b"impl Into<M> for i64 { fn into(self) -> M { M { m: self } } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"conflicting impls of trait 'Into'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Implement `From<i64> for M`; `Into` comes with it (std's blanket impl). `x.into()` needs the\n");
    buf_bytes(out, b"type it converts to: `let y: M = x.into();`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f(a: i64, b: i64) -> i64 { a + b }\n");
    buf_bytes(out, b"fn main() -> i32 { f(b: 1, 2) as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"a positional argument after a named one: the named arguments come last\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Named arguments follow the positional ones, in the parameters' order\n");
    buf_bytes(out, b"(`f(1, c: 3, b: 2)` is an error whose `try:` is `f(1, b: 2, c: 3)`); a\n");
    buf_bytes(out, b"missing one gets `try: f(1, b: VALUE)`, a misspelt name the nearest.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn f(a: i64, b: i64 = 2) -> i64 { a + b }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"a parameter has no default value; pass it at each call\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"No parameter has a default value (`syntax.default-arg`; the `try:`\n");
    buf_bytes(out, b"removes it): every call passes every argument, by position or by name.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64, y: i64 }\n");
    buf_bytes(out, b"fn main() -> i32 { let x = 1; let p = P { x, y }; p.x as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"undefined variable 'y'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The shorthand `P { x, y }` takes locals of the fields' names: write\n");
    buf_bytes(out, b"`y: VALUE`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[derive(Debg)]\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"cannot derive 'Debg' (derivable: PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Clone, Copy, Default)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Display is written by hand. Deriving a trait and implementing it too is a coherence error\n");
    buf_bytes(out, b"whose help is `remove Ord from #[derive]`; deriving `PartialEq` needs\n");
    buf_bytes(out, b"`==` on every field.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"fn main() -> i32 { let p = P { x: 1 }; println(\"{p}\"); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"'P' does not implement Display\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Implement it (`impl fmt::Display for P { fn fmt(&self, f: &mut\n");
    buf_bytes(out, b"fmt::Formatter) -> fmt::Result { write(f, \"P({})\", self.x) } }`, with\n");
    buf_bytes(out, b"`use std::fmt;`), or print with `{p:?}` and `#[derive(Debug)]`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { let x = 1; println(f\"x = {x + 1}\"); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"f-strings are removed (0.26.3)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Write the format literal: a name\n");
    buf_bytes(out, b"stays in its hole, an expression becomes `{}` and an argument,\n");
    buf_bytes(out, b"`println(\"x = {}\", x + 1)`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Generics and traits\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn biggest<T>(a: T, b: T) -> T { if a > b { a } else { b } }\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"fn main() -> i32 { let p = biggest(P { x: 1 }, P { x: 2 }); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] comparison requires numeric type, got 'P' | note: in instantiation of 'biggest<P>'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A generic body is checked per use; the note names the instance.\n");
    buf_bytes(out, b"Derive or implement `PartialOrd` for `P`, and bound `T: PartialOrd` to\n");
    buf_bytes(out, b"say what it needs.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"trait A { fn a(self) -> i64; fn b(self) -> i64; }\n");
    buf_bytes(out, b"struct S { }\n");
    buf_bytes(out, b"impl A for S { fn a(self) -> i64 { 1 } }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] the impl of trait 'A' is missing 'b' | help: it has no default: write it in the impl\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"trait A { fn a(self) -> i64; }\n");
    buf_bytes(out, b"fn f(x: &dyn A) -> i64 { 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[parser error] 'dyn' is a reserved keyword\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"No trait objects: `fn f<T: A>(x: T)`, or an enum of the cases.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Modules and imports\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::*;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[module error] wildcard imports are not allowed\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`use std::collections::{HashMap, HashSet};`; `volec fix --only imports`\n");
    buf_bytes(out, b"writes them.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"mod m { pub fn helper() -> i64 { 1 } }\n");
    buf_bytes(out, b"fn main() -> i32 { helper() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] undefined variable 'helper' | help: add `use crate::m::helper;`\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Add the `use` line the help names, or run the `try:` line, `volec fix\n");
    buf_bytes(out, b"--suggested main.vl`, which adds every missing one (and makes the\n");
    buf_bytes(out, b"other errors' exact fixes; `fix --only imports`: the imports alone).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"In a module other than the root, a path starts in that module, or with\n");
    buf_bytes(out, b"a sibling module, or one of the root: `use table::Table;` and\n");
    buf_bytes(out, b"`table::f(x)` in check.vl are `crate::table::...` when `mod table;` is\n");
    buf_bytes(out, b"in main.vl. A module elsewhere (`crate::a::table`) is `unknown module\n");
    buf_bytes(out, b"'table'`, whose help says `crate::a::table::...` and whose `try:` is the\n");
    buf_bytes(out, b"`use` line so written (in code: `use crate::a::table;`). `mod util;` with no util.vl is\n");
    buf_bytes(out, b"`cannot find the file of module 'util'`, whose `try:` makes it:\n");
    buf_bytes(out, b"`volec edit new-file util.vl main.vl < util.vl` (the text on\n");
    buf_bytes(out, b"stdin; the `mod` line that is there stays). A `mod` line for a file that\n");
    buf_bytes(out, b"is next to a submodule's file belongs in the root.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { let total = 1; println(\"{}\", totl); 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] undefined variable 'totl' | help: did you mean 'total'?\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A module and an item of the same name both work, as in Rust: after `mod\n");
    buf_bytes(out, b"eval; use eval::eval;`, `eval(x)` calls the function and `eval::NAME`\n");
    buf_bytes(out, b"goes through the module.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"mod m { fn hidden() -> i64 { 1 } }\n");
    buf_bytes(out, b"fn main() -> i32 { m::hidden() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[item.private] 'hidden' is private | help: make it public: `pub fn hidden` at\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"The help gives the declaration with `pub` and where it is (`volec fix\n");
    buf_bytes(out, b"--only pub` writes them all). Child modules see their parent's private items, not\n");
    buf_bytes(out, b"the reverse. A struct's fields too:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"mod m {\n");
    buf_bytes(out, b"    pub struct P { pub x: i64, y: i64 }\n");
    buf_bytes(out, b"    pub fn p() -> P { P { x: 1, y: 2 } }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"fn main() -> i32 { m::p().y as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[field.private] field 'y' of 'P' is private to module 'm' | help: make it public: 'pub y: i64' at\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## unsafe\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"extern \"C\" { fn abs(x: i32) -> i32; }\n");
    buf_bytes(out, b"fn main() -> i32 { abs(-3) }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] calling a C function is unsafe\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`unsafe { abs(-3) }`. The error's `try:`, `volec fix --only unsafe\n");
    buf_bytes(out, b"main.vl`, wraps every such place; the check hook prints it once at the\n");
    buf_bytes(out, b"head of its report, with how many errors it answers.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn helper() -> i64 { let v: Vec<i64, Gpa> = Vec::new(); v.len() as i64 }\n");
    buf_bytes(out, b"fn main() -> i32 { helper() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"add the parameter `gpa: Gpa` to 'helper' and pass it down\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Allocation is explicit (`alloc.no_in`): the help\n");
    buf_bytes(out, b"says where the allocator comes from here (this function's `gpa`, main's\n");
    buf_bytes(out, b"parameter, or one to add). `volec fix --only alloc` writes the call\n");
    buf_bytes(out, b"when one allocator is in scope; here there is none, and the parameter\n");
    buf_bytes(out, b"is yours to add (`volec refactor signature`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let mut p = P { x: 1 };\n");
    buf_bytes(out, b"    let q: *mut P = &mut p;\n");
    buf_bytes(out, b"    q.x = 9;\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] access to a field through a raw pointer is unsafe\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`q` is a raw pointer. Use `p.x = 9;`, a reference (`let q = &mut p; q.x =\n");
    buf_bytes(out, b"9;`, safe), or pass `&mut p` to a function taking `p: &mut P`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn factorial(n: i64) -> i64 { if n < 2 { 1 } else { n * factorial(n - 1) } }\n");
    buf_bytes(out, b"fn main() -> i32 { let f = &factorial; f(5) as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot take the address of 'factorial': a function's name is already a pointer to it\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A function's name is a `fn(i64) -> i64` value: `let f = factorial;`,\n");
    buf_bytes(out, b"then `f(5)`. `fix --suggested` drops the `&`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn first(p: *const i64) -> i64 { p[1] }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] cannot index into a value of type '*i64' | help: a raw pointer is not indexed: offset it and read, `unsafe { *p.add(i) }`\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A pointer is one value; for many, take a slice `&[i64]`: a slice or a\n");
    buf_bytes(out, b"Vec indexes its elements, checked and safe.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn read(x: *const i64) -> i64 { *x }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] dereference of a raw pointer is unsafe\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Take a reference, `x: &i64` (`x: &mut i64` when written through, called\n");
    buf_bytes(out, b"with `&mut n`), or vouch for the pointer in `unsafe { *x }` (`fix --only\n");
    buf_bytes(out, b"unsafe`). The same for a field access and a method call through it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"unsafe fn danger() -> i64 { 1 }\n");
    buf_bytes(out, b"fn main() -> i32 { danger() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[unsafe] calling an `unsafe fn` is unsafe\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Call it in `unsafe { }`, under a `// SAFETY:` comment that says why its\n");
    buf_bytes(out, b"contract holds here.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Borrowing and moves\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The borrow checker's errors (`borrowck.*`) are Rust's, one line each,\n");
    buf_bytes(out, b"with both positions and a `help:` with the fix; the message names\n");
    buf_bytes(out, b"rustc's code where it has one, and `volec explain borrowck.CODE` has\n");
    buf_bytes(out, b"each in full (`guide memory#borrowing`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn bump(n: &mut i64) { *n += 1; }\n");
    buf_bytes(out, b"fn main() -> i32 { let mut q = 1i64; bump(q); q as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[type error] expected '&mut i64', got 'i64'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`bump(&mut q)`: the call shows what may change. Where a `&T` goes, a\n");
    buf_bytes(out, b"value is `edition.lenient: 'q' is a value where a reference goes`: pass\n");
    buf_bytes(out, b"`&q`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn keep(v: Vec<i64, Gpa>) -> usize { v.len() }\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { let v: Vec<i64, Gpa> = Vec::new_in(gpa); keep(v); v.len() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[borrowck.use_moved] 'v' is used here after it moved\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A parameter by value takes the argument; the caller's `v` is dead after\n");
    buf_bytes(out, b"the call (rustc E0382). When `keep` only reads, make it `v: &Vec<i64,\n");
    buf_bytes(out, b"Gpa>` and pass `&v`; else pass `keep(v.clone())` or use `v` before. An\n");
    buf_bytes(out, b"owned value also moves with `let w = v;`, `return v`, into a struct\n");
    buf_bytes(out, b"literal and into a `for x in v`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { let w: Vec<i64, Gpa> = Vec::new_in(gpa); w.push(1); w.len() as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[borrowck.borrow_immutable] cannot borrow 'w' as mutable, as it is not declared as mutable\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A `&mut self` method and `&mut w` change `w`, so it is a `let mut w`\n");
    buf_bytes(out, b"(E0596), as for an assignment; the same for a closure that changes what\n");
    buf_bytes(out, b"it captures and is called (`let mut bump = || n += 1;`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.push(1);\n");
    buf_bytes(out, b"    let first = &v[0];\n");
    buf_bytes(out, b"    v.push(4);\n");
    buf_bytes(out, b"    *first as i32\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[borrowck.conflict] cannot borrow 'v' as mutable because it is also borrowed as immutable\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`v.push(4)` may move the elements `first` points into (E0502). Use the\n");
    buf_bytes(out, b"borrow before the change, or take it again after; keep an index (`for i\n");
    buf_bytes(out, b"in 0..v.len() { let x = v[i]; ... }`); copy a `Copy` value out first\n");
    buf_bytes(out, b"(`let x = v[0];`). The same for a push inside `for x in &v`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn swap(a: &mut i64, b: &mut i64) { let t = *a; *a = *b; *b = t; }\n");
    buf_bytes(out, b"fn main() -> i32 { let mut a = 1; swap(&mut a, &mut a); a as i32 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[borrowck.mut_twice] cannot borrow 'a' as mutable more than once at a time\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A `&mut` is the only way to its place while it is used (E0499): two\n");
    buf_bytes(out, b"elements of one Vec swap with `v.swap(i, j)`, two halves borrow with\n");
    buf_bytes(out, b"`split_at_mut`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 { let mut n = 1; let r = &n; n = 2; *r }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[borrowck.assign_borrowed] cannot assign to 'n' because it is borrowed\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Assign after the borrow's last use (E0506).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::alloc::Allocator;\n");
    buf_bytes(out, b"struct T<A: Allocator> { keys: Vec<i64, A> }\n");
    buf_bytes(out, b"impl T<Gpa> { fn rehash(&mut self) { let mut old = self.keys; old.push(1); } }\n");
    buf_bytes(out, b"fn main() -> i32 { 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[borrowck.move_out] cannot move out of 'self.keys', which is reached through a reference or an index\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"A value behind a reference stays there (E0507): borrow it (`&self.keys`),\n");
    buf_bytes(out, b"clone it, or take it and leave another in its place\n");
    buf_bytes(out, b"(`std::mem::replace(&mut self.keys, Vec::new_in(gpa))`, `Option::take`).\n");
    buf_bytes(out, b"`let s = v[i];` of an element that is not `Copy` is the same error.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn greet<'a>(gpa: Gpa) -> &'a str { let b = String::from_in(\"hi\", gpa); b.as_str() }\n");
    buf_bytes(out, b"fn main() -> i32 { 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[borrowck.return_local] a reference to 'b', a local of this function, escapes it\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"Return the `String` (`-> String<Gpa>`, `b`), not a borrow of it (E0515);\n");
    buf_bytes(out, b"the caller borrows.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn longest(a: &str, b: &str) -> &str { if a.len() > b.len() { a } else { b } }\n");
    buf_bytes(out, b"fn main() -> i32 { 0 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[borrowck.elision] the result of 'longest' borrows, but from which parameter is not said\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"`fn longest<'a>(a: &'a str, b: &'a str) -> &'a str` (E0106): with one\n");
    buf_bytes(out, b"reference parameter, or `&self`, nothing is written.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## At run time\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A failed check prints its message on stderr and exits with code 101:\n");
    buf_bytes(out, b"`index out of bounds: index I, length N`, `slice range out of bounds:\n");
    buf_bytes(out, b"...`, `called unwrap on None`, `called unwrap on Err`, `invalid value V\n");
    buf_bytes(out, b"for enum E`, `attempt to divide by zero`. A program built with `--trace`\n");
    buf_bytes(out, b"prints, instead, the failing line and the calls that led to it\n");
    buf_bytes(out, b"(`volec test` builds so; `guide debug`). Integer overflow panics at -O0\n");
    buf_bytes(out, b"and wraps at -O1 and above. Runaway recursion is stopped by the operating system\n");
    buf_bytes(out, b"(a signal, no message).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"enum Level { Low, High }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let v: Option<i64> = None;\n");
    buf_bytes(out, b"    println(\"{}\", v.unwrap_or(5));\n");
    buf_bytes(out, b"    let e = 3 as Level;\n");
    buf_bytes(out, b"    println(\"{}\", e as i64);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out (exit 101)\n");
    buf_bytes(out, b"5\n");
    buf_bytes(out, b"main.vl:6:13: invalid value 3 for enum Level\n");
    buf_bytes(out, b"```\n");
}
