// Generated by compiler/guide/embed.sh from compiler/guide/allocators.md (do
// not edit): the guide's topic 'allocators'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Allocators\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Allocation is explicit: nothing allocates without being given an\n");
    buf_bytes(out, b"allocator. A program's general-purpose allocator is the `gpa: Gpa` its\n");
    buf_bytes(out, b"`main` takes; a function that allocates takes one as a parameter, or\n");
    buf_bytes(out, b"works on a container it was given (a `Vec` holds its allocator: `push`,\n");
    buf_bytes(out, b"`clone` and its drop use it). There is no global allocator to reach for,\n");
    buf_bytes(out, b"so a function's signature says whether it allocates. This is where vole\n");
    buf_bytes(out, b"is not Rust: Rust's `Vec::new()` allocates from a global one.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Gpa, from main\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn squares(n: i64, gpa: Gpa) -> Vec<i64, Gpa> { // allocates: takes the allocator\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::with_capacity_in(n as usize, gpa);\n");
    buf_bytes(out, b"    for i in 0..n { v.push(i * i); }\n");
    buf_bytes(out, b"    v\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total(v: &Vec<i64, Gpa>) -> i64 { // grows nothing: no allocator\n");
    buf_bytes(out, b"    v.iter().sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut v = squares(4, gpa);\n");
    buf_bytes(out, b"    v.push(100);                              // the Vec's own allocator\n");
    buf_bytes(out, b"    let b = total(&v).to_string_in(gpa);      // a String<Gpa>\n");
    buf_bytes(out, b"    let words: Vec<i64, Gpa> = (1..4i64).map(|x| x * 10).collect_in(gpa);\n");
    buf_bytes(out, b"    println(\"{b} {words:?}\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}                                             // words, b, v dropped: freed\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"114 [10, 20, 30]\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`Gpa` is a zero-sized `Copy` value: an allocator is passed by value\n");
    buf_bytes(out, b"(`gpa: Gpa`), and every container made from it shares it. Only `main`\n");
    buf_bytes(out, b"gets one (std's types have private fields: no `Gpa {}` outside std).\n");
    buf_bytes(out, b"Each of Rust's forms that allocates has an `_in` form taking the\n");
    buf_bytes(out, b"allocator last, as Rust's allocator API does (`Vec::with_capacity_in(cap,\n");
    buf_bytes(out, b"alloc)`): `Vec::new_in(a)`, `with_capacity_in(n, a)`,\n");
    buf_bytes(out, b"`String::new_in(a)`, `String::from_in(s, a)`, `Box::new_in(x, a)`,\n");
    buf_bytes(out, b"`HashMap::new_in(a)`, `it.collect_in(a)`, `format_in(\"..\", args, a)`,\n");
    buf_bytes(out, b"`x.to_string_in(a)`, `s.to_vec_in(a)`, `s.to_uppercase_in(a)`,\n");
    buf_bytes(out, b"`io::read_to_string_in(r, a)`, `fs::read_in(p, a)`, `v.clone_in(b)`.\n");
    buf_bytes(out, b"There is no form without `_in`: `Vec::new()`, `collect()`,\n");
    buf_bytes(out, b"`to_string()` are errors that name the `_in` form, and `volec fix --only\n");
    buf_bytes(out, b"alloc` passes the one allocator in scope:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let v: Vec<i64, Gpa> = Vec::new();\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[alloc.no_in] 'Vec::new' allocates from nothing: pass the allocator, last, to 'Vec::new_in'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Containers and their allocator\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`Vec<T, A: Allocator>`, `String<A>`, `Box<T, A>`, `HashMap<K, V, A, S>`:\n");
    buf_bytes(out, b"the allocator is a type parameter, always written (no default,\n");
    buf_bytes(out, b"`alloc.default`; a map's hasher `S` likewise, `hash.default`: `guide\n");
    buf_bytes(out, b"std`), so `Vec<i64, Gpa>` says it may grow from `Gpa`, which\n");
    buf_bytes(out, b"takes no bytes. Code generic over the allocator names it (`use\n");
    buf_bytes(out, b"std::alloc::Allocator;`), and changes the container through a `&mut`;\n");
    buf_bytes(out, b"code that only reads takes a slice:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::alloc::Allocator;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn fill<A: Allocator>(v: &mut Vec<i64, A>, n: i64) {\n");
    buf_bytes(out, b"    for i in 0..n { v.push(i); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn sum(s: &[i64]) -> i64 {                    // any Vec's slice\n");
    buf_bytes(out, b"    s.iter().sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    fill(&mut v, 5);\n");
    buf_bytes(out, b"    println(\"{}\", sum(&v));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"10\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An impl block writes every type argument: `impl<T, A: Allocator> Tr for\n");
    buf_bytes(out, b"Vec<T, A>`. `&A` is an allocator when `A` is one, so a container can\n");
    buf_bytes(out, b"borrow its allocator (`Vec::new_in(&arena)`, below).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Allocation is a capability\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A function can allocate only through an allocator reachable from its\n");
    buf_bytes(out, b"parameters, so its signature says whether it may:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- **No default allocator type** (`alloc.default`): `Vec<u8>` is an\n");
    buf_bytes(out, b"  error; write `Vec<u8, Gpa>`, or a generic `A`.\n");
    buf_bytes(out, b"- **No static holds an allocator** (`alloc.static`): a static's type\n");
    buf_bytes(out, b"  holds none, looked through fields, payloads and pointers. Keep\n");
    buf_bytes(out, b"  containers in `main` and pass them (or slices of them) down.\n");
    buf_bytes(out, b"- **A type that holds an allocator names it** (`alloc.field`): a field\n");
    buf_bytes(out, b"  `Vec<i64, Gpa>` needs `struct Parser<A: Allocator> { toks: Vec<i64, A>\n");
    buf_bytes(out, b"  }`, used as `Parser<Gpa>`; a literal infers `A` from its fields.\n");
    buf_bytes(out, b"- **An allocator's impl is unsafe** (`alloc.safe_impl`): `Allocator` is\n");
    buf_bytes(out, b"  an `unsafe trait` (Rust's: `allocate(&self, Layout) ->\n");
    buf_bytes(out, b"  Result<NonNull<u8>, AllocError>`, `deallocate`), and `unsafe impl\n");
    buf_bytes(out, b"  Allocator for T` says, under `// SAFETY:`, where its memory comes\n");
    buf_bytes(out, b"  from. An `_in` function takes its allocator last (`alloc.last`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::alloc::Allocator;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Parser<A: Allocator> {\n");
    buf_bytes(out, b"    toks: Vec<i64, A>,\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn parse_in<A: Allocator>(s: &str, a: A) -> Parser<A> {\n");
    buf_bytes(out, b"    let mut p = Parser { toks: Vec::new_in(a) };\n");
    buf_bytes(out, b"    for c in s.bytes() { p.toks.push(c as i64); }\n");
    buf_bytes(out, b"    p\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let p = parse_in(\"ab\", gpa);\n");
    buf_bytes(out, b"    println(\"{}\", p.toks.len());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec fix --only alloc` writes what it can: `Gpa` where an allocator is\n");
    buf_bytes(out, b"missing, the `_in` form with the allocator in scope, a type made generic\n");
    buf_bytes(out, b"over what it holds, then its uses; `volec explain alloc.field` (and each\n");
    buf_bytes(out, b"code) tells the rule.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Arenas\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An arena allocates by bumping a pointer and frees everything at once.\n");
    buf_bytes(out, b"`Arena::new_in(gpa)` makes one (its memory from `gpa`), freed whole when\n");
    buf_bytes(out, b"it is dropped: `arena.alloc(x)` puts a value in it and gives a `&mut T`\n");
    buf_bytes(out, b"that lives as long as the arena is borrowed, `alloc_str(s)` and\n");
    buf_bytes(out, b"`alloc_slice_copy(s)` copy text and slices in, and `&arena` is an\n");
    buf_bytes(out, b"allocator for containers. `std::alloc::arena_scope(&gpa, |a| ...)` makes\n");
    buf_bytes(out, b"one for a closure and frees all of it when the closure returns; nothing\n");
    buf_bytes(out, b"allocated from it may leave the closure (`borrowck.outlives`).\n");
    buf_bytes(out, b"`arena.scope(|s| ...)` is a scope inside an arena. `FixedBuf::new(&mut\n");
    buf_bytes(out, b"mem)` allocates from memory you give it, which it borrows mutably:\n");
    buf_bytes(out, b"while it, or a container on it, lives, `mem` is not read or written\n");
    buf_bytes(out, b"another way (`borrowck.assign_borrowed`), and it cannot outlive `mem`.\n");
    buf_bytes(out, b"Two containers alive together need a buffer each.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::alloc::FixedBuf;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let mut mem = [0u8; 256];\n");
    buf_bytes(out, b"    let mut v: Vec<i64, FixedBuf> = Vec::new_in(FixedBuf::new(&mut mem));\n");
    buf_bytes(out, b"    v.push(7);\n");
    buf_bytes(out, b"    v.push(8);\n");
    buf_bytes(out, b"    println(\"{}\", v[0] + v[1]);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"15\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::alloc::{Arena, arena_scope};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn longest(words: &[&str], gpa: Gpa) -> usize {\n");
    buf_bytes(out, b"    arena_scope(&gpa, |a| {\n");
    buf_bytes(out, b"        let mut lens = Vec::new_in(a);        // a Vec<usize, &ArenaScope<..>>\n");
    buf_bytes(out, b"        for w in words { lens.push(w.len()); }\n");
    buf_bytes(out, b"        lens.iter().copied().max().unwrap_or(0) // a usize leaves, the Vec does not\n");
    buf_bytes(out, b"    })\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let arena = Arena::new_in(gpa);           // freed whole when it is dropped\n");
    buf_bytes(out, b"    let n = arena.alloc(40);                  // a &mut i32 in the arena\n");
    buf_bytes(out, b"    *n += 2;\n");
    buf_bytes(out, b"    let name = arena.alloc_str(\"vole\");\n");
    buf_bytes(out, b"    let mut v = Vec::new_in(&arena);          // a container on it: &Arena is an allocator\n");
    buf_bytes(out, b"    v.push(*n);\n");
    buf_bytes(out, b"    println(\"{} {name} {} {}\", longest(&[\"a\", \"bcd\"], gpa), v[0], arena.used() > 0);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3 vole 42 true\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## --check-alloc\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec --check-alloc f.vl -o f` builds the program with a checking\n");
    buf_bytes(out, b"`Gpa` (like `--check-unsafe`, at any `-O`): every block gets pages of\n");
    buf_bytes(out, b"its own, never reused, so a use after free, a double free, a free of a\n");
    buf_bytes(out, b"wrong pointer or size stop the program with where the block was\n");
    buf_bytes(out, b"allocated and freed; leaks are listed at exit (`gpa.check_leaks()` in a\n");
    buf_bytes(out, b"test). Safe code cannot do these (the borrow checker rejects a\n");
    buf_bytes(out, b"reference into memory that was freed or moved: `volec guide\n");
    buf_bytes(out, b"memory#slices`); this mode finds them in `unsafe` code.\n");
}
