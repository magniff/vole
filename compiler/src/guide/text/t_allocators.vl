// Generated by compiler/guide/embed.sh from compiler/guide/allocators.md (do
// not edit): the guide's topic 'allocators'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Allocators (0.16)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Allocation is explicit: nothing allocates without being given an\n");
    buf_bytes(out, b"allocator. A program's general-purpose allocator is the `gpa: Gpa` its\n");
    buf_bytes(out, b"`main` takes; a function that allocates takes one as a parameter, or\n");
    buf_bytes(out, b"works on a container it was given (a `Vec` holds its allocator: `push`,\n");
    buf_bytes(out, b"`clone` and its drop use it). There is no global allocator to reach for,\n");
    buf_bytes(out, b"so a function's signature says whether it allocates.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Gpa, from main\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn squares(n: i64, gpa: Gpa) -> Vec<i64, Gpa> { // allocates: takes the allocator\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::with_capacity_in(n as usize, gpa);\n");
    buf_bytes(out, b"    for i in 0..n { v.push(i * i); }\n");
    buf_bytes(out, b"    v\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total(v: Vec<i64, Gpa>) -> i64 { // grows nothing: no allocator\n");
    buf_bytes(out, b"    v.iter().sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {                    // or main(argc, argv, gpa)\n");
    buf_bytes(out, b"    var v = squares(4, gpa);\n");
    buf_bytes(out, b"    v.push(100);                              // the Vec's own allocator\n");
    buf_bytes(out, b"    var b = String::new_in(gpa);\n");
    buf_bytes(out, b"    b.push_fmt(total(v));\n");
    buf_bytes(out, b"    let words: Vec<i64, Gpa> = (1..4).map(|x| x * 10).collect_in(gpa);\n");
    buf_bytes(out, b"    println(\"{} {words:?}\", b.as_slice());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}                                             // words, b, v dropped: freed\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"114 [10, 20, 30]\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`Gpa` is a zero-sized value, copied freely: an allocator is passed as a\n");
    buf_bytes(out, b"let parameter (`gpa: Gpa`, no convention to write), and every container\n");
    buf_bytes(out, b"made from it shares it. Only `main` gets one (std's\n");
    buf_bytes(out, b"types have private fields: no `Gpa {}` outside std). Each 0.15 form that\n");
    buf_bytes(out, b"allocated has an `_in` form taking the allocator last: `Vec::new_in(a)`,\n");
    buf_bytes(out, b"`with_capacity_in(n, a)`, `filled_in(n, x, a)`, `String::new_in(a)`,\n");
    buf_bytes(out, b"`HashMap::new_in(a)`, `it.collect_in(a)`, `format_in(x, a)`,\n");
    buf_bytes(out, b"`read_stdin_in(a)`, `split_in(s, sep, a)`, `split_whitespace_in(s, a)`,\n");
    buf_bytes(out, b"`sort_stable_in(s, a)`, `sort_stable_by_in(s, f, a)`, `v.clone_in(b)`,\n");
    buf_bytes(out, b"`BinaryHeap::new_in(a)`. The allocator is always the last argument, as\n");
    buf_bytes(out, b"in Rust's allocator API (`Vec::with_capacity_in(cap, alloc)`), except\n");
    buf_bytes(out, b"before a closure that is given it: `arena_scope(gpa, |a| ..)`.\n");
    buf_bytes(out, b"There is no form without `_in` (0.26.3): `Vec::new()`, `collect()`,\n");
    buf_bytes(out, b"`format(x)` are errors that name the `_in` form, and `volec fix --only\n");
    buf_bytes(out, b"alloc` passes the one allocator in scope:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let v: Vec<i64, Gpa> = Vec::new();\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[alloc.no_in] 'Vec::new' allocates from nothing: pass the allocator, last, to 'Vec::new_in'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Containers and their allocator\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`Vec<T, A: Allocator>`, `String<A>`, `HashMap<K, V, A>`: the allocator is a\n");
    buf_bytes(out, b"type parameter, always written (0.26.3: no default, `alloc.default`), so\n");
    buf_bytes(out, b"`Vec<i64, Gpa>` says it may grow from `Gpa`, which takes no bytes. Code\n");
    buf_bytes(out, b"generic over the allocator names it, and changes the container through\n");
    buf_bytes(out, b"an `inout` parameter (called with `&v`); code that only reads takes a\n");
    buf_bytes(out, b"slice:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn fill<A: Allocator>(v: inout Vec<i64, A>, n: i64) {\n");
    buf_bytes(out, b"    for i in 0..n { v.push(i); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn sum(s: [i64]) -> i64 {                     // any Vec's as_slice()\n");
    buf_bytes(out, b"    s.iter().sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    fill(&v, 5);\n");
    buf_bytes(out, b"    println(sum(v.as_slice()));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"10\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An impl block writes every type argument: `impl<T, A: Allocator> Tr for\n");
    buf_bytes(out, b"Vec<T, A>`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Allocation is a capability (0.26.3)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A function can allocate only through an allocator reachable from its\n");
    buf_bytes(out, b"parameters, so its signature says whether it may:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- **No default allocator type** (`alloc.default`): `Vec<u8>` is an\n");
    buf_bytes(out, b"  error; write `Vec<u8, Gpa>`, or a generic `A`.\n");
    buf_bytes(out, b"- **No static holds an allocator** (`alloc.static`): a static's type is\n");
    buf_bytes(out, b"  `AllocFree`, looked through fields, payloads and pointers. Keep\n");
    buf_bytes(out, b"  containers in `main` and pass them (or views of them) down. A bound\n");
    buf_bytes(out, b"  `T: AllocFree` (`use std::AllocFree;`) keeps a generic function from\n");
    buf_bytes(out, b"  allocating through what it is given.\n");
    buf_bytes(out, b"- **A type that holds an allocator names it** (`alloc.field`): a field\n");
    buf_bytes(out, b"  `Vec<i64, Gpa>` needs `struct Parser<A: Allocator> { toks: Vec<i64, A>\n");
    buf_bytes(out, b"  }`, used as `Parser<Gpa>`; a literal infers `A` from its fields.\n");
    buf_bytes(out, b"- **An allocator's impl is unsafe** (`alloc.safe_impl`): `Allocator` is\n");
    buf_bytes(out, b"  an `unsafe trait`, and `unsafe impl Allocator for T` says, under\n");
    buf_bytes(out, b"  `// SAFETY:`, where its memory comes from. An `_in` function takes its\n");
    buf_bytes(out, b"  allocator last (`alloc.last`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Parser<A: Allocator> {\n");
    buf_bytes(out, b"    toks: Vec<i64, A>,\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn parse_in<A: Allocator>(s: [u8], a: A) -> Parser<A> {\n");
    buf_bytes(out, b"    var p = Parser { toks: Vec::new_in(a) };\n");
    buf_bytes(out, b"    for c in s { p.toks.push(c as i64); }\n");
    buf_bytes(out, b"    p\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let p = parse_in(\"ab\", gpa);\n");
    buf_bytes(out, b"    println(\"{}\", p.toks.len());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec fix --only alloc` writes what it can: `Gpa` where an allocator is\n");
    buf_bytes(out, b"missing, the `_in` form with the allocator in scope, a type made generic\n");
    buf_bytes(out, b"over what it holds, then its uses; `volec explain alloc.field` (and each\n");
    buf_bytes(out, b"code) tells the rule.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Arenas\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An arena allocates by bumping a pointer and frees everything at once.\n");
    buf_bytes(out, b"`arena_scope(gpa, |a| ...)` makes one (its memory from `gpa`), runs the\n");
    buf_bytes(out, b"closure with it, and frees all of it when the closure returns; nothing allocated from it may leave\n");
    buf_bytes(out, b"the closure (the compiler rejects a result or a capture that holds the\n");
    buf_bytes(out, b"`ScopedArena`). `Arena::new_in(gpa)` is a handle kept longer (it does\n");
    buf_bytes(out, b"not drop yet: `unsafe { a.free_all(); }` returns its memory, 0.17),\n");
    buf_bytes(out, b"`a.scope(|s| ...)` a scope of it; `FixedBuf::new(&mem[..])` allocates\n");
    buf_bytes(out, b"from memory you give it, which it holds inout (0.25): while it, or a\n");
    buf_bytes(out, b"container on it, lives, `mem` is not read, written or dropped another\n");
    buf_bytes(out, b"way (`own.conflict`), and it cannot outlive `mem`. Two containers alive\n");
    buf_bytes(out, b"together need a buffer each.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::FixedBuf;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    var mem = [0u8; 256];\n");
    buf_bytes(out, b"    var v: Vec<i64, FixedBuf> = Vec::new_in(FixedBuf::new(&mem[..]));\n");
    buf_bytes(out, b"    v.push(7);\n");
    buf_bytes(out, b"    v.push(8);\n");
    buf_bytes(out, b"    println(\"{}\", v[0] + v[1]);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"15\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn longest(words: [[u8]], gpa: Gpa) -> usize {\n");
    buf_bytes(out, b"    arena_scope(gpa, |a| {\n");
    buf_bytes(out, b"        var lens: Vec<usize, ScopedArena> = Vec::new_in(a);\n");
    buf_bytes(out, b"        for w in words { lens.push(w.len()); }\n");
    buf_bytes(out, b"        lens.iter().max().unwrap_or(0)        // a usize leaves, the Vec does not\n");
    buf_bytes(out, b"    })\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## --check-alloc\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec --check-alloc f.vl -o f` builds the program with a checking\n");
    buf_bytes(out, b"`Gpa` (like `--check-unsafe`, at any `-O`): every block gets pages of\n");
    buf_bytes(out, b"its own, never reused, so a use after free, a double free, a free of a\n");
    buf_bytes(out, b"wrong pointer or size stop the program with where the block was\n");
    buf_bytes(out, b"allocated and freed; leaks are listed at exit (`gpa.check_leaks()` in a\n");
    buf_bytes(out, b"test). Arenas and `FixedBuf` are checked the same way: a block\n");
    buf_bytes(out, b"used after their `reset`, after its scope ended, or after it moved is\n");
    buf_bytes(out, b"reported. Views (`as_slice()`, a `[T]`) into memory that was freed or\n");
    buf_bytes(out, b"moved are rejected in safe code since 0.17 (`volec guide memory#slices`);\n");
    buf_bytes(out, b"this mode still finds them in `unsafe` code and under `--values=off`.\n");
}
