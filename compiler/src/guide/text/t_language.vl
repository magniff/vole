// Generated by compiler/guide/embed.sh from compiler/guide/language.md (do
// not edit): the guide's topic 'language'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# The language, the long form (vole 0.28)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Vole is a compiled systems language with Rust's surface: structs, enums\n");
    buf_bytes(out, b"with exhaustive `match`, traits and generics (monomorphized), closures,\n");
    buf_bytes(out, b"iterators, modules, checked slices, `unsafe` raw pointers, exact C\n");
    buf_bytes(out, b"interop. Ownership is Rust's: a value has one owner and is dropped at\n");
    buf_bytes(out, b"the end of its scope; `&T` and `&mut T` borrow it, checked by the borrow\n");
    buf_bytes(out, b"checker, with lifetimes where a signature needs them. It is not Rust in\n");
    buf_bytes(out, b"a few places (the table below): there are no macros, and nothing\n");
    buf_bytes(out, b"allocates without an allocator. Every function's effects are known.\n");
    buf_bytes(out, b"Safe code has no undefined behaviour. This text matches this compiler;\n");
    buf_bytes(out, b"`volec guide` is the short core of this text, `volec guide TOPIC` the\n");
    buf_bytes(out, b"detail (topics at the end); `volec guide --full` prints this topic with\n");
    buf_bytes(out, b"std's API in its place.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Build and run\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec run [DIR] [-- ARGS]            # DIR/main.vl built (when changed), then run\n");
    buf_bytes(out, b"volec hello.vl -o hello && ./hello   # executable (cc links it)\n");
    buf_bytes(out, b"volec hello.vl -o hello.o            # object; `-o x.s`: assembly\n");
    buf_bytes(out, b"volec check hello.vl                 # errors only, one per line\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    println(\"hello\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"hello\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`main` returns the exit status (`fn main()` with no result is 0).\n");
    buf_bytes(out, b"`fn main(gpa: Gpa)` takes the program's allocator (below); the\n");
    buf_bytes(out, b"arguments are `std::env::args()`. Several files on the command line\n");
    buf_bytes(out, b"make one program; `mod name;` loads `name.vl`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Where it is not Rust\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `println!(\"{}\", x)`, `format!`, `vec!`, `assert!` | no macros: functions, `println(\"x = {x:>4} {:?}\", v)`, `format_in(\"..\", args, gpa)` (a `String`), `assert(c)`, `panic(\"..\")` (`guide formatting`) |\n");
    buf_bytes(out, b"| `Vec::new()`, a global allocator | `Vec::new_in(gpa)`: nothing allocates without an allocator; `gpa` comes from `fn main(gpa: Gpa)`, passed down as a parameter (`guide allocators`) |\n");
    buf_bytes(out, b"| `Vec<T>`, `String`, `HashMap<K, V>`, `Box<T>` | the allocator is in the type: `Vec<T, Gpa>`, `String<Gpa>`, `HashMap<K, V, Gpa, FixedState>` (the hasher too; `FixedState` is in the prelude, as `Gpa`), `Box<T, Gpa>`; a struct that holds one is generic over it (`struct S<A: Allocator> { v: Vec<u8, A> }`) |\n");
    buf_bytes(out, b"| `s.to_string()`, `it.collect()`, `s.to_uppercase()` | what allocates has the name with `_in` and takes the allocator last: `to_string_in(gpa)`, `collect_in(gpa)` (`alloc.no_in` names it; `volec fix --only alloc`) |\n");
    buf_bytes(out, b"| `use m::*;` | not allowed: `use m::{a, b};`, or the path `m::a` |\n");
    buf_bytes(out, b"| `a as i64` to widen | written or not: an `i32` goes where an `i64` does, losslessly; `a as i32` narrows (`guide conversions`) |\n");
    buf_bytes(out, b"| `dyn Trait`, `i128`, `async`, macros by example, a function inside a function, a string literal as a pattern | not there: dispatch is static (`impl Trait`, generics); `if s == \"add\"` |\n");
    buf_bytes(out, b"| contracts, effects | `requires`/`ensures` clauses, `#[no_alloc]`, `volec query effects f` (`guide contracts`, `guide effects`) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec guide rust` has every difference. The prelude, in every module\n");
    buf_bytes(out, b"without `use`, is Rust's (`Option`, `Some`, `None`, `Result`, `Ok`,\n");
    buf_bytes(out, b"`Err`, `Vec`, `String`, `Box`, `Clone`, `Copy`, `Default`, `Drop`,\n");
    buf_bytes(out, b"`PartialEq`, `Eq`, `PartialOrd`, `Ord`, `From`, `Into`, `Iterator`...)\n");
    buf_bytes(out, b"plus `Gpa` and, as functions, Rust's macros: `print`, `println`,\n");
    buf_bytes(out, b"`eprint`, `eprintln`, `format_in`, `write`, `writeln`, `panic`,\n");
    buf_bytes(out, b"`assert`, `assert_eq`, `assert_ne`, `debug_assert`, `todo`,\n");
    buf_bytes(out, b"`unimplemented`, `unreachable`. The rest of std is used by path\n");
    buf_bytes(out, b"(`std::mem::swap(&mut a, &mut b)`) or imported (`use\n");
    buf_bytes(out, b"std::collections::HashMap;`). Calling C or an `unsafe fn`,\n");
    buf_bytes(out, b"dereferencing a raw pointer and using a `static mut` are allowed only\n");
    buf_bytes(out, b"in `unsafe { }` (`volec guide unsafe`: the full list).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Values and types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let a = 42;               // i32: an integer literal is i32 unless the context says\n");
    buf_bytes(out, b"let b: u8 = 255;          // i8 i16 i32 i64 u8 u16 u32 u64 isize usize\n");
    buf_bytes(out, b"let c = 3u32;             // suffixes; 1_000, 0xff, 0b1010\n");
    buf_bytes(out, b"let d = 2.5;              // f64; 2.5f32 is f32\n");
    buf_bytes(out, b"let e = 'A';              // char: a Unicode scalar value; b'A' is a u8\n");
    buf_bytes(out, b"let f = true;             // bool\n");
    buf_bytes(out, b"let s = \"text\";           // &str: s.len() (bytes), &s[1..3], s.chars()\n");
    buf_bytes(out, b"let bs = b\"bytes\";        // &[u8; 5]: bs[0]\n");
    buf_bytes(out, b"let p = c\"for C\";         // *const u8, NUL-terminated\n");
    buf_bytes(out, b"let t = (1, \"two\");       // a tuple: t.0, t.1\n");
    buf_bytes(out, b"let arr = [0; 8];         // [i32; 8]; also [1, 2, 3]; arr[i] is checked\n");
    buf_bytes(out, b"let mut n = a as u8;      // `as` converts numbers; only widening is implicit\n");
    buf_bytes(out, b"n += c as u8 + b / 5 + e as u8;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`let` bindings are immutable, `let mut` ones mutable. Shadowing (`let x\n");
    buf_bytes(out, b"= x + 1;`) is allowed. `const N: i64 = 10;` and `static LIMIT: i64 = 3;`\n");
    buf_bytes(out, b"are items; a `static mut` is read and written in `unsafe` (`guide\n");
    buf_bytes(out, b"threads`). Overflow panics at -O0 and wraps at -O1 and above, `x / 0`\n");
    buf_bytes(out, b"panics; indexing, slicing, `unwrap` and casts to enums are checked (a\n");
    buf_bytes(out, b"message, exit 101): `guide types`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Functions and control flow\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn classify(n: i64) -> &'static str {\n");
    buf_bytes(out, b"    if n < 0 { \"negative\" } else if n == 0 { \"zero\" } else { \"positive\" }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn greet(name: &str, times: i64, sep: &str) {\n");
    buf_bytes(out, b"    for _ in 0..times { print(\"hi {name}{sep}\"); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let mut total = 0;\n");
    buf_bytes(out, b"    for i in 0..10 {              // 0..10 and 0..=9; (0..10).rev(), .step_by(2)\n");
    buf_bytes(out, b"        if i % 2 == 0 { continue; }\n");
    buf_bytes(out, b"        total += i;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let mut k = 0;\n");
    buf_bytes(out, b"    while k < 3 { k += 1; }\n");
    buf_bytes(out, b"    let found = loop {            // loop's value comes from `break value`\n");
    buf_bytes(out, b"        k += 1;\n");
    buf_bytes(out, b"        if k * k > 50 { break k; }\n");
    buf_bytes(out, b"    };\n");
    buf_bytes(out, b"    'outer: for i in 0..5 {       // a label: `'name:`, then `break 'name`\n");
    buf_bytes(out, b"        for j in 0..5 {\n");
    buf_bytes(out, b"            if i * j == 6 { break 'outer; }\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    greet(\"ann\", 1, \" \");\n");
    buf_bytes(out, b"    greet(\"bob\", 2, \"! \");\n");
    buf_bytes(out, b"    println(\"{}\", classify(total - found));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"hi ann hi bob! hi bob! positive\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The last expression of a block, without `;`, is its value; `if`, `match`,\n");
    buf_bytes(out, b"`loop` and blocks are expressions. A range is a value (`let r = 0..3;`,\n");
    buf_bytes(out, b"`(0..10).rev()`, `.step_by(2)`). There are no nested functions.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## References: &T, &mut T, by value\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::alloc::Allocator;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Account<A: Allocator> { balance: i64, log: Vec<i64, A> } // the allocator: a parameter\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn transfer(from: &mut Account<Gpa>, to: &mut Account<Gpa>, amount: i64) -> bool {\n");
    buf_bytes(out, b"    if from.balance < amount { return false; }\n");
    buf_bytes(out, b"    from.balance -= amount;\n");
    buf_bytes(out, b"    to.balance += amount;\n");
    buf_bytes(out, b"    from.log.push(-amount);\n");
    buf_bytes(out, b"    to.log.push(amount);\n");
    buf_bytes(out, b"    true\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn report(a: &Account<Gpa>, out: &mut i64) { *out += a.balance; } // *out: the caller's i64\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn keep(all: &mut Vec<Account<Gpa>, Gpa>, a: Account<Gpa>) { all.push(a); }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let mut a = Account { balance: 100, log: Vec::new_in(gpa) };\n");
    buf_bytes(out, b"    let mut b = Account { balance: 5, log: Vec::new_in(gpa) };\n");
    buf_bytes(out, b"    transfer(&mut a, &mut b, 30);         // the call shows what changes\n");
    buf_bytes(out, b"    let mut sum = 0;\n");
    buf_bytes(out, b"    report(&a, &mut sum);\n");
    buf_bytes(out, b"    report(&b, &mut sum);\n");
    buf_bytes(out, b"    let mut all: Vec<Account<Gpa>, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    keep(&mut all, a);                    // a moves: dead from here\n");
    buf_bytes(out, b"    println(\"{sum} {} {}\", all[0].log.len(), b.balance);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"105 1 35\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `&T` reads: any number of them at once. `&mut T` changes the caller's\n");
    buf_bytes(out, b"  place, exclusively: `transfer(&mut a, &mut a, 1)` is\n");
    buf_bytes(out, b"  `borrowck.mut_twice`. A parameter by value takes the argument: a\n");
    buf_bytes(out, b"  `Copy` value (`i64`, a struct deriving `Clone, Copy`) is copied, any\n");
    buf_bytes(out, b"  other moves, and the callee owns it and drops it.\n");
    buf_bytes(out, b"- Through a reference, a field or a method needs no `*`\n");
    buf_bytes(out, b"  (`from.balance`, `from.log.push(x)`); the value itself does (`*out +=\n");
    buf_bytes(out, b"  1`).\n");
    buf_bytes(out, b"- `let r = &mut a;` keeps a borrow, passed on as `f(r)`; it ends at its\n");
    buf_bytes(out, b"  last use (`guide memory`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Structs, enums, match, methods\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[derive(Clone, Copy, PartialEq, Debug)]\n");
    buf_bytes(out, b"struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"enum Shape { Circle(Point, i64), Rect { min: Point, max: Point }, Empty }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Point {\n");
    buf_bytes(out, b"    fn new(x: i64, y: i64) -> Point { Point { x, y } }          // Point::new(1, 2)\n");
    buf_bytes(out, b"    fn shift(&mut self, dx: i64) { self.x += dx; }              // writes through self\n");
    buf_bytes(out, b"    fn sum(&self) -> i64 { self.x + self.y }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn area(s: &Shape) -> i64 {\n");
    buf_bytes(out, b"    match s {\n");
    buf_bytes(out, b"        Shape::Circle(_, r) => 3 * r * r,\n");
    buf_bytes(out, b"        Shape::Rect { min, max } => (max.x - min.x) * (max.y - min.y),\n");
    buf_bytes(out, b"        Shape::Empty => 0,\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let mut p = Point::new(1, 2);\n");
    buf_bytes(out, b"    p.shift(10);                          // borrows p mutably: p is a let mut\n");
    buf_bytes(out, b"    let shapes = [Shape::Rect { min: Point::new(0, 0), max: p }, Shape::Circle(p, 2),\n");
    buf_bytes(out, b"        Shape::Empty];                    // p is Copy: used twice\n");
    buf_bytes(out, b"    for s in &shapes {\n");
    buf_bytes(out, b"        print(\"{} \", area(s));\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"{} {:?}\", p.sum(), p);\n");
    buf_bytes(out, b"    let o: Option<i64> = Some(7);\n");
    buf_bytes(out, b"    if let Some(v) = o { print(\"{v}\"); }\n");
    buf_bytes(out, b"    match 15 {\n");
    buf_bytes(out, b"        0 => println(\" zero\"),\n");
    buf_bytes(out, b"        1..=9 => println(\" digit\"),\n");
    buf_bytes(out, b"        n if n % 5 == 0 => println(\" fives\"),\n");
    buf_bytes(out, b"        _ => println(\" other\"),\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"22 12 0 13 Point { x: 11, y: 2 }\n");
    buf_bytes(out, b"7 fives\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A variant's fields are by position (`Circle(Point, i64)`) or by name\n");
    buf_bytes(out, b"(`Rect { min: Point, max: Point }`: made as `Shape::Rect { min: a, max\n");
    buf_bytes(out, b"}` in any order, matched as `Shape::Rect { min, .. }`; a variant's\n");
    buf_bytes(out, b"fields are read only through patterns). A match must cover every value;\n");
    buf_bytes(out, b"arms can have `|`, ranges `a..=b` and guards `if`. Matching a `&Shape`\n");
    buf_bytes(out, b"binds references (`r` above is a `&i64`). `use Shape::{Circle, Empty};`\n");
    buf_bytes(out, b"lets variants be written without `Shape::`. `==` is `PartialEq`:\n");
    buf_bytes(out, b"`#[derive(PartialEq)]` compares a struct or enum field by field; `&str`\n");
    buf_bytes(out, b"compares by bytes, a `Vec` or `HashMap` by contents.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Generics and traits\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"trait Area {\n");
    buf_bytes(out, b"    fn area(&self) -> i64;\n");
    buf_bytes(out, b"    fn twice(&self) -> i64 { 2 * self.area() }         // a default method\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Square { side: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Area for Square {\n");
    buf_bytes(out, b"    fn area(&self) -> i64 { self.side * self.side }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total<T: Area>(items: &[T]) -> i64 {   // bounds: T: A + B\n");
    buf_bytes(out, b"    items.iter().map(|it| it.area()).sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Pair<T> { a: T, b: T }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl<T: PartialOrd> Pair<T> {\n");
    buf_bytes(out, b"    fn max(self) -> T { if self.a > self.b { self.a } else { self.b } }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let squares = [Square { side: 2 }, Square { side: 3 }];\n");
    buf_bytes(out, b"    let p = Pair::<i64> { a: 3, b: 9 };   // the turbofish: Pair::<i64>\n");
    buf_bytes(out, b"    println(\"{} {} {}\", total(&squares), squares[0].twice(), p.max()); // &array: a slice\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"13 8 9\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Generics are templates, checked per instantiation (`max::<i64>(a, b)`\n");
    buf_bytes(out, b"is the turbofish). Operators go through std's traits: `impl\n");
    buf_bytes(out, b"std::ops::Add for V` makes `a + b` work; `PartialOrd` gives `<`. There\n");
    buf_bytes(out, b"are no trait objects: dispatch is static (`guide traits`, `guide\n");
    buf_bytes(out, b"generics`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Modules and imports\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`mod geometry;` loads geometry.vl (or `mod geometry { ... }` inline);\n");
    buf_bytes(out, b"`use geometry::{Rect, area};` imports by name, never `*`. Paths start\n");
    buf_bytes(out, b"with a name in scope, `crate`, `self`, `super` or `std`. Items are\n");
    buf_bytes(out, b"private (to their module and its children) unless `pub`, and so are a\n");
    buf_bytes(out, b"struct's fields (`pub w: i64` to show one); `pub use` re-exports. A\n");
    buf_bytes(out, b"missing import's error says which `use` line to add, and `volec fix`\n");
    buf_bytes(out, b"adds it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Slices, arrays, text\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn sum(xs: &[i64]) -> i64 {\n");
    buf_bytes(out, b"    let mut t = 0;\n");
    buf_bytes(out, b"    for i in 0..xs.len() { t += xs[i]; }    // indices are usize; checked\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let mut a = [5i64, 1, 4];\n");
    buf_bytes(out, b"    a[1] = 2;\n");
    buf_bytes(out, b"    println(\"{}\", sum(&a) + sum(&a[1..]));  // &a[lo..hi], &a[..hi], &a[lo..]\n");
    buf_bytes(out, b"    let s = \"hello world\";\n");
    buf_bytes(out, b"    println(\"{}\", &s[6..]);\n");
    buf_bytes(out, b"    if s.starts_with(\"hello\") { println(\"starts with hello\"); }\n");
    buf_bytes(out, b"    let words = [0; 4];\n");
    buf_bytes(out, b"    let i = s.len() - 7;\n");
    buf_bytes(out, b"    println(\"{}\", words[i]);              // out of bounds: a message, exit 101\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out (exit 101)\n");
    buf_bytes(out, b"17\n");
    buf_bytes(out, b"world\n");
    buf_bytes(out, b"starts with hello\n");
    buf_bytes(out, b"main.vl:16:19: index out of bounds: index 4, length 4\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An array `[T; N]` is a value (`a.len()` is N); a slice `&[T]` is a\n");
    buf_bytes(out, b"pointer and a length (`.len()`; `.as_ptr()` for C) borrowing an array, a\n");
    buf_bytes(out, b"`Vec` or memory. A `&[T]` is read-only; `&mut [T]` (`&mut a[..]`,\n");
    buf_bytes(out, b"`v.as_mut_slice()`) writes its elements. Text is `&str`, UTF-8: `&s[a..b]`\n");
    buf_bytes(out, b"slices by bytes, `s.chars()` gives its `char`s, `s.as_bytes()` its\n");
    buf_bytes(out, b"`&[u8]` (`guide text`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## std: Vec, HashMap, String; allocation\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::collections::HashMap;\n");
    buf_bytes(out, b"use std::fmt::Write;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn evens(n: i64, gpa: Gpa) -> Vec<i64, Gpa> { // it allocates: it takes an allocator\n");
    buf_bytes(out, b"    (0..n).map(|i| i * 2).collect_in(gpa)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {                 // the program's allocator\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); // dropped (freed) when main returns\n");
    buf_bytes(out, b"    v.push(30);\n");
    buf_bytes(out, b"    v.push(10);\n");
    buf_bytes(out, b"    v.push(20);\n");
    buf_bytes(out, b"    v.sort();                              // in place\n");
    buf_bytes(out, b"    v[0] += 1;                             // checked; v.get(0) is an Option<&i64>\n");
    buf_bytes(out, b"    for x in &v { print(\"{x} \"); }         // also v.iter(); `for x in v` moves v\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    let last = v.pop();                    // Option<i64>\n");
    buf_bytes(out, b"    println(\"{}\", last.unwrap_or(-1));\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    let mut m: HashMap<&str, i64, Gpa, FixedState> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"    m.insert(\"a\", 1);\n");
    buf_bytes(out, b"    m.insert(\"b\", 2);\n");
    buf_bytes(out, b"    match m.get(\"a\") { Some(x) => println(\"{x}\"), None => println(\"none\") }\n");
    buf_bytes(out, b"    for (k, _) in &m { print(\"{k}\"); }     // (&K, &V) pairs, in slot order\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    let mut b = String::new_in(gpa);       // text builder\n");
    buf_bytes(out, b"    let e = evens(4, gpa);\n");
    buf_bytes(out, b"    b.push_str(\"n=\");\n");
    buf_bytes(out, b"    write(&mut b, \"{}\", m.len() + e.len()).unwrap();\n");
    buf_bytes(out, b"    b.push('!');\n");
    buf_bytes(out, b"    println(\"{b}\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"11 20 30\n");
    buf_bytes(out, b"30\n");
    buf_bytes(out, b"1\n");
    buf_bytes(out, b"ba\n");
    buf_bytes(out, b"n=6!\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Allocation is explicit: nothing allocates without an allocator. A\n");
    buf_bytes(out, b"function that allocates takes one, `gpa: Gpa` or `a: A` with `A:\n");
    buf_bytes(out, b"Allocator`, or a container it was given (`push` uses the Vec's own);\n");
    buf_bytes(out, b"main's `gpa` is where they come from. `std::alloc::arena_scope(&gpa, |a|\n");
    buf_bytes(out, b"...)` hands out an arena whose memory is all freed when the closure\n");
    buf_bytes(out, b"returns. `--check-alloc` builds the program with a checking allocator: a\n");
    buf_bytes(out, b"use after free, a double free, a leak are reported where they happen.\n");
    buf_bytes(out, b"Every function's effects are inferred (`alloc(Gpa) io static panic\n");
    buf_bytes(out, b"diverge unsafe`): `volec query effects f --why io` shows where; `#[no_alloc]` on\n");
    buf_bytes(out, b"a function is checked (`guide effects`, `guide allocators`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`Vec`, `String` and `HashMap` own their contents: `let w = v;` or\n");
    buf_bytes(out, b"passing one by value moves it (`.clone()` copies). Pass `&v` to a `v:\n");
    buf_bytes(out, b"&Vec<T, A>` (or `&[T]`) parameter to read it, `&mut v` to a `v: &mut\n");
    buf_bytes(out, b"Vec<T, A>` one to let a function push. A slice from `as_slice` borrows\n");
    buf_bytes(out, b"the vector: the vector does not grow or drop while the slice is used\n");
    buf_bytes(out, b"(`guide memory#slices`). std's API, made from its source in this\n");
    buf_bytes(out, b"compiler, a line per item: `volec guide std#the-api`; one name with\n");
    buf_bytes(out, b"its comment: `volec guide --find NAME` (all of them, 140k bytes, to a\n");
    buf_bytes(out, b"file: `volec guide std#every-item`).\n");
    buf_bytes(out, b"@STD-API-FULL@\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A priority queue is a `BinaryHeap` (the largest first; the smallest\n");
    buf_bytes(out, b"with `Reverse`, or a `MinHeap`), in `std::collections`. Dijkstra's\n");
    buf_bytes(out, b"shortest paths with a heap of (distance, node) pairs:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::cmp::Reverse;\n");
    buf_bytes(out, b"use std::collections::BinaryHeap;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// Dijkstra: the shortest distances from node 0.\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let n: usize = 5;\n");
    buf_bytes(out, b"    let mut adj: Vec<Vec<(usize, i64), Gpa>, Gpa> = Vec::new_in(gpa); // adj[u]: (to, weight)\n");
    buf_bytes(out, b"    for _ in 0..n {\n");
    buf_bytes(out, b"        adj.push(Vec::new_in(gpa));\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    for (u, v, w) in [(0usize, 1usize, 4i64), (0, 2, 1), (2, 1, 2), (1, 3, 1), (2, 3, 5)] {\n");
    buf_bytes(out, b"        adj[u].push((v, w));\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let mut dist: Vec<i64, Gpa> = Vec::from_elem_in(i64::MAX, n, gpa);\n");
    buf_bytes(out, b"    let mut heap: BinaryHeap<Reverse<(i64, usize)>, Gpa> = BinaryHeap::new_in(gpa); // (distance, node)\n");
    buf_bytes(out, b"    dist[0] = 0;\n");
    buf_bytes(out, b"    heap.push(Reverse((0, 0)));\n");
    buf_bytes(out, b"    while let Some(Reverse((d, u))) = heap.pop() { // the nearest first\n");
    buf_bytes(out, b"        if d > dist[u] {\n");
    buf_bytes(out, b"            continue; // stale: u was reached sooner\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        for &(v, w) in &adj[u] {\n");
    buf_bytes(out, b"            if d + w < dist[v] {\n");
    buf_bytes(out, b"                dist[v] = d + w;\n");
    buf_bytes(out, b"                heap.push(Reverse((d + w, v)));\n");
    buf_bytes(out, b"            }\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"{} {} {} {}\", dist[1], dist[2], dist[3], dist[4] == i64::MAX);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3 1 4 true\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Input, output, arguments\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"std prints and reads stdin, Rust's way: `io::read_to_string_in(\n");
    buf_bytes(out, b"io::stdin(), gpa)` (all of it, an `io::Result<String<Gpa>>`),\n");
    buf_bytes(out, b"`io::stdin().read_line(&mut s)` (appends the next line with its\n");
    buf_bytes(out, b"`'\\n'`; `Ok(0)` at the end), then `str`'s methods (`lines`,\n");
    buf_bytes(out, b"`split_whitespace`, `split`, `trim`, `parse::<i64>()`, a `Result`:\n");
    buf_bytes(out, b"`guide conversions`, where Option means absent and Result failed).\n");
    buf_bytes(out, b"Files, the environment and processes are `std::fs`, `std::env` and\n");
    buf_bytes(out, b"`std::process` (`guide io`):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::{env, io};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let input = io::read_to_string_in(io::stdin(), gpa).unwrap(); // all of stdin, a String<Gpa>\n");
    buf_bytes(out, b"    let mut total = 0i64;\n");
    buf_bytes(out, b"    for tok in input.split_whitespace() {\n");
    buf_bytes(out, b"        match tok.parse::<i64>() {        // a Result<i64, ParseIntError>\n");
    buf_bytes(out, b"            Ok(n) => total += n,\n");
    buf_bytes(out, b"            Err(_) => eprintln(\"not a number: {tok}\"),\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"{total}\");\n");
    buf_bytes(out, b"    for a in env::args().skip(1) {        // the first is the program\n");
    buf_bytes(out, b"        println(\"{a}\");\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```in\n");
    buf_bytes(out, b"12\n");
    buf_bytes(out, b"30\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"42\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## unsafe and C\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"import \"stdio.h\" as c;                   // a C header, its names under c::\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"extern \"C\" {                              // or declare C functions yourself\n");
    buf_bytes(out, b"    fn abs(x: i32) -> i32;\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    unsafe { c::printf(c\"%.1f %d\\n\", 2.5 * 2.0, abs(-3)); }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"5.0 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Unsafe operations: calling C or an `unsafe fn`, dereferencing a raw\n");
    buf_bytes(out, b"pointer (`*p`, `(*p).f`), using a `static mut`, reading a union field. A\n");
    buf_bytes(out, b"reference (`&T`, `&mut T`) is safe to read and write through wherever it\n");
    buf_bytes(out, b"is kept; `*const T` and `*mut T` are raw. `volec fix --only unsafe`\n");
    buf_bytes(out, b"wraps what needs it; `#[repr(C)]`, callbacks and linking: `guide\n");
    buf_bytes(out, b"c-interop`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Errors you will meet first\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| error (short form) | fix |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `'println!' is a macro call: vole has no macros` | `println(\"{}\", x)`, the help's form |\n");
    buf_bytes(out, b"| `'Vec::new' allocates from nothing` (`alloc.no_in`; `to_string`, `collect`) | `Vec::new_in(gpa)`, `to_string_in(gpa)`: `fn main(gpa: Gpa)`, `gpa` passed down; `volec fix --only alloc` |\n");
    buf_bytes(out, b"| `'Vec' names no allocator` (`alloc.default`) | `Vec<i64, Gpa>` |\n");
    buf_bytes(out, b"| `alloc.field: the struct 'S' holds an allocator its parameters do not name` | `struct S<A: Allocator> { v: Vec<u8, A> }`, used as `S<Gpa>` |\n");
    buf_bytes(out, b"| `expected 'String<Gpa>', got '&str'` | `String::from_in(\"..\", gpa)`; a parameter `s: &str` takes both |\n");
    buf_bytes(out, b"| `wildcard imports are not allowed` | `use m::{a, b};` |\n");
    buf_bytes(out, b"| `borrowck.use_moved: 'v' is used here after it moved` | lend it (`&v`), or pass `v.clone()` |\n");
    buf_bytes(out, b"| `borrowck.conflict: cannot borrow 'u' as mutable because it is also borrowed as immutable` | use the shared borrow before the change, or take it again after |\n");
    buf_bytes(out, b"| `edition.lenient: 'n' is a value where a reference goes` | `f(&n)` |\n");
    buf_bytes(out, b"| `expected '&mut Vec<i64, Gpa>', got 'Vec<i64, Gpa>'` | `f(&mut v)` |\n");
    buf_bytes(out, b"| `cannot assign to immutable variable 'x'` | `let mut x` |\n");
    buf_bytes(out, b"| `cannot infer the type of closure parameter 'x'` | `\\|x: i64\\| ...`, or pass it where an `Fn` bound or `fn` type gives it |\n");
    buf_bytes(out, b"| `'?' needs 'f' to return Option or Result` | `fn f(..) -> Option<T>` or `-> Result<T, E>` |\n");
    buf_bytes(out, b"| `expected '&[i64]', got '&[i32; 3]'` | `[5i64, 1, 4]`: an unsuffixed literal is an `i32` unless the context says at once |\n");
    buf_bytes(out, b"| `expected 'i32', got 'i64'` | `x as i32`: only widening is implicit |\n");
    buf_bytes(out, b"| `distinct.mix: '5u8' is 'u8' where 'char' goes` | `5u8 as char` |\n");
    buf_bytes(out, b"| `non-exhaustive match: 'E::C' is not covered` | an arm, or `_ =>` |\n");
    buf_bytes(out, b"| `error[unsafe] calling a C function is unsafe` | `unsafe { ... }` |\n");
    buf_bytes(out, b"| `unknown type 'HashMap' \\| help: add 'use ...'` | add the `use` line the help names (`volec fix`) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec guide errors` has more, each with its fix.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Tools: read and change code through the compiler\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec check [ROOT]                   # all errors, one line each: FILE:L:C: error[KIND] MSG | help: ...\n");
    buf_bytes(out, b"volec f.vl -o f                    # the same lines when compiling, off a terminal\n");
    buf_bytes(out, b"volec query show NAME                # an item's source: fn, Type::method, Enum::Variant, FILE:LINE\n");
    buf_bytes(out, b"volec query def NAME                 # where it is defined, its signature\n");
    buf_bytes(out, b"volec query refs NAME                # every resolved use (--count, --in FILE)\n");
    buf_bytes(out, b"volec query items [MODULE]           # a module's items with signatures (std: its API)\n");
    buf_bytes(out, b"volec query context NAME             # source, what it calls, its types and callers, at once\n");
    buf_bytes(out, b"volec query effects NAME             # what it may do: alloc(Gpa) io static panic diverge unsafe\n");
    buf_bytes(out, b"volec try '7 / 2'                    # run a snippet with std: its output, TYPE = VALUE\n");
    buf_bytes(out, b"volec edit patch NAME --old 'a < b' --new 'a <= b'   # change text inside one item\n");
    buf_bytes(out, b"volec edit replace NAME < new.vl   # replace an item; edit insert --after NAME; edit delete NAME\n");
    buf_bytes(out, b"volec fix                            # missing imports, unused, pub, unsafe blocks\n");
    buf_bytes(out, b"volec undo                           # take the last edit back\n");
    buf_bytes(out, b"volec refactor rename main::x total  # a local (or FILE:LINE:COL), an item, a field, with every use\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"They pay off on renames, moves, signature changes, errors across files\n");
    buf_bytes(out, b"and large code; a small file is cheaper read whole (`query show\n");
    buf_bytes(out, b"FILE.vl`). ROOT is `--root FILE`, a last argument ending in `.vl`,\n");
    buf_bytes(out, b"or `./main.vl`. Every edit is checked first: one that adds an error\n");
    buf_bytes(out, b"writes nothing. A problem is one line, `error CODE: message`, then\n");
    buf_bytes(out, b"`try:` lines to run as they are (`guide tools`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Topics\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec guide TOPIC` prints one; `volec guide --list` gives their\n");
    buf_bytes(out, b"sizes; `volec guide --all` prints everything.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"@TOPICS@\n");
}
