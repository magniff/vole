// Generated by compiler/guide/embed.sh from compiler/guide/language.md (do
// not edit): the guide's topic 'language'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# The language, the long form (vole 0.20)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Vole is a compiled systems language of values: structs, enums with\n");
    buf_bytes(out, b"exhaustive `match`, traits and generics (monomorphized), modules,\n");
    buf_bytes(out, b"checked slices, `unsafe` raw pointers, exact C interop. A value has one\n");
    buf_bytes(out, b"owner and is dropped at the end of its scope; a function says what it\n");
    buf_bytes(out, b"does with each parameter, `let` (the default: it reads it), `inout`\n");
    buf_bytes(out, b"(it changes it: the caller writes `&x`) or `sink` (it takes it), and\n");
    buf_bytes(out, b"the compiler checks that no two accesses of a value conflict. There\n");
    buf_bytes(out, b"are no lifetimes to write and no macros. Nothing allocates without an\n");
    buf_bytes(out, b"allocator, and every function's effects are known (0.16). Safe code\n");
    buf_bytes(out, b"has no undefined behaviour. This text matches this compiler;\n");
    buf_bytes(out, b"`volec guide` is the short core of this text, `volec guide TOPIC`\n");
    buf_bytes(out, b"the detail (topics at the end); `volec guide --full` prints this\n");
    buf_bytes(out, b"topic with std's API in its place.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Build and run\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec run [DIR] [-- ARGS]            # DIR/main.vl built (when changed), then run\n");
    buf_bytes(out, b"volec hello.vl -o hello && ./hello   # executable (cc links it)\n");
    buf_bytes(out, b"volec hello.vl -o hello.o            # object; `-o x.s`: assembly\n");
    buf_bytes(out, b"volec check hello.vl                 # errors only, one per line\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    println(\"hello\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"hello\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`main` returns the exit status (`fn main()` with no result is 0).\n");
    buf_bytes(out, b"`fn main(gpa: Gpa)` takes the program's allocator (below), `fn\n");
    buf_bytes(out, b"main(argc: i32, argv: **u8, gpa: Gpa)` the arguments too. Several files\n");
    buf_bytes(out, b"on the command line make one program; `mod name;` loads `name.vl`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Rust habits and what vole has instead\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| Rust | vole |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `String`, `&str` | the same (0.20): `str` (UTF-8 text, a view; `&str` is `str`) and `String` (owned, `String::new_in(gpa)`); bytes are `[u8]`; `c\"text\"` is a NUL-terminated `*u8` for C |\n");
    buf_bytes(out, b"| `x: &T`, `x: &mut T`, `x: T` | conventions (0.20): `x: T` (let: read; called `f(v)`), `x: inout T` (called `f(&v)`), `x: sink T` (taken; an owned argument moves); no lifetimes; `*T` is the raw pointer: dereferencing it needs `unsafe`; no `Box` (`guide rust`: the whole mapping) |\n");
    buf_bytes(out, b"| `fn f(&self)`, `fn f(&mut self)`, `fn f(self)` | `fn f(self)`, `fn f(inout self)`, `fn f(sink self)` |\n");
    buf_bytes(out, b"| `let mut x`, `move \\|\\|` | `var x`, `sink \\|\\|`; `inout r = &x;` keeps an access, used as `x` itself (no `*r`) |\n");
    buf_bytes(out, b"| `use m::*;` | not allowed: `use m::{a, b};`, or the path `m::a` |\n");
    buf_bytes(out, b"| `println!(\"{}\", x)`, `format!` | no macros: `println(\"x = {x:>4} {:?}\", v)`, `format_in(\"..\", args, gpa)` (a `String`) (`guide formatting`) |\n");
    buf_bytes(out, b"| `Vec::new()`, a global allocator | `Vec::new_in(gpa)`: nothing allocates without an allocator; `gpa` comes from `fn main(gpa: Gpa)`, passed down as a parameter (0.16, `guide allocators`) |\n");
    buf_bytes(out, b"| `Box<T>`, arenas | a `Vec`; `arena_scope(gpa, \\|a\\| ..)` frees all it allocated at its end; `--check-alloc` traps a use after free |\n");
    buf_bytes(out, b"| `const fn`, purity | `#[pure]`, `#[no_alloc]`: checked declarations; `volec query effects f` (0.16, `guide effects`) |\n");
    buf_bytes(out, b"| `v[i]` on a `Vec` | the same (0.17): `v[i]`, `v[i] = x`, `v[a..b]` index its slice, checked, also through an access (`v: inout Vec<i64, Gpa>`); `v.get(i)`, `v.set(i, x)` too |\n");
    buf_bytes(out, b"| closures, `.iter().map()` | the same (0.14): `v.iter().map(\\|x\\| x * k).sum()`; `F: Fn(i64) -> i64` bounds; no `dyn Fn`, `iter_mut` (`guide closures`, `guide iterators`) |\n");
    buf_bytes(out, b"| `x?` | the same on `Option` and `Result` (0.15); `impl From<E> for F` converts the error; `main` may return `Result<(), E>` (`guide conversions`) |\n");
    buf_bytes(out, b"| `impl Trait for T`, `T: Trait` | the same; `type Item;` associated types (0.14); `#[derive(Eq, Ord, Hash, Debug, Clone)]` (0.15); no `dyn`, supertraits; `where` (0.26.2) |\n");
    buf_bytes(out, b"| `Drop`, RAII | the same (0.17): values are dropped at the end of their scope; `impl Drop for T`, `drop(x)`, `std::forget(x)`; no `free` calls (`guide memory`) |\n");
    buf_bytes(out, b"| `!x` on integers | `~x`; `!` is for `bool` only |\n");
    buf_bytes(out, b"| `i64::MAX`, `x.abs()`, `x.pow(2)` | `i64::MAX`, `u8::MIN` the same (0.15); floats have Rust's methods (`x.sqrt()`, `x.powi(2)`, `f64::consts::PI`: `guide math`, 0.25.2.1), integers `abs`, `signum`, `min`, `max`, `clamp`, `pow` (0.25.2.2) |\n");
    buf_bytes(out, b"| overflow panics, `/ 0` panics | integers wrap; `x / 0 == 0`, `x % 0 == x`; no panic |\n");
    buf_bytes(out, b"| `match s { \"add\" => ... }` | strings are not patterns: `if s == \"add\" { ... }` |\n");
    buf_bytes(out, b"| `char` | none: `'a'` is a `u8` (one ASCII byte) |\n");
    buf_bytes(out, b"| no default or named arguments | `fn f(a: i64, b: i64 = 2)`, `f(1, b: 3)` (0.15): named ones last, in order |\n");
    buf_bytes(out, b"| `usize`, implicit `i32` -> `i64` | lengths and indices are `usize` (0.26.2); lossless widening (0.15), `a as i32` narrows |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The prelude, in every module without `use`: `Option`, `Some`, `None`,\n");
    buf_bytes(out, b"`Result`, `Ok`, `Err`, `Vec`, `print`, `println`, `eprint`, `eprintln`,\n");
    buf_bytes(out, b"`format_in`, `Gpa`, `Arena`, `ScopedArena`, `arena_scope`, and the traits\n");
    buf_bytes(out, b"`Add`, `Sub`, `Mul`, `Div`, `Neg`, `Eq`, `Ord`, `Hash`, `Display`, `Debug`,\n");
    buf_bytes(out, b"`Clone`, `From`, `Into`, `Allocator`. The rest of std is used by path\n");
    buf_bytes(out, b"(`std::print_int(n)`) or imported (`use std::{HashMap, is_digit};`).\n");
    buf_bytes(out, b"Calling C or an `unsafe fn`, and dereferencing or indexing a raw\n");
    buf_bytes(out, b"pointer, are allowed only in `unsafe { }` (`volec guide rust`: the\n");
    buf_bytes(out, b"full list).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Values and types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let a = 42;               // i64: an integer literal is i64 unless the context says\n");
    buf_bytes(out, b"let b: u8 = 255;          // i8 i16 i32 i64 u8 u16 u32 u64 isize usize\n");
    buf_bytes(out, b"let c = 3u32;             // suffixes; 1_000, 0xff, 0b1010\n");
    buf_bytes(out, b"let d = 2.5;              // f64; 2.5f32 is f32\n");
    buf_bytes(out, b"let e = 'A';              // u8: a byte, ASCII only\n");
    buf_bytes(out, b"let f = true;             // bool\n");
    buf_bytes(out, b"let s = \"bytes\";          // [u8]: s.len() (an i64), s[0], s[1..3]\n");
    buf_bytes(out, b"let p = c\"for C\";         // *u8, NUL-terminated\n");
    buf_bytes(out, b"let t = (1, \"two\");       // a tuple: t.0, t.1\n");
    buf_bytes(out, b"let arr = [0; 8];         // [i64; 8]; also [1, 2, 3]; arr[i] is checked\n");
    buf_bytes(out, b"var n = a as i32;         // `as` converts numbers; nothing converts implicitly\n");
    buf_bytes(out, b"n += c as i32 + b as i32 + e as i32;\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`let` bindings are immutable, `var` ones mutable. Shadowing (`let x =\n");
    buf_bytes(out, b"x + 1;`) is allowed. `const N: i64 = 10;` and `static var COUNT: i64 = 0;`\n");
    buf_bytes(out, b"are items (statics are safe to use; with threads, a `static var` is for\n");
    buf_bytes(out, b"one thread: `guide threads`). Integers wrap, `x / 0 ==\n");
    buf_bytes(out, b"0`, `x % 0 == x`; indexing, slicing, `unwrap` and casts to enums are\n");
    buf_bytes(out, b"checked (a message, exit 101): `guide types`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Functions and control flow\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn classify(n: i64) -> [u8] {\n");
    buf_bytes(out, b"    if n < 0 { \"negative\" } else if n == 0 { \"zero\" } else { \"positive\" }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn greet(name: [u8], times: i64 = 1, sep: [u8] = \" \") {   // defaults (0.15)\n");
    buf_bytes(out, b"    for _ in 0..times { print(\"hi {name}{sep}\"); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var total = 0;\n");
    buf_bytes(out, b"    for i in 0..10 {              // 0..10 and 0..=9: ranges exist only in `for`\n");
    buf_bytes(out, b"        if i % 2 == 0 { continue; }\n");
    buf_bytes(out, b"        total += i;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    var k = 0;\n");
    buf_bytes(out, b"    while k < 3 { k += 1; }\n");
    buf_bytes(out, b"    let found = loop {            // loop's value comes from `break value`\n");
    buf_bytes(out, b"        k += 1;\n");
    buf_bytes(out, b"        if k * k > 50 { break k; }\n");
    buf_bytes(out, b"    };\n");
    buf_bytes(out, b"    outer: for i in 0..5 {        // a label: `name:`, then `break :name`\n");
    buf_bytes(out, b"        for j in 0..5 {\n");
    buf_bytes(out, b"            if i * j == 6 { break :outer; }\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    greet(\"ann\");\n");
    buf_bytes(out, b"    greet(\"bob\", times: 2, sep: \"! \");    // named arguments: last, in order\n");
    buf_bytes(out, b"    println(classify(total - found));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"hi ann hi bob! hi bob! positive\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The last expression of a block, without `;`, is its value; `if`, `match`,\n");
    buf_bytes(out, b"`loop` and blocks are expressions. There are no nested functions.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Parameters: let, inout, sink\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Account<A: Allocator> { balance: i64, log: Vec<i64, A> }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn transfer(from: inout Account<Gpa>, to: inout Account<Gpa>, amount: i64) -> bool {\n");
    buf_bytes(out, b"    if from.balance < amount { return false; }\n");
    buf_bytes(out, b"    from.balance -= amount;\n");
    buf_bytes(out, b"    to.balance += amount;\n");
    buf_bytes(out, b"    from.log.push(-amount);\n");
    buf_bytes(out, b"    to.log.push(amount);\n");
    buf_bytes(out, b"    true\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn report(a: Account<Gpa>, out: inout i64) { out += a.balance; } // an access is its value\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn keep(all: inout Vec<Account<Gpa>, Gpa>, a: sink Account<Gpa>) { all.push(a); }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    var a = Account { balance: 100, log: Vec::new_in(gpa) };\n");
    buf_bytes(out, b"    var b = Account { balance: 5, log: Vec::new_in(gpa) };\n");
    buf_bytes(out, b"    transfer(&a, &b, 30);                 // the call shows what changes\n");
    buf_bytes(out, b"    var sum = 0;\n");
    buf_bytes(out, b"    report(a, &sum);\n");
    buf_bytes(out, b"    report(b, &sum);\n");
    buf_bytes(out, b"    var all: Vec<Account<Gpa>, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    keep(&all, a);                        // a moves: dead from here\n");
    buf_bytes(out, b"    println(\"{sum} {} {}\", all[0].log.len(), b.balance);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"105 1 35\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `let` (nothing written) reads: a plain value (`i64`, `Point`) is\n");
    buf_bytes(out, b"  copied, an owned one (`Vec`, a struct with one) is borrowed for the\n");
    buf_bytes(out, b"  call, so the caller keeps it. `inout` changes the caller's place,\n");
    buf_bytes(out, b"  exclusively: `transfer(&a, &a, 1)` is `own.conflict`. `sink` takes the\n");
    buf_bytes(out, b"  value: the callee owns it, may change it, and drops it.\n");
    buf_bytes(out, b"- Inside the function every parameter is used as the value: `out +=\n");
    buf_bytes(out, b"  a.balance`, `from.log.push(x)`; there is no `*`.\n");
    buf_bytes(out, b"- `inout r = &a;` is a local access to `a`, passed on as `f(&r)`; `let`\n");
    buf_bytes(out, b"  and `var` locals own their value (`guide memory`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Structs, enums, match, methods\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"enum Shape { Circle(Point, i64), Rect { min: Point, max: Point }, Empty }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Point {\n");
    buf_bytes(out, b"    fn new(x: i64, y: i64) -> Point { Point { x: x, y: y } }   // Point::new(1, 2)\n");
    buf_bytes(out, b"    fn shift(inout self, dx: i64) { self.x += dx; }             // writes through self\n");
    buf_bytes(out, b"    fn sum(self) -> i64 { self.x + self.y }                     // a copy\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn area(s: Shape) -> i64 {\n");
    buf_bytes(out, b"    match s {\n");
    buf_bytes(out, b"        Shape::Circle(_, r) => 3 * r * r,\n");
    buf_bytes(out, b"        Shape::Rect { min, max } => (max.x - min.x) * (max.y - min.y),\n");
    buf_bytes(out, b"        Shape::Empty => 0,\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var p = Point::new(1, 2);\n");
    buf_bytes(out, b"    p.shift(10);                          // lends p inout: p is a var\n");
    buf_bytes(out, b"    let shapes = [Shape::Rect { min: Point::new(0, 0), max: p }, Shape::Circle(p, 2),\n");
    buf_bytes(out, b"        Shape::Empty];\n");
    buf_bytes(out, b"    for s in shapes {\n");
    buf_bytes(out, b"        std::print_int(area(s));\n");
    buf_bytes(out, b"        print(\" \");\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    std::print_int(p.sum());\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    let o: Option<i64> = Some(7);\n");
    buf_bytes(out, b"    if let Some(v) = o { std::print_int(v); }\n");
    buf_bytes(out, b"    match 15 {\n");
    buf_bytes(out, b"        0 => println(\" zero\"),\n");
    buf_bytes(out, b"        1..=9 => println(\" digit\"),\n");
    buf_bytes(out, b"        n if n % 5 == 0 => println(\" fives\"),\n");
    buf_bytes(out, b"        _ => println(\" other\"),\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"22 12 0 13\n");
    buf_bytes(out, b"7 fives\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A variant's fields are by position (`Circle(Point, i64)`) or by name\n");
    buf_bytes(out, b"(`Rect { min: Point, max: Point }`, 0.17: made as `Shape::Rect { min: a,\n");
    buf_bytes(out, b"max }` in any order, matched as `Shape::Rect { min, .. }`; a variant's\n");
    buf_bytes(out, b"fields are read only through patterns, as in Rust). A match must cover\n");
    buf_bytes(out, b"every value; arms can have `|`, ranges `a..=b` and guards `if`. `use Shape::{Circle, Empty};` lets variants be written\n");
    buf_bytes(out, b"without `Shape::`. `==` compares structs, enums, tuples and arrays field\n");
    buf_bytes(out, b"by field; `[u8]` compares by bytes, a `Vec` or `HashMap` by contents.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Generics and traits\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"trait Area {\n");
    buf_bytes(out, b"    fn area(self) -> i64;\n");
    buf_bytes(out, b"    fn twice(self) -> i64 { 2 * self.area() }          // a default method\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Square { side: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Area for Square {\n");
    buf_bytes(out, b"    fn area(self) -> i64 { self.side * self.side }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total<T: Area>(items: [T]) -> i64 {    // bounds: T: A + B\n");
    buf_bytes(out, b"    items.iter().map(|it| it.area()).sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Pair<T> { a: T, b: T }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl<T: Ord> Pair<T> {\n");
    buf_bytes(out, b"    fn max(self) -> T { if self.a > self.b { self.a } else { self.b } }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let squares = [Square { side: 2 }, Square { side: 3 }];\n");
    buf_bytes(out, b"    let p = Pair::<i64> { a: 3, b: 9 };   // the turbofish: Pair::<i64>\n");
    buf_bytes(out, b"    println(\"{} {} {}\", total(squares[..]), squares[0].twice(), p.max()); // a[..]: a slice\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"13 8 9\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Generics are templates, checked per instantiation (`max::<i64>(a, b)`\n");
    buf_bytes(out, b"is the turbofish). Operators go through the prelude's traits: `impl Add\n");
    buf_bytes(out, b"for V` makes `a + b` work; `Ord`'s `cmp` gives `<`. There are no trait\n");
    buf_bytes(out, b"objects: dispatch is static.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Modules and imports\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`mod geometry;` loads geometry.vl (or `mod geometry { ... }` inline);\n");
    buf_bytes(out, b"`use geometry::{Rect, area};` imports by name, never `*`. Paths start\n");
    buf_bytes(out, b"with a name in scope, `crate`, `self`, `super` or `std`. Items are\n");
    buf_bytes(out, b"private (to their module and its children) unless `pub`, and so are a\n");
    buf_bytes(out, b"struct's fields (0.26: `pub w: i64` to show one); `pub use`\n");
    buf_bytes(out, b"re-exports. A missing import's error says which `use` line to add, and\n");
    buf_bytes(out, b"`volec fix` adds it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Slices, arrays, text\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn sum(xs: [i64]) -> i64 {\n");
    buf_bytes(out, b"    var t = 0;\n");
    buf_bytes(out, b"    for i in 0..xs.len() { t += xs[i]; }    // indices are usize; checked\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var a = [5, 1, 4];\n");
    buf_bytes(out, b"    a[1] = 2;\n");
    buf_bytes(out, b"    std::print_int(sum(a[..]) + sum(a[1..]));   // a[lo..hi], a[..hi], a[lo..]\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    let s = \"hello world\";\n");
    buf_bytes(out, b"    println(s[6..]);\n");
    buf_bytes(out, b"    if s[0..5] == \"hello\" { println(\"starts with hello\"); }\n");
    buf_bytes(out, b"    let words = [0; 4];\n");
    buf_bytes(out, b"    std::print_int(words[4]);             // out of bounds: a message, exit 101\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out (exit 101)\n");
    buf_bytes(out, b"17\n");
    buf_bytes(out, b"world\n");
    buf_bytes(out, b"starts with hello\n");
    buf_bytes(out, b"main.vl:16:20: index out of bounds: index 4, length 4\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An array `[T; N]` is a value (copied by `=`; `a.len()` is N); a slice\n");
    buf_bytes(out, b"`[T]` is a pointer and a length (`.len()`; `.ptr` for C) viewing an\n");
    buf_bytes(out, b"array, a `Vec` or memory. A `[T]` is read-only; `inout [T]`\n");
    buf_bytes(out, b"(`&a[..]`, `v.as_mut_slice()`) writes its elements.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## std: Vec, HashMap, String; allocation\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn evens(n: i64, gpa: Gpa) -> Vec<i64, Gpa> { // it allocates: it takes an allocator\n");
    buf_bytes(out, b"    (0..n).map(|i| i * 2).collect_in(gpa)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {                 // the program's allocator\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa); // dropped (freed) when main returns\n");
    buf_bytes(out, b"    v.push(30);\n");
    buf_bytes(out, b"    v.push(10);\n");
    buf_bytes(out, b"    v.push(20);\n");
    buf_bytes(out, b"    sort(v.as_mut_slice());                // in place\n");
    buf_bytes(out, b"    v.set(0, v.get(0) + 1);                // get/set are checked\n");
    buf_bytes(out, b"    for x in v { std::print_int(x); print(\" \"); }   // also &v, v.iter()\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    let last = v.pop();                    // Option<i64>\n");
    buf_bytes(out, b"    std::print_int(last.unwrap_or(-1));\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    var m: HashMap<[u8], i64, Gpa> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"    m.insert(\"a\", 1);\n");
    buf_bytes(out, b"    m.insert(\"b\", 2);\n");
    buf_bytes(out, b"    match m.get(\"a\") { Some(x) => std::print_int(x), None => print(\"none\") }\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    for (k, _) in m.iter() { print(k); }   // (K, V) pairs, in slot order\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    var b = String::new_in(gpa);           // text builder\n");
    buf_bytes(out, b"    let e = evens(4, gpa);\n");
    buf_bytes(out, b"    b.push_str(\"n=\");\n");
    buf_bytes(out, b"    b.push_fmt(m.len() as i64 + e.len() as i64);\n");
    buf_bytes(out, b"    b.push_str(\"!\");\n");
    buf_bytes(out, b"    println(b.as_slice());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"11 20 30\n");
    buf_bytes(out, b"30\n");
    buf_bytes(out, b"1\n");
    buf_bytes(out, b"ba\n");
    buf_bytes(out, b"n=6!\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Allocation is explicit (0.16): nothing allocates without an allocator.\n");
    buf_bytes(out, b"A function that allocates takes one, `gpa: Gpa` or `a: A` with `A:\n");
    buf_bytes(out, b"Allocator`, or a container it was given (`push` uses the Vec's own);\n");
    buf_bytes(out, b"main's `gpa` is where they come from. `arena_scope(gpa, |a| ...)` hands out\n");
    buf_bytes(out, b"an arena whose memory is all freed when the closure returns.\n");
    buf_bytes(out, b"`--check-alloc` builds the program with a checking allocator: a use\n");
    buf_bytes(out, b"after free, a double free, a leak are reported where they happen.\n");
    buf_bytes(out, b"`volec fix --only alloc016` moves 0.15 code (`Vec::new()`) over.\n");
    buf_bytes(out, b"Every function's effects are inferred (`alloc(Gpa) io panic\n");
    buf_bytes(out, b"diverge unsafe`): `volec query effects f --why io` shows where;\n");
    buf_bytes(out, b"`#[pure]` or `#[no_alloc]` on a function is checked (`guide effects`,\n");
    buf_bytes(out, b"`guide allocators`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`Vec`, `Buf` and `HashMap` own their contents: `let w = v;` or passing\n");
    buf_bytes(out, b"one to a `sink` parameter moves it (`.clone()` copies). Pass `v` to a\n");
    buf_bytes(out, b"`v: Vec<T, A>` (let) parameter to read it, `&v` to a `v: inout Vec<T, A>` one\n");
    buf_bytes(out, b"to let a function push. A slice from `as_slice` views the vector: using it after the\n");
    buf_bytes(out, b"vector grew or was dropped is an error (`guide views`). std's API,\n");
    buf_bytes(out, b"made from its source in this compiler, a\n");
    buf_bytes(out, b"line per item: `volec guide std#the-api`; each item with its comment:\n");
    buf_bytes(out, b"`volec guide std#every-item`; one name: `volec guide --find NAME`.\n");
    buf_bytes(out, b"@STD-API-FULL@\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A priority queue is a `BinaryHeap` (the largest first) or a `MinHeap`\n");
    buf_bytes(out, b"(the smallest first; Rust's `BinaryHeap<Reverse<T>>`), both in the\n");
    buf_bytes(out, b"prelude (`guide std#heaps-priority-queues`). Dijkstra's shortest paths\n");
    buf_bytes(out, b"with a MinHeap of (distance, node) pairs:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"// Dijkstra: the shortest distances from node 0.\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let n = 5;\n");
    buf_bytes(out, b"    var adj: Vec<Vec<(i64, i64), Gpa>, Gpa> = Vec::new_in(gpa); // adj[u]: (to, weight)\n");
    buf_bytes(out, b"    for _ in 0..n {\n");
    buf_bytes(out, b"        adj.push(Vec::new_in(gpa));\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    for (u, v, w) in [(0, 1, 4), (0, 2, 1), (2, 1, 2), (1, 3, 1), (2, 3, 5)] {\n");
    buf_bytes(out, b"        adj[u].push((v, w));\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    var dist: Vec<i64, Gpa> = Vec::filled_in(n as usize, i64::MAX, gpa);\n");
    buf_bytes(out, b"    var heap: MinHeap<(i64, i64), Gpa> = MinHeap::new_in(gpa); // (distance, node)\n");
    buf_bytes(out, b"    dist[0] = 0;\n");
    buf_bytes(out, b"    heap.push((0, 0));\n");
    buf_bytes(out, b"    while let Some((d, u)) = heap.pop() {      // the nearest first\n");
    buf_bytes(out, b"        if d > dist[u] {\n");
    buf_bytes(out, b"            continue;                          // stale: u was reached sooner\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        for (v, w) in adj[u].iter() {\n");
    buf_bytes(out, b"            if d + w < dist[v] {\n");
    buf_bytes(out, b"                dist[v] = d + w;\n");
    buf_bytes(out, b"                heap.push((d + w, v));\n");
    buf_bytes(out, b"            }\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"{} {} {} {}\", dist[1], dist[2], dist[3], dist[4] == i64::MAX);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3 1 4 true\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Input, output, arguments\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"std prints and reads stdin: `read_stdin_in(gpa)` (all of it, a\n");
    buf_bytes(out, b"`Result<Vec<u8, Gpa>, IoError>`), `read_line(&buf)` (the next line, without its\n");
    buf_bytes(out, b"`'\\n'`; `Ok(false)` at the end), `Scanner` (tokens, numbers, lines of a\n");
    buf_bytes(out, b"text), `parse_int` (a `Result`), `split_in`, `trim` (`guide conversions`:\n");
    buf_bytes(out, b"Option means absent, Result failed). Files go through C (`fopen`):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"import \"string.h\" as c;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(argc: i32, argv: **u8, gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let input = read_stdin_in(gpa).unwrap(); // all of stdin, a Vec<u8, Gpa>\n");
    buf_bytes(out, b"    var sc = Scanner::new(input.as_slice());\n");
    buf_bytes(out, b"    var total = 0;\n");
    buf_bytes(out, b"    while let Ok(n) = sc.next_int() {     // Err(ScanError::End) at the end\n");
    buf_bytes(out, b"        total += n;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(total);\n");
    buf_bytes(out, b"    for k in 1..argc as i64 {             // argv[0] is the program; C strings\n");
    buf_bytes(out, b"        println(unsafe { argv[k][0..c::strlen(argv[k]) as i64] });\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```in\n");
    buf_bytes(out, b"12\n");
    buf_bytes(out, b"30\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"42\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## unsafe and C\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"import \"stdio.h\" as c;                   // a C header, its names under c::\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"extern \"C\" {                              // or declare C functions yourself\n");
    buf_bytes(out, b"    fn abs(x: i32) -> i32;\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    unsafe { c::printf(c\"%.1f %d\\n\", 2.5 * 2.0, abs(-3)); }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"5.0 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Unsafe operations: calling C or an `unsafe fn`, dereferencing (`*p`,\n");
    buf_bytes(out, b"`p.f`) or indexing (`p[i]`) a raw pointer, reading a union field. An\n");
    buf_bytes(out, b"access (a let or inout parameter, an `inout` local, a `let T` / `inout\n");
    buf_bytes(out, b"T` field) is safe to read and write through wherever it is kept; every\n");
    buf_bytes(out, b"`*T` is raw, a parameter too (`fix --values` makes a parameter an\n");
    buf_bytes(out, b"access).\n");
    buf_bytes(out, b"`volec fix --only unsafe` wraps what needs it; `#[repr(C)]`, callbacks\n");
    buf_bytes(out, b"and linking: `guide c-interop`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Errors you will meet first\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| error (short form) | fix |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `unknown type 'char'` (or `Box`) | `u8` (or a `u32` code point), `*T` or `Vec<T, A>` |\n");
    buf_bytes(out, b"| `expected type, got '&'`; `expected identifier, got '&'` | `str` for `&str`; `self`, `inout self` or `sink self` for `&self`, `&mut self`, `self` |\n");
    buf_bytes(out, b"| `conv.rust: '&mut T' is Rust's spelling` (`let mut`, `&mut x`, `move`) | the `try:` line's form: `inout T`, `var`, `&x`, `sink`; `volec fix --suggested` |\n");
    buf_bytes(out, b"| `conv.marker: 'v' is lent inout here` | `f(&v)`: an inout argument is marked |\n");
    buf_bytes(out, b"| `conv.marker_extra: '&' marks an argument the callee may change` | `f(v)`: a let or sink argument is not |\n");
    buf_bytes(out, b"| `own.readonly: writes through 'v' ... read-only (let)` | take it `v: inout T`, called `f(&v)` |\n");
    buf_bytes(out, b"| `own.readonly: '&n' changes 'n', a let binding` (or `v.push(x)`) | `var n`; a parameter `x: inout T`; `inout self`; `static var` |\n");
    buf_bytes(out, b"| `cannot infer the type of closure parameter 'x'` | `\\|x: i64\\| ...`, or pass it where an `Fn` bound or `fn` type gives it |\n");
    buf_bytes(out, b"| `'?' needs 'f' to return Option or Result` | `fn f(..) -> Option<T>` or `-> Result<T, E>` |\n");
    buf_bytes(out, b"| `'println!' is a macro call` | no macros: `println(\"{}\", x)` |\n");
    buf_bytes(out, b"| `cannot assign to immutable variable 'x'` | `var x` |\n");
    buf_bytes(out, b"| `cannot index type 'HashMap<K, V, A>'` | `m.get(k)` (an Option), `m.insert(k, v)` |\n");
    buf_bytes(out, b"| `allocation is explicit: pass an allocator (try: Vec::new_in(gpa))` | `fn main(gpa: Gpa)`, `gpa` passed down; `volec fix --only alloc016` |\n");
    buf_bytes(out, b"| `'for' iterates over ... got 'i64'` | a range: `for x in 0..n`; a Vec, a HashMap, `v.iter()` and ranges as values iterate too (0.14) |\n");
    buf_bytes(out, b"| `expected '[i64]', got '[i64; 3]'` | pass `a[..]` |\n");
    buf_bytes(out, b"| `expected 'i32', got 'i64'` | `x as i32`: only widening is implicit |\n");
    buf_bytes(out, b"| `non-exhaustive match: 'E::C' is not covered` | an arm, or `_ =>` |\n");
    buf_bytes(out, b"| `error[unsafe] calling a C function is unsafe` | `unsafe { ... }` |\n");
    buf_bytes(out, b"| `undefined variable 'helper' \\| help: add 'use ...'` | add the `use` line the help names |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec guide errors` has more, each with its fix.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Tools: read and change code through the compiler\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec check [ROOT]                   # all errors, one line each: FILE:L:C: error[KIND] MSG | help: ...\n");
    buf_bytes(out, b"volec f.vl -o f                    # the same lines when compiling, off a terminal\n");
    buf_bytes(out, b"volec query show NAME                # an item's source: fn, Type::method, Enum::Variant, FILE:LINE\n");
    buf_bytes(out, b"volec query def NAME                 # where it is defined, its signature\n");
    buf_bytes(out, b"volec query refs NAME                # every resolved use (--count, --in FILE)\n");
    buf_bytes(out, b"volec query items [MODULE]           # a module's items with signatures (std: its API)\n");
    buf_bytes(out, b"volec query context NAME             # source, what it calls, its types and callers, at once\n");
    buf_bytes(out, b"volec query effects NAME             # what it may do: alloc(Gpa) io panic diverge unsafe\n");
    buf_bytes(out, b"volec try '7 / 2'                    # run a snippet with std: its output, TYPE = VALUE\n");
    buf_bytes(out, b"volec edit patch NAME --old 'a < b' --new 'a <= b'   # change text inside one item\n");
    buf_bytes(out, b"volec edit replace NAME < new.vl   # replace an item; edit insert --after NAME; edit delete NAME\n");
    buf_bytes(out, b"volec fix                            # missing imports, unused, pub, unsafe blocks\n");
    buf_bytes(out, b"volec undo                           # take the last edit back\n");
    buf_bytes(out, b"volec refactor rename main::x total  # a local (or FILE:LINE:COL), an item, a field, with every use\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"They pay off on renames, moves, signature changes, errors across files\n");
    buf_bytes(out, b"and large code; a small file is cheaper read whole (`query show\n");
    buf_bytes(out, b"FILE.vl`). ROOT is `--root FILE`, a last argument ending in `.vl`,\n");
    buf_bytes(out, b"or `./main.vl`. Every edit is checked first: one that adds an error\n");
    buf_bytes(out, b"writes nothing. A problem is one line, `error CODE: message`, then\n");
    buf_bytes(out, b"`try:` lines to run as they are (`guide tools`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Topics\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec guide TOPIC` prints one; `volec guide --list` gives their\n");
    buf_bytes(out, b"sizes; `volec guide --all` prints everything.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"@TOPICS@\n");
}
