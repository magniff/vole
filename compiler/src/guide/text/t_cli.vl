use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Command lines: std::cli (0.24)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::cli` parses a program's arguments: clap's builder, without derive.\n");
    buf_bytes(out, "A `Command` lists flags, options and positionals (and subcommands);\n");
    buf_bytes(out, "`parse` gives `Matches` or a `CliError`. `--help`, `-h` and (with a\n");
    buf_bytes(out, "version) `--version`, `-V` are built in. The design: docs/design/cli.md.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "use std::cli::{Arg, Command};\n");
    buf_bytes(out, "use std::env;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let cmd = Command::new_in(\"grep\", gpa).version(\"1.0\").about(\"find lines\")\n");
    buf_bytes(out, "        .arg(Arg::flag(\"count\").short('c').help(\"print how many\"))\n");
    buf_bytes(out, "        .arg(Arg::option(\"max\").short('m').value_name(\"N\").default(\"0\"))\n");
    buf_bytes(out, "        .arg(Arg::positional(\"pattern\").required())\n");
    buf_bytes(out, "        .arg(Arg::positional(\"file\").multiple());\n");
    buf_bytes(out, "    let m = cmd.parse_or_exit(env::args());    // an error: printed, exit 2\n");
    buf_bytes(out, "    let max = match m.get_as::<i64>(\"max\") { Ok(n) => n, Err(e) => cmd.exit(e) };\n");
    buf_bytes(out, "    for f in m.values(\"file\") { .. }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Parsing and Matches\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`cmd.parse(args)` takes any iterator of `str`, the program's name first\n");
    buf_bytes(out, "(`env::args()`, `line.split(' ')`, `v.iter()`); `parse_in(args, a)`\n");
    buf_bytes(out, "puts the Matches on allocator `a` (an arena). Accepted: `-v`, `-vvv`,\n");
    buf_bytes(out, "clusters `-vq`, `-ofile`, `-o file`, `-o=file`, `--out file`,\n");
    buf_bytes(out, "`--out=file`, `--` (the rest is positional), `-` (a positional). An\n");
    buf_bytes(out, "option takes the next argument even when it starts with `-` (`-n -5`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::cli::{Arg, Command};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let cmd = Command::new_in(\"tool\", gpa)\n");
    buf_bytes(out, "        .arg(Arg::flag(\"verbose\").short('v'))\n");
    buf_bytes(out, "        .arg(Arg::option(\"out\").short('o').default(\"-\"))\n");
    buf_bytes(out, "        .arg(Arg::option(\"jobs\").short('j').default(\"1\"))\n");
    buf_bytes(out, "        .arg(Arg::positional(\"file\").multiple())\n");
    buf_bytes(out, "        .subcommand(Command::new_in(\"push\", gpa).arg(Arg::flag(\"force\").short('f')));\n");
    buf_bytes(out, "    let m = cmd.parse(\"tool -vv -ofile a b\".split(' ')).unwrap();\n");
    buf_bytes(out, "    let jobs = m.get_as::<i64>(\"jobs\").unwrap();\n");
    buf_bytes(out, "    println(f\"{m.count(\"verbose\")} {m.get(\"out\").unwrap()} {jobs} {m.values(\"file\").len()}\");\n");
    buf_bytes(out, "    let p = cmd.parse(\"tool -j 4 push -f\".split(' ')).unwrap();\n");
    buf_bytes(out, "    match p.subcommand() {\n");
    buf_bytes(out, "        Some((name, sub)) => println(f\"{name} {sub.flag(\"force\")}\"),\n");
    buf_bytes(out, "        None => println(\"none\"),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    match cmd.parse(\"tool --outt x\".split(' ')) {\n");
    buf_bytes(out, "        Ok(_) => println(\"ok\"),\n");
    buf_bytes(out, "        Err(e) => print(cmd.render_in(e, gpa).as_slice()),\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "2 file 1 2\n");
    buf_bytes(out, "push true\n");
    buf_bytes(out, "error: unknown option '--outt'\n");
    buf_bytes(out, "try: --out\n");
    buf_bytes(out, "usage: tool [options] [file]... [command]\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `m.flag(name)`: given (a default is not); `m.count(name)`: how many\n");
    buf_bytes(out, "  times; `m.get(name)`: the last value or the default, an\n");
    buf_bytes(out, "  `Option<str>`; `m.values(name)`: every value, a `[str]`;\n");
    buf_bytes(out, "  `m.get_as::<T>(name)`: parsed (`FromStr`), `Err(CliError)` naming the\n");
    buf_bytes(out, "  argument; `m.subcommand()`: `Option<(str, Matches)>`;\n");
    buf_bytes(out, "  `m.indices_of(name)` (0.25): each value's (or flag's) index among the\n");
    buf_bytes(out, "  arguments, for the order of different options (`-l m x.o -l z`). A\n");
    buf_bytes(out, "  name that is no Arg of that command panics.\n");
    buf_bytes(out, "- An Arg: `.short('x')`, `.long(\"s\")` (its name by default),\n");
    buf_bytes(out, "  `.help(..)`, `.value_name(\"FILE\")` (a positional's too, 0.25),\n");
    buf_bytes(out, "  `.default(..)`, `.required()`, `.multiple()` (a positional taking the\n");
    buf_bytes(out, "  rest), `.choices(\"fast|slow\")` (0.25: another value is an error,\n");
    buf_bytes(out, "  `try: --mode <fast|slow>`). Options may repeat.\n");
    buf_bytes(out, "- (0.25) `Command::new_in(name, a)` takes any allocator, an arena too\n");
    buf_bytes(out, "  (`arena_scope(gpa, |a| ..)`: nothing on the Gpa). A program's own\n");
    buf_bytes(out, "  check fails in std::cli's form: `cmd.exit(CliError::custom(\"-b and -t\n");
    buf_bytes(out, "  together\", \"-b\"))`; `e.letter()`: the unknown letter of a cluster.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Subcommands, aliases, values (0.25.2)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::cli::{Arg, Command};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let cmd = Command::new_in(\"vc\", gpa).subcommand_required()\n");
    buf_bytes(out, "        .arg(Arg::option(\"root\").short('R').global())\n");
    buf_bytes(out, "        .arg(Arg::option(\"color\").alias(\"colour\").hide())\n");
    buf_bytes(out, "        .arg(Arg::option(\"stats\").default_missing(\"all\"))\n");
    buf_bytes(out, "        .arg(Arg::option(\"overlay\").num_values(2).value_name(\"PATH COPY\"))\n");
    buf_bytes(out, "        .subcommand(Command::new_in(\"remove\", gpa).alias(\"rm\")\n");
    buf_bytes(out, "            .arg(Arg::flag(\"binary\").short('b').conflicts_with(\"text\"))\n");
    buf_bytes(out, "            .arg(Arg::flag(\"text\").short('t'))\n");
    buf_bytes(out, "            .arg(Arg::positional(\"expr\").multiple().allow_hyphen_values())\n");
    buf_bytes(out, "            .arg(Arg::positional(\"args\").multiple().last()));\n");
    buf_bytes(out, "    let m = cmd.parse(\"vc --stats --overlay a b rm -R d -x -- -y\".split(' ')).unwrap();\n");
    buf_bytes(out, "    let (name, sub) = m.subcommand().unwrap();\n");
    buf_bytes(out, "    println(f\"{name} {m.get(\"stats\").unwrap()} {m.values(\"overlay\").len()} {sub.get(\"root\").unwrap()}\");\n");
    buf_bytes(out, "    println(f\"{sub.values(\"expr\")[0]} {sub.values(\"args\")[0]}\");\n");
    buf_bytes(out, "    let lines: [str; 2] = [\"vc\", \"vc rm -b -t\"];\n");
    buf_bytes(out, "    for line in lines {\n");
    buf_bytes(out, "        match cmd.parse(line.split(' ')) {\n");
    buf_bytes(out, "            Ok(_) => println(\"ok\"),\n");
    buf_bytes(out, "            Err(e) => print(cmd.render_in(e, gpa).as_slice()),\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "remove all 2 d\n");
    buf_bytes(out, "-x -y\n");
    buf_bytes(out, "error: missing command for 'vc'\n");
    buf_bytes(out, "try: vc remove\n");
    buf_bytes(out, "usage: vc [options] <command>\n");
    buf_bytes(out, "error: '-t' cannot be used with '-b'\n");
    buf_bytes(out, "try: drop '-t' (or '-b')\n");
    buf_bytes(out, "usage: vc remove [options] [expr]... [-- args]...\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `.global()`: a flag or option of a command that its subcommands\n");
    buf_bytes(out, "  accept too, before or after their names (`vc -R d rm`, `vc rm -R d`);\n");
    buf_bytes(out, "  every level's Matches reads it.\n");
    buf_bytes(out, "- `.alias(s)`: another long name (an Arg) or name (a Command), called\n");
    buf_bytes(out, "  again for more; `.hide()`: accepted, not in the help (a deprecated\n");
    buf_bytes(out, "  spelling). The did-you-mean measures aliases, suggests the own name.\n");
    buf_bytes(out, "- `.num_values(n)`: n values each time (`--overlay PATH COPY`; fewer:\n");
    buf_bytes(out, "  a MissingValue error). `.default_missing(s)`: an optional value,\n");
    buf_bytes(out, "  `--stats` gives s, only `--stats=x` gives x.\n");
    buf_bytes(out, "- `.allow_hyphen_values()`: a positional takes a word starting with `-`\n");
    buf_bytes(out, "  that is no option (`grep '-> bool'`). `.last()`: a positional of the\n");
    buf_bytes(out, "  words after `--` (`probe F:L EXPR... -- ARGS...`).\n");
    buf_bytes(out, "- `.conflicts_with(name)`: both given is an ArgumentConflict error;\n");
    buf_bytes(out, "  `Command::subcommand_required()`: none given is MissingSubcommand\n");
    buf_bytes(out, "  (`try:` names the commands). Exit code 2, as every error.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Help and errors\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`cmd.exit(e)` prints a CliError and exits with `e.exit_code()`: the\n");
    buf_bytes(out, "help or version on stdout (0), else on stderr (2) the error, a `try:`\n");
    buf_bytes(out, "line (the nearest option or command by edit distance, or the fix) and\n");
    buf_bytes(out, "the usage line. `cmd.render_in(e, a)` and `cmd.help_in(a)` give that\n");
    buf_bytes(out, "text as a `Buf`; `.width(n)` wraps the help (80). Parsing does no io\n");
    buf_bytes(out, "(`query effects`): only `exit` and `parse_or_exit` print.\n");
}
