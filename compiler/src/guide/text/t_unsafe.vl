// Generated by compiler/guide/embed.sh from compiler/guide/unsafe.md (do
// not edit): the guide's topic 'unsafe'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# unsafe\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Safe code has no undefined behaviour: indexing is checked, every\n");
    buf_bytes(out, b"variable is initialized, references are checked by the borrow checker,\n");
    buf_bytes(out, b"and arithmetic that overflows or divides by zero panics (at -O0;\n");
    buf_bytes(out, b"overflow wraps at -O1 and above, as Rust's release builds). What can\n");
    buf_bytes(out, b"have undefined behaviour is an *unsafe operation*, allowed only inside\n");
    buf_bytes(out, b"`unsafe { ... }` (an expression: `let x = unsafe { *p };`) or in the body\n");
    buf_bytes(out, b"of an `unsafe fn`, as in Rust:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- calling a C function (an `extern \"C\"` declaration, an `extern \"C\" fn`\n");
    buf_bytes(out, b"  pointer) or an `unsafe fn`, `p.add(i)` and `std::slice::from_raw_parts`\n");
    buf_bytes(out, b"  among them;\n");
    buf_bytes(out, b"- dereferencing a raw pointer: `*p`, `(*p).f`, a method called through\n");
    buf_bytes(out, b"  `*p`;\n");
    buf_bytes(out, b"- reading or writing a `static mut` (error `unsafe`, rustc's E0133); a plain `static`\n");
    buf_bytes(out, b"  is safe to read;\n");
    buf_bytes(out, b"- reading a union's field.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`*const T` and `*mut T` are raw pointers: nothing checks what they point\n");
    buf_bytes(out, b"to. Making, passing, comparing and casting one is safe, an integer cast\n");
    buf_bytes(out, b"to a pointer too (`4096 as *const u8`); dereferencing it is not.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## References and raw pointers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`&T` and `&mut T` are checked by the compiler (`guide memory`, the\n");
    buf_bytes(out, b"borrow checker's rules), so using them is safe. A raw pointer is the\n");
    buf_bytes(out, b"escape hatch:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `&x as *const T` and `&mut x as *mut T` make one, and a `&mut x`\n");
    buf_bytes(out, b"  passed where a `*mut T` is wanted (a C function's parameter) converts\n");
    buf_bytes(out, b"  to it; `c\"...\"` is a `*const u8` to read-only memory, NUL-terminated.\n");
    buf_bytes(out, b"- In `unsafe` code `&*p` and `&mut *p` make a reference of the pointee:\n");
    buf_bytes(out, b"  the code vouches for it. A raw pointer never becomes a reference by\n");
    buf_bytes(out, b"  itself.\n");
    buf_bytes(out, b"- To read or change a caller's value, take a reference, not a pointer:\n");
    buf_bytes(out, b"  `fn read(x: &i64)`, `fn set(x: &mut i64) { *x = 4; }`. `fix --only\n");
    buf_bytes(out, b"  unsafe` wraps what stays raw in `unsafe { }`.\n");
    buf_bytes(out, b"- `v[i]` on a Vec or a slice is that element, checked; `*p.add(i)` on a\n");
    buf_bytes(out, b"  raw pointer is pointer arithmetic, unchecked and unsafe.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"extern \"C\" {\n");
    buf_bytes(out, b"    fn malloc(n: usize) -> *mut u8;\n");
    buf_bytes(out, b"    fn free(p: *mut u8);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Stats { count: i64, sum: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn add(s: &mut Stats, x: i64) {     // a reference: checked, safe to use\n");
    buf_bytes(out, b"    s.count += 1;\n");
    buf_bytes(out, b"    s.sum += x;\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// The caller promises that p points to n valid i64s.\n");
    buf_bytes(out, b"unsafe fn total(p: *const i64, n: usize) -> i64 {\n");
    buf_bytes(out, b"    let mut t = 0;\n");
    buf_bytes(out, b"    for i in 0..n { t += *p.add(i); } // allowed: the body is unsafe code\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let mut st = Stats { count: 0, sum: 0 };\n");
    buf_bytes(out, b"    add(&mut st, 5);\n");
    buf_bytes(out, b"    add(&mut st, 7);\n");
    buf_bytes(out, b"    let p = unsafe { malloc(3 * 8) as *mut i64 };\n");
    buf_bytes(out, b"    unsafe {\n");
    buf_bytes(out, b"        *p = 1;\n");
    buf_bytes(out, b"        *p.add(1) = 2;\n");
    buf_bytes(out, b"        *p.add(2) = 3;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let raw = unsafe { std::slice::from_raw_parts(p, 3) }; // valid while p is\n");
    buf_bytes(out, b"    println(\"{}\", st.sum + unsafe { total(p, 3) } + raw[2]);\n");
    buf_bytes(out, b"    unsafe { free(p as *mut u8); }  // raw is not used after\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"21\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Write the contract of an `unsafe fn` in its comment: its callers take it\n");
    buf_bytes(out, b"on. What unsafe code must keep so that the safe code around it stays\n");
    buf_bytes(out, b"defined:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- every reference it hands to safe code (`&*p`, `&mut *p`) points to\n");
    buf_bytes(out, b"  live memory of its type, and every slice it makes is valid for its\n");
    buf_bytes(out, b"  length while it is used;\n");
    buf_bytes(out, b"- it makes no second live alias of a place a `&mut` reference holds\n");
    buf_bytes(out, b"  (the optimizer relies on a `&mut` being the only way to its memory);\n");
    buf_bytes(out, b"  overlapping slices made with `std::slice::from_raw_parts` and\n");
    buf_bytes(out, b"  `from_raw_parts_mut` and passed to a function as its `&[T]` and\n");
    buf_bytes(out, b"  `&mut [T]` are undefined behaviour (the optimizer knows such\n");
    buf_bytes(out, b"  parameters apart): overlapping memory goes through raw pointers\n");
    buf_bytes(out, b"  (`*const T`, `*mut T`), never through two references;\n");
    buf_bytes(out, b"- it changes nothing behind a live `&` reference, through a raw pointer\n");
    buf_bytes(out, b"  either (a `Cell` aside): the optimizer keeps a `&Vec`'s header (its\n");
    buf_bytes(out, b"  pointer, length and capacity) from before a loop, so a push to the\n");
    buf_bytes(out, b"  caller's Vec through a pointer kept in a static may go unseen;\n");
    buf_bytes(out, b"- it makes no pointer into a Vec's header from the Vec's own buffer\n");
    buf_bytes(out, b"  pointer, nor puts a Vec inside its own buffer (the optimizer takes a\n");
    buf_bytes(out, b"  store to an element as never reaching that Vec's header);\n");
    buf_bytes(out, b"- it gives a Vec no buffer that is a static, a local, or the struct the\n");
    buf_bytes(out, b"  Vec is a field of (`from_raw_parts` takes a block of the Vec's\n");
    buf_bytes(out, b"  allocator): the optimizer keeps a Vec's pointer and length across a\n");
    buf_bytes(out, b"  call whose callee only writes elements, of any Vec;\n");
    buf_bytes(out, b"- a type whose safe methods manage memory through raw pointers (a\n");
    buf_bytes(out, b"  growable buffer of its own) implements `Drop`: that keeps it from\n");
    buf_bytes(out, b"  being `Copy`, so a copy cannot outlive a reallocation.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Tools\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `volec fix --only unsafe` puts each unsafe operation outside unsafe\n");
    buf_bytes(out, b"  code into an `unsafe { }` block (the statement around it).\n");
    buf_bytes(out, b"- Each unsafe site says why, in the comments right above it (the\n");
    buf_bytes(out, b"  statement's or item's, no blank line between): `// UNSAFE:` why it\n");
    buf_bytes(out, b"  cannot be safe, `// SAFETY:` why it is sound. `volec check` warns\n");
    buf_bytes(out, b"  about a site without both (`unsafe.unjustified`). (0.25.3)\n");
    buf_bytes(out, b"- `volec query unsafe [FILE...|std]` (0.25.3) lists every unsafe block,\n");
    buf_bytes(out, b"  `unsafe fn` and extern block: `FILE:LINE`, kind, item, class (`ffi`,\n");
    buf_bytes(out, b"  `alloc`, `intrinsic`, `transmute/cast`, `raw-pointer`, `static-mut`:\n");
    buf_bytes(out, b"  through a pointer held in a static, `other`), its comments, and the\n");
    buf_bytes(out, b"  operations inside that need unsafe; `none (unneeded)`: a block with\n");
    buf_bytes(out, b"  nothing unsafe inside, to remove. `--unjustified`, `--summary`\n");
    buf_bytes(out, b"  (counts by class, module, file), `--json`, `--no-std`.\n");
    buf_bytes(out, b"- `volec fix --only unneeded-unsafe` (0.25.4) takes the `none\n");
    buf_bytes(out, b"  (unneeded)` blocks away and keeps their code in its scope; a block it\n");
    buf_bytes(out, b"  cannot open so (one that declares and is not last) is left and\n");
    buf_bytes(out, b"  counted. `--only unneeded-justified` (0.25.5) takes the justified ones\n");
    buf_bytes(out, b"  too, with their `// UNSAFE:` and `// SAFETY:` comments.\n");
    buf_bytes(out, b"- `volec --check-unsafe -O1 prog.vl -o prog` checks raw-pointer\n");
    buf_bytes(out, b"  accesses against the heap blocks at run time (`malloc`/`free`):\n");
    buf_bytes(out, b"  out-of-bounds and use-after-free stop the program with `unsafe access\n");
    buf_bytes(out, b"  ...` and exit 101. Programs run tens of times slower.\n");
    buf_bytes(out, b"- `volec --check-alloc` (0.16) puts every block of Gpa on pages of\n");
    buf_bytes(out, b"  its own: a use after free through raw pointers faults and is reported\n");
    buf_bytes(out, b"  with where the block was allocated and freed;\n");
    buf_bytes(out, b"  bad frees and leaks are reported too (`volec guide memory`). With\n");
    buf_bytes(out, b"  `--check-unsafe`, raw accesses are checked against those blocks.\n");
}
