// Generated by compiler/guide/embed.sh from compiler/guide/unsafe.md (do
// not edit): the guide's topic 'unsafe'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# unsafe\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Safe code has no undefined behaviour: arithmetic wraps, `/ 0` is 0,\n");
    buf_bytes(out, b"indexing is checked, every variable is initialized. What can have\n");
    buf_bytes(out, b"undefined behaviour is an *unsafe operation*, allowed only inside\n");
    buf_bytes(out, b"`unsafe { ... }` (an expression: `let x = unsafe { *p };`) or in the body\n");
    buf_bytes(out, b"of an `unsafe fn`:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- calling a C function (an `extern \"C\"` declaration, an `import`ed one,\n");
    buf_bytes(out, b"  an `extern \"C\" fn` pointer) or an `unsafe fn`;\n");
    buf_bytes(out, b"- dereferencing a raw pointer: `*p`, `p.f`, a method called through `p`;\n");
    buf_bytes(out, b"- indexing or slicing a raw pointer: `p[i]`, `p[lo..hi]` (unchecked);\n");
    buf_bytes(out, b"- casting an integer to a pointer (except the literal `0`, null), in a\n");
    buf_bytes(out, b"  static's or a constant's initializer too: `static P: *u8 = unsafe {\n");
    buf_bytes(out, b"  4096 as *u8 };`;\n");
    buf_bytes(out, b"- reading a union's field;\n");
    buf_bytes(out, b"- using an `unsafe fn` as a value.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A `*T` is raw wherever it comes from, a parameter too. Passing,\n");
    buf_bytes(out, b"comparing and casting one is safe; dereferencing it is not. `*` means\n");
    buf_bytes(out, b"only this: an access (a let or inout parameter, an `inout` local, an\n");
    buf_bytes(out, b"access field) is used as its value, with no `*`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Accesses and raw pointers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Parameters taken let, inout or sink, `inout r = &x;` locals and access\n");
    buf_bytes(out, b"fields are checked by the compiler (`guide memory`, `guide views`), so\n");
    buf_bytes(out, b"using them is safe. `*T` is the raw pointer, the escape hatch: nothing\n");
    buf_bytes(out, b"checks what it points to.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `&place` passed where a `*T` is wanted (C's parameters, `&x as *u8`)\n");
    buf_bytes(out, b"  converts to the raw pointer; the call takes an exclusive loan of\n");
    buf_bytes(out, b"  `place` for its duration, sound for C's `const T*` too.\n");
    buf_bytes(out, b"- A raw pointer: a `*T` local or field, `malloc`'s result, `c\"...\"`\n");
    buf_bytes(out, b"  (read-only memory), and `&(*p).f` of a place reached through a raw\n");
    buf_bytes(out, b"  `p`. In `unsafe` code `&*p` makes an inout access of the pointee\n");
    buf_bytes(out, b"  (`bump(&*p)`, `inout r = &*p;`): the code vouches. A raw pointer never\n");
    buf_bytes(out, b"  becomes an access by itself.\n");
    buf_bytes(out, b"- To read or change a caller's value, take it let or inout, not `*T`:\n");
    buf_bytes(out, b"  `fn read(x: i64)`, `fn set(x: inout i64) { x = 4; }`. `fix --only\n");
    buf_bytes(out, b"  unsafe` wraps what stays raw in `unsafe { }`.\n");
    buf_bytes(out, b"- `p[i]` on an access to a Vec, a Buf or a slice is that element,\n");
    buf_bytes(out, b"  checked; `p[i]` on a raw pointer is pointer arithmetic, unchecked and\n");
    buf_bytes(out, b"  unsafe.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"extern \"C\" {\n");
    buf_bytes(out, b"    fn malloc(n: u64) -> *u8;\n");
    buf_bytes(out, b"    fn free(p: *u8);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Stats { count: i64, sum: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn add(s: inout Stats, x: i64) {     // an access: safe to use\n");
    buf_bytes(out, b"    s.count += 1;\n");
    buf_bytes(out, b"    s.sum += x;\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// The caller promises that p points to n valid i64s.\n");
    buf_bytes(out, b"unsafe fn total(p: *i64, n: i64) -> i64 {\n");
    buf_bytes(out, b"    var t = 0;\n");
    buf_bytes(out, b"    for i in 0..n { t += p[i]; }      // allowed: the body is unsafe code\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var st = Stats { count: 0, sum: 0 };\n");
    buf_bytes(out, b"    add(&st, 5);\n");
    buf_bytes(out, b"    add(&st, 7);\n");
    buf_bytes(out, b"    let p = unsafe { malloc(3 * 8) as *i64 };\n");
    buf_bytes(out, b"    unsafe {\n");
    buf_bytes(out, b"        p[0] = 1;\n");
    buf_bytes(out, b"        p[1] = 2;\n");
    buf_bytes(out, b"        p[2] = 3;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let raw = unsafe { p[0..3] };     // a slice of raw memory: valid while p is\n");
    buf_bytes(out, b"    std::print_int(st.sum + unsafe { total(p, 3) } + raw[2]);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    unsafe { free(p as *u8); }        // raw is not used after\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"21\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Write the contract of an `unsafe fn` in its comment: its callers take it\n");
    buf_bytes(out, b"on. What unsafe code must keep so that the safe code around it stays\n");
    buf_bytes(out, b"defined:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- every pointer it hands to safe code as an access (`&*p`) points to\n");
    buf_bytes(out, b"  live memory of its type, and every slice it makes is valid for its length\n");
    buf_bytes(out, b"  while it is used;\n");
    buf_bytes(out, b"- it makes no second live alias of a place under an inout access (the\n");
    buf_bytes(out, b"  optimizer relies on an `inout` parameter being the only way to its\n");
    buf_bytes(out, b"  memory);\n");
    buf_bytes(out, b"- (0.25.4) it changes nothing lent let while the call runs, through a\n");
    buf_bytes(out, b"  raw pointer either: the optimizer keeps a let parameter's Vec header\n");
    buf_bytes(out, b"  (its pointer, length and capacity) from before a loop, so a push to\n");
    buf_bytes(out, b"  the caller's Vec through a pointer kept in a static may go unseen;\n");
    buf_bytes(out, b"- it makes no pointer into a Vec's header from the Vec's own buffer\n");
    buf_bytes(out, b"  pointer, nor puts a Vec inside its own buffer (the optimizer takes a\n");
    buf_bytes(out, b"  store to an element as never reaching that Vec's header);\n");
    buf_bytes(out, b"- a type whose safe methods manage memory through raw pointers (a\n");
    buf_bytes(out, b"  growable buffer of its own) implements `Drop`: that makes it owned and\n");
    buf_bytes(out, b"  move-only, so a copy cannot outlive a reallocation.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Tools\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `volec fix --only unsafe` puts each unsafe operation outside unsafe\n");
    buf_bytes(out, b"  code into an `unsafe { }` block (the statement around it).\n");
    buf_bytes(out, b"- Each unsafe site says why, in the comments right above it (the\n");
    buf_bytes(out, b"  statement's or item's, no blank line between): `// UNSAFE:` why it\n");
    buf_bytes(out, b"  cannot be safe, `// SAFETY:` why it is sound. `volec check` warns\n");
    buf_bytes(out, b"  about a site without both (`unsafe.unjustified`; an error with\n");
    buf_bytes(out, b"  `--deny-warnings`). (0.25.3)\n");
    buf_bytes(out, b"- `volec query unsafe [FILE...|std]` (0.25.3) lists every unsafe block,\n");
    buf_bytes(out, b"  `unsafe fn` and extern block: `FILE:LINE`, kind, item, class (`ffi`,\n");
    buf_bytes(out, b"  `alloc`, `intrinsic`, `transmute/cast`, `raw-pointer`, `static-mut`:\n");
    buf_bytes(out, b"  through a pointer held in a static, `other`), its comments, and the\n");
    buf_bytes(out, b"  operations inside that need unsafe; `none (unneeded)`: a block with\n");
    buf_bytes(out, b"  nothing unsafe inside, to remove. `--unjustified`, `--summary`\n");
    buf_bytes(out, b"  (counts by class, module, file), `--json`, `--no-std`.\n");
    buf_bytes(out, b"- `volec fix --only unneeded-unsafe` (0.25.4) takes the `none\n");
    buf_bytes(out, b"  (unneeded)` blocks away and keeps their code in its scope; a block it\n");
    buf_bytes(out, b"  cannot open so (one that declares and is not last) is left and\n");
    buf_bytes(out, b"  counted. `--only unneeded-justified` (0.25.5) takes the justified ones\n");
    buf_bytes(out, b"  too, with their `// UNSAFE:` and `// SAFETY:` comments.\n");
    buf_bytes(out, b"- `volec --check-unsafe -O1 prog.vl -o prog` checks raw-pointer\n");
    buf_bytes(out, b"  accesses against the heap blocks at run time (`malloc`/`free`):\n");
    buf_bytes(out, b"  out-of-bounds and use-after-free stop the program with `unsafe access\n");
    buf_bytes(out, b"  ...` and exit 101. Programs run tens of times slower.\n");
    buf_bytes(out, b"- `volec --check-alloc` (0.16) puts every block of Gpa on pages of\n");
    buf_bytes(out, b"  its own: a use after free through raw pointers faults and is reported\n");
    buf_bytes(out, b"  with where the block was allocated and freed;\n");
    buf_bytes(out, b"  bad frees and leaks are reported too (`volec guide memory`). With\n");
    buf_bytes(out, b"  `--check-unsafe`, raw accesses are checked against those blocks.\n");
    buf_bytes(out, b"- Statics, `static var` included, are safe: a `static var` is for the\n");
    buf_bytes(out, b"  main thread, and code another thread runs may not reach one\n");
    buf_bytes(out, b"  (`sync.global`, `guide threads`).\n");
}
