// Generated by compiler/guide/embed.sh from compiler/guide/views.md (do
// not edit): the guide's topic 'views'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Views\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A *view* points into memory something else owns: a slice `[T]` (a\n");
    buf_bytes(out, b"string literal, `v.as_slice()`, `a[1..3]`), an access field (`q: inout\n");
    buf_bytes(out, b"Query`, `cfg: let Config`), a struct holding one (`Scanner`, `struct Tok\n");
    buf_bytes(out, b"{ text: [u8] }`), a `Vec<[u8], Gpa>` of them, a closure that captures by\n");
    buf_bytes(out, b"access. Views are second-class: the checker keeps each one inside what\n");
    buf_bytes(out, b"it views, with no lifetimes to write.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## What a view may do\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Live in locals, parameters, struct fields and containers\n");
    buf_bytes(out, b"  (`Vec<[u8], Gpa>`, `HashMap<[u8], i64, Gpa>`): a parser keeps tokens that view\n");
    buf_bytes(out, b"  its input.\n");
    buf_bytes(out, b"- Be returned when it views a parameter: `fn first_word(s: [u8]) ->\n");
    buf_bytes(out, b"  [u8]`, `fn as_slice(self) -> [T]` on a `Vec<T, A>`.\n");
    buf_bytes(out, b"- Not outlive its owner: not returned out of the function that owns the\n");
    buf_bytes(out, b"  memory (`own.escape`), not used after its owner changed, moved or was\n");
    buf_bytes(out, b"  dropped (`own.conflict`).\n");
    buf_bytes(out, b"- Statics hold only views of constant data (string literals).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`[T]` is read-only (a let access to elements); `inout [T]` is the\n");
    buf_bytes(out, b"exclusive, writable one: `fn fill(s: inout [i64], x: i64)`, called as\n");
    buf_bytes(out, b"`fill(&a[1..3], 0)`, `fill(&v[..], 0)` or `fill(v.as_mut_slice(), 0)`\n");
    buf_bytes(out, b"(already an access: no `&`). A struct with an `inout` field (`struct\n");
    buf_bytes(out, b"Parser { q: inout Query }`) is a *move-only* view: it moves, it is not\n");
    buf_bytes(out, b"copied, and while it lives `q` is reached only through it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Exclusivity\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"While a view of `x` (or a let access, a let argument) is used later,\n");
    buf_bytes(out, b"nothing writes, moves or drops `x`; while an inout access `&x` is used\n");
    buf_bytes(out, b"later, `x` is reached only through it. Uses end at the last one (not at the end of the block), so a view\n");
    buf_bytes(out, b"that is not used again is no conflict.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"let first = v.as_slice();   v.push(4);   first[0]     own.conflict: use first before the push\n");
    buf_bytes(out, b"for x in v { v.push(x); }                             own.conflict: loop over 0..v.len()\n");
    buf_bytes(out, b"f(&a, a)                                              own.conflict: f(&a.x, a.y) is fine\n");
    buf_bytes(out, b"rng.big(1 + rng.next())                               own.conflict: let n = rng.next(); first\n");
    buf_bytes(out, b"v.push(v.len())                                       fine: the receiver is taken after the arguments\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Disjoint fields do not overlap; `v[i]` and `v[j]` do (`v.swap(i, j)`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## What a function returns: its view summary\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Each function has an inferred summary, like its effects (`guide\n");
    buf_bytes(out, b"effects`): which parameters its result (and what its `inout` parameters\n");
    buf_bytes(out, b"come to hold) points into.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| summary | meaning | e.g. |\n");
    buf_bytes(out, b"|---|---|---|\n");
    buf_bytes(out, b"| `views(self)` | points into what `self` points to | `Vec::as_slice`; a lexer that owns its text, returning `self.src.as_slice()[a..b]` |\n");
    buf_bytes(out, b"| `views(*self)` | carries views `self` holds, not into `self` | a parser returning a token's `text` |\n");
    buf_bytes(out, b"| `views(s)`, `views()` | into parameter `s`; nothing | `first_word(s)`; a function returning a Buf |\n");
    buf_bytes(out, b"| `stores(word)` | what the `inout` parameters may come to hold | `intern(names: inout Vec<[u8], Gpa>, word: [u8])` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec query views NAME --why` shows a summary and the line that\n");
    buf_bytes(out, b"makes each part; `#[views(*self)]` on a function pins it (the body is\n");
    buf_bytes(out, b"checked against it, callers use it).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Parsers and lexers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A parser over tokens that view the input, and a lexer over text its\n");
    buf_bytes(out, b"caller owns, are `views(*self)`: what they return outlives the next\n");
    buf_bytes(out, b"call. This checks clean:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Tok { text: [u8], kind: i64 }\n");
    buf_bytes(out, b"struct Parser<A: Allocator> { toks: Vec<Tok, A>, pos: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Parser<Gpa> {\n");
    buf_bytes(out, b"    fn name(inout self) -> [u8] {\n");
    buf_bytes(out, b"        let t = self.toks[self.pos];\n");
    buf_bytes(out, b"        self.pos += 1;\n");
    buf_bytes(out, b"        t.text                        // a view of the input, not of the parser\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    var p = Parser { toks: Vec::new_in(gpa), pos: 0 };\n");
    buf_bytes(out, b"    p.toks.push(Tok { text: \"let\", kind: 0 });\n");
    buf_bytes(out, b"    p.toks.push(Tok { text: \"x\", kind: 1 });\n");
    buf_bytes(out, b"    let a = p.name();\n");
    buf_bytes(out, b"    let b = p.name();                 // a is still fine\n");
    buf_bytes(out, b"    println(\"{a} {b}\");\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"let x\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A lexer that *owns* its text (`src: Buf`) and returns views of it is\n");
    buf_bytes(out, b"`views(self)`: the second call (`word(inout self)`) changes the lexer\n");
    buf_bytes(out, b"while the first word still views it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"main.vl:14:13: error[own.conflict] 'lx.word()' may change 'lx' while 'a' (main.vl:13:9) views it; 'a' is used at main.vl:15:16\n");
    buf_bytes(out, b"  help: use the view before the change, keep an index instead of a view, or keep a copy\n");
    buf_bytes(out, b"  try: volec query own main.vl:15:16\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Let the lexer view text its caller owns (`src: [u8]`: `volec\n");
    buf_bytes(out, b"refactor field Lexer --type src '[u8]'`), or copy each word into a\n");
    buf_bytes(out, b"`Buf`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The diagnostics\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Each is one line (`check` joins the parts with ` | `), with what\n");
    buf_bytes(out, b"happened and both positions, a `help:` with the fix, and `try:` lines\n");
    buf_bytes(out, b"that run as they are. `volec explain own.conflict` (and the other\n");
    buf_bytes(out, b"codes) has each in full; `volec query own FILE:LINE:COL` shows every\n");
    buf_bytes(out, b"local's state at a position.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"main.vl:10:5: error[own.conflict] 'v.push(4)' may change 'v' while 'first' (main.vl:9:9) views it; 'first' is used at main.vl:11:13\n");
    buf_bytes(out, b"  help: use the view before the change, keep an index instead of a view, or keep a copy\n");
    buf_bytes(out, b"  try: volec edit patch main --old 'v.as_slice()' --new 'v.clone()'\n");
    buf_bytes(out, b"  try: volec query own main.vl:11:13\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"greet.vl:4:5: error[own.escape] 'greet' returns a view of 'b', which is dropped when 'greet' returns\n");
    buf_bytes(out, b"  help: return the owner itself; a caller that wants a view takes '.as_slice()' of it\n");
    buf_bytes(out, b"  try: volec edit patch greet --old '-> [u8]' --new '-> Buf' --old 'b.as_slice()' --new 'b'\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"main.vl:12:18: error[own.conflict] 'v.push(x)' may change the elements of 'v' while the 'for' at main.vl:12:5 iterates over them\n");
    buf_bytes(out, b"  help: loop over the indexes (the loop sees the elements present when it starts), or collect the new elements and append them after the loop\n");
    buf_bytes(out, b"  try: volec edit patch main --old 'for x in v {' --new 'for i in 0..v.len() { let x = v[i];'\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"main.vl:6:11: error[own.conflict] 'a' is lent inout to '&a' and inout again to '&a' in the same call\n");
    buf_bytes(out, b"  help: pass disjoint places, copy the plain value out first, or for two elements of one Vec use 'v.swap(i, j)'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"They are errors by default (`--values=error`). `--values=warn` makes\n");
    buf_bytes(out, b"them warnings; `--values=report` lists them without failing\n");
    buf_bytes(out, b"the build; `--values=off` turns the checks and the drops off (0.16's\n");
    buf_bytes(out, b"semantics, for code not yet migrated by `volec fix --values`).\n");
}
