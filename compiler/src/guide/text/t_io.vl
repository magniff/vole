    buf_bytes(out, b"command).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::{fs, io};\n");
    buf_bytes(out, b"use std::fs::File;\n");
    buf_bytes(out, b"use std::io::{BufRead, BufReader, BufWriter, Write};\n");
    buf_bytes(out, b"use std::process::Command;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn run(gpa: Gpa) -> io::Result<()> {\n");
    buf_bytes(out, b"    let path = \"/tmp/vole-guide-files.txt\";\n");
    buf_bytes(out, b"    {\n");
    buf_bytes(out, b"        let mut w = BufWriter::new(File::create(path)?);\n");
