    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let mut r = BufReader::new(File::open(path)?);\n");
    buf_bytes(out, b"    let mut line = String::new_in(gpa);\n");
