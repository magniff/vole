    buf_bytes(out, b"    while r.read_line(&mut line)? > 0 {\n");
    buf_bytes(out, b"        total += 1;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"{total} {} {}\", line.lines().count(), fs::metadata(path)?.len());\n");
