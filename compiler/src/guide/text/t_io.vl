    buf_bytes(out, b"    let out = c.output()?;\n");
    buf_bytes(out, b"    println(\"{} {}\", out.status.success(), out.stdout.len());\n");
    buf_bytes(out, b"    match File::open(path) {\n");
    buf_bytes(out, b"        Ok(_) => println(\"still there\"),\n");
    buf_bytes(out, b"        Err(e) => println(\"{:?}\", e.kind()),\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    match run(gpa) {\n");
