    buf_bytes(out, b"        Err(e) => {\n");
    buf_bytes(out, b"            eprintln(\"{e}\");\n");
    buf_bytes(out, b"            1\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
