    buf_bytes(out, b"`is_dir()`), `fs::create_dir_all(p)?`, `fs::remove_file`,\n");
    buf_bytes(out, b"`fs::remove_dir_all`, `fs::rename(a, b)`, `fs::copy(a, b)`,\n");
