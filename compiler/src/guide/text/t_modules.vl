// Generated by compiler/guide/embed.sh from compiler/guide/modules.md (do
// not edit): the guide's topic 'modules'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Modules and imports\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A file is a module. The files on the command line make the root module\n");
    buf_bytes(out, b"(`crate`); `mod name;` in a module loads its child `name` from\n");
    buf_bytes(out, b"`name.vl` or `name/mod.vl` next to it (from `a.vl`: `a/name.vl`).\n");
    buf_bytes(out, b"`mod name { items }` declares one inline.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"main.vl            mod geometry;  use geometry::shapes::{Shape, area};\n");
    buf_bytes(out, b"geometry.vl        pub mod shapes;  pub struct Rect { w: i64, h: i64 }\n");
    buf_bytes(out, b"geometry/shapes.vl pub enum Shape { ... }  pub fn area(s: Shape) -> i64 { ... }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec main.vl -o prog      # loads the modules main.vl names\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Visibility\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Every item is private to its module and the modules inside it unless\n");
    buf_bytes(out, b"`pub`. So is a struct's field (0.26, Rust's rule): outside, reading,\n");
    buf_bytes(out, b"writing or borrowing a field not marked `pub` is `field.private`, and a\n");
    buf_bytes(out, b"literal needs every field visible (`field.literal-private`; a struct\n");
    buf_bytes(out, b"with a private field is made by its module's functions). On your own\n");
    buf_bytes(out, b"field the help is its declaration with `pub`, which `volec fix --only\n");
    buf_bytes(out, b"pub` writes. Methods are visible wherever their type is. A `pub mod` can\n");
    buf_bytes(out, b"be reached from outside its parent. `pub use a::b;` re-exports `b`.\n");
    buf_bytes(out, b"`pub(crate)` (0.26.2) is visible in the crate only, `pub(super)` in the\n");
    buf_bytes(out, b"parent module (and inside it), `pub(in crate::a)` in module `a`, which\n");
    buf_bytes(out, b"must be the item's own or one around it (`vis.path`); `pub(self)` is\n");
    buf_bytes(out, b"private. They go on items, fields, `use` and `mod`. Used outside, the\n");
    buf_bytes(out, b"error (`item.private`, `field.private`) says where it is visible, and\n");
    buf_bytes(out, b"`fix --only pub` widens it to `pub(crate)`. Std's crate is std: a std\n");
    buf_bytes(out, b"item marked `pub(crate)` is not a program's to use.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"mod shop {\n");
    buf_bytes(out, b"    pub mod till {\n");
    buf_bytes(out, b"        pub(super) fn tax(n: i64) -> i64 { n / 10 }\n");
    buf_bytes(out, b"        pub(crate) fn total(n: i64) -> i64 { n + tax(n) }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    pub fn quote(n: i64) -> i64 { till::tax(n) }   // the parent sees it\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    println(shop::till::total(50) + shop::quote(50));   // not shop::till::tax\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"60\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"mod geo {\n");
    buf_bytes(out, b"    pub struct Rect { pub w: i64, h: i64 }\n");
    buf_bytes(out, b"    impl Rect {\n");
    buf_bytes(out, b"        pub fn new(w: i64, h: i64) -> Rect { Rect { w: w, h: h } }\n");
    buf_bytes(out, b"        pub fn area(self) -> i64 { self.w * self.h }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let r = geo::Rect::new(3, 4);     // not `geo::Rect { w: 3, h: 4 }`: h is private\n");
    buf_bytes(out, b"    std::print_int(r.w + r.area());   // r.w is pub; r.h would be field.private\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"15\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Paths and use\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A path starts with a name in scope, `crate`, `self`, `super` or `std`:\n");
    buf_bytes(out, b"`geometry::area(s)`, `crate::util::Vec2 { x: 1, y: 2 }`,\n");
    buf_bytes(out, b"`shapes::Shape::Rect(r)`, `util::Stack::<u8>::new()`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A path may also start with a sibling module (0.17): in `parser.vl`,\n");
    buf_bytes(out, b"where `main.vl` has `mod lexer; mod parser;`, `use lexer::{Tok, next};`\n");
    buf_bytes(out, b"is `use crate::lexer::{Tok, next};`, and `lexer::next(..)` or `t:\n");
    buf_bytes(out, b"lexer::Tok` in code is `crate::lexer::...` the same way. The first\n");
    buf_bytes(out, b"segment, when the module has no name of its own for it, is a child of its\n");
    buf_bytes(out, b"parent module, else of the root; when both exist and differ, the error's\n");
    buf_bytes(out, b"`try:` lines are the two `crate::` paths.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"mod util {\n");
    buf_bytes(out, b"    pub fn double(x: i64) -> i64 { x * 2 }\n");
    buf_bytes(out, b"    pub fn half(x: i64) -> i64 { x / 2 }\n");
    buf_bytes(out, b"    pub enum Mode { Fast, Slow }\n");
    buf_bytes(out, b"    pub mod inner {\n");
    buf_bytes(out, b"        use super::double;               // the parent's item\n");
    buf_bytes(out, b"        pub fn quad(x: i64) -> i64 { double(double(x)) }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"use util::{double, half as halve};       // by name, with `as` to rename\n");
    buf_bytes(out, b"use util::inner::quad;\n");
    buf_bytes(out, b"use util::Mode::{Fast, Slow};            // an enum's variants\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn speed(m: util::Mode) -> i64 {\n");
    buf_bytes(out, b"    match m { Fast => 10, Slow => 1 }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    std::print_int(double(3) + halve(8) + quad(1) + speed(Fast) + crate::util::double(1));\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"26\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- No wildcard imports (`use m::*;` is an error): every name a file uses\n");
    buf_bytes(out, b"  is declared there, imported by name, or written as a path.\n");
    buf_bytes(out, b"- The order of items and `use` lines does not matter.\n");
    buf_bytes(out, b"- Name resolution: a local binding, then the module's own items, then\n");
    buf_bytes(out, b"  its imports, then the prelude. A program's own `Vec` (or `trim`) hides\n");
    buf_bytes(out, b"  the prelude's.\n");
    buf_bytes(out, b"- The prelude, std's names used without a `use`: `Option Some None\n");
    buf_bytes(out, b"  Result Ok Err Vec Buf HashMap print println eprint eprintln format\n");
    buf_bytes(out, b"  format_in Gpa Allocator Arena ScopedArena arena_scope read_line\n");
    buf_bytes(out, b"  read_stdin_in Scanner parse_int trim split_in split_whitespace_in sort\n");
    buf_bytes(out, b"  sort_by cmp_of eq_of Fmt Display Debug Clone From Into Iterator Hash\n");
    buf_bytes(out, b"  Eq Ord` and the operator traits, `panic(msg)` (prints `msg`, exits with\n");
    buf_bytes(out, b"  101) and `unreachable()`. The rest of std is `use std::{...}` (or\n");
    buf_bytes(out, b"  `std::name`); a program that names none of it is built without std.\n");
    buf_bytes(out, b"- A C header: `import \"stdio.h\" as c;` then `c::printf`; in a pattern,\n");
    buf_bytes(out, b"  import a C constant by name: `use c::EOF;`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Symbols\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An item of module `a::b` has the symbol `a.b.name`; root items keep\n");
    buf_bytes(out, b"their names, as do `extern \"C\"` items and `#[link_name]`s.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Tools\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `volec fix --only imports` adds the `use` lines a program is\n");
    buf_bytes(out, b"  missing (its own items', and std's outside the prelude),\n");
    buf_bytes(out, b"  and `--only unused` removes unused ones. (0.25.2) `check` and a build\n");
    buf_bytes(out, b"  warn about each, `use.unused` (an error with `--deny-warnings`): an\n");
    buf_bytes(out, b"  import nothing in its file names; not a `pub use`.\n");
    buf_bytes(out, b"- `volec query items` lists every module; `query items MODULE` its\n");
    buf_bytes(out, b"  items with signatures.\n");
    buf_bytes(out, b"- `volec refactor move a::f --to crate::b` moves items, fixing\n");
    buf_bytes(out, b"  imports and `pub`; `refactor rename`, `refactor new-module`,\n");
    buf_bytes(out, b"  `refactor split` (see `volec guide tools`).\n");
}
