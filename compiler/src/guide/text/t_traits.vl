use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Traits\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A trait declares functions; `Self` stands for the implementing type; a\n");
    buf_bytes(out, b"function may have a default body. `impl Trait for Type` defines them for\n");
    buf_bytes(out, b"any type (`i64`, `[u8]`, `Vec<T, A>`, a struct). Its functions become the\n");
    buf_bytes(out, b"type's methods. Dispatch is static: a trait is not a type.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::hash_u64;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"trait Shape {\n");
    buf_bytes(out, b"    fn area(self) -> i64;\n");
    buf_bytes(out, b"    fn name(self) -> [u8] { \"shape\" }          // a default\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Square { side: i64 }\n");
    buf_bytes(out, b"struct Rect { w: i64, h: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Shape for Square {\n");
    buf_bytes(out, b"    fn area(self) -> i64 { self.side * self.side }\n");
    buf_bytes(out, b"    fn name(self) -> [u8] { \"square\" }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Shape for Rect {\n");
    buf_bytes(out, b"    fn area(self) -> i64 { self.w * self.h }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn report<T: Shape>(s: T) {\n");
    buf_bytes(out, b"    print(s.name());\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(s.area());\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// Operators: + - * / and unary - through Add Sub Mul Div Neg,\n");
    buf_bytes(out, b"// == through Eq, < <= > >= through Ord's cmp. All take their operands\n");
    buf_bytes(out, b"// let (`self`, `o: V2`): `a + b` reads a and b, an owned one too.\n");
    buf_bytes(out, b"struct V2 { x: i64, y: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Add for V2 {\n");
    buf_bytes(out, b"    fn add(self, o: V2) -> V2 { V2 { x: self.x + o.x, y: self.y + o.y } }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Ord for V2 {\n");
    buf_bytes(out, b"    fn cmp(self, o: V2) -> i64 { (self.x + self.y) - (o.x + o.y) }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Hash for V2 {\n");
    buf_bytes(out, b"    fn hash(self) -> u64 { hash_u64((self.x * 31 + self.y) as u64) }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"trait Double { fn double(self) -> Self; }\n");
    buf_bytes(out, b"impl Double for i64 { fn double(self) -> i64 { self * 2 } }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let sq = Square { side: 3 };\n");
    buf_bytes(out, b"    let r = Rect { w: 2, h: 5 };\n");
    buf_bytes(out, b"    report(sq);                           // or report(Square { side: 3 }): a temporary\n");
    buf_bytes(out, b"    report(r);\n");
    buf_bytes(out, b"    let v = V2 { x: 1, y: 2 } + V2 { x: 3, y: 4 };\n");
    buf_bytes(out, b"    if v > (V2 { x: 0, y: 0 }) { std::print_int(v.x * 10 + v.y); }\n");
    buf_bytes(out, b"    var seen: HashMap<V2, bool, Gpa> = HashMap::new_in(gpa); // a struct key: Hash + Eq\n");
    buf_bytes(out, b"    seen.insert(v, true);\n");
    buf_bytes(out, b"    if seen.contains(V2 { x: 4, y: 6 }) { print(\" found \"); }\n");
    buf_bytes(out, b"    std::print_int(21.double());\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"square 9\n");
    buf_bytes(out, b"shape 10\n");
    buf_bytes(out, b"46 found 42\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Bounds: `fn f<T: A + B>`, `impl<T: Hash> Hash for Pair<T>`, `struct\n");
    buf_bytes(out, b"  Map<K: Hash + Eq, V>`. A call with a type that lacks the trait is an\n");
    buf_bytes(out, b"  error naming the bound.\n");
    buf_bytes(out, b"- At most one impl per trait and type (a generic impl counts for all\n");
    buf_bytes(out, b"  its instances).\n");
    buf_bytes(out, b"- `Eq`: every type with structural `==` has it (structs, enums, tuples,\n");
    buf_bytes(out, b"  arrays, slices whose parts have `==`; a `[u8]` by bytes); an\n");
    buf_bytes(out, b"  `impl Eq` replaces structural `==`, also for a part.\n");
    buf_bytes(out, b"  `Ord`: numbers, pointers, fieldless enums have it.\n");
    buf_bytes(out, b"- A trait writes its receivers as impls do: `fn eq(self, other: Self)\n");
    buf_bytes(out, b"  -> bool`, `fn next(inout self) -> Option<Self::Item>`, `fn fmt(self, f:\n");
    buf_bytes(out, b"  inout Fmt)`, `fn clone(self) -> Self`; an impl takes them the same way.\n");
    buf_bytes(out, b"- Methods are called `x.m()`, which lends `x` as the receiver says (an\n");
    buf_bytes(out, b"  `inout self` method needs a `var`), or `Type::m(x)` (`Type::m(&x)` for\n");
    buf_bytes(out, b"  `inout self`); a trait's function without `self` is called `Type::f()`.\n");
    buf_bytes(out, b"- A default function is checked, and compiled, only for the impls\n");
    buf_bytes(out, b"  that use it (in a non-generic impl).\n");
    buf_bytes(out, b"- Not there: `dyn Trait` (use generics, or an enum of the cases),\n");
    buf_bytes(out, b"  supertraits, associated constants, `impl Trait` in argument or return\n");
    buf_bytes(out, b"  position, blanket impls over all `T`.\n");
    buf_bytes(out, b"- (0.15) Traits may take type parameters, `trait From<T>`; bounds take\n");
    buf_bytes(out, b"  arguments, `T: From<i64>` (`volec guide conversions`).\n");
    buf_bytes(out, b"  `#[derive(Eq, Ord, Hash, Debug, Clone)]` writes impls (`volec\n");
    buf_bytes(out, b"  guide formatting`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Associated types (0.14)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A trait declares `type Name;`, each impl defines it, and `T::Name` (or\n");
    buf_bytes(out, b"`Self::Name`) is that type. A bound can fix it: `I: Iterator<Item =\n");
    buf_bytes(out, b"i64>`. Slices get impls too: `impl<T> [T] { ... }`, `impl<T> Tr for [T]`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::print_int;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Countdown { n: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Iterator for Countdown {           // std's trait, in the prelude\n");
    buf_bytes(out, b"    type Item = i64;\n");
    buf_bytes(out, b"    fn next(inout self) -> Option<i64> {\n");
    buf_bytes(out, b"        if self.n == 0 { return None; }\n");
    buf_bytes(out, b"        self.n -= 1;\n");
    buf_bytes(out, b"        Some(self.n + 1)\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn first<I: Iterator>(it: sink I) -> Option<I::Item> {\n");
    buf_bytes(out, b"    it.next()                           // a sink parameter is the callee's: mutable\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total<I: Iterator<Item = i64>>(it: sink I) -> i64 {\n");
    buf_bytes(out, b"    it.sum()                            // a default of Iterator\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl<T> [T] {\n");
    buf_bytes(out, b"    fn second(self) -> T { self[1] }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    print_int(first(Countdown { n: 3 }).unwrap());\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    print_int(total(Countdown { n: 4 }));\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    print_int(Countdown { n: 5 }.count() as i64);\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    let c: [u8; 1] = [\"xyz\".second()];\n");
    buf_bytes(out, b"    print(c[0..1]);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3 10 5 y\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Every declared name must be defined: \"the impl of trait 'Iterator' is\n");
    buf_bytes(out, b"  missing 'type Item'\".\n");
    buf_bytes(out, b"- `X::Name` needs `X` to be a type parameter or `Self`; two traits\n");
    buf_bytes(out, b"  defining the name for one type is an ambiguity error. No defaults or\n");
    buf_bytes(out, b"  bounds on associated types, no `<T as Tr>::Name`.\n");
    buf_bytes(out, b"- A constraint that does not hold: \"'Small::Item' is 'u8', but the bound\n");
    buf_bytes(out, b"  'I: Iterator<Item = i64>' of 'total' requires 'i64'\".\n");
    buf_bytes(out, b"- `F::Output` is the result type of a fn type (or a closure).\n");
}
