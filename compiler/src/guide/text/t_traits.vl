pub fn text(out: i64) {
    buf_bytes(out, b"# Traits\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Rust's traits. A trait declares functions (`Self` is the implementing\n");
    buf_bytes(out, b"type), with or without a default body, associated types and constants.\n");
    buf_bytes(out, b"`impl Trait for Type` defines them for any type (`i64`, `[T]`, `Vec<T,\n");
    buf_bytes(out, b"A>`, a struct); its methods become the type's. Dispatch is static: a\n");
    buf_bytes(out, b"generic function is compiled once per type it is called with.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::collections::HashMap;\n");
    buf_bytes(out, b"use std::hash::FixedState;\n");
    buf_bytes(out, b"use std::ops::Add;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"trait Shape {\n");
    buf_bytes(out, b"    fn area(&self) -> i64;\n");
    buf_bytes(out, b"    fn name(&self) -> &str { \"shape\" }          // a default\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Square { side: i64 }\n");
    buf_bytes(out, b"struct Rect { w: i64, h: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Shape for Square {\n");
    buf_bytes(out, b"    fn area(&self) -> i64 { self.side * self.side }\n");
    buf_bytes(out, b"    fn name(&self) -> &str { \"square\" }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Shape for Rect {\n");
    buf_bytes(out, b"    fn area(&self) -> i64 { self.w * self.h }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn report<T: Shape>(s: &T) {\n");
    buf_bytes(out, b"    println(\"{} {}\", s.name(), s.area());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// Operators through std::ops (Add, Sub, Mul, Neg, Index...) and std::cmp:\n");
    buf_bytes(out, b"// == through PartialEq, < through PartialOrd, both derivable.\n");
    buf_bytes(out, b"#[derive(Clone, Copy, PartialEq, Eq, Hash, PartialOrd, Ord, Debug)]\n");
    buf_bytes(out, b"struct V2 { x: i64, y: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Add for V2 {\n");
    buf_bytes(out, b"    type Output = V2;\n");
    buf_bytes(out, b"    fn add(self, o: V2) -> V2 { V2 { x: self.x + o.x, y: self.y + o.y } }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"trait Double { fn double(self) -> Self; }\n");
    buf_bytes(out, b"impl Double for i64 { fn double(self) -> i64 { self * 2 } }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    report(&Square { side: 3 });\n");
    buf_bytes(out, b"    report(&Rect { w: 2, h: 5 });\n");
    buf_bytes(out, b"    let v = V2 { x: 1, y: 2 } + V2 { x: 3, y: 4 };\n");
    buf_bytes(out, b"    if v > (V2 { x: 0, y: 0 }) { print(\"{}\", v.x * 10 + v.y); }\n");
    buf_bytes(out, b"    let mut seen: HashMap<V2, bool, Gpa, FixedState> = HashMap::new_in(gpa); // a key: Hash + Eq\n");
    buf_bytes(out, b"    seen.insert(v, true);\n");
    buf_bytes(out, b"    if seen.contains_key(&V2 { x: 4, y: 6 }) { print(\" found \"); }\n");
    buf_bytes(out, b"    println(\"{} {:?}\", 21i64.double(), v);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"square 9\n");
    buf_bytes(out, b"shape 10\n");
    buf_bytes(out, b"46 found 42 V2 { x: 4, y: 6 }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Bounds: `fn f<T: A + B>`, `where T: A`, `impl<T: Hash> Hash for\n");
    buf_bytes(out, b"  Pair<T>`, `fn area(s: &impl Shape)`. A call with a type that lacks the\n");
    buf_bytes(out, b"  trait is an error naming the bound: `the trait 'T' is not implemented\n");
    buf_bytes(out, b"  for 'i64' | help: required by the bound 'X: T' of 'g'`.\n");
    buf_bytes(out, b"- One impl per trait and type (a generic impl counts for all its\n");
    buf_bytes(out, b"  instances): `conflicting impls of trait 'T' for 'S'`. An impl without\n");
    buf_bytes(out, b"  a function the trait has no default for: `the impl of trait 'T' is\n");
    buf_bytes(out, b"  missing 'f'`.\n");
    buf_bytes(out, b"- Operators are std::ops' traits (`Add`, `Sub`, `Mul`, `Div`, `Rem`,\n");
    buf_bytes(out, b"  `Neg`, `Not`, the `*Assign` forms, `Index`, `IndexMut`), each with its\n");
    buf_bytes(out, b"  `type Output`; `==` is `PartialEq`, `<` `PartialOrd`. `#[derive(Clone,\n");
    buf_bytes(out, b"  Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Default)]` writes\n");
    buf_bytes(out, b"  them (`guide formatting#derive`); a HashMap key is `Hash + Eq`.\n");
    buf_bytes(out, b"- Receivers are Rust's: `&self`, `&mut self`, `self`. `x.m()` borrows\n");
    buf_bytes(out, b"  `x` as the receiver says (a `&mut self` method needs a `let mut x`);\n");
    buf_bytes(out, b"  `Type::m(&x)` is the same call, and a function without `self` is called\n");
    buf_bytes(out, b"  `Type::f()` or `T::f()` for a type parameter.\n");
    buf_bytes(out, b"- A method of an integer literal needs its type where only some integer\n");
    buf_bytes(out, b"  types have it: `21i64.double()` (rustc's E0689).\n");
    buf_bytes(out, b"- Supertraits (`trait Loud: Named`), associated constants (`const KIND:\n");
    buf_bytes(out, b"  &'static str;`, used as `Self::KIND`, `<Dog as Named>::KIND`), blanket\n");
    buf_bytes(out, b"  impls (`impl<T: Debug> Describe for T`), generic traits (`trait\n");
    buf_bytes(out, b"  From<T>`, `T: From<i64>`, `guide conversions`) and `impl Trait`\n");
    buf_bytes(out, b"  arguments and results are Rust's.\n");
    buf_bytes(out, b"- Not there: `dyn Trait` (`dyn` is reserved: use generics, or an enum of\n");
    buf_bytes(out, b"  the cases).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Associated types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A trait declares `type Name;`, each impl defines it, and `T::Name`,\n");
    buf_bytes(out, b"`Self::Name` or `<T as Tr>::Name` is that type. A bound can fix it: `I:\n");
    buf_bytes(out, b"Iterator<Item = i64>`. A trait can be implemented for a slice: `impl<T>\n");
    buf_bytes(out, b"Second for [T]`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Countdown { n: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Iterator for Countdown {           // std's trait, in the prelude\n");
    buf_bytes(out, b"    type Item = i64;\n");
    buf_bytes(out, b"    fn next(&mut self) -> Option<i64> {\n");
    buf_bytes(out, b"        if self.n == 0 { return None; }\n");
    buf_bytes(out, b"        self.n -= 1;\n");
    buf_bytes(out, b"        Some(self.n + 1)\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn first<I: Iterator>(mut it: I) -> Option<I::Item> {\n");
    buf_bytes(out, b"    it.next()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total<I: Iterator<Item = i64>>(it: I) -> i64 {\n");
    buf_bytes(out, b"    it.sum()                            // a default of Iterator\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"trait Second<T> { fn second(&self) -> &T; }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl<T> Second<T> for [T] {\n");
    buf_bytes(out, b"    fn second(&self) -> &T { &self[1] }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let b = \"xyz\".as_bytes();\n");
    buf_bytes(out, b"    println(\"{} {} {} {}\", first(Countdown { n: 3 }).unwrap(), total(Countdown { n: 4 }),\n");
    buf_bytes(out, b"        Countdown { n: 5 }.count(), *b.second() as char);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3 10 5 y\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Every declared name must be defined: `the impl of trait 'Iterator' is\n");
    buf_bytes(out, b"  missing 'type Item'`.\n");
    buf_bytes(out, b"- A constraint that does not hold names both types: `'Small::Item' is\n");
    buf_bytes(out, b"  'u8', but the bound 'I: Iterator<Item = i64>' of 'total' requires\n");
    buf_bytes(out, b"  'i64'`.\n");
    buf_bytes(out, b"- `F::Output` is the result type of a closure or fn type.\n");
}
