// Generated by compiler/guide/embed.sh from compiler/guide/edition.md (do
// not edit): the guide's topic 'edition'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# The rust edition (0.27.0; its std, std2, since 0.27.2)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A file whose first line is `// EDITION: rust` (or a program compiled\n");
    buf_bytes(out, b"with `--edition rust`) is read with Rust's meanings. It is the same\n");
    buf_bytes(out, b"compiler; since 0.27.2 its std is the edition's own, std2\n");
    buf_bytes(out, b"(compiler/std2): Rust's std, its names, modules and signatures, with\n");
    buf_bytes(out, b"the allocator written (`Vec<T, A>`, `Vec::new_in(gpa)`, `String<A>`,\n");
    buf_bytes(out, b"`HashMap<K, V, A>`). Its prelude is Rust's plus `Gpa`; `Allocator` is\n");
    buf_bytes(out, b"`use std::alloc::Allocator`. The print functions are functions, not\n");
    buf_bytes(out, b"macros: `println(\"{} {x}\", a)`. MVS files, and MVS's std, are read\n");
    buf_bytes(out, b"exactly as before; the edition is per program, from its root file.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## What 0.27.0 reads\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- references: `&T` and `&mut T` as values, `&x`, `&mut x`, `*r`, a field\n");
    buf_bytes(out, b"  or a method through a reference, reborrows (`f(r)` twice with `r: &mut T`);\n");
    buf_bytes(out, b"- receivers `&self`, `&mut self`, `self`, `mut self`; `let mut`, `mut x: T`;\n");
    buf_bytes(out, b"- lifetimes: `'a` in generics, types, bounds and `where`, `&'a T`,\n");
    buf_bytes(out, b"  `impl<'a>`, elision (kept, not checked yet: 0.27.1 checks regions);\n");
    buf_bytes(out, b"- `for` over `&v`, `&mut v`, a slice or `v.iter()` gives `&T` (`&mut T`),\n");
    buf_bytes(out, b"  over a Vec or an array by value the values;\n");
    buf_bytes(out, b"- patterns: match ergonomics through a reference, `ref x`, `ref mut x`,\n");
    buf_bytes(out, b"  `&x`, `&(a, b)`, `&Some(k)`;\n");
    buf_bytes(out, b"- std's `Deref`, `DerefMut`, `Index`, `IndexMut` on your types (`use\n");
    buf_bytes(out, b"  std::ops::{Deref, Index}`): `*w`, `w.f`, `w.m()`, `g[i]`;\n");
    buf_bytes(out, b"- `&impl Trait` and `impl Trait` arguments, `#[derive(Clone, Copy,\n");
    buf_bytes(out, b"  PartialEq, ...)]` (Copy is what a plain type is already);\n");
    buf_bytes(out, b"- `where Self: Sized` and `?Sized` (they say nothing); `*const T` and\n");
    buf_bytes(out, b"  `*mut T`; quoted labels `'outer:`; a trait's defaulted parameter\n");
    buf_bytes(out, b"  (`trait PartialEq<Rhs = Self>`, `impl PartialEq for P`); MVS's `var`,\n");
    buf_bytes(out, b"  `inout`, `sink` and `defer` are names, and so is `union` but before a\n");
    buf_bytes(out, b"  name;\n");
    buf_bytes(out, b"- `&f(x)` of a value: a temporary of its statement, dropped at its end\n");
    buf_bytes(out, b"  (of the block for `let r = &f(x);`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"// EDITION: rust\n");
    buf_bytes(out, b"use std::ops::Index;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Grid {\n");
    buf_bytes(out, b"    cells: [i64; 4],\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Index<usize> for Grid {\n");
    buf_bytes(out, b"    type Output = i64;\n");
    buf_bytes(out, b"    fn index(&self, i: usize) -> &i64 {\n");
    buf_bytes(out, b"        &self.cells[i]\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn bump(v: &mut Vec<i64, Gpa>) {\n");
    buf_bytes(out, b"    for x in v {\n");
    buf_bytes(out, b"        *x += 1;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.push(1);\n");
    buf_bytes(out, b"    bump(&mut v);\n");
    buf_bytes(out, b"    let g = Grid { cells: [5, 6, 7, 8] };\n");
    buf_bytes(out, b"    let mut s = 0;\n");
    buf_bytes(out, b"    for &x in &g.cells {\n");
    buf_bytes(out, b"        s += x;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"{} {} {}\", v[0], g[2], s);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2 7 26\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Translating an MVS program: fix --edition rust (0.27.3)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec fix --edition rust FILE|DIR` rewrites an MVS program, in place,\n");
    buf_bytes(out, b"into the rust edition (`--dry-run`: the diff only). It reads the program\n");
    buf_bytes(out, b"as MVS checks it, so each rewrite follows the types:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- parameters: a let parameter MVS borrows is `&T` (a copy stays `T`),\n");
    buf_bytes(out, b"  `inout T` is `&mut T`, `sink T` is `T`, a view `[T]` is `&[T]` (`[u8]`\n");
    buf_bytes(out, b"  is `&str` when the program uses its bytes as text only); receivers\n");
    buf_bytes(out, b"  `&self`, `&mut self`, `self`;\n");
    buf_bytes(out, b"- calls: the inout marker `&x` is `&mut x`, a value a let parameter\n");
    buf_bytes(out, b"  borrows is given as `&x`, a reference read as a copy or assigned is\n");
    buf_bytes(out, b"  `*r`; std's calls by compiler/std2/rewrite.tsv's rows, chosen by type\n");
    buf_bytes(out, b"  (`v.get(i)` is `v[i]` for a Copy element);\n");
    buf_bytes(out, b"- locals: `var` is `let mut`, `inout r = &e` is `let r = &mut e`, an\n");
    buf_bytes(out, b"  integer literal MVS types as i64 by default gets `: i64`;\n");
    buf_bytes(out, b"- items: a copy type derives Clone and Copy, std's paths are std2's,\n");
    buf_bytes(out, b"  `println(x)` is `println(\"{}\", x)`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"No line moves (the `// EDITION: rust` line ends the root file), so a\n");
    buf_bytes(out, b"position the program prints stays. What it cannot decide is left as\n");
    buf_bytes(out, b"written and counted (`note fix.edition_left`; `--list-left` names each\n");
    buf_bytes(out, b"place); the rust check's errors follow. The MVS program:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total(v: Vec<i64, Gpa>) -> i64 {\n");
    buf_bytes(out, b"    var t = 0;\n");
    buf_bytes(out, b"    for i in 0..v.len() {\n");
    buf_bytes(out, b"        t += v.get(i);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn shift(p: inout Point, d: i64) {\n");
    buf_bytes(out, b"    p.x += d;\n");
    buf_bytes(out, b"    p.y += d;\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn keep(v: sink Vec<i64, Gpa>) -> usize { v.len() }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.push(3);\n");
    buf_bytes(out, b"    v.push(4);\n");
    buf_bytes(out, b"    var p = Point { x: 1, y: 2 };\n");
    buf_bytes(out, b"    shift(&p, 10);\n");
    buf_bytes(out, b"    let q = p;\n");
    buf_bytes(out, b"    println(total(v));\n");
    buf_bytes(out, b"    println(\"{} {} {}\", q.x, q.y, keep(v));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"7\n");
    buf_bytes(out, b"11 12 2\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"and what `fix --edition rust` makes of it, which prints the same:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[derive(Clone, Copy)] struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total(v: &Vec<i64, Gpa>) -> i64 {\n");
    buf_bytes(out, b"    let mut t: i64 = 0;\n");
    buf_bytes(out, b"    for i in 0..v.len() {\n");
    buf_bytes(out, b"        t += v[i];\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn shift(p: &mut Point, d: i64) {\n");
    buf_bytes(out, b"    p.x += d;\n");
    buf_bytes(out, b"    p.y += d;\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn keep(v: Vec<i64, Gpa>) -> usize { v.len() }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.push(3);\n");
    buf_bytes(out, b"    v.push(4);\n");
    buf_bytes(out, b"    let mut p = Point { x: 1, y: 2 };\n");
    buf_bytes(out, b"    shift(&mut p, 10);\n");
    buf_bytes(out, b"    let q = p;\n");
    buf_bytes(out, b"    println(\"{}\", total(&v));\n");
    buf_bytes(out, b"    println(\"{} {} {}\", q.x, q.y, keep(v));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"// EDITION: rust\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"7\n");
    buf_bytes(out, b"11 12 2\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The seams of 0.27.0 and 0.27.1 (MVS std), gone\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Until 0.27.2 the edition ran on MVS's std, and two places differed from\n");
    buf_bytes(out, b"Rust's std, each with its own code: `edition.std_copy` (`*x` of what a\n");
    buf_bytes(out, b"std getter gave, `v.last()`, a copy where Rust's gives `&T`) and\n");
    buf_bytes(out, b"`edition.std_by_value` (`&x` given to a std function taking the value,\n");
    buf_bytes(out, b"`v.contains(&t)`). With std2 both are gone, and so is `edition.lenient`'s\n");
    buf_bytes(out, b"std half: `*v.last().unwrap()` and `v.contains(&t)` are right, as in\n");
    buf_bytes(out, b"Rust. `edition.lenient` stays for a rust-edition function's own\n");
    buf_bytes(out, b"parameters and a `let`'s written type: a `&T` given where its value\n");
    buf_bytes(out, b"goes, or a place where `&T` goes, is an error whose `try:` is Rust's\n");
    buf_bytes(out, b"spelling (`*r`, `&x`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## NLL, the regions solved (0.27.1)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Every rust-edition function's regions are solved on the places IR, as\n");
    buf_bytes(out, b"rustc's NLL does (docs/design/borrowck.md is the rule book; each\n");
    buf_bytes(out, b"message's code names its rule): a reference lives as long as its region\n");
    buf_bytes(out, b"is used; a place is not written, moved, dropped or lent exclusively\n");
    buf_bytes(out, b"while a loan of it is live, nor read while an exclusive loan is; a\n");
    buf_bytes(out, b"receiver's `&mut` is two-phase (`v.push(v.len())` is fine); a\n");
    buf_bytes(out, b"reference to a local does not leave its function; a signature's\n");
    buf_bytes(out, b"lifetimes are what the body must respect (`'a: 'b`, elision as Rust's);\n");
    buf_bytes(out, b"a moved value is not used again (a field moved, the whole is partly\n");
    buf_bytes(out, b"moved; in a loop, \"in a previous iteration\"); a value cannot be moved\n");
    buf_bytes(out, b"out of a reference, an index or a `static`; a value with `impl Drop`\n");
    buf_bytes(out, b"keeps what it references alive until its drop, the std containers\n");
    buf_bytes(out, b"(`Vec`, `String`, `HashMap`, ...) only their elements'. The seventeen\n");
    buf_bytes(out, b"codes are `volec explain --list`'s `borrowck.*` entries (`mut_twice`,\n");
    buf_bytes(out, b"`conflict`, `return_local`, `outlives`, `use_moved`, `move_out`, ...),\n");
    buf_bytes(out, b"each with its rustc code; `volec check --emit-places=regions` prints\n");
    buf_bytes(out, b"each body's liveness, constraints, region values and loans.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"What is not checked (each a named divergence in the rule book): MVS\n");
    buf_bytes(out, b"std's types holding hidden views (0.27.0 to 0.27.1: std2's types carry\n");
    buf_bytes(out, b"their lifetimes, `Iter<'a, T>`); a `&raw` pointer's uses (unsafe's);\n");
    buf_bytes(out, b"rvalue promotion (`&5` is a temporary, not `'static`). Since 0.27.2 a\n");
    buf_bytes(out, b"closure body is checked like any other (its environment is `&Env`,\n");
    buf_bytes(out, b"`&mut Env` or `Env` by its kind, and what it stores or returns from\n");
    buf_bytes(out, b"its captures is checked where the closure is made), so 0.27.1's\n");
    buf_bytes(out, b"`warning borrowck.unchecked` is gone.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## What comes later: edition.later\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"What the edition reads but does not have yet is one soft error,\n");
    buf_bytes(out, b"`edition.later`, naming the feature and its release; the rest of the\n");
    buf_bytes(out, b"program is checked, and an impl or a function the feature is in is left\n");
    buf_bytes(out, b"out (`#[array_builtin(N)]`, a blanket impl, an impl on an instance).\n");
    buf_bytes(out, b"`volec explain edition.later`. Deferred initialization, `let x: T;` and\n");
    buf_bytes(out, b"`let x;` (typed by its first assignment), is the edition's from 0.27.1.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| feature | release |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `where_bound` (a bound on a type that is not a parameter), `array_builtin`, `qualified_path` (a longer path than `<T as Tr>::X`), `auto_trait` (`Send`, `Sync`) | 0.27.2 |\n");
    buf_bytes(out, b"| `impl_trait_return` (`-> impl Tr` at the top of a function's result) | 0.27.2.1 |\n");
    buf_bytes(out, b"| `impl_trait_nested` (`-> Option<impl Tr>`, a trait method's `-> impl Tr`, `let x: impl Tr`) | 0.29 |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"// EDITION: rust\n");
    buf_bytes(out, b"fn adder(k: i64) -> Option<impl Fn(i64) -> i64> {\n");
    buf_bytes(out, b"    None\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```err\n");
    buf_bytes(out, b"error[edition.later] 'impl Fn(i64) -> i64' (impl_trait_nested) comes with the rust edition in 0.29\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Options\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `--edition rust` (`--edition=rust`): the edition without the line.\n");
    buf_bytes(out, b"- `--allow=CODE` (repeatable; a family: `--allow=borrowck`): a warning\n");
    buf_bytes(out, b"  not reported, as rustc's `-A`.\n");
    buf_bytes(out, b"- `--max-errors=N`: stop after N errors, not 50 (0: every error).\n");
}
