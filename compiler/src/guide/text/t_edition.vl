// Generated by compiler/guide/embed.sh from compiler/guide/edition.md (do
// not edit): the guide's topic 'edition'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# The rust edition (0.27.0)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A file whose first line is `// EDITION: rust` (or a program compiled\n");
    buf_bytes(out, "with `--edition rust`) is read with Rust's meanings. It is the same\n");
    buf_bytes(out, "compiler and the same std: the MVS conventions (`let`, `inout`, `sink`)\n");
    buf_bytes(out, "are still what a std function's parameters are, and a rust-edition\n");
    buf_bytes(out, "program calls std as any program does. MVS files are read exactly as\n");
    buf_bytes(out, "before; the edition is per program, from its root file.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## What 0.27.0 reads\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- references: `&T` and `&mut T` as values, `&x`, `&mut x`, `*r`, a field\n");
    buf_bytes(out, "  or a method through a reference, reborrows (`f(r)` twice with `r: &mut T`);\n");
    buf_bytes(out, "- receivers `&self`, `&mut self`, `self`, `mut self`; `let mut`, `mut x: T`;\n");
    buf_bytes(out, "- lifetimes: `'a` in generics, types, bounds and `where`, `&'a T`,\n");
    buf_bytes(out, "  `impl<'a>`, elision (kept, not checked yet: 0.27.1 checks regions);\n");
    buf_bytes(out, "- `for` over `&v`, `&mut v`, a slice or `v.iter()` gives `&T` (`&mut T`),\n");
    buf_bytes(out, "  over a Vec or an array by value the values;\n");
    buf_bytes(out, "- patterns: match ergonomics through a reference, `ref x`, `ref mut x`,\n");
    buf_bytes(out, "  `&x`, `&(a, b)`, `&Some(k)`;\n");
    buf_bytes(out, "- std's `Deref`, `DerefMut`, `Index`, `IndexMut` on your types (`use\n");
    buf_bytes(out, "  std::ops::{Deref, Index}`): `*w`, `w.f`, `w.m()`, `g[i]`;\n");
    buf_bytes(out, "- `&impl Trait` and `impl Trait` arguments, `#[derive(Clone, Copy,\n");
    buf_bytes(out, "  PartialEq, ...)]` (Copy is what a plain type is already);\n");
    buf_bytes(out, "- `where Self: Sized` (it says nothing); `*const T` and `*mut T`;\n");
    buf_bytes(out, "  quoted labels `'outer:`; MVS's `var`, `inout`, `sink` and `defer` are\n");
    buf_bytes(out, "  names.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "// EDITION: rust\n");
    buf_bytes(out, "use std::ops::Index;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Grid {\n");
    buf_bytes(out, "    cells: [i64; 4],\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Index<usize> for Grid {\n");
    buf_bytes(out, "    type Output = i64;\n");
    buf_bytes(out, "    fn index(&self, i: usize) -> &i64 {\n");
    buf_bytes(out, "        &self.cells[i]\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn bump(v: &mut Vec<i64, Gpa>) {\n");
    buf_bytes(out, "    for x in v {\n");
    buf_bytes(out, "        *x += 1;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    v.push(1);\n");
    buf_bytes(out, "    bump(&mut v);\n");
    buf_bytes(out, "    let g = Grid { cells: [5, 6, 7, 8] };\n");
    buf_bytes(out, "    let mut s = 0;\n");
    buf_bytes(out, "    for &x in &g.cells {\n");
    buf_bytes(out, "        s += x;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(\"{} {} {}\", v[0], g[2], s);\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "2 7 26\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## The seams of 0.27.0 (MVS std)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "0.27.0's edition runs on MVS's std. Two places differ from Rust's std,\n");
    buf_bytes(out, "each with its own code; 0.27.2's std removes both:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| code | where | fix |\n");
    buf_bytes(out, "|---|---|---|\n");
    buf_bytes(out, "| `edition.std_copy` | `*x` of what a std getter gives (`v.get(i)`, `v.last()`, a map's `get`): a copy, where Rust's give `&T` | the value as it is (`try:`) |\n");
    buf_bytes(out, "| `edition.std_by_value` | `&x` given to a std function that takes the value (`v.contains(&t)` of Strings, `m.insert(k, v)`) | `x.clone()`, `x`, or `*x` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A generic `let` parameter of std's is `&T` or `T` per instance (a copy\n");
    buf_bytes(out, "for a plain T); a `&x` given to one is lent, as Rust's `v.contains(&3)`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The edition is lenient where MVS's 0.19 meanings are (`edition.lenient`,\n");
    buf_bytes(out, "closed in 0.27.1): a `&T` of a plain value (a number, a struct of\n");
    buf_bytes(out, "numbers) is read where the value goes, and a place is lent where `&T`\n");
    buf_bytes(out, "goes. A program Rust accepts means the same; some that Rust rejects\n");
    buf_bytes(out, "compile.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Regions, not solved yet\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "0.27.0 builds each rust-edition function's region variables (a loan per\n");
    buf_bytes(out, "`&x`, one per reference in a parameter's or a local's type, one per call\n");
    buf_bytes(out, "whose result holds a reference: `volec check --emit-places` prints them,\n");
    buf_bytes(out, "`&'r3 _1`), and solves none yet: every such function is one warning,\n");
    buf_bytes(out, "`borrowck.unchecked` (`--allow=borrowck.unchecked` leaves it out).\n");
    buf_bytes(out, "0.27.1's NLL solves them.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## What comes later: edition.later\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "What the edition reads but 0.27.0 does not have is one soft error,\n");
    buf_bytes(out, "`edition.later`, naming the feature and its release; the rest of the\n");
    buf_bytes(out, "program is checked, and an impl or a function the feature is in is left\n");
    buf_bytes(out, "out (`#[array_builtin(N)]`, a blanket impl, an impl on an instance).\n");
    buf_bytes(out, "`volec explain edition.later`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| feature | release |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `const_ptr_write` (a write through `*const T`), `deferred_init` (`let x;`) | 0.27.1 |\n");
    buf_bytes(out, "| `char`, `fn_once`, `impl_trait_return`, `where_bound`, `tuple_struct`, `supertrait`, `assoc_bounds`, `impl_for_ref`, `assoc_const`, `array_builtin`, `blanket_impl`, `impl_on_instance`, `return_inference` | 0.27.2 |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "// EDITION: rust\n");
    buf_bytes(out, "fn call<F: FnOnce() -> i64>(f: F) -> i64 {\n");
    buf_bytes(out, "    f()\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```err\n");
    buf_bytes(out, "error[edition.later] 'FnOnce' (fn_once) comes with the rust edition in 0.27.2\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Options\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `--edition rust` (`--edition=rust`): the edition without the line.\n");
    buf_bytes(out, "- `--allow=CODE` (repeatable; a family: `--allow=borrowck`): a warning\n");
    buf_bytes(out, "  not reported, as rustc's `-A`.\n");
}
