// Generated by compiler/guide/embed.sh from compiler/guide/threads.md (do
// not edit): the guide's topic 'threads'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Threads\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Threads, atomics, locks and channels (0.21; the design is\n");
    buf_bytes(out, b"docs/design/concurrency.md). Safe code cannot make a data race: what\n");
    buf_bytes(out, b"crosses threads is checked where a thread starts, from the types (Rust's\n");
    buf_bytes(out, b"`Send` and `Sync`, inferred) and the effects (no `static var` on another\n");
    buf_bytes(out, b"thread). The errors are `sync.*` (`volec explain sync.global`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Atomics\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::sync::atomic` has `Atomic<T>` for integers, `bool` and raw\n");
    buf_bytes(out, b"pointers, with Rust's names as aliases (`AtomicI64`, `AtomicU32`,\n");
    buf_bytes(out, b"`AtomicBool`, `AtomicPtr<T>`...) and Rust's methods: `load`, `store`,\n");
    buf_bytes(out, b"`swap`, `compare_exchange` (`Ok(old)` or `Err(found)`), `fetch_add`,\n");
    buf_bytes(out, b"`fetch_sub`, `fetch_and`, `fetch_or`, `fetch_xor`, `fetch_nand`,\n");
    buf_bytes(out, b"`fetch_max`, `fetch_min`, `into_inner`, and `fence(order)`. (0.25.5) The\n");
    buf_bytes(out, b"bound `T: AtomicValue` checks T (`Atomic<f64>` or of a struct: \"the trait\n");
    buf_bytes(out, b"'AtomicValue' is not implemented for 'f64'\"); the arithmetic is the\n");
    buf_bytes(out, b"integers' (`AtomicInteger`), `fetch_and`/`or`/`xor` also bool's\n");
    buf_bytes(out, b"(`AtomicBitwise`); no program can implement these traits. The orderings\n");
    buf_bytes(out, b"are C++'s (`Ordering::Relaxed`, `Acquire`, `Release`, `AcqRel`,\n");
    buf_bytes(out, b"`SeqCst`); one an operation cannot have (a load with `Release`) is made\n");
    buf_bytes(out, b"`SeqCst`. An atomic is move-only (0.26.1: it holds an UnsafeCell, `guide\n");
    buf_bytes(out, b"memory#cells`, so a `#[pure]` function or a contract may not use one). A\n");
    buf_bytes(out, b"static one needs no `var` (and so has no `global`): `static HITS:\n");
    buf_bytes(out, b"AtomicI64 = AtomicI64::new(0);`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::sync::atomic::{AtomicI64, Ordering};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let n = AtomicI64::new(5);\n");
    buf_bytes(out, b"    let old = n.fetch_add(3, Ordering::Relaxed);\n");
    buf_bytes(out, b"    let r = n.compare_exchange(8, 10, Ordering::AcqRel, Ordering::Acquire);\n");
    buf_bytes(out, b"    println(\"{old} {} {}\", r.is_ok(), n.load(Ordering::SeqCst));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"5 true 10\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"On AArch64 they are `ldar`/`stlr` and LSE's `ldadd`, `cas`, `swp`... on\n");
    buf_bytes(out, b"macOS, exclusive-pair loops (`ldxr`/`stxr`) on Linux (`--atomics=lse` or\n");
    buf_bytes(out, b"`--atomics=llsc` chooses). The optimizer moves no memory access across an\n");
    buf_bytes(out, b"atomic or a fence, and invents no store to memory another thread may see.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Threads\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::thread::spawn(sink || ...)` runs the closure on a new thread; its\n");
    buf_bytes(out, b"handle's `join()` waits and gives the result (a panic in any thread stops\n");
    buf_bytes(out, b"the program, so there is no `Result` to unwrap). The closure is a `sink`\n");
    buf_bytes(out, b"one: the thread may outlive the caller, so it takes owned values (a Vec\n");
    buf_bytes(out, b"moves in), no views (`sync.borrow_escapes`) and no raw pointers\n");
    buf_bytes(out, b"(`sync.not_send`). `thread::scope(|s| ...)` joins every thread started\n");
    buf_bytes(out, b"with `s.spawn` before it returns, so those may use the caller's values\n");
    buf_bytes(out, b"and views; while the scope runs its closure changes nothing they use\n");
    buf_bytes(out, b"(`sync.scope_write`; a counter no thread uses is fine), and a scoped\n");
    buf_bytes(out, b"thread only reads what it is given (`sync.scope_shared_write`, also for\n");
    buf_bytes(out, b"`&v`, `&a[..]`, `v[i] = x` and `a.sort()`: return results through `join`,\n");
    buf_bytes(out, b"or use a Mutex or an atomic; two threads cannot yet each write their own\n");
    buf_bytes(out, b"part of one slice, there is no `split_at_mut`). Neither the scope nor a\n");
    buf_bytes(out, b"scoped thread's handle leaves `thread::scope` (`sync.scope_escape`): join\n");
    buf_bytes(out, b"inside and return the results. No thread may reach a `static var` (`sync.global`; `query\n");
    buf_bytes(out, b"effects FILE:LINE --why static` shows the chain); printing is fine.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::thread;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn sum(s: [i64]) -> i64 {\n");
    buf_bytes(out, b"    var t = 0;\n");
    buf_bytes(out, b"    for x in s { t += x; }\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    for i in 0..1000 { v.push(i); }\n");
    buf_bytes(out, b"    let s = v.as_slice();\n");
    buf_bytes(out, b"    let total = thread::scope(|sc| {\n");
    buf_bytes(out, b"        let a = sc.spawn(|| sum(s[0..500]));\n");
    buf_bytes(out, b"        let b = sc.spawn(|| sum(s[500..]));\n");
    buf_bytes(out, b"        a.join() + b.join()\n");
    buf_bytes(out, b"    });\n");
    buf_bytes(out, b"    let h = thread::spawn(sink || v.len());\n");
    buf_bytes(out, b"    println(\"{total} {}\", h.join());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"499500 1000\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`thread::yield_now()`, `thread::available_parallelism()`. Printing is safe\n");
    buf_bytes(out, b"from any thread: once threads run, each print holds a lock, so output\n");
    buf_bytes(out, b"never interleaves.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Mutex, Once, Condvar and channels\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::sync::Mutex<T>` owns its data: `m.with(|data| ...)` locks, runs the\n");
    buf_bytes(out, b"closure and unlocks (`try_with` when the lock is free now), the way to\n");
    buf_bytes(out, b"reach the data in 0.21.0. The closure's result may not view the data,\n");
    buf_bytes(out, b"nor may it store a view of it elsewhere (`own.escape`: the lock is\n");
    buf_bytes(out, b"released when `with` returns): copy out what you need. Scoped threads share the Mutex (and an atomic). `m.lock()` gives a guard that unlocks when dropped, but it is\n");
    buf_bytes(out, b"`unsafe` and internal until a type holding a view may implement Drop\n");
    buf_bytes(out, b"(0.21.x): nothing keeps the guard inside the mutex's life yet. `Once`'s\n");
    buf_bytes(out, b"`call_once(f)` runs f once whatever the threads; `Condvar`'s\n");
    buf_bytes(out, b"`wait_then(m, ready, then)` sleeps until `ready(data)`, then runs `then`\n");
    buf_bytes(out, b"under the lock (`notify_one`, `notify_all`). There is no poisoning.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::sync::mpsc::channel_in(gpa)` gives a `Sender` (clone it for more\n");
    buf_bytes(out, b"senders) and a `Receiver`: `send(x)` fails, giving `x` back, when the\n");
    buf_bytes(out, b"receiver is gone; `recv()` waits, and fails when every sender is gone and\n");
    buf_bytes(out, b"nothing is left; `for x in rx.iter()` runs until then. What a channel\n");
    buf_bytes(out, b"carries, a Mutex holds and `with`'s closure returns is no view\n");
    buf_bytes(out, b"(`sync.view_item`): it comes out elsewhere, later, maybe after what it\n");
    buf_bytes(out, b"views is gone; send an owned copy (`s.to_vec_in(gpa)`,\n");
    buf_bytes(out, b"`s.to_string_in(gpa)`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::thread;\n");
    buf_bytes(out, b"use std::sync::{Mutex, mpsc};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let count = Mutex::new(0);\n");
    buf_bytes(out, b"    let total = thread::scope(|s| {\n");
    buf_bytes(out, b"        let (tx, rx) = mpsc::channel_in::<i64>(gpa);\n");
    buf_bytes(out, b"        s.spawn(sink || {\n");
    buf_bytes(out, b"            for i in 1..=10 { tx.send(i).unwrap(); }\n");
    buf_bytes(out, b"            0\n");
    buf_bytes(out, b"        });\n");
    buf_bytes(out, b"        s.spawn(|| {\n");
    buf_bytes(out, b"            for _ in 0..10 { count.with(|n| n += 1); }\n");
    buf_bytes(out, b"            0\n");
    buf_bytes(out, b"        });\n");
    buf_bytes(out, b"        var sum = 0;\n");
    buf_bytes(out, b"        for x in rx.iter() { sum += x; }\n");
    buf_bytes(out, b"        sum\n");
    buf_bytes(out, b"    });\n");
    buf_bytes(out, b"    println(\"{total} {}\", count.with(|n| n));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"55 10\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The locks wait on a futex (Linux) or `__ulock` (macOS).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Cells and threads\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"*(0.26.1)* A `Cell` (`guide memory#cells`) is Send when its value is and\n");
    buf_bytes(out, b"never Sync: a scoped thread may not share one (`sync.not_sync`), and an\n");
    buf_bytes(out, b"immutable `static` of one is `sync.static`. Keep a cell in a `static var`\n");
    buf_bytes(out, b"(the main thread's) or a `#[thread_local] static var` (one per thread),\n");
    buf_bytes(out, b"or share an atomic or a Mutex instead:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::cell::Cell;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[thread_local]\n");
    buf_bytes(out, b"static var CALLS: Cell<i64> = Cell::new(0);\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn work() -> i64 {\n");
    buf_bytes(out, b"    CALLS.set(CALLS.get() + 1);\n");
    buf_bytes(out, b"    CALLS.get()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    work();\n");
    buf_bytes(out, b"    println(\"{}\", work());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Thread-locals\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`#[thread_local] static var X: T = INIT;` gives each thread its own `X`,\n");
    buf_bytes(out, b"made from `INIT` when the thread first uses it. Using one is safe; its\n");
    buf_bytes(out, b"effect is `tls`, not `global`. A thread-local's drop does not run.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::thread;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[thread_local]\n");
    buf_bytes(out, b"static var CALLS: i64 = 0;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn work() -> i64 {\n");
    buf_bytes(out, b"    for _ in 0..3 { CALLS += 1; }\n");
    buf_bytes(out, b"    CALLS\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let h = thread::spawn(sink || work());\n");
    buf_bytes(out, b"    CALLS = 100;\n");
    buf_bytes(out, b"    println(\"{} {CALLS}\", h.join());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3 100\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Effects\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Three effects (0.21): `sync` (an atomic, a fence, a lock, a join, a\n");
    buf_bytes(out, b"channel), `thread` (starting a thread) and `tls` (a thread-local).\n");
    buf_bytes(out, b"`query effects f` shows them; `#[pure]` excludes them.\n");
}
