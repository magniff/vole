// Generated by compiler/guide/embed.sh from compiler/guide/threads.md (do
// not edit): the guide's topic 'threads'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Threads\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Threads and atomics, Rust's. Safe code cannot make a data race: what\n");
    buf_bytes(out, b"crosses threads is checked where a thread starts, from the types\n");
    buf_bytes(out, b"(`Send` and `Sync`, inferred, as in Rust) and the borrow checker. The\n");
    buf_bytes(out, b"errors are `sync.*` (`volec explain sync.not_send`) and `borrowck.*`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Atomics\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::sync::atomic` has `Atomic<T>` for integers, `bool` and raw\n");
    buf_bytes(out, b"pointers, with Rust's names as aliases (`AtomicI64`, `AtomicU32`,\n");
    buf_bytes(out, b"`AtomicUsize`, `AtomicBool`, `AtomicPtr<T>`...) and Rust's methods:\n");
    buf_bytes(out, b"`new`, `load`, `store`, `swap`, `compare_exchange` (`Ok(old)` or\n");
    buf_bytes(out, b"`Err(found)`), `compare_exchange_weak`, `fetch_add`, `fetch_sub`,\n");
    buf_bytes(out, b"`fetch_and`, `fetch_or`, `fetch_xor`, `fetch_nand`, `fetch_max`,\n");
    buf_bytes(out, b"`fetch_min`, `get_mut`, `into_inner`, and `fence(order)`,\n");
    buf_bytes(out, b"`compiler_fence(order)`. The bound `T: AtomicValue` checks T\n");
    buf_bytes(out, b"(`Atomic<f64>`: \"the trait 'AtomicValue' is not implemented for\n");
    buf_bytes(out, b"'f64'\"); no program can implement it. The orderings are Rust's\n");
    buf_bytes(out, b"(`Ordering::Relaxed`, `Acquire`, `Release`, `AcqRel`, `SeqCst`). An\n");
    buf_bytes(out, b"atomic is Sync, so a plain `static` of one is shared by every thread:\n");
    buf_bytes(out, b"`static HITS: AtomicI64 = AtomicI64::new(0);`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::sync::atomic::{AtomicI64, Ordering};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let n = AtomicI64::new(5);\n");
    buf_bytes(out, b"    let old = n.fetch_add(3, Ordering::Relaxed);\n");
    buf_bytes(out, b"    let r = n.compare_exchange(8, 10, Ordering::AcqRel, Ordering::Acquire);\n");
    buf_bytes(out, b"    println(\"{old} {} {}\", r.is_ok(), n.load(Ordering::SeqCst));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"5 true 10\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"On AArch64 they are `ldar`/`stlr` and LSE's `ldadd`, `cas`, `swp`... on\n");
    buf_bytes(out, b"macOS, exclusive-pair loops (`ldxr`/`stxr`) on Linux (`--atomics=lse` or\n");
    buf_bytes(out, b"`--atomics=llsc` chooses). The optimizer moves no memory access across an\n");
    buf_bytes(out, b"atomic or a fence, and invents no store to memory another thread may see.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Threads\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::thread::spawn_in(f, gpa)` runs the closure on a new thread (Rust's\n");
    buf_bytes(out, b"`spawn`, with the allocator its closure and result live on until the\n");
    buf_bytes(out, b"join); its handle's `join()` waits and gives `Ok(result)`. The closure\n");
    buf_bytes(out, b"is `FnOnce() -> T + Send + 'static`: the thread may outlive the caller,\n");
    buf_bytes(out, b"so it owns what it captures (`move`), and a borrow of a local is\n");
    buf_bytes(out, b"`borrowck.dropped_borrowed`; a raw pointer is not Send\n");
    buf_bytes(out, b"(`sync.not_send`). `thread::scope(|s| ...)` joins every thread started\n");
    buf_bytes(out, b"with `s.spawn(..)` before it returns, so those may borrow the caller's\n");
    buf_bytes(out, b"locals, shared or (one thread) mutably, as the borrow checker allows.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::sync::atomic::{AtomicI64, Ordering};\n");
    buf_bytes(out, b"use std::thread;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"static HITS: AtomicI64 = AtomicI64::new(0);\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn sum(s: &[i64]) -> i64 {\n");
    buf_bytes(out, b"    let mut t = 0;\n");
    buf_bytes(out, b"    for x in s { t += *x; }\n");
    buf_bytes(out, b"    HITS.fetch_add(1, Ordering::Relaxed);\n");
    buf_bytes(out, b"    t\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    for i in 0..1000 { v.push(i); }\n");
    buf_bytes(out, b"    let s = v.as_slice();\n");
    buf_bytes(out, b"    let total = thread::scope(|sc| {\n");
    buf_bytes(out, b"        let a = sc.spawn(|| sum(&s[0..500]));\n");
    buf_bytes(out, b"        let b = sc.spawn(|| sum(&s[500..]));\n");
    buf_bytes(out, b"        a.join().unwrap() + b.join().unwrap()\n");
    buf_bytes(out, b"    });\n");
    buf_bytes(out, b"    let h = thread::spawn_in(move || v.len(), gpa);\n");
    buf_bytes(out, b"    println(\"{total} {} {}\", h.join().unwrap(), HITS.load(Ordering::Relaxed));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"499500 1000 2\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`thread::yield_now()`, `thread::sleep(d)`, `thread::available_parallelism()`\n");
    buf_bytes(out, b"(a `usize`). Printing is safe from any thread: once threads run, each\n");
    buf_bytes(out, b"print holds a lock, so output never interleaves.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Locks, Arc, channels\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::sync` has Rust's `Mutex<T>` (`m.lock().unwrap()` gives a guard:\n");
    buf_bytes(out, b"`*g` is the data, methods go through it, `g.push(3)`, an index needs\n");
    buf_bytes(out, b"`(*g)[0]`; dropping the guard unlocks; `try_lock`), `RwLock<T>`\n");
    buf_bytes(out, b"(`read`, `write`), `Condvar` (`wait(guard)`, `notify_one`,\n");
    buf_bytes(out, b"`notify_all`), `Once` (`call_once`) and `Arc<T, A>`\n");
    buf_bytes(out, b"(`Arc::new_in(x, gpa)`, `clone()`: a counted pointer for threads that\n");
    buf_bytes(out, b"cannot borrow). There is no poisoning: a panic in any thread stops the\n");
    buf_bytes(out, b"program, so `lock()` and `join()` are always `Ok`. A scoped thread\n");
    buf_bytes(out, b"borrows a Mutex; a `spawn_in` thread takes an `Arc` of one.\n");
    buf_bytes(out, b"`std::sync::mpsc::channel_in(gpa)` gives a `(Sender, Receiver)` pair:\n");
    buf_bytes(out, b"`tx.send(x)` (an `Err` with the value when the receiver is gone),\n");
    buf_bytes(out, b"`tx.clone()` for each producer, `rx.recv()`, `rx.try_recv()`, and\n");
    buf_bytes(out, b"`rx.iter()`, which ends when every sender is dropped.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::sync::mpsc;\n");
    buf_bytes(out, b"use std::sync::{Arc, Mutex};\n");
    buf_bytes(out, b"use std::thread;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let hits = Mutex::new(0);\n");
    buf_bytes(out, b"    let total = thread::scope(|sc| {\n");
    buf_bytes(out, b"        let (tx, rx) = mpsc::channel_in(gpa);\n");
    buf_bytes(out, b"        for k in 1..4 {\n");
    buf_bytes(out, b"            let tx = tx.clone();\n");
    buf_bytes(out, b"            let hits = &hits;\n");
    buf_bytes(out, b"            sc.spawn(move || {\n");
    buf_bytes(out, b"                *hits.lock().unwrap() += 1;\n");
    buf_bytes(out, b"                tx.send(k * 10).unwrap();\n");
    buf_bytes(out, b"            });\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        drop(tx);\n");
    buf_bytes(out, b"        let mut t = 0;\n");
    buf_bytes(out, b"        for x in rx.iter() { t += x; }\n");
    buf_bytes(out, b"        t\n");
    buf_bytes(out, b"    });\n");
    buf_bytes(out, b"    let shared = Arc::new_in(Mutex::new(Vec::new_in(gpa)), gpa);\n");
    buf_bytes(out, b"    let theirs = shared.clone();\n");
    buf_bytes(out, b"    let h = thread::spawn_in(move || theirs.lock().unwrap().push(7), gpa);\n");
    buf_bytes(out, b"    h.join().unwrap();\n");
    buf_bytes(out, b"    let g = shared.lock().unwrap();\n");
    buf_bytes(out, b"    println(\"{total} {} {} {}\", hits.lock().unwrap(), g.len(), (*g)[0]);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"60 3 1 7\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Thread-locals\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`#[thread_local] static mut X: T = INIT;` gives each thread its own `X`,\n");
    buf_bytes(out, b"made from `INIT` when the thread first uses it; using it is `unsafe`, as\n");
    buf_bytes(out, b"any `static mut`. A thread-local's drop does not run. A `static` of a\n");
    buf_bytes(out, b"`Cell` is `sync.static` (a Cell is not Sync).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::thread;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[thread_local]\n");
    buf_bytes(out, b"static mut CALLS: i64 = 0;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn work() -> i64 {\n");
    buf_bytes(out, b"    for _ in 0..3 { unsafe { CALLS += 1; } }\n");
    buf_bytes(out, b"    unsafe { CALLS }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let h = thread::spawn_in(|| work(), gpa);\n");
    buf_bytes(out, b"    unsafe { CALLS = 100; }\n");
    buf_bytes(out, b"    println(\"{} {}\", h.join().unwrap(), unsafe { CALLS });\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3 100\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Effects\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Three effects: `sync` (an atomic, a fence, a join), `thread` (starting a\n");
    buf_bytes(out, b"thread) and `tls` (a thread-local). `query effects f` shows them;\n");
    buf_bytes(out, b"`#[pure]` excludes them.\n");
}
