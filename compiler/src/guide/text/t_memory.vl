// Generated by compiler/guide/embed.sh from compiler/guide/memory.md (do
// not edit): the guide's topic 'memory'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Memory\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Rust's ownership. Each value has one owner: `let w = v;`, an argument\n");
    buf_bytes(out, b"passed by value and `return v` move it (a `Copy` value is copied), and\n");
    buf_bytes(out, b"the owner drops it at the end of its scope. References borrow it: `&T`\n");
    buf_bytes(out, b"shared, `&mut T` exclusive, checked by the borrow checker, with\n");
    buf_bytes(out, b"lifetimes (`'a`) where a signature needs them. There is no garbage\n");
    buf_bytes(out, b"collector and no reference counting; memory comes from an allocator,\n");
    buf_bytes(out, b"written in the type (`Vec<i64, Gpa>`, `guide allocators`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Copy and move\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `Copy` types are copied bit for bit: integers, floats, `bool`,\n");
    buf_bytes(out, b"  `char`, `&T`, raw pointers, `fn` pointers, tuples and arrays of `Copy`\n");
    buf_bytes(out, b"  types, and a struct or enum that derives `Clone, Copy` (its fields all\n");
    buf_bytes(out, b"  `Copy`). A struct without the derive moves, as in Rust.\n");
    buf_bytes(out, b"- Everything else moves: `Vec`, `String`, `HashMap`, `Box`, a type with\n");
    buf_bytes(out, b"  `Drop`, a struct holding one. A use after the move is\n");
    buf_bytes(out, b"  `borrowck.use_moved` (rustc E0382), whose help says where it moved:\n");
    buf_bytes(out, b"  use it before, pass a `.clone()`, or lend it (`&v`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Borrowing\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A parameter's type says what the function does with the argument:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| written | the callee | the caller writes |\n");
    buf_bytes(out, b"|---|---|---|\n");
    buf_bytes(out, b"| `v: &Vec<i64, Gpa>` | reads it | `total(&v)` |\n");
    buf_bytes(out, b"| `v: &mut Vec<i64, Gpa>` | may change it; the change reaches the caller | `fill(&mut v)` |\n");
    buf_bytes(out, b"| `v: Vec<i64, Gpa>` | owns it (keeps it or drops it) | `keep(v)`: v moves |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn total(v: &Vec<i64, Gpa>) -> i64 { // reads, no copy\n");
    buf_bytes(out, b"    let mut s = 0;\n");
    buf_bytes(out, b"    for x in v { s += *x; }\n");
    buf_bytes(out, b"    s\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn fill(v: &mut Vec<i64, Gpa>, n: i64) { // changes the caller's Vec\n");
    buf_bytes(out, b"    for i in 0..n { v.push(i * i); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn keep(all: &mut Vec<Vec<i64, Gpa>, Gpa>, v: Vec<i64, Gpa>) { // takes v\n");
    buf_bytes(out, b"    all.push(v);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn make(n: i64, gpa: Gpa) -> Vec<i64, Gpa> { // the caller owns the result\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    fill(&mut v, n);\n");
    buf_bytes(out, b"    v                                    // moved out: not dropped here\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let v = make(4, gpa);\n");
    buf_bytes(out, b"    let w = v.clone();                   // a copy; `let w = v;` moves v\n");
    buf_bytes(out, b"    println(\"{} {} {}\", total(&v), total(&w), w.len());\n");
    buf_bytes(out, b"    let mut all: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    keep(&mut all, w);                   // w is dead from here\n");
    buf_bytes(out, b"    println(\"{}\", all.len());\n");
    buf_bytes(out, b"}                                        // all (and w in it), then v, dropped (freed)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"14 14 4\n");
    buf_bytes(out, b"1\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- At each point a place has any number of shared borrows or one\n");
    buf_bytes(out, b"  mutable one, never both. A borrow lasts until its last use, not to\n");
    buf_bytes(out, b"  the end of its block. `v.push(v.len())` is fine (the argument is read\n");
    buf_bytes(out, b"  before the receiver's mutable borrow starts).\n");
    buf_bytes(out, b"- The errors, with rustc's codes: `borrowck.conflict` (E0502),\n");
    buf_bytes(out, b"  `borrowck.mut_twice` (E0499), `borrowck.assign_borrowed` (E0506),\n");
    buf_bytes(out, b"  `borrowck.move_out` (E0507, E0508), `borrowck.dropped_borrowed`\n");
    buf_bytes(out, b"  (E0597, E0716), `borrowck.borrow_immutable` (E0596),\n");
    buf_bytes(out, b"  `borrowck.elision` (E0106), `borrowck.outlives` (a lifetime too\n");
    buf_bytes(out, b"  short). Each one's help names the fix.\n");
    buf_bytes(out, b"- A binding changes only if declared `let mut x`; `&mut x` or a `&mut\n");
    buf_bytes(out, b"  self` method (`x.push(1)`) of a `let x` is an error (E0596).\n");
    buf_bytes(out, b"- Receivers: `fn len(&self)`, `fn push(&mut self, x: T)`, `fn\n");
    buf_bytes(out, b"  finish(self)`. A method call borrows its receiver itself: `v.push(1)`\n");
    buf_bytes(out, b"  is `Vec::push(&mut v, 1)`.\n");
    buf_bytes(out, b"- Lifetimes, Rust's: a result that borrows from the one reference\n");
    buf_bytes(out, b"  parameter (or from `&self`) needs none written; otherwise name it,\n");
    buf_bytes(out, b"  `fn longest<'a>(a: &'a str, b: &'a str) -> &'a str`\n");
    buf_bytes(out, b"  (`borrowck.elision` says so). A struct that holds a reference takes\n");
    buf_bytes(out, b"  one: `struct Parser<'a> { text: &'a str }`. A reference to a function's\n");
    buf_bytes(out, b"  own local cannot leave it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Moves and drops\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- At the end of a scope its owned locals are dropped, last declared\n");
    buf_bytes(out, b"  first, on every exit (`return`, `break`, `?`), not on an `exit` or a\n");
    buf_bytes(out, b"  panic. A moved value is not dropped where it was.\n");
    buf_bytes(out, b"- A temporary (a call's result that is lent, read or matched and not\n");
    buf_bytes(out, b"  bound: `total(&make())`, `make().len()`) is dropped at the end of its\n");
    buf_bytes(out, b"  statement, the last made first; a block's tail expression's before\n");
    buf_bytes(out, b"  the block's locals; `let r = &make();` keeps it to the end of the\n");
    buf_bytes(out, b"  block. An `if let`'s scrutinee's are dropped before its `else` block\n");
    buf_bytes(out, b"  runs, and at the end of the matching block (Rust 2024's rule): in\n");
    buf_bytes(out, b"  `if let Some(n) = lock(c).peek() { .. } else { c.n += 1; }` the guard\n");
    buf_bytes(out, b"  is gone in the else block. So are a `let .. else`'s before its else\n");
    buf_bytes(out, b"  block, and a `while let`'s at each iteration's end. A `match` keeps\n");
    buf_bytes(out, b"  its scrutinee's to the end of its statement.\n");
    buf_bytes(out, b"- `impl Drop for T { fn drop(&mut self) { ... } }` runs code at the\n");
    buf_bytes(out, b"  drop; a type without one drops its fields. `drop(x)` drops early,\n");
    buf_bytes(out, b"  `std::mem::forget(x)` never (a leak, safe); calling `x.drop()` is an\n");
    buf_bytes(out, b"  error (rustc E0040).\n");
    buf_bytes(out, b"- A guard is a struct whose `Drop` releases what it holds (closes a\n");
    buf_bytes(out, b"  descriptor, restores the terminal), made where the resource is taken:\n");
    buf_bytes(out, b"  `let _closer = Closer { fd };` runs its drop on every exit of the\n");
    buf_bytes(out, b"  scope, after the locals made later (`let _ = ..` drops at once).\n");
    buf_bytes(out, b"- A `match`, `if let` or `let Two { a, .. } = t` by value moves only the\n");
    buf_bytes(out, b"  parts it binds; the rest stays in `t` and is dropped with it.\n");
    buf_bytes(out, b"  `v[i] = x` drops the element it replaces.\n");
    buf_bytes(out, b"- `let x = v[i];` of an element that is not `Copy` would move it out of\n");
    buf_bytes(out, b"  the Vec: `borrowck.move_out`. Borrow it (`&v[i]`), clone it, or take\n");
    buf_bytes(out, b"  it with `std::mem::replace(&mut v[i], new)` or `Option::take`\n");
    buf_bytes(out, b"  (`std::mem::take` for a type with `Default`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Slices\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A slice `&[T]` borrows its owner's elements: `v.as_slice()`, `&v[a..b]`,\n");
    buf_bytes(out, b"`s.as_bytes()`. While it is used, its owner does not grow, shrink or\n");
    buf_bytes(out, b"drop (`borrowck.conflict`), so a slice never points at freed memory. Use\n");
    buf_bytes(out, b"the slice before the change, then borrow again, or keep an index:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.push(1);\n");
    buf_bytes(out, b"    let s = v.as_slice();\n");
    buf_bytes(out, b"    print(\"{} \", s[0]);                  // s's last use: before the pushes\n");
    buf_bytes(out, b"    for i in 0..100 { v.push(i); }       // may move the elements\n");
    buf_bytes(out, b"    let s2 = v.as_slice();               // a fresh borrow\n");
    buf_bytes(out, b"    println(\"{}\", s2.len());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"1 101\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec --check-alloc` (0.16) also checks at run time: every Gpa block\n");
    buf_bytes(out, b"on pages of its own, so a use after free (through `unsafe` code) faults\n");
    buf_bytes(out, b"and is reported with where the block was allocated and freed; bad frees\n");
    buf_bytes(out, b"and leaks are reported too.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Cells\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::cell::Cell<T>` is a value that changes through a shared\n");
    buf_bytes(out, b"reference, Rust's Cell: `get` (a copy, `T: Copy`), `set`, `replace`,\n");
    buf_bytes(out, b"`take`, `swap`, `update`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::cell::Cell;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Counter { hits: Cell<i64> }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn hit(c: &Counter) { c.hits.set(c.hits.get() + 1); }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let c = Counter { hits: Cell::new(0) };\n");
    buf_bytes(out, b"    hit(&c);\n");
    buf_bytes(out, b"    hit(&c);\n");
    buf_bytes(out, b"    let arr = [Cell::new(1i64), Cell::new(2)];\n");
    buf_bytes(out, b"    for x in &arr { x.set(x.get() * 10); }\n");
    buf_bytes(out, b"    println(\"{} {}\", c.hits.get(), arr[1].get());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2 20\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `UnsafeCell<T>` is the primitive under Cell, the atomics and Mutex:\n");
    buf_bytes(out, b"  `get` gives a `*mut T` to write through in `unsafe`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Raw memory\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`malloc` and `free` from C, raw `*const T` and `*mut T` pointers, in\n");
    buf_bytes(out, b"`unsafe` (`volec guide unsafe`). `volec --check-unsafe -O1` checks heap\n");
    buf_bytes(out, b"accesses through raw pointers at run time. Memory nobody wrote (from\n");
    buf_bytes(out, b"`malloc`) has an unspecified value: write it before reading it.\n");
}
