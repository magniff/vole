// Generated by compiler/guide/embed.sh from compiler/guide/memory.md (do
// not edit): the guide's topic 'memory'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Memory\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Vole's values have one owner each (0.17; spelled `let` / `inout` /\n");
    buf_bytes(out, b"`sink` since 0.20): an owned value moves and is dropped at the end of\n");
    buf_bytes(out, b"its scope, a function says by its parameters' conventions what it does\n");
    buf_bytes(out, b"with each argument, and the views a slice holds are checked. Nothing\n");
    buf_bytes(out, b"stores a reference, so there are no lifetimes to write. There is no\n");
    buf_bytes(out, b"garbage collector and no reference counting; memory comes from an\n");
    buf_bytes(out, b"allocator (`guide allocators`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Three kinds of types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The kind is computed from the type; nothing is declared:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| kind | what | `let w = v;`, a sink argument, `return` |\n");
    buf_bytes(out, b"|---|---|---|\n");
    buf_bytes(out, b"| plain | numbers, bool, raw `*T`, structs, tuples and arrays of plain types | a bit copy, as in C |\n");
    buf_bytes(out, b"| owned | `Vec`, `Buf`, `HashMap`, `Arena`, a type with `Drop`, a struct holding one | a move: the old name is dead until assigned again; `.clone()` copies |\n");
    buf_bytes(out, b"| view | a slice `[T]`, a struct holding one (`Scanner`) or an access field (`q: inout Query`), a closure capturing by access | a copy (one holding an `inout`: a move) that cannot outlive what it views |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec query own FILE:LINE:COL` shows each local's kind there, and\n");
    buf_bytes(out, b"whether it is moved or what it views.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Conventions: let, inout, sink\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A parameter's convention says what the function does with the argument:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| convention | written | the callee | the caller writes |\n");
    buf_bytes(out, b"|---|---|---|---|\n");
    buf_bytes(out, b"| let (the default) | `v: Vec<i64, Gpa>` | reads it; cannot change or keep it | `total(v)`: lent for the call, or a temporary |\n");
    buf_bytes(out, b"| inout | `v: inout Vec<i64, Gpa>` | may change it; the change reaches the caller | `fill(&v)`: `&` marks it |\n");
    buf_bytes(out, b"| sink | `v: sink Vec<i64, Gpa>` | owns it (may change it, keeps or drops it) | `keep(v)`: v moves (a plain value is copied) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn total(v: Vec<i64, Gpa>) -> i64 { // let: reads, no copy\n");
    buf_bytes(out, b"    var s = 0;\n");
    buf_bytes(out, b"    for x in v { s += x; }\n");
    buf_bytes(out, b"    s\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn fill(v: inout Vec<i64, Gpa>, n: i64) { // inout: changes the caller's Vec\n");
    buf_bytes(out, b"    for i in 0..n { v.push(i * i); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn keep(all: inout Vec<Vec<i64, Gpa>, Gpa>, v: sink Vec<i64, Gpa>) { // sink: takes it\n");
    buf_bytes(out, b"    all.push(v);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn make(n: i64, gpa: Gpa) -> Vec<i64, Gpa> { // the caller owns the result\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    fill(&v, n);\n");
    buf_bytes(out, b"    v                                    // moved out: not dropped here\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let v = make(4, gpa);\n");
    buf_bytes(out, b"    let w = v.clone();                   // a copy; `let w = v;` moves v\n");
    buf_bytes(out, b"    println(\"{} {} {}\", total(v), total(w), w.len());\n");
    buf_bytes(out, b"    var all: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    keep(&all, w);                       // w is dead from here\n");
    buf_bytes(out, b"    println(all.len());\n");
    buf_bytes(out, b"}                                        // all (and w in it), then v, dropped (freed)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"14 14 4\n");
    buf_bytes(out, b"1\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- There are no references to take or store: where other languages\n");
    buf_bytes(out, b"  borrow a reference, a let parameter borrows the value read-only for\n");
    buf_bytes(out, b"  the call and an inout one borrows it exclusively, with `&x` at the\n");
    buf_bytes(out, b"  call. An inout access needs a mutable place: `&x` and an `inout self`\n");
    buf_bytes(out, b"  method (`x.push(1)`) on a let binding are `own.readonly` (`var x`).\n");
    buf_bytes(out, b"- For a plain type (`i64`, a struct of numbers) `let` and `sink` are\n");
    buf_bytes(out, b"  both a copy; only `inout` changes the caller's value. For an owned one\n");
    buf_bytes(out, b"  `let` lends it and `sink` moves it.\n");
    buf_bytes(out, b"- Receivers: `fn len(self)`, `fn push(inout self, x: sink T)`, `fn\n");
    buf_bytes(out, b"  finish(sink self)`. A method call lends its receiver without `&`:\n");
    buf_bytes(out, b"  `v.push(1)` changes `v`, so `v` must be `var` (or an inout parameter).\n");
    buf_bytes(out, b"- A let parameter is read-only: changing it is an error that names the\n");
    buf_bytes(out, b"  fix (take it `inout`). Defaults: `b: i64 = 2` on let and sink\n");
    buf_bytes(out, b"  parameters, not on inout ones.\n");
    buf_bytes(out, b"- Mutable locals are `var x = e;`; `let` ones cannot change. A `sink`\n");
    buf_bytes(out, b"  parameter is the callee's own, so it is mutable.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Moves and drops\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `let w = v;`, a sink argument, `return v`, a struct literal's field\n");
    buf_bytes(out, b"  and a `sink ||` closure move `v`; using `v` after that is `own.moved`,\n");
    buf_bytes(out, b"  which names where it moved (`'keep(sink v)'`); its `try:` passes\n");
    buf_bytes(out, b"  `v.clone()`, or lend it to a let parameter instead.\n");
    buf_bytes(out, b"- At the end of a scope its owned locals are dropped, last declared\n");
    buf_bytes(out, b"  first, on every exit (`return`, `break`, `?`), not on `exit` or a\n");
    buf_bytes(out, b"  panic. A moved value is not dropped where it was.\n");
    buf_bytes(out, b"- `impl Drop for T { fn drop(inout self) { ... } }` runs code at the\n");
    buf_bytes(out, b"  drop; a type without one drops its fields. `drop(x)` drops early,\n");
    buf_bytes(out, b"  `std::forget(x)` never (a leak, safe); `x.drop()` by hand is\n");
    buf_bytes(out, b"  `own.drop_call` (`try: drop(x)`). A type with a Drop of its own\n");
    buf_bytes(out, b"  holds no view, also through a type argument (`G<[i64]>` of `impl<T>\n");
    buf_bytes(out, b"  Drop for G<T>`): `own.drop_view`, since its drop could read what the\n");
    buf_bytes(out, b"  view points to after that is gone. std's containers of views are fine.\n");
    buf_bytes(out, b"- A guard is a struct whose `Drop` releases what it holds (closes a\n");
    buf_bytes(out, b"  descriptor, restores the terminal), made where the resource is taken:\n");
    buf_bytes(out, b"  `let _closer = Closer { fd };` runs its drop on every exit of the\n");
    buf_bytes(out, b"  scope, after the locals made later (`let _ = ..` drops at once). It is\n");
    buf_bytes(out, b"  what `defer` did before 0.26.2 (now `syntax.defer`).\n");
    buf_bytes(out, b"- A `match`, `if let` or `let (a, _) = t` by value on a local moves\n");
    buf_bytes(out, b"  only the parts it binds; the rest (`_`, `..`, a wildcard arm) stays\n");
    buf_bytes(out, b"  in the local and is dropped with it, at its scope's end. `v[i] = x`\n");
    buf_bytes(out, b"  drops the element it replaces.\n");
    buf_bytes(out, b"- `let x = v[i];` of an owned element borrows it (a let access, read\n");
    buf_bytes(out, b"  only); `var x = v[i];` would move it out of the Vec and is\n");
    buf_bytes(out, b"  `own.move_out`, as is `var k = self.keys;` in an `inout self` method:\n");
    buf_bytes(out, b"  take it with `self.keys.take()`, which leaves an empty one\n");
    buf_bytes(out, b"  (`std::take(&x)` for a `Default` value), `std::replace`, or\n");
    buf_bytes(out, b"  `.clone()`.\n");
    buf_bytes(out, b"- `v.free()` still works: it frees now and leaves `v` empty (its drop\n");
    buf_bytes(out, b"  then frees nothing).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Accesses\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An access is what a let or inout parameter holds: not a pointer to\n");
    buf_bytes(out, b"manage, but the caller's value itself, used as that value.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Read it, write it, call its methods: `n + 1`, `out = acc`, `out +=\n");
    buf_bytes(out, b"  1`, `v.push(x)`, `p.x`. There is no `*r`; `*` is only for raw `*T`\n");
    buf_bytes(out, b"  pointers.\n");
    buf_bytes(out, b"- `inout r = &st;` names an inout access in a local; pass it on as\n");
    buf_bytes(out, b"  `&r`, any number of times: `bump(&r); bump(&r);`. A let argument needs\n");
    buf_bytes(out, b"  no local: pass `st` itself.\n");
    buf_bytes(out, b"- A struct may hold one as a field: `struct Parser { toks: [Tok], q:\n");
    buf_bytes(out, b"  inout Query }`, built as `Parser { toks: t, q: &q }`; such a struct is\n");
    buf_bytes(out, b"  a view (`guide views`).\n");
    buf_bytes(out, b"- `match e { E::A(n) => n + 1, .. }` on a let `e` binds into it;\n");
    buf_bytes(out, b"  `match &x { .. }` binds inout accesses that change `x`'s parts.\n");
    buf_bytes(out, b"- Exclusivity: while an inout access of `x` (or a view of it) is in use,\n");
    buf_bytes(out, b"  `x` is not read or changed another way. `f(&a, a)` and `f(&a, &a)` are\n");
    buf_bytes(out, b"  errors (`own.conflict`); `v.push(v.len())` is fine (the receiver is\n");
    buf_bytes(out, b"  taken after the arguments).\n");
    buf_bytes(out, b"- `*T` is a raw pointer (0.18.1): dereferencing it needs `unsafe`;\n");
    buf_bytes(out, b"  `&x` passed where a `*T` is wanted gives the address, with an\n");
    buf_bytes(out, b"  exclusive loan for the call (`guide unsafe`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Views\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A slice does not own memory: `v.as_slice()` views `v`'s elements, a\n");
    buf_bytes(out, b"`Scanner` views its text. The checker keeps every view inside what it\n");
    buf_bytes(out, b"views: a view used after its owner grew or was dropped (`own.conflict`),\n");
    buf_bytes(out, b"returned out of the function that owns its memory (`own.escape`), or a\n");
    buf_bytes(out, b"`for` loop over a Vec that pushes to it, is an error, not undefined\n");
    buf_bytes(out, b"behaviour. Take the view again after the change, or keep an index:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"v.push(1);\n");
    buf_bytes(out, b"let s = v.as_slice();\n");
    buf_bytes(out, b"    print(\"{} \", s[0]); // used before the pushes\n");
    buf_bytes(out, b"for i in 0..100 { v.push(i); }            // may move the elements\n");
    buf_bytes(out, b"let s2 = v.as_slice();                    // a fresh view\n");
    buf_bytes(out, b"    println(\"{}\", s2.len());\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"1 101\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec guide views` has the rules, the diagnostics and the patterns\n");
    buf_bytes(out, b"(parsers and lexers that keep views of their input are fine).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec --check-alloc` (0.16) also checks at run time: every Gpa block\n");
    buf_bytes(out, b"on pages of its own, so a use after free (through `unsafe` code) faults\n");
    buf_bytes(out, b"and is reported with where the block was allocated and freed; bad frees\n");
    buf_bytes(out, b"and leaks are reported too (`gpa.live_blocks()`, `gpa.check_leaks()` for\n");
    buf_bytes(out, b"tests).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Cells\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"*(0.26.1)* `std::cell::Cell<T>` is a value that changes through a shared\n");
    buf_bytes(out, b"(let) access, Rust's Cell: `get` (a copy, T: Copy), `set`, `replace`,\n");
    buf_bytes(out, b"`take`, `swap`, `update`. A cell is owned, so a let parameter of one is\n");
    buf_bytes(out, b"the caller's cell, and the callee's `set` reaches it:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::cell::Cell;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Counter { hits: Cell<i64> }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn hit(c: Counter) { c.hits.set(c.hits.get() + 1); }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let c = Counter { hits: Cell::new(0) };\n");
    buf_bytes(out, b"    hit(c);\n");
    buf_bytes(out, b"    hit(c);\n");
    buf_bytes(out, b"    let arr = [Cell::new(1), Cell::new(2)];\n");
    buf_bytes(out, b"    for x in arr { x.set(x.get() * 10); }\n");
    buf_bytes(out, b"    println(\"{} {}\", c.hits.get(), arr[1].get());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2 20\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- A cell moves (`let d = c`) and has no drop of its own.\n");
    buf_bytes(out, b"- No copy of a cell is made where its place is meant: a `for` over an\n");
    buf_bytes(out, b"  array of cells iterates the array itself; `v.get(i)` of one is\n");
    buf_bytes(out, b"  `own.interior_copy` (write `v[i].set(x)`).\n");
    buf_bytes(out, b"- `UnsafeCell<T>` is the primitive under Cell, Atomic and Mutex: `get`\n");
    buf_bytes(out, b"  gives a `*T` to write through in `unsafe`.\n");
    buf_bytes(out, b"- A type that holds a cell by value is not `Freeze` (`std::Freeze`): not\n");
    buf_bytes(out, b"  Sync (`guide threads#cells-and-threads`), and a `#[pure]` function or a\n");
    buf_bytes(out, b"  contract condition may not read it (`query effects F --why interior`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Raw memory\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`malloc` and `free` from C, raw `*T` pointers, in `unsafe` (`volec\n");
    buf_bytes(out, b"guide unsafe`). `volec --check-unsafe -O1` checks heap accesses\n");
    buf_bytes(out, b"through raw pointers at run time. Memory nobody wrote (from `malloc`)\n");
    buf_bytes(out, b"has an unspecified value: write it before reading it.\n");
}
