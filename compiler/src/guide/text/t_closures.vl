// Generated by compiler/guide/embed.sh from compiler/guide/closures.md (do
// not edit): the guide's topic 'closures'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Closures\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A closure is a function written as an expression, that uses the locals\n");
    buf_bytes(out, b"around it: `|x| x + k`. Each closure has its own type, which has no\n");
    buf_bytes(out, b"name: give a closure to a generic parameter bounded by `Fn`, `FnMut` or\n");
    buf_bytes(out, b"`FnOnce` (or an `impl Fn(..)` parameter), or keep it in a `let`. Calls\n");
    buf_bytes(out, b"are direct (no allocation, no pointer to a function), and a closure\n");
    buf_bytes(out, b"passed to a generic function is usually inlined.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {\n");
    buf_bytes(out, b"    f(x)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn repeat<F: FnMut(i64)>(n: i64, mut f: F) {\n");
    buf_bytes(out, b"    for i in 0..n { f(i); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let k = 10;\n");
    buf_bytes(out, b"    let add_k = |x: i64| x + k;             // a `let` needs the parameter's type\n");
    buf_bytes(out, b"    print(\"{} \", apply(add_k, 1));\n");
    buf_bytes(out, b"    print(\"{} \", apply(|x| x * 2, 21));     // here F's bound gives x: i64\n");
    buf_bytes(out, b"    let mut total = 0;\n");
    buf_bytes(out, b"    repeat(4, |i| total += i);              // borrows `total` mutably\n");
    buf_bytes(out, b"    println(\"{total}\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"11 42 6\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Syntax\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `|a, b| a + b`; `|| 42` takes nothing; `|x: i64| -> i64 { x + 1 }`:\n");
    buf_bytes(out, b"  with a result type, the body is a block. The body takes everything\n");
    buf_bytes(out, b"  after the bars, as `return`'s value does: `|x| x + 1` is\n");
    buf_bytes(out, b"  `|x| (x + 1)`.\n");
    buf_bytes(out, b"- Parameters are patterns: `|(a, b): (i64, i64)| a * b`, `|mut x|`,\n");
    buf_bytes(out, b"  `|_|`, `|s: &mut Sum, x: i64| s.total += x`; not `|a | b|` (no\n");
    buf_bytes(out, b"  or-pattern at the top).\n");
    buf_bytes(out, b"- A parameter's type is the annotation, else the one the context\n");
    buf_bytes(out, b"  expects (an `F: Fn(i64) -> bool` bound, an `fn(i64) -> bool`\n");
    buf_bytes(out, b"  parameter). Without either it is an error: `cannot infer the type of\n");
    buf_bytes(out, b"  closure parameter 'x'`, fixed by writing `|x: i64|` (a closure kept in\n");
    buf_bytes(out, b"  a `let` needs it, where rustc would infer it from the later call).\n");
    buf_bytes(out, b"- `return` in the body returns from the closure; `break` and `continue`\n");
    buf_bytes(out, b"  cannot leave it. An `unsafe { }` around a closure covers its body.\n");
    buf_bytes(out, b"- Messages and `volec query type FILE:LINE:COL` show a closure's type\n");
    buf_bytes(out, b"  as `closure(i64) -> i64 at main.vl:4:15`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## What a closure captures\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Rust's rules. A closure borrows what it uses: a shared borrow of a\n");
    buf_bytes(out, b"variable it only reads, a mutable borrow of one it changes (an\n");
    buf_bytes(out, b"assignment, `x.push(..)`, `&mut x`). The borrow lasts from the closure's\n");
    buf_bytes(out, b"creation to its last call: until then, a variable it borrows mutably is\n");
    buf_bytes(out, b"not used another way, and one it reads is not changed\n");
    buf_bytes(out, b"(`borrowck.conflict`). Use the variable after the closure's last call,\n");
    buf_bytes(out, b"pass the value as a parameter instead, or move it in with `move`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    let mut add = |x: i64| v.push(x);\n");
    buf_bytes(out, b"    add(1);\n");
    buf_bytes(out, b"    add(2);\n");
    buf_bytes(out, b"    println(\"{}\", v.len()); // add's last call is above\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## move closures\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`move || body` takes what it captures: a `Copy` value is copied, any\n");
    buf_bytes(out, b"other moves into the closure and is dead after it\n");
    buf_bytes(out, b"(`borrowck.use_moved`), and the closure changes its own copies. It is\n");
    buf_bytes(out, b"the way to keep a closure that outlives the block of what it uses:\n");
    buf_bytes(out, b"without `move`, a closure that borrows a variable cannot leave that\n");
    buf_bytes(out, b"variable's block (a block's value, a `break` value, an arm's value:\n");
    buf_bytes(out, b"`borrowck.dropped_borrowed`). A closure whose body moves a captured\n");
    buf_bytes(out, b"value out (`drop(v)`, `let w = v;`) can be called once: it is `FnOnce`\n");
    buf_bytes(out, b"only.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn call<F: FnMut() -> usize>(mut f: F) -> usize { f() }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.push(4);\n");
    buf_bytes(out, b"    let w = v.clone();\n");
    buf_bytes(out, b"    let count = || w.len();            // borrows w\n");
    buf_bytes(out, b"    let keep = move || v.len();        // v moves into the closure: dead here\n");
    buf_bytes(out, b"    println(\"{} {} {}\", count(), call(keep), w.len());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"1 1 1\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn call<F: FnMut() -> i64>(mut f: F) -> i64 {\n");
    buf_bytes(out, b"    f()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let mut n: i64 = 1;\n");
    buf_bytes(out, b"    let snap = move || n;              // a copy of n, now\n");
    buf_bytes(out, b"    let bump = || { n += 10; n };      // borrows n mutably\n");
    buf_bytes(out, b"    let b = call(bump);                // 11\n");
    buf_bytes(out, b"    n += 100;                          // bump is done with n\n");
    buf_bytes(out, b"    println(\"{b} {} {n}\", call(snap));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"11 1 111\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Fn, FnMut, FnOnce, fn\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `F: Fn(A, B) -> R` takes a closure with that signature that changes\n");
    buf_bytes(out, b"  nothing it captures, or a plain function `fn(A, B) -> R`.\n");
    buf_bytes(out, b"- `F: FnMut(A, B) -> R` takes one that may change what it captures;\n");
    buf_bytes(out, b"  call it through `mut f: F` or `f: &mut F`.\n");
    buf_bytes(out, b"- `F: FnOnce(A, B) -> R` takes any closure, called once.\n");
    buf_bytes(out, b"- `-> R` may be left out: `FnMut(i64)` returns `()`.\n");
    buf_bytes(out, b"- A closure that captures nothing is a plain function: it converts to\n");
    buf_bytes(out, b"  `fn(i64) -> i64` where one is expected. A capturing one is an error\n");
    buf_bytes(out, b"  there; make the parameter generic: `fn run<F: Fn(i64) -> i64>(f: F)`.\n");
    buf_bytes(out, b"- A function may return one: `fn adder(k: i64) -> impl Fn(i64) -> i64 {\n");
    buf_bytes(out, b"  move |x| x + k }`.\n");
    buf_bytes(out, b"- In a struct, a closure is a generic field: `struct Button<F> { on: F }`,\n");
    buf_bytes(out, b"  called as `(b.on)(3)`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Counter<F> { step: F, n: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn run(f: fn(i64) -> i64) -> i64 {\n");
    buf_bytes(out, b"    f(4)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    print(\"{} \", run(|x| x * x));      // captures nothing: a plain fn\n");
    buf_bytes(out, b"    let k = 3;\n");
    buf_bytes(out, b"    let mut c = Counter { step: |x: i64| x + k, n: 0 };\n");
    buf_bytes(out, b"    c.n = (c.step)(c.n);\n");
    buf_bytes(out, b"    c.n = (c.step)(c.n);\n");
    buf_bytes(out, b"    println(\"{}\", c.n);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"16 6\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Not there: `dyn Fn` (`dyn` is reserved: use generics), closures in\n");
    buf_bytes(out, b"statics, a closure calling itself. `volec guide iterators`: closures\n");
    buf_bytes(out, b"with `map`, `filter`, `fold`.\n");
}
