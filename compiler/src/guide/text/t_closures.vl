// Generated by compiler/guide/embed.sh from compiler/guide/closures.md (do
// not edit): the guide's topic 'closures'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Closures\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A closure is a function written as an expression, that uses the locals\n");
    buf_bytes(out, b"around it: `|x| x + k`. Each closure has its own type, which has no\n");
    buf_bytes(out, b"name: give a closure to a generic parameter bounded by `Fn` or `FnMut`,\n");
    buf_bytes(out, b"or keep it in a `let`. Calls are direct (no allocation, no pointer to a\n");
    buf_bytes(out, b"function), and a closure passed to a generic function is usually\n");
    buf_bytes(out, b"inlined.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {\n");
    buf_bytes(out, b"    f(x)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn repeat<F: FnMut(i64)>(n: i64, f: sink F) {\n");
    buf_bytes(out, b"    for i in 0..n { f(i); }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let k = 10;\n");
    buf_bytes(out, b"    let add_k = |x: i64| x + k;              // a `let` needs the parameter's type\n");
    buf_bytes(out, b"    std::print_int(apply(add_k, 1));\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(apply(|x| x * 2, 21));    // here F's bound gives x: i64\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    var total = 0;\n");
    buf_bytes(out, b"    repeat(4, |i| { total += i; });          // changes `total` (a `var`: captured inout)\n");
    buf_bytes(out, b"    std::print_int(total);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"11 42 6\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Syntax\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `|a, b| a + b`; `|| 42` takes nothing; `|x: i64| -> i64 { x + 1 }`:\n");
    buf_bytes(out, b"  with a result type, the body is a block. The body takes everything\n");
    buf_bytes(out, b"  after the bars, as `return`'s value does: `|x| x + 1` is\n");
    buf_bytes(out, b"  `|x| (x + 1)`.\n");
    buf_bytes(out, b"- Parameters are patterns: `|(a, b): (i64, i64)| a * b`, `|var x|`,\n");
    buf_bytes(out, b"  `|_|`; not `|a | b|` (no or-pattern at the top). They are let unless\n");
    buf_bytes(out, b"  annotated: `|s: inout Sum, x: i64| s.total += x`.\n");
    buf_bytes(out, b"- `|d: sink D|` takes its argument (the call moves it), as does a\n");
    buf_bytes(out, b"  closure given to an `FnMut(sink T)` bound (`map`, `for_each`,\n");
    buf_bytes(out, b"  `fold`, `Option::map`): the closure owns it and drops it at the end\n");
    buf_bytes(out, b"  of its body, unless the body moves it out (returns it, pushes it,\n");
    buf_bytes(out, b"  passes it to a `sink` parameter). Before 0.25.3 it leaked.\n");
    buf_bytes(out, b"- A parameter's type is the annotation, else the one the context\n");
    buf_bytes(out, b"  expects (an `F: Fn(i64) -> bool` bound, an `fn(i64) -> bool`\n");
    buf_bytes(out, b"  parameter). Without either it is an error: `cannot infer the type of\n");
    buf_bytes(out, b"  closure parameter 'x'`, fixed by writing `|x: i64|`.\n");
    buf_bytes(out, b"- `return` in the body returns from the closure; `break` and `continue`\n");
    buf_bytes(out, b"  cannot leave it. An `unsafe { }` around a closure covers its body.\n");
    buf_bytes(out, b"- Messages and `volec query type FILE:LINE:COL` show a closure's type\n");
    buf_bytes(out, b"  as `closure(i64) -> i64 at main.vl:4:15`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## What a closure captures\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Decided per variable, so the meaning never depends on an analysis:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| the variable | captured | the closure sees |\n");
    buf_bytes(out, b"|---|---|---|\n");
    buf_bytes(out, b"| a plain `let x`, a parameter, a `for` variable | a copy | the value it had; nothing can change it |\n");
    buf_bytes(out, b"| an owned `let x` (a `Vec`, a `Buf`) | let (read-only access) | `x` itself, read only; no copy |\n");
    buf_bytes(out, b"| `var x` | inout | `x` itself: its assignments change `x` |\n");
    buf_bytes(out, b"| anything, in a `sink \\|..\\|` closure | taken: copied, an owned local moved in | a snapshot; assignments change the closure's own |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A closure capturing `x` by access holds that access from its creation\n");
    buf_bytes(out, b"to its last call (0.25). One that changes `x` (an assignment, `&x`, an\n");
    buf_bytes(out, b"inout method such as `x.push(..)`) holds an inout access: while it is\n");
    buf_bytes(out, b"still to be called, `x` is not read or changed another way, and calling\n");
    buf_bytes(out, b"it or passing it next to `&x` or a view of `x` is an error\n");
    buf_bytes(out, b"(`own.conflict`). One that only reads `x` holds a let access: `x` may be\n");
    buf_bytes(out, b"read, not changed. Use `x` after the closure's last call, pass the\n");
    buf_bytes(out, b"value to the closure as a parameter instead of capturing it, or capture\n");
    buf_bytes(out, b"a snapshot with `sink`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    var add = |x: i64| v.push(x);\n");
    buf_bytes(out, b"    add(1);\n");
    buf_bytes(out, b"    add(2);\n");
    buf_bytes(out, b"    println(\"{}\", v.len()); // add's last call is above\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A captured variable is the closure's `inout` parameter (0.25): what its\n");
    buf_bytes(out, b"body stores into one must outlive the call. A view of the body's own\n");
    buf_bytes(out, b"local stored into a captured `Vec`, through `arena_scope`'s closure or\n");
    buf_bytes(out, b"any other, is `own.escape`, as it is for a function storing into its\n");
    buf_bytes(out, b"`inout` parameter. A view the closure returns, or stores into what it\n");
    buf_bytes(out, b"captures, counts at every call: called directly or by a generic\n");
    buf_bytes(out, b"function (`apply(x, f)`, `iter.map(f)`), the result views what the\n");
    buf_bytes(out, b"closure views.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## sink closures\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`sink || body` takes what it captures, as a `sink` parameter does: a\n");
    buf_bytes(out, b"plain value is copied, an owned local moves into the closure (and is\n");
    buf_bytes(out, b"dead after it), and the closure may change its own copies. A borrowed\n");
    buf_bytes(out, b"owned value (a `let` or `inout` parameter, `self`, a loop's element)\n");
    buf_bytes(out, b"cannot be taken: that is `own.move_out`; clone it first, or drop `sink`. It is the\n");
    buf_bytes(out, b"way to keep a closure that outlives the block of what it uses: the\n");
    buf_bytes(out, b"move closure of other languages (`move ||` is `conv.rust`, with `sink\n");
    buf_bytes(out, b"||` in its `try:` line).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An owned value a closure captures without `sink` still belongs to its\n");
    buf_bytes(out, b"variable, so the body may not move it (`drop(x)`, passing it to a sink\n");
    buf_bytes(out, b"parameter): that is `own.move_out`; use `x.clone()` inside. A `sink`\n");
    buf_bytes(out, b"(`move`) closure owns its captures and may move one out: its drop then\n");
    buf_bytes(out, b"skips that one. Called again after such a move, it stops the program\n");
    buf_bytes(out, b"(exit 101), since no closure is `FnOnce` yet.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn call<F: FnMut() -> usize>(f: sink F) -> usize { f() }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.push(4);\n");
    buf_bytes(out, b"    let w = v.clone();\n");
    buf_bytes(out, b"    let count = || w.len();            // an owned let: read through an access\n");
    buf_bytes(out, b"    let keep = sink || v.len();        // v moves into the closure: dead here\n");
    buf_bytes(out, b"    println(\"{} {} {}\", count(), call(keep), w.len());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"1 1 1\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn call<F: FnMut() -> i64>(f: sink F) -> i64 {\n");
    buf_bytes(out, b"    f()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var n = 1;\n");
    buf_bytes(out, b"    let snap = sink || n;              // a copy of n, now\n");
    buf_bytes(out, b"    let bump = || { n += 10; n };      // n captured inout: changes n\n");
    buf_bytes(out, b"    let b = call(bump);                // 11\n");
    buf_bytes(out, b"    n += 100;                          // bump is done with n\n");
    buf_bytes(out, b"    println(\"{b} {} {n}\", call(snap));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"11 1 111\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A closure that borrows a variable cannot leave that variable's block: a\n");
    buf_bytes(out, b"block's value, a `break` value, a `match` or `if let` arm's value. The\n");
    buf_bytes(out, b"fix is a `sink` closure, or the variable declared outside the\n");
    buf_bytes(out, b"block. There is nothing else a closure can escape through: closure\n");
    buf_bytes(out, b"types cannot be named, so no struct field, static or return type can\n");
    buf_bytes(out, b"hold one (outside generic parameters).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Fn, FnMut, fn\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `F: Fn(A, B) -> R` takes a closure with that signature that assigns\n");
    buf_bytes(out, b"  no captured variable, or a plain function `fn(A, B) -> R`.\n");
    buf_bytes(out, b"- `F: FnMut(A, B) -> R` takes any closure with that signature, or a\n");
    buf_bytes(out, b"  plain function. Call `f` from a `f: sink F` parameter or a `var`.\n");
    buf_bytes(out, b"- A parameter's convention is part of the signature: `F: FnMut(inout\n");
    buf_bytes(out, b"  Sum, i64)` takes a closure `|s: inout Sum, x: i64| s.total += x`,\n");
    buf_bytes(out, b"  called as `f(&s, x)`; `fn(inout Sum, i64)` is the plain function type.\n");
    buf_bytes(out, b"- `-> R` may be left out: `FnMut(i64)` returns `()`. There is no\n");
    buf_bytes(out, b"  `FnOnce`.\n");
    buf_bytes(out, b"- A closure that captures nothing is a plain function: it converts to\n");
    buf_bytes(out, b"  `fn(i64) -> i64` where one is expected. A capturing one is an error\n");
    buf_bytes(out, b"  there; make the parameter generic: `fn run<F: Fn(i64) -> i64>(f: F)`.\n");
    buf_bytes(out, b"- In a struct, a closure is a generic field: `struct Button<F> { on: F }`,\n");
    buf_bytes(out, b"  called as `(b.on)(3)`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Counter<F> { step: F, n: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn run(f: fn(i64) -> i64) -> i64 {\n");
    buf_bytes(out, b"    f(4)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    std::print_int(run(|x| x * x));       // captures nothing: a plain fn\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    let k = 3;\n");
    buf_bytes(out, b"    var c = Counter { step: |x: i64| x + k, n: 0 };\n");
    buf_bytes(out, b"    c.n = (c.step)(c.n);\n");
    buf_bytes(out, b"    c.n = (c.step)(c.n);\n");
    buf_bytes(out, b"    std::print_int(c.n);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"16 6\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Not there: `FnOnce`, `Box<dyn Fn>` and `dyn` (use generics), `impl Fn`\n");
    buf_bytes(out, b"in a result (0.15), closures in statics, a closure calling itself.\n");
    buf_bytes(out, b"`volec guide iterators`: closures with `map`, `filter`, `fold`.\n");
}
