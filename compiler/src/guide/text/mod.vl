pub fn topic_summary(i: i64) -> [u8] {
    match i {
        0 => "about 2k tokens: the language in one program (let, inout, sink, var), std's most used items, first errors, the loop (the default)",
        1 => "a whole program in three files and a test case: modules, enums and match, Result and ?, Vec, HashMap, Buf, sorting, allocators",
        2 => "the long form of the core: values, functions, structs, generics, modules, slices, std, input, unsafe, errors, tools",
        3 => "Rust -> vole, area by area: text, parameters and memory (&T, &mut T, let mut), errors, iteration, syntax",
        4 => "lexical rules, items, statements, precedence, control flow, patterns",
        5 => "float math (0.25.2.1): Rust's f32 and f64 methods (sqrt, sin, atan2, powi, min, ...), f64::consts::PI, f64::EPSILON, std::math's functions; pure vole, no C; the integers' abs, min, max, clamp, signum, pow (0.25.2.2)",
        6 => "numbers and their defined behaviour, arrays, slices, pointers, distinct types and NonNull (0.18), enums, SIMD",
        7 => "Vec, HashMap, Buf, Option, Result, printing, reading stdin, text, sort: the API from std's source",
        8 => "str and String (0.20): UTF-8 text with Rust's methods (split, trim, find, parse, lines, chars), patterns, the _in forms, bytes to text",
        9 => "files, paths, the environment, processes (0.20): std::fs, io::Error, BufReader, BufWriter, std::path, std::env, std::process",
        10 => "command lines (0.24): std::cli, a Command of flags, options, positionals and subcommands; Matches; the help, errors with try: lines, exit codes",
        11 => "plain, owned and view types; the conventions let, inout, sink; moves, drops, accesses; views checked (0.17, 0.20)",
        12 => "slices and access fields as views: exclusivity, inout [T], view summaries, parsers, the own.* diagnostics (0.17)",
        13 => "explicit allocation (0.16): gpa from main, the _in forms, A: Allocator, arenas, --check-alloc, fix --only alloc016",
        14 => "what a function may do (0.16): alloc(Gpa) io global panic diverge unsafe, query effects, #[pure] and its kin",
        15 => "the errors newcomers hit, each with its fix; run-time failures",
        16 => "files, mod, pub, use, paths, the prelude",
        17 => "type parameters, instances, the turbofish, inference",
        18 => "traits, impls, defaults, bounds, operator traits",
        19 => "|x| x + k, captures, sink closures, Fn and FnMut bounds, fn coercion (0.14)",
        20 => "Iterator, map/filter/fold/sum/collect, for over iterators, sort_by (0.14)",
        21 => "widening, From and Into, the ? operator, main -> Result, std's error enums (0.15)",
        22 => "f-strings, Display and Debug, print/println/format, #[derive] (0.15)",
        23 => "unsafe operations, raw pointers and &x, unsafe fn, --check-unsafe",
        24 => "calling C, importing headers, repr(C), callbacks, linking",
        25 => "std::window (0.23): an App, windows, pulled events, keys, text and input methods, mouse, frames on request, the clipboard",
        26 => "atomics, std::thread (spawn, scope), Mutex, channels, thread-locals, the sync/thread/tls effects (0.21)",
        27 => "SIMD and CPU intrinsics (0.19): NEON, SSE, AVX2, CRC32, AES, SHA-256, popcount; finding one (query arch), byte search, detect and has, #[target_feature], #[multiversion], checked memory",
        28 => "GPU compute and rendering (0.22): std::gpu on Metal, a window with a storage buffer, compute and render, descriptors, buffer usages, surface, texture and storable formats, bind groups and layouts (a pipeline's own entry points), one module per kernel, index buffers (no indirect draws), uniform layout and gpu.unwritten, workgroups, buffer sizes and adapter.limits(), atomics, a compute simulation (ping-pong, per-step uniforms, readback), timing, what the WGSL translation rejects, the gpu.* contracts",
        29 => "GPU rendering (0.22): render to a texture, a textured quad (vertex layouts of several attributes, write_texture, samplers, textureSampleLevel), multiple render targets, depth-only passes",
        30 => "query, edit, refactor, fix, check, diagnostics and try lines",
        31 => "requires, ensures, old and result, assert and assert_eq, debug clauses, the failure line (0.18)",
        32 => "#[test] (with gpa: Gpa), a check must be able to fail, #[property] and Arbitrary, snapshots, volec test, #[fuzz] and volec fuzz, reduce over programs (0.18)",
        33 => "a bug: tests with failure traces, probe values at a line, reduce an input, which change broke a test (0.17)",
        34 => "recipes for \"add an X\": a std function, a peephole rule, a pass, a diagnostic, a test, a subcommand, a module (0.17)",
        35 => "the style (0.25.1): imports grouped std, crate, the rest; 4 spaces, 100 columns, trailing commas; volec fmt --check",
        _ => "",
    }
}

