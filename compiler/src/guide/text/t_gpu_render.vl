// Generated by compiler/guide/embed.sh from compiler/guide/gpu-render.md (do
// not edit): the guide's topic 'gpu-render'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# GPU rendering: std::gpu (0.22; guide updated 0.25.4)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Drawing with std::gpu (`guide gpu` for the objects, compute, bind groups,\n");
    buf_bytes(out, "usages and formats, limits and contracts): a render pipeline\n");
    buf_bytes(out, "(`RenderDesc`) draws in a render pass (`enc.render_pass(PassDesc, |pass|\n");
    buf_bytes(out, "..)`) into a texture or a window's frame, read back with\n");
    buf_bytes(out, "`enc.copy_texture_to_buffer`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Render to a texture\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::{BufferUsage, Format, PassDesc, Reflection, ShaderSource, TextureUsage};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    let code = \"#include <metal_stdlib>\\nusing namespace metal;\\nvertex float4 vs(uint v [[vertex_id]]) { float2 p[3] = { float2(-1, -1), float2(3, -1), float2(-1, 3) }; return float4(p[v], 0, 1); }\\nfragment float4 fs() { return float4(1, 0.5, 0, 1); }\\n\";\n");
    buf_bytes(out, "    var refl = Reflection::new_in(gpa);\n");
    buf_bytes(out, "    refl.vertex(\"vs\", \"vs\");\n");
    buf_bytes(out, "    refl.fragment(\"fs\", \"fs\");\n");
    buf_bytes(out, "    let src = ShaderSource::msl(code, refl);\n");
    buf_bytes(out, "    let shader = dev.shader(src)?;\n");
    buf_bytes(out, "    let desc = gpu::RenderDesc::new(shader, \"vs\", \"fs\", Format::Rgba8Unorm);\n");
    buf_bytes(out, "    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, "    let tex = dev.texture(8, 8, Format::Rgba8Unorm, usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);\n");
    buf_bytes(out, "    let view = tex.view();\n");
    buf_bytes(out, "    var out = dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.render_pass(PassDesc::color(view), |pass| { // cleared to black, then drawn\n");
    buf_bytes(out, "        pass.set_pipeline(pipe);\n");
    buf_bytes(out, "        pass.draw(0..3, 0..1); // a triangle over the whole target\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    enc.copy_texture_to_buffer(tex, out, 256); // rows 256 bytes apart\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "    let px = out.map_read(dev);\n");
    buf_bytes(out, "    println(f\"{px[0]} {px[1]} {px[2]} {px[3]}\");\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "255 128 0 255\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## A textured quad\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A vertex buffer of several attributes (`VertexLayout`: the stride, then\n");
    buf_bytes(out, "each `@location(n)` with its format and offset), a one-channel texture\n");
    buf_bytes(out, "written from the CPU (`queue.write_texture(tex, bytes, bytes_per_row)`),\n");
    buf_bytes(out, "a sampler, and both bound beside each other: `gpu::bind_texture`,\n");
    buf_bytes(out, "`gpu::bind_sampler`. A fragment shader samples with `textureSample`, or\n");
    buf_bytes(out, "`textureSampleLevel(t, s, uv, 0.0)` where it must name the level (a\n");
    buf_bytes(out, "texture of one mip level, or code outside uniform control flow); an\n");
    buf_bytes(out, "`R8Unorm` texel reads as `vec4<f32>(r, 0, 0, 1)`, r in 0..1.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::{BufferUsage, Format, PassDesc, SamplerDesc, TextureUsage, VertexFormat, VertexLayout};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "const QUAD: [u8] = r\"\"\"\n");
    buf_bytes(out, "    struct VOut { @builtin(position) pos: vec4<f32>, @location(0) uv: vec2<f32> }\n");
    buf_bytes(out, "    @group(0) @binding(0) var t: texture_2d<f32>;\n");
    buf_bytes(out, "    @group(0) @binding(1) var s: sampler;\n");
    buf_bytes(out, "    @vertex fn vs(@location(0) pos: vec2<f32>, @location(1) uv: vec2<f32>) -> VOut {\n");
    buf_bytes(out, "        return VOut(vec4<f32>(pos, 0.0, 1.0), uv);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    @fragment fn fs(v: VOut) -> @location(0) vec4<f32> {\n");
    buf_bytes(out, "        let r = textureSampleLevel(t, s, v.uv, 0.0).r;\n");
    buf_bytes(out, "        return vec4<f32>(r, r, r, 1.0);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    \"\"\";\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    let shader = dev.shader_wgsl(QUAD)?;\n");
    buf_bytes(out, "    var desc = gpu::RenderDesc::new(shader, \"vs\", \"fs\", Format::Rgba8Unorm);\n");
    buf_bytes(out, "    var layout = VertexLayout::new(16); // x, y, u, v: four f32s a vertex\n");
    buf_bytes(out, "    layout.attribute(0, VertexFormat::Float32x2, 0);\n");
    buf_bytes(out, "    layout.attribute(1, VertexFormat::Float32x2, 8);\n");
    buf_bytes(out, "    desc.vertex_buffer(layout);\n");
    buf_bytes(out, "    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, "    // two triangles over the target; uv (0, 0) at its top left\n");
    buf_bytes(out, "    let quad: [f32; 24] = [\n");
    buf_bytes(out, "        -1.0, 1.0, 0.0, 0.0, 1.0, 1.0, 1.0, 0.0, -1.0, -1.0, 0.0, 1.0,\n");
    buf_bytes(out, "        -1.0, -1.0, 0.0, 1.0, 1.0, 1.0, 1.0, 0.0, 1.0, -1.0, 1.0, 1.0,\n");
    buf_bytes(out, "    ];\n");
    buf_bytes(out, "    let vb = dev.buffer_init(gpu::bytes_of_f32(quad[..]), BufferUsage::VERTEX);\n");
    buf_bytes(out, "    // a 2 x 2 R8Unorm texture, a byte a texel, rows of 2 bytes\n");
    buf_bytes(out, "    let image = dev.texture(2, 2, Format::R8Unorm); // TEXTURE_BINDING | COPY_DST\n");
    buf_bytes(out, "    let texels: [u8; 4] = [0, 64, 128, 255];\n");
    buf_bytes(out, "    queue.write_texture(image, texels[..], 2);\n");
    buf_bytes(out, "    let sampler = dev.sampler(SamplerDesc::nearest());\n");
    buf_bytes(out, "    let group = dev.bind_group(pipe.bind_layout(0),\n");
    buf_bytes(out, "        [gpu::bind_texture(0, image.view()), gpu::bind_sampler(1, sampler)][..]);\n");
    buf_bytes(out, "    let target = dev.texture(4, 4, Format::Rgba8Unorm,\n");
    buf_bytes(out, "        usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);\n");
    buf_bytes(out, "    var out = dev.buffer(256 * 4, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.render_pass(PassDesc::color(target.view()), |pass| {\n");
    buf_bytes(out, "        pass.set_pipeline(pipe);\n");
    buf_bytes(out, "        pass.set_bind_group(0, group);\n");
    buf_bytes(out, "        pass.set_vertex_buffer(0, vb);\n");
    buf_bytes(out, "        pass.draw(0..6, 0..1);\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    enc.copy_texture_to_buffer(target, out, 256);\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "    let px = out.map_read(dev);\n");
    buf_bytes(out, "    // the red byte of the four corners: each texel covers 2 x 2 pixels\n");
    buf_bytes(out, "    println(f\"{px[0]} {px[3 * 4]} {px[3 * 256]} {px[3 * 256 + 3 * 4]}\");\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "0 64 128 255\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Drawing over the image you just made\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "An overlay (a panel, a label, a cursor) is one more render pass into the\n");
    buf_bytes(out, "same target after the scene's passes and before `frame.present`: a\n");
    buf_bytes(out, "pass that keeps what is there instead of clearing it,\n");
    buf_bytes(out, "`PassDesc::color(view, load: Load::Keep)`, and a pipeline that blends\n");
    buf_bytes(out, "over it, `desc.blend(Blend::alpha())` (source over destination, straight\n");
    buf_bytes(out, "alpha; `Blend::premultiplied()` for premultiplied colours). Everything\n");
    buf_bytes(out, "is a textured quad from one vertex buffer of position, colour and uv\n");
    buf_bytes(out, "(`VertexLayout::new(32)`: `Float32x2`, `Float32x4`, `Float32x2`), and\n");
    buf_bytes(out, "one `R8Unorm` atlas (`queue.write_texture`) holds the glyphs and a white\n");
    buf_bytes(out, "texel: a solid quad samples the white texel, a character its glyph, and\n");
    buf_bytes(out, "the fragment shader writes the colour with alpha times the coverage. A\n");
    buf_bytes(out, "string's width is its glyph count times the advance, less the last gap,\n");
    buf_bytes(out, "so text is measured before it is placed (centred, right-aligned). A\n");
    buf_bytes(out, "window's frame is `Bgra8Unorm`: the pipeline's format is the frame's.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::{\n");
    buf_bytes(out, "    Blend, BufferUsage, Color, Format, Load, PassDesc, SamplerDesc, TextureUsage, VertexFormat,\n");
    buf_bytes(out, "    VertexLayout,\n");
    buf_bytes(out, "};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "const UI: [u8] = r\"\"\"\n");
    buf_bytes(out, "    struct VIn {\n");
    buf_bytes(out, "        @location(0) pos: vec2<f32>, @location(1) color: vec4<f32>, @location(2) uv: vec2<f32>,\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    struct VOut {\n");
    buf_bytes(out, "        @builtin(position) pos: vec4<f32>, @location(0) color: vec4<f32>, @location(1) uv: vec2<f32>,\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    @group(0) @binding(0) var atlas: texture_2d<f32>;\n");
    buf_bytes(out, "    @group(0) @binding(1) var samp: sampler;\n");
    buf_bytes(out, "    @vertex fn vs(v: VIn) -> VOut {\n");
    buf_bytes(out, "        return VOut(vec4<f32>(v.pos, 0.0, 1.0), v.color, v.uv);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    @fragment fn fs(v: VOut) -> @location(0) vec4<f32> {\n");
    buf_bytes(out, "        let coverage = textureSampleLevel(atlas, samp, v.uv, 0.0).r; // ink, or the white texel\n");
    buf_bytes(out, "        return vec4<f32>(v.color.rgb, v.color.a * coverage);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    \"\"\";\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// The atlas (R8Unorm, 12 x 5 texels, '#' is 255): the white texel at\n");
    buf_bytes(out, "// (0, 0) for solid quads, then 'H' and 'I', 3 x 5 each, at x 4 and 8.\n");
    buf_bytes(out, "static ART: [str; 5] = [\n");
    buf_bytes(out, "    \"#   # # ### \",\n");
    buf_bytes(out, "    \"    # #  #  \",\n");
    buf_bytes(out, "    \"    ###  #  \",\n");
    buf_bytes(out, "    \"    # #  #  \",\n");
    buf_bytes(out, "    \"    # # ### \",\n");
    buf_bytes(out, "];\n");
    buf_bytes(out, "const AW: f64 = 12.0;\n");
    buf_bytes(out, "const AH: f64 = 5.0;\n");
    buf_bytes(out, "const W: i64 = 16; // the target, in pixels\n");
    buf_bytes(out, "const H: i64 = 8;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// Pixels (x0, y0)-(x1, y1) showing atlas texels (u0, v0)-(u1, v1) (in\n");
    buf_bytes(out, "// 0..1) in colour c: two triangles of x, y, r, g, b, a, u, v.\n");
    buf_bytes(out, "fn quad(vs: inout Vec<f32>, x0: f64, y0: f64, x1: f64, y1: f64, uv: [f64; 4], c: [f32; 4]) {\n");
    buf_bytes(out, "    let (l, r) = (2.0 * x0 / W as f64 - 1.0, 2.0 * x1 / W as f64 - 1.0);\n");
    buf_bytes(out, "    let (t, b) = (1.0 - 2.0 * y0 / H as f64, 1.0 - 2.0 * y1 / H as f64);\n");
    buf_bytes(out, "    let corners = [\n");
    buf_bytes(out, "        [l, t, uv[0], uv[1]], [r, t, uv[2], uv[1]], [l, b, uv[0], uv[3]],\n");
    buf_bytes(out, "        [l, b, uv[0], uv[3]], [r, t, uv[2], uv[1]], [r, b, uv[2], uv[3]],\n");
    buf_bytes(out, "    ];\n");
    buf_bytes(out, "    for k in 0..6 {\n");
    buf_bytes(out, "        let p = corners[k];\n");
    buf_bytes(out, "        vs.extend_from_slice([p[0] as f32, p[1] as f32, c[0], c[1], c[2], c[3], p[2] as f32,\n");
    buf_bytes(out, "            p[3] as f32][..]);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// The width of s in pixels: 4 a glyph (3 of ink, 1 of space), less the last space.\n");
    buf_bytes(out, "fn text_width(s: [u8]) -> f64 {\n");
    buf_bytes(out, "    if s.len == 0 { 0.0 } else { (s.len * 4 - 1) as f64 }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// One quad a glyph from (x, y), the top left; its cell from the byte.\n");
    buf_bytes(out, "fn text(vs: inout Vec<f32>, x: f64, y: f64, s: [u8], c: [f32; 4]) {\n");
    buf_bytes(out, "    var cx = x;\n");
    buf_bytes(out, "    for ch in s {\n");
    buf_bytes(out, "        let u = if ch == 'H' { 4.0 } else { 8.0 }; // a real font: a table of cells\n");
    buf_bytes(out, "        quad(&vs, cx, y, cx + 3.0, y + 5.0, [u / AW, 0.0, (u + 3.0) / AW, 1.0], c);\n");
    buf_bytes(out, "        cx += 4.0;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    let target = dev.texture(W, H, Format::Rgba8Unorm,\n");
    buf_bytes(out, "        usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);\n");
    buf_bytes(out, "    let view = target.view();\n");
    buf_bytes(out, "    // the image you just made: here a pass that clears it to blue\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.render_pass(PassDesc::color(view, clear: Color::rgba(0.0, 0.0, 1.0, 1.0)), |_| {});\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    // the overlay: a blended pipeline of position, colour and uv\n");
    buf_bytes(out, "    let shader = dev.shader_wgsl(UI)?;\n");
    buf_bytes(out, "    var desc = gpu::RenderDesc::new(shader, \"vs\", \"fs\", Format::Rgba8Unorm); // a frame: Bgra8Unorm\n");
    buf_bytes(out, "    var layout = VertexLayout::new(32); // 8 f32s a vertex\n");
    buf_bytes(out, "    layout.attribute(0, VertexFormat::Float32x2, 0); // x, y\n");
    buf_bytes(out, "    layout.attribute(1, VertexFormat::Float32x4, 8); // r, g, b, a\n");
    buf_bytes(out, "    layout.attribute(2, VertexFormat::Float32x2, 24); // u, v\n");
    buf_bytes(out, "    desc.vertex_buffer(layout);\n");
    buf_bytes(out, "    desc.blend(Blend::alpha()); // source over what is there\n");
    buf_bytes(out, "    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, "    var texels: Vec<u8> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    for r in 0..5 {\n");
    buf_bytes(out, "        for ch in ART[r].as_bytes() {\n");
    buf_bytes(out, "            texels.push(if ch == '#' { 255 } else { 0 });\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    let atlas = dev.texture(12, 5, Format::R8Unorm); // TEXTURE_BINDING | COPY_DST\n");
    buf_bytes(out, "    queue.write_texture(atlas, texels.as_slice(), 12); // rows of 12 bytes\n");
    buf_bytes(out, "    let sampler = dev.sampler(SamplerDesc::nearest());\n");
    buf_bytes(out, "    let group = dev.bind_group(pipe.bind_layout(0),\n");
    buf_bytes(out, "        [gpu::bind_texture(0, atlas.view()), gpu::bind_sampler(1, sampler)][..]);\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    // the draw list: a half-dark box, then \"HI\" measured and centred in it\n");
    buf_bytes(out, "    var verts: Vec<f32> = Vec::new_in(gpa);\n");
    buf_bytes(out, "    let white = [0.5 / AW, 0.5 / AH, 0.5 / AW, 0.5 / AH];\n");
    buf_bytes(out, "    quad(&verts, 1.0, 1.0, 10.0, 8.0, white, [0.0, 0.0, 0.0, 0.5]);\n");
    buf_bytes(out, "    let label = \"HI\";\n");
    buf_bytes(out, "    text(&verts, 1.0 + (9.0 - text_width(label)) / 2.0, 2.0, label, [1.0, 1.0, 0.0, 1.0]);\n");
    buf_bytes(out, "    let vb = dev.buffer_init(gpu::bytes_of_f32(verts.as_slice()), BufferUsage::VERTEX);\n");
    buf_bytes(out, "    let count = verts.len() / 8;\n");
    buf_bytes(out, "    var out = dev.buffer(256 * H, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, "    var enc2 = dev.encoder();\n");
    buf_bytes(out, "    enc2.render_pass(PassDesc::color(view, load: Load::Keep), |pass| { // kept, not cleared\n");
    buf_bytes(out, "        pass.set_pipeline(pipe);\n");
    buf_bytes(out, "        pass.set_bind_group(0, group);\n");
    buf_bytes(out, "        pass.set_vertex_buffer(0, vb);\n");
    buf_bytes(out, "        pass.draw(0..count, 0..1);\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    enc2.copy_texture_to_buffer(target, out, 256);\n");
    buf_bytes(out, "    queue.submit(enc2.finish());\n");
    buf_bytes(out, "    let px = out.map_read(dev);\n");
    buf_bytes(out, "    // a pixel a character: '#' the text, 'o' the box, '.' the image\n");
    buf_bytes(out, "    for y in 0..H {\n");
    buf_bytes(out, "        var line: [u8; 16] = [0; 16];\n");
    buf_bytes(out, "        for x in 0..W {\n");
    buf_bytes(out, "            let p = y * 256 + x * 4;\n");
    buf_bytes(out, "            line[x] = if px[p] > 200 { '#' } else if px[p + 2] > 200 { '.' } else { 'o' };\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "        println(line[..]);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    println(f\"box {px[256 + 4 + 2]}, image {px[256 + 14 * 4 + 2]}\"); // blue, half and whole\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "................\n");
    buf_bytes(out, ".ooooooooo......\n");
    buf_bytes(out, ".o#o#o###o......\n");
    buf_bytes(out, ".o#o#oo#oo......\n");
    buf_bytes(out, ".o###oo#oo......\n");
    buf_bytes(out, ".o#o#oo#oo......\n");
    buf_bytes(out, ".o#o#o###o......\n");
    buf_bytes(out, ".ooooooooo......\n");
    buf_bytes(out, "box 128, image 255\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A whole one: examples/gpu/pathtrace (`ui_render.vl`: the pipeline and\n");
    buf_bytes(out, "the pass; `font.vl`: a 5 x 7 font of 95 glyphs baked into a 128 x 128\n");
    buf_bytes(out, "atlas; `ui.wgsl`; `ui.vl`'s `quad`, `text`, `text_width`, with\n");
    buf_bytes(out, "clipping). Its `--headless --ui` draws the panel over the final frame\n");
    buf_bytes(out, "and writes a PPM (`guide window#checking-the-pixels-headless`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Multiple render targets\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "One pass can write several textures at once, a G-buffer: the pass\n");
    buf_bytes(out, "names a color attachment for each (`PassDesc::color(a).with_color(b)`,\n");
    buf_bytes(out, "at most 8), the pipeline a target of the same format for each, in the\n");
    buf_bytes(out, "same order (`RenderDesc::new`'s format is target 0, then\n");
    buf_bytes(out, "`desc.target(format)`), and the fragment shader returns a struct whose\n");
    buf_bytes(out, "`@location(i)` member is written into attachment i.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::{BufferUsage, Format, PassDesc, TextureUsage};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "const GBUFFER: [u8] = r\"\"\"\n");
    buf_bytes(out, "    struct G {\n");
    buf_bytes(out, "        @location(0) albedo: vec4<f32>,\n");
    buf_bytes(out, "        @location(1) normal: vec4<f32>,\n");
    buf_bytes(out, "        @location(2) depth: f32,\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    @vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {\n");
    buf_bytes(out, "        var p = vec2<f32>(-1.0, -1.0);\n");
    buf_bytes(out, "        if (i == 1u) { p = vec2<f32>(3.0, -1.0); }\n");
    buf_bytes(out, "        if (i == 2u) { p = vec2<f32>(-1.0, 3.0); }\n");
    buf_bytes(out, "        return vec4<f32>(p, 0.25, 1.0);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    @fragment fn fs(@builtin(position) pos: vec4<f32>) -> G {\n");
    buf_bytes(out, "        return G(vec4<f32>(1.0, 0.5, 0.0, 1.0), vec4<f32>(0.0, 0.0, 1.0, 1.0), pos.z);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    \"\"\";\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    let shader = dev.shader_wgsl(GBUFFER)?;\n");
    buf_bytes(out, "    var desc = gpu::RenderDesc::new(shader, \"vs\", \"fs\", Format::Rgba8Unorm); // target 0\n");
    buf_bytes(out, "    desc.target(Format::Rgba8Unorm); // target 1\n");
    buf_bytes(out, "    desc.target(Format::R32Float); // target 2\n");
    buf_bytes(out, "    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, "    let usage = TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC;\n");
    buf_bytes(out, "    let albedo = dev.texture(8, 8, Format::Rgba8Unorm, usage: usage);\n");
    buf_bytes(out, "    let normal = dev.texture(8, 8, Format::Rgba8Unorm, usage: usage);\n");
    buf_bytes(out, "    let depth = dev.texture(8, 8, Format::R32Float, usage: usage);\n");
    buf_bytes(out, "    let (av, nv, dv) = (albedo.view(), normal.view(), depth.view());\n");
    buf_bytes(out, "    var outs = [\n");
    buf_bytes(out, "        dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST),\n");
    buf_bytes(out, "        dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST),\n");
    buf_bytes(out, "        dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST),\n");
    buf_bytes(out, "    ];\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.render_pass(PassDesc::color(av).with_color(nv).with_color(dv), |pass| {\n");
    buf_bytes(out, "        pass.set_pipeline(pipe);\n");
    buf_bytes(out, "        pass.draw(0..3, 0..1); // one draw writes all three\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    enc.copy_texture_to_buffer(albedo, outs[0], 256);\n");
    buf_bytes(out, "    enc.copy_texture_to_buffer(normal, outs[1], 256);\n");
    buf_bytes(out, "    enc.copy_texture_to_buffer(depth, outs[2], 256);\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "    let a = outs[0].map_read_copy_in(dev, gpa);\n");
    buf_bytes(out, "    let n = outs[1].map_read_copy_in(dev, gpa);\n");
    buf_bytes(out, "    let d = gpu::f32s(outs[2].map_read(dev));\n");
    buf_bytes(out, "    println(f\"albedo {a[0]} {a[1]} {a[2]}, normal {n[0]} {n[1]} {n[2]}, depth {d[0]}\");\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "albedo 255 128 0, normal 0 0 255, depth 0.25\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The pass's pipelines must fit it: `pass.set_pipeline` checks that the\n");
    buf_bytes(out, "pipeline has as many color targets as the pass has color attachments,\n");
    buf_bytes(out, "each of its attachment's format (`gpu.format`, naming the counts or the\n");
    buf_bytes(out, "index), and a depth state only where the pass has a depth attachment.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Depth-only passes\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A shadow map is drawn with no color at all: `PassDesc::depth_only(view)`\n");
    buf_bytes(out, "(cleared to 1.0 and stored, to be read afterwards) and a pipeline with\n");
    buf_bytes(out, "no fragment stage and no color target, `RenderDesc::depth_only(shader,\n");
    buf_bytes(out, "\"vs\")` (a `Depth32Float` test, `Compare::Less`, that writes). The shader\n");
    buf_bytes(out, "needs only the vertex entry. The depth texture is then read by the next\n");
    buf_bytes(out, "pass as a `texture_depth_2d` (`textureLoad`, or `textureSampleCompare`\n");
    buf_bytes(out, "with a comparison sampler); it needs `TEXTURE_BINDING` for that.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::{BufferUsage, Format, PassDesc, TextureUsage, VertexFormat, VertexLayout};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "const SHADOW: [u8] = r\"\"\"\n");
    buf_bytes(out, "    @vertex fn vs(@location(0) p: vec3<f32>) -> @builtin(position) vec4<f32> {\n");
    buf_bytes(out, "        return vec4<f32>(p, 1.0);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    \"\"\";\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    let shader = dev.shader_wgsl(SHADOW)?;\n");
    buf_bytes(out, "    var desc = gpu::RenderDesc::depth_only(shader, \"vs\");\n");
    buf_bytes(out, "    var layout = VertexLayout::new(12);\n");
    buf_bytes(out, "    layout.attribute(0, VertexFormat::Float32x3, 0);\n");
    buf_bytes(out, "    desc.vertex_buffer(layout);\n");
    buf_bytes(out, "    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, "    // one triangle over the left half of the map, at depth 0.25\n");
    buf_bytes(out, "    let tri: [f32; 9] = [-1.0, -1.0, 0.25, 0.0, -1.0, 0.25, -1.0, 3.0, 0.25];\n");
    buf_bytes(out, "    let vb = dev.buffer_init(gpu::bytes_of_f32(tri[..]), BufferUsage::VERTEX);\n");
    buf_bytes(out, "    let map = dev.texture(8, 8, Format::Depth32Float,\n");
    buf_bytes(out, "        usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_SRC);\n");
    buf_bytes(out, "    let view = map.view();\n");
    buf_bytes(out, "    var out = dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.render_pass(PassDesc::depth_only(view), |pass| {\n");
    buf_bytes(out, "        pass.set_pipeline(pipe);\n");
    buf_bytes(out, "        pass.set_vertex_buffer(0, vb);\n");
    buf_bytes(out, "        pass.draw(0..3, 0..1);\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    enc.copy_texture_to_buffer(map, out, 256);\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "    let d = gpu::f32s(out.map_read(dev));\n");
    buf_bytes(out, "    println(f\"left {d[0]}, right {d[7]}\"); // the right half keeps the clear value\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "left 0.25, right 1\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
}
