// Generated by compiler/guide/embed.sh from compiler/guide/gpu-render.md (do
// not edit): the guide's topic 'gpu-render'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# GPU rendering: std::gpu (0.22; guide updated 0.25.4)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Drawing with std::gpu (`guide gpu` for the objects, compute, bind groups,\n");
    buf_bytes(out, b"usages and formats, limits and contracts): a render pipeline\n");
    buf_bytes(out, b"(`RenderDesc`) draws in a render pass (`enc.render_pass(PassDesc, |pass|\n");
    buf_bytes(out, b"..)`) into a texture or a window's frame, read back with\n");
    buf_bytes(out, b"`enc.copy_texture_to_buffer`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Render to a texture\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::gpu;\n");
    buf_bytes(out, b"use std::gpu::{BufferUsage, Format, PassDesc, Reflection, ShaderSource, TextureUsage};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> Result<(), gpu::Error<Gpa>> {\n");
    buf_bytes(out, b"    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, b"    let (dev, mut queue) = inst.adapter(gpu::Power::High)?.device(gpu::Limits::default())?;\n");
    buf_bytes(out, b"    let code = \"#include <metal_stdlib>\\nusing namespace metal;\\nvertex float4 vs(uint v [[vertex_id]]) { float2 p[3] = { float2(-1, -1), float2(3, -1), float2(-1, 3) }; return float4(p[v], 0, 1); }\\nfragment float4 fs() { return float4(1, 0.5, 0, 1); }\\n\";\n");
    buf_bytes(out, b"    let mut refl = Reflection::new_in(gpa);\n");
    buf_bytes(out, b"    refl.vertex(\"vs\", \"vs\");\n");
    buf_bytes(out, b"    refl.fragment(\"fs\", \"fs\");\n");
    buf_bytes(out, b"    let src = ShaderSource::msl(code, refl);\n");
    buf_bytes(out, b"    let shader = dev.shader(&src)?;\n");
    buf_bytes(out, b"    let desc = gpu::RenderDesc::new(&shader, \"vs\", \"fs\", Format::Rgba8Unorm);\n");
    buf_bytes(out, b"    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, b"    let tex = dev.texture(8, 8, Format::Rgba8Unorm,\n");
    buf_bytes(out, b"        TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);\n");
    buf_bytes(out, b"    let view = tex.view();\n");
    buf_bytes(out, b"    let mut out = dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, b"    let mut enc = dev.encoder();\n");
    buf_bytes(out, b"    enc.render_pass(PassDesc::color(&view, gpu::Color::black(), gpu::Load::Clear),\n");
    buf_bytes(out, b"        |pass| { // cleared to black, then drawn\n");
    buf_bytes(out, b"        pass.set_pipeline(&pipe);\n");
    buf_bytes(out, b"        pass.draw(0..3, 0..1); // a triangle over the whole target\n");
    buf_bytes(out, b"    });\n");
    buf_bytes(out, b"    enc.copy_texture_to_buffer(&tex, &out, 256); // rows 256 bytes apart\n");
    buf_bytes(out, b"    queue.submit(enc.finish());\n");
    buf_bytes(out, b"    let px = out.map_read(&dev);\n");
    buf_bytes(out, b"    println(\"{} {} {} {}\", px[0], px[1], px[2], px[3]);\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"255 128 0 255\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## A textured quad\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A vertex buffer of several attributes (`VertexLayout`: the stride, then\n");
    buf_bytes(out, b"each `@location(n)` with its format and offset), a one-channel texture\n");
    buf_bytes(out, b"written from the CPU (`queue.write_texture(&tex, bytes, bytes_per_row)`,\n");
    buf_bytes(out, b"the whole of it; a part or another layer with `write_texture_region(..,\n");
    buf_bytes(out, b"x, y, w, h, layer)`, as `copy_texture_to_buffer_region` reads one back),\n");
    buf_bytes(out, b"a sampler, and both bound beside each other: `gpu::bind_texture`,\n");
    buf_bytes(out, b"`gpu::bind_sampler`. A fragment shader samples with `textureSample`, or\n");
    buf_bytes(out, b"`textureSampleLevel(t, s, uv, 0.0)` where it must name the level (a\n");
    buf_bytes(out, b"texture of one mip level, or code outside uniform control flow); an\n");
    buf_bytes(out, b"`R8Unorm` texel reads as `vec4<f32>(r, 0, 0, 1)`, r in 0..1.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::gpu;\n");
    buf_bytes(out, b"use std::gpu::{BufferUsage, Format, PassDesc, SamplerDesc, TextureUsage, VertexFormat, VertexLayout};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"embed wgsl QUAD {\n");
    buf_bytes(out, b"    struct VOut { @builtin(position) pos: vec4<f32>, @location(0) uv: vec2<f32> }\n");
    buf_bytes(out, b"    @group(0) @binding(0) var t: texture_2d<f32>;\n");
    buf_bytes(out, b"    @group(0) @binding(1) var s: sampler;\n");
    buf_bytes(out, b"    @vertex fn vs(@location(0) pos: vec2<f32>, @location(1) uv: vec2<f32>) -> VOut {\n");
    buf_bytes(out, b"        return VOut(vec4<f32>(pos, 0.0, 1.0), uv);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    @fragment fn fs(v: VOut) -> @location(0) vec4<f32> {\n");
    buf_bytes(out, b"        let r = textureSampleLevel(t, s, v.uv, 0.0).r;\n");
    buf_bytes(out, b"        return vec4<f32>(r, r, r, 1.0);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> Result<(), gpu::Error<Gpa>> {\n");
    buf_bytes(out, b"    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, b"    let (dev, mut queue) = inst.adapter(gpu::Power::High)?.device(gpu::Limits::default())?;\n");
    buf_bytes(out, b"    let shader = dev.shader_wgsl(QUAD.src)?;\n");
    buf_bytes(out, b"    let mut desc = gpu::RenderDesc::new(&shader, QUAD.vs, QUAD.fs, Format::Rgba8Unorm);\n");
    buf_bytes(out, b"    let mut layout = VertexLayout::new(16, gpu::StepMode::Vertex); // x, y, u, v: four f32s a vertex\n");
    buf_bytes(out, b"    layout.attribute(0, VertexFormat::Float32x2, 0);\n");
    buf_bytes(out, b"    layout.attribute(1, VertexFormat::Float32x2, 8);\n");
    buf_bytes(out, b"    desc.vertex_buffer(layout);\n");
    buf_bytes(out, b"    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, b"    // two triangles over the target; uv (0, 0) at its top left\n");
    buf_bytes(out, b"    let quad: [f32; 24] = [\n");
    buf_bytes(out, b"        -1.0, 1.0, 0.0, 0.0, 1.0, 1.0, 1.0, 0.0, -1.0, -1.0, 0.0, 1.0,\n");
    buf_bytes(out, b"        -1.0, -1.0, 0.0, 1.0, 1.0, 1.0, 1.0, 0.0, 1.0, -1.0, 1.0, 1.0,\n");
    buf_bytes(out, b"    ];\n");
    buf_bytes(out, b"    let vb = dev.buffer_init(gpu::bytes_of_f32(&quad[..]), BufferUsage::VERTEX);\n");
    buf_bytes(out, b"    // a 2 x 2 R8Unorm texture, a byte a texel, rows of 2 bytes\n");
    buf_bytes(out, b"    let image = dev.texture(2, 2, Format::R8Unorm,\n");
    buf_bytes(out, b"        TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_DST); // TEXTURE_BINDING | COPY_DST\n");
    buf_bytes(out, b"    let texels: [u8; 4] = [0, 64, 128, 255];\n");
    buf_bytes(out, b"    queue.write_texture(&image, &texels[..], 2);\n");
    buf_bytes(out, b"    let sampler = dev.sampler(SamplerDesc::nearest());\n");
    buf_bytes(out, b"    let group = dev.bind_group(pipe.bind_layout(0),\n");
    buf_bytes(out, b"        &[gpu::bind_texture(0, &image.view()), gpu::bind_sampler(1, &sampler)][..]);\n");
    buf_bytes(out, b"    let target = dev.texture(4, 4, Format::Rgba8Unorm,\n");
    buf_bytes(out, b"        TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);\n");
    buf_bytes(out, b"    let mut out = dev.buffer(256 * 4, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, b"    let mut enc = dev.encoder();\n");
    buf_bytes(out, b"    enc.render_pass(PassDesc::color(&target.view(), gpu::Color::black(), gpu::Load::Clear), |pass| {\n");
    buf_bytes(out, b"        pass.set_pipeline(&pipe);\n");
    buf_bytes(out, b"        pass.set_bind_group(0, &group);\n");
    buf_bytes(out, b"        pass.set_vertex_buffer(0, &vb, 0);\n");
    buf_bytes(out, b"        pass.draw(0..6, 0..1);\n");
    buf_bytes(out, b"    });\n");
    buf_bytes(out, b"    enc.copy_texture_to_buffer(&target, &out, 256);\n");
    buf_bytes(out, b"    queue.submit(enc.finish());\n");
    buf_bytes(out, b"    let px = out.map_read(&dev);\n");
    buf_bytes(out, b"    // the red byte of the four corners: each texel covers 2 x 2 pixels\n");
    buf_bytes(out, b"    println(\"{} {} {} {}\", px[0], px[3 * 4], px[3 * 256], px[3 * 256 + 3 * 4]);\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"0 64 128 255\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Drawing over the image you just made\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An overlay (a panel, a label, a cursor) is one more render pass into the\n");
    buf_bytes(out, b"same target after the scene's passes and before `frame.present`: a\n");
    buf_bytes(out, b"pass that keeps what is there instead of clearing it,\n");
    buf_bytes(out, b"`PassDesc::color(&view, Color::black(), load: Load::Keep)`, and a pipeline that blends\n");
    buf_bytes(out, b"over it, `desc.blend(Blend::alpha(), 0)` (source over destination, straight\n");
    buf_bytes(out, b"alpha; `Blend::premultiplied()` for premultiplied colours). Everything\n");
    buf_bytes(out, b"is a textured quad from one vertex buffer of position, colour and uv\n");
    buf_bytes(out, b"(`VertexLayout::new(32, gpu::StepMode::Vertex)`: `Float32x2`, `Float32x4`, `Float32x2`), and\n");
    buf_bytes(out, b"one `R8Unorm` atlas (`queue.write_texture`) holds the glyphs and a white\n");
    buf_bytes(out, b"texel: a solid quad samples the white texel, a character its glyph, and\n");
    buf_bytes(out, b"the fragment shader writes the colour with alpha times the coverage. A\n");
    buf_bytes(out, b"string's width is its glyph count times the advance, less the last gap,\n");
    buf_bytes(out, b"so text is measured before it is placed (centred, right-aligned). A\n");
    buf_bytes(out, b"window's frame is `Bgra8Unorm`: the pipeline's format is the frame's.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::gpu;\n");
    buf_bytes(out, b"use std::gpu::{Blend, BufferUsage, Color, Format, Load, PassDesc, SamplerDesc, TextureUsage, VertexFormat, VertexLayout};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"embed wgsl UI {\n");
    buf_bytes(out, b"    struct VIn {\n");
    buf_bytes(out, b"        @location(0) pos: vec2<f32>, @location(1) color: vec4<f32>, @location(2) uv: vec2<f32>,\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    struct VOut {\n");
    buf_bytes(out, b"        @builtin(position) pos: vec4<f32>, @location(0) color: vec4<f32>, @location(1) uv: vec2<f32>,\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    @group(0) @binding(0) var atlas: texture_2d<f32>;\n");
    buf_bytes(out, b"    @group(0) @binding(1) var samp: sampler;\n");
    buf_bytes(out, b"    @vertex fn vs(v: VIn) -> VOut {\n");
    buf_bytes(out, b"        return VOut(vec4<f32>(v.pos, 0.0, 1.0), v.color, v.uv);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    @fragment fn fs(v: VOut) -> @location(0) vec4<f32> {\n");
    buf_bytes(out, b"        let coverage = textureSampleLevel(atlas, samp, v.uv, 0.0).r; // ink, or the white texel\n");
    buf_bytes(out, b"        return vec4<f32>(v.color.rgb, v.color.a * coverage);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// The atlas (R8Unorm, 12 x 5 texels, '#' is 255): the white texel at\n");
    buf_bytes(out, b"// (0, 0) for solid quads, then 'H' and 'I', 3 x 5 each, at x 4 and 8.\n");
    buf_bytes(out, b"static ART: [&str; 5] = [\n");
    buf_bytes(out, b"    \"#   # # ### \",\n");
    buf_bytes(out, b"    \"    # #  #  \",\n");
    buf_bytes(out, b"    \"    ###  #  \",\n");
    buf_bytes(out, b"    \"    # #  #  \",\n");
    buf_bytes(out, b"    \"    # # ### \",\n");
    buf_bytes(out, b"];\n");
    buf_bytes(out, b"const AW: f64 = 12.0;\n");
    buf_bytes(out, b"const AH: f64 = 5.0;\n");
    buf_bytes(out, b"const W: i64 = 16; // the target, in pixels\n");
    buf_bytes(out, b"const H: i64 = 8;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// Pixels (x0, y0)-(x1, y1) showing atlas texels (u0, v0)-(u1, v1) (in\n");
    buf_bytes(out, b"// 0..1) in colour c: two triangles of x, y, r, g, b, a, u, v.\n");
    buf_bytes(out, b"fn quad(vs: &mut Vec<f32, Gpa>, x0: f64, y0: f64, x1: f64, y1: f64, uv: [f64; 4], c: [f32; 4]) {\n");
    buf_bytes(out, b"    let (l, r) = (2.0 * x0 / W as f64 - 1.0, 2.0 * x1 / W as f64 - 1.0);\n");
    buf_bytes(out, b"    let (t, b) = (1.0 - 2.0 * y0 / H as f64, 1.0 - 2.0 * y1 / H as f64);\n");
    buf_bytes(out, b"    let corners = [\n");
    buf_bytes(out, b"        [l, t, uv[0], uv[1]], [r, t, uv[2], uv[1]], [l, b, uv[0], uv[3]],\n");
    buf_bytes(out, b"        [l, b, uv[0], uv[3]], [r, t, uv[2], uv[1]], [r, b, uv[2], uv[3]],\n");
    buf_bytes(out, b"    ];\n");
    buf_bytes(out, b"    for p in corners {\n");
    buf_bytes(out, b"        vs.extend_from_slice(&[p[0] as f32, p[1] as f32, c[0], c[1], c[2], c[3], p[2] as f32,\n");
    buf_bytes(out, b"            p[3] as f32][..]);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// The width of s in pixels: 4 a glyph (3 of ink, 1 of space), less the last space.\n");
    buf_bytes(out, b"fn text_width(s: &[u8]) -> f64 {\n");
    buf_bytes(out, b"    if s.len() == 0 { 0.0 } else { (s.len() * 4 - 1) as f64 }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// One quad a glyph from (x, y), the top left; its cell from the byte.\n");
    buf_bytes(out, b"fn text(vs: &mut Vec<f32, Gpa>, x: f64, y: f64, s: &[u8], c: [f32; 4]) {\n");
    buf_bytes(out, b"    let mut cx = x;\n");
    buf_bytes(out, b"    for &ch in s {\n");
    buf_bytes(out, b"        let u = if ch == b'H' { 4.0 } else { 8.0 }; // a real font: a table of cells\n");
    buf_bytes(out, b"        quad(vs, cx, y, cx + 3.0, y + 5.0, [u / AW, 0.0, (u + 3.0) / AW, 1.0], c);\n");
    buf_bytes(out, b"        cx += 4.0;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> Result<(), gpu::Error<Gpa>> {\n");
    buf_bytes(out, b"    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, b"    let (dev, mut queue) = inst.adapter(gpu::Power::High)?.device(gpu::Limits::default())?;\n");
    buf_bytes(out, b"    let target = dev.texture(W, H, Format::Rgba8Unorm,\n");
    buf_bytes(out, b"        TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);\n");
    buf_bytes(out, b"    let view = target.view();\n");
    buf_bytes(out, b"    // the image you just made: here a pass that clears it to blue\n");
    buf_bytes(out, b"    let mut enc = dev.encoder();\n");
    buf_bytes(out, b"    enc.render_pass(PassDesc::color(&view, clear: Color::rgba(0.0, 0.0, 1.0, 1.0),\n");
    buf_bytes(out, b"        load: Load::Clear), |_| {});\n");
    buf_bytes(out, b"    queue.submit(enc.finish());\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    // the overlay: a blended pipeline of position, colour and uv\n");
    buf_bytes(out, b"    let shader = dev.shader_wgsl(UI.src)?;\n");
    buf_bytes(out, b"    let mut desc = gpu::RenderDesc::new(&shader, UI.vs, UI.fs, Format::Rgba8Unorm); // a frame: Bgra8Unorm\n");
    buf_bytes(out, b"    let mut layout = VertexLayout::new(32, gpu::StepMode::Vertex); // 8 f32s a vertex\n");
    buf_bytes(out, b"    layout.attribute(0, VertexFormat::Float32x2, 0); // x, y\n");
    buf_bytes(out, b"    layout.attribute(1, VertexFormat::Float32x4, 8); // r, g, b, a\n");
    buf_bytes(out, b"    layout.attribute(2, VertexFormat::Float32x2, 24); // u, v\n");
    buf_bytes(out, b"    desc.vertex_buffer(layout);\n");
    buf_bytes(out, b"    desc.blend(Blend::alpha(), 0); // source over what is there\n");
    buf_bytes(out, b"    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, b"    let mut texels: Vec<u8, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    for row in ART {\n");
    buf_bytes(out, b"        for &ch in row.as_bytes() {\n");
    buf_bytes(out, b"            texels.push(if ch == b'#' { 255 } else { 0 });\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let atlas = dev.texture(12, 5, Format::R8Unorm,\n");
    buf_bytes(out, b"        TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_DST); // TEXTURE_BINDING | COPY_DST\n");
    buf_bytes(out, b"    queue.write_texture(&atlas, texels.as_slice(), 12); // rows of 12 bytes\n");
    buf_bytes(out, b"    let sampler = dev.sampler(SamplerDesc::nearest());\n");
    buf_bytes(out, b"    let group = dev.bind_group(pipe.bind_layout(0),\n");
    buf_bytes(out, b"        &[gpu::bind_texture(0, &atlas.view()), gpu::bind_sampler(1, &sampler)][..]);\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    // the draw list: a half-dark box, then \"HI\" measured and centred in it\n");
    buf_bytes(out, b"    let mut verts: Vec<f32, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    let white = [0.5 / AW, 0.5 / AH, 0.5 / AW, 0.5 / AH];\n");
    buf_bytes(out, b"    quad(&mut verts, 1.0, 1.0, 10.0, 8.0, white, [0.0, 0.0, 0.0, 0.5]);\n");
    buf_bytes(out, b"    let label = \"HI\";\n");
    buf_bytes(out, b"    text(&mut verts, 1.0 + (9.0 - text_width(label.as_bytes())) / 2.0, 2.0, label.as_bytes(), [1.0, 1.0, 0.0, 1.0]);\n");
    buf_bytes(out, b"    let vb = dev.buffer_init(gpu::bytes_of_f32(verts.as_slice()), BufferUsage::VERTEX);\n");
    buf_bytes(out, b"    let count = verts.len() / 8;\n");
    buf_bytes(out, b"    let mut out = dev.buffer(256 * H, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, b"    let mut enc2 = dev.encoder();\n");
    buf_bytes(out, b"    enc2.render_pass(PassDesc::color(&view, Color::black(), load: Load::Keep),\n");
    buf_bytes(out, b"        |pass| { // kept, not cleared\n");
    buf_bytes(out, b"        pass.set_pipeline(&pipe);\n");
    buf_bytes(out, b"        pass.set_bind_group(0, &group);\n");
    buf_bytes(out, b"        pass.set_vertex_buffer(0, &vb, 0);\n");
    buf_bytes(out, b"        pass.draw(0..count as i64, 0..1);\n");
    buf_bytes(out, b"    });\n");
    buf_bytes(out, b"    enc2.copy_texture_to_buffer(&target, &out, 256);\n");
    buf_bytes(out, b"    queue.submit(enc2.finish());\n");
    buf_bytes(out, b"    let px = out.map_read(&dev);\n");
    buf_bytes(out, b"    // a pixel a character: '#' the text, 'o' the box, '.' the image\n");
    buf_bytes(out, b"    for y in 0..H as usize {\n");
    buf_bytes(out, b"        let mut line: [u8; 16] = [0; 16];\n");
    buf_bytes(out, b"        for x in 0..W as usize {\n");
    buf_bytes(out, b"            let p = y * 256 + x * 4;\n");
    buf_bytes(out, b"            line[x] = if px[p] > 200 { b'#' } else if px[p + 2] > 200 { b'.' } else { b'o' };\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        println(\"{}\", str::from_utf8(&line[..]).unwrap());\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"box {}, image {}\", px[256 + 4 + 2], px[256 + 14 * 4 + 2]); // blue, half and whole\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"................\n");
    buf_bytes(out, b".ooooooooo......\n");
    buf_bytes(out, b".o#o#o###o......\n");
    buf_bytes(out, b".o#o#oo#oo......\n");
    buf_bytes(out, b".o###oo#oo......\n");
    buf_bytes(out, b".o#o#oo#oo......\n");
    buf_bytes(out, b".o#o#o###o......\n");
    buf_bytes(out, b".ooooooooo......\n");
    buf_bytes(out, b"box 128, image 255\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A whole one: examples/gpu/pathtrace (`ui_render.vl`: the pipeline and\n");
    buf_bytes(out, b"the pass; `font.vl`: a 5 x 7 font of 95 glyphs baked into a 128 x 128\n");
    buf_bytes(out, b"atlas; `ui.wgsl`; `ui.vl`'s `quad`, `text`, `text_width`, with\n");
    buf_bytes(out, b"clipping). Its `--headless --ui` draws the panel over the final frame\n");
    buf_bytes(out, b"and writes a PPM (`guide window#checking-the-pixels-headless`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Multiple render targets\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"One pass can write several textures at once, a G-buffer: the pass\n");
    buf_bytes(out, b"names a color attachment for each (`PassDesc::color(&a, clear,\n");
    buf_bytes(out, b"load).with_color(&b, clear, load)`,\n");
    buf_bytes(out, b"at most 8), the pipeline a target of the same format for each, in the\n");
    buf_bytes(out, b"same order (`RenderDesc::new`'s format is target 0, then\n");
    buf_bytes(out, b"`desc.target(format)`), and the fragment shader returns a struct whose\n");
    buf_bytes(out, b"`@location(i)` member is written into attachment i.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::gpu;\n");
    buf_bytes(out, b"use std::gpu::{BufferUsage, Format, PassDesc, TextureUsage};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"embed wgsl GBUFFER {\n");
    buf_bytes(out, b"    struct G {\n");
    buf_bytes(out, b"        @location(0) albedo: vec4<f32>,\n");
    buf_bytes(out, b"        @location(1) normal: vec4<f32>,\n");
    buf_bytes(out, b"        @location(2) depth: f32,\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    @vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {\n");
    buf_bytes(out, b"        var p = vec2<f32>(-1.0, -1.0);\n");
    buf_bytes(out, b"        if (i == 1u) { p = vec2<f32>(3.0, -1.0); }\n");
    buf_bytes(out, b"        if (i == 2u) { p = vec2<f32>(-1.0, 3.0); }\n");
    buf_bytes(out, b"        return vec4<f32>(p, 0.25, 1.0);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    @fragment fn fs(@builtin(position) pos: vec4<f32>) -> G {\n");
    buf_bytes(out, b"        return G(vec4<f32>(1.0, 0.5, 0.0, 1.0), vec4<f32>(0.0, 0.0, 1.0, 1.0), pos.z);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> Result<(), gpu::Error<Gpa>> {\n");
    buf_bytes(out, b"    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, b"    let (dev, mut queue) = inst.adapter(gpu::Power::High)?.device(gpu::Limits::default())?;\n");
    buf_bytes(out, b"    let shader = dev.shader_wgsl(GBUFFER.src)?;\n");
    buf_bytes(out, b"    let mut desc = gpu::RenderDesc::new(&shader, GBUFFER.vs, GBUFFER.fs, Format::Rgba8Unorm); // target 0\n");
    buf_bytes(out, b"    desc.target(Format::Rgba8Unorm); // target 1\n");
    buf_bytes(out, b"    desc.target(Format::R32Float); // target 2\n");
    buf_bytes(out, b"    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, b"    let usage = TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC;\n");
    buf_bytes(out, b"    let albedo = dev.texture(8, 8, Format::Rgba8Unorm, usage);\n");
    buf_bytes(out, b"    let normal = dev.texture(8, 8, Format::Rgba8Unorm, usage);\n");
    buf_bytes(out, b"    let depth = dev.texture(8, 8, Format::R32Float, usage);\n");
    buf_bytes(out, b"    let (av, nv, dv) = (albedo.view(), normal.view(), depth.view());\n");
    buf_bytes(out, b"    let mut outs = [\n");
    buf_bytes(out, b"        dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST),\n");
    buf_bytes(out, b"        dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST),\n");
    buf_bytes(out, b"        dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST),\n");
    buf_bytes(out, b"    ];\n");
    buf_bytes(out, b"    let mut enc = dev.encoder();\n");
    buf_bytes(out, b"    enc.render_pass(PassDesc::color(&av, gpu::Color::black(), gpu::Load::Clear).with_color(&nv,\n");
    buf_bytes(out, b"        gpu::Color::black(), gpu::Load::Clear).with_color(&dv, gpu::Color::black(),\n");
    buf_bytes(out, b"        gpu::Load::Clear), |pass| {\n");
    buf_bytes(out, b"        pass.set_pipeline(&pipe);\n");
    buf_bytes(out, b"        pass.draw(0..3, 0..1); // one draw writes all three\n");
    buf_bytes(out, b"    });\n");
    buf_bytes(out, b"    enc.copy_texture_to_buffer(&albedo, &outs[0], 256);\n");
    buf_bytes(out, b"    enc.copy_texture_to_buffer(&normal, &outs[1], 256);\n");
    buf_bytes(out, b"    enc.copy_texture_to_buffer(&depth, &outs[2], 256);\n");
    buf_bytes(out, b"    queue.submit(enc.finish());\n");
    buf_bytes(out, b"    let a = outs[0].map_read_copy_in(&dev, gpa);\n");
    buf_bytes(out, b"    let n = outs[1].map_read_copy_in(&dev, gpa);\n");
    buf_bytes(out, b"    let d = gpu::f32s(outs[2].map_read(&dev));\n");
    buf_bytes(out, b"    println(\"albedo {} {} {}, normal {} {} {}, depth {}\", a[0], a[1], a[2], n[0], n[1], n[2], d[0]);\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"albedo 255 128 0, normal 0 0 255, depth 0.25\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The pass's pipelines must fit it: `pass.set_pipeline` checks that the\n");
    buf_bytes(out, b"pipeline has as many color targets as the pass has color attachments,\n");
    buf_bytes(out, b"each of its attachment's format (`gpu.format`, naming the counts or the\n");
    buf_bytes(out, b"index), and a depth state only where the pass has a depth attachment.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Depth-only passes\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A shadow map is drawn with no color at all: `PassDesc::depth_only(&view, 1.0, true)`\n");
    buf_bytes(out, b"(cleared to 1.0 and stored, to be read afterwards) and a pipeline with\n");
    buf_bytes(out, b"no fragment stage and no color target, `RenderDesc::depth_only(&shader,\n");
    buf_bytes(out, b"\"vs\", Format::Depth32Float, Compare::Less)` (a test that writes). The shader\n");
    buf_bytes(out, b"needs only the vertex entry. The depth texture is then read by the next\n");
    buf_bytes(out, b"pass as a `texture_depth_2d` (`textureLoad`, or `textureSampleCompare`\n");
    buf_bytes(out, b"with a comparison sampler); it needs `TEXTURE_BINDING` for that.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::gpu;\n");
    buf_bytes(out, b"use std::gpu::{BufferUsage, Format, PassDesc, TextureUsage, VertexFormat, VertexLayout};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"embed wgsl SHADOW {\n");
    buf_bytes(out, b"    @vertex fn vs(@location(0) p: vec3<f32>) -> @builtin(position) vec4<f32> {\n");
    buf_bytes(out, b"        return vec4<f32>(p, 1.0);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> Result<(), gpu::Error<Gpa>> {\n");
    buf_bytes(out, b"    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, b"    let (dev, mut queue) = inst.adapter(gpu::Power::High)?.device(gpu::Limits::default())?;\n");
    buf_bytes(out, b"    let shader = dev.shader_wgsl(SHADOW.src)?;\n");
    buf_bytes(out, b"    let mut desc = gpu::RenderDesc::depth_only(&shader, SHADOW.vs, Format::Depth32Float,\n");
    buf_bytes(out, b"        gpu::Compare::Less);\n");
    buf_bytes(out, b"    let mut layout = VertexLayout::new(12, gpu::StepMode::Vertex);\n");
    buf_bytes(out, b"    layout.attribute(0, VertexFormat::Float32x3, 0);\n");
    buf_bytes(out, b"    desc.vertex_buffer(layout);\n");
    buf_bytes(out, b"    let pipe = dev.render_pipeline(desc)?;\n");
    buf_bytes(out, b"    // one triangle over the left half of the map, at depth 0.25\n");
    buf_bytes(out, b"    let tri: [f32; 9] = [-1.0, -1.0, 0.25, 0.0, -1.0, 0.25, -1.0, 3.0, 0.25];\n");
    buf_bytes(out, b"    let vb = dev.buffer_init(gpu::bytes_of_f32(&tri[..]), BufferUsage::VERTEX);\n");
    buf_bytes(out, b"    let map = dev.texture(8, 8, Format::Depth32Float,\n");
    buf_bytes(out, b"        TextureUsage::RENDER_ATTACHMENT | TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_SRC);\n");
    buf_bytes(out, b"    let view = map.view();\n");
    buf_bytes(out, b"    let mut out = dev.buffer(256 * 8, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, b"    let mut enc = dev.encoder();\n");
    buf_bytes(out, b"    enc.render_pass(PassDesc::depth_only(&view, 1.0, true), |pass| {\n");
    buf_bytes(out, b"        pass.set_pipeline(&pipe);\n");
    buf_bytes(out, b"        pass.set_vertex_buffer(0, &vb, 0);\n");
    buf_bytes(out, b"        pass.draw(0..3, 0..1);\n");
    buf_bytes(out, b"    });\n");
    buf_bytes(out, b"    enc.copy_texture_to_buffer(&map, &out, 256);\n");
    buf_bytes(out, b"    queue.submit(enc.finish());\n");
    buf_bytes(out, b"    let d = gpu::f32s(out.map_read(&dev));\n");
    buf_bytes(out, b"    println(\"left {}, right {}\", d[0], d[7]); // the right half keeps the clear value\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"left 0.25, right 1\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
}
