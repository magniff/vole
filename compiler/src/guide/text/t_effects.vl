// Generated by compiler/guide/embed.sh from compiler/guide/effects.md (do
// not edit): the guide's topic 'effects'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Effects (0.16)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Every function has an inferred effect set: what calling it may do. It\n");
    buf_bytes(out, b"is inferred from the body and everything the body calls, closures and\n");
    buf_bytes(out, b"generic instances included, and never depends on `-O`. A signature\n");
    buf_bytes(out, b"says two things: its conventions what a call may change of its\n");
    buf_bytes(out, b"arguments (`inout`) and keep (`sink`), its effects what it may do beyond\n");
    buf_bytes(out, b"them:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| effect | comes from |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `alloc(Gpa)`, `alloc(Arena)`, `alloc(extern)` | allocating from that allocator type (`extern`: C's malloc) |\n");
    buf_bytes(out, b"| `io` | a C function that reads or writes: `write`, `read`, stdio |\n");
    buf_bytes(out, b"| `static` | reading or writing a `static var`, taking its address (not shown in a set: `--why static`; `global` its old name, an alias) |\n");
    buf_bytes(out, b"| `panic` | a checked index or slice, `unwrap`, `as E`, std's panic, an `assert` (but `assert(true)`), a requires (in the caller), an ensures |\n");
    buf_bytes(out, b"| `diverge` | `while`, `loop`, recursion: it may not return (a counted `for` returns) |\n");
    buf_bytes(out, b"| `unsafe` | unsafe operations in its own body (not its callers') |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A set is written in that order, `none` for the empty one. Allocation is\n");
    buf_bytes(out, b"explicit (`guide allocators`), so `alloc(Gpa)` without `static` means\n");
    buf_bytes(out, b"\"from a Gpa it was given\". Running out of memory is `alloc`, not `panic`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Asking\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec query effects total            # crate::total  alloc(Gpa) panic\n");
    buf_bytes(out, b"volec query effects crate::parser    # every function of a module\n");
    buf_bytes(out, b"volec query effects total --why alloc     # the chain of calls down to where it allocates\n");
    buf_bytes(out, b"volec query effects crate --has io        # the functions that do io\n");
    buf_bytes(out, b"volec --print-effects main.vl           # every function's set, then the build\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`query def`, `show` and `context` print a function's set on its first\n");
    buf_bytes(out, b"line (`effects: alloc(Gpa) panic`); a generic function's sets are its\n");
    buf_bytes(out, b"instances' (`query effects` lists each).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Declaring\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A declaration is an upper bound the compiler checks against the\n");
    buf_bytes(out, b"inferred set; callers still see the inferred one, which may be smaller.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[pure]                                   // no alloc, io or static\n");
    buf_bytes(out, b"fn mid(a: i64, b: i64) -> i64 { a + (b - a) / 2 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[no_alloc]\n");
    buf_bytes(out, b"fn sum(s: [i64]) -> i64 { s.iter().sum() }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[effects(alloc(Gpa), panic)]             // at most these\n");
    buf_bytes(out, b"fn grow(v: inout Vec<i64, Gpa>) { v.push(1); }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn apply<F: Fn(i64) -> i64 + effects(panic)>(f: F, x: i64) -> i64 { f(x) }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let a = [1, 2];\n");
    buf_bytes(out, b"    println(apply(|x| mid(x, 10), 2) + sum(a[..]));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"9\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `#[pure]`: no `alloc`, `io`, `static` (it may panic, loop and write\n");
    buf_bytes(out, b"  through its `inout` parameters: they are in the signature, the call\n");
    buf_bytes(out, b"  marks them `&x`); `#[no_alloc]`, `#[no_io]`,\n");
    buf_bytes(out, b"  `#[no_panic]` forbid one; `#[effects(...)]` lists what is allowed,\n");
    buf_bytes(out, b"  `#[effects()]` nothing. Several attributes intersect.\n");
    buf_bytes(out, b"- On a trait's function (`#[pure] fn hash(self) -> u64;`) the\n");
    buf_bytes(out, b"  declaration binds every impl; std's `Eq`, `Ord` and `Hash` are pure.\n");
    buf_bytes(out, b"- On a C function in an `extern` block it is trusted, as its signature\n");
    buf_bytes(out, b"  is. Undeclared, std's table applies (libm and `mem*`: none, `malloc`:\n");
    buf_bytes(out, b"  `alloc(extern)`, stdio: `io`), else everything.\n");
    buf_bytes(out, b"- A bound `F: Fn(..) -> R + effects(panic)` is checked where `F` is\n");
    buf_bytes(out, b"  given: the error is at the call, naming the closure's effect.\n");
    buf_bytes(out, b"- A call through a `fn` value may call every function of that type\n");
    buf_bytes(out, b"  whose address the program takes.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A broken declaration is one error with where the effect comes from:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"sum.vl:3:1: error[effect] 'total' is #[no_alloc], but it allocates from Gpa: 'v.push(x)' at sum.vl:7:9 grows a Vec<i64>\n");
    buf_bytes(out, b"help: allocate in the caller and pass the memory in, or remove #[no_alloc]\n");
    buf_bytes(out, b"try: volec query effects total --why alloc\n");
    buf_bytes(out, b"```\n");
}
