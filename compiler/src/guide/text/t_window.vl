// Generated by compiler/guide/embed.sh from compiler/guide/window.md (do
// not edit): the guide's topic 'window'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Windows: std::window (0.23; guide updated 0.25.4)\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`std::window` opens windows and reads their input, winit's objects with\n");
    buf_bytes(out, "events pulled rather than pushed. 0.23.0 runs on macOS (Cocoa); Wayland\n");
    buf_bytes(out, "and X11 come in 0.23.1 behind the same API.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "use std::window::{App, Event, WindowDesc};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, "    var app = App::new_in(gpa).unwrap();              // Err(NoDisplay) under ssh\n");
    buf_bytes(out, "    let desc = WindowDesc::new(\"demo\", 800, 600);     // logical points\n");
    buf_bytes(out, "    var win = app.window(desc).unwrap();\n");
    buf_bytes(out, "    win.request_frame();\n");
    buf_bytes(out, "    loop {\n");
    buf_bytes(out, "        match app.wait().unwrap() {                   // blocks; nothing busy-waits\n");
    buf_bytes(out, "            Event::Frame(_) => draw(win),             // once per request_frame\n");
    buf_bytes(out, "            Event::Key(k) => if k.pressed && !k.ime { on_key(k) },\n");
    buf_bytes(out, "            Event::Text(t) => typed(t.bytes[0..t.len as i64]),  // UTF-8, inline\n");
    buf_bytes(out, "            Event::Resize(_, s) => resize(s.w, s.h, s.scale),   // physical pixels\n");
    buf_bytes(out, "            Event::Readable(fd) => read_more(fd),     // a watched fd (app.watch)\n");
    buf_bytes(out, "            Event::Close(_) | Event::Quit => break,\n");
    buf_bytes(out, "            _ => {}\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0                                                 // win, then app, dropped\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- **Events**: `Frame`, `Key` (physical `KeyCode`, logical `Logical`,\n");
    buf_bytes(out, "  `Mods` with left and right, `repeat`, `ime`, `text_follows`), `Text`,\n");
    buf_bytes(out, "  `Preedit` (`app.preedit()` is the composition), `Resize` (physical\n");
    buf_bytes(out, "  pixels and the scale), `Mouse` (press, release, move; pixels from the\n");
    buf_bytes(out, "  top-left; `clicks`), `Scroll` (`precise`: pixels, else lines),\n");
    buf_bytes(out, "  `Cursor` (enter, leave), `Focus`, `Readable`, `Close`, `Quit`.\n");
    buf_bytes(out, "- **Calls**: `app.wait()`, `poll()`, `wait_timeout(ms)`; `app.watch(fd)`;\n");
    buf_bytes(out, "  `app.clipboard_get_in(gpa)`, `clipboard_set(text)`;\n");
    buf_bytes(out, "  `app.on_live_resize(f, ctx)` (`ctx` a raw `*u8`; macOS runs its own loop while a window\n");
    buf_bytes(out, "  edge is dragged: `f` is called there and may `poll` and draw).\n");
    buf_bytes(out, "  `win.request_frame()`, `size()`, `raw_surface()` (the CAMetalLayer),\n");
    buf_bytes(out, "  `set_title`, `set_cursor`, `hide_cursor_while_typing`,\n");
    buf_bytes(out, "  `set_ime_area(x, y, w, h)`, `set_fullscreen`, `focused`, `close`.\n");
    buf_bytes(out, "- **HiDPI units** (0.25.2.2): only `WindowDesc::new(title, w, h)` is in\n");
    buf_bytes(out, "  logical points. Everything a program reads back is in physical pixels:\n");
    buf_bytes(out, "  `win.size()` (a `Size { w, h, scale }`), `Resize`'s size, `Mouse.x`\n");
    buf_bytes(out, "  and `.y`, `Scroll`'s precise deltas. On a Retina display (`scale`\n");
    buf_bytes(out, "  2.0) `WindowDesc::new(\"demo\", 800, 600)` gives `win.size()` 1600 x\n");
    buf_bytes(out, "  1200. Configure the surface with that size (`surf.configure(dev,\n");
    buf_bytes(out, "  s.w, s.h, ..)`, again at each `Resize`), so `surf.width` and\n");
    buf_bytes(out, "  `surf.height` are the drawable's pixels too; a snapshot of the window\n");
    buf_bytes(out, "  (a copy of its frame, a canvas, a PPM) is `surf.width` x\n");
    buf_bytes(out, "  `surf.height`, never the WindowDesc's numbers (those give its top-left\n");
    buf_bytes(out, "  quarter at scale 2). The scale is the window's, not the surface's:\n");
    buf_bytes(out, "  `Surface` has none (its fields are `raw`, `configured`, `width`,\n");
    buf_bytes(out, "  `height`, `format`); keep the last `Size`'s `scale` (`win.size()`,\n");
    buf_bytes(out, "  then each `Resize`'s) beside the surface, and divide by it only for\n");
    buf_bytes(out, "  logical points (UI sizes meant to look the same on every display). The\n");
    buf_bytes(out, "  mouse maps with the surface's size now (`window#mouse-and-surface-size`).\n");
    buf_bytes(out, "- **Frames when the window is not shown** (0.25.2.1) come from a\n");
    buf_bytes(out, "  10 Hz timer: their times are not the program's\n");
    buf_bytes(out, "  (`window#when-the-window-is-not-shown`).\n");
    buf_bytes(out, "- **Keys and text**: a key that types something is a `Key` with\n");
    buf_bytes(out, "  `text_follows`, then a `Text`. Encode keys that do not (arrows, Return,\n");
    buf_bytes(out, "  Control-letters); send `Text` as it is. `ime` marks keys an input\n");
    buf_bytes(out, "  method took.\n");
    buf_bytes(out, "- **Linking**: nothing to add. std::window's extern blocks name what\n");
    buf_bytes(out, "  they link (`#[link(framework = \"AppKit\")]`, `guide c-interop`), so\n");
    buf_bytes(out, "  `volec main.vl -o app` links AppKit, QuartzCore and libobjc.\n");
    buf_bytes(out, "- **Tests**: `tests/window/run.sh`; the checks that need a display skip\n");
    buf_bytes(out, "  without one (`VOLE_NO_DISPLAY_TESTS=1` too). (0.25.4) A program's own\n");
    buf_bytes(out, "  event loop runs without a display, its input and frames from a script:\n");
    buf_bytes(out, "  `VOLE_WINDOW_SCRIPT='frames 2; key space; click 40 30; shot a.ppm;\n");
    buf_bytes(out, "  frames 1' ./prog` (`window#testing-input-without-a-display`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Mouse and surface size\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`Mouse.x` and `.y` are physical pixels from the content's top-left,\n");
    buf_bytes(out, "the units of `surf.width` and `surf.height`. Map them with the\n");
    buf_bytes(out, "surface's size now: `surf.configure` at each `Event::Resize` sets\n");
    buf_bytes(out, "`surf.width` and `.height` (a `Resize` also comes first, after\n");
    buf_bytes(out, "`app.window`). A size taken once at the start (`let px = win.size();`)\n");
    buf_bytes(out, "is wrong once the window is resized or moved to a display of another\n");
    buf_bytes(out, "scale: the pointer then lands on the wrong cell. To a grid of `cells`:\n");
    buf_bytes(out, "`m.x / surf.width as f64 * cells`; to a shader's coordinates (y up):\n");
    buf_bytes(out, "`2 * x / width - 1` and `1 - 2 * y / height`.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::RawSurface;\n");
    buf_bytes(out, "use std::window::{App, Button, Event, MouseAction, WindowDesc};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "const GRID: f64 = 128.0; // the simulation's cells across and down\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    var app = match App::new_in(gpa) {\n");
    buf_bytes(out, "        Ok(a) => a,\n");
    buf_bytes(out, "        Err(_) => return Ok(()),\n");
    buf_bytes(out, "    };\n");
    buf_bytes(out, "    var win = match app.window(WindowDesc::new(\"mouse\", 512, 512)) {\n");
    buf_bytes(out, "        Ok(w) => w,\n");
    buf_bytes(out, "        Err(_) => return Ok(()),\n");
    buf_bytes(out, "    };\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var _queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    var surf = inst.surface(dev, RawSurface::MetalLayer(win.raw_surface()))?;\n");
    buf_bytes(out, "    let px = win.size(); // the size now: stale after a Resize\n");
    buf_bytes(out, "    surf.configure(dev, px.w, px.h);\n");
    buf_bytes(out, "    var scale = px.scale; // the window's; a Surface has no scale\n");
    buf_bytes(out, "    var down = false;\n");
    buf_bytes(out, "    loop {\n");
    buf_bytes(out, "        match app.wait() {\n");
    buf_bytes(out, "            Ok(Event::Resize(_, s)) => {\n");
    buf_bytes(out, "                surf.configure(dev, s.w, s.h); // surf.width, .height follow\n");
    buf_bytes(out, "                scale = s.scale;\n");
    buf_bytes(out, "            }\n");
    buf_bytes(out, "            Ok(Event::Mouse(m)) => {\n");
    buf_bytes(out, "                if m.button == Button::Left && m.action != MouseAction::Move {\n");
    buf_bytes(out, "                    down = m.action == MouseAction::Press;\n");
    buf_bytes(out, "                }\n");
    buf_bytes(out, "                if down {\n");
    buf_bytes(out, "                    // with the surface's size, never px\n");
    buf_bytes(out, "                    let cx = (m.x / surf.width as f64 * GRID) as i64;\n");
    buf_bytes(out, "                    let cy = (m.y / surf.height as f64 * GRID) as i64;\n");
    buf_bytes(out, "                    let nx = 2.0 * m.x / surf.width as f64 - 1.0;\n");
    buf_bytes(out, "                    let ny = 1.0 - 2.0 * m.y / surf.height as f64;\n");
    buf_bytes(out, "                    let pt = m.x / scale; // logical points, for UI sizes\n");
    buf_bytes(out, "                    println(\"cell {cx} {cy}, shader {nx:.2} {ny:.2}, x {pt:.0} pt\");\n");
    buf_bytes(out, "                }\n");
    buf_bytes(out, "            }\n");
    buf_bytes(out, "            Ok(Event::Close(_)) | Ok(Event::Quit) => break,\n");
    buf_bytes(out, "            _ => {}\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## When the window is not shown\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The display gives no frames while it is asleep (the screen locked,\n");
    buf_bytes(out, "nobody there), or while the window is covered, hidden, minimized or on\n");
    buf_bytes(out, "another Space. A request is then answered by a timer, 10 frames a\n");
    buf_bytes(out, "second (60 without a display link), so a `--frames N` loop still ends;\n");
    buf_bytes(out, "after 3 s without a display frame stderr gets one line, `window: no\n");
    buf_bytes(out, "frame in 3 s: the window is occluded or not shown (the display is\n");
    buf_bytes(out, "asleep); ...`. A frame time measured then is the timer's 100 ms, not\n");
    buf_bytes(out, "the program's. A program started from a background shell is not made\n");
    buf_bytes(out, "active: its window is ordered front regardless.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "So a check that times GPU work does it headless, without the window:\n");
    buf_bytes(out, "submit the work of N frames with no wait between them, `wait_idle`\n");
    buf_bytes(out, "once, and divide by N. That is throughput, the frames a second the GPU\n");
    buf_bytes(out, "sustains with submissions overlapping, not latency, how long one frame\n");
    buf_bytes(out, "takes from its submit to its end (one submit, then a wait:\n");
    buf_bytes(out, "`gpu#timing-gpu-work`). Warm up first, and say which one a report\n");
    buf_bytes(out, "gives.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::BufferUsage;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "embed wgsl STEP {\n");
    buf_bytes(out, "    @group(0) @binding(0) var<storage, read_write> xs: array<u32>;\n");
    buf_bytes(out, "    @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n");
    buf_bytes(out, "        xs[id.x] = xs[id.x] * 3u + 1u;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// A frame's GPU work: what the windowed program submits each frame.\n");
    buf_bytes(out, "fn frame(dev: gpu::Device, queue: inout gpu::Queue, pipe: gpu::ComputePipeline, group: gpu::BindGroup) {\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.compute_pass(|pass| {\n");
    buf_bytes(out, "        pass.set_pipeline(pipe);\n");
    buf_bytes(out, "        pass.set_bind_group(0, group);\n");
    buf_bytes(out, "        pass.dispatch(1024);\n");
    buf_bytes(out, "    });\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    let pipe = dev.compute_pipeline(dev.shader_wgsl(STEP.src)?, STEP.main)?;\n");
    buf_bytes(out, "    let xs = dev.buffer(1024 * 64 * 4, BufferUsage::STORAGE);\n");
    buf_bytes(out, "    let group = dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, xs)][..]);\n");
    buf_bytes(out, "    frame(dev, &queue, pipe, group); // a warm-up: the first submit sets things up\n");
    buf_bytes(out, "    queue.wait_idle()?;\n");
    buf_bytes(out, "    let n = 200;\n");
    buf_bytes(out, "    let t0 = std::time::monotonic_now();\n");
    buf_bytes(out, "    for _ in 0..n {\n");
    buf_bytes(out, "        frame(dev, &queue, pipe, group); // no wait between them\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    queue.wait_idle()?; // all n done\n");
    buf_bytes(out, "    let ms = std::time::monotonic_now().saturating_sub(t0).as_millis_f64() / n as f64;\n");
    buf_bytes(out, "    println(\"{n} frames timed: {}\", ms > 0.0); // a report prints format_args(\"{ms:.3} ms a frame\")\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "200 frames timed: true\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Checking the pixels headless\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A windowed program's pixels can be checked without a window: give it a\n");
    buf_bytes(out, "`--headless` mode that draws its final frame with the same code into a\n");
    buf_bytes(out, "`RawSurface::Headless` surface (frames, no window), copies the frame's\n");
    buf_bytes(out, "texture into a `MAP_READ | COPY_DST` buffer (rows 256-byte aligned),\n");
    buf_bytes(out, "optionally draws the overlay first (`gpu-render#drawing-over-the-image-you-just-made`),\n");
    buf_bytes(out, "and then compares pixels or writes a PPM to look at (`sips -s format png\n");
    buf_bytes(out, "shot.ppm --out shot.png` on macOS makes an image a viewer opens). The\n");
    buf_bytes(out, "worked example is examples/gpu/pathtrace: `--headless --ui --size\n");
    buf_bytes(out, "1280x720 --out panel.ppm` draws the panel over the final frame through\n");
    buf_bytes(out, "the window's own UI pipeline (`--ui-scale 2` for a Retina layout), and\n");
    buf_bytes(out, "its case in tests/examples checks it.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::{fs, gpu};\n");
    buf_bytes(out, "use std::gpu::{BufferUsage, Color, Format, PassDesc, RawSurface, TextureView};\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// The frame's drawing, shared with the window's Event::Frame: here a\n");
    buf_bytes(out, "// clear; in a program its scene passes, then the overlay.\n");
    buf_bytes(out, "fn draw(dev: gpu::Device, queue: inout gpu::Queue, view: TextureView) {\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.render_pass(PassDesc::color(view, clear: Color::rgba(1.0, 0.5, 0.0, 1.0)), |_| {});\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    let (w, h) = (64, 32);\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    var surf = inst.surface(dev, RawSurface::Headless)?; // frames, no window\n");
    buf_bytes(out, "    surf.configure(dev, w, h, format: Format::Bgra8Unorm, vsync: false);\n");
    buf_bytes(out, "    let frame = surf.frame()?;\n");
    buf_bytes(out, "    draw(dev, &queue, frame.texture.view());\n");
    buf_bytes(out, "    let stride = (w * 4 + 255) / 256 * 256; // rows 256-byte aligned\n");
    buf_bytes(out, "    var readback = dev.buffer(stride * h, BufferUsage::MAP_READ | BufferUsage::COPY_DST);\n");
    buf_bytes(out, "    var enc = dev.encoder();\n");
    buf_bytes(out, "    enc.copy_texture_to_buffer(frame.texture, readback, stride);\n");
    buf_bytes(out, "    queue.submit(enc.finish());\n");
    buf_bytes(out, "    frame.present(&queue);\n");
    buf_bytes(out, "    let px = readback.map_read(dev); // B, G, R, A a pixel\n");
    buf_bytes(out, "    var ppm = format_in(\"P6\\n{w} {h}\\n255\\n\", gpa);\n");
    buf_bytes(out, "    for y in 0..h {\n");
    buf_bytes(out, "        for x in 0..w {\n");
    buf_bytes(out, "            let p = y * stride + x * 4;\n");
    buf_bytes(out, "            ppm.push(px[p + 2]);\n");
    buf_bytes(out, "            ppm.push(px[p + 1]);\n");
    buf_bytes(out, "            ppm.push(px[p]);\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    let ok = fs::write(\"shot.ppm\", ppm.as_slice()).is_ok(); // open it, or compare\n");
    buf_bytes(out, "    println(\"rgb {} {} {}, wrote shot.ppm: {ok}\", px[2], px[1], px[0]);\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "rgb 255 128 0, wrote shot.ppm: true\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## Testing input without a display\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "(0.25.4) A program's own event loop runs with no display when\n");
    buf_bytes(out, "`VOLE_WINDOW_SCRIPT` is set: `App::new_in` opens no window server and\n");
    buf_bytes(out, "the events come from the script, in order. Each `Frame` comes as soon as\n");
    buf_bytes(out, "the program asks for one (`request_frame`), never from a timer, so a\n");
    buf_bytes(out, "test of keys, the mouse or a frame count takes milliseconds. The\n");
    buf_bytes(out, "window's `raw_surface()` is null, which std::gpu takes for\n");
    buf_bytes(out, "`RawSurface::Headless`: the frames are offscreen, at the script's size.\n");
    buf_bytes(out, "The program needs no code for it; `shot FILE` writes the next frame it\n");
    buf_bytes(out, "presents as a PPM to compare (`tests/ppmdiff.sh`, a case's\n");
    buf_bytes(out, "`EXPECT-PPM`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "use std::gpu;\n");
    buf_bytes(out, "use std::gpu::{Color, PassDesc, RawSurface};\n");
    buf_bytes(out, "use std::window::{App, Button, Event, MouseAction, WindowDesc};\n");
    buf_bytes(out, "use std::window::keys::Logical;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main(gpa: Gpa) -> Result<(), gpu::Error> {\n");
    buf_bytes(out, "    var app = match App::new_in(gpa) {\n");
    buf_bytes(out, "        Ok(a) => a,\n");
    buf_bytes(out, "        Err(_) => return Ok(()), // no display, no script\n");
    buf_bytes(out, "    };\n");
    buf_bytes(out, "    var win = match app.window(WindowDesc::new(\"paint\", 400, 300)) {\n");
    buf_bytes(out, "        Ok(w) => w,\n");
    buf_bytes(out, "        Err(_) => return Ok(()),\n");
    buf_bytes(out, "    };\n");
    buf_bytes(out, "    let inst = gpu::Instance::new_in(gpa);\n");
    buf_bytes(out, "    let (dev, var queue) = inst.adapter()?.device()?;\n");
    buf_bytes(out, "    var surf = inst.surface(dev, RawSurface::MetalLayer(win.raw_surface()))?;\n");
    buf_bytes(out, "    var red = false;\n");
    buf_bytes(out, "    win.request_frame();\n");
    buf_bytes(out, "    loop {\n");
    buf_bytes(out, "        match app.wait() {\n");
    buf_bytes(out, "            Ok(Event::Resize(_, s)) => surf.configure(dev, s.w, s.h),\n");
    buf_bytes(out, "            Ok(Event::Frame(_)) => {\n");
    buf_bytes(out, "                let frame = surf.frame()?;\n");
    buf_bytes(out, "                let c = if red { Color::rgba(1.0, 0.0, 0.0, 1.0) } else { Color::black() };\n");
    buf_bytes(out, "                var enc = dev.encoder();\n");
    buf_bytes(out, "                enc.render_pass(PassDesc::color(frame.texture.view(), clear: c), |_| {});\n");
    buf_bytes(out, "                queue.submit(enc.finish());\n");
    buf_bytes(out, "                frame.present(&queue);\n");
    buf_bytes(out, "                win.request_frame();\n");
    buf_bytes(out, "            }\n");
    buf_bytes(out, "            Ok(Event::Mouse(m)) => {\n");
    buf_bytes(out, "                if m.button == Button::Left && m.action == MouseAction::Press {\n");
    buf_bytes(out, "                    red = !red;\n");
    buf_bytes(out, "                }\n");
    buf_bytes(out, "            }\n");
    buf_bytes(out, "            Ok(Event::Key(k)) => {\n");
    buf_bytes(out, "                if k.pressed && k.key == Logical::Char('q' as u32) {\n");
    buf_bytes(out, "                    break;\n");
    buf_bytes(out, "                }\n");
    buf_bytes(out, "            }\n");
    buf_bytes(out, "            Ok(Event::Close(_)) | Ok(Event::Quit) => break,\n");
    buf_bytes(out, "            _ => {}\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```sh\n");
    buf_bytes(out, "VOLE_WINDOW_SCRIPT='size 64x32; frames 2; click left 10 10; shot red.ppm; frames 1; key q' ./paint\n");
    buf_bytes(out, "VOLE_WINDOW_SCRIPT=@input.script ./paint      # the script in a file\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The commands, separated by `;` or newlines (`#` a comment); coordinates\n");
    buf_bytes(out, "are physical pixels from the content's top-left:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "| command | events |\n");
    buf_bytes(out, "|---|---|\n");
    buf_bytes(out, "| `size 640x480 [S]` | first: the window's size and scale (default: the WindowDesc's, scale 1) |\n");
    buf_bytes(out, "| `frames N` | up to N `Frame`s, one for each `request_frame` (none asked for: none sent, the program is idle) |\n");
    buf_bytes(out, "| `key K`, `keydown K`, `keyup K` | a press and a release, or one; K is a character (`a`, `+`, `A` is shift+a) or a name (`space enter tab backspace escape delete insert home end pageup pagedown left right up down f1`..`f20`), after `shift+ ctrl+ alt+ cmd+`; a printable press is followed by its `Text` |\n");
    buf_bytes(out, "| `move X Y` | the pointer moves |\n");
    buf_bytes(out, "| `press [B] X Y`, `release [B] X Y`, `click [B] X Y` | B: `left` (default), `right`, `middle`; then `shift`, `ctrl`, `alt` or `cmd` held |\n");
    buf_bytes(out, "| `scroll DY [DX]` | a wheel, in lines (positive: up) |\n");
    buf_bytes(out, "| `resize WxH`, `focus on`/`off` | `Resize`, `Focus` |\n");
    buf_bytes(out, "| `shot FILE.ppm` | the next frame presented (`frame.present`) is also written to FILE (`gpu::capture_next_frame`) |\n");
    buf_bytes(out, "| `close`, `quit` | `Close`, `Quit` |\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- When the script ends, each open window gets `Close`, then `Quit`; a\n");
    buf_bytes(out, "  program still waiting after that stops (exit 1) with a line saying so.\n");
    buf_bytes(out, "  A command that does not parse stops it (exit 2) with its line:\n");
    buf_bytes(out, "  `window.script: VOLE_WINDOW_SCRIPT line 1: unknown command ...`.\n");
    buf_bytes(out, "- A UI that reads the mouse in its frame (immediate mode) needs a frame\n");
    buf_bytes(out, "  between a press and its release: `press 470 345; frames 1; release 470\n");
    buf_bytes(out, "  345`. `click` sends both before the next frame.\n");
    buf_bytes(out, "- Time does not pass: a program that moves things by the clock between\n");
    buf_bytes(out, "  frames moves them by the few microseconds a frame takes. Pause it\n");
    buf_bytes(out, "  (life's space) or step it (life's `n`) from the script.\n");
    buf_bytes(out, "- In a test case: `// ENV: VOLE_WINDOW_SCRIPT=...` and `// EXPECT-PPM:\n");
    buf_bytes(out, "  shot.ppm tests/golden/NAME.ppm region X,Y,W,H` (`tests/examples/\n");
    buf_bytes(out, "  gpu-life-script.test` paints and steps examples/gpu/life;\n");
    buf_bytes(out, "  `pathtrace-script.test` clicks a button of pathtrace's panel).\n");
}
