    buf_bytes(out, b"# The style: volec fmt (0.25.1)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"One layout, no options: `volec fmt FILE|MODULE` writes it, `--check`\n");
    buf_bytes(out, b"lists the files not in it (exit 1), `--dry-run` shows the diff, `--all`\n");
    buf_bytes(out, b"the tree, `--changed` (0.25.2) the `.vl` files changed since git's HEAD\n");
    buf_bytes(out, b"(`--since REV`: since REV), not the untidy files of others. The edits of `edit`, `fix` and `refactor` land formatted. In\n");
    buf_bytes(out, b"full: docs/style.md.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"use std::{fs, io};                // groups: std, crate, the rest; sorted, merged\n");
    buf_bytes(out, b"use std::collections::HashMap;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"use crate::shapes::Point;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"use super::helper;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) {\n");
    buf_bytes(out, b"    let p = Point {\n");
    buf_bytes(out, b"        x: 1,\n");
    buf_bytes(out, b"        y: 2,                     // a closing bracket on its own line: a trailing comma\n");
    buf_bytes(out, b"    };\n");
    buf_bytes(out, b"    let t = pair(p.x, p.y);       // on one line: none (`(x,)` keeps its own)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- four spaces a level; 100 columns, a longer line broken at its loosest\n");
    buf_bytes(out, b"  point (after `,`, before `else`, `||`, `&&`, a comparison, a chain's `.`);\n");
    buf_bytes(out, b"- spaces around binary operators and after `,` `:`; `Vec<i64, Gpa>` tight;\n");
    buf_bytes(out, b"- at most one blank line; one around items of several lines; none\n");
    buf_bytes(out, b"  after `{` or before `}`;\n");
    buf_bytes(out, b"- comments kept as written; lines are never joined, only broken;\n");
    buf_bytes(out, b"- fmt changes no token but trailing commas, and is idempotent.\n");
