// Generated by compiler/guide/embed.sh from compiler/guide/testing.md (do
// not edit): the guide's topic 'testing'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Tests, properties and fuzzing\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Tests are written in the language and run by `volec test`,\n");
    buf_bytes(out, b"which builds them at -O0 and at -O2 and compares the two. Other builds\n");
    buf_bytes(out, b"leave test items out; `check` and the queries see them.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A test that allocates takes the allocator as its parameter, as `main`\n");
    buf_bytes(out, b"does: `#[test] fn t(gpa: Gpa) { let mut v = Vec::new_in(gpa); .. }` (the\n");
    buf_bytes(out, b"test runner gives the gpa, and checks that the test frees what it\n");
    buf_bytes(out, b"allocates).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## #[test]\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::num::ParseIntError;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn gap(v: &[i64]) -> i64 {\n");
    buf_bytes(out, b"    let mut best = 0;\n");
    buf_bytes(out, b"    for i in 1..v.len() {\n");
    buf_bytes(out, b"        if v[i] - v[i - 1] > best {\n");
    buf_bytes(out, b"            best = v[i] - v[i - 1];\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    best\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[test]\n");
    buf_bytes(out, b"fn gap_of_three() {\n");
    buf_bytes(out, b"    assert_eq(gap(&[1, 5, 6]), 4);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[test]\n");
    buf_bytes(out, b"fn parses() -> Result<(), ParseIntError> {\n");
    buf_bytes(out, b"    let n: i64 = \"12\".parse()?;\n");
    buf_bytes(out, b"    assert(n == 12);\n");
    buf_bytes(out, b"    Ok(())\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[test]\n");
    buf_bytes(out, b"fn keeps_nothing(gpa: Gpa) {\n");
    buf_bytes(out, b"    let mut b = String::new_in(gpa);\n");
    buf_bytes(out, b"    b.push_str(\"dropped at the end\");\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    println(\"{}\", gap(&[2, 9]));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"7\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- A `#[test]` takes nothing or `gpa: Gpa`, and returns `()` or a\n");
    buf_bytes(out, b"  Result (an `Err` fails). Anything else is `test.signature`.\n");
    buf_bytes(out, b"- Test builds use `--check-alloc`: a block left allocated fails the test\n");
    buf_bytes(out, b"  (`check-alloc: 1 block of Gpa not freed ... allocated at FILE:L:C`).\n");
    buf_bytes(out, b"- `#[cfg(test)] mod tests;` (a file, or `mod tests { .. }`) is a module\n");
    buf_bytes(out, b"  only test builds have. It sees its parent's items without an import:\n");
    buf_bytes(out, b"  `use super::*;` is refused (`import.wildcard`; no wildcard imports).\n");
    buf_bytes(out, b"- `std::test::assert_snapshot(&x)` compares `{x:?}` with\n");
    buf_bytes(out, b"  `tests/snapshots/MODULE__TEST__N.snap` (`TEST__N.snap` in the root\n");
    buf_bytes(out, b"  module); the first run writes it, a\n");
    buf_bytes(out, b"  change fails with the first differing line, `--accept` rewrites it.\n");
    buf_bytes(out, b"- A `#[test]` sees what its module sees: written in the\n");
    buf_bytes(out, b"  module it tests, it calls that module's private functions and\n");
    buf_bytes(out, b"  methods, and reads its private fields (`guide modules#visibility`),\n");
    buf_bytes(out, b"  so a test of a widget's state needs no `pub` and no accessor. From\n");
    buf_bytes(out, b"  another module they are errors (`item.private`: `'clamp01' is\n");
    buf_bytes(out, b"  private`; `field.private`: `field 'active' of 'Slider' is private to\n");
    buf_bytes(out, b"  module 'widget'`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole widget.vl\n");
    buf_bytes(out, b"// A slider: `drag` and `clamp01` are private to this module.\n");
    buf_bytes(out, b"pub struct Slider { active: bool, value: f64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"pub fn slider_new() -> Slider {\n");
    buf_bytes(out, b"    Slider { active: false, value: 0.0 }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Slider {\n");
    buf_bytes(out, b"    pub fn press(&mut self, x: f64) {\n");
    buf_bytes(out, b"        self.active = true;\n");
    buf_bytes(out, b"        self.drag(x);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    pub fn value(&self) -> f64 { self.value }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    fn drag(&mut self, x: f64) {\n");
    buf_bytes(out, b"        if self.active {\n");
    buf_bytes(out, b"            self.value = clamp01(x);\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn clamp01(x: f64) -> f64 {\n");
    buf_bytes(out, b"    if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[test]\n");
    buf_bytes(out, b"fn a_press_starts_a_drag() {\n");
    buf_bytes(out, b"    let mut s = slider_new();\n");
    buf_bytes(out, b"    s.press(0.25);\n");
    buf_bytes(out, b"    assert(s.active); // the state behind the widget\n");
    buf_bytes(out, b"    s.drag(2.0); // a private method\n");
    buf_bytes(out, b"    assert(s.value == clamp01(2.0)); // a private function\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```vole main.vl\n");
    buf_bytes(out, b"mod widget;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"use widget::slider_new;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let mut s = slider_new();\n");
    buf_bytes(out, b"    s.press(0.5);\n");
    buf_bytes(out, b"    println(\"{}\", s.value());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"0.5\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## A check must be able to fail\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A test, a `--check` mode, a verdict a demo prints: each is worth what it\n");
    buf_bytes(out, b"can catch. One that passes whatever the code does proves nothing, and\n");
    buf_bytes(out, b"reporting it as verified misleads. Before trusting a check:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- **Break the code on purpose once and see the check fail.** Flip a\n");
    buf_bytes(out, b"  sign, drop a term, skip the kernel's write, start a loop one step late;\n");
    buf_bytes(out, b"  run the check; it must fail. Then undo the break. A check that still\n");
    buf_bytes(out, b"  passes tests nothing.\n");
    buf_bytes(out, b"- **Compare with an independent reference**: a CPU version written\n");
    buf_bytes(out, b"  apart from the code under test, a closed form, a published value;\n");
    buf_bytes(out, b"  exactly where the arithmetic is exact (integers, a sort, a scan), and\n");
    buf_bytes(out, b"  within a stated tolerance where it is not. \"Not black\", \"no NaN\" and\n");
    buf_bytes(out, b"  \"in range\" are smoke tests, not checks of the result.\n");
    buf_bytes(out, b"- **Check what the clamp or the construction does not already\n");
    buf_bytes(out, b"  guarantee.** Positions clamped into a box are always inside it, so \"no\n");
    buf_bytes(out, b"  particle escapes\" holds by construction: check what the walls must do\n");
    buf_bytes(out, b"  instead (the velocity reflected, mass conserved). A total the update\n");
    buf_bytes(out, b"  renormalizes is conserved whatever the physics; a quantity that\n");
    buf_bytes(out, b"  settles in a few steps \"grows\" for any run. Ask: what wrong program\n");
    buf_bytes(out, b"  passes this?\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"// The update clamps x into 0..1.\n");
    buf_bytes(out, b"fn step(x: f64, v: f64, dt: f64) -> f64 {\n");
    buf_bytes(out, b"    let y = x + v * dt;\n");
    buf_bytes(out, b"    if y < 0.0 { 0.0 } else if y > 1.0 { 1.0 } else { y }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// Weak: true for any step that clamps, right or wrong inside.\n");
    buf_bytes(out, b"#[test]\n");
    buf_bytes(out, b"fn stays_inside() {\n");
    buf_bytes(out, b"    assert(step(0.5, 100.0, 1.0) <= 1.0);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// Able to fail: the exact motion where the clamp does not act (break\n");
    buf_bytes(out, b"// step's `v * dt` into `v` and this fails; stays_inside still passes).\n");
    buf_bytes(out, b"#[test]\n");
    buf_bytes(out, b"fn moves_by_v_dt() {\n");
    buf_bytes(out, b"    assert_eq(step(0.25, 0.5, 0.5), 0.5);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## #[property]\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A property's parameters are generated: 100 cases (`--cases N`), sizes\n");
    buf_bytes(out, b"growing, a failure shrunk to a small input and printed with its seed.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::test::{Arbitrary, Gen};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn clamp(x: i64, lo: i64, hi: i64) -> i64 {\n");
    buf_bytes(out, b"    if x < lo { lo } else if x > hi { hi } else { x }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[property]\n");
    buf_bytes(out, b"fn clamp_stays_in(x: i64, lo: i64, hi: i64) {\n");
    buf_bytes(out, b"    if lo <= hi {\n");
    buf_bytes(out, b"        let c = clamp(x, lo, hi);\n");
    buf_bytes(out, b"        assert(lo <= c && c <= hi);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Small { n: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Arbitrary for Small {\n");
    buf_bytes(out, b"    fn arbitrary(g: &mut Gen<Gpa>) -> Small {\n");
    buf_bytes(out, b"        Small { n: g.int_in(0, 9) }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[property]\n");
    buf_bytes(out, b"fn small_is_small(s: Small) {\n");
    buf_bytes(out, b"    assert(s.n >= 0 && s.n <= 9);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    println(\"{}\", clamp(12, 0, 9));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"9\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Numbers, bool, char, `Vec<T, Gpa>`, `&[T]`, `String<Gpa>`, `&str`,\n");
    buf_bytes(out, b"  `Option`, `Result` and tuples are generated from their types; a\n");
    buf_bytes(out, b"  struct or an enum of the program needs its `impl Arbitrary`\n");
    buf_bytes(out, b"  (`std::test::{Arbitrary, Gen}`: `g.int_in(lo, hi)`, `g.choose(n)`,\n");
    buf_bytes(out, b"  `g.bool()`, `g.size()`).\n");
    buf_bytes(out, b"- Each case runs in a child process; its values are dropped after it,\n");
    buf_bytes(out, b"  and a block it leaves allocated fails the case (a leak).\n");
    buf_bytes(out, b"- A function with an `ensures` is tested as a property too, its\n");
    buf_bytes(out, b"  requires filtering the inputs (`--no-contracts`: not).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## volec test\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"$ volec test\n");
    buf_bytes(out, b"test main.vl: 4 passed, 2 failed (1 case, 3 #[test], 1 #[property], 1 contract; -O0 and -O2 agree)\n");
    buf_bytes(out, b"FAIL gap_needs_two: checks.vl:24:12: index out of bounds: index 1, length 1\n");
    buf_bytes(out, b"  trace: checks.vl:24 checks::gap_needs_two\n");
    buf_bytes(out, b"FAIL bubble_sorts (property, case 11 of 100, shrunk in 496 steps): not sorted\n");
    buf_bytes(out, b"  input: v = [0, 0, -2]\n");
    buf_bytes(out, b"  try: volec test bubble_sorts --seed 0xf788dd27897d1fed main.vl\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- The summary first, then one line per failure, its trace, its input\n");
    buf_bytes(out, b"  and the command that replays it. `FILTER` runs the tests whose name\n");
    buf_bytes(out, b"  holds it; `tests/NAME.in` with `NAME.out` are cases of the program.\n");
    buf_bytes(out, b"- A test whose -O0 and -O2 runs differ is a `DIFF` line: the compiler's\n");
    buf_bytes(out, b"  bug, not yours (`volec reduce --differs` shrinks it).\n");
    buf_bytes(out, b"- `--seed H` replays a property's failure, `--accept` takes snapshots,\n");
    buf_bytes(out, b"  case outputs and saved fuzz inputs, `-O N` runs one level.\n");
    buf_bytes(out, b"- What a failing test printed is under its failure (`  stdout: x = 3`,\n");
    buf_bytes(out, b"  `  stderr: ...`); `--show-output` (Rust's `--nocapture` too) prints\n");
    buf_bytes(out, b"  every test's under its name (`OUTPUT NAME`), so a value is seen with\n");
    buf_bytes(out, b"  `println`, not by failing an assert on purpose.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## #[fuzz] and volec fuzz\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn parse(data: &[u8]) -> i64 {\n");
    buf_bytes(out, b"    if data.len() >= 2 && data[0] == b'O' && data[1] == b'K' {\n");
    buf_bytes(out, b"        return 1;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[fuzz]\n");
    buf_bytes(out, b"fn parse_never_crashes(data: &[u8]) {\n");
    buf_bytes(out, b"    let _ = parse(data);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    println(\"{}\", parse(b\"OK\"));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"1\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec fuzz NAME [--time S]` builds the test binary with `--coverage`\n");
    buf_bytes(out, b"(every block counts in std's map) and mutates inputs, keeping those that\n");
    buf_bytes(out, b"reach new code. A crash is shrunk, saved under `.volec/fuzz/NAME/`\n");
    buf_bytes(out, b"and replayed by every `volec test` after (`--accept` keeps it in\n");
    buf_bytes(out, b"`tests/fuzz/NAME/`). A `#[fuzz]` takes one `&[u8]` (or any generated\n");
    buf_bytes(out, b"types, like a property).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## volec reduce over programs\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `volec reduce PROG.vl --differs [--input F]`: the program cut\n");
    buf_bytes(out, b"  while its -O0 and -O2 runs disagree (a miscompile, to report).\n");
    buf_bytes(out, b"- `--fails 'TEXT'`: while the build or the run prints TEXT.\n");
    buf_bytes(out, b"- `--test NAME`: while test NAME fails as it does now.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Items, then statements, are cut by halves, then one by one; the result\n");
    buf_bytes(out, b"is `PROG.min.vl`. For an input instead: `volec reduce FILE --until\n");
    buf_bytes(out, b"'CMD'` (guide debug).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## tests/run.sh cases\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The compiler's own suite (`tests/run.sh`) checks programs by `//`\n");
    buf_bytes(out, b"directives; its header lists them all. Two help with programs whose\n");
    buf_bytes(out, b"output varies:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"// EXPECT: 320 x 180 cells: {num} ms a step, {int} x {int} picture\n");
    buf_bytes(out, b"// EXPECT-PPM: out.ppm tests/golden/NAME.ppm region 16,8,32,32 tolerance 8 allow 1%\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `EXPECT` holes: `{num}` a number, `{int}` an integer, `{..}` any\n");
    buf_bytes(out, b"  text within the line; each line still matches one line.\n");
    buf_bytes(out, b"- `EXPECT-PPM OUT REF`: the PPM the program wrote (OUT, in its run\n");
    buf_bytes(out, b"  directory) against REF (the region's size), a channel off by at most\n");
    buf_bytes(out, b"  the tolerance, up to `allow` of the pixels off. A failure gives the\n");
    buf_bytes(out, b"  count, the worst pixel and `try: cp target/test-shots/CASE.ppm REF`.\n");
    buf_bytes(out, b"- A check that cannot run here (window tests with no display frames:\n");
    buf_bytes(out, b"  the screen locked) is `SKIP NAME: why`, counted apart, never a pass.\n");
}
