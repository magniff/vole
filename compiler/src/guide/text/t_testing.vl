// Generated by compiler/guide/embed.sh from compiler/guide/testing.md (do
// not edit): the guide's topic 'testing'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, "# Tests, properties and fuzzing\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Tests are written in the language (0.18) and run by `volec test`,\n");
    buf_bytes(out, "which builds them at -O0 and at -O2 and compares the two. Other builds\n");
    buf_bytes(out, "leave test items out; `check` and the queries see them.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A test that allocates takes the allocator as its parameter, as `main`\n");
    buf_bytes(out, "does: `#[test] fn t(gpa: Gpa) { var v = Vec::new_in(gpa); .. }` (there\n");
    buf_bytes(out, "is no `Gpa::default()` or `Gpa::new()`; the test runner gives the gpa,\n");
    buf_bytes(out, "and checks that the test frees what it allocates).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## #[test]\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "fn gap(v: [i64]) -> i64 {\n");
    buf_bytes(out, "    var best = 0;\n");
    buf_bytes(out, "    for i in 1..v.len() {\n");
    buf_bytes(out, "        if v[i] - v[i - 1] > best {\n");
    buf_bytes(out, "            best = v[i] - v[i - 1];\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    best\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[test]\n");
    buf_bytes(out, "fn gap_of_three() {\n");
    buf_bytes(out, "    assert_eq(gap([1, 5, 6][..]), 4);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[test]\n");
    buf_bytes(out, "fn parses() -> Result<(), std::ParseIntError> {\n");
    buf_bytes(out, "    let n = std::parse_int(\"12\")?;\n");
    buf_bytes(out, "    assert(n == 12);\n");
    buf_bytes(out, "    Ok(())\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[test]\n");
    buf_bytes(out, "fn keeps_nothing(gpa: Gpa) {\n");
    buf_bytes(out, "    var b = Buf::new_in(gpa);\n");
    buf_bytes(out, "    b.push_str(\"dropped at the end\");\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    std::print_int(gap([2, 9][..]));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "7\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- A `#[test]` takes nothing or `gpa: Gpa`, and returns `()` or a\n");
    buf_bytes(out, "  Result (an `Err` fails). Anything else is `test.signature`.\n");
    buf_bytes(out, "- Test builds use `--check-alloc`: a block left allocated fails the test\n");
    buf_bytes(out, "  (`check-alloc: 1 block of Gpa not freed ... allocated at FILE:L:C`).\n");
    buf_bytes(out, "- `#[cfg(test)] mod tests;` (a file, or `mod tests { .. }`) is a module\n");
    buf_bytes(out, "  only test builds have. It sees its parent's items without an import:\n");
    buf_bytes(out, "  `use super::*;` is refused (`import.wildcard`; no wildcard imports).\n");
    buf_bytes(out, "- `assert_snapshot(x)` compares `{x:?}` with\n");
    buf_bytes(out, "  `tests/snapshots/MODULE__TEST__N.snap`; the first run writes it, a\n");
    buf_bytes(out, "  change fails with the first differing line, `--accept` rewrites it.\n");
    buf_bytes(out, "- A `#[test]` sees what its module sees: written in the\n");
    buf_bytes(out, "  module it tests, it calls that module's private functions and\n");
    buf_bytes(out, "  methods, and reads any field (a field is as visible as its struct:\n");
    buf_bytes(out, "  `guide modules#visibility`), so a test of a widget's state needs no\n");
    buf_bytes(out, "  `pub` and no accessor. From another module a private function is an\n");
    buf_bytes(out, "  error (`'clamp01' is private`).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole widget.vl\n");
    buf_bytes(out, "// A slider: `drag` and `clamp01` are private to this module.\n");
    buf_bytes(out, "pub struct Slider { active: bool, value: f64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "pub fn slider_new() -> Slider {\n");
    buf_bytes(out, "    Slider { active: false, value: 0.0 }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl Slider {\n");
    buf_bytes(out, "    pub fn press(inout self, x: f64) {\n");
    buf_bytes(out, "        self.active = true;\n");
    buf_bytes(out, "        self.drag(x);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    pub fn value(self) -> f64 { self.value }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "    fn drag(inout self, x: f64) {\n");
    buf_bytes(out, "        if self.active {\n");
    buf_bytes(out, "            self.value = clamp01(x);\n");
    buf_bytes(out, "        }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn clamp01(x: f64) -> f64 {\n");
    buf_bytes(out, "    if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[test]\n");
    buf_bytes(out, "fn a_press_starts_a_drag() {\n");
    buf_bytes(out, "    var s = slider_new();\n");
    buf_bytes(out, "    s.press(0.25);\n");
    buf_bytes(out, "    assert(s.active); // the state behind the widget\n");
    buf_bytes(out, "    s.drag(2.0); // a private method\n");
    buf_bytes(out, "    assert(s.value == clamp01(2.0)); // a private function\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```vole main.vl\n");
    buf_bytes(out, "mod widget;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "use widget::slider_new;\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() {\n");
    buf_bytes(out, "    var s = slider_new();\n");
    buf_bytes(out, "    s.press(0.5);\n");
    buf_bytes(out, "    println(s.value());\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "0.5\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## A check must be able to fail\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A test, a `--check` mode, a verdict a demo prints: each is worth what it\n");
    buf_bytes(out, "can catch. One that passes whatever the code does proves nothing, and\n");
    buf_bytes(out, "reporting it as verified misleads. Before trusting a check:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- **Break the code on purpose once and see the check fail.** Flip a\n");
    buf_bytes(out, "  sign, drop a term, skip the kernel's write, start a loop one step late;\n");
    buf_bytes(out, "  run the check; it must fail. Then undo the break. A check that still\n");
    buf_bytes(out, "  passes tests nothing.\n");
    buf_bytes(out, "- **Compare with an independent reference**: a CPU version written\n");
    buf_bytes(out, "  apart from the code under test, a closed form, a published value;\n");
    buf_bytes(out, "  exactly where the arithmetic is exact (integers, a sort, a scan), and\n");
    buf_bytes(out, "  within a stated tolerance where it is not. \"Not black\", \"no NaN\" and\n");
    buf_bytes(out, "  \"in range\" are smoke tests, not checks of the result.\n");
    buf_bytes(out, "- **Check what the clamp or the construction does not already\n");
    buf_bytes(out, "  guarantee.** Positions clamped into a box are always inside it, so \"no\n");
    buf_bytes(out, "  particle escapes\" holds by construction: check what the walls must do\n");
    buf_bytes(out, "  instead (the velocity reflected, mass conserved). A total the update\n");
    buf_bytes(out, "  renormalizes is conserved whatever the physics; a quantity that\n");
    buf_bytes(out, "  settles in a few steps \"grows\" for any run. Ask: what wrong program\n");
    buf_bytes(out, "  passes this?\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "// The update clamps x into 0..1.\n");
    buf_bytes(out, "fn step(x: f64, v: f64, dt: f64) -> f64 {\n");
    buf_bytes(out, "    let y = x + v * dt;\n");
    buf_bytes(out, "    if y < 0.0 { 0.0 } else if y > 1.0 { 1.0 } else { y }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// Weak: true for any step that clamps, right or wrong inside.\n");
    buf_bytes(out, "#[test]\n");
    buf_bytes(out, "fn stays_inside() {\n");
    buf_bytes(out, "    assert(step(0.5, 100.0, 1.0) <= 1.0);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "// Able to fail: the exact motion where the clamp does not act (break\n");
    buf_bytes(out, "// step's `v * dt` into `v` and this fails; stays_inside still passes).\n");
    buf_bytes(out, "#[test]\n");
    buf_bytes(out, "fn moves_by_v_dt() {\n");
    buf_bytes(out, "    assert_eq(step(0.25, 0.5, 0.5), 0.5);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## #[property]\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "A property's parameters are generated: 100 cases (`--cases N`), sizes\n");
    buf_bytes(out, "growing, a failure shrunk to a small input and printed with its seed.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "fn clamp(x: i64, lo: i64, hi: i64) -> i64 {\n");
    buf_bytes(out, "    if x < lo { lo } else if x > hi { hi } else { x }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[property]\n");
    buf_bytes(out, "fn clamp_stays_in(x: i64, lo: i64, hi: i64) {\n");
    buf_bytes(out, "    if lo <= hi {\n");
    buf_bytes(out, "        let c = clamp(x, lo, hi);\n");
    buf_bytes(out, "        assert(lo <= c && c <= hi);\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "struct Small { n: i64 }\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "impl std::Arbitrary for Small {\n");
    buf_bytes(out, "    fn arbitrary(g: inout std::Gen) -> Small {\n");
    buf_bytes(out, "        Small { n: g.int_in(0, 9) }\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[property]\n");
    buf_bytes(out, "fn small_is_small(s: Small) {\n");
    buf_bytes(out, "    assert(s.n >= 0 && s.n <= 9);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    std::print_int(clamp(12, 0, 9));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "9\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- Numbers, bool, `Vec<T>`, `[T]`, `Buf`, `Option`, `Result`, tuples\n");
    buf_bytes(out, "  and the program's structs and enums are generated from their types;\n");
    buf_bytes(out, "  `impl std::Arbitrary` gives a type its own (`g.int_in(lo, hi)`,\n");
    buf_bytes(out, "  `g.choose(n)`, `g.bool()`, `g.size()`).\n");
    buf_bytes(out, "- Each case runs in a child process; its values are dropped after it,\n");
    buf_bytes(out, "  and a block it leaves allocated fails the case (a leak).\n");
    buf_bytes(out, "- A function with an `ensures` is tested as a property too, its\n");
    buf_bytes(out, "  requires filtering the inputs (`--no-contracts`: not).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## volec test\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "$ volec test\n");
    buf_bytes(out, "test main.vl: 6 passed, 2 failed (1 case, 5 #[test], 2 #[property], 1 contract; -O0 and -O2 agree)\n");
    buf_bytes(out, "FAIL gap_needs_two: checks.vl:14:8: index out of bounds: index 1, length 1\n");
    buf_bytes(out, "  trace: checks.vl:14 checks::gap_needs_two\n");
    buf_bytes(out, "FAIL bubble_sorts (property, case 11 of 100, shrunk in 8 steps): not sorted\n");
    buf_bytes(out, "  input: v = [1, 0]\n");
    buf_bytes(out, "  try: volec test bubble_sorts --seed 0xf788dd27897d1fed main.vl\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- The summary first, then one line per failure, its trace, its input\n");
    buf_bytes(out, "  and the command that replays it. `FILTER` runs the tests whose name\n");
    buf_bytes(out, "  holds it; `tests/NAME.in` with `NAME.out` are cases of the program.\n");
    buf_bytes(out, "- A test whose -O0 and -O2 runs differ is a `DIFF` line: the compiler's\n");
    buf_bytes(out, "  bug, not yours (`volec reduce --differs` shrinks it).\n");
    buf_bytes(out, "- `--seed H` replays a property's failure, `--accept` takes snapshots,\n");
    buf_bytes(out, "  case outputs and saved fuzz inputs, `-O N` runs one level.\n");
    buf_bytes(out, "- What a failing test printed is under its failure (`  stdout: x = 3`,\n");
    buf_bytes(out, "  `  stderr: ...`); `--show-output` (Rust's `--nocapture` too) prints\n");
    buf_bytes(out, "  every test's under its name (`OUTPUT NAME`), so a value is seen with\n");
    buf_bytes(out, "  `println`, not by failing an assert on purpose.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## #[fuzz] and volec fuzz\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```vole\n");
    buf_bytes(out, "fn parse(data: [u8]) -> i64 {\n");
    buf_bytes(out, "    if data.len() >= 2 && data[0] == 'O' && data[1] == 'K' {\n");
    buf_bytes(out, "        return 1;\n");
    buf_bytes(out, "    }\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "#[fuzz]\n");
    buf_bytes(out, "fn parse_never_crashes(data: [u8]) {\n");
    buf_bytes(out, "    let _ = parse(data);\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "fn main() -> i32 {\n");
    buf_bytes(out, "    std::print_int(parse(\"OK\"));\n");
    buf_bytes(out, "    0\n");
    buf_bytes(out, "}\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "```out\n");
    buf_bytes(out, "1\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "`volec fuzz NAME [--time S]` builds the test binary with `--coverage`\n");
    buf_bytes(out, "(every block counts in std's map) and mutates inputs, keeping those that\n");
    buf_bytes(out, "reach new code. A crash is shrunk, saved under `.volec/fuzz/NAME/`\n");
    buf_bytes(out, "and replayed by every `volec test` after (`--accept` keeps it in\n");
    buf_bytes(out, "`tests/fuzz/NAME/`). A `#[fuzz]` takes one `[u8]` (or any generated\n");
    buf_bytes(out, "types, like a property).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## volec reduce over programs\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `volec reduce PROG.vl --differs [--input F]`: the program cut\n");
    buf_bytes(out, "  while its -O0 and -O2 runs disagree (a miscompile, to report).\n");
    buf_bytes(out, "- `--fails 'TEXT'`: while the build or the run prints TEXT.\n");
    buf_bytes(out, "- `--test NAME`: while test NAME fails as it does now.\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "Items, then statements, are cut by halves, then one by one; the result\n");
    buf_bytes(out, "is `PROG.min.vl`. For an input instead: `volec reduce FILE --until\n");
    buf_bytes(out, "'CMD'` (guide debug).\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "## tests/run.sh cases\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "The compiler's own suite (`tests/run.sh`) checks programs by `//`\n");
    buf_bytes(out, "directives; its header lists them all. Two help with programs whose\n");
    buf_bytes(out, "output varies:\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "```text\n");
    buf_bytes(out, "// EXPECT: 320 x 180 cells: {num} ms a step, {int} x {int} picture\n");
    buf_bytes(out, "// EXPECT-PPM: out.ppm tests/golden/NAME.ppm region 16,8,32,32 tolerance 8 allow 1%\n");
    buf_bytes(out, "```\n");
    buf_bytes(out, "\n");
    buf_bytes(out, "- `EXPECT` holes: `{num}` a number, `{int}` an integer, `{..}` any\n");
    buf_bytes(out, "  text within the line; each line still matches one line.\n");
    buf_bytes(out, "- `EXPECT-PPM OUT REF`: the PPM the program wrote (OUT, in its run\n");
    buf_bytes(out, "  directory) against REF (the region's size), a channel off by at most\n");
    buf_bytes(out, "  the tolerance, up to `allow` of the pixels off. A failure gives the\n");
    buf_bytes(out, "  count, the worst pixel and `try: cp target/test-shots/CASE.ppm REF`.\n");
    buf_bytes(out, "- A check that cannot run here (window tests with no display frames:\n");
    buf_bytes(out, "  the screen locked) is `SKIP NAME: why`, counted apart, never a pass.\n");
}
