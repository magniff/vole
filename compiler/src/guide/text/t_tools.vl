// Generated by compiler/guide/embed.sh from compiler/guide/tools.md (do
// not edit): the guide's topic 'tools'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Tools\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The compiler reads and changes programs by name: ask it instead of\n");
    buf_bytes(out, b"reading files with grep or sed, and edit through it instead of\n");
    buf_bytes(out, b"rewriting files. Names are resolved by the compiler, so a query sees\n");
    buf_bytes(out, b"uses through imports and ignores comments and strings.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"When they pay off: renames, moves, signature, field and variant\n");
    buf_bytes(out, b"changes (every use, checked, in one command), errors across files, and\n");
    buf_bytes(out, b"code too large to read. A small program (a few hundred lines) is\n");
    buf_bytes(out, b"cheaper read whole, once (`volec query show FILE.vl` up to 200\n");
    buf_bytes(out, b"lines, `query text FILE:A-B` 200 at a time), than explored with many\n");
    buf_bytes(out, b"small queries.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The loop\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"1. Write the program; `volec check` (the front end only: fast, every\n");
    buf_bytes(out, b"   error, one line each; `ok: 0 errors in main.vl` when there is none). Before writing a construct you are unsure of,\n");
    buf_bytes(out, b"   `volec guide --find WORDS` or `volec guide TOPIC#SECTION`\n");
    buf_bytes(out, b"   prints the lines on it.\n");
    buf_bytes(out, b"2. Fix each error: `volec query show FILE:LINE` prints the item at\n");
    buf_bytes(out, b"   the error's position; `volec edit patch` changes a few lines of it.\n");
    buf_bytes(out, b"3. `volec fix --suggested` when errors have `try: volec fix\n");
    buf_bytes(out, b"   --suggested main.vl` (0.18): their exact fixes, one checked edit,\n");
    buf_bytes(out, b"   then the errors left; `volec fix` for unsafe blocks. A fix that\n");
    buf_bytes(out, b"   would change what the code means (a lossy conversion, a cast of a\n");
    buf_bytes(out, b"   cast, a did-you-mean naming the function the call is in, one with\n");
    buf_bytes(out, b"   which the program has a new error) is not made: `note fix.refused`\n");
    buf_bytes(out, b"   says why, and the error is yours to fix. The check hook makes only\n");
    buf_bytes(out, b"   the mechanical ones itself (an unused import), each shown as\n");
    buf_bytes(out, b"   `changed FILE:LINE: OLD -> NEW`; the\n");
    buf_bytes(out, b"   others it shows as `suggested, not applied`: read each first.\n");
    buf_bytes(out, b"4. Build and run: `volec run` (0.25.4: `volec run DIR -- ARGS`;\n");
    buf_bytes(out, b"   DIR/main.vl, here ./main.vl, built into volec's cache when it\n");
    buf_bytes(out, b"   changed, then run; off a terminal only the program's output, its\n");
    buf_bytes(out, b"   exit status volec's). For the executable itself, `volec main.vl -o\n");
    buf_bytes(out, b"   prog` (a build that works ends with `ok: built prog`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The program\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Commands find the program's root file from `--root FILE` (or `--root\n");
    buf_bytes(out, b"DIR`: its main.vl), a last argument ending in `.vl`, `$VOLE_ROOT`, or\n");
    buf_bytes(out, b"`./main.vl`. The other files are the modules it loads. A FILE or\n");
    buf_bytes(out, b"FILE:LINE argument names its own program from anywhere (`volec query\n");
    buf_bytes(out, b"context examples/nes/check.vl:233` from the tree's root), and a NAME\n");
    buf_bytes(out, b"the program lacks gets a `try:` with the `--root` of the program\n");
    buf_bytes(out, b"under the current directory that defines it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Reading\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"For an item you have not seen, ask `volec query context NAME` first:\n");
    buf_bytes(out, b"one call gives its source, the signatures of what it calls and uses,\n");
    buf_bytes(out, b"and its callers (instead of `show`, then `def`, then `refs`):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"$ volec query context parse_item\n");
    buf_bytes(out, b"// crate::parse_item  main.vl:5-9  effects: panic diverge\n");
    buf_bytes(out, b"fn parse_item<'a>(toks: &mut SplitWhitespace<'a>) -> Option<Item<'a>> {\n");
    buf_bytes(out, b"    let name = toks.next()?;\n");
    buf_bytes(out, b"    ...\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"// calls (3)\n");
    buf_bytes(out, b"str::parse  <std>:7349:12  method  pub fn parse<F: FromStr>(&self) -> Result<F, F::Err>\n");
    buf_bytes(out, b"...\n");
    buf_bytes(out, b"// types (3)\n");
    buf_bytes(out, b"crate::Item  main.vl:3:8  struct  struct Item<'a> { name: &'a str, qty: i64 }\n");
    buf_bytes(out, b"...\n");
    buf_bytes(out, b"// callers (1)\n");
    buf_bytes(out, b"main  main.vl:15:26  while let Some(it) = parse_item(&mut toks) {\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"(The fields are separated by TABs.) It stays within about 2,000 tokens\n");
    buf_bytes(out, b"(`--budget N`); a module's name gives its items and its most used\n");
    buf_bytes(out, b"bodies.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| to | run |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| an item with what it calls, its types and callers | `volec query context NAME` (`--budget N`) |\n");
    buf_bytes(out, b"| an item's source | `volec query show NAME` (`--with-comments`) |\n");
    buf_bytes(out, b"| the item at an error | `volec query show FILE:LINE` |\n");
    buf_bytes(out, b"| where it is defined, its signature | `volec query def NAME` |\n");
    buf_bytes(out, b"| every use | `volec query refs NAME` (`--count`, `--in FILE\\|MODULE`; a local: `FN::x`) |\n");
    buf_bytes(out, b"| who calls a function; what it calls | `volec query callers NAME`; `query callees FN` (`--transitive`) |\n");
    buf_bytes(out, b"| what a function may do: allocate, io, panic... (0.16) | `volec query effects NAME\\|MODULE` (`--why io`, `--has alloc(Gpa)`) |\n");
    buf_bytes(out, b"| every unsafe site: what it does, its class, its `UNSAFE:`/`SAFETY:` comments (0.25.3) | `volec query unsafe [FILE...\\|std]` (`--unjustified`, `--summary`, `--json`) |\n");
    buf_bytes(out, b"| a module's items, with signatures | `volec query items MODULE`; every module: `query items` |\n");
    buf_bytes(out, b"| only some of them, briefly (0.25.3) | `query items std --find clamp` (a word of the name: `f64::clamp`, `i64::clamp`), `--kind fn,method`; `--names`: kinds and paths only |\n");
    buf_bytes(out, b"| a type, then its methods | `volec query show TYPE` (each method's signature; `query items TYPE`: contracts whole) |\n");
    buf_bytes(out, b"| a module's `use` lines, header comment | `volec query show MODULE::use` (`::header`) |\n");
    buf_bytes(out, b"| lines of any file | `volec query text FILE:A-B` |\n");
    buf_bytes(out, b"| a word in code, comments or strings (a shader's WGSL); in every program under a directory | `volec query grep WORD` (`--strings`, `--in FILE`); `query grep WORD --in examples/gpu` |\n");
    buf_bytes(out, b"| what nothing uses | `volec query unused` |\n");
    buf_bytes(out, b"| sizes, dependencies | `volec query stats`, `query deps MODULE` |\n");
    buf_bytes(out, b"| std's API, a std item | `volec query items std`, `query show std::io::stdin` (any program; a re-exported name too: `query show std::gpu::Color`) |\n");
    buf_bytes(out, b"| what a snippet does | `volec try 'let v = [3, 1]; v.len()'` prints `usize = 2` |\n");
    buf_bytes(out, b"| build a program and run it (0.25.4) | `volec run [DIR] [OPTIONS] [-- ARGS]` (DIR/main.vl; rebuilt only when it changed; the binary in volec's cache, never in DIR) |\n");
    buf_bytes(out, b"| the guide on some words | `volec guide --find WORDS`, `guide TOPIC#SECTION`, `explain WORDS` |\n");
    buf_bytes(out, b"| items like one, to copy for a new one; recipes for adding an X (0.17) | `volec query similar NAME`; `query examples KIND`; `volec guide how` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"NAME is `f`, `module::f`, `Type::method`, `Enum::Variant`,\n");
    buf_bytes(out, b"`Struct.field`, `<Type as Trait>::f` or `FILE:LINE`; several in one call;\n");
    buf_bytes(out, b"every name a tool prints is taken back. Output is one fact per line,\n");
    buf_bytes(out, b"fields separated by a TAB; `--budget N` keeps it to about N tokens.\n");
    buf_bytes(out, b"`CMD --help` lists a command's options.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Several commands in one call: `volec batch < cmds.txt`, one command\n");
    buf_bytes(out, b"per line as typed after `volec` (`<<END` ... `END` gives one its\n");
    buf_bytes(out, b"stdin); each output follows a line `## $ volec ARGS`. Chain what you\n");
    buf_bytes(out, b"would run in turn: `query items` then `query show`, `show` then `refs`,\n");
    buf_bytes(out, b"an edit then `check`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Changing\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| to | run |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| change text inside an item | `volec edit patch NAME --old 'TEXT' --new 'TEXT'` (pairs repeat; for hunks: several lines at other indentation match as `--loose`; the same change everywhere: `--all`; a whole item: `edit replace`) |\n");
    buf_bytes(out, b"| replace, add, remove an item | `volec edit replace NAME < new.vl`, `edit insert --after NAME < item.vl`, `edit delete NAME` |\n");
    buf_bytes(out, b"| add statements inside an item | `volec edit insert --in NAME --after 'ANCHOR' < text` |\n");
    buf_bytes(out, b"| several items at once, one edit | `volec edit apply items.vl`: `@@ NAME` then its new text, `@@ new after NAME`, `@@ delete NAME` (or `query show A B`'s output, edited) |\n");
    buf_bytes(out, b"| see the result | `--show` on any edit; `volec query diff` |\n");
    buf_bytes(out, b"| undo the last edit | `volec undo` (the journal: in `.git`, else in `.volec/` next to main.vl) |\n");
    buf_bytes(out, b"| merge conflicts | `volec query conflicts --show`, then `volec edit resolve FILE:LINE --ours` (`--theirs`, `--both`, `< text`) |\n");
    buf_bytes(out, b"| rename anything, with every use | `volec refactor rename PATH NEW` |\n");
    buf_bytes(out, b"| rename a local or parameter | `volec refactor rename FILE:LINE:COL NEW` or `refactor rename FN::x NEW` (shadowing respected) |\n");
    buf_bytes(out, b"| a parameter, with every call | `volec refactor signature FN --add 'x: i64 = 0'` (the parameter is `x: i64` and each call gets 0; `--remove`, `--rename-param`, `--reorder`, `--type`) |\n");
    buf_bytes(out, b"| a field, with every literal | `volec refactor field STRUCT --add 'g: i64 = 0'` (`--type g T --default EXPR`) |\n");
    buf_bytes(out, b"| a variant, with every match | `volec refactor variant ENUM --add 'X(i64)' --arm 'EXPR'` (`--arm-in FN 'EXPR'` per match) |\n");
    buf_bytes(out, b"| move items to a module | `volec refactor move PATH --to MODULE` (made when missing) |\n");
    buf_bytes(out, b"| an idiom everywhere, typed | `volec rewrite 'old($a)' 'new($a)' --dry-run` |\n");
    buf_bytes(out, b"| a word in every file git tracks (docs, scripts, a source's comments or strings) | `volec rewrite --text OLD NEW --word --case --dry-run --diff` (`--files GLOB`, `--comments`, `--strings`, `--no-sources`, `--exclude SPEC`, `--check ROOT`) |\n");
    buf_bytes(out, b"| sources to another extension, with the mentions of their paths | `volec refactor extension .vl .vl ROOT\\|DIR\\|--all --dry-run` (git mv; the build compared before and after) |\n");
    buf_bytes(out, b"| imports, unused, pub, unsafe | `volec fix` (`--only imports,unused,pub,unsafe`, `--dry-run`) |\n");
    buf_bytes(out, b"| the errors' exact fixes (their `try: volec fix --suggested`) | `volec fix --suggested` (`--dry-run`, `--at FILE:LINE`, `--codes CODE,...`, `--diff`) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Every edit is atomic: the edited program is checked first, and an edit\n");
    buf_bytes(out, b"that adds an error writes nothing and prints the errors, each tagged\n");
    buf_bytes(out, b"`[edited: PATH]` or `[in PATH]` (an item the edit did not change: change\n");
    buf_bytes(out, b"it in the same `edit apply`, or run the refactoring the `try:` line\n");
    buf_bytes(out, b"names). `--dry-run` prints the diff instead; `--no-check` writes anyway.\n");
    buf_bytes(out, b"A change of several steps is one call, checked once at its end: `edit\n");
    buf_bytes(out, b"patch NAME --old A --new B --old C --new D` (`--in OTHER` before the\n");
    buf_bytes(out, b"pairs of another item: a table and its count const), `--pairs FILE`\n");
    buf_bytes(out, b"with `@@ NAME` or `@@ FILE` blocks (and `--old`/`--new` too), or `edit\n");
    buf_bytes(out, b"apply FILE`. An empty OLD inserts NEW above the line of a `FILE:LINE`\n");
    buf_bytes(out, b"target: comments above many lines are one pairs file, a block per\n");
    buf_bytes(out, b"`@@ FILE:LINE` (the lines as before the edit). A refused edit's\n");
    buf_bytes(out, b"`edit.breaks` line names its first error; a generated file (`//\n");
    buf_bytes(out, b"Generated by SCRIPT`) is refused, `edit.generated` (`--force`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Testing\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec test` builds the program when a source changed and runs its\n");
    buf_bytes(out, b"cases: `tests/NAME.in` (stdin; none: empty) with `tests/NAME.out` (the\n");
    buf_bytes(out, b"expected stdout), next to `main.vl`; `tests/NAME.exit` holds an exit\n");
    buf_bytes(out, b"status other than 0. It prints the counts first, then each failing case\n");
    buf_bytes(out, b"with a few lines of difference, within about 1,000 tokens:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"$ volec test\n");
    buf_bytes(out, b"test main.vl: 4 passed, 1 failed (tests/)\n");
    buf_bytes(out, b"FAIL big: stdout differs at line 3 (10 lines expected, 9 printed)\n");
    buf_bytes(out, b"  - 42 apples\n");
    buf_bytes(out, b"  - 43 pears\n");
    buf_bytes(out, b"  + 41 apples\n");
    buf_bytes(out, b"  + 43 pears\n");
    buf_bytes(out, b"(outputs: .volec/test/NAME.got, NAME.err)\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec test big small` runs the cases whose names contain a word;\n");
    buf_bytes(out, b"`--full` every failure in full; `--input FILE` (`-`: stdin) one run,\n");
    buf_bytes(out, b"its output and exit status; `--timeout S` per case (10; one stopped\n");
    buf_bytes(out, b"by it having run under half of S, waiting on a loaded machine, runs\n");
    buf_bytes(out, b"again, twice at most). Output is\n");
    buf_bytes(out, b"compared with `\\r\\n` as `\\n` and trailing whitespace at the end left\n");
    buf_bytes(out, b"out. In the vole tree, `volec test FILTER` rebuilds\n");
    buf_bytes(out, b"`target/volec` when the source is newer and runs `tests/run.sh\n");
    buf_bytes(out, b"FILTER`, summarized the same way.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Debugging\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A bug: `volec guide debug`. Tests are built with `--trace`, so a crash\n");
    buf_bytes(out, b"or a hang prints its line and callers. `volec probe FILE:LINE EXPR...\n");
    buf_bytes(out, b"--input FILE` prints values at a line without editing the source.\n");
    buf_bytes(out, b"`volec reduce FILE --until 'CMD'` shrinks a failing input. In the\n");
    buf_bytes(out, b"vole tree, `volec test FILTER` also runs each failure with\n");
    buf_bytes(out, b"`target/tools/volec`, to tell new failures from old ones.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Diagnostics\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Compiler errors, from `volec check` or a build whose output is not a\n");
    buf_bytes(out, b"terminal (`--diagnostics=short` anywhere, `--diagnostics=human` for the\n");
    buf_bytes(out, b"multi-line form):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"main.vl:4:20: error[type error] undefined variable 'totl' | help: did you mean 'total'?\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A tool's problem is one line, `SEVERITY CODE: MESSAGE` (the code is\n");
    buf_bytes(out, b"stable), followed by `try:` lines, each a command to run as it is:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"error patch.no-match: OLD 1 is not in crate::main; nearest, line 4: println(\"{}\", total);\n");
    buf_bytes(out, b"try: volec edit patch main --old 'println(\"{}\", total)' --new 'println(\"{}\", total + 1)'\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Exit status: 0 done, 1 refused or failed (nothing written), 2 usage.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"On a terminal (0.25.3) a build and `check` show their phases\n");
    buf_bytes(out, b"(`Checking main.vl ... ok`, `Compiling`, `Linking`), each error as rustc\n");
    buf_bytes(out, b"does (`FILE:LINE:COL`, the source line, a caret, the `try:` marked) and a\n");
    buf_bytes(out, b"`Finished` or `Failed` line, in colour: `--color=auto|always|never`,\n");
    buf_bytes(out, b"`NO_COLOR`. Off a terminal the output is the one-line form above. A link\n");
    buf_bytes(out, b"that fails is one error too (`link.undefined`, `link.no-library`,\n");
    buf_bytes(out, b"`main.missing`...; `volec explain link`), `--verbose` adds the linker's\n");
    buf_bytes(out, b"own text; `volec build main.vl` says to write `volec main.vl -o main`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## In an editor\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec lsp` (0.24) is a language server over stdin and stdout: the\n");
    buf_bytes(out, b"same answers in an editor, unsaved edits included. Definition and\n");
    buf_bytes(out, b"references of every name, std's included (0.25: its files written to a\n");
    buf_bytes(out, b"cache, `~/Library/Caches/vole/std-*`, `~/.cache/vole/std-*`), operators\n");
    buf_bytes(out, b"(`+` of a type with `Add`) and type parameters too; hover with a\n");
    buf_bytes(out, b"function's signature, effects (declared or inferred, a line of why\n");
    buf_bytes(out, b"each), features and comment, a local's type, or a line on a keyword,\n");
    buf_bytes(out, b"an attribute or a primitive type; the file's and the workspace's\n");
    buf_bytes(out, b"symbols; `check`'s errors as diagnostics, their `try:` lines attached.\n");
    buf_bytes(out, b"(0.25.1) Completion while typing, on text that does not parse yet:\n");
    buf_bytes(out, b"after `.` the receiver's fields and methods (`v.` of a `Vec<i64, Gpa>`), after\n");
    buf_bytes(out, b"`::` a module's items, variants, a type's functions, else the locals,\n");
    buf_bytes(out, b"the module's items, imports, the prelude and keywords, each with its\n");
    buf_bytes(out, b"signature, and its comment and effects when chosen; formatting, the\n");
    buf_bytes(out, b"buffer as `volec fmt` lays it out (the VS Code extension on save), no\n");
    buf_bytes(out, b"edits when it does not parse. The root: the nearest `main.vl` (up to\n");
    buf_bytes(out, b"the repository's top or the home directory), else the file itself\n");
    buf_bytes(out, b"(0.25.2). (0.25.2) Definition on a C import's string opens the header,\n");
    buf_bytes(out, b"on `c::NAME` its declaration there (a hover shows it); headers found\n");
    buf_bytes(out, b"through `-I` need the include paths (`vole.includePaths`; docs/lsp.md).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Other compiler options\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`-O0`, `-O1`, `-O2` (the default; all behave the same), `-j N` (0.18.1:\n");
    buf_bytes(out, b"the threads -O1 and -O2 compile on; the output is the same whatever N),\n");
    buf_bytes(out, b"`--no-cache` (0.18.1: -O1 and -O2 keep each function's optimized code in\n");
    buf_bytes(out, b"`target/volec-cache/`, as the tools' cache, and a rebuild reuses what\n");
    buf_bytes(out, b"an edit did not change, the same bytes, for a program past about 8000\n");
    buf_bytes(out, b"IR instructions or with `--cache=on`; `--no-cache` goes without; both\n");
    buf_bytes(out, b"caches drop their least recently used past `$VOLE_CACHE_LIMIT` MB, 1024 each),\n");
    buf_bytes(out, b"`--target aarch64-macos|aarch64-linux|x86_64-linux|x86_64-macos`, `-g` (debug line\n");
    buf_bytes(out, b"tables), `--trace` (0.17: a failure prints its line and callers),\n");
    buf_bytes(out, b"`--check-unsafe`, `--check-alloc` (0.16), `--emit-header`,\n");
    buf_bytes(out, b"`--emit-imports`, `-I DIR`, `--version`; `--emit-ir` and `--emit-mir`\n");
    buf_bytes(out, b"(the IR after the optimizer, after instruction selection) print to\n");
    buf_bytes(out, b"stdout, or to `-o FILE`. `volec guide TOPIC` for the language.\n");
}
