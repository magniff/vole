// Generated by compiler/guide/embed.sh from compiler/guide/generics.md (do
// not edit): the guide's topic 'generics'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Generics\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Functions, structs, enums, traits, impl blocks and type aliases take\n");
    buf_bytes(out, b"type parameters. A generic item is a template: each use with new type\n");
    buf_bytes(out, b"arguments makes a separate copy (monomorphization), checked and\n");
    buf_bytes(out, b"optimized as if written by hand. No boxing, no dynamic dispatch.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::alloc::Allocator;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Stack<T, A: Allocator> {\n");
    buf_bytes(out, b"    items: Vec<T, A>,\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl<T, A: Allocator> Stack<T, A> {\n");
    buf_bytes(out, b"    fn new(a: A) -> Stack<T, A> { Stack { items: Vec::new_in(a) } }\n");
    buf_bytes(out, b"    fn push(&mut self, x: T) { self.items.push(x); }\n");
    buf_bytes(out, b"    fn pop(&mut self) -> Option<T> { self.items.pop() }\n");
    buf_bytes(out, b"}                                          // no free: a Stack drops its Vec\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Stack<i64, Gpa> {                     // methods of one instance only\n");
    buf_bytes(out, b"    fn sum(&self) -> i64 { self.items.iter().sum() }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn largest<T: Ord + Copy>(s: &[T]) -> T {  // bounds: T has Ord and Copy\n");
    buf_bytes(out, b"    let mut best = s[0];\n");
    buf_bytes(out, b"    for &x in s {\n");
    buf_bytes(out, b"        if x > best { best = x; }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    best\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn swap<T, U>(p: (T, U)) -> (U, T) { (p.1, p.0) }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"type Pair<T> = (T, T);\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn sum_pair(p: Pair<i64>) -> i64 { p.0 + p.1 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut s: Stack<i64, Gpa> = Stack::new(gpa);\n");
    buf_bytes(out, b"    s.push(4);\n");
    buf_bytes(out, b"    s.push(9);\n");
    buf_bytes(out, b"    let a = [3i64, 8, 1];\n");
    buf_bytes(out, b"    print(\"{} {} \", s.sum(), largest(&a));\n");
    buf_bytes(out, b"    print(\"{} \", largest::<u8>(b\"vole\"));  // the turbofish\n");
    buf_bytes(out, b"    let t = swap((1, \"one\"));\n");
    buf_bytes(out, b"    println(\"{} {}\", t.0, sum_pair((2, 3)) + s.pop().unwrap());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"13 8 118 one 14\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Type arguments: after a type's name (`Vec<i64, Gpa>`, `Option<&str>`), and in\n");
    buf_bytes(out, b"  expressions after `::` (`Vec::<u8, Gpa>::new_in(gpa)`, `max::<i64>(a, b)`,\n");
    buf_bytes(out, b"  a method's own: `x.m::<u8>()`). They are inferred from arguments and\n");
    buf_bytes(out, b"  from the expected type (`let v: Vec<i64, Gpa> = Vec::new_in(gpa);`);\n");
    buf_bytes(out, b"  unsuffixed literals are looked at last. A `&[T]` parameter infers T\n");
    buf_bytes(out, b"  from what is borrowed: `&v` of a `Vec<i64, Gpa>`, `&v[a..b]`, `&a` of\n");
    buf_bytes(out, b"  an array, `s.as_bytes()`.\n");
    buf_bytes(out, b"- A generic function used as a value needs its arguments:\n");
    buf_bytes(out, b"  `let f = largest::<i64>;`.\n");
    buf_bytes(out, b"- A body uses a type parameter only as its bounds allow, as in Rust:\n");
    buf_bytes(out, b"  `a > b` needs `T: PartialOrd`, and `let best = s[0]` (a copy out of a\n");
    buf_bytes(out, b"  slice) needs `T: Copy`. An error inside an instance is reported with\n");
    buf_bytes(out, b"  `note: in instantiation of 'f<P>' at ...`.\n");
    buf_bytes(out, b"- `size_of::<T>()` and `align_of::<T>()` (std::mem's) work on type\n");
    buf_bytes(out, b"  parameters.\n");
    buf_bytes(out, b"- `where` writes the bounds after the signature: `fn f<T>(x: T) where\n");
    buf_bytes(out, b"  T: Display + Copy`, on a struct, an enum, a trait and an impl too\n");
    buf_bytes(out, b"  (`impl<T, A: Allocator> Stack<T, A> where T: Ord {`), and on an\n");
    buf_bytes(out, b"  associated type (`where I::Item: Display`).\n");
    buf_bytes(out, b"- `x: impl Display` is a type parameter without a name: `fn show(x:\n");
    buf_bytes(out, b"  impl Display)` is `fn show<T: Display>(x: T)`; also `f: impl Fn(i64)\n");
    buf_bytes(out, b"  -> i64` and `f: &mut impl FnMut(i64)`. A result may be `impl Trait`\n");
    buf_bytes(out, b"  too (`fn twice() -> impl Fn(i64) -> i64`). A turbofish gives only the\n");
    buf_bytes(out, b"  named parameters.\n");
    buf_bytes(out, b"- Traits take type parameters (`trait Conv<T> { fn conv(&self) -> T; }`,\n");
    buf_bytes(out, b"  `impl Conv<i64> for i32`), and have associated types: `I::Item` for\n");
    buf_bytes(out, b"  `I: Iterator`, bounds `I: Iterator<Item = i64>`, `F: Fn(i64) -> bool`\n");
    buf_bytes(out, b"  (`volec guide iterators`, `guide closures`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::fmt::Display;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn show<T>(label: T, x: impl Display) where T: Display {\n");
    buf_bytes(out, b"    println(\"{label}={x}\");\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn apply(f: impl Fn(i64) -> i64, x: i64) -> i64 { f(x) }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    show(\"n\", 4);\n");
    buf_bytes(out, b"    show::<&str>(\"pi\", 3.5);\n");
    buf_bytes(out, b"    println(\"{}\", apply(|x| x * 2, 21));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"n=4\n");
    buf_bytes(out, b"pi=3.5\n");
    buf_bytes(out, b"42\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Not there: const generics (`[T; N]` with `N` a parameter), variadic\n");
    buf_bytes(out, b"  generics.\n");
}
