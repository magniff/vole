// Generated by compiler/guide/embed.sh from compiler/guide/generics.md (do
// not edit): the guide's topic 'generics'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Generics\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Functions, structs, enums, impl blocks and type aliases take type\n");
    buf_bytes(out, b"parameters. A generic item is a template: each use with new type\n");
    buf_bytes(out, b"arguments makes a separate copy (monomorphization), checked and\n");
    buf_bytes(out, b"optimized as if written by hand. No boxing, no dynamic dispatch.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Stack<T, A: Allocator> { items: Vec<T, A> }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl<T, A: Allocator> Stack<T, A> {\n");
    buf_bytes(out, b"    fn new(a: A) -> Stack<T, A> { Stack { items: Vec::new_in(a) } }\n");
    buf_bytes(out, b"    fn push(inout self, x: sink T) { self.items.push(x); }\n");
    buf_bytes(out, b"    fn pop(inout self) -> Option<T> { self.items.pop() }\n");
    buf_bytes(out, b"}                                          // no free: a Stack drops its Vec\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Stack<i64, Gpa> { // methods of one instance only\n");
    buf_bytes(out, b"    fn sum(self) -> i64 {\n");
    buf_bytes(out, b"        var t = 0;\n");
    buf_bytes(out, b"        for x in self.items.as_slice() { t += x; }\n");
    buf_bytes(out, b"        t\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn largest<T: Ord>(s: [T]) -> T {          // a bound: T must implement Ord\n");
    buf_bytes(out, b"    var best = s[0];\n");
    buf_bytes(out, b"    for x in s { if x > best { best = x; } }\n");
    buf_bytes(out, b"    best\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn swap<T, U>(p: sink (T, U)) -> (U, T) { (p.1, p.0) }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"type Pair<T> = (T, T);\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn sum_pair(p: Pair<i64>) -> i64 { p.0 + p.1 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    var s: Stack<i64, Gpa> = Stack::new(gpa);\n");
    buf_bytes(out, b"    s.push(4);\n");
    buf_bytes(out, b"    s.push(9);\n");
    buf_bytes(out, b"    std::print_int(s.sum());\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    let a = [3, 8, 1];\n");
    buf_bytes(out, b"    std::print_int(largest(a[..]));\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(largest::<u8>(\"vole\") as i64);   // the turbofish\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    let t = swap((1, \"one\"));\n");
    buf_bytes(out, b"    print(t.0);\n");
    buf_bytes(out, b"    print(\" \");\n");
    buf_bytes(out, b"    std::print_int(sum_pair((2, 3)) + s.pop().unwrap());\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"13 8 118 one 14\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Type arguments: after a type's name (`Vec<i64, Gpa>`, `Option<*u8>`), and in\n");
    buf_bytes(out, b"  expressions after `::` (`Vec::<u8, Gpa>::new_in(gpa)`, `max::<i64>(a, b)`,\n");
    buf_bytes(out, b"  `Pair::<i64> { a: 1, b: 2 }`, a method's own: `x.m::<u8>()`). They are inferred\n");
    buf_bytes(out, b"  from arguments and from the expected type (`let v: Vec<i64, Gpa> =\n");
    buf_bytes(out, b"  Vec::new_in(gpa);`); unsuffixed literals are looked at last. A `[T]`\n");
    buf_bytes(out, b"  parameter (let, `inout` or `sink`) infers T from what lends it the\n");
    buf_bytes(out, b"  slice: `sort(&v)` of a `Vec<i64, Gpa>`, `&xs[a..b]`, an array, a Buf, a\n");
    buf_bytes(out, b"  String's bytes (to read), `&xs` of an `inout [T]` parameter (0.25.1).\n");
    buf_bytes(out, b"- A generic function used as a value needs its arguments:\n");
    buf_bytes(out, b"  `let f = largest::<i64>;`.\n");
    buf_bytes(out, b"- Without bounds, a body is checked per instance: `a > b` works for\n");
    buf_bytes(out, b"  every `T` that has `>`. An error inside an instance is reported with\n");
    buf_bytes(out, b"  `note: in instantiation of 'f<P>' at ...`. With a bound, only the\n");
    buf_bytes(out, b"  bound's functions may be called on `T`'s values.\n");
    buf_bytes(out, b"- A parameter's convention holds for every instance, and its cost is\n");
    buf_bytes(out, b"  the instance's: `x: T` (let) is a copy where `T` is plain and a\n");
    buf_bytes(out, b"  borrow where it is owned; `x: sink T` moves an owned `T`. A function\n");
    buf_bytes(out, b"  that keeps or returns its argument (`push`, `swap`) takes it `sink`.\n");
    buf_bytes(out, b"- `size_of(T)` and `align_of(T)` work on type parameters.\n");
    buf_bytes(out, b"- `where` (0.26.2) writes the bounds after the signature, Rust's way:\n");
    buf_bytes(out, b"  `fn f<T>(x: T) where T: Display + Copy`, on a struct, an enum, a trait\n");
    buf_bytes(out, b"  and an impl too (`impl<T, A: Allocator> Stack<T, A> where T: Ord {`). Its left side is a\n");
    buf_bytes(out, b"  parameter of the item: `where I::Item: Display` is\n");
    buf_bytes(out, b"  `where.unsupported`, write `I: Iterator<Item = X>, X: Display`.\n");
    buf_bytes(out, b"- `x: impl Display` (0.26.2) is a type parameter without a name, as in\n");
    buf_bytes(out, b"  Rust: `fn show(x: impl Display)` is `fn show<T: Display>(x: T)`; also\n");
    buf_bytes(out, b"  `f: impl Fn(i64) -> i64` and `f: inout impl FnMut(i64)`. Messages call\n");
    buf_bytes(out, b"  it `impl Display`; a turbofish gives only the named parameters. Only a\n");
    buf_bytes(out, b"  parameter's type may be `impl Trait` (`type.impl-position`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::Display;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn show<T>(label: T, x: impl Display) where T: Display {\n");
    buf_bytes(out, b"    println(\"{label}={x}\");\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn apply(f: impl Fn(i64) -> i64, x: i64) -> i64 { f(x) }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    show(\"n\", 4);\n");
    buf_bytes(out, b"    show::<[u8]>(\"pi\", 3.5);\n");
    buf_bytes(out, b"    println(apply(|x| x * 2, 21));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"n=4\n");
    buf_bytes(out, b"pi=3.5\n");
    buf_bytes(out, b"42\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- Not there: const generics (`[T; N]` with `N` a parameter), generic\n");
    buf_bytes(out, b"  traits (`trait Conv<T>`), variadic generics.\n");
    buf_bytes(out, b"  Associated types (0.14): `I::Item` for `I: Iterator`, and bounds\n");
    buf_bytes(out, b"  `I: Iterator<Item = i64>`, `F: Fn(i64) -> bool` (`volec guide\n");
    buf_bytes(out, b"  iterators`, `guide closures`).\n");
}
