// Generated by compiler/guide/embed.sh from compiler/guide/arch.md (do
// not edit): the guide's topic 'arch'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# std::arch: SIMD and CPU intrinsics (0.19)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::arch` gives the CPU's own instructions as functions, the\n");
    buf_bytes(out, b"intrinsics: SIMD on vectors (NEON on AArch64, SSE to AVX2 on x86-64),\n");
    buf_bytes(out, b"CRC32 checksums, AES, SHA-256, dot products, popcount and bit scans.\n");
    buf_bytes(out, b"They are in `std::arch::aarch64`, `std::arch::x86_64`, and, portable,\n");
    buf_bytes(out, b"`std::arch` (`has`, `detect`, `count_ones`). The names are the vendors' (ACLE's `vaddq_u8`,\n");
    buf_bytes(out, b"`__crc32cd`; Intel's `_mm_movemask_epi8`), as C and Rust's `core::arch`\n");
    buf_bytes(out, b"spell them, so code and answers written for those carry over. Each\n");
    buf_bytes(out, b"intrinsic is one instruction, seen by the optimizer (constant folding,\n");
    buf_bytes(out, b"GVN, hoisting out of loops).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Three rules make it safe: an instruction the CPU lacks never runs (the\n");
    buf_bytes(out, b"compiler checks every call against the features known at that point:\n");
    buf_bytes(out, b"`arch.feature`), memory intrinsics take a checked slice and an index,\n");
    buf_bytes(out, b"and nothing is undefined (a shift count or lane out of range is a\n");
    buf_bytes(out, b"compile error, `arch.const_arg`). No `unsafe` is needed, and none is\n");
    buf_bytes(out, b"written: an `unsafe` block around them is a warning.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Recipes\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"What to reach for, by task. AArch64 is executed and tested on every\n");
    buf_bytes(out, b"build; x86-64 is compiled and its encodings checked.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| task | AArch64 | x86-64 |\n");
    buf_bytes(out, b"|---|---|---|\n");
    buf_bytes(out, b"| byte search (memchr) | `vceqq_u8`, `vmaxvq_u8` (any match), the shrn movemask (where: below) | `_mm_cmpeq_epi8`, `_mm_movemask_epi8`, `trailing_zeros` (sse2); `_mm256_cmpeq_epi8`, `_mm256_movemask_epi8` (avx2) |\n");
    buf_bytes(out, b"| hash-table probe (16 control bytes) | `vld1q_u8`, `vdupq_n_u8`, `vceqq_u8`, shrn movemask | `_mm_loadu_si128`, `_mm_set1_epi8`, `_mm_cmpeq_epi8`, `_mm_movemask_epi8` |\n");
    buf_bytes(out, b"| checksums: CRC-32 (gzip), CRC-32C | `__crc32b`...`__crc32d`, `__crc32cb`...`__crc32cd` (crc) | `_mm_crc32_u8`...`_mm_crc32_u64` (sse4.2, CRC-32C only) |\n");
    buf_bytes(out, b"| hashing, GHASH, CRC folding | `vmull_p64` (aes: carry-less multiply), `vaeseq_u8` + `vaesmcq_u8` | `_mm_clmulepi64_si128` (pclmulqdq), `_mm_aesenc_si128` (aes) |\n");
    buf_bytes(out, b"| SHA-1, SHA-256 | `vsha256hq_u32`, `vsha256h2q_u32`, `vsha256su0q_u32`, `vsha256su1q_u32` (sha2) | `_mm_sha256rnds2_epu32`, `_mm_sha256msg1_epu32` (sha) |\n");
    buf_bytes(out, b"| dot products (int8 ML, Adler-32) | `vdotq_u32`, `vdotq_s32` (dotprod) | `_mm_maddubs_epi16` (ssse3), `_mm_madd_epi16`, `_mm_sad_epu8` (sse2) |\n");
    buf_bytes(out, b"| popcount, bit scans | `x.count_ones()`, `leading_zeros`, `trailing_zeros` (the integer methods, one instruction); `vcntq_u8` per byte | the same methods (popcnt, lzcnt, tzcnt when known); `_popcnt64` (popcnt), `_lzcnt_u64` (lzcnt), `_tzcnt_u64` (bmi1) |\n");
    buf_bytes(out, b"| table lookup, shuffles | `vqtbl1q_u8`, `vextq_u8`, `vzip1q_u8` | `_mm_shuffle_epi8`, `_mm_alignr_epi8` (ssse3) |\n");
    buf_bytes(out, b"| saturating arithmetic | `vqaddq_u8`, `vqsubq_u8` | `_mm_adds_epu8`, `_mm_subs_epu8` (sse2) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The x86-64 column is Intel's names, SSE2 to AVX2 (`volec query arch\n");
    buf_bytes(out, b"--arch x86_64` lists them, `--feature avx2` one feature's); the feature\n");
    buf_bytes(out, b"in parentheses is what the call needs beyond x86-64's baseline (sse2).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Finding one without a manual, by words, feature or instruction (no\n");
    buf_bytes(out, b"program needed; one intrinsic a line: name, features, instruction,\n");
    buf_bytes(out, b"what it does):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec query arch saturating subtract u8    # aarch64::vqsubq_u8  neon  uqsub ...\n");
    buf_bytes(out, b"volec query arch --feature crc             # every CRC intrinsic\n");
    buf_bytes(out, b"volec query arch --equiv _mm_movemask_epi8 # the other architecture's way\n");
    buf_bytes(out, b"volec query show vqtbl1q_u8                # signature, features, instruction, what it computes, its use line\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Vectors are values in a vector register, with lanes: `v16u8` (16 lanes\n");
    buf_bytes(out, b"of `u8`), `v8i16`, `v4f32`, ...: 64-bit (`v8u8`, `v2f32`), 128-bit and\n");
    buf_bytes(out, b"256-bit (`v32u8`, `v8f32`; two registers on AArch64), signed, unsigned\n");
    buf_bytes(out, b"and float, with `+ - * & | ^`, compares (a mask), `splat`, `load`,\n");
    buf_bytes(out, b"`lane`, `sum` (`guide types#simd-vectors`). ACLE's names are aliases:\n");
    buf_bytes(out, b"`uint8x16_t` is `v16u8`, `int32x4_t` is `v4i32`, `uint8x16x2_t` is\n");
    buf_bytes(out, b"`(v16u8, v16u8)`. Intel's `__m128i`, `__m128`, `__m256i` ... are opaque:\n");
    buf_bytes(out, b"no lanes, no operators, made and read by their intrinsics, because\n");
    buf_bytes(out, b"`a + b` on an `__m128i` would not say the lane width.\n");
    buf_bytes(out, b"`T::from_bits(v)` reinterprets any vector of the same size, with no\n");
    buf_bytes(out, b"instruction (`v16u8::from_bits(m)`, as `vreinterpretq_*` and\n");
    buf_bytes(out, b"`_mm_cast*` do).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Immediates (shift counts, lanes, `ext` positions) are the last\n");
    buf_bytes(out, b"arguments and must be constants in the instruction's range:\n");
    buf_bytes(out, b"`vshrq_n_u8(v, 3)`, never Rust's `vshrq_n_u8::<3>(v)` (`arch.rust_form`\n");
    buf_bytes(out, b"says so, with the edit).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::arch::aarch64::{vaddq_u8, vdupq_n_u8, vextq_u8, vgetq_lane_u8, vqsubq_u8};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let a = vdupq_n_u8(200);\n");
    buf_bytes(out, b"    let b = vdupq_n_u8(100);\n");
    buf_bytes(out, b"    let wrapped = vaddq_u8(a, b);      // 300 wraps to 44\n");
    buf_bytes(out, b"    let floor = vqsubq_u8(b, a);       // saturates at 0\n");
    buf_bytes(out, b"    let both = vextq_u8(wrapped, floor, 15);\n");
    buf_bytes(out, b"    println(\"{} {} {}\", vgetq_lane_u8(wrapped, 0), vgetq_lane_u8(floor, 0), vgetq_lane_u8(both, 1));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"44 0 0\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Guards\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An intrinsic needs its features (`query show NAME` prints them). A call\n");
    buf_bytes(out, b"is accepted where they are known:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- the build's features: the target's baseline, or `-C target-cpu=` /\n");
    buf_bytes(out, b"  `-C target-feature=+f` (below, Features);\n");
    buf_bytes(out, b"- the enclosing function's `#[target_feature(enable = \"crc\")]`;\n");
    buf_bytes(out, b"- a guard: the then branch of `if std::arch::detect(\"crc\")` or\n");
    buf_bytes(out, b"  `if std::arch::has(\"crc\")` (`&&` of them too), the else branch of\n");
    buf_bytes(out, b"  `if !detect(\"crc\")`, the rest of a block after `if !detect(\"crc\") {\n");
    buf_bytes(out, b"  return ...; }`, and after `assert(detect(\"crc\"))`. A `bool` kept in a\n");
    buf_bytes(out, b"  local or an `||` is no guard.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`detect(\"f\")` asks the running CPU: one cached bit (filled once before\n");
    buf_bytes(out, b"`main`), a constant when the build already knows f, and `false` for\n");
    buf_bytes(out, b"another architecture's feature. `has(\"f\")` is the build's answer, a\n");
    buf_bytes(out, b"constant. What a function needs is inferred from its calls, as effects\n");
    buf_bytes(out, b"are, so helpers need no attribute: the error appears in the entry point\n");
    buf_bytes(out, b"(`main`, an `extern \"C\"` function, a test) at the call that is not\n");
    buf_bytes(out, b"guarded, with the intrinsic it comes from and an edit that adds the\n");
    buf_bytes(out, b"guard. `volec query features NAME` prints a function's requirement,\n");
    buf_bytes(out, b"`--why crc` the calls down to the intrinsic; `def`, `show` and `context`\n");
    buf_bytes(out, b"print it as `features: crc (inferred)` after its effects.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::arch::aarch64::__crc32cb;\n");
    buf_bytes(out, b"use std::arch::detect;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// CRC-32C of s, bit by bit: the fallback.\n");
    buf_bytes(out, b"fn crc32c_portable(s: &[u8]) -> u32 {\n");
    buf_bytes(out, b"    let mut c: u32 = 0xffffffff;\n");
    buf_bytes(out, b"    for b in s {\n");
    buf_bytes(out, b"        c ^= *b as u32;\n");
    buf_bytes(out, b"        for _ in 0..8 {\n");
    buf_bytes(out, b"            c = if (c & 1) != 0 { (c >> 1) ^ 0x82f63b78 } else { c >> 1 };\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    !c\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// The same by the crc instructions: needs crc (inferred).\n");
    buf_bytes(out, b"fn crc32c_hw(s: &[u8]) -> u32 {\n");
    buf_bytes(out, b"    let mut c: u32 = 0xffffffff;\n");
    buf_bytes(out, b"    for b in s {\n");
    buf_bytes(out, b"        c = __crc32cb(c, *b);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    !c\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn crc32c(s: &[u8]) -> u32 {\n");
    buf_bytes(out, b"    if detect(\"crc\") { crc32c_hw(s) } else { crc32c_portable(s) }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    println(\"{:x} {:x}\", crc32c(b\"123456789\"), crc32c_portable(b\"123456789\"));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"e3069283 e3069283\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Code for the other architecture stays in the program: under\n");
    buf_bytes(out, b"`has(\"avx2\")` it is type-checked on an arm machine and never generated\n");
    buf_bytes(out, b"there, so one source serves both (no `cfg`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Features\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| target | the build's baseline (default `-C target-cpu`) |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| aarch64-macos | `apple-m1`: neon, fp, crc, aes, sha2, sha3, dotprod, rdm, lse, fp16 |\n");
    buf_bytes(out, b"| aarch64-linux | `generic`: neon, fp (crc, aes, sha2, dotprod are detected) |\n");
    buf_bytes(out, b"| x86_64-linux | `x86-64`: sse, sse2 |\n");
    buf_bytes(out, b"| x86_64-macos | `core2`: up to ssse3 |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`-C target-cpu=NAME|native` and `-C target-feature=+crc,-aes` change\n");
    buf_bytes(out, b"it, on every command that checks (`check`, `query`, the edits). A\n");
    buf_bytes(out, b"feature implies those below it (`avx2` => `avx` => `sse4.2` ... => `sse2`;\n");
    buf_bytes(out, b"`sha3` => `sha2` => `neon`); `aes` exists on both architectures, so\n");
    buf_bytes(out, b"`aarch64.aes` and `x86_64.aes` name one. `VOLE_ARCH_DISABLE=crc,aes`\n");
    buf_bytes(out, b"(or `all`) in the environment makes `detect` answer false for those at\n");
    buf_bytes(out, b"run time: the way to test a fallback on a machine that has the feature.\n");
    buf_bytes(out, b"It can only clear features, never add one.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`#[target_feature(enable = \"crc,aes\")]` on a function declares what it\n");
    buf_bytes(out, b"needs: callers must know it, and its body is checked against it\n");
    buf_bytes(out, b"(`arch.declared`). It is a pin, as `#[effects]` is, rarely needed.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`#[multiversion(\"dotprod\", \"avx2\")]` compiles one body once per listed\n");
    buf_bytes(out, b"set the build lacks, plus the baseline version, and makes the function\n");
    buf_bytes(out, b"a dispatcher (`if detect(..) { version } else ...`: no indirect call,\n");
    buf_bytes(out, b"hoisted out of loops). Inside, `has(\"dotprod\")` is a constant per\n");
    buf_bytes(out, b"version, so it picks the code; a call only some versions can make must\n");
    buf_bytes(out, b"be under it (`arch.multiversion`). Its address can be taken.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::arch::aarch64::{vaddvq_u32, vdotq_u32, vdupq_n_u32, vld1q_u8};\n");
    buf_bytes(out, b"use std::arch::has;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// The dot product of a and b (equal lengths, a multiple of 16).\n");
    buf_bytes(out, b"#[multiversion(\"dotprod\")]\n");
    buf_bytes(out, b"fn dot(a: &[u8], b: &[u8]) -> u32 {\n");
    buf_bytes(out, b"    if has(\"dotprod\") {\n");
    buf_bytes(out, b"        let mut acc = vdupq_n_u32(0);\n");
    buf_bytes(out, b"        let mut i: i64 = 0;       // the intrinsics take an i64 index\n");
    buf_bytes(out, b"        while i + 16 <= a.len() as i64 {\n");
    buf_bytes(out, b"            acc = vdotq_u32(acc, vld1q_u8(a, i), vld1q_u8(b, i));\n");
    buf_bytes(out, b"            i += 16;\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        vaddvq_u32(acc)\n");
    buf_bytes(out, b"    } else {\n");
    buf_bytes(out, b"        let mut n: u32 = 0;\n");
    buf_bytes(out, b"        for i in 0..a.len() {\n");
    buf_bytes(out, b"            n += a[i] as u32 * b[i] as u32;\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        n\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let a: [u8; 32] = [3; 32];\n");
    buf_bytes(out, b"    let b: [u8; 32] = [2; 32];\n");
    buf_bytes(out, b"    println(\"{}\", dot(&a, &b));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"192\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Memory\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The vendor's name is the safe form: it takes a slice and an index,\n");
    buf_bytes(out, b"`vld1q_u8(s, i)` (16 bytes from `s[i]`), `vst1q_u8(s, i, v)`,\n");
    buf_bytes(out, b"`_mm_loadu_si128(s, i)`, and checks `0 <= i` and `i + 16 <= s.len()` as\n");
    buf_bytes(out, b"`s[i]` does (`panic` in its effects). The slice is a `&[T]` (`&a` of an\n");
    buf_bytes(out, b"array, `&v`, `&s[..]`) and the index an `i64`. A store writes, so its\n");
    buf_bytes(out, b"slice is `&mut [T]`: `vst1q_u8(&mut out, i, v)`, `v.as_mut_slice()`, or\n");
    buf_bytes(out, b"a `&mut [T]` parameter passed on; a `&[T]` there is a type error (the\n");
    buf_bytes(out, b"types differ in mutability). Range analysis removes the check in\n");
    buf_bytes(out, b"counted loops (`while i + 16 <= s.len() as i64`), so the loop body is\n");
    buf_bytes(out, b"the bare load. Aligned forms (`_mm_load_si128`) check the alignment too and stop\n");
    buf_bytes(out, b"with `misaligned access` instead of faulting (`arch.misaligned`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The pointer forms keep the vendor signatures and are `unsafe`, in the\n");
    buf_bytes(out, b"`raw` submodules, for porting C: `std::arch::aarch64::raw::vld1q_u8(p:\n");
    buf_bytes(out, b"*const u8)`. Passing a pointer to the safe form is `arch.raw_form`, with the\n");
    buf_bytes(out, b"edit to `s, i` when the pointer is `&s[i]`. `--check-unsafe` checks raw\n");
    buf_bytes(out, b"loads against the program's blocks as it checks any raw access.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Byte search\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"AArch64 has no movemask: to know *which* byte matched, narrow the\n");
    buf_bytes(out, b"compare mask to 4 bits a byte (`vshrn_n_u16(.., 4)`), read it as a u64\n");
    buf_bytes(out, b"and count trailing zeros; `vmaxvq_u8(eq) != 0` is the cheaper \"any\n");
    buf_bytes(out, b"match\" test for the loop. x86-64's `_mm_movemask_epi8` gives one bit a\n");
    buf_bytes(out, b"byte. Both branches can sit in one function: the other architecture's\n");
    buf_bytes(out, b"is checked and dropped.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::arch::aarch64::{\n");
    buf_bytes(out, b"    vceqq_u8, vdupq_n_u8, vget_lane_u64, vld1q_u8, vmaxvq_u8, vreinterpret_u64_u8,\n");
    buf_bytes(out, b"    vreinterpretq_u16_u8, vshrn_n_u16,\n");
    buf_bytes(out, b"};\n");
    buf_bytes(out, b"use std::arch::x86_64::{_mm_cmpeq_epi8, _mm_loadu_si128, _mm_movemask_epi8, _mm_set1_epi8};\n");
    buf_bytes(out, b"use std::arch::has;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// The first i with s[i] == b, or -1.\n");
    buf_bytes(out, b"fn find(s: &[u8], b: u8) -> i64 {\n");
    buf_bytes(out, b"    let mut i: i64 = 0;\n");
    buf_bytes(out, b"    if has(\"neon\") {\n");
    buf_bytes(out, b"        let needle = vdupq_n_u8(b);\n");
    buf_bytes(out, b"        while i + 16 <= s.len() as i64 {\n");
    buf_bytes(out, b"            let eq = vceqq_u8(vld1q_u8(s, i), needle);\n");
    buf_bytes(out, b"            if vmaxvq_u8(eq) != 0 {\n");
    buf_bytes(out, b"                let m = vget_lane_u64(vreinterpret_u64_u8(vshrn_n_u16(vreinterpretq_u16_u8(eq), 4)), 0);\n");
    buf_bytes(out, b"                return i + m.trailing_zeros() as i64 / 4;\n");
    buf_bytes(out, b"            }\n");
    buf_bytes(out, b"            i += 16;\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    } else if has(\"sse2\") {\n");
    buf_bytes(out, b"        let needle = _mm_set1_epi8(b as i8);\n");
    buf_bytes(out, b"        while i + 16 <= s.len() as i64 {\n");
    buf_bytes(out, b"            let m = _mm_movemask_epi8(_mm_cmpeq_epi8(_mm_loadu_si128(s, i), needle));\n");
    buf_bytes(out, b"            if m != 0 {\n");
    buf_bytes(out, b"                return i + m.trailing_zeros() as i64;\n");
    buf_bytes(out, b"            }\n");
    buf_bytes(out, b"            i += 16;\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    while i < s.len() as i64 {\n");
    buf_bytes(out, b"        if s[i] == b {\n");
    buf_bytes(out, b"            return i;\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"        i += 1;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    -1\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let text = b\"the quick brown fox jumps over the lazy dog\";\n");
    buf_bytes(out, b"    println(\"{} {} {}\", find(text, b'z'), find(text, b'q'), find(text, b'!'));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"37 4 -1\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`examples/arch/bytesearch` is this, with timings against the portable\n");
    buf_bytes(out, b"loop.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## SHA-256\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"The sha2 feature does SHA-256's compression four rounds an instruction.\n");
    buf_bytes(out, b"A block is 16 big-endian words; `vrev32q_u8` turns little-endian loads\n");
    buf_bytes(out, b"into them. Each group of four rounds adds the round constants to four\n");
    buf_bytes(out, b"message words (`vaddq_u32`), then `vsha256hq_u32` makes the new\n");
    buf_bytes(out, b"`abcd` and `vsha256h2q_u32` the new `efgh` from the old `abcd` (keep a\n");
    buf_bytes(out, b"copy: both read it). `vsha256su0q_u32` and `vsha256su1q_u32` extend the\n");
    buf_bytes(out, b"schedule four words at a time: the words of group g + 4 from those of\n");
    buf_bytes(out, b"groups g..g + 3. After the 16 groups the state adds the block's input\n");
    buf_bytes(out, b"state.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::arch::aarch64::{\n");
    buf_bytes(out, b"    uint32x4_t, vaddq_u32, vld1q_u32, vld1q_u8, vreinterpretq_u32_u8, vrev32q_u8, vsha256h2q_u32,\n");
    buf_bytes(out, b"    vsha256hq_u32, vsha256su0q_u32, vsha256su1q_u32, vst1q_u32,\n");
    buf_bytes(out, b"};\n");
    buf_bytes(out, b"use std::arch::detect;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// SHA-256's round constants (FIPS 180-4, 4.2.2).\n");
    buf_bytes(out, b"static K: [u32; 64] = [\n");
    buf_bytes(out, b"    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,\n");
    buf_bytes(out, b"    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,\n");
    buf_bytes(out, b"    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,\n");
    buf_bytes(out, b"    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n");
    buf_bytes(out, b"    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,\n");
    buf_bytes(out, b"    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,\n");
    buf_bytes(out, b"    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,\n");
    buf_bytes(out, b"    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,\n");
    buf_bytes(out, b"];\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// The 4 big-endian words of block[i..i + 16].\n");
    buf_bytes(out, b"fn words(block: &[u8], i: i64) -> uint32x4_t {\n");
    buf_bytes(out, b"    vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(block, i)))\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"// One 64-byte block into the state (a, b, c, d, e, f, g, h).\n");
    buf_bytes(out, b"fn compress(state: &mut [u32], block: &[u8]) {\n");
    buf_bytes(out, b"    let mut abcd = vld1q_u32(state, 0);\n");
    buf_bytes(out, b"    let mut efgh = vld1q_u32(state, 4);\n");
    buf_bytes(out, b"    let (abcd0, efgh0) = (abcd, efgh);\n");
    buf_bytes(out, b"    let mut w0 = words(block, 0);\n");
    buf_bytes(out, b"    let mut w1 = words(block, 16);\n");
    buf_bytes(out, b"    let mut w2 = words(block, 32);\n");
    buf_bytes(out, b"    let mut w3 = words(block, 48);\n");
    buf_bytes(out, b"    for g in 0..16 {\n");
    buf_bytes(out, b"        let wk = vaddq_u32(w0, vld1q_u32(&K, 4 * g));\n");
    buf_bytes(out, b"        let next = if g < 12 { vsha256su1q_u32(vsha256su0q_u32(w0, w1), w2, w3) } else { w0 };\n");
    buf_bytes(out, b"        let old = abcd;\n");
    buf_bytes(out, b"        abcd = vsha256hq_u32(abcd, efgh, wk);\n");
    buf_bytes(out, b"        efgh = vsha256h2q_u32(efgh, old, wk);\n");
    buf_bytes(out, b"        w0 = w1;\n");
    buf_bytes(out, b"        w1 = w2;\n");
    buf_bytes(out, b"        w2 = w3;\n");
    buf_bytes(out, b"        w3 = next;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    vst1q_u32(state, 0, vaddq_u32(abcd, abcd0));\n");
    buf_bytes(out, b"    vst1q_u32(state, 4, vaddq_u32(efgh, efgh0));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let mut state: [u32; 8] = [\n");
    buf_bytes(out, b"        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,\n");
    buf_bytes(out, b"    ];\n");
    buf_bytes(out, b"    // \"abc\" padded to one block: 0x80, zeros, its length in bits at the end.\n");
    buf_bytes(out, b"    let mut block: [u8; 64] = [0; 64];\n");
    buf_bytes(out, b"    block[0] = b'a';\n");
    buf_bytes(out, b"    block[1] = b'b';\n");
    buf_bytes(out, b"    block[2] = b'c';\n");
    buf_bytes(out, b"    block[3] = 0x80;\n");
    buf_bytes(out, b"    block[63] = 24;\n");
    buf_bytes(out, b"    if !detect(\"sha2\") {\n");
    buf_bytes(out, b"        println(\"no sha2 on this CPU: use a portable SHA-256\");\n");
    buf_bytes(out, b"        return;\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    compress(&mut state, &block);\n");
    buf_bytes(out, b"    for k in 0..8 {\n");
    buf_bytes(out, b"        print(\"{:08x}\", state[k]);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"x86-64's `_mm_sha256rnds2_epu32` does two rounds and wants the state as\n");
    buf_bytes(out, b"`abef`/`cdgh`: `query arch --equiv vsha256hq_u32`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Errors\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| code | what | fix |\n");
    buf_bytes(out, b"|---|---|---|\n");
    buf_bytes(out, b"| `arch.feature` | a call needs a feature the point does not know | the `try:` guard with a fallback, `-C target-feature=+f`, or `#[multiversion]` |\n");
    buf_bytes(out, b"| `arch.declared` | a `#[target_feature]` smaller than its body's needs | add the feature (the `try:` edit) |\n");
    buf_bytes(out, b"| `arch.const_arg` | an immediate not constant, or out of range | a literal in range (`query show NAME`) |\n");
    buf_bytes(out, b"| `arch.rust_form` | `f::<3>(v)`, `is_x86_feature_detected!` | `f(v, 3)`, `std::arch::detect(\"f\")` |\n");
    buf_bytes(out, b"| `arch.raw_form` | a pointer to a safe memory form | `vld1q_u8(s, i)`, or `raw::` in `unsafe` |\n");
    buf_bytes(out, b"| `arch.fn_pointer` | a `fn` value of a function that needs features | call it under a guard, a closure, or `#[multiversion]` |\n");
    buf_bytes(out, b"| `arch.multiversion` | a call one version cannot make | put it under `has(\"f\")` |\n");
    buf_bytes(out, b"| `arch.feature_name`, `arch.feature_ambiguous` | an unknown name; `aes` of the other architecture | the suggested name; `aarch64.aes` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec explain arch` lists them; `explain arch.feature` gives one in\n");
    buf_bytes(out, b"full.\n");
}
