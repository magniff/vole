// Generated by compiler/guide/embed.sh from compiler/guide/c-interop.md (do
// not edit): the guide's topic 'c-interop'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# C interop\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"C compatibility is asked for explicitly and then exact. Vole's own\n");
    buf_bytes(out, b"types and functions have no fixed layout or convention; `#[repr(C)]`\n");
    buf_bytes(out, b"types and `extern \"C\"` functions have C's, for the target.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Calling C\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Import a header (its names are reached through the `as` name; every\n");
    buf_bytes(out, b"header of a program shares one C module, so one name serves them all),\n");
    buf_bytes(out, b"or declare the functions yourself. Every call is `unsafe`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"import \"stdio.h\" as c;\n");
    buf_bytes(out, b"import \"string.h\" as c;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"extern \"C\" {\n");
    buf_bytes(out, b"    fn getenv(name: *const u8) -> *const u8;   // declared by hand\n");
    buf_bytes(out, b"    #[link_name = \"strlen\"]\n");
    buf_bytes(out, b"    fn c_length(s: *const u8) -> usize;        // another name for a C symbol\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let s = c\"vole\";\n");
    buf_bytes(out, b"    let n = unsafe { c::strlen(s) } as i64;\n");
    buf_bytes(out, b"    let home = unsafe { getenv(c\"NO_SUCH_VARIABLE_HERE\") };\n");
    buf_bytes(out, b"    let bytes = unsafe { std::slice::from_raw_parts(s, c::strlen(s) as usize) }; // a C string as a slice\n");
    buf_bytes(out, b"    println(\"{:?}\", std::str::from_utf8(bytes));\n");
    buf_bytes(out, b"    unsafe {\n");
    buf_bytes(out, b"        c::printf(c\"%s has %ld bytes, %d %.3f\\n\", s, n, home.is_null(), 1.0 / 8.0);\n");
    buf_bytes(out, b"        c::printf(c\"%lu\\n\", c_length(c\"abc\"));\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"Ok(\"vole\")\n");
    buf_bytes(out, b"vole has 4 bytes, 1 0.125\n");
    buf_bytes(out, b"3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `c\"...\"` is a NUL-terminated `*const u8`, for C. A `&str` or `&[u8]`\n");
    buf_bytes(out, b"  is not terminated: pass `s.as_ptr()` and `s.len()` to C (`write(1,\n");
    buf_bytes(out, b"  s.as_ptr(), s.len() as u64)`), or copy into a buffer with a 0 at the\n");
    buf_bytes(out, b"  end.\n");
    buf_bytes(out, b"- A C string to a slice: `unsafe { std::slice::from_raw_parts(p,\n");
    buf_bytes(out, b"  c::strlen(p) as usize) }`, then `std::str::from_utf8` for text.\n");
    buf_bytes(out, b"- Variadic functions (`printf`) take any FFI-safe value; `%ld` for `i64`,\n");
    buf_bytes(out, b"  `%d` for `i32` and `bool`, `%f` for `f64` (and `f32`), `%s` for a\n");
    buf_bytes(out, b"  `*const u8`.\n");
    buf_bytes(out, b"- Types from C: `int` is `i32`, `long` is `i64`, `char *`, `const char\n");
    buf_bytes(out, b"  *` and `void *` are pointers to `u8` (the checker does not tell\n");
    buf_bytes(out, b"  `*const u8` from `*mut u8` yet, and prints both as `*u8`), `size_t` is\n");
    buf_bytes(out, b"  `u64` (`n as usize` where vole wants a length), structs are\n");
    buf_bytes(out, b"  `#[repr(C)]` structs, enums\n");
    buf_bytes(out, b"  are integer types with constants. `volec --emit-imports prog.vl\n");
    buf_bytes(out, b"  -o decls.vl` shows what a program's headers declare.\n");
    buf_bytes(out, b"- What headers cannot give: function-like macros, `static inline`\n");
    buf_bytes(out, b"  functions, `errno` (call `__error()` on macOS, `__errno_location()` on\n");
    buf_bytes(out, b"  Linux).\n");
    buf_bytes(out, b"- `-I DIR` adds an include directory (`volec check -I DIR` too, 0.25.2;\n");
    buf_bytes(out, b"  the language server's `vole.includePaths`); `import \"./mine.h\" as c;`\n");
    buf_bytes(out, b"  is relative to the importing file.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Layout: #[repr(C)]\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::mem::size_of;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[repr(C)]\n");
    buf_bytes(out, b"struct Header { tag: u8, size: u32 }          // C's field order and padding\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[repr(C, packed)]\n");
    buf_bytes(out, b"struct Packed { tag: u8, size: u32 }          // no padding\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[repr(C)]\n");
    buf_bytes(out, b"union Bits { i: u32, f: f32 }                 // reading a field is unsafe\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[repr(u8)]\n");
    buf_bytes(out, b"enum Kind { A = 1, B = 2 }                    // an enum with a u8 tag\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let b = Bits { f: 1.0 };\n");
    buf_bytes(out, b"    println(\"{} {}\", size_of::<Header>() + size_of::<Packed>() + size_of::<Kind>(), unsafe { b.i });\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"14 1065353216\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Also `#[repr(C, align(N))]` and `#[repr(C, packed(N))]`. A `#[repr(C)]`\n");
    buf_bytes(out, b"enum with fields is C's struct of a tag and a union. Types in `extern\n");
    buf_bytes(out, b"\"C\"` signatures must be FFI-safe: numbers, `bool`, pointers, `extern\n");
    buf_bytes(out, b"\"C\" fn` pointers, `#[repr(C)]` types. Slices, tuples, plain structs and\n");
    buf_bytes(out, b"plain `fn` pointers are rejected with a hint. A C function that writes\n");
    buf_bytes(out, b"through a pointer takes `p: *mut T`, and the call passes `&mut x`,\n");
    buf_bytes(out, b"which converts (a mutable borrow of `x` for the call).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## C calling vole\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`extern \"C\" fn` defines a function with C's convention and an unmangled\n");
    buf_bytes(out, b"symbol; only such a function is a C callback (a plain `fn` is another\n");
    buf_bytes(out, b"type).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"import \"stdlib.h\" as c;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"extern \"C\" fn by_value(a: *const u8, b: *const u8) -> i32 {\n");
    buf_bytes(out, b"    let x = unsafe { *(a as *const i32) };\n");
    buf_bytes(out, b"    let y = unsafe { *(b as *const i32) };\n");
    buf_bytes(out, b"    if x < y { -1 } else if x > y { 1 } else { 0 }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let mut a: [i32; 5] = [4, 2, 5, 1, 3];\n");
    buf_bytes(out, b"    unsafe { c::qsort(a.as_mut_ptr() as *mut u8, 5, 4, by_value); }\n");
    buf_bytes(out, b"    for x in a { print(\"{x}\"); }\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"12345\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`extern \"C\" static mut COUNT: i64 = 0;` defines a static C can use.\n");
    buf_bytes(out, b"`volec --emit-header prog.vl -o prog.h` writes the C header of a\n");
    buf_bytes(out, b"program's `extern \"C\"` functions and statics, with the `#[repr(C)]`\n");
    buf_bytes(out, b"types they use.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Building with C\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec prog.vl -o prog` links with `cc` (`$VOLE_CC` instead).\n");
    buf_bytes(out, b"C files, objects (`.o`), archives (`.a`), shared libraries, `-l NAME`\n");
    buf_bytes(out, b"and `-L DIR` on its command line go to that link, in their order; a C\n");
    buf_bytes(out, b"file is compiled by `cc` at the program's `-O` level, with its `-I`\n");
    buf_bytes(out, b"directories. libm is linked when the program calls one of its functions\n");
    buf_bytes(out, b"(Linux has it apart from libc):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec prog.vl helper.c -L vendor/lib -l png -o prog\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`-o prog.o` makes an object instead, for a build that links it itself\n");
    buf_bytes(out, b"(`cc prog.o helper.o -o prog -lm`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An extern block can say what it links (0.25): `#[link(lib = \"objc\")]`\n");
    buf_bytes(out, b"(`-lobjc`), `#[link(framework = \"Metal\")]` (macOS; Linux leaves it\n");
    buf_bytes(out, b"out), or Rust's `#[link(name = \"objc\")]` and `#[link(name = \"Metal\",\n");
    buf_bytes(out, b"kind = \"framework\")]`, several in one attribute or in several, before\n");
    buf_bytes(out, b"`extern \"C\"`. A program links them when it calls a function of the\n");
    buf_bytes(out, b"block or uses one of its statics, so std::gpu, std::objc and\n");
    buf_bytes(out, b"std::window bring libobjc and their frameworks, and a program without\n");
    buf_bytes(out, b"them links nothing more (keep the C library's functions in a block of\n");
    buf_bytes(out, b"their own). On the command line, `-framework NAME` adds a framework.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[link(lib = \"m\")]\n");
    buf_bytes(out, b"extern \"C\" {\n");
    buf_bytes(out, b"    fn ilogb(x: f64) -> i32;\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    println(\"{}\", unsafe { ilogb(8.0) });\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A program with nothing to link but itself skips `cc`: the system's\n");
    buf_bytes(out, b"linker runs directly, with the command `cc -###` gave the first time\n");
    buf_bytes(out, b"(kept in the user's cache directory; `$VOLE_LINK_CACHE` names another,\n");
    buf_bytes(out, b"`off` none). The executable is the same. `--linker=cc` (or\n");
    buf_bytes(out, b"`$VOLE_LINKER=cc`) links through `cc` anyway. On AArch64 macOS the\n");
    buf_bytes(out, b"compiler links such a program itself, without `ld` (a few ms), when it\n");
    buf_bytes(out, b"needs nothing but libSystem; `--linker=system` runs `ld` instead.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Reading stdin: std has `std::io::stdin()` (`volec guide io`); from C, `getchar()` from `stdio.h`, or `read(0, buf, n)` from\n");
    buf_bytes(out, b"`unistd.h`, into a `Vec<u8, A>` or an array (not mixed with std's, which\n");
    buf_bytes(out, b"buffers):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"import \"stdio.h\" as c;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut line: Vec<u8, Gpa> = Vec::new_in(gpa);    // dropped (freed) at the end\n");
    buf_bytes(out, b"    loop {\n");
    buf_bytes(out, b"        let ch = unsafe { c::getchar() };\n");
    buf_bytes(out, b"        if ch < 0 || ch == '\\n' as i32 { break; }\n");
    buf_bytes(out, b"        line.push(ch as u8);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"read {} bytes\", line.len());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"read 0 bytes\n");
    buf_bytes(out, b"```\n");
}
