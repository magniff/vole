    buf_bytes(out, b"their comments, 140k bytes (to a file): `volec guide std#every-item`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"@STD-API@\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"@STD-API-DOC@\n");
