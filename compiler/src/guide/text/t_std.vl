    buf_bytes(out, b"v.len() -> i64                   Vec, Buf, HashMap, slices\n");
    buf_bytes(out, b"v.get(i: i64) -> T               checked, as v[i]; m.get(k) -> Option<V>\n");
    buf_bytes(out, b"b.push_str(s: [u8])\n");
