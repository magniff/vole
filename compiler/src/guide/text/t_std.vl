    buf_bytes(out, b"each), most used first. `v` is a `Vec`, `b` a `Buf`, `m` a `HashMap`,\n");
    buf_bytes(out, b"`sc` a `Scanner`, `o` an `Option` or `Result`. All of these are in the\n");
    buf_bytes(out, b"prelude: no `use` line.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"v.push(x: T)                     Vec; Buf: b.push(byte: u8)\n");
    buf_bytes(out, b"v.as_slice() -> [T]              Vec; Buf: -> [u8]\n");
