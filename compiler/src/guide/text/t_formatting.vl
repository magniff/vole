// Generated by compiler/guide/embed.sh from compiler/guide/formatting.md (do
// not edit): the guide's topic 'formatting'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Formatting and derive\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Format strings, the `Display` and `Debug` traits, the `print` family,\n");
    buf_bytes(out, b"and `#[derive]`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Format strings\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Rust's `format!` family without the `!` (vole has no macros: `println!`\n");
    buf_bytes(out, b"is an error naming `println`): a literal that is the first argument of\n");
    buf_bytes(out, b"`print`, `println`, `eprint`, `eprintln` (stderr), `format_in(..,\n");
    buf_bytes(out, b"gpa)` (a new `String<A>` on allocator `gpa`, the allocator last),\n");
    buf_bytes(out, b"`format_args`, `write(w, ..)` and `writeln` (into a `fmt::Write`, a\n");
    buf_bytes(out, b"Formatter inside a Display impl), `panic` or `assert`'s message is a\n");
    buf_bytes(out, b"format string, its arguments after it: `println(\"{} has {n:>4}\",\n");
    buf_bytes(out, b"p.name)`. The grammar and the output are Rust's std::fmt.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `{}` takes the next argument, `{0}` argument 0, `{name}` a named\n");
    buf_bytes(out, b"  argument (`name = expr`) or a local, a parameter, a `const` or a\n");
    buf_bytes(out, b"  `static` in scope; `{{` and `}}` are braces. An expression in a hole,\n");
    buf_bytes(out, b"  `{p.x}`, is `format.expr-hole`: write `{}` and pass `p.x` (its `try:`\n");
    buf_bytes(out, b"  does).\n");
    buf_bytes(out, b"- Each argument is evaluated once, left to right, before anything is\n");
    buf_bytes(out, b"  written; one no hole takes, or a hole with no argument, is\n");
    buf_bytes(out, b"  `format.args`.\n");
    buf_bytes(out, b"- Floats print the shortest text that reads back as the same value\n");
    buf_bytes(out, b"  (`2.5`, `0.1`), byte for byte as Rust prints them (#numbers).\n");
    buf_bytes(out, b"- Passed straight to the printing functions, a format string is written\n");
    buf_bytes(out, b"  in place: no allocation, at every `-O` level.\n");
    buf_bytes(out, b"- `format_args(\"..\", args)` is the formatted text as a value, for a\n");
    buf_bytes(out, b"  function of your own taking `T: Display`.\n");
    buf_bytes(out, b"- MVS's f-strings, `f\"{p.x + 1}\"`, are `syntax.fstring`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"### The spec\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`{name:spec}`, `spec = [[fill]align][+][#][0][width][.precision][type]`:\n");
    buf_bytes(out, b"`<` `^` `>` align (numbers go right by default, text left) with any fill\n");
    buf_bytes(out, b"character (`{s:*^9}`), `+` signs a number, `#` writes `0x`/`0o`/`0b`\n");
    buf_bytes(out, b"(and `0` pads after them), `0` pads a number with zeros after its sign,\n");
    buf_bytes(out, b"the width and the precision are digits (precision also `*`: the next\n");
    buf_bytes(out, b"argument), `.N` gives a float N decimals and cuts text to N; the type is\n");
    buf_bytes(out, b"`?` Debug (`x?`, `X?` with hex numbers; `#?` over several lines),\n");
    buf_bytes(out, b"`x`/`X` hex, `o` octal, `b` binary, `e`/`E` an exponent (`1.5e3`).\n");
    buf_bytes(out, b"A width from an argument (`w$`, `1$`) is not read yet.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn next(c: &mut i64) -> i64 {\n");
    buf_bytes(out, b"    *c += 1;\n");
    buf_bytes(out, b"    *c\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let n = 42;\n");
    buf_bytes(out, b"    let s = \"hi\";\n");
    buf_bytes(out, b"    println(\"[{n:^8}] [{n:+}] [{n:#x}] [{n:o}] [{n:#010x}] [{s:*^7}]\");\n");
    buf_bytes(out, b"    println(\"[{:>5}] [{:.*}] [{0:?}] [{:e}]\", 9, 2, 1.25, 1500.0);\n");
    buf_bytes(out, b"    let name = \"vole\";\n");
    buf_bytes(out, b"    let x = 2.5;\n");
    buf_bytes(out, b"    println(\"{name} has {n} and {x}\");\n");
    buf_bytes(out, b"    println(\"[{n:>6}] [{n:<6}] [{n:06}] [{n:x}] [{n:X}] [{n:b}]\");\n");
    buf_bytes(out, b"    println(\"[{name:>9}] [{x:.3}] [{}] {{braces}} {}\", 'A', n * 2 + 1);\n");
    buf_bytes(out, b"    let t = format_in(\"{n}-{}\", n + 1, gpa); // a String, dropped at the end\n");
    buf_bytes(out, b"    eprintln(\"to stderr: {}\", t);\n");
    buf_bytes(out, b"    let mut c = 0;\n");
    buf_bytes(out, b"    println(\"{} {}\", next(&mut c), next(&mut c)); // left to right: 1, then 2\n");
    buf_bytes(out, b"    println(\"{:#?}\", (1, \"a\"));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"[   42   ] [+42] [0x2a] [52] [0x0000002a] [**hi***]\n");
    buf_bytes(out, b"[    9] [1.25] [9] [1.5e3]\n");
    buf_bytes(out, b"vole has 42 and 2.5\n");
    buf_bytes(out, b"[    42] [42    ] [000042] [2a] [2A] [101010]\n");
    buf_bytes(out, b"[     vole] [2.500] [A] {braces} 85\n");
    buf_bytes(out, b"to stderr: 42-43\n");
    buf_bytes(out, b"1 2\n");
    buf_bytes(out, b"(\n");
    buf_bytes(out, b"    1,\n");
    buf_bytes(out, b"    \"a\",\n");
    buf_bytes(out, b")\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Printing writes through a static 4 KB buffer, one `write` per call, no\n");
    buf_bytes(out, b"heap.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Numbers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A float's `{}`, `{:?}`, `{:e}` and `{:E}` are Rust's text, byte for\n");
    buf_bytes(out, b"byte: the shortest digits that read back as the value (Schubfach), `{}`\n");
    buf_bytes(out, b"never with an exponent, `{:?}` with one below 1e-4 and from 1e16 on.\n");
    buf_bytes(out, b"`s.parse::<f64>()` reads text back as Rust's does (`-1.5e3`, `.5`,\n");
    buf_bytes(out, b"`inf`, `NaN`; no spaces; correctly rounded), and `to_bits`,\n");
    buf_bytes(out, b"`from_bits` give the IEEE bits; `i64::from_str_radix(s, 16)` reads an\n");
    buf_bytes(out, b"integer in another base. Text without an allocator: `guide\n");
    buf_bytes(out, b"text#numbers-as-text-without-an-allocator`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let x = \"0.1\".parse::<f64>().unwrap() + \"2e-1\".parse::<f64>().unwrap();\n");
    buf_bytes(out, b"    println(\"{x} {x:?} {x:e} {:?} {} {}\", 1e16, 1e-7, 0.1f32);\n");
    buf_bytes(out, b"    println(\"{:?} {} {:x}\", i64::from_str_radix(\"-ff\", 16), \"1,5\".parse::<f64>().is_err(), 1.5f64.to_bits());\n");
    buf_bytes(out, b"    println(\"{} {:?} {}\", f64::from_bits(0x3ff8000000000000), \"inf\".parse::<f64>(), b'A' as char);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"0.30000000000000004 0.30000000000000004 3.0000000000000004e-1 1e16 0.0000001 0.1\n");
    buf_bytes(out, b"Ok(-255) true 3ff8000000000000\n");
    buf_bytes(out, b"1.5 Ok(inf) A\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Display and Debug\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Rust's traits, `std::fmt::Display` and `std::fmt::Debug`:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"trait Display { fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result; }\n");
    buf_bytes(out, b"trait Debug { fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result; }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Write `impl Display for T` (no derive: the text is yours) with `write(f,\n");
    buf_bytes(out, b"\"..\", args)`, or `f.write_str(s)`. Display is in std for the numbers,\n");
    buf_bytes(out, b"`char`, `str`, `String` and std's errors; Debug for those (text quoted\n");
    buf_bytes(out, b"and escaped: `\"a\\n\"`), slices, arrays, `Vec<T, A>`, tuples, `Option`,\n");
    buf_bytes(out, b"`Result` and `HashMap` (`[1, 2]`, `Some(5)`, `{1: 2}`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::fmt;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[derive(Debug, Clone, Copy)]\n");
    buf_bytes(out, b"struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[derive(Debug)]\n");
    buf_bytes(out, b"enum Shape { Circle(i64), Rect(Point, Point), Line { from: Point, len: i64 }, Empty }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl fmt::Display for Point {\n");
    buf_bytes(out, b"    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n");
    buf_bytes(out, b"        write(f, \"({}, {})\", self.x, self.y)\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let p = Point { x: 1, y: 2 };\n");
    buf_bytes(out, b"    let mut q = p.clone();\n");
    buf_bytes(out, b"    q.x = 5;\n");
    buf_bytes(out, b"    println(\"{p} {q:?} [{p:>8}]\");\n");
    buf_bytes(out, b"    let shapes = [Shape::Circle(3), Shape::Rect(p, q), Shape::Line { from: p, len: 4 }, Shape::Empty];\n");
    buf_bytes(out, b"    for s in &shapes { println(\"{s:?}\"); }\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.push(1);\n");
    buf_bytes(out, b"    v.push(2);\n");
    buf_bytes(out, b"    println(\"{v:?} {:?} {:?} {:?}\", v.last(), \"hi\\n\", &v[..1]);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"(1, 2) Point { x: 5, y: 2 } [(1, 2)]\n");
    buf_bytes(out, b"Circle(3)\n");
    buf_bytes(out, b"Rect(Point { x: 1, y: 2 }, Point { x: 5, y: 2 })\n");
    buf_bytes(out, b"Line { from: Point { x: 1, y: 2 }, len: 4 }\n");
    buf_bytes(out, b"Empty\n");
    buf_bytes(out, b"[1, 2] Some(2) \"hi\\n\" [1]\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A `write(f, ..)` in `fmt` ignores the caller's width (`{p:>8}` above),\n");
    buf_bytes(out, b"as in Rust; `f.pad(s)` honours it.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## derive\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`#[derive(..)]` before a struct or an enum writes Rust's impls:\n");
    buf_bytes(out, b"`Clone`, `Copy`, `PartialEq`, `Eq`, `PartialOrd`, `Ord` (field by field,\n");
    buf_bytes(out, b"in declaration order; an enum by variant order, then payload), `Hash`,\n");
    buf_bytes(out, b"`Debug` (`P { x: 1, y: 2 }`, `Circle(3)`, `Empty`) and `Default`. On a\n");
    buf_bytes(out, b"generic type each parameter gets the trait as a bound: `#[derive(Ord)]\n");
    buf_bytes(out, b"struct P<T>` is `impl<T: Ord> Ord for P<T>`. Display has no derive. A\n");
    buf_bytes(out, b"derived trait and a hand-written impl of it clash: remove one.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::collections::HashMap;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Default)]\n");
    buf_bytes(out, b"struct Key { group: i64, id: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let mut keys = [Key { group: 2, id: 1 }, Key { group: 1, id: 9 }, Key { group: 1, id: 3 }];\n");
    buf_bytes(out, b"    keys.sort_unstable();                    // by group, then id\n");
    buf_bytes(out, b"    let mut m: HashMap<Key, i64, Gpa> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"    for k in keys { m.insert(k, k.id * 10); }\n");
    buf_bytes(out, b"    let wanted = Key { group: 2, id: 1 };\n");
    buf_bytes(out, b"    println(\"{:?} {:?} {:?} {}\", keys[0], m.get(&wanted), Key::default(), keys[1] < keys[2]);\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"Key { group: 1, id: 3 } Some(10) Key { group: 0, id: 0 } true\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`sort` of a slice or an array is stable and allocates its buffer:\n");
    buf_bytes(out, b"`a.sort_in(gpa)` (a Vec's `v.sort()` takes the Vec's allocator);\n");
    buf_bytes(out, b"`sort_unstable` allocates nothing.\n");
}
