// Generated by compiler/guide/embed.sh from compiler/guide/formatting.md (do
// not edit): the guide's topic 'formatting'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Formatting and derive (0.15)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Format strings, the `Display` and `Debug` traits, the generic `print`\n");
    buf_bytes(out, b"family, and `#[derive]`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Format strings\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"(0.26.2) Rust's `format!` family without the `!`: a plain literal that is\n");
    buf_bytes(out, b"the first argument of `print`, `println`, `eprint`, `eprintln` (stderr),\n");
    buf_bytes(out, b"`format_in(.., gpa)` (a new `String<A>` on allocator `gpa`, the allocator last), `format_args`,\n");
    buf_bytes(out, b"`b.push_fmt(..)` (appends to a `Buf` or a `String`), `f.write(..)`\n");
    buf_bytes(out, b"(inside a Display impl), `panic`, `assert`'s message or a contract's\n");
    buf_bytes(out, b"`else` is a format string, its arguments after it:\n");
    buf_bytes(out, b"`println(\"{} has {n:>4}\", p.name)`. The grammar and the output are\n");
    buf_bytes(out, b"Rust's std::fmt, byte for byte (`guide formatting#the-spec`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `{}` takes the next argument, `{0}` argument 0, `{name}` a named\n");
    buf_bytes(out, b"  argument (`name = expr`) or a local, a parameter, a `const` or a\n");
    buf_bytes(out, b"  `static` in scope; `{{` and `}}` are braces. An expression in a hole,\n");
    buf_bytes(out, b"  `{p.x}`, is `format.expr-hole`: write `{}` and pass `p.x` (its `try:`\n");
    buf_bytes(out, b"  does).\n");
    buf_bytes(out, b"- Each argument is evaluated once, left to right, before anything is\n");
    buf_bytes(out, b"  written; one no hole takes, or a hole with no argument, is\n");
    buf_bytes(out, b"  `format.args`.\n");
    buf_bytes(out, b"- A first argument that is no literal is a value: `println(s)` prints\n");
    buf_bytes(out, b"  `s`, braces and all.\n");
    buf_bytes(out, b"- `format_args(\"..\", args)` is the formatted text as a value (an\n");
    buf_bytes(out, b"  `std::Interp`, Rust's `format_args!`), for a function of your own\n");
    buf_bytes(out, b"  taking `T: Display`; it holds copies of the arguments, so it can be\n");
    buf_bytes(out, b"  stored and printed later.\n");
    buf_bytes(out, b"- Floats print the shortest text that reads back as the same value\n");
    buf_bytes(out, b"  (`2.5`, `0.1`), byte for byte as Rust prints them (#numbers).\n");
    buf_bytes(out, b"- Passed straight to the printing functions, a format string is written\n");
    buf_bytes(out, b"  in place: no closure, no `Interp`, no copy of the function, at every\n");
    buf_bytes(out, b"  `-O` level. Through a function of your own taking `T: Display`, each\n");
    buf_bytes(out, b"  `format_args` is a new copy of that function (and of what it calls).\n");
    buf_bytes(out, b"- `panic(\"bad {x}\")` formats into 256 bytes on the stack (a piece that\n");
    buf_bytes(out, b"  does not fit is left out), so a `#[no_alloc]` function may panic with\n");
    buf_bytes(out, b"  one.\n");
    buf_bytes(out, b"- f-strings, `f\"{p.x + 1}\"` (0.15 to 0.26.2), are removed: error\n");
    buf_bytes(out, b"  `syntax.fstring` (0.26.3), once per file. `volec fix --only fstring\n");
    buf_bytes(out, b"  --keep-braces FILE` rewrites them as format strings, once: a name hole\n");
    buf_bytes(out, b"  stays, an expression becomes `{}` and an argument. (Without\n");
    buf_bytes(out, b"  `--keep-braces` it also doubles the braces of a plain literal, for\n");
    buf_bytes(out, b"  code from before 0.26.2, which printed them as they are.)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"### The spec\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`{name:spec}`, `spec = [[fill]align][+][#][0][width][.precision][type]`:\n");
    buf_bytes(out, b"`<` `^` `>` align (numbers go right by default, text left) with any fill\n");
    buf_bytes(out, b"byte (`{s:*^9}`), `+` signs a number, `#` writes `0x`/`0o`/`0b` (and `0`\n");
    buf_bytes(out, b"pads after them), `0` pads a number with zeros after its sign, the width\n");
    buf_bytes(out, b"and the precision are digits, `N$`, `name$` (precision also `*`: the\n");
    buf_bytes(out, b"next argument), `.N` gives a float N decimals and cuts text to N; the\n");
    buf_bytes(out, b"type is `?` Debug (`x?`, `X?` with hex numbers), `x`/`X` hex, `o` octal,\n");
    buf_bytes(out, b"`b` binary, `e`/`E` an exponent (`1.5e3`), `p` a pointer as `0x..`, and\n");
    buf_bytes(out, b"vole's `c`, a `u8` as its byte (a `u8` is a number otherwise). `{:#?}`,\n");
    buf_bytes(out, b"Debug over several lines, is not in this release.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let n = 42;\n");
    buf_bytes(out, b"    let s = \"hi\";\n");
    buf_bytes(out, b"    println(\"[{n:^8}] [{n:+}] [{n:#x}] [{n:o}] [{n:#010x}] [{s:*^7}]\");\n");
    buf_bytes(out, b"    println(\"[{:>w$}] [{:.*}] [{0:?}] [{:e}]\", 9, 2, 1.25, 1500.0, w = 5);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"[   42   ] [+42] [0x2a] [52] [0x0000002a] [**hi***]\n");
    buf_bytes(out, b"[    9] [1.25] [9] [1.5e3]\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let name = \"vole\";\n");
    buf_bytes(out, b"    let n = 42;\n");
    buf_bytes(out, b"    let x = 2.5;\n");
    buf_bytes(out, b"    println(\"{name} has {n} and {x}\");\n");
    buf_bytes(out, b"    println(\"[{n:>6}] [{n:<6}] [{n:06}] [{n:x}] [{n:X}] [{n:b}]\");\n");
    buf_bytes(out, b"    println(\"[{name:>9}] [{x:.3}] [{:c}] {{braces}} {}\", 'A', n * 2 + 1);\n");
    buf_bytes(out, b"    let s = format_in(\"{n}-{}\", n + 1, gpa); // a String, dropped at the end\n");
    buf_bytes(out, b"    eprintln(\"to stderr: {}\", s.as_slice());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"vole has 42 and 2.5\n");
    buf_bytes(out, b"[    42] [42    ] [000042] [2a] [2A] [101010]\n");
    buf_bytes(out, b"[     vole] [2.500] [A] {braces} 85\n");
    buf_bytes(out, b"to stderr: 42-43\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn next(c: inout i64) -> i64 {\n");
    buf_bytes(out, b"    c += 1;\n");
    buf_bytes(out, b"    c\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var c = 0;\n");
    buf_bytes(out, b"    let line = format_args(\"{} {}\", next(&c), next(&c)); // evaluated here: 1, then 2\n");
    buf_bytes(out, b"    c = 100;\n");
    buf_bytes(out, b"    println(line);\n");
    buf_bytes(out, b"    println(line);\n");
    buf_bytes(out, b"    std::print_int(c);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"1 2\n");
    buf_bytes(out, b"1 2\n");
    buf_bytes(out, b"100\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Printing writes through a static 4 KB buffer, one `write` per call, no\n");
    buf_bytes(out, b"heap. Rust's `println!(\"{}\", x)` is `println(\"{}\", x)`, `format!` is\n");
    buf_bytes(out, b"`format_in(\"...\", args, gpa)`; there are no macros.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Numbers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"(0.20) A float's `{}`, `{:?}`, `{:e}` and `{:E}` are Rust's text, byte for\n");
    buf_bytes(out, b"byte: the shortest digits that read back as the value (Schubfach), `{}`\n");
    buf_bytes(out, b"never with an exponent, `{:?}` with one below 1e-4 and from 1e16 on.\n");
    buf_bytes(out, b"`std::num` reads text back, as Rust's `s.parse()` does, and writes it\n");
    buf_bytes(out, b"without a Fmt:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| call | is |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `parse_f64(s) -> Result<f64, ParseFloatError>`, `parse_f32` | Rust's `f64::from_str`: `-1.5e3`, `.5`, `inf`, `NaN`; no spaces; correctly rounded |\n");
    buf_bytes(out, b"| `parse_i64_radix(s, 16) -> Result<i64, ParseIntError>`, `parse_u64_radix` | Rust's `from_str_radix` (radix 2 to 36) |\n");
    buf_bytes(out, b"| `write_f64(v, FloatFmt::Debug, &out) -> i64`, `write_f32` | the text into `out` (an `inout [u8]`) (`FLOAT_TEXT_MAX` bytes always fit): its length |\n");
    buf_bytes(out, b"| `fmt_u64(v, &out) -> i64`, `fmt_i64` | the digits at the end of a `[u8; 20]`: where they start |\n");
    buf_bytes(out, b"| `fmt_f64(v, decimals, &out) -> i64` (0.25.4) | `{v:.N}`'s text at the end of a `[u8; 32]`, no allocation: where it starts (`guide text#numbers-as-text-without-an-allocator`) |\n");
    buf_bytes(out, b"| `f64_to_bits(v)`, `f64_from_bits(u)`, `f32_...` | the IEEE bits (Rust's `to_bits`) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::num::{FloatFmt, parse_f64, parse_i64_radix, write_f64};\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let x = parse_f64(\"0.1\").unwrap() + parse_f64(\"2e-1\").unwrap();\n");
    buf_bytes(out, b"    println(\"{x} {x:?} {x:e} {:?} {} {}\", 1e16, 1e-7, 0.1f32);\n");
    buf_bytes(out, b"    var out: [u8; 32] = [0; 32];\n");
    buf_bytes(out, b"    let n = write_f64(1234.5, FloatFmt::LowerExp, &out[..]);\n");
    buf_bytes(out, b"    println(out[0..n]);\n");
    buf_bytes(out, b"    println(\"{:?} {}\", parse_i64_radix(\"-ff\", 16), parse_f64(\"1,5\").is_err());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"0.30000000000000004 0.30000000000000004 3.0000000000000004e-1 1e16 0.0000001 0.1\n");
    buf_bytes(out, b"1.2345e3\n");
    buf_bytes(out, b"Ok(-255) true\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Display and Debug\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```text\n");
    buf_bytes(out, b"trait Display { fn fmt(self, f: inout Fmt); }\n");
    buf_bytes(out, b"trait Debug { fn fmt_debug(self, f: inout Fmt); }\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Write `impl Display for T` (no derive: the text is yours) with the\n");
    buf_bytes(out, b"methods of `std::Fmt`: `f.str(s)` (a `[u8]`), `f.byte(b)`, `f.write(x)`\n");
    buf_bytes(out, b"(any Display value, `format_args(..)` too), `f.display(x)`, `f.debug(x)`.\n");
    buf_bytes(out, b"`self` is read (let), `f` is changed (inout); there is no result to\n");
    buf_bytes(out, b"return. Display is in std for the numbers, `[u8]` and the\n");
    buf_bytes(out, b"error enums; Debug for those (a `[u8]` quoted and\n");
    buf_bytes(out, b"escaped: `\"a\\n\"`), `Vec<T, A>`, `Option`, `Result` and `HashMap` (`[1, 2]`,\n");
    buf_bytes(out, b"`Some(5)`, `{1: 2}`). `{s:?}` of a slice `[T]` whose T has Debug\n");
    buf_bytes(out, b"writes it as a Vec's, `[1, 2]` (0.25.3); the slice has no Debug impl of\n");
    buf_bytes(out, b"its own (it would clash with `[u8]`'s), so a Debug impl writes one with\n");
    buf_bytes(out, b"`std::debug_list(f, s)`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[derive(Debug, Clone)]\n");
    buf_bytes(out, b"struct Point { x: i64, y: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[derive(Debug)]\n");
    buf_bytes(out, b"enum Shape { Circle(i64), Rect(Point, Point), Line { from: Point, len: i64 }, Empty }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Display for Point {\n");
    buf_bytes(out, b"    fn fmt(self, f: inout Fmt) {\n");
    buf_bytes(out, b"        f.write(\"({}, {})\", self.x, self.y);\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let p = Point { x: 1, y: 2 };\n");
    buf_bytes(out, b"    var q = p.clone();\n");
    buf_bytes(out, b"    q.x = 5;\n");
    buf_bytes(out, b"    println(\"{p} {q:?}\");\n");
    buf_bytes(out, b"    let shapes = [Shape::Circle(3), Shape::Rect(p, q), Shape::Line { from: p, len: 4 }, Shape::Empty];\n");
    buf_bytes(out, b"    for s in shapes { println(\"{s:?}\"); }\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    v.push(1);\n");
    buf_bytes(out, b"    v.push(2);\n");
    buf_bytes(out, b"    println(\"{v:?} {:?} {:?}\", v.last(), \"hi\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"(1, 2) Point { x: 5, y: 2 }\n");
    buf_bytes(out, b"Circle(3)\n");
    buf_bytes(out, b"Rect(Point { x: 1, y: 2 }, Point { x: 5, y: 2 })\n");
    buf_bytes(out, b"Line { from: Point { x: 1, y: 2 }, len: 4 }\n");
    buf_bytes(out, b"Empty\n");
    buf_bytes(out, b"[1, 2] Some(2) \"hi\"\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## derive\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`#[derive(Eq, Ord, Hash, Debug, Clone)]` before a struct or an enum\n");
    buf_bytes(out, b"(with `#[repr]` if it has one) writes the impls:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| trait | what it is |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `Eq` | the structural `==` it already has; an error if a field has no `==` |\n");
    buf_bytes(out, b"| `Ord` | field by field, in declaration order; an enum by variant order, then payload |\n");
    buf_bytes(out, b"| `Hash` | the fields' hashes mixed (`std::hash_mix`), an enum's variant first |\n");
    buf_bytes(out, b"| `Debug` | Rust's text: `P { x: 1, y: 2 }`, `Circle(3)`, `Empty` |\n");
    buf_bytes(out, b"| `Clone` | field by field (`std::clone_of`): a `Vec` field is copied deep |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"On a generic type each parameter gets the trait as a bound: `#[derive(Ord)]\n");
    buf_bytes(out, b"struct P<T>` is `impl<T: Ord> Ord for P<T>`. Display has no derive. A\n");
    buf_bytes(out, b"derived trait and a hand-written impl of it clash: remove one.\n");
    buf_bytes(out, b"`x.clone()` of a plain value (numbers, pointers, fieldless enums,\n");
    buf_bytes(out, b"tuples of them) is a copy. `Clone` is in std for `Vec` (deep), `Buf`,\n");
    buf_bytes(out, b"`HashMap`, `Option`, `Result` and the primitives.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[derive(Eq, Ord, Hash, Debug)]\n");
    buf_bytes(out, b"struct Key { group: i64, id: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    var keys = [Key { group: 2, id: 1 }, Key { group: 1, id: 9 }, Key { group: 1, id: 3 }];\n");
    buf_bytes(out, b"    sort(&keys[..]);                         // by group, then id\n");
    buf_bytes(out, b"    var m: HashMap<Key, i64, Gpa> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"    for k in keys { m.insert(k, k.id * 10); }\n");
    buf_bytes(out, b"    let wanted = Key { group: 2, id: 1 };\n");
    buf_bytes(out, b"    println(\"{:?} {:?}\", keys[0], m.get(wanted));\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"Key { group: 1, id: 3 } Some(10)\n");
    buf_bytes(out, b"```\n");
}
