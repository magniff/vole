use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# vole, the core (vole 0.28)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Vole is a compiled systems language with Rust's surface: its syntax,\n");
    buf_bytes(out, b"ownership (a value has one owner, moves or is copied, and is dropped at\n");
    buf_bytes(out, b"the end of its scope), references (`&T`, `&mut T`) checked by a borrow\n");
    buf_bytes(out, b"checker, traits, generics and std's names. It differs in a few places:\n");
    buf_bytes(out, b"no macros (`println(\"{x}\")` is a function), and nothing allocates\n");
    buf_bytes(out, b"without an allocator, which is written in the type (`Vec<i64, Gpa>`) and\n");
    buf_bytes(out, b"passed to what allocates (`Vec::new_in(gpa)`). Indexing is checked, and\n");
    buf_bytes(out, b"safe code has no undefined behaviour. This page is the core; the rest is\n");
    buf_bytes(out, b"on demand (the end). Every difference from Rust: `volec guide rust`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Build and run\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec run < in.txt                         # ./main.vl built (when changed), run\n");
    buf_bytes(out, b"volec main.vl -o prog                      # the executable; `mod x;` loads x.vl\n");
    buf_bytes(out, b"volec check main.vl                        # every error, one line each\n");
    buf_bytes(out, b"volec try '\"42\".parse::<i64>()'            # a snippet: its TYPE = VALUE\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The language in one program\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"import \"stdio.h\" as c;                 // a C header; its names under c::\n");
    buf_bytes(out, b"use std::fmt::Write;\n");
    buf_bytes(out, b"use std::collections::HashMap;         // std items by name (never *)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl P {\n");
    buf_bytes(out, b"    fn bump(&mut self) { self.x += 1; }    // &mut self: changes the caller's P\n");
    buf_bytes(out, b"    fn get(&self) -> i64 { self.x }        // &self: reads it\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total(v: &Vec<i64, Gpa>) -> i64 { // &: reads, no copy\n");
    buf_bytes(out, b"    v.iter().sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn grow(v: &mut Vec<i64, Gpa>, x: i64) { // &mut: the caller writes grow(&mut v, x)\n");
    buf_bytes(out, b"    v.push(x);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn keep(all: &mut Vec<Vec<i64, Gpa>, Gpa>, v: Vec<i64, Gpa>) { // by value: keep takes v\n");
    buf_bytes(out, b"    all.push(v);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn first(s: &str) -> char { s.chars().next().unwrap() } // text is &str, UTF-8; 'a' is a char, b'a' a u8\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn odds(n: i64, gpa: Gpa) -> Vec<i64, Gpa> { // allocating takes an allocator\n");
    buf_bytes(out, b"    (0..n).filter(|i| i % 2 == 1).collect_in(gpa)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { // gpa: the program's allocator; 0 = exit status\n");
    buf_bytes(out, b"    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); // let mut: mutable; let: not\n");
    buf_bytes(out, b"    v.push(5);\n");
    buf_bytes(out, b"    grow(&mut v, 2);\n");
    buf_bytes(out, b"    v[0] += 10;                        // checked (&v[1..2] a slice)\n");
    buf_bytes(out, b"    v.sort();\n");
    buf_bytes(out, b"    let mut p = P { x: 1 };\n");
    buf_bytes(out, b"    p.bump();                          // a receiver needs no &mut; p must be let mut\n");
    buf_bytes(out, b"    println(\"{} {v:?} {}\", p.get(), total(&v)); // formatted; total(&v) only reads\n");
    buf_bytes(out, b"    let mut all: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    keep(&mut all, v);                 // v moved into keep: dead from here\n");
    buf_bytes(out, b"    let s = \"hi\";\n");
    buf_bytes(out, b"    println(\"{}\", s.len());            // a usize (slices, Vec, String, HashMap)\n");
    buf_bytes(out, b"    let mut b = String::new_in(gpa);   // a text builder\n");
    buf_bytes(out, b"    let o = odds(7, gpa);\n");
    buf_bytes(out, b"    b.push_str(\"n=\");\n");
    buf_bytes(out, b"    write(&mut b, \"{}\", o.len()).unwrap();\n");
    buf_bytes(out, b"    println(\"{b}\");\n");
    buf_bytes(out, b"    if s == \"hi\" && !first(s).is_ascii_digit() { println(\"{}\", first(s)); }\n");
    buf_bytes(out, b"    let mut m: HashMap<&str, i64, Gpa> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"    *m.entry(\"k\").or_insert(0) += 1;\n");
    buf_bytes(out, b"    let z = 0;\n");
    buf_bytes(out, b"    println(\"{} {} {}\", !0u8, 250u8.wrapping_add(7), m[\"k\"]); // x / 0 panics\n");
    buf_bytes(out, b"    unsafe { c::puts(c\"from C\"); }     // C calls need unsafe; c\"..\": a NUL-terminated *const u8\n");
    buf_bytes(out, b"    if z != 0 { panic(\"z\"); }          // exit 101; unreachable()\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}                                      // all, o, b, m: dropped (freed) here\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2 [2, 15] 17\n");
    buf_bytes(out, b"2\n");
    buf_bytes(out, b"n=3\n");
    buf_bytes(out, b"h\n");
    buf_bytes(out, b"255 1 1\n");
    buf_bytes(out, b"from C\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Also: lengths and indices are `usize` (`v[i as usize]` of an `i64`);\n");
    buf_bytes(out, b"overflow panics at -O0, wraps at -O2 (`wrapping_add`: always);\n");
    buf_bytes(out, b"`a as i32` narrows, widening is implicit (`i64::from(a)` is Rust's\n");
    buf_bytes(out, b"form); `x?`, closures (`|x| x + k`, `move ||` to take what it captures),\n");
    buf_bytes(out, b"`impl Trait for T`, `T: Trait`, `#[derive(Clone, PartialEq, Debug)]`,\n");
    buf_bytes(out, b"`where T: Ord`, `x: impl Display`, lifetimes (`'a`) where a signature\n");
    buf_bytes(out, b"needs them, `Box<T, A>`; no `dyn`. A struct is moved unless it derives\n");
    buf_bytes(out, b"`Clone, Copy`. A reference is used as in Rust: `*x` reads or writes\n");
    buf_bytes(out, b"through it, a field or method needs no `*` (`p.x`, `v.len()`), and\n");
    buf_bytes(out, b"`match e` on an `e: &E` binds references (`E::A(n) => *n + 1`). The\n");
    buf_bytes(out, b"prelude (no `use`) is Rust's plus `Gpa`: `Option`, `Result`, `Vec`,\n");
    buf_bytes(out, b"`String`, `Box`, the common traits, and as functions Rust's macros:\n");
    buf_bytes(out, b"`print`, `println`, `eprintln`, `format_in`, `write`, `writeln`,\n");
    buf_bytes(out, b"`panic`, `assert`, `assert_eq`, `unreachable`, `todo`. The rest of std\n");
    buf_bytes(out, b"is `use std::...` (`std::collections::HashMap`); `use crate::lexer::Tok;`\n");
    buf_bytes(out, b"reaches the program's module `lexer`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## std: what programs use most\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::collections::HashMap;\n");
    buf_bytes(out, b"use std::io;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Item<'a> { name: &'a str, qty: i64 }    // 'a: the name borrows the input\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let input = io::read_to_string_in(io::stdin(), gpa).unwrap(); // all of stdin, a String<Gpa>\n");
    buf_bytes(out, b"    let mut lines = input.lines();\n");
    buf_bytes(out, b"    let mut toks = lines.next().unwrap().split_whitespace();\n");
    buf_bytes(out, b"    let n: i64 = toks.next().unwrap().parse().unwrap(); // parse: a Result<i64, ParseIntError>\n");
    buf_bytes(out, b"    let mut items: Vec<Item, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    let mut seen: HashMap<&str, i64, Gpa> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"    for _ in 0..n {\n");
    buf_bytes(out, b"        let name = toks.next().unwrap();       // Option<&str>: a slice of input\n");
    buf_bytes(out, b"        let qty = toks.next().unwrap_or(\"\").parse().unwrap_or(0);\n");
    buf_bytes(out, b"        items.push(Item { name, qty });\n");
    buf_bytes(out, b"        seen.insert(name, qty);                // also contains_key(k), remove(k)\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    items.sort_by(|a, b| b.qty.cmp(&a.qty));   // a, b: &Item; an Ordering\n");
    buf_bytes(out, b"    for (i, it) in items.iter().enumerate() { print(\"{i}:{} \", it.name); }\n");
    buf_bytes(out, b"    let line = lines.next().unwrap_or(\"\").trim();\n");
    buf_bytes(out, b"    let total: i64 = line.split(',').map(|w| w.trim().parse::<i64>().unwrap_or(0)).sum();\n");
    buf_bytes(out, b"    match seen.get(\"pen\") {                    // Option<&i64>\n");
    buf_bytes(out, b"        Some(q) => println(\"pen={q} total={total}\"),\n");
    buf_bytes(out, b"        None => println(\"no pen\"),\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let text = format_in(\"{} {}\", items.len(), seen.len(), gpa); // a String<Gpa>\n");
    buf_bytes(out, b"    println(\"{text}\");                         // text, seen, items, input: dropped at the end\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```in\n");
    buf_bytes(out, b"3 pen 2 ink 5 cap 1\n");
    buf_bytes(out, b"1,2, 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"0:ink 1:pen 2:cap pen=2 total=6\n");
    buf_bytes(out, b"3 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Lines one at a time: `let mut b = String::new_in(gpa); while\n");
    buf_bytes(out, b"io::stdin().read_line(&mut b).unwrap() > 0 { ... }` (appends, with the\n");
    buf_bytes(out, b"`'\\n'`; `b.clear()` between). An owned value (`Vec`, `String`,\n");
    buf_bytes(out, b"`HashMap`, a struct holding one) moves into a by-value parameter, a\n");
    buf_bytes(out, b"`let w = v;`, a struct field or a `return`: `v` is dead after it\n");
    buf_bytes(out, b"(`borrowck.use_moved`); pass `&v` to lend it, or `v.clone()`. A `Copy`\n");
    buf_bytes(out, b"value (numbers, `&T`, a struct deriving it) is copied. A temporary is\n");
    buf_bytes(out, b"dropped at the end of its statement. A slice of `v` (`&v[a..b]`) borrows\n");
    buf_bytes(out, b"it: `v` does not grow while the slice is used. What allocates has Rust's\n");
    buf_bytes(out, b"name with `_in` and takes the allocator last: `collect_in(gpa)`,\n");
    buf_bytes(out, b"`to_string_in(gpa)`, `format_in(.., gpa)`. std's most used items:\n");
    buf_bytes(out, b"`volec guide std`; all, a line each: `volec guide std#the-api`; one name\n");
    buf_bytes(out, b"with its comment: `volec guide --find split_once`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The first errors and their fixes\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| error (short form) | fix |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `'println!' is a macro call: vole has no macros` | `println(\"{a}\")`, the help's form |\n");
    buf_bytes(out, b"| `'Vec::new' allocates from nothing` (`alloc.no_in`) | `Vec::new_in(gpa)`: main's `gpa`, passed down; `volec fix --only alloc` |\n");
    buf_bytes(out, b"| `'Vec' names no allocator` (`alloc.default`) | `Vec<i64, Gpa>`, or a generic `A: Allocator` |\n");
    buf_bytes(out, b"| `expected 'String<Gpa>', got '&str'` | `String::from_in(\"..\", gpa)`: a String owns its text; a parameter `s: &str` takes literals and a String's `&s` |\n");
    buf_bytes(out, b"| `cannot assign to immutable variable 'a'` | `let mut a` |\n");
    buf_bytes(out, b"| `borrowck.borrow_immutable: cannot borrow 'w' as mutable, as it is not declared as mutable` | `let mut w`: `w.push(1)` and `&mut w` change it |\n");
    buf_bytes(out, b"| `expected '&mut Vec<i64, Gpa>', got 'Vec<i64, Gpa>'` | `f(&mut v)`: the callee may change `v` |\n");
    buf_bytes(out, b"| `borrowck.use_moved: 'v' is used here after it moved` | lend it (`&v`), or `keep(v.clone())` |\n");
    buf_bytes(out, b"| `borrowck.conflict: cannot borrow 'u' as mutable because it is also borrowed as immutable` | use the shared borrow before the change, or take it again after (`guide memory#borrowing`) |\n");
    buf_bytes(out, b"| `non-exhaustive match: 'E::B' is not covered` | an arm for it, or `_ =>` |\n");
    buf_bytes(out, b"| `calling a C function is unsafe` | `unsafe { ... }`; `volec fix --only unsafe` adds them |\n");
    buf_bytes(out, b"| `expected 'i32', got 'i64'` | `x as i32`: only widening is implicit |\n");
    buf_bytes(out, b"| `an index is a 'usize', got 'i64'` | `v[i as usize]`, or declare `i: usize` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Every error has a `help:`; `volec guide errors` has more.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Tests and checks: `#[test] fn` and `#[property] fn p(x: i64)` (inputs\n");
    buf_bytes(out, b"generated, shrunk) sit next to the code and `volec test` runs them at\n");
    buf_bytes(out, b"-O0 and -O2; `requires`/`ensures` clauses and `assert_eq(a, b)` are\n");
    buf_bytes(out, b"checked at run time (`guide testing`, `guide contracts`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Float math: Rust's methods on f32 and f64 (`x.sqrt()`, `y.atan2(x)`,\n");
    buf_bytes(out, b"`x.powi(2)`) and constants (`std::f64::consts::PI`): `volec guide math`.\n");
    buf_bytes(out, b"SIMD and CPU intrinsics: `std::arch`, the vendors' names (`vaddq_u8`)\n");
    buf_bytes(out, b"checked against the CPU: `volec guide arch`; `query arch WORDS`.\n");
    buf_bytes(out, b"GPU compute and rendering: `std::gpu`, wgpu's objects on Metal: `volec guide gpu`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The loop\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Write the program, then `volec check` (a check hook, where there is\n");
    buf_bytes(out, b"one, runs it after each edit); fix the first error first. A clean check\n");
    buf_bytes(out, b"ends with `ok: 0 errors in main.vl`, a build with `ok: built prog`. Before writing a construct\n");
    buf_bytes(out, b"you are unsure of, `volec guide --find WORDS` (`--find read a line`)\n");
    buf_bytes(out, b"or `volec guide TOPIC#SECTION` prints the lines on it; `volec\n");
    buf_bytes(out, b"try 'CODE'` runs a snippet. For an unfamiliar item, ask\n");
    buf_bytes(out, b"`volec query context NAME` first: its source, what it calls and its\n");
    buf_bytes(out, b"callers in one call (`query context parse_args`). Edits, refactorings\n");
    buf_bytes(out, b"and other queries: `volec guide tools`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Topics (`volec guide TOPIC`, `TOPIC#` lists its sections):\n");
    buf_bytes(out, b"@TOPIC-NAMES@\n");
}
