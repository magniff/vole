use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# vole, the core (vole 0.20)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Vole is a compiled systems language of values: a value has one\n");
    buf_bytes(out, b"owner, is copied or moved, and is dropped at the end of its scope. A\n");
    buf_bytes(out, b"function says what it does with each argument: reads it (`let`, the\n");
    buf_bytes(out, b"default), changes it (`inout`, marked `&x` at the call) or takes it\n");
    buf_bytes(out, b"(`sink`). There are no references to store or lifetimes to write; views\n");
    buf_bytes(out, b"(slices, structs holding one) are checked to stay inside what they view.\n");
    buf_bytes(out, b"Nothing allocates without an allocator, indexing is checked, and safe\n");
    buf_bytes(out, b"code has no undefined behaviour. This page is the core; the rest is on\n");
    buf_bytes(out, b"demand (the end). From Rust: `volec guide rust` has the mapping.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Build and run\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```sh\n");
    buf_bytes(out, b"volec run < in.txt                         # ./main.vl built (when changed), run\n");
    buf_bytes(out, b"volec main.vl -o prog                      # the executable; `mod x;` loads x.vl\n");
    buf_bytes(out, b"volec check main.vl                        # every error, one line each\n");
    buf_bytes(out, b"volec try 'parse_int(\"42\")'                  # a snippet: its TYPE = VALUE\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The language in one program\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"import \"stdio.h\" as c;                 // a C header; its names under c::\n");
    buf_bytes(out, b"use std::is_digit;                     // std items by name (never *)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct P { x: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl P {\n");
    buf_bytes(out, b"    fn bump(inout self) { self.x += 1; }   // inout self: changes the caller's P\n");
    buf_bytes(out, b"    fn get(self) -> i64 { self.x }         // self (let): reads it\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn total(v: Vec<i64, Gpa>) -> i64 { // let (default): read-only, no copy\n");
    buf_bytes(out, b"    v.iter().sum()\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn grow(v: inout Vec<i64, Gpa>, x: i64) { // inout: the caller writes grow(&v, x)\n");
    buf_bytes(out, b"    v.push(x);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn keep(all: inout Vec<Vec<i64, Gpa>, Gpa>, v: sink Vec<i64, Gpa>) { // sink: keep takes v\n");
    buf_bytes(out, b"    all.push(v);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn first(s: [u8]) -> u8 { s[0] } // text is [u8]; 'a' is a u8; no char\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn odds(n: i64, gpa: Gpa) -> Vec<i64, Gpa> { // allocating takes an allocator\n");
    buf_bytes(out, b"    (0..n).filter(|i| i % 2 == 1).collect_in(gpa)\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 { // gpa: the program's allocator; 0 = exit status\n");
    buf_bytes(out, b"    var v: Vec<i64, Gpa> = Vec::new_in(gpa); // var: mutable; let: not\n");
    buf_bytes(out, b"    v.push(5);\n");
    buf_bytes(out, b"    grow(&v, 2);                       // & marks the argument grow may change\n");
    buf_bytes(out, b"    v[0] += 10;                        // checked (v[1..2] a slice)\n");
    buf_bytes(out, b"    v.sort();                          // or sort(v.as_mut_slice())\n");
    buf_bytes(out, b"    var p = P { x: 1 };\n");
    buf_bytes(out, b"    p.bump();                          // a receiver needs no &; p must be var\n");
    buf_bytes(out, b"    println(\"{} {v:?} {}\", p.get(), total(v)); // formatted; total(v) only reads\n");
    buf_bytes(out, b"    var all: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    keep(&all, v);                     // v moved into keep: dead from here\n");
    buf_bytes(out, b"    let s = \"hi\";\n");
    buf_bytes(out, b"    println(s.len());                  // an i64 (slices, Vec, String, HashMap)\n");
    buf_bytes(out, b"    var b = String::new_in(gpa);       // a text builder\n");
    buf_bytes(out, b"    let o = odds(7, gpa);\n");
    buf_bytes(out, b"    b.push_str(\"n=\");\n");
    buf_bytes(out, b"    b.push_fmt(o.len());\n");
    buf_bytes(out, b"    println(b.as_slice());\n");
    buf_bytes(out, b"    if s == \"hi\" && !is_digit(first(s)) { println(first(s)); }   // compared, not matched\n");
    buf_bytes(out, b"    var m: HashMap<[u8], i64, Gpa> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"    m.get_or_insert(\"k\", 0)[0] += 1;   // a one-element view: [0] is the value\n");
    buf_bytes(out, b"    let z = 0;\n");
    buf_bytes(out, b"    println(\"{} {} {}\", ~0u8, 250u8.wrapping_add(7), m.get(\"k\").unwrap()); // ~x; x / 0 panics\n");
    buf_bytes(out, b"    unsafe { c::puts(c\"from C\"); }     // C calls need unsafe; c\"..\": a NUL-terminated *u8\n");
    buf_bytes(out, b"    if z != 0 { panic(\"z\"); }          // exit 101; unreachable()\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}                                      // all, o, b, m: dropped (freed) here\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"2 [2, 15] 17\n");
    buf_bytes(out, b"2\n");
    buf_bytes(out, b"n=3\n");
    buf_bytes(out, b"104\n");
    buf_bytes(out, b"255 1 1\n");
    buf_bytes(out, b"from C\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Also: lengths and indices are `usize` (0.26.2; a counter from a literal\n");
    buf_bytes(out, b"says `var i: usize = 0`); overflow panics at -O0, wraps at -O2 (`wrapping_add`: always); `a as i32`\n");
    buf_bytes(out, b"narrows, widening is implicit; `x?`, closures (`|x| x + k`, `sink ||`\n");
    buf_bytes(out, b"to take what it captures), `impl Trait for T`, `T: Trait`,\n");
    buf_bytes(out, b"`#[derive(Eq, Debug)]`, `where T: Ord` and `x: impl Display` (0.26.2); no `dyn`, `Box`. A let or inout\n");
    buf_bytes(out, b"parameter is used as the value itself: `n + 1`, `out = acc`, `p.x`\n");
    buf_bytes(out, b"(`*` is only for raw `*T` pointers, which need `unsafe`). `inout r =\n");
    buf_bytes(out, b"&st;` names an access to pass on: `f(&r)`, `g(&r)`. `match e` on a let\n");
    buf_bytes(out, b"`e: E` binds into it (`E::A(n) => n + 1`). Arguments may have defaults\n");
    buf_bytes(out, b"and names: `fn f(a: i64, b: i64 = 2)`, `f(1, b: 3)`. The prelude (no\n");
    buf_bytes(out, b"`use`) has `Option`, `Result`, `Vec`, `Buf`, `HashMap`, `BinaryHeap` and\n");
    buf_bytes(out, b"`MinHeap` (priority queues: `pop` the largest, the smallest), `print`,\n");
    buf_bytes(out, b"`println`, `format_in`, `Gpa`, `read_line`, `read_stdin_in`, `Scanner`,\n");
    buf_bytes(out, b"`parse_int` (`parse_int(s)` is a `Result<i64, ParseIntError>`: take\n");
    buf_bytes(out, b"it with `.unwrap_or(0)`, `?`, or `match` on `Ok(n)` and `Err(e)`),\n");
    buf_bytes(out, b"`trim`, `split_in`, `split_whitespace_in`, `sort`,\n");
    buf_bytes(out, b"`sort_by`, `sort_stable_by`, `cmp_of`, `Fmt`, `panic`, `unreachable`;\n");
    buf_bytes(out, b"the rest of std is `use std::{...}`; `use lexer::Tok;` in a module\n");
    buf_bytes(out, b"reaches its sibling `lexer`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## std: what programs use most\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Item { name: [u8], qty: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn add(v: inout Vec<Item, Gpa>, it: Item) { v.push(it); } // called as add(&items, ..)\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    let input = read_stdin_in(gpa).unwrap();   // all of stdin: Result<Vec<u8, Gpa>, IoError>\n");
    buf_bytes(out, b"    var sc = Scanner::new(input.as_slice());\n");
    buf_bytes(out, b"    let n = sc.next_int().unwrap();            // Result<i64, ScanError>\n");
    buf_bytes(out, b"    var items: Vec<Item, Gpa> = Vec::new_in(gpa);\n");
    buf_bytes(out, b"    var seen: HashMap<[u8], i64, Gpa> = HashMap::new_in(gpa);\n");
    buf_bytes(out, b"    for _ in 0..n {\n");
    buf_bytes(out, b"        let name = sc.next_token().unwrap();   // Option<[u8]>: a slice of input\n");
    buf_bytes(out, b"        let qty = sc.next_int().unwrap_or(0);\n");
    buf_bytes(out, b"        add(&items, Item { name: name, qty: qty });\n");
    buf_bytes(out, b"        seen.insert(name, qty);                // also contains(k), remove(k)\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    items.sort_by(|a, b| b.qty - a.qty);       // a, b: Item (let); < 0: a first\n");
    buf_bytes(out, b"    for (i, it) in items.iter().enumerate() { print(\"{i}:{} \", it.name); }\n");
    buf_bytes(out, b"    let line = trim(sc.next_line().unwrap());  // the rest of the line\n");
    buf_bytes(out, b"    let total = split_in(line, ',', gpa).iter()\n");
    buf_bytes(out, b"        .map(|w| parse_int(trim(w)).unwrap_or(0)).sum();\n");
    buf_bytes(out, b"    match seen.get(\"pen\") {                    // Option<i64>\n");
    buf_bytes(out, b"        Some(q) => println(\"pen={q} total={total}\"),\n");
    buf_bytes(out, b"        None => println(\"no pen\"),\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let text = format_in(\"{} {}\", items.len(), seen.len(), gpa); // a String\n");
    buf_bytes(out, b"    println(text.as_slice());                  // text, seen, items, input: dropped at the end\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```in\n");
    buf_bytes(out, b"3 pen 2 ink 5 cap 1 1,2, 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"0:ink 1:pen 2:cap pen=2 total=6\n");
    buf_bytes(out, b"3 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Lines one at a time: `var b = String::new_in(gpa); while\n");
    buf_bytes(out, b"read_line(&b).unwrap() { ... }` (without the `'\\n'`). An owned value\n");
    buf_bytes(out, b"(`Vec`, `Buf`, `HashMap`, a struct holding one) moves into a `sink`\n");
    buf_bytes(out, b"parameter, a `let w = v;`, a struct field or a `return`: `v` is dead\n");
    buf_bytes(out, b"after it (`own.moved`); pass it to a let parameter to lend it, or pass\n");
    buf_bytes(out, b"`v.clone()`. A plain value (numbers, structs of them) is copied. `&f(x)`\n");
    buf_bytes(out, b"makes a temporary that lives to the end of the block (0.18.1); any other\n");
    buf_bytes(out, b"owned temporary used without being moved (`f()?.read()`,\n");
    buf_bytes(out, b"`make().len()`, `total(make())`) is dropped at the end of its statement,\n");
    buf_bytes(out, b"or of its block when a `let` keeps a view of it (0.25). A slice\n");
    buf_bytes(out, b"of `v` is a view: take it again after `v` grows. std's most used items:\n");
    buf_bytes(out, b"`volec guide std`; all, a line each: `volec guide std#the-api`;\n");
    buf_bytes(out, b"one name with its comment: `volec guide --find split_in`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The first errors and their fixes\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| error (short form) | fix |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `conv.marker: 'v' is lent inout here` | `f(&v)`: the callee may change `v` |\n");
    buf_bytes(out, b"| `conv.marker_extra: '&' marks an argument the callee may change` | `f(v)`: a let or sink argument has no `&` |\n");
    buf_bytes(out, b"| `conv.rust: 'let mut' is Rust's spelling` | the `try:` line's form (`var`, `x: inout T`, `self`, `&x`) |\n");
    buf_bytes(out, b"| `cannot assign to immutable variable 'a'` | `var a`; a parameter you change: `a: inout T` |\n");
    buf_bytes(out, b"| `own.moved: 'v' is used here after it moved into 'keep(sink v)'` | lend it (a let parameter), or `keep(v.clone())` |\n");
    buf_bytes(out, b"| `own.conflict: ... while 'first' views them` | use the view before the change, or take it again after (`guide memory#slices`) |\n");
    buf_bytes(out, b"| `non-exhaustive match: 'E::B' is not covered` | an arm for it, or `_ =>` |\n");
    buf_bytes(out, b"| `calling a C function is unsafe` | `unsafe { ... }`; `volec fix --only unsafe` adds them |\n");
    buf_bytes(out, b"| `no 'cmp' in module 'std'` | every std item is `std::name` (its most used names need no `use`) |\n");
    buf_bytes(out, b"| `expected 'String<Gpa>', got '[u8]'` | `String::from_in(\"..\", gpa)`: a String owns its text; a parameter `s: str` takes literals and a String's `&s` |\n");
    buf_bytes(out, b"| `'Vec::new' allocates from nothing` | `Vec::new_in(gpa)`: main's `gpa`, passed down |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Every error has a `help:`; `volec guide errors` has more.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Tests and checks (0.18): `#[test] fn` and `#[property] fn p(x: i64)`\n");
    buf_bytes(out, b"(inputs generated, shrunk) sit next to the code and `volec test` runs\n");
    buf_bytes(out, b"them at -O0 and -O2; `requires`/`ensures` clauses and `assert_eq(a, b)`\n");
    buf_bytes(out, b"are checked at run time, a failure one line `FILE:L:C: message` (`guide\n");
    buf_bytes(out, b"testing`, `guide contracts`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Float math (0.25.2.1): Rust's methods on f32 and f64, no `use`\n");
    buf_bytes(out, b"(`x.sqrt()`, `x.sin()`, `y.atan2(x)`, `x.powi(2)`, `a.max(b)`) and\n");
    buf_bytes(out, b"constants (`f64::consts::PI`, `f64::EPSILON`), in vole: `volec guide math`.\n");
    buf_bytes(out, b"SIMD and CPU intrinsics (0.19): `std::arch`, the vendors' names (`vaddq_u8`,\n");
    buf_bytes(out, b"`__crc32cd`) checked against the CPU: `volec guide arch`; `query arch WORDS`.\n");
    buf_bytes(out, b"GPU compute and rendering (0.22): `std::gpu`, wgpu's objects on Metal: `volec guide gpu`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The loop\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Write the program, then `volec check` (a check hook, where there is\n");
    buf_bytes(out, b"one, runs it after each edit); fix the first error first. A clean check\n");
    buf_bytes(out, b"ends with `ok: 0 errors in main.vl`, a build with `ok: built prog`. Before writing a construct\n");
    buf_bytes(out, b"you are unsure of, `volec guide --find WORDS` (`--find read a line`)\n");
    buf_bytes(out, b"or `volec guide TOPIC#SECTION` prints the lines on it; `volec\n");
    buf_bytes(out, b"try 'CODE'` runs a snippet. For an unfamiliar item, ask\n");
    buf_bytes(out, b"`volec query context NAME` first: its source, what it calls and its\n");
    buf_bytes(out, b"callers in one call (`query context parse_args`). Edits, refactorings\n");
    buf_bytes(out, b"and other queries: `volec guide tools`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Topics (`volec guide TOPIC`, `TOPIC#` lists its sections):\n");
    buf_bytes(out, b"@TOPIC-NAMES@\n");
}
