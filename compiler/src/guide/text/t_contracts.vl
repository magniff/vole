// Generated by compiler/guide/embed.sh from compiler/guide/contracts.md (do
// not edit): the guide's topic 'contracts'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Contracts and assertions\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A function states what it needs and what it promises between its\n");
    buf_bytes(out, b"signature and its body (0.18). The clauses are checked at run time, as\n");
    buf_bytes(out, b"bounds are: a failure is one line on stderr and exit 101. There is no\n");
    buf_bytes(out, b"release switch; `debug` clauses are the ones only test builds check.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## requires and ensures\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Stack<A: Allocator> { items: Vec<i64, A> }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl Stack<Gpa> {\n");
    buf_bytes(out, b"    fn top(self, i: i64) -> i64\n");
    buf_bytes(out, b"        requires 0 <= i && i < self.items.len() as i64 else \"no item {i}\"\n");
    buf_bytes(out, b"        ensures result == self.items.get(i as usize)\n");
    buf_bytes(out, b"    {\n");
    buf_bytes(out, b"        self.items.get(i as usize)\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"    fn pop(inout self) -> i64\n");
    buf_bytes(out, b"        requires self.items.len() > 0 else \"pop on an empty stack\"\n");
    buf_bytes(out, b"    {\n");
    buf_bytes(out, b"        self.items.pop().unwrap()\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main(gpa: Gpa) -> i32 {\n");
    buf_bytes(out, b"    var s = Stack { items: Vec::new_in(gpa) };\n");
    buf_bytes(out, b"    s.items.push(4);\n");
    buf_bytes(out, b"    println(\"{} {}\", s.top(0), s.pop());\n");
    buf_bytes(out, b"    println(\"{}\", s.pop());\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out (exit 101)\n");
    buf_bytes(out, b"4 4\n");
    buf_bytes(out, b"main.vl:22:19: pop on an empty stack: self.items.len() = 0\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- `requires COND` is checked at the call, after the arguments: a failure\n");
    buf_bytes(out, b"  names the caller's line, the one to change. Several clauses are\n");
    buf_bytes(out, b"  checked in order.\n");
    buf_bytes(out, b"- `ensures COND` is checked at every return of the body, before its\n");
    buf_bytes(out, b"  drops: a failure names the function. `result` is the value\n");
    buf_bytes(out, b"  returned; `old(e)` is e evaluated at entry.\n");
    buf_bytes(out, b"- A failure reads `requires failed: 'COND' of 'f' (FILE:L:C): x = 4, ...`\n");
    buf_bytes(out, b"  (the integer operands' values; a float's in millionths, `d = 707106e-6`,\n");
    buf_bytes(out, b"  0.25.2.1). `else \"text\"` (a format string,\n");
    buf_bytes(out, b"  `else \"bad {x}\"`, evaluated only on failure) replaces all before the\n");
    buf_bytes(out, b"  values. Its holes are integers, three at most (`contract.message`): a\n");
    buf_bytes(out, b"  float or text shows as an operand of the condition instead.\n");
    buf_bytes(out, b"- `debug requires` / `debug ensures` are checked only by `volec test`\n");
    buf_bytes(out, b"  (and `--debug-contracts`): for conditions that cost more than the\n");
    buf_bytes(out, b"  function (`debug requires is_sorted(v)`).\n");
    buf_bytes(out, b"- std's own: `Vec::get`, `set`, `swap`, `insert`, `remove`,\n");
    buf_bytes(out, b"  `Option::unwrap`, `Result::unwrap` have requires, so their failures\n");
    buf_bytes(out, b"  name your line.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## What a condition may do\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A condition reads the parameters, `result`, `old(..)` and constants, and\n");
    buf_bytes(out, b"calls functions; it must be pure: no io, no allocation, no static\n");
    buf_bytes(out, b"(`contract.effect`, with the `query effects --why` that shows the call),\n");
    buf_bytes(out, b"through a fn value too (what every function of its type whose address\n");
    buf_bytes(out, b"is taken may do).\n");
    buf_bytes(out, b"Owned parameters are read in place, never moved or dropped.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An ensures runs after the body, so (`contract.old`):\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"- a parameter taken by value and owned (a `Vec`, a `Buf`) is gone:\n");
    buf_bytes(out, b"  write `old(v.len())` (or `old(v.clone())`), or take it by `&`;\n");
    buf_bytes(out, b"- `old(e)` must not keep a view (`old(v.as_slice())`) of what the body\n");
    buf_bytes(out, b"  may change: take a plain part, `old(v.len())`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`result` in a requires, or in an ensures of a function that returns\n");
    buf_bytes(out, b"nothing, is `contract.result`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Assertions\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`assert(c)`, `assert(c, \"message\")`, `assert_eq(a, b)`, `assert_ne(a,\n");
    buf_bytes(out, b"b)` and `debug_assert(c)` are in the prelude; `assert!(..)` and the other\n");
    buf_bytes(out, b"bang spellings are accepted. Each operand is evaluated once; the\n");
    buf_bytes(out, b"message is `assertion failed: 'COND'` (or the message given) and the\n");
    buf_bytes(out, b"values:\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let k = std::parse_int(\"3\").unwrap_or(0);\n");
    buf_bytes(out, b"    assert_eq(k * 2, 6);\n");
    buf_bytes(out, b"    assert(k > 5, \"k is small\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out (exit 101)\n");
    buf_bytes(out, b"main.vl:4:5: k is small: k = 3\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## The failure line\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Every run-time check prints one line, `FILE:LINE:COL: message`, and\n");
    buf_bytes(out, b"exits with 101: bounds, `as E`, `unwrap`, contracts, assertions.\n");
    buf_bytes(out, b"`--trace` adds the calls that led there (`volec test` builds with\n");
    buf_bytes(out, b"it; guide debug).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Contracts and the optimizer\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A check passes facts on: after `requires i < v.len()`, `v[i]` in the\n");
    buf_bytes(out, b"body needs no bounds check, where the call is inlined and (0.18.1, -O2)\n");
    buf_bytes(out, b"in a function no caller inlines, since every direct call checks first.\n");
    buf_bytes(out, b"Nothing is assumed: a fact comes only from a check that ran, so a\n");
    buf_bytes(out, b"function whose address is taken (an indirect call does not check its\n");
    buf_bytes(out, b"requires) or that C calls keeps its own checks. Integers wrap: `i + 4\n");
    buf_bytes(out, b"<= v.len()` holds for an i near `i64::MAX`, so it does not prove\n");
    buf_bytes(out, b"`v[i + 1]`; `x % n` with `requires n > 0` is in `0..n`. `volec\n");
    buf_bytes(out, b"query checks FN` lists the checks left after the optimizer and the ones\n");
    buf_bytes(out, b"it removed.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Contracts as tests\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`volec test` tests every function with an `ensures` as a property:\n");
    buf_bytes(out, b"its inputs generated, its requires filtering them (guide testing).\n");
}
