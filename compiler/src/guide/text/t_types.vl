// Generated by compiler/guide/embed.sh from compiler/guide/types.md (do
// not edit): the guide's topic 'types'.

use crate::base::buf_bytes;

pub fn text(out: i64) {
    buf_bytes(out, b"# Types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| type | |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `i8 i16 i32 i64 isize`, `u8 u16 u32 u64 usize` | integers (no `i128`); an unsuffixed literal is `i32` unless the context or a suffix says (Rust's) |\n");
    buf_bytes(out, b"| `f32`, `f64` | IEEE floats; a literal is `f64` unless the context or a suffix says |\n");
    buf_bytes(out, b"| `bool`, `char` | `true`, `false`; a `char` is a Unicode scalar value, `'a'` |\n");
    buf_bytes(out, b"| `()` | the unit type |\n");
    buf_bytes(out, b"| `!` | never: `return`, `break`, `loop` without `break`, `fn f() -> !` |\n");
    buf_bytes(out, b"| `(A, B)` | tuples: `t.0`; `(x,)` has one element |\n");
    buf_bytes(out, b"| `[T; N]` | an array, a value; `N` a constant expression |\n");
    buf_bytes(out, b"| `[T]`, `str` | a slice, text: behind a reference, `&[T]`, `&mut [T]`, `&str`; `.len()` is a `usize` |\n");
    buf_bytes(out, b"| `&T`, `&mut T` | references, checked by the borrow checker (`guide memory`) |\n");
    buf_bytes(out, b"| `*const T`, `*mut T` | raw pointers (`*mut u8` is also C's `void *`) |\n");
    buf_bytes(out, b"| `fn(A, &B) -> R` | a plain function value |\n");
    buf_bytes(out, b"| `extern \"C\" fn(A) -> R` | a C function pointer, another type |\n");
    buf_bytes(out, b"| `S`, `E`, `S<T>` | structs, enums, unions, their instances |\n");
    buf_bytes(out, b"| `type X = distinct T` | vole's: a type of its own with T's representation |\n");
    buf_bytes(out, b"| `std::ptr::NonNull<T>` | a `*mut T` that is never null |\n");
    buf_bytes(out, b"| `v16u8 v8i16 v4f32 v2f64 ...` | SIMD vectors: 8, 16 or 32 bytes of signed, unsigned or float lanes (`guide arch`) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Numbers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`as` converts between numeric types (and `bool` and `char` to an\n");
    buf_bytes(out, b"integer, a fieldless enum to an integer); `T::from(x)` widens (`guide\n");
    buf_bytes(out, b"conversions`, which also has vole's own widening). An unsuffixed literal\n");
    buf_bytes(out, b"takes the type the context needs (`let b: u8 = 7;`, `x + 1` with `x:\n");
    buf_bytes(out, b"u32`), and must fit: `let b: u8 = 300;` is an error.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Every operation is defined. Overflow is Rust's: `max + 1` panics at -O0\n");
    buf_bytes(out, b"(`attempt to add with overflow`, at the expression) and wraps at -O1\n");
    buf_bytes(out, b"and -O2; `--overflow-checks=on|off` chooses for any level. `x / 0` and\n");
    buf_bytes(out, b"`MIN / -1` panic at every level, and so does a shift by the type's bits\n");
    buf_bytes(out, b"or more at -O0 (at -O2 the amount is taken modulo the bits). Where\n");
    buf_bytes(out, b"wrapping (or a check) is what you mean, say so, at every level:\n");
    buf_bytes(out, b"`x.wrapping_add(y)` (`_sub _mul _neg _shl _shr _div _rem _pow _abs`),\n");
    buf_bytes(out, b"`checked_*` (an `Option`), `overflowing_*` (the value and a bool),\n");
    buf_bytes(out, b"`saturating_*`. Hashes and PRNGs write `wrapping_*`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let max: i64 = i64::MAX;\n");
    buf_bytes(out, b"    let b: u8 = 250;\n");
    buf_bytes(out, b"    let s: u32 = 1;\n");
    buf_bytes(out, b"    print(\"{} \", max.wrapping_add(1));               // wraps at every level\n");
    buf_bytes(out, b"    print(\"{} \", b.wrapping_add(10));                // u8 wraps: 4\n");
    buf_bytes(out, b"    print(\"{} \", max.checked_add(1).unwrap_or(-1));  // None: it overflowed\n");
    buf_bytes(out, b"    print(\"{} \", b.saturating_add(10));              // 255\n");
    buf_bytes(out, b"    print(\"{} \", -7 % 3);                            // the sign of the dividend\n");
    buf_bytes(out, b"    print(\"{} \", s.wrapping_shl(33));                // the amount mod the bits\n");
    buf_bytes(out, b"    print(\"{} \", 1e30 as i64 - max);                 // float to int saturates\n");
    buf_bytes(out, b"    print(\"{} \", -1.9 as i64);                       // truncates\n");
    buf_bytes(out, b"    println(\"{}\", (0.0f64 / 0.0) as i64);            // NaN becomes 0\n");
    buf_bytes(out, b"    let (v, o) = 250u8.overflowing_add(10);\n");
    buf_bytes(out, b"    println(\"{v} {o} {}\", i32::MIN);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"-9223372036854775808 4 -1 255 -1 2 0 -1 0\n");
    buf_bytes(out, b"4 true -2147483648\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Floats are IEEE 754 without fast-math; `1.0 / 0.0` is infinity, and\n");
    buf_bytes(out, b"`NaN != NaN`. Floats have Rust's methods and constants: `x.sqrt()`,\n");
    buf_bytes(out, b"`x.sin()`, `x.abs()`, `x.powi(2)`, `a.max(b)`, `f64::EPSILON`,\n");
    buf_bytes(out, b"`f64::MAX`, `std::f64::consts::PI` (`volec guide math`), in vole, with\n");
    buf_bytes(out, b"no C call.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Arrays and slices\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn sum(xs: &[u32]) -> u32 { xs.iter().sum() }\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let mut grid = [[0i64; 3]; 2];      // [[i64; 3]; 2]\n");
    buf_bytes(out, b"    grid[1][2] = 5;\n");
    buf_bytes(out, b"    let copy = grid;                  // arrays are Copy: copied whole\n");
    buf_bytes(out, b"    grid[0][0] = 1;\n");
    buf_bytes(out, b"    let row = &grid[1][..];           // &[i64]: a borrow of the array's row\n");
    buf_bytes(out, b"    let part = &row[1..];             // checked: lo <= hi <= len\n");
    buf_bytes(out, b"    println(\"{} {} {}\", copy[0][0] + part.len() as i64 + part[1], grid.len(), sum(&[1, 2]));\n");
    buf_bytes(out, b"    let t = (1, \"a\");\n");
    buf_bytes(out, b"    let one = (5,);\n");
    buf_bytes(out, b"    println(\"{} {} {}\", t.0, t.1, one.0);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"7 2 3\n");
    buf_bytes(out, b"1 a 5\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Indexing (`a[i]`) and slicing (`a[lo..hi]`, `a[..hi]`, `a[lo..]`,\n");
    buf_bytes(out, b"`a[..]`) are checked: out of bounds, the program prints `index out of\n");
    buf_bytes(out, b"bounds: index I, length N` and exits with 101. An index may be any\n");
    buf_bytes(out, b"integer type (vole's; rustc's is `usize`). A function taking `&[T]`\n");
    buf_bytes(out, b"takes `&a` of an array or a Vec. An array is `Copy` when its elements\n");
    buf_bytes(out, b"are.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## References and pointers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"A reference, `&T` or `&mut T`, is checked (`volec guide memory`) and\n");
    buf_bytes(out, b"safe; a field or method through one needs no `*` (`r.n += 5`), a value\n");
    buf_bytes(out, b"does (`*r += 1`). A raw pointer (`&x as *const T`, `&mut x as *mut T`,\n");
    buf_bytes(out, b"`std::ptr::null()`) is dereferenced only in `unsafe`, `(*p).n`;\n");
    buf_bytes(out, b"`p.add(i)` is pointer arithmetic, unsafe (`guide unsafe`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::ptr::NonNull<T>` is a `*mut T` that is never null:\n");
    buf_bytes(out, b"`NonNull::new(p)` is `Some` unless p is null, `p.as_ptr()` is the raw\n");
    buf_bytes(out, b"pointer, and dereferencing stays `unsafe`. `Option<NonNull<T>>` is the\n");
    buf_bytes(out, b"field type of a nullable link. Any raw pointer has `p.is_null()`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Enums as integers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`#[repr(u8)] enum Level { Low = 1, Mid = 5, High = 9 }` gives each\n");
    buf_bytes(out, b"variant its value: `l as u8`. vole also casts back, checked: `9 as\n");
    buf_bytes(out, b"Level` is `High`, `4 as Level` exits 101 (`invalid value 4 for enum\n");
    buf_bytes(out, b"Level`); rustc has no such cast (E0605).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::ptr::NonNull;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Counter { n: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn bump(c: &mut Counter) { c.n += 1; }   // a reference: checked, safe\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Node { value: i64, next: Option<NonNull<Node>> }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"#[derive(Clone, Copy, PartialEq, PartialOrd, Debug)]\n");
    buf_bytes(out, b"#[repr(u8)]\n");
    buf_bytes(out, b"enum Level { Low = 1, Mid = 5, High = 9 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let mut c = Counter { n: 0 };\n");
    buf_bytes(out, b"    bump(&mut c);\n");
    buf_bytes(out, b"    let r = &mut c;\n");
    buf_bytes(out, b"    r.n += 5;                            // auto-deref: (*r).n\n");
    buf_bytes(out, b"    let p = &mut c as *mut Counter;      // a raw pointer: deref in unsafe\n");
    buf_bytes(out, b"    unsafe { (*p).n += 5; }\n");
    buf_bytes(out, b"    let b = Node { value: 2, next: None };\n");
    buf_bytes(out, b"    let a = Node { value: 1, next: NonNull::new(&b as *const Node as *mut Node) };\n");
    buf_bytes(out, b"    let mut total = 0;\n");
    buf_bytes(out, b"    let mut cur = NonNull::new(&a as *const Node as *mut Node);\n");
    buf_bytes(out, b"    while let Some(q) = cur {\n");
    buf_bytes(out, b"        unsafe {\n");
    buf_bytes(out, b"            total += (*q.as_ptr()).value;\n");
    buf_bytes(out, b"            cur = (*q.as_ptr()).next;\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    let l = Level::Mid;\n");
    buf_bytes(out, b"    println(\"{} {total} {} {} {}\", c.n, std::mem::size_of::<NonNull<Node>>(), l as u8, Level::Low < l);\n");
    buf_bytes(out, b"    println(\"{} {}\", std::mem::size_of::<(u8, u32)>(), std::mem::align_of::<u64>());\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"11 3 8 5 true\n");
    buf_bytes(out, b"8 8\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Layout\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::mem::size_of::<T>()` and `align_of::<T>()` are constants. vole's\n");
    buf_bytes(out, b"own types have no guaranteed layout (field order, enum tags);\n");
    buf_bytes(out, b"`#[repr(C)]` gives C's. See `volec guide c-interop`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Distinct types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"vole's: `type NodeId = distinct i64;` is a new type, as Go's defined\n");
    buf_bytes(out, b"types are: T's representation and ABI, but not interchangeable with T.\n");
    buf_bytes(out, b"`as` converts both ways for free (`id as i64`, `n as NodeId`); a\n");
    buf_bytes(out, b"literal is the one implicit conversion. T's operators work between two\n");
    buf_bytes(out, b"values of the type, or one and a literal (`a + 1`, `a < b` is a bool);\n");
    buf_bytes(out, b"mixing it with T is `distinct.mix`, whose `try:` is the `as` to write.\n");
    buf_bytes(out, b"It has T's comparisons, Hash, Debug, Display and Clone, but none of T's\n");
    buf_bytes(out, b"methods (`distinct.method`): `impl NodeId { .. }` adds its own. T is\n");
    buf_bytes(out, b"plain: numbers, bool, raw pointers, and structs, tuples and arrays of\n");
    buf_bytes(out, b"them (`distinct.kind`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## SIMD vectors\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`v4f32(a, b, c, d)`, `v4f32::splat(x)`, `v4f32::load(s, i)` (checked,\n");
    buf_bytes(out, b"`s` a slice) make vectors; `+ - *` work lane by lane on all six types,\n");
    buf_bytes(out, b"`/` on float vectors, `& | ^` on integer ones; comparisons give a mask\n");
    buf_bytes(out, b"(`m.select(a, b)`); `v.lane(i)`, `v.with_lane(i, x)`, `v.sum()`,\n");
    buf_bytes(out, b"`v.store(&mut s, i)`. They are not FFI-safe.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| bytes | signed | unsigned | float |\n");
    buf_bytes(out, b"|---|---|---|---|\n");
    buf_bytes(out, b"| 8 | `v8i8 v4i16 v2i32 v1i64` | `v8u8 v4u16 v2u32 v1u64` | `v2f32 v1f64` |\n");
    buf_bytes(out, b"| 16 | `v16i8 v8i16 v4i32 v2i64` | `v16u8 v8u16 v4u32 v2u64` | `v4f32 v2f64` |\n");
    buf_bytes(out, b"| 32 | `v32i8 v16i16 v8i32 v4i64` | `v32u8 v16u16 v8u32 v4u64` | `v8f32 v4f64` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An unsigned vector compares unsigned, and its mask is itself (a lane all\n");
    buf_bytes(out, b"ones or 0); 32-byte vectors are two registers where the CPU has no wider\n");
    buf_bytes(out, b"ones. `T::from_bits(v)` reinterprets a vector of the same size, with no\n");
    buf_bytes(out, b"instruction. The CPU's own instructions on them (NEON, SSE, AVX2, CRC,\n");
    buf_bytes(out, b"AES, SHA) are `std::arch`'s: `volec guide arch`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let xs: [f32; 4] = [1.0, 2.0, 3.0, 4.0];\n");
    buf_bytes(out, b"    let s: &[f32] = &xs;\n");
    buf_bytes(out, b"    let v = v4f32::load(s, 0) * v4f32::splat(2.0);\n");
    buf_bytes(out, b"    let mut out = [0.0f32; 4];\n");
    buf_bytes(out, b"    v.store(&mut out[..], 0);\n");
    buf_bytes(out, b"    let m = v < v4f32::splat(5.0);       // a mask, lane by lane\n");
    buf_bytes(out, b"    println(\"{} {} {:?}\", v.sum(), m.select(v, v4f32::splat(0.0)).sum(), out);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"20 6 [2.0, 4.0, 6.0, 8.0]\n");
    buf_bytes(out, b"```\n");
}
