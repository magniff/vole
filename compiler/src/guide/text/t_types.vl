pub fn text(out: i64) {
    buf_bytes(out, b"# Types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| type | |\n");
    buf_bytes(out, b"|---|---|\n");
    buf_bytes(out, b"| `i8 i16 i32 i64 isize`, `u8 u16 u32 u64 usize` | integers; literals are `i64` unless the context or a suffix says |\n");
    buf_bytes(out, b"| `f32`, `f64` | IEEE floats; literals are `f64` unless the context or a suffix says: `let c = [1.0, 0.5];` is `[f64; 2]` (annotate: `let c: [f32; 2] = ..`; 0.25.2: a mismatch from it names the `let`) |\n");
    buf_bytes(out, b"| `bool` | `true`, `false` |\n");
    buf_bytes(out, b"| `()` | the unit type |\n");
    buf_bytes(out, b"| `!` | never: `return`, `break`, `loop` without `break`, `fn f() -> !` |\n");
    buf_bytes(out, b"| `(A, B)` | tuples: `t.0` (through a pointer too: `p.0`); `(x,)` has one element |\n");
    buf_bytes(out, b"| `[T; N]` | an array, a value; `N` a constant expression |\n");
    buf_bytes(out, b"| `[T]` | a slice: `.len()` (an `i64`); `.ptr` (a `*T`) for C |\n");
    buf_bytes(out, b"| `*T` | a pointer (`*u8` is also C's `void *` and `char *`) |\n");
    buf_bytes(out, b"| `fn(A, inout B) -> R` | a plain function value; a parameter's convention is part of its type |\n");
    buf_bytes(out, b"| `let T`, `inout T` | an access, in a field (`q: inout Query`) or a function type (`guide memory`) |\n");
    buf_bytes(out, b"| `extern \"C\" fn(A) -> R` | a C function pointer, another type |\n");
    buf_bytes(out, b"| `S`, `E`, `S<T>` | structs, enums, unions, their instances |\n");
    buf_bytes(out, b"| `type X = distinct T` | a type of its own with T's representation (0.18) |\n");
    buf_bytes(out, b"| `std::NonNull<T>` | a `*T` that is never null; `Option<NonNull<T>>` is one pointer |\n");
    buf_bytes(out, b"| `v16u8 v8i16 v4f32 v2f64 ...` | SIMD vectors: 8, 16 or 32 bytes of signed, unsigned or float lanes (0.19: `guide arch`) |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Numbers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Only widening converts implicitly (0.15: a narrower integer to a wider\n");
    buf_bytes(out, b"one, `volec guide conversions`); otherwise both sides of `+`, `==`,\n");
    buf_bytes(out, b"`=` have one type, and `as` converts between numeric types (and `bool` to an integer,\n");
    buf_bytes(out, b"fieldless enums to integers and back). An unsuffixed literal takes the\n");
    buf_bytes(out, b"type the context needs (`let b: u8 = 7;`, `x + 1` with `x: u32`), and\n");
    buf_bytes(out, b"must fit: `let b: u8 = 300;` is an error.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Every operation is defined. Overflow is Rust's (0.26.3): `max + 1`\n");
    buf_bytes(out, b"panics at -O0 (`attempt to add with overflow`, at the expression) and\n");
    buf_bytes(out, b"wraps at -O1 and -O2; `--overflow-checks=on|off` chooses for any level.\n");
    buf_bytes(out, b"`x / 0` and `MIN / -1` panic at every level, and so does a shift by the\n");
    buf_bytes(out, b"type's bits or more at -O0 (at -O2 the amount is taken modulo the bits).\n");
    buf_bytes(out, b"Where wrapping (or a check) is what you mean, say so, at every level:\n");
    buf_bytes(out, b"`x.wrapping_add(y)` (`_sub _mul _neg _shl _shr _div _rem _pow _abs`),\n");
    buf_bytes(out, b"`checked_*` (an `Option`), `overflowing_*` (the value and a bool),\n");
    buf_bytes(out, b"`saturating_*`, and `std::num::Wrapping<T>` (`Wrapping(x) + Wrapping(y)`,\n");
    buf_bytes(out, b"its `.value`). Hashes and PRNGs write `wrapping_*`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let max: i64 = 9223372036854775807;\n");
    buf_bytes(out, b"let b: u8 = 250;\n");
    buf_bytes(out, b"let s: u32 = 1;\n");
    buf_bytes(out, b"std::print_int(max.wrapping_add(1)); print(\" \");                // wraps at every level\n");
    buf_bytes(out, b"std::print_int(b.wrapping_add(10) as i64); print(\" \");          // u8 wraps: 4\n");
    buf_bytes(out, b"std::print_int(max.checked_add(1).unwrap_or(-1)); print(\" \");   // None: it overflowed\n");
    buf_bytes(out, b"std::print_int(b.saturating_add(10) as i64); print(\" \");        // 255\n");
    buf_bytes(out, b"std::print_int(-7 % 3); print(\" \");                             // the sign of the dividend\n");
    buf_bytes(out, b"std::print_int(s.wrapping_shl(33) as i64); print(\" \");          // the amount mod the bits\n");
    buf_bytes(out, b"std::print_int(1e30 as i64 - max); print(\" \");                  // float to int saturates\n");
    buf_bytes(out, b"std::print_int(-1.9 as i64); print(\" \");                        // truncates\n");
    buf_bytes(out, b"std::print_int((0.0 / 0.0) as i64);                             // NaN becomes 0\n");
    buf_bytes(out, b"println(\"\");\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"-9223372036854775808 4 -1 255 -1 2 0 -1 0\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Floats are IEEE 754 without fast-math; `1.0 / 0.0` is infinity, and\n");
    buf_bytes(out, b"`NaN != NaN`. Floats have Rust's methods and constants (0.25.2.1):\n");
    buf_bytes(out, b"`x.sqrt()`, `x.sin()`, `x.abs()`, `x.powi(2)`, `a.max(b)`, `f64::EPSILON`,\n");
    buf_bytes(out, b"`f64::MAX`, `f64::consts::PI` (`volec guide math`), in vole, with no C\n");
    buf_bytes(out, b"call; integers have none (`i64::MAX` and `MIN` aside).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Arrays and slices\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"var grid = [[0; 3]; 2];           // [[i64; 3]; 2]\n");
    buf_bytes(out, b"grid[1][2] = 5;\n");
    buf_bytes(out, b"let copy = grid;                  // arrays are values: copied whole\n");
    buf_bytes(out, b"grid[0][0] = 1;\n");
    buf_bytes(out, b"let row = grid[1][..];            // [i64]: a view of the array\n");
    buf_bytes(out, b"let part = row[1..];              // checked: lo <= hi <= len\n");
    buf_bytes(out, b"std::print_int(copy[0][0] + part.len() as i64 + part[1]);\n");
    buf_bytes(out, b"println(\"\");\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"7\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"Indexing (`a[i]`, any integer type) and slicing (`a[lo..hi]`, `a[..hi]`,\n");
    buf_bytes(out, b"`a[lo..]`, `a[..]`) are checked: out of bounds, the program prints\n");
    buf_bytes(out, b"`index out of bounds: index I, length N` and exits with 101. An array\n");
    buf_bytes(out, b"has its length too: `a.len()` (0.17), or slice it: `a[..].len()`. A function taking `[T]` gets\n");
    buf_bytes(out, b"`a[..]`, not `a`. An array literal where a slice of numbers goes takes\n");
    buf_bytes(out, b"its element type (0.25.2.1): `let xs: [u32] = [1, 2, 3];`, `sum([1, 2])`\n");
    buf_bytes(out, b"for `xs: [u32]`. A slice of a raw pointer, `p[0..n]`, is unchecked and\n");
    buf_bytes(out, b"unsafe.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Accesses and pointers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An *access* is how a function reaches a value it does not own: a let\n");
    buf_bytes(out, b"parameter (read-only), an `x: inout T` parameter (exclusive, writes\n");
    buf_bytes(out, b"reach the caller, passed as `&place`), an `inout r = &place;` local, an\n");
    buf_bytes(out, b"access field (`q: inout Query`). All are checked (`volec guide\n");
    buf_bytes(out, b"memory`), safe, and used as the value itself: `r.n += 5`, `r = v`, `n +\n");
    buf_bytes(out, b"1`, with no `*`. A raw pointer `*T` (from C, `&place` where a `*T` is\n");
    buf_bytes(out, b"expected, `0 as *T` for null) is dereferenced only in `unsafe`. There is\n");
    buf_bytes(out, b"no pointer arithmetic: index a raw pointer (`p[i]`, `&p[i]`) in unsafe\n");
    buf_bytes(out, b"code, or cast through `i64`. Through an access to a Vec, a Buf or a\n");
    buf_bytes(out, b"slice, `p[i]` is that element, checked; through a raw pointer it is\n");
    buf_bytes(out, b"`unsafe`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"struct Counter { n: i64 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn bump(c: inout Counter) { c.n += 1; }  // an access: safe\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    var c = Counter { n: 0 };\n");
    buf_bytes(out, b"    bump(&c);\n");
    buf_bytes(out, b"    inout r = &c;                        // an inout local: safe\n");
    buf_bytes(out, b"    r.n += 5;\n");
    buf_bytes(out, b"    let p = &c as *Counter;              // a raw pointer: unsafe\n");
    buf_bytes(out, b"    unsafe { p.n += 5; }\n");
    buf_bytes(out, b"    std::print_int(c.n);\n");
    buf_bytes(out, b"    println(\"\");\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"11\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Distinct types\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`type NodeId = distinct i64;` is a new type, as Go's defined types are:\n");
    buf_bytes(out, b"T's representation and ABI, but not interchangeable with T. `as`\n");
    buf_bytes(out, b"converts both ways for free (`id as i64`, `n as NodeId`); a literal is\n");
    buf_bytes(out, b"the one implicit conversion. T's operators work between two values of\n");
    buf_bytes(out, b"the type, or one and a literal (`a + 1`, `m / 2.0`, `a < b` is a bool);\n");
    buf_bytes(out, b"mixing it with T is `distinct.mix`, whose `try:` is the `as` to write\n");
    buf_bytes(out, b"(`volec fix --suggested` writes them all). It has T's Eq, Ord, Hash,\n");
    buf_bytes(out, b"Debug, Display and Clone (`Vec<NodeId, Gpa>` sorts, prints, is a HashMap key)\n");
    buf_bytes(out, b"and T's literal patterns, but none of T's methods (`distinct.method`):\n");
    buf_bytes(out, b"`impl NodeId { .. }` adds its own. `type Id<T> = distinct i64;` makes\n");
    buf_bytes(out, b"`Id<Node>` and `Id<Edge>` two types. T is plain: numbers, bool, raw\n");
    buf_bytes(out, b"pointers, and structs, tuples and arrays of them; not owned (a Vec, a\n");
    buf_bytes(out, b"type with a Drop impl) nor a view (a slice, an access field) (`distinct.kind`).\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"type NodeId = distinct i64;\n");
    buf_bytes(out, b"type Meters = distinct f64;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"impl NodeId {\n");
    buf_bytes(out, b"    fn next(self) -> NodeId { self + 1 }\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let a: NodeId = 3;\n");
    buf_bytes(out, b"    let b = a.next() * 2;              // NodeId\n");
    buf_bytes(out, b"    let x: f64 = 0.5;\n");
    buf_bytes(out, b"    let d: Meters = 2.0;\n");
    buf_bytes(out, b"    let e = d + x as Meters;           // `d + x` is distinct.mix\n");
    buf_bytes(out, b"    println(\"{b} {} {e} {}\", a < b, b as i64 + 1);\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"8 true 2.5 9\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`std::NonNull<T>` is std's `distinct *T` that is never null:\n");
    buf_bytes(out, b"`NonNull::new(p)` is `Some` unless p is null, `p as NonNull<T>` is\n");
    buf_bytes(out, b"checked (a null p exits 101: `null pointer made NonNull`), `p.as_ptr()`\n");
    buf_bytes(out, b"(or `p as *T`) is the raw pointer, and dereferencing stays `unsafe`.\n");
    buf_bytes(out, b"`Option<NonNull<T>>` is one pointer, `None` the null one, so it is the\n");
    buf_bytes(out, b"field type of a nullable link and C's nullable pointer in an `extern\n");
    buf_bytes(out, b"\"C\"` signature; a C header's `_Nonnull` pointers import as NonNull (a\n");
    buf_bytes(out, b"result is C's promise, which the unsafe call vouches for). `_Nonnull`\n");
    buf_bytes(out, b"is clang's nullability qualifier: imports read headers as the system's\n");
    buf_bytes(out, b"C compiler does, so they see it where that compiler is clang (macOS);\n");
    buf_bytes(out, b"with gcc (most Linux systems) a header has no such qualifier and its\n");
    buf_bytes(out, b"pointers import as `*T`. Any `*T` has `p.is_null()`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"use std::NonNull;\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"struct Node { value: i64, next: Option<NonNull<Node>> }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() {\n");
    buf_bytes(out, b"    let b = Node { value: 2, next: None };\n");
    buf_bytes(out, b"    let a = Node { value: 1, next: NonNull::new(&b) };\n");
    buf_bytes(out, b"    var total = 0;\n");
    buf_bytes(out, b"    var cur = NonNull::new(&a);\n");
    buf_bytes(out, b"    while let Some(p) = cur {\n");
    buf_bytes(out, b"        unsafe {\n");
    buf_bytes(out, b"            total += (*p.as_ptr()).value;\n");
    buf_bytes(out, b"            cur = (*p.as_ptr()).next;\n");
    buf_bytes(out, b"        }\n");
    buf_bytes(out, b"    }\n");
    buf_bytes(out, b"    println(\"{total} {}\", size_of(Option<NonNull<Node>>));\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"3 8\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Enums as integers\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"#[repr(u8)]\n");
    buf_bytes(out, b"enum Level { Low = 1, Mid = 5, High = 9 }\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"fn main() -> i32 {\n");
    buf_bytes(out, b"    let l = Level::Mid;\n");
    buf_bytes(out, b"    std::print_int(l as i64);\n");
    buf_bytes(out, b"    if Level::Low < l { println(\" above low\"); }   // declaration order\n");
    buf_bytes(out, b"    let back = 9 as Level;                         // checked: 4 as Level exits 101\n");
    buf_bytes(out, b"    if back == Level::High { println(\"high\"); }\n");
    buf_bytes(out, b"    0\n");
    buf_bytes(out, b"}\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"5 above low\n");
    buf_bytes(out, b"high\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## Layout\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`size_of(T)` and `align_of(T)` are constants. Vole's own types have\n");
    buf_bytes(out, b"no guaranteed layout (field order, enum tags, slices); `#[repr(C)]`\n");
    buf_bytes(out, b"gives C's. See `volec guide c-interop`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"## SIMD vectors\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"`v4f32(a, b, c, d)`, `v4f32::splat(x)`, `v4f32::load(s, i)` (checked)\n");
    buf_bytes(out, b"make vectors; `+ - *` work lane by lane on all six types, `/` on float\n");
    buf_bytes(out, b"vectors, `& | ^` on integer ones; comparisons give a mask\n");
    buf_bytes(out, b"(`m.select(a, b)`); `v.lane(i)`, `v.with_lane(i, x)`, `v.sum()`,\n");
    buf_bytes(out, b"`v.store(s, i)`. They are not FFI-safe.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"| bytes | signed | unsigned (0.19) | float |\n");
    buf_bytes(out, b"|---|---|---|---|\n");
    buf_bytes(out, b"| 8 (0.19) | `v8i8 v4i16 v2i32 v1i64` | `v8u8 v4u16 v2u32 v1u64` | `v2f32 v1f64` |\n");
    buf_bytes(out, b"| 16 | `v16i8 v8i16 v4i32 v2i64` | `v16u8 v8u16 v4u32 v2u64` | `v4f32 v2f64` |\n");
    buf_bytes(out, b"| 32 (0.19) | `v32i8 v16i16 v8i32 v4i64` | `v32u8 v16u16 v8u32 v4u64` | `v8f32 v4f64` |\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"An unsigned vector compares unsigned, and its mask is itself (a lane all\n");
    buf_bytes(out, b"ones or 0); 32-byte vectors are two registers where the CPU has no wider\n");
    buf_bytes(out, b"ones. `T::from_bits(v)` reinterprets a vector of the same size, with no\n");
    buf_bytes(out, b"instruction. The CPU's own instructions on them (NEON, SSE, AVX2, CRC,\n");
    buf_bytes(out, b"AES, SHA) are `std::arch`'s: `volec guide arch`.\n");
    buf_bytes(out, b"\n");
    buf_bytes(out, b"```vole\n");
    buf_bytes(out, b"let xs: [f32; 4] = [1.0, 2.0, 3.0, 4.0];\n");
    buf_bytes(out, b"let v = v4f32::load(xs[..], 0) * v4f32::splat(2.0);\n");
    buf_bytes(out, b"std::print_int(v.sum() as i64);\n");
    buf_bytes(out, b"println(\"\");\n");
    buf_bytes(out, b"```\n");
    buf_bytes(out, b"```out\n");
    buf_bytes(out, b"20\n");
    buf_bytes(out, b"```\n");
}
