// std's API, for `volec guide std` (0.13): every public item of the
// standard library's source as this compiler embeds it
// (front/stdsrc.vl), with the comment above it. Functions and methods
// are their signatures, types and traits their declarations, and the
// trait impls are summed up by trait at the end. It is made from the
// source's text, written in one style: an item starts a line, and the
// braces of a body balance on its lines (tests/guide/run.sh compares the
// result with the compiler's item index).

use crate::base::{
    buf_append, buf_at, buf_byte, buf_bytes, buf_clear, buf_copy, buf_done, buf_len, buf_new,
    buf_truncate, intern,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::stdsrc_rust::std2_source;

// Whether s starts with p.
fn starts(s: &[u8], p: &[u8]) -> bool {
    s.len() >= p.len() && s[0..p.len()] == p
}

// Where p first occurs in s, or -1.
fn find(s: &[u8], p: &[u8]) -> i64 {
    let mut i: i64 = 0;
    while i + p.len() as i64 <= s.len() as i64 {
        if &s[i as usize..(i + p.len() as i64) as usize] == p {
            return i;
        }
        i += 1;
    }
    -1
}

// s without its leading blanks.
fn trim(s: &[u8]) -> &[u8] {
    let mut i: i64 = 0;
    while i < s.len() as i64 && s[i as usize] == b' ' {
        i += 1;
    }
    &s[i as usize..]
}

// s without its leading and trailing blanks.
fn trim_both(s: &[u8]) -> &[u8] {
    let t = trim(s);
    let mut e = t.len() as i64;
    while e > 0 && t[(e - 1) as usize] == b' ' {
        e -= 1;
    }
    &t[0..e as usize]
}

// s without a leading `pub `.
fn unpub(s: &[u8]) -> &[u8] {
    if starts(s, b"pub ") { &s[4..] } else { s }
}

// (0.16) A struct's declaration s (`struct V<T> { a: T, pub n: i64 }`)
// with its `pub` fields only, into out with a line break: the others are
// std's (a #[sealed] type's are not visible); none left, its name alone.
fn put_struct(out: i64, s: &[u8]) {
    let mut open: i64 = -1;
    let mut angle: i64 = 0;
    for i in 0..s.len() as i64 {
        if s[i as usize] == b'<' {
            angle += 1;
        } else if s[i as usize] == b'>' {
            angle -= 1;
        } else if s[i as usize] == b'{' && angle == 0 && open < 0 {
            open = i;
        }
    }
    if open < 0 || s[(s.len() as i64 - 1) as usize] != b'}' {
        put_line(out, b"", s);
        return;
    }
    let head = trim_both(&s[0..open as usize]);
    let body = &s[(open + 1) as usize..(s.len() as i64 - 1) as usize];
    let kept = buf_new();
    let mut depth: i64 = 0;
    let mut from: i64 = 0;
    for i in 0..body.len() as i64 + 1 {
        let c = if i < body.len() as i64 { body[i as usize] } else { b',' as u8 };
        if c == b'<' || c == b'(' || c == b'[' {
            depth += 1;
        } else if c == b'>' || c == b')' || c == b']' {
            depth -= 1;
        } else if c == b',' && depth == 0 {
            let field = trim_both(&body[from as usize..i as usize]);
            if starts(field, b"pub ") {
                if (buf_len(kept) as usize) > 0 {
                    buf_bytes(kept, b", ");
                }
                buf_bytes(kept, field);
            }
            from = i + 1;
        }
    }
    buf_bytes(out, head);
    if (buf_len(kept) as usize) > 0 {
        buf_bytes(out, b" { ");
        buf_append(out, kept);
        buf_bytes(out, b" }");
    }
    buf_bytes(out, b"\n");
}

// What line s changes the depth of braces by; braces in strings,
// characters and comments do not count.
fn brace_delta(s: &[u8]) -> i64 {
    let mut d: i64 = 0;
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let ch = s[i as usize];
        if ch == b'/' && i + 1 < s.len() as i64 && s[(i + 1) as usize] == b'/' {
            return d;
        }
        // (a lifetime, `'a`, is no character: one closes within its few
        // bytes, `'x'`, `'\n'`, `'\u{1F600}'`, a UTF-8 character's four)
        let n = s.len() as i64;
        let lifetime = ch == b'\'' && !(i + 1 < n && s[(i + 1) as usize] == b'\\')
            && !(i + 2 < n && s[(i + 2) as usize] == b'\'')
            && !(i + 1 < n && s[(i + 1) as usize] >= 128);
        if lifetime {
            i += 1;
            continue;
        }
        if ch == b'"' || ch == b'\'' {
            i += 1;
            while i < s.len() as i64 && s[i as usize] != ch {
                if s[i as usize] == b'\\' {
                    i += 1;
                }
                i += 1;
            }
        } else if ch == b'{' {
            d += 1;
        } else if ch == b'}' {
            d -= 1;
        }
        i += 1;
    }
    d
}

// A function's signature: its line up to the body, without `pub`.
fn signature(t: &[u8]) -> &[u8] {
    let u = unpub(t);
    let k = find(u, b" {");
    if k >= 0 { &u[0..k as usize] } else { u }
}

fn is_fn(t: &[u8]) -> bool {
    starts(t, b"pub fn ") || starts(t, b"pub unsafe fn ")
}

fn is_decl(t: &[u8]) -> bool {
    starts(t, b"pub struct ") || starts(t, b"pub enum ") || starts(t, b"pub union ")
        || starts(t, b"pub trait ") || starts(t, b"pub const ") || starts(t, b"pub static ")
        || starts(t, b"pub type ")
}

// Writes line s to out, after `indent` and with a line break.
fn put_line(out: i64, indent: &[u8], s: &[u8]) {
    buf_bytes(out, indent);
    buf_bytes(out, s);
    buf_bytes(out, b"\n");
}

// Writes the comment lines of buffer doc (each ends with a line break),
// indented, and empties doc.
fn put_doc(out: i64, doc: i64, indent: &[u8]) {
    let text = buf_copy(doc);
    let mut start: i64 = 0;
    while start < text.len() as i64 {
        let mut end = start;
        while end < text.len() as i64 && text[end as usize] != b'\n' {
            end += 1;
        }
        put_line(out, indent, &text[start as usize..end as usize]);
        start = end + 1;
    }
    buf_clear(doc);
}

// `impl<T: Hash> Hash for Pair<T>` (a trait impl's header, without its
// brace): the trait and the type.
fn trait_impl_parts(head: &[u8]) -> (&[u8], &[u8]) {
    let mut rest = &head[4..];
    if starts(rest, b"<") {
        let close = find(rest, b">");
        rest = &rest[(close + 1) as usize..];
    }
    rest = trim(rest);
    let k = find(rest, b" for ");
    (&rest[0..k as usize], &rest[(k + 5) as usize..])
}

// What std_api writes: every item with its comment (`guide std#api`);
// (0.15) the signatures of what the core guide teaches, without comments
// (`guide --full`); (0.17) the index, `guide std`: every item a program
// uses, its signature on one line, `self: *Self` for the receiver's type.
pub const API_DOC: i64 = 0;
pub const API_CORE: i64 = 1;
pub const API_INDEX: i64 = 2;

// (0.17) Whether a section banner of std's source (`// ---- Gpa's
// implementation (0.16) ----`) is about std's own workings: not in the
// index.
fn internal_section(t: &[u8]) -> bool {
    find(t, b"implementation") >= 0 || find(t, b"leak checks") >= 0 || find(t, b"hooks") >= 0
        || find(t, b"holes") >= 0 || find(t, b"ambient") >= 0
}

// (0.17) Whether the index leaves out a section of std's source: the
// allocators (`guide allocators`), the bit operations and (0.18.1) the
// heaps (their section of `guide std`), (0.20) number conversion, and
// the other sections new in 0.20 (until 0.20 lists them), which
// INDEX_ALSO names, and (0.23) std::window's, (0.25.2.1) std::math's,
// (0.25.4) the scripted event loop's and the frame capture's.
fn unindexed_section(t: &[u8]) -> bool {
    internal_section(t) || find(t, b"Allocation (0.16)") >= 0 || t == b"// ---- Gpa ----"
        || find(t, b"Arenas (0.16)") >= 0 || find(t, b"FixedBuf (0.16)") >= 0
        || find(t, b"Bits (0.16)") >= 0 || find(t, b"Heaps (0.18.1)") >= 0
        || find(t, b"Numbers: ") >= 0
        // (0.20) the other sections new in 0.20, until 0.20 lists them (B7)
        || find(t, b"(0.20)") >= 0
        // (0.23) std::window: its own guide topic, not the index
        || find(t, b"(0.23)") >= 0
        // (0.21) atomics, threads and locks: guide threads
        || find(t, b"(0.21)") >= 0
        // (0.24) std::cli: guide cli
        || find(t, b"(0.24)") >= 0
        // (0.25.2.1) std::math: guide math
        || find(t, b"Math: ") >= 0
        // (0.25.4) std::window's scripted loop (guide window) and the
        // frame capture it asks std::gpu for (gpu::capture_next_frame)
        || find(t, b"Windows: ") >= 0 || find(t, b"Frame capture (") >= 0
        // (0.26.1) std::cell: guide memory#cells
        || find(t, b"Cells: ") >= 0
        // (0.26.3) the integers' wrapping_*, checked_*, overflowing_*,
        // saturating_*: guide types#numbers
        || find(t, b"Integer arithmetic: ") >= 0
}

// The module a banner of embed.sh names (`// ---- mod std::a::b ----`,
// `// ---- end mod std::a::b ----`): `a::b`, what follows the banner's
// first `from` bytes without its ` ----`.
fn banner_module(t: &[u8], from: i64) -> &[u8] {
    let n = t.len() as i64;
    if n < from + 5 {
        return b"";
    }
    &t[from as usize..(n - 5) as usize]
}

// (0.28.0) Whether the index leaves out std's module `m` (its path after
// `std::`): the ones with a topic of their own, std's own workings, and
// what programs seldom name (INDEX_ALSO says where they are).
fn index_hides(m: &[u8]) -> bool {
    let names: &[&[u8]] = &[b"sys", b"unicode", b"fmath", b"cli", b"test", b"thread", b"sync",
        b"process", b"path", b"time", b"hash", b"intconv", b"flt", b"random", b"cell", b"alloc",
        b"boxed", b"ptr", b"panic", b"marker", b"borrow", b"capture", b"array", b"window",
        b"prelude", b"char", b"collections::btree_map", b"collections::binary_heap",
        b"iter::adapters", b"iter::sources", b"fs", b"env", b"num", b"mem", b"ops", b"convert",
        b"clone", b"default"];
    for &n in names {
        if m == n {
            return true;
        }
    }
    false
}

// (0.17) Whether the index leaves out item `name` (of the impl of
// `owner`, "" outside one): what programs seldom call by name, which
// INDEX_ALSO names.
fn unindexed(owner: &[u8], name: &[u8]) -> bool {
    if owner.len() > 0 {
        // (0.28.0: a Debug impl's builders and its Formatter, a map's
        // entries: guide formatting, guide std#overview)
        return owner.len() > 5 && owner[0..5] == b"Debug" || owner == b"Formatter"
            || owner == b"Entry" || owner == b"OccupiedEntry" || owner == b"VacantEntry";
    }
    // (the operator traits: `Add`, `Rem`, `BitAnd`, `Shl`, and their
    // `...Assign`)
    let n = name.len() as i64;
    if n > 6 && name[(n - 6) as usize..] == b"Assign" {
        return true;
    }
    name == b"Add" || name == b"Sub" || name == b"Mul" || name == b"Div" || name == b"Neg"
        || name == b"Rem" || name == b"Not" || name == b"BitAnd" || name == b"BitOr"
        || name == b"BitXor" || name == b"Shl" || name == b"Shr" || name == b"main_error"
        || name == b"contract_check" || name == b"SliceIndex" || name == b"Pattern"
        // (0.28.0: std's own helpers, and the traits behind `{:x}`, `{:e}`,
        // `{:p}` and a range's steps)
        || name == b"lossy_next" || name == b"ascii_printable_prefix_len" || name == b"Step"
        || name == b"LowerHex" || name == b"UpperHex" || name == b"Octal" || name == b"Binary"
        || name == b"LowerExp" || name == b"UpperExp" || name == b"Pointer"
}

// (0.17) The index's last line: what it leaves out, and where it is.
const INDEX_ALSO: &[u8] =
    b"// Also, in guide std#every-item: Rust's traits as Rust has them (std::ops: Deref, Index, Drop, the ranges, the operators; std::convert: From, Into, TryFrom, AsRef; Clone; Default); the iterator adapters' types; the allocators (std::alloc: guide allocators); BinaryHeap, MinHeap, BTreeMap (std::collections); std::fs, std::path, std::env, std::process (guide io); std::sync and std::thread (guide threads); std::cell (guide memory#cells); std::cli (guide cli); std::time, std::hash, std::random, std::char, std::num, std::mem, std::ptr, std::boxed, std::unicode, std::test (guide testing).";

// (0.17) The name an item line of std's listing declares (`fn split_in<A:
// ...`, `unsafe fn panic(`, `struct Scanner`, `enum IoError {`, `trait
// Ord {`), and whether it is a type or trait; "" when it declares none.
pub fn item_name(t: &[u8]) -> (&[u8], bool) {
    let mut r = unpub(t);
    if starts(r, b"unsafe ") {
        r = &r[7..];
    }
    let mut ty = false;
    if starts(r, b"fn ") {
        r = &r[3..];
    } else if starts(r, b"struct ") {
        r = &r[7..];
        ty = true;
    } else if starts(r, b"enum ") || starts(r, b"trait ") {
        r = &r[((if starts(r, b"enum ") { 5 } else { 6 })) as usize..];
        ty = true;
    } else {
        return (b"", false);
    }
    let mut e: i64 = 0;
    while e < r.len() as i64 && name_byte(r[e as usize]) {
        e += 1;
    }
    (&r[0..e as usize], ty)
}

fn name_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') || c == b'_'
}

// (0.17) The type an impl header is for, by name: `Vec` for `impl<T, A:
// Allocator> Vec<T, A> {`, `Scanner` for `impl Scanner {`.
pub fn impl_name(h: &[u8]) -> &[u8] {
    let mut r = &h[4..];
    if starts(r, b"<") {
        let mut depth: i64 = 0;
        let mut i: i64 = 0;
        while i < r.len() as i64 {
            if r[i as usize] == b'<' {
                depth += 1;
            } else if r[i as usize] == b'>' {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }
            i += 1;
        }
        r = &r[(i + 1) as usize..];
    }
    r = trim(r);
    let mut e: i64 = 0;
    while e < r.len() as i64 && name_byte(r[e as usize]) {
        e += 1;
    }
    &r[0..e as usize]
}

// (0.17) Writes signature s after `indent`, with a line break; in the
// index (`short`), the receiver's type as `Self`: `fn push(self: *Self,
// x: T)` for `fn push(self: *Vec<T, A>, x: T)`.
fn put_sig(out: i64, indent: &[u8], s: &[u8], short: bool) {
    let k = find(s, b"(self: ");
    if !short || k < 0 {
        put_line(out, indent, s);
        return;
    }
    let mut i = k + 7;
    let ptr = s[i as usize] == b'*';
    // (0.17: `&Self`, `&mut Self`)
    let rest = &s[i as usize..];
    let shared = starts(rest, b"&") && !starts(rest, b"&mut ");
    let exclusive = starts(rest, b"&mut ");
    let mut depth: i64 = 0;
    while i < s.len() as i64 {
        let c = s[i as usize];
        if c == b'<' || c == b'(' || c == b'[' {
            depth += 1;
        } else if c == b'>' || c == b']' {
            depth -= 1;
        } else if c == b')' {
            if depth == 0 {
                break;
            }
            depth -= 1;
        } else if c == b',' && depth == 0 {
            break;
        }
        i += 1;
    }
    buf_bytes(out, indent);
    buf_bytes(out, &s[0..(k + 1) as usize]);
    buf_bytes(out, if ptr { b"self: *Self" } else if exclusive { b"self: &mut Self" }
        else if shared { b"self: &Self" } else { b"self: Self" });
    buf_bytes(out, &s[i as usize..]);
    buf_bytes(out, b"\n");
}

// Writes std's API to buffer out, in `mode` (API_DOC, API_CORE,
// API_INDEX).
pub fn std_api(out: i64, mode: i64, pcx: &mut Ctx<Comp>) {
    // (0.15) The core guide's form: the signatures only, without their
    // comments; (0.17) the index too.
    let core = mode != API_DOC;
    let index = mode == API_INDEX;
    let src = buf_new();
    std2_source(src);
    let text = buf_copy(src);
    let doc = buf_new();
    let decl = buf_new();
    let sig = buf_new();
    // (symbols: the compiler's source keeps off std's containers, 0.16)
    let mut impl_traits: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut impl_types: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut depth: i64 = 0;
    // In an impl of a type's own methods: its header, printed before its
    // first public method.
    let mut in_impl = false;
    let mut impl_head: &[u8] = b"";
    let mut head_done = false;
    // (0.16) The type of the impl block just closed, and where its `}`
    // starts: in the core guide, a block of the same type right after it
    // (`impl<T, A: Allocator + GlobalAllocator> Vec<T, A>`, then `impl<T,
    // A: Allocator> Vec<T, A>`) continues it.
    let mut closed_type: &[u8] = b"";
    let mut closed_at: i64 = -1;
    // (0.14) In a trait of several lines: its items' signatures are
    // printed, not their default bodies.
    let mut in_trait = false;
    // (0.17) A trait the index leaves out: its lines are skipped.
    let mut hide_trait = false;
    // A declaration whose braces close on a later line, joined into one.
    let mut joining = false;
    // (0.16) In the core guide, the sections 0.16 adds (their banners say
    // `(0.16`) are left out, as 0.15's were until its guide was made: the
    // allocators, arenas, Gpa (`volec guide std` lists them).
    let mut skipping = false;
    let mut hide_fn = false;
    // (0.16) After `#[sealed]`: the struct's fields are std's own, so it
    // is shown as `struct Vec<T, A: Allocator = Gpa> { .. }`; its body's
    // lines are skipped.
    let mut sealed = false;
    let mut sealed_body = false;
    // (0.20) The line after a module's banner in the built-in text: its
    // `mod NAME {` or `}` (embed.sh), not std's API.
    let mut wrapper = false;
    let mut in_use = false;
    // (0.22) std::gpu and std::objc have guide topics of their own: their
    // modules are not in std's listing (every-item, the index)
    let mut own_topic: i64 = 0;
    // (0.28.0) The module the index is leaving out (its path after
    // `std::`), "" when in none.
    let mut hidden: &[u8] = b"";
    let mut start: i64 = 0;
    if index {
        put_line(out, b"",
            b"// Signatures only; with their comments: volec guide std#every-item.");
    } else if core {
        put_line(out, b"", b"// Signatures only; with their comments: volec guide std.");
    }
    while start < text.len() as i64 {
        let mut end = start;
        while end < text.len() as i64 && text[end as usize] != b'\n' {
            end += 1;
        }
        let mut line = &text[start as usize..end as usize];
        start = end + 1;
        // (0.18) A signature fmt wrapped inside its generics or parameters
        // (`fn gen_result<T, E, F: Fn(&mut Gen) -> T,`), joined into one.
        if (is_fn(trim(line)) || starts(trim(line), b"fn ")) && line.len() > 0
            && (line[(line.len() as i64 - 1) as usize] == b','
                || line[(line.len() as i64 - 1) as usize] == b'('
                || line[(line.len() as i64 - 1) as usize] == b'<') {
            let joined = buf_new();
            buf_bytes(joined, line);
            while start < text.len() as i64 {
                let mut e = start;
                while e < text.len() as i64 && text[e as usize] != b'\n' {
                    e += 1;
                }
                let next = trim(&text[start as usize..e as usize]);
                let last = buf_at(joined, buf_len(joined) - 1);
                if last != b'(' && last != b'<' {
                    buf_byte(joined, b' ');
                }
                buf_bytes(joined, next);
                start = e + 1;
                if next.len() == 0
                    || next[(next.len() as i64 - 1) as usize] != b','
                    && next[(next.len() as i64 - 1) as usize] != b'('
                    && next[(next.len() as i64 - 1) as usize] != b'<' {
                    break;
                }
            }
            line = buf_done(joined);
        }
        let t = trim(line);
        // (0.20) std's modules: their items are listed as the root's are
        if starts(t, b"// ---- mod std::gpu") || starts(t, b"// ---- mod std::objc") {
            own_topic += 1;
        }
        if own_topic > 0 {
            if starts(t, b"// ---- end mod std::gpu") || starts(t, b"// ---- end mod std::objc") {
                own_topic -= 1;
                // (the module's closing brace, on the next line)
                wrapper = own_topic == 0;
            }
            continue;
        }
        // (0.28.0) the index leaves out the modules index_hides names
        if hidden.len() > 0 {
            if starts(t, b"// ---- end mod std::") && banner_module(t, 21) == hidden {
                hidden = b"";
                wrapper = true;
            }
            continue;
        }
        if index && starts(t, b"// ---- mod std::") && index_hides(banner_module(t, 17)) {
            hidden = banner_module(t, 17);
            continue;
        }
        if starts(t, b"// ---- mod std::") || starts(t, b"// ---- end mod std::") {
            // (a module's items before its first banner are a section of
            // their own: listed)
            wrapper = true;
            skipping = false;
            continue;
        }
        if wrapper {
            wrapper = false;
            continue;
        }
        if in_use || starts(t, b"pub mod ") || starts(t, b"pub use ") || starts(t, b"use ") {
            in_use = (in_use || starts(t, b"pub use ") || starts(t, b"use ")) && find(t, b";") < 0;
            continue;
        }
        let before = depth;
        depth += brace_delta(line);
        if core && before == 0 && starts(t, b"// ----") {
            skipping = if index { unindexed_section(t) } else { find(t, b"(0.16") >= 0 };
        }
        if skipping {
            continue;
        }
        // (0.16: std's ambient functions, errors outside std, are not
        // in the core guide, and marked in `guide std`: front/ambient.vl)
        if starts(t, b"#[ambient(") {
            if core {
                hide_fn = true;
            } else {
                let what = &t[11..(t.len() as i64 - 3) as usize];
                buf_bytes(doc, b"// (0.16) An error: allocation is explicit; write ");
                buf_bytes(doc, what);
                buf_bytes(doc, b".\n");
            }
            continue;
        }
        // (0.17: a `#[views(..)]` or `#[stores(..)]` pin keeps the comment
        // above it for the item below)
        if starts(t, b"#[views(") || starts(t, b"#[stores(") {
            continue;
        }
        if hide_fn && (is_fn(t) || starts(t, b"fn ")) {
            hide_fn = false;
            buf_clear(doc);
            continue;
        }
        if sealed_body {
            sealed_body = depth > 0;
            continue;
        }
        if before == 0 && t == b"#[sealed]" {
            sealed = true;
            continue;
        }
        if joining {
            buf_bytes(decl, b" ");
            buf_bytes(decl, t);
            if depth == 0 {
                // (`a: i64, }`: the last field's comma goes)
                let joined = buf_copy(decl);
                let n = joined.len() as i64;
                if core && starts(&joined, b"struct ") {
                    put_struct(out, &joined);
                } else if n >= 3 && joined[(n - 3) as usize..] == b", }" {
                    buf_bytes(out, &joined[0..(n - 3) as usize]);
                    put_line(out, b"", b" }");
                } else {
                    put_line(out, b"", &joined);
                }
                joining = false;
            }
            continue;
        }
        if before == 0 {
            if starts(t, b"//") {
                if !core {
                    put_line(doc, b"", t);
                }
                continue;
            }
            // (0.16: the core guide leaves out std's aliases of the builtin
            // limits, `I32_MAX` for `i32::MAX`)
            if core && starts(t, b"pub const ")
                && (find(t, b"::MIN;") >= 0 || find(t, b"::MAX;") >= 0) {
                buf_clear(doc);
                continue;
            }
            if index && (find(t, b"fn __") >= 0 || unindexed(b"", item_name(t).0)) {
                // (0.17: what std's own f-strings call, and what the
                // index leaves out; a trait of several lines: its items too)
                if (starts(t, b"pub trait ") || starts(t, b"pub unsafe trait ")) && depth > 0 {
                    in_trait = true;
                    hide_trait = true;
                }
            } else if index && starts(t, b"pub struct ") && find(t, b"<'") >= 0 {
                // (0.28.0: a type that borrows, an iterator's or a guard's:
                // its method says it, `fn iter(&self) -> Iter<'_, T>`)
                sealed_body = depth > 0;
                sealed = false;
            } else if is_fn(t) {
                put_doc(out, doc, b"");
                put_sig(out, b"", signature(t), index);
            } else if (starts(t, b"pub trait ") || starts(t, b"pub unsafe trait ")) && depth > 0 {
                put_doc(out, doc, b"");
                buf_bytes(out, signature(t));
                put_line(out, b"", b" {");
                in_trait = true;
            } else if sealed && starts(t, b"pub struct ") && find(t, b"{") > 0 {
                put_doc(out, doc, b"");
                buf_bytes(out, trim(&unpub(t)[0..find(unpub(t), b"{") as usize]));
                put_line(out, b"", b" { .. }");
                sealed_body = depth > 0;
                sealed = false;
            } else if is_decl(t) {
                put_doc(out, doc, b"");
                if depth == 0 && core && starts(unpub(t), b"struct ") {
                    put_struct(out, unpub(t));
                } else if depth == 0 {
                    put_line(out, b"", unpub(t));
                } else {
                    buf_clear(decl);
                    buf_bytes(decl, unpub(t));
                    joining = true;
                }
            } else if (starts(t, b"impl") || starts(t, b"unsafe impl")) && depth > 0 {
                // (0.26.3: `unsafe impl Allocator for Gpa`, the trait and the type)
                let head = signature(if starts(t, b"unsafe ") { &t[7..] } else { t });
                if find(head, b" for ") >= 0 {
                    let parts = trait_impl_parts(head);
                    impl_traits.push(intern(parts.0, pcx));
                    impl_types.push(intern(parts.1, pcx));
                } else {
                    in_impl = true;
                    impl_head = head;
                    head_done = false;
                }
            }
            // (an attribute keeps the comment above it for its item)
            if !starts(t, b"#[") {
                sealed = false;
                buf_clear(doc);
            }
            continue;
        }
        if in_trait && hide_trait {
            if depth == 0 {
                in_trait = false;
                hide_trait = false;
            }
            continue;
        }
        if in_trait && before == 1 {
            if starts(t, b"//") {
                if !core {
                    put_line(doc, b"", t);
                }
                continue;
            }
            if starts(t, b"fn ") || starts(t, b"type ") {
                put_doc(out, doc, b"    ");
                put_sig(out, b"    ", signature(t), index);
            }
            if !starts(t, b"#[") {
                buf_clear(doc);
            }
        }
        if in_trait && depth == 0 {
            put_line(out, b"", b"}");
            in_trait = false;
        }
        if in_impl && before == 1 {
            if starts(t, b"//") {
                if !core {
                    put_line(doc, b"", t);
                }
                continue;
            }
            if is_fn(t) && index
                && (find(t, b"fn __") >= 0 || unindexed(impl_name(impl_head), item_name(t).0)) {
                buf_clear(doc);
            } else if is_fn(t) {
                if !head_done && core && closed_at >= 0
                    && buf_len(out) == closed_at + 2
                    && impl_type(impl_head) == closed_type {
                    buf_truncate(out, closed_at);
                    head_done = true;
                }
                if !head_done {
                    buf_bytes(out, impl_head);
                    put_line(out, b"", b" {");
                    head_done = true;
                }
                put_doc(out, doc, b"    ");
                put_sig(out, b"    ", signature(t), index);
            }
            if !starts(t, b"#[") {
                buf_clear(doc);
            }
        }
        if in_impl && depth == 0 {
            if head_done {
                closed_at = buf_len(out);
                closed_type = impl_type(impl_head);
                put_line(out, b"", b"}");
            }
            in_impl = false;
        }
    }
    // The trait impls, by trait, in the order of their first impl.
    let traits = impl_traits.as_slice();
    let types = impl_types.as_slice();
    // (0.28.0: not in the index: a type's traits are in std#every-item)
    if traits.len() > 0 && !index {
        put_line(out, b"", b"// Trait impls (their methods are the traits'):");
    }
    for i in 0..(if index { 0 } else { traits.len() as i64 }) {
        let mut first = true;
        for j in 0..i {
            if traits[j as usize] == traits[i as usize] {
                first = false;
            }
        }
        if !first
            || (index
                && (sym_text(traits[i as usize], pcx) == b"Iterator"
                    || sym_text(traits[i as usize], pcx) == b"Allocator")) {
            continue;
        }
        buf_bytes(out, b"impl ");
        buf_bytes(out, sym_text(traits[i as usize], pcx));
        buf_bytes(out, b" for ");
        let mut sep = "";
        for j in i..traits.len() as i64 {
            if traits[j as usize] == traits[i as usize] {
                buf_bytes(out, sep.as_bytes());
                buf_bytes(out, sym_text(types[j as usize], pcx));
                sep = ", ";
            }
        }
        buf_bytes(out, b"\n");
    }
    if index {
        put_line(out, b"", INDEX_ALSO);
    }
}

// The type of impl header h (`impl<T, A: Allocator> Vec<T, A>`: `Vec<T,
// A>`): what follows its last `> `.
fn impl_type(h: &[u8]) -> &[u8] {
    let mut i = h.len() as i64 - 2;
    while i >= 0 {
        if h[i as usize] == b'>' && h[(i + 1) as usize] == b' ' {
            return &h[(i + 2) as usize..];
        }
        i -= 1;
    }
    h
}

fn sym_text(s: i64, pcx: &Ctx<Comp>) -> &'static [u8] {
    crate::base::sym_text(s, pcx)
}
