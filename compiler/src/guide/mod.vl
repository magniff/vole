// `volec guide` (0.13): the language, taught by the compiler that
// implements it, for a reader who has never seen vole. The text is
// compiler/guide/*.md, built into the compiler by compiler/guide/embed.sh
// (text/, as std's source is into front/stdsrc.vl), so it matches the
// compiler it comes with; std's API is made from std's embedded source
// when it is printed (stdapi.vl). tests/guide/run.sh compiles and runs
// every example in it.
//
//   volec guide              the core guide (the default topic)
//   volec guide TOPIC...     the topics, in turn (0.18.1: up to a
//                               `@PAGE-END@` line; --whole: all of it)
//   volec guide --list       NAME TAB SIZE TAB SUMMARY per topic, SIZE
//                               as `N tokens` (bytes / 4)
//   volec guide --all        every topic, in order
//   volec guide --full       (0.17) the long form: topic language,
//                               with std's API in it

pub mod text;
mod stdapi;
pub mod find;

use crate::base::{
    STDERR, STDOUT, buf_append, buf_bytes, buf_copy, buf_int, buf_len, buf_new, buf_str,
    buf_write_fd,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::cli::line::{
    Call, EV_OPTION, EV_WORD, Ev, Leaf, Line, flag, is_flag, is_missing, is_opt, option, table,
};
use crate::guide::find::{FIND_BUDGET, guide_find, guide_section, put_sections_try};
use crate::guide::stdapi::{API_CORE, API_DOC, API_INDEX, std_api};
use crate::guide::text::{TOPIC_COUNT, topic_name, topic_summary, topic_text};

// The topic named `name`, or -1.
fn topic_of(name: &[u8]) -> i64 {
    for i in 0..TOPIC_COUNT {
        if topic_name(i) == name {
            return i;
        }
    }
    -1
}

// Writes topic i to buffer out, with its placeholder lines filled in:
// `@STD-API@` (std's API: 0.17, its index; `@STD-API-DOC@`, render_doc),
// `@TOPICS@` (the other topics,
// a line each), (0.17) `@TOPIC-NAMES@` (their names, on one line) and
// `@STD-API-FULL@` (std's API, signatures only, in `guide --full`; else
// nothing). The whole topic: a `@PAGE-END@` line is left out (render_page).
pub fn render(i: i64, out: i64, pcx: &mut Ctx<Comp>) {
    render_in(i, out, false, false, false, pcx);
}

// (0.17) render, with the section `@STD-API-DOC@` makes (every item of
// std with its comment): for `guide TOPIC#SECTION` (`guide std#every-item`).
pub fn render_doc(i: i64, out: i64, pcx: &mut Ctx<Comp>) {
    render_in(i, out, false, true, false, pcx);
}

// (0.18.1) `guide TOPIC`: the topic's first page, up to its line
// `@PAGE-END@ TEXT` (std: the most used items, 4k characters of its 18k),
// then TEXT, which says where the rest is (`guide std#the-api`); the
// whole topic with --whole, in --all and --find, and a section at a time
// (`TOPIC#SECTION`). The 0.18 eval's agents read all of `guide std` before
// writing a line (Haiku in 40 of 60 runs) for the few items they used.
fn render_page(i: i64, out: i64, pcx: &mut Ctx<Comp>) {
    render_in(i, out, false, false, true, pcx);
}

// render, with `full`: `guide --full` (0.17), the long form with std's
// API in it; with `doc` (0.17), `@STD-API-DOC@` as std's API with its
// comments, a section of its own; with `page` (0.18.1), up to the line
// `@PAGE-END@ TEXT`, then TEXT (render_page).
fn render_in(i: i64, out: i64, full: bool, doc: bool, page: bool, pcx: &mut Ctx<Comp>) {
    let raw = buf_new();
    topic_text(i, raw);
    let text = buf_copy(raw);
    let mut start: i64 = 0;
    while start < text.len() as i64 {
        let mut end = start;
        while end < text.len() as i64 && text[end as usize] != b'\n' {
            end += 1;
        }
        let line = &text[start as usize..end as usize];
        if line.len() >= 10 && line[0..10] == b"@PAGE-END@" {
            if page {
                let mut from: i64 = 10;
                while from < line.len() as i64 && line[from as usize] == b' ' {
                    from += 1;
                }
                buf_bytes(out, &line[from as usize..]);
                buf_bytes(out, b"\n");
                return;
            }
        } else if line == b"@STD-API@" {
            std_api(out, API_INDEX, pcx);
        } else if line == b"@STD-API-DOC@" {
            // (0.17: a section of its own, only for `guide std#every-item`)
            if doc {
                buf_bytes(out, b"## Every item with its comment\n\n```text\n");
                std_api(out, API_DOC, pcx);
                buf_bytes(out, b"```\n");
            }
        } else if line == b"@STD-API-FULL@" {
            if full {
                buf_bytes(out, b"\n```text\n");
                std_api(out, API_CORE, pcx);
                buf_bytes(out, b"```\n");
            }
        } else if line == b"@TOPICS@" {
            topic_lines(out);
        } else if line == b"@TOPIC-NAMES@" {
            topic_names(out);
        } else {
            buf_bytes(out, line);
            buf_bytes(out, b"\n");
        }
        start = end + 1;
    }
}

// The topics but the core, one line each, for the core guide's end.
fn topic_lines(out: i64) {
    for i in 1..TOPIC_COUNT {
        buf_bytes(out, b"- `");
        buf_bytes(out, topic_name(i));
        buf_bytes(out, b"`: ");
        buf_bytes(out, topic_summary(i));
        buf_bytes(out, b"\n");
    }
}

// The topics but the core, by name on one line (0.17), for the short
// core guide's end: `rust` `syntax` ...
fn topic_names(out: i64) {
    for i in 1..TOPIC_COUNT {
        if i > 1 {
            buf_bytes(out, b" ");
        }
        buf_bytes(out, b"`");
        buf_bytes(out, topic_name(i));
        buf_bytes(out, b"`");
    }
    buf_bytes(out, b"\n");
}

// --list: each topic with its size, in tokens at 4 bytes a token.
fn list(out: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..TOPIC_COUNT {
        let b = buf_new();
        render(i, b, pcx);
        buf_bytes(out, topic_name(i));
        buf_bytes(out, b"\t");
        buf_int(out, (buf_len(b) + 2) / 4);
        buf_bytes(out, b" tokens\t");
        buf_bytes(out, topic_summary(i));
        buf_bytes(out, b"\n");
    }
}

fn usage(out: i64) {
    buf_bytes(out,
        b"usage: volec guide [TOPIC[#SECTION]...] [--list] [--all] [--full] [--whole] [--find WORDS] [--budget N]\n");
    buf_bytes(out, b"  (no TOPIC)   the core guide: Rust habits, std, first errors, the loop\n");
    buf_bytes(out, b"  TOPIC...     the topics, in turn (a long one, as std: its first page, and where the rest is)\n");
    buf_bytes(out, b"  --whole      a topic whole, without its page end (guide std --whole)\n");
    buf_bytes(out, b"  --list       the topics, with their sizes\n");
    buf_bytes(out, b"  --all        every topic\n");
    buf_bytes(out, b"  --full       the long form (topic language), with std's API\n");
    buf_bytes(out, b"  TOPIC#SECTION  one section (TOPIC#: its sections; TOPIC SECTION... too)\n");
    buf_bytes(out, b"  how [TASK]   recipes for \"add an X\" (guide how add-std-fn)\n");
    buf_bytes(out, b"  --find WORDS   the paragraphs about WORDS, each under # TOPIC#SECTION\n");
    buf_bytes(out, b"  --budget N     about N tokens at most (--find: 1000 by default)\n");
}

// `guide`'s arguments (0.25.2: a leaf of volec's Command tree, cli/tree.vl).
pub fn guide_leaf(gpa: Gpa) -> Leaf<'static, Gpa> {
    let mut opts = table(gpa);
    opts.push(option("budget", "N", "the answer cut to about N tokens"));
    opts.push(flag("whole", "a topic without its page end"));
    opts.push(flag("find", "the paragraphs about the words after it"));
    opts.push(flag("list", "the topics"));
    opts.push(flag("all", "every topic"));
    opts.push(flag("full", "the long form, std's API in it"));
    let mut help = flag("help", "this help");
    help.short = b'h';
    opts.push(help);
    Leaf::new(opts, "topic")
}

// `volec guide ...`; the exit status: 0, 1 (a topic or section that
// does not exist, or nothing found; the others are printed) or 2 (a
// usage error).
pub fn run_guide(c: &Call<'_, Gpa>, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    let err = buf_new();
    let prog = c.prog();
    let mut status: i64 = 0;
    let mut any = false;
    // (0.15: --budget N anywhere; --find takes the words after it)
    let mut budget: i64 = -1;
    let mut find: i64 = -1;
    // (0.18.1: --whole, a topic without its page end; render_page)
    let mut whole = false;
    let line = c.evs.clone();
    for ev in line.iter().copied() {
        if is_flag(ev, "whole") {
            whole = true;
        }
        if is_opt(ev, "budget") || is_missing(ev, "budget") {
            let n: i64 = if ev.kind == EV_OPTION { parse_tokens(ev.value) } else { -1 };
            if n < 0 {
                buf_bytes(err, b"error guide.usage: --budget needs a number of tokens\ntry: ");
                buf_str(err, prog);
                buf_bytes(err, b" guide --find WORDS --budget 1000\n");
                buf_write_fd(err, STDERR);
                return 2;
            }
            budget = n;
        }
        if is_flag(ev, "find") && find < 0 {
            find = ev.at;
        }
    }
    if find >= 0 {
        let q = buf_new();
        for k in find + 1..c.line.len() {
            if c.word(k) == "--budget" {
                break;
            }
            if (buf_len(q) as usize) > 0 {
                buf_bytes(q, b" ");
            }
            buf_bytes(q, c.word(k).as_bytes());
        }
        return find_command(prog, &buf_copy(q), budget, pcx);
    }
    let mut j: i64 = 0;
    while j < line.len() as i64 {
        let ev = line[j as usize];
        let name = ev.text.as_bytes();
        let n = name.len();
        j += 1;
        if is_opt(ev, "budget") || is_flag(ev, "whole") {
            continue;
        }
        any = true;
        if is_flag(ev, "list") {
            list(out, pcx);
        } else if is_flag(ev, "all") {
            for i in 0..TOPIC_COUNT {
                render(i, out, pcx);
            }
        } else if is_flag(ev, "full") {
            // (0.17: the long form, std's API in it)
            render_in(topic_of(b"language"), out, true, false, false, pcx);
        } else if is_flag(ev, "help") {
            usage(out);
        } else if ev.kind != EV_WORD || (n > 0 && name[0] == b'-') {
            buf_bytes(err, b"error guide.usage: unknown option '");
            buf_bytes(err, name);
            buf_bytes(err, b"'\ntry: ");
            buf_str(err, prog);
            buf_bytes(err, b" guide --help\n");
            buf_write_fd(out, STDOUT);
            buf_write_fd(err, STDERR);
            return 2;
        } else {
            // (TOPIC#SECTION, 0.15)
            let mut hash: i64 = 0;
            while hash < name.len() as i64 && name[hash as usize] != b'#' {
                hash += 1;
            }
            let i = topic_of(&name[0..hash as usize]);
            if i < 0 {
                buf_bytes(err, b"error guide.no-topic: no topic '");
                buf_bytes(err, &name[0..hash as usize]);
                buf_bytes(err, b"'\ntry: ");
                buf_str(err, prog);
                buf_bytes(err, b" guide --list\n");
                status = 1;
            } else if hash < name.len() as i64 {
                if !guide_section(i, &name[(hash + 1) as usize..], out, pcx) {
                    buf_bytes(err, b"error guide.no-section: no section '");
                    buf_bytes(err, &name[(hash + 1) as usize..]);
                    buf_bytes(err, b"' in ");
                    buf_bytes(err, &name[0..hash as usize]);
                    buf_bytes(err, b"\n");
                    put_sections_try(err, prog, i, pcx);
                    status = 1;
                }
            } else if j < line.len() as i64 && is_section(line[j as usize]) {
                // (0.17: TOPIC SECTION..., `guide how add-std-fn`: the
                // words after a topic that are no topics, its sections)
                while j < line.len() as i64 && is_section(line[j as usize]) {
                    let want = line[j as usize].text.as_bytes();
                    j += 1;
                    if !guide_section(i, want, out, pcx) {
                        buf_bytes(err, b"error guide.no-section: no section '");
                        buf_bytes(err, want);
                        buf_bytes(err, b"' in ");
                        buf_bytes(err, name);
                        buf_bytes(err, b"\n");
                        put_sections_try(err, prog, i, pcx);
                        status = 1;
                    }
                }
            } else if whole {
                render(i, out, pcx);
            } else {
                render_page(i, out, pcx);
            }
        }
    }
    if !any {
        render(0, out, pcx);
    }
    write_within(out, budget, c.line, err);
    buf_write_fd(err, STDERR);
    status
}

// Whether ev is a word after a topic that is a section of it: no option,
// no topic.
fn is_section(ev: Ev<'_>) -> bool {
    ev.kind == EV_WORD && !ev.text.starts_with("-") && topic_of(ev.text.as_bytes()) < 0
}

// A number of tokens, or -1.
fn parse_tokens(s: *const u8) -> i64 {
    let t = crate::base::cstr(s);
    let mut n: i64 = 0;
    for &c in t.as_slice() {
        if c < b'0' || c > b'9' {
            return -1;
        }
        n = n * 10 + (c - b'0') as i64;
    }
    if t.len() == 0 { -1 } else { n }
}

// `guide --find WORDS [--budget N]`: the exit status.
fn find_command(prog: *mut u8, words: &[u8], budget: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let out = buf_new();
    let err = buf_new();
    if words.len() == 0 {
        buf_bytes(err, b"error guide.usage: --find needs WORDS\ntry: ");
        buf_str(err, prog);
        buf_bytes(err, b" guide --find 'read a line'\n");
        buf_write_fd(err, STDERR);
        return 2;
    }
    let tokens: i64 = if budget > 0 { budget } else if budget == 0 { 1 << 30 } else { FIND_BUDGET };
    let mut left: i64 = 0;
    let found = guide_find(words, tokens * 4, out, &mut left, pcx);
    buf_write_fd(out, STDOUT);
    if found == 0 {
        buf_bytes(err, b"error guide.no-match: no paragraph about '");
        buf_bytes(err, words);
        buf_bytes(err, b"'\ntry: ");
        buf_str(err, prog);
        buf_bytes(err, b" guide --list\n");
        buf_write_fd(err, STDERR);
        return 1;
    }
    if left > 0 {
        buf_bytes(err, b"note guide.budget: ");
        buf_int(err, left);
        buf_bytes(err, b" more paragraphs over the budget of ");
        buf_int(err, tokens);
        buf_bytes(err, b" tokens\ntry: ");
        buf_str(err, prog);
        buf_bytes(err, b" guide --find '");
        buf_bytes(err, words);
        buf_bytes(err, b"' --budget ");
        buf_int(err, tokens * 3);
        buf_bytes(err, b"\n");
        if pcx.find_over >= 0 {
            buf_bytes(err, b"try: ");
            buf_str(err, prog);
            buf_bytes(err, b" guide ");
            buf_append(err, pcx.find_over);
            buf_bytes(err, b"\n");
        }
        buf_write_fd(err, STDERR);
    }
    0
}

// Writes out to stdout, cut at a line to about `budget` tokens (-1, 0:
// all), with a note and the command that prints it all into err.
fn write_within(out: i64, budget: i64, line: Line<'_>, err: i64) {
    let s = buf_copy(out);
    if budget <= 0 || s.len() as i64 <= budget * 4 {
        buf_write_fd(out, STDOUT);
        return;
    }
    let mut end = budget * 4;
    while end > 0 && s[(end - 1) as usize] != b'\n' {
        end -= 1;
    }
    let cut = buf_new();
    buf_bytes(cut, &s[0..end as usize]);
    buf_write_fd(cut, STDOUT);
    buf_bytes(err, b"note guide.budget: cut at about ");
    buf_int(err, budget);
    buf_bytes(err, b" tokens (about ");
    buf_int(err, (s.len() as i64 + 3) / 4);
    buf_bytes(err, b" in all)\ntry: ");
    buf_bytes(err, line.word(0).as_bytes());
    let mut k: i64 = 1;
    while k < line.len() {
        if line.word(k) == "--budget" {
            k += 2;
            continue;
        }
        buf_bytes(err, b" ");
        buf_bytes(err, line.word(k).as_bytes());
        k += 1;
    }
    buf_bytes(err, b" --budget ");
    buf_int(err, (s.len() as i64 + 3) / 4 / 100 * 100 + 100);
    buf_bytes(err, b"\n");
}
