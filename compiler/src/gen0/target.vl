// The target layer: what the code generator (gen/) knows about the
// machine. This file holds the output helpers shared by every target and
// the target interface, which dispatches to the instruction set's file:
// arm64.vl (a64_*) or x86_64.vl (x64_*). The target selection (which
// machine, X86, ELF) is base/target.vl.
//
// Machine model used by the code generator, in virtual registers that each
// target maps to real ones:
//   R_ACC (0)     the accumulator: integers, bools and pointers; the float
//                 accumulator is a separate register (d0/s0, xmm0); values
//                 kept in memory (structs, tuples, arrays) are represented
//                 by their address in R_ACC
//   R_SECOND (1)  the second operand (int or float), and the destination
//                 of a copy
//   R_RESULT (8)  the result pointer of a function returning a compound
//                 value (set by the caller right before the call)
//   R_ADDR (9)    an address, for a load or store right after it is made
//   R_LOOP_PTR (10), R_LOOP_COUNT (11)
//                 the cursor and count of a fill loop (no calls inside)
// Temporaries (16 bytes each) live on the machine stack; every local lives
// in a frame slot at a negative offset from the frame pointer. Each target
// keeps its own scratch registers out of this set.

use crate::back::abi::returns_through_pointer;
use crate::back::codecache::cc_text_string;
use crate::back::objfile::{OUT_ASM, raw_data};
use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_clear, buf_fmt, buf_int, buf_new, buf_slice, buf_str, buf_uint,
    cstr, find_sym, free, intern_c, out_path, strlen, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{ELF, X86};
use crate::front::contracts::checks::{fixed_message, message_text};
use crate::front::contracts::sites::site_count;
use crate::front::lexer::{Tok, add_string, str_at};
use crate::front::types::{ENUMS, align_to, int_bits, is_float, scalar_type};
use crate::gen0::arm64::{
    a64_add_imm, a64_align_down, a64_arg_location, a64_bitnot, a64_call, a64_call_indirect,
    a64_checked_binary, a64_compare, a64_compare_jump, a64_copy, a64_decrement, a64_epilogue,
    a64_extern_symbol_addr, a64_float_binary, a64_float_to_float, a64_float_to_int, a64_frame_addr,
    a64_frame_reserve, a64_function_start, a64_index_addr, a64_int_binary, a64_int_to_float,
    a64_jump, a64_jump_if_nonzero, a64_jump_if_zero, a64_jump_imm, a64_jump_unless_zero_result,
    a64_load, a64_load_arg_reg, a64_load_callee, a64_load_float, a64_load_imm, a64_load_param,
    a64_load_reg, a64_local_symbol_addr, a64_move_to_second, a64_negate, a64_normalize,
    a64_not_bool, a64_note_runtime, a64_panic, a64_pop_float, a64_pop_int, a64_push_float,
    a64_push_int, a64_runtime, a64_sp_add, a64_sp_sub, a64_stack_arg, a64_store, a64_store_offset,
    a64_string_addr, a64_variadic_arg_location,
};
use crate::gen0::gen::overaligned_slot;
use crate::gen0::x86_64::{
    x64_add_imm, x64_align_down, x64_arg_location, x64_bitnot, x64_call, x64_call_indirect,
    x64_checked_binary, x64_compare, x64_compare_jump, x64_copy, x64_decrement, x64_epilogue,
    x64_extern_symbol_addr, x64_float_binary, x64_float_to_float, x64_float_to_int, x64_frame_addr,
    x64_frame_reserve, x64_function_start, x64_index_addr, x64_int_binary, x64_int_to_float,
    x64_jump, x64_jump_if_nonzero, x64_jump_if_zero, x64_jump_imm, x64_jump_unless_zero_result,
    x64_load, x64_load_arg_reg, x64_load_callee, x64_load_float, x64_load_imm, x64_load_param,
    x64_load_reg, x64_local_symbol_addr, x64_move_to_second, x64_negate, x64_normalize,
    x64_not_bool, x64_panic, x64_pop_float, x64_pop_int, x64_push_float, x64_push_int, x64_runtime,
    x64_sp_add, x64_sp_sub, x64_stack_arg, x64_store, x64_store_offset, x64_string_addr,
};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Cond;
use crate::middle::parallel::const_data_id;
use crate::middle::trace::trace_dump_fn;
use crate::places::ir::{BO_ADD, BO_DIV, BO_MUL, BO_SHL, BO_SHR, BO_SUB};

pub const R_ACC: i64 = 0;
pub const R_SECOND: i64 = 1;
pub const R_RESULT: i64 = 8;
pub const R_ADDR: i64 = 9;
pub const R_LOOP_PTR: i64 = 10;
pub const R_LOOP_COUNT: i64 = 11;

// ---- Output helpers ----

pub fn o(cx: inout FnCtx, s: *u8) {
    buf_str(cx.code, s);
}

pub fn oi(cx: inout FnCtx, value: i64) {
    buf_int(cx.code, value);
}

// (0.18.1) buf_fmt for a task (0.26.5: the same now, its String its own;
// cx's scratch String, which held an allocator its type did not name, is
// gone).
pub fn cx_fmt<T: std::Display>(cx: inout FnCtx, b: i64, x: sink T) {
    buf_fmt(b, x);
}

pub fn on(cx: inout FnCtx) {
    buf_byte(cx.code, '\n');
}

// "    <s>\n"
pub fn ins(cx: inout FnCtx, s: *u8) {
    buf_str(cx.code, c"    ");
    buf_str(cx.code, s);
    buf_byte(cx.code, '\n');
}

// "    <a><value><b>\n"
pub fn ins_i(cx: inout FnCtx, a: *u8, value: i64, b: *u8) {
    buf_str(cx.code, c"    ");
    buf_str(cx.code, a);
    buf_int(cx.code, value);
    buf_str(cx.code, b);
    buf_byte(cx.code, '\n');
}

// Ends a line started with o(): "<a><value><b>\n".
pub fn end_i(cx: inout FnCtx, a: *u8, value: i64, b: *u8) {
    buf_str(cx.code, a);
    buf_int(cx.code, value);
    buf_str(cx.code, b);
    buf_byte(cx.code, '\n');
}

// Ends a line started with o(): "<s>\n".
pub fn end(cx: inout FnCtx, s: *u8) {
    buf_str(cx.code, s);
    buf_byte(cx.code, '\n');
}

pub fn new_label(cx: inout FnCtx) -> i64 {
    cx.label_count += 1;
    cx.label_count
}

// Assembler-local labels: "L" on Mach-O, ".L" on ELF.
pub fn local_prefix() -> *u8 {
    if ELF { c".L" } else { c"L" }
}

// The prefix of C-visible symbols: "_" on Mach-O, nothing on ELF.
pub fn global_prefix() -> *u8 {
    if ELF { c"" } else { c"_" }
}

// The symbol prefix of vole functions (other than main) and statics.
pub fn function_prefix() -> *u8 {
    if ELF { c"vole." } else { c"_vole." }
}

pub fn static_prefix() -> *u8 {
    if ELF { c"vole.static." } else { c"_vole.static." }
}

pub fn emit_label(cx: inout FnCtx, label: i64) {
    o_label(&cx, label);
    o(&cx, c":\n");
}

// A local label as an operand: L<n> (.L<n> on ELF). In a task's context
// (local_labels) the number is the function's own, written L\x01<n>,
// which the join renumbers (middle::parallel, join_text).
pub fn o_label(cx: inout FnCtx, label: i64) {
    o(&cx, local_prefix());
    if cx.local_labels {
        buf_byte(cx.code, 1);
    }
    oi(&cx, label);
}

// The label of string literal or constant data `id`: Lstr.<id>. Constant
// data a task made, not numbered yet (a negative id, middle::parallel):
// Lstr.\x02<n>, which the join numbers.
pub fn o_str_label(cx: inout FnCtx, id: i64) {
    o(&cx, local_prefix());
    o(&cx, c"str.");
    // (0.18.1) With the code cache: the text's string i, str.\x03<i>, its
    // id put by the join (back::codecache).
    let i = cc_text_string(&cx, id);
    if i >= 0 {
        buf_byte(cx.code, 3);
        oi(&cx, i);
        return;
    }
    let real = const_data_id(id);
    if real < 0 {
        buf_byte(cx.code, 2);
        oi(&cx, -id - 1);
    } else {
        oi(&cx, real);
    }
}

// "<prefix><name>"; a C symbol (prefix "_" or none) may be renamed by
// #[link_name].
pub fn emit_symbol_ref(cx: inout FnCtx, sym_prefix: *u8, name: i64, pcx: Ctx<Comp>) {
    unsafe {
        o(&cx, sym_prefix);
        if strlen(sym_prefix) <= 1 {
            let link = pcx.link_names.get(name + 1);
            if link != 0 {
                buf_bytes(cx.code, sym_text(link - 1));
                return;
            }
        }
        buf_bytes(cx.code, sym_text(name));
    }
}

// log2 of a power of two.
pub fn log2(value: i64) -> i64 {
    var result = 0;
    while (1 << result as u64) < value {
        result += 1;
    }
    result
}

// Pushes the accumulator for a value of type `ty`.
pub fn push_value(cx: inout FnCtx, ty: i64, pcx: inout Ctx<Comp>) {
    if is_float(ty) {
        push_d0(&cx, &pcx);
    } else {
        push_x0(&cx, &pcx);
    }
}

// ---- Data ----

pub fn data_label(prefix: *u8, name: i64, pcx: Ctx<Comp>) {
    buf_str(pcx.data, prefix);
    buf_fmt(pcx.data, format_args("{}:\n", sym_text(name)));
}

// (0.25) Whether data goes to the assembler as bytes (back::objfile's
// raw_data, named by a `.vole_data` line) rather than as `.byte` text:
// when the output is an object, which nobody reads as text. `-S` keeps the
// text.
fn data_raw(pcx: Ctx<Comp>) -> bool {
    pcx.output_mode != OUT_ASM
}

// `.byte` lines for `n` bytes at `p`.
pub fn data_bytes(bytes: [u8], pcx: Ctx<Comp>) {
    unsafe {
        let n = bytes.len as i64;
        let p = bytes.ptr;
        if (0..n).all(|i| p[i] == 0) {
            if n > 0 {
                buf_fmt(pcx.data, format_args("    .space {n}\n"));
            }
            return;
        }
        if data_raw(pcx) {
            let at = raw_data(bytes);
            buf_fmt(pcx.data, format_args("    .vole_data {at}, {n}\n"));
            return;
        }
        var i = 0;
        while i < n {
            buf_str(pcx.data, c"    .byte ");
            var j = 0;
            while j < 16 && i < n {
                if j > 0 {
                    buf_byte(pcx.data, ',');
                }
                buf_uint(pcx.data, p[i]);
                i += 1;
                j += 1;
            }
            buf_byte(pcx.data, '\n');
        }
    }
}

pub fn data_section(writable: bool, pcx: Ctx<Comp>) {
    if ELF {
        buf_str(pcx.data, if writable { c"\n.data\n" } else { c"\n.section .rodata\n" });
    } else {
        buf_str(pcx.data,
            if writable { c"\n.section __DATA,__data\n" }
            else { c"\n.section __TEXT,__const\n" });
    }
}

// (0.25.5) The section of a writable static whose bytes are all zero: it
// takes no room in the object, and the loader zeroes it (Mach-O's
// zerofill __bss, ELF's nobits .bss).
pub fn bss_section(pcx: Ctx<Comp>) {
    buf_str(pcx.data,
        if ELF { c"\n.section .bss,\"aw\",@nobits\n" }
        else { c"\n.section __DATA,__bss,zerofill\n" });
}

pub fn data_align(align: i64, pcx: Ctx<Comp>) {
    buf_str(pcx.data, c".p2align ");
    buf_fmt(pcx.data, format_args("{}\n", log2(align)));
}

// The alignment of each string literal or constant data (0: none).
static var STR_ALIGN: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// Read-only data made by the optimizer (as a string, so that it is
// addressed like one): returns its id.
pub fn add_const_data(bytes: [u8], align: i64) -> i64 {
    let id = add_string(bytes);
    while STR_ALIGN.count <= id {
        STR_ALIGN.push(0);
    }
    unsafe { STR_ALIGN.data[id] = align; }
    id
}

// (0.18.1, back::codecache) The alignment of string or constant data id
// (0: a string literal's).
pub fn str_align(id: i64) -> i64 {
    unsafe {
        if id < STR_ALIGN.count { STR_ALIGN.data[id] } else { 0 }
    }
}

pub fn data_string(id: i64, pcx: Ctx<Comp>) {
    unsafe {
        if id < STR_ALIGN.count && STR_ALIGN.data[id] > 1 {
            data_align(STR_ALIGN.data[id], pcx);
        }
        buf_fmt(pcx.data, format_args("{}str.{id}:\n", cstr(local_prefix())));
        if data_raw(pcx) {
            // (0.25) the bytes and their 0 in one line
            let s = str_at(id);
            let at = raw_data(s);
            raw_data("\0");
            buf_fmt(pcx.data, format_args("    .vole_data {at}, {}\n", s.len as i64 + 1));
            return;
        }
        data_bytes(str_at(id), pcx);
        buf_str(pcx.data, c"    .byte 0\n");
    }
}

// The start and the end of the assembly file.
pub fn emit_file_header(cx: inout FnCtx, pcx: Ctx<Comp>) {
    buf_str(cx.asm, if ELF { c".text\n" } else { c".section __TEXT,__text\n" });
    // (0.19: the instruction set extensions the intrinsics need)
    if pcx.arch_used && !X86 {
        crate::back::mc_arm64::arch::ma_arch_extensions(cx.asm, pcx);
    }
}

pub fn emit_file_trailer(cx: inout FnCtx) {
    if ELF {
        // No executable stack.
        buf_str(cx.asm, c"\n.section .note.GNU-stack,\"\",@progbits\n");
    }
}

// ---- The target interface ----
//
// Every function below dispatches to the instruction set. The comments
// describe the contract in terms of the virtual registers above.

// Control flow.
pub fn emit_jump(cx: inout FnCtx, label: i64) {
    if X86 { x64_jump(&cx, label); } else { a64_jump(&cx, label); }
}

// Jumps when the accumulator is zero (false).
pub fn emit_jump_if_zero(cx: inout FnCtx, label: i64) {
    if X86 { x64_jump_if_zero(&cx, label); } else { a64_jump_if_zero(&cx, label); }
}

pub fn emit_jump_if_nonzero(cx: inout FnCtx, label: i64) {
    if X86 { x64_jump_if_nonzero(&cx, label); } else { a64_jump_if_nonzero(&cx, label); }
}

// <reg> -= 1, setting the flags for emit_jump_unless_zero_result.
pub fn emit_decrement(cx: inout FnCtx, reg: i64) {
    if X86 { x64_decrement(&cx, reg); } else { a64_decrement(&cx, reg); }
}

// Jumps unless the last emit_decrement reached zero (stores in between do
// not change the flags).
pub fn emit_jump_unless_zero_result(cx: inout FnCtx, label: i64) {
    if X86 { x64_jump_unless_zero_result(&cx, label); }
    else { a64_jump_unless_zero_result(&cx, label); }
}

// Jumps when R_ACC <op> R_SECOND, integers (op a comparison token).
pub fn emit_compare_jump(cx: inout FnCtx, op: Cond, signed: bool, label: i64) {
    if X86 { x64_compare_jump(&cx, op, signed, label); }
    else { a64_compare_jump(&cx, op, signed, label); }
}

// Constants and addresses.

// <reg> = value
pub fn emit_load_imm(cx: inout FnCtx, reg: i64, value: u64) {
    if X86 { x64_load_imm(&cx, reg, value); } else { a64_load_imm(&cx, reg, value); }
}

// <reg> = frame pointer - offset
pub fn emit_frame_addr(cx: inout FnCtx, reg: i64, offset: i64, pcx: Ctx<Comp>) {
    unsafe {
        let i = overaligned_slot(offset, pcx);
        if i >= 0 {
            // The slot's address rounded up to its alignment, inside the room
            // left below it; then the field's offset.
            let slot = pcx.overaligned.data[i];
            let align = pcx.overaligned.data[i + 1];
            emit_frame_addr_plain(&cx, reg, slot - (align - 16));
            if X86 { x64_align_down(&cx, reg, align); } else { a64_align_down(&cx, reg, align); }
            if slot != offset {
                if X86 { x64_add_imm(&cx, reg, slot - offset); }
                else { a64_add_imm(&cx, reg, slot - offset); }
            }
            return;
        }
        emit_frame_addr_plain(&cx, reg, offset);
    }
}

fn emit_frame_addr_plain(cx: inout FnCtx, reg: i64, offset: i64) {
    if X86 { x64_frame_addr(&cx, reg, offset); } else { a64_frame_addr(&cx, reg, offset); }
}

// <reg> += value
pub fn emit_add_imm(cx: inout FnCtx, reg: i64, value: i64) {
    if X86 { x64_add_imm(&cx, reg, value); } else { a64_add_imm(&cx, reg, value); }
}

// R_ACC = address of a symbol defined in this file.
pub fn emit_local_symbol_addr(cx: inout FnCtx, prefix: *u8, name: i64, pcx: Ctx<Comp>) {
    if X86 { x64_local_symbol_addr(&cx, prefix, name, pcx); }
    else { a64_local_symbol_addr(&cx, prefix, name, pcx); }
}

// R_ACC = address of an external (C) symbol.
pub fn emit_extern_symbol_addr(cx: inout FnCtx, name: i64, pcx: Ctx<Comp>) {
    if X86 { x64_extern_symbol_addr(&cx, name, pcx); }
    else { a64_extern_symbol_addr(&cx, name, pcx); }
}

// R_ACC = address of string literal `id`.
pub fn emit_string_addr(cx: inout FnCtx, id: i64) {
    if X86 { x64_string_addr(&cx, id); } else { a64_string_addr(&cx, id); }
}

// Float accumulator = the float whose f64 bits are `bits`.
pub fn emit_load_float(cx: inout FnCtx, bits: i64, ty: i64) {
    if X86 { x64_load_float(&cx, bits, ty); } else { a64_load_float(&cx, bits, ty); }
}

// Temporaries.

pub fn push_x0(cx: inout FnCtx, pcx: inout Ctx<Comp>) {
    if X86 { x64_push_int(&cx); } else { a64_push_int(&cx); }
    pcx.depth += 1;
}

fn push_d0(cx: inout FnCtx, pcx: inout Ctx<Comp>) {
    if X86 { x64_push_float(&cx); } else { a64_push_float(&cx); }
    pcx.depth += 1;
}

// Pops the top temporary into int register <reg>.
pub fn pop_x(cx: inout FnCtx, reg: i64, pcx: inout Ctx<Comp>) {
    if X86 { x64_pop_int(&cx, reg); } else { a64_pop_int(&cx, reg); }
    pcx.depth -= 1;
}

// Pops the top temporary into float register <reg> (0: the accumulator).
pub fn pop_d(cx: inout FnCtx, reg: i64, pcx: inout Ctx<Comp>) {
    if X86 { x64_pop_float(&cx, reg); } else { a64_pop_float(&cx, reg); }
    pcx.depth -= 1;
}

// Loads and stores.

// Accumulator = the value of type `ty` at [<addr>].
pub fn emit_load(cx: inout FnCtx, ty: i64, addr: i64, pcx: Ctx<Comp>) {
    let t = scalar_type(ty);
    if X86 { x64_load(&cx, t, addr, pcx); } else { a64_load(&cx, t, addr, pcx); }
}

// <reg> = the 8 bytes at [<addr>].
pub fn emit_load_reg(cx: inout FnCtx, reg: i64, addr: i64) {
    if X86 { x64_load_reg(&cx, reg, addr); } else { a64_load_reg(&cx, reg, addr); }
}

// [<addr>] = <reg>, a value of type `ty` (register <reg> of the float
// accumulator's kind for floats).
pub fn emit_store(cx: inout FnCtx, ty: i64, reg: i64, addr: i64, pcx: Ctx<Comp>) {
    let t = scalar_type(ty);
    if X86 { x64_store(&cx, t, reg, addr, pcx); } else { a64_store(&cx, t, reg, addr, pcx); }
}

// [<addr> + offset] = the 8 bytes of <reg>.
pub fn emit_store_offset(cx: inout FnCtx, reg: i64, addr: i64, offset: i64) {
    if X86 { x64_store_offset(&cx, reg, addr, offset); }
    else { a64_store_offset(&cx, reg, addr, offset); }
}

// Copies `size` bytes from [R_ACC] to [R_SECOND]; clobbers the target's
// scratch registers (and every caller-saved register for large copies).
pub fn emit_copy(cx: inout FnCtx, size: i64) {
    if X86 { x64_copy(&cx, size); } else { a64_copy(&cx, size); }
}

// R_SECOND = accumulator (the float registers for floats).
pub fn emit_move_to_second(cx: inout FnCtx, ty: i64) {
    if X86 { x64_move_to_second(&cx, ty); } else { a64_move_to_second(&cx, ty); }
}

// Integer operations: integers are kept sign- or zero-extended to 64 bits.

// Brings R_ACC into the canonical form of `ty`.
pub fn emit_normalize(cx: inout FnCtx, ty: i64) {
    let t = scalar_type(ty);
    if X86 { x64_normalize(&cx, t); } else { a64_normalize(&cx, t); }
}

// R_ACC = R_ACC <op> R_SECOND for integers of type `ty`.
pub fn emit_int_binary(cx: inout FnCtx, op: Tok, ty: i64) {
    if X86 { x64_int_binary(&cx, op, ty); } else { a64_int_binary(&cx, op, ty); }
}

// R_ACC = (accumulator <op> second operand) as a bool; operands of `ty`.
pub fn emit_compare(cx: inout FnCtx, op: Cond, ty: i64) {
    let t = scalar_type(ty);
    if X86 { x64_compare(&cx, op, t); } else { a64_compare(&cx, op, t); }
}

// Accumulator = -accumulator.
pub fn emit_negate(cx: inout FnCtx, ty: i64) {
    if X86 { x64_negate(&cx, ty); } else { a64_negate(&cx, ty); }
}

// R_ACC = !R_ACC (a bool).
pub fn emit_not_bool(cx: inout FnCtx) {
    if X86 { x64_not_bool(&cx); } else { a64_not_bool(&cx); }
}

// R_ACC = ~R_ACC.
pub fn emit_bitnot(cx: inout FnCtx, ty: i64) {
    if X86 { x64_bitnot(&cx, ty); } else { a64_bitnot(&cx, ty); }
}

// R_ACC = R_SECOND + R_ACC * elem_size (an element's address).
pub fn emit_index_addr(cx: inout FnCtx, elem_size: i64) {
    if X86 { x64_index_addr(&cx, elem_size); } else { a64_index_addr(&cx, elem_size); }
}

// Floats.

// Float accumulator = accumulator <op> second operand.
pub fn emit_float_binary(cx: inout FnCtx, op: Tok, ty: i64) {
    if X86 { x64_float_binary(&cx, op, ty); } else { a64_float_binary(&cx, op, ty); }
}

pub fn emit_int_to_float(cx: inout FnCtx, from: i64, to: i64) {
    if X86 { x64_int_to_float(&cx, from, to); } else { a64_int_to_float(&cx, from, to); }
}

pub fn emit_float_to_float(cx: inout FnCtx, from: i64, to: i64) {
    if from == to {
        return;
    }
    if X86 { x64_float_to_float(&cx, to); } else { a64_float_to_float(&cx, to); }
}

// Saturating conversions (NaN is 0): signed results up to 32 bits convert
// at 32 bits and wrap, unsigned ones up to 32 bits convert signed at 64
// bits and wrap; u64 converts unsigned at 2^63 and above.
pub fn emit_float_to_int(cx: inout FnCtx, from: i64, to: i64) {
    if X86 { x64_float_to_int(&cx, from, to); } else { a64_float_to_int(&cx, from, to); }
}

// Functions.

pub fn emit_function_start(cx: inout FnCtx, symbol_prefix: *u8, name: i64, global: bool) {
    if X86 { x64_function_start(&cx, symbol_prefix, name, global); }
    else { a64_function_start(&cx, symbol_prefix, name, global); }
}

// Reserves the frame once its size is known (written to ASM, after the
// function start).
pub fn emit_frame_reserve(cx: inout FnCtx, frame_size: i64) {
    let size = align_to(frame_size, 16);
    if size == 0 {
        return;
    }
    let out = cx.code;
    cx.code = cx.asm;
    if X86 { x64_frame_reserve(&cx, size); } else { a64_frame_reserve(&cx, size); }
    cx.code = out;
}

pub fn emit_epilogue(cx: inout FnCtx) {
    if X86 { x64_epilogue(&cx); } else { a64_epilogue(&cx); }
}

// Calls. An argument's location is 0-7 for an int register (by index in
// the target's argument registers), 8-15 for a float register, or
// 16 + offset for the outgoing stack area. `state` holds the next int
// register, the next float register and the stack offset.

pub fn arg_location(ty: i64, state: *i64, pcx: Ctx<Comp>) -> i64 {
    if X86 { x64_arg_location(ty, state) } else { a64_arg_location(ty, state, pcx) }
}

// The location of an argument passed to the `...` of a C function: where
// a named one would go, but on Apple's arm64 (always on the stack).
pub fn variadic_arg_location(ty: i64, state: *i64, pcx: Ctx<Comp>) -> i64 {
    if X86 { x64_arg_location(ty, state) }
    else if pcx.apple_a64 { a64_variadic_arg_location(state) }
    else { a64_arg_location(ty, state, pcx) }
}

// The first int argument register used by ordinary arguments of a function
// returning `ret` (1 where the result pointer takes the first one).
pub fn first_int_arg(cx: inout FnCtx, ret: i64, pcx: Ctx<Comp>) -> i64 {
    if X86 && returns_through_pointer(&cx, ret, pcx) { 1 } else { 0 }
}

// Accumulator = the incoming parameter at `location`, of type `ty` (a
// pointer for compound values).
pub fn emit_load_param(cx: inout FnCtx, location: i64, ty: i64, pcx: Ctx<Comp>) {
    let t = scalar_type(ty);
    if X86 { x64_load_param(&cx, location, t, pcx); }
    else { a64_load_param(&cx, location, t, pcx); }
}

// Moves the stack pointer down (reserve) or up (release) by `size` bytes.
pub fn emit_sp_sub(cx: inout FnCtx, size: i64) {
    if X86 { x64_sp_sub(&cx, size); } else { a64_sp_sub(&cx, size); }
}

pub fn emit_sp_add(cx: inout FnCtx, size: i64) {
    if X86 { x64_sp_add(&cx, size); } else { a64_sp_add(&cx, size); }
}

// Loads argument register `location` from the temporary at sp + from;
// `promote` widens an f32 to f64 (C's default promotion).
pub fn emit_load_arg_reg(cx: inout FnCtx, location: i64, ty: i64, from: i64, promote: bool) {
    let t = scalar_type(ty);
    if X86 { x64_load_arg_reg(&cx, location, t, from, promote); }
    else { a64_load_arg_reg(&cx, location, t, from, promote); }
}

// Copies the temporary at sp + from to the outgoing stack area at
// sp + offset.
pub fn emit_stack_arg(cx: inout FnCtx, ty: i64, from: i64, offset: i64, promote: bool,
    pcx: Ctx<Comp>) {
    let t = scalar_type(ty);
    if X86 { x64_stack_arg(&cx, t, from, offset, promote); }
    else { a64_stack_arg(&cx, t, from, offset, promote, pcx); }
}

// Loads the callee of an indirect call from the temporary at sp + from.
pub fn emit_load_callee(cx: inout FnCtx, from: i64) {
    if X86 { x64_load_callee(&cx, from); } else { a64_load_callee(&cx, from); }
}

// Calls a function by symbol; `vector_regs` float registers carry
// arguments (needed by variadic C functions on x86-64).
pub fn emit_call(cx: inout FnCtx, prefix: *u8, name: i64, is_extern: bool, variadic: bool,
    vector_regs: i64, pcx: Ctx<Comp>) {
    if X86 { x64_call(&cx, prefix, name, is_extern, variadic, vector_regs, pcx); }
    else { a64_call(&cx, prefix, name, pcx); }
}

pub fn emit_call_indirect(cx: inout FnCtx) {
    if X86 { x64_call_indirect(&cx); } else { a64_call_indirect(&cx); }
}

// ---- Run-time checks ----
//
// A failed check calls the run-time helper `rt.panic(kind, a, b, c)`,
// emitted once per program (see emit_runtime), which writes a message to
// stderr and exits with 101. Kinds: index out of bounds (a = the index, b
// = the length), signed or unsigned index; slice range out of bounds (a..b,
// c = the length), signed or unsigned bounds.

pub const PANIC_INDEX_SIGNED: i64 = 0;
pub const PANIC_INDEX_UNSIGNED: i64 = 1;
pub const PANIC_RANGE_SIGNED: i64 = 2;
pub const PANIC_RANGE_UNSIGNED: i64 = 3;

static var RT_PANIC_SYM: i64 = 0;

pub fn enum_panic_kind(e: i64, pcx: inout Ctx<Comp>) -> i64 {
    for i in 0..pcx.enum_panics.count {
        if unsafe { pcx.enum_panics.data[i] == e } {
            return 4 + i;
        }
    }
    pcx.enum_panics.push(e);
    3 + pcx.enum_panics.count
}

// The symbol of the runtime's panic entry, made the first time (the main
// thread's: lowering, gen0, middle::parallel's prepare_tasks).
pub fn make_rt_panic_sym() -> i64 {
    if RT_PANIC_SYM == 0 {
        RT_PANIC_SYM = intern_c(c"rt.panic");
    }
    RT_PANIC_SYM
}

// (0.27.0) The same, read (a task's: prepare_tasks made it); -1 while no
// symbol is the name.
pub fn rt_panic_sym() -> i64 {
    if RT_PANIC_SYM != 0 { RT_PANIC_SYM } else { find_sym("rt.panic") }
}

static var RT_NOTE_SYM: i64 = 0;

// The symbol of the runtime's note entry (--trace), made as
// make_rt_panic_sym makes its.
pub fn make_rt_note_sym() -> i64 {
    if RT_NOTE_SYM == 0 {
        RT_NOTE_SYM = intern_c(c"rt.note");
    }
    RT_NOTE_SYM
}

// (0.27.0) The same, read, as rt_panic_sym.
pub fn rt_note_sym() -> i64 {
    if RT_NOTE_SYM != 0 { RT_NOTE_SYM } else { find_sym("rt.note") }
}

// Calls the helper with a = R_ACC, b = R_SECOND, c = R_ADDR. (0.18) site:
// the check's site (front/contracts/sites.vl; 0: none), whose position
// the helper prints first.
pub fn emit_panic(cx: inout FnCtx, kind: i64, pcx: inout Ctx<Comp>, site: i64 = 0) {
    pcx.panic_used = true;
    if X86 { x64_panic(&cx, kind, site, pcx); } else { a64_panic(&cx, kind, site, pcx); }
}

// (0.18) Calls the helper as emit_panic does, with the site popped from
// the temporaries (a value: a requires' call site).
pub fn emit_panic_site_popped(cx: inout FnCtx, kind: i64, pcx: inout Ctx<Comp>) {
    pcx.panic_used = true;
    if X86 {
        ins(&cx, c"movq (%rsp), %r8");
        ins(&cx, c"addq $16, %rsp");
        x64_panic(&cx, kind, -1, pcx);
    } else {
        a64_pop_int(&cx, 4);
        a64_panic(&cx, kind, -1, pcx);
    }
    pcx.depth -= 1;
}

// (0.26.3, decision 6) R_ACC = R_ACC <op> R_SECOND (`+`, `-`, `*`) for
// integers of type ty, checked: Rust's panic of `kind` at site when the
// result does not fit.
pub fn emit_checked_binary(cx: inout FnCtx, op: Tok, ty: i64, kind: i64, site: i64,
    pcx: inout Ctx<Comp>) {
    let ok = new_label(&cx);
    if X86 { x64_checked_binary(&cx, op, ty, ok); } else { a64_checked_binary(&cx, op, ty, ok); }
    emit_panic(&cx, kind, &pcx, site);
    emit_label(&cx, ok);
}

// (0.26.3) Rust's panic of `kind` at site unless R_ACC (R_SECOND:
// `second`) differs from value (`below`: unless it is below it, unsigned).
pub fn emit_check_imm(cx: inout FnCtx, second: bool, value: i64, below: bool, kind: i64,
    site: i64, pcx: inout Ctx<Comp>) {
    let ok = new_label(&cx);
    if X86 { x64_jump_imm(&cx, second, value, below, ok); }
    else { a64_jump_imm(&cx, second, value, below, ok); }
    emit_panic(&cx, kind, &pcx, site);
    emit_label(&cx, ok);
}

// (0.26.3) Rust's panic of `kind` at site when R_ACC is signed type ty's
// MIN and R_SECOND -1 (a division's overflow).
pub fn emit_min_check(cx: inout FnCtx, ty: i64, kind: i64, site: i64, pcx: inout Ctx<Comp>) {
    let ok = new_label(&cx);
    let min = (0 - 1) << (int_bits(ty) - 1) as u64;
    if X86 {
        x64_jump_imm(&cx, true, 0 - 1, false, ok);
        x64_jump_imm(&cx, false, min, false, ok);
    } else {
        a64_jump_imm(&cx, true, 0 - 1, false, ok);
        a64_jump_imm(&cx, false, min, false, ok);
    }
    emit_panic(&cx, kind, &pcx, site);
    emit_label(&cx, ok);
}

// (0.17) The line after a failure's message, without --trace; (0.18) none:
// a failure is one line, `FILE:LINE:COL: message` (design Q10; the guide
// and `volec test` name --trace). std's panic prints the same
// (std::panic_note).
pub fn panic_note_text() -> [u8] {
    ""
}

// The helper and its messages, when a check was generated: (0.18) a table
// of 32-bit offsets from rt.messages to each message (kinds 0 to 3, then
// one per ENUM_PANICS entry: an enum's, or a message text's), the
// sites' table (front/contracts/sites.vl) and the files' names.
pub fn emit_runtime(cx: inout FnCtx, pcx: Ctx<Comp>) {
    unsafe {
        if !pcx.panic_used {
            return;
        }
        let out = cx.code;
        buf_clear(cx.code);
        if X86 { x64_runtime(&cx, pcx); } else { a64_runtime(&cx, pcx); }
        // (0.26.3, measuring) $VOLE_OVF_CENSUS: rt.note too
        if pcx.ovf_census && !X86 {
            a64_note_runtime(&cx, pcx);
        }
        buf_bytes(cx.asm, buf_slice(cx.code));
        cx.code = out;
        // (0.17) each message with a note on --trace, without --trace (with
        // it, the trace follows them).
        let note = if trace_dump_fn(pcx) >= 0 { "" } else { panic_note_text() };
        let lp = cstr(local_prefix());
        data_section(writable: false, pcx: pcx);
        // (0.18.1) -O1 and -O2: the kinds and sites as the join numbered them
        // (rt_output), those of the code emitted; -O0: the front end's.
        let kinds = if pcx.rt_renumbered { pcx.out_kinds.count } else { pcx.enum_panics.count };
        let count = 4 + kinds;
        buf_fmt(pcx.data, format_args(".p2align 2\n{lp}rt.messages:\n"));
        for i in 0..count {
            buf_fmt(pcx.data, format_args("    .long {lp}rt.m{i} - {lp}rt.messages\n"));
        }
        let messages: [*u8; 4] = [
            c"index out of bounds: index %lld, length %llu\n",
            c"index out of bounds: index %llu, length %llu\n",
            c"slice range out of bounds: %lld..%lld, length %llu\n",
            c"slice range out of bounds: %llu..%llu, length %llu\n",
        ];
        for i in 0..4 {
            let text = messages[i];
            buf_fmt(pcx.data, format_args("{lp}rt.m{i}:\n"));
            data_bytes(text[0..strlen(text) as i64], pcx);
            data_bytes(note, pcx);
            data_bytes("\0", pcx);
        }
        for i in 0..kinds {
            buf_fmt(pcx.data, format_args("{lp}rt.m{}:\n", 4 + i));
            let m = buf_new();
            let e = pcx.enum_panics.data[if pcx.rt_renumbered { pcx.out_kinds.data[i] - 4 }
                else { i }];
            if e >= 0 {
                buf_str(m, c"invalid value %lld for enum ");
                buf_bytes(m, sym_text(ENUMS[e].name));
                buf_byte(m, '\n');
            } else {
                // (0.18) a check's message, made by front/contracts.
                buf_bytes(m, message_text(-1 - e, pcx));
            }
            buf_bytes(m, note);
            buf_byte(m, 0);
            data_bytes(buf_slice(m), pcx);
        }
        buf_fmt(pcx.data, format_args("{lp}rt.at:\n"));
        data_bytes("%s:%u:%u: \0", pcx);
        // (0.18) The sites: (line, file << 16 | column) each, from 1; the
        // files their checks are in, by name.
        buf_fmt(pcx.data, format_args(".p2align 2\n{lp}rt.sites:\n    .long 0, 0\n"));
        let sites = if pcx.rt_renumbered { pcx.out_sites.count + 1 } else { site_count(pcx) };
        var used = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for f in 0..pcx.files.len() {
            used.push(0);
        }
        for o in 1..sites {
            let s = if pcx.rt_renumbered { pcx.out_sites.data[o - 1] } else { o };
            let col = if pcx.site_col.data[s] > 65535 { 65535 } else { pcx.site_col.data[s] };
            buf_fmt(pcx.data,
                format_args("    .long {}, {}\n", pcx.site_line.data[s],
                    pcx.site_file.data[s] * 65536 + col));
            used.data[pcx.site_file.data[s]] = 1;
        }
        buf_fmt(pcx.data, format_args("{lp}rt.files:\n"));
        for f in 0..pcx.files.len() as i64 {
            if used.data[f] != 0 {
                buf_fmt(pcx.data, format_args("    .long {lp}rt.f{f} - {lp}rt.files\n"));
            } else {
                buf_fmt(pcx.data, format_args("    .long {lp}rt.at - {lp}rt.files\n"));
            }
        }
        for f in 0..pcx.files.len() as i64 {
            if used.data[f] != 0 {
                buf_fmt(pcx.data, format_args("{lp}rt.f{f}:\n"));
                let path = out_path(f, pcx);
                data_bytes(path[0..strlen(path) as i64], pcx);
                data_bytes("\0", pcx);
            }
        }
        unsafe { free(used.data as *u8); }
        if pcx.ovf_census && !X86 {
            data_section(writable: true, pcx: pcx);
            let seen = sites + 1;
            buf_fmt(pcx.data, format_args("{lp}rt.seen:\n    .space {seen}\n"));
        }
    }
}

// (0.18) The kind of a check whose message is `text` (a message of
// front/contracts/checks.vl: a format for the helper's dprintf, with
// the check's values).
pub fn message_kind(text: i64, pcx: inout Ctx<Comp>) -> i64 {
    let key = -1 - text;
    for i in 0..pcx.enum_panics.count {
        if unsafe { pcx.enum_panics.data[i] == key } {
            return 4 + i;
        }
    }
    pcx.enum_panics.push(key);
    3 + pcx.enum_panics.count
}

// (0.18) Whether check kind `kind` (4 on) is an enum's `as E` check (else a
// contract's or an assertion's).
pub fn kind_is_enum(kind: i64, pcx: Ctx<Comp>) -> bool {
    kind >= 4 && kind - 4 < pcx.enum_panics.count && unsafe { pcx.enum_panics.data[kind - 4] >= 0 }
}

pub fn arith_panic_kind(bo: i64, unary: bool, zero: bool, pcx: inout Ctx<Comp>) -> i64 {
    let m = if unary { 3 } else if bo == BO_ADD { 0 } else if bo == BO_SUB { 1 }
        else if bo == BO_MUL { 2 } else if bo == BO_SHL { 4 } else if bo == BO_SHR { 5 }
        else if bo == BO_DIV { if zero { 6 } else { 8 } } else if zero { 7 } else { 9 };
    while pcx.arith_kinds.len() < 10 {
        pcx.arith_kinds.push(-1);
    }
    if pcx.arith_kinds[m as usize] < 0 {
        let texts: [[u8]; 10] = [
            "attempt to add with overflow\n",
            "attempt to subtract with overflow\n",
            "attempt to multiply with overflow\n",
            "attempt to negate with overflow\n",
            "attempt to shift left with overflow\n",
            "attempt to shift right with overflow\n",
            "attempt to divide by zero\n",
            "attempt to calculate the remainder with a divisor of zero\n",
            "attempt to divide with overflow\n",
            "attempt to calculate the remainder with overflow\n",
        ];
        pcx.arith_kinds[m as usize] = message_kind(fixed_message(texts[m], &pcx), &pcx);
    }
    pcx.arith_kinds[m as usize]
}

// The program's number for the front end's site or kind `value` (class
// middle::ir::RT_SITE or RT_KIND), given the first time the join asks.
pub fn rt_output(class: i64, value: i64, pcx: inout Ctx<Comp>) -> i64 {
    if class == crate::middle::ir::RT_SITE {
        let found = pcx.out_site_of.get(value + 1);
        if found != 0 {
            return found;
        }
        pcx.out_sites.push(value);
        pcx.out_site_of.put(value + 1, pcx.out_sites.count);
        return pcx.out_sites.count;
    }
    let found = pcx.out_kind_of.get(value + 1);
    if found != 0 {
        return found;
    }
    pcx.out_kinds.push(value);
    pcx.out_kind_of.put(value + 1, 3 + pcx.out_kinds.count);
    3 + pcx.out_kinds.count
}
