// Expressions (gen0): gen_expr leaves the value of an operand the
// places-IR walk did not bind (places.vl) in the accumulator: a literal
// or a name (0.26.2: the AST walk of the other expressions, of
// statements and of control flow is gone). Here too: casts, a string's
// tuple, a function's or a static's address, and the helpers call.vl,
// vector.vl and places.vl share.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::ast::{NodeKind, child};
use crate::front::ast::NodeKind::{
    Array, Bool, CStr, Char, Float, Ident, Int, Str, StructLit, Tuple, Unit,
};
use crate::front::check::{Res, type_error};
use crate::front::consteval::{const_value, f64_of_bits, float_const, wrap_int};
use crate::front::contracts::sites::site_of;
use crate::front::lexer::{Tok, str_at};
use crate::front::parser::exprs::is_comparison;
use crate::front::threadlocal::{is_thread_local, tls_addr_fn};
use crate::front::types::{
    TY_BOOL, TY_NEVER, TY_U64, TyKind, field_offset, is_compound, is_float, is_signed, is_slice,
    is_void, struct_field, tuple_offset, type_elem, type_size,
};
use crate::gen0::gen::{
    alloc_slot, alloc_slot_for, fn_symbol_prefix, load_from_x0, load_reg_from_frame,
    static_symbol_prefix, store_reg_to_frame, store_to_frame,
};
use crate::gen0::target::{
    PANIC_INDEX_SIGNED, PANIC_INDEX_UNSIGNED, PANIC_RANGE_SIGNED, PANIC_RANGE_UNSIGNED, R_ACC,
    R_ADDR, R_LOOP_COUNT, R_LOOP_PTR, R_SECOND, emit_add_imm, emit_bitnot, emit_call, emit_compare,
    emit_compare_jump, emit_copy, emit_decrement, emit_extern_symbol_addr, emit_float_binary,
    emit_float_to_float, emit_float_to_int, emit_frame_addr, emit_index_addr, emit_int_binary,
    emit_int_to_float, emit_jump_unless_zero_result, emit_label, emit_load_float, emit_load_imm,
    emit_load_reg, emit_local_symbol_addr, emit_move_to_second, emit_negate, emit_normalize,
    emit_not_bool, emit_panic, emit_store, emit_store_offset, emit_string_addr, ins, new_label,
    pop_x, push_x0,
};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, cond_of_token};
use crate::places::ir::Body;

// ---- Expressions ----

// R_ACC (or `reg` with the machine layer) = the address of static `name`:
// through the GOT when C defines it.
pub fn emit_static_addr(cx: &mut FnCtx<Comp>, name: i64, pcx: &mut Ctx<Comp>) {
    let s = (pcx.sym_static[name as usize]) - 1;
    crate::gen0::gen::static_named(s, pcx);
    let linkage = pcx.statics[s as usize].linkage;
    if linkage == 1 {
        emit_extern_symbol_addr(cx, name, pcx);
    } else {
        emit_local_symbol_addr(cx, static_symbol_prefix(s, pcx), name, pcx);
    }
    // (0.21) A thread-local: this thread's copy, std::thread::__tls_addr(
    // its initial value, size) (front/threadlocal.vl).
    if is_thread_local(s, pcx) {
        let f = tls_addr_fn(pcx);
        emit_load_imm(cx, R_SECOND, type_size(pcx.statics[s as usize].ty, pcx) as u64);
        if get_x86() {
            ins(cx, c"movq %rax, %rdi");
            ins(cx, c"movq %rcx, %rsi");
        }
        emit_call(cx, fn_symbol_prefix(f, pcx), pcx.fns[f as usize].name, false, false, 0, pcx);
    }
}

// (0.26.1) Accumulator = operand e of a call, an intrinsic or a vector
// operation: the one point where those read their operands, so that the
// places-IR walk gives them its operands instead of the AST's (call.vl,
// arch.vl, vector.vl).
pub fn gen_operand(cx: &mut FnCtx<Comp>, e: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    gen_expr(cx, e, pbody, pcx);
}

pub fn gen_expr(cx: &mut FnCtx<Comp>, n: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // (0.26.1: a node the places-IR walk bound to its operand, gen0's
    // places.vl)
    if pcx.g_bound.len() > 0
        && crate::gen0::gen::places::gen_bound(cx, n, pbody, pcx) {
        return;
    }
    let ty = pcx.nodes[n as usize].ty;
    match pcx.nodes[n as usize].kind {
        Int | Char => emit_load_imm(cx, R_ACC, wrap_int(pcx.nodes[n as usize].a, ty) as u64),
        Float => emit_load_float(cx, float_const(f64_of_bits(pcx.nodes[n as usize].a), ty), ty),
        Bool => emit_load_imm(cx, R_ACC, pcx.nodes[n as usize].a as u64),
        Unit => {}
        Str => gen_string(cx, n, pcx),
        CStr => emit_string_addr(cx, pcx.nodes[n as usize].a),
        Ident => gen_ident(cx, n, pcx),
        _ => type_error(n, c"internal error: unexpected node in code generation", pcx),
    }
}

// A string literal is a (pointer, length) tuple.
fn gen_string(cx: &mut FnCtx<Comp>, n: i64, pcx: &mut Ctx<Comp>) {
    gen_string_id(cx, pcx.nodes[n as usize].a, pcx);
}

// (0.26.1) Accumulator = the address of a new (pointer, length) tuple of
// string `id`.
pub fn gen_string_id(cx: &mut FnCtx<Comp>, id: i64, pcx: &mut Ctx<Comp>) {
    let slot = alloc_slot(16, 8, pcx);
    emit_string_addr(cx, id);
    emit_frame_addr(cx, R_ADDR, slot, pcx);
    emit_store(cx, TY_U64, R_ACC, R_ADDR, pcx);
    emit_load_imm(cx, R_ACC, str_at(id).len() as u64);
    emit_store_offset(cx, R_ACC, R_ADDR, 8);
    emit_frame_addr(cx, R_ACC, slot, pcx);
}

fn gen_ident(cx: &mut FnCtx<Comp>, n: i64, pcx: &mut Ctx<Comp>) {
    let ty = pcx.nodes[n as usize].ty;
    let resolution = pcx.nodes[n as usize].res;
    let index = pcx.nodes[n as usize].y;
    if resolution == Res::Local {
        emit_frame_addr(cx, R_ACC, pcx.locals[index as usize].offset, pcx);
        load_from_x0(cx, ty, pcx);
    } else if resolution == Res::Const {
        let value = const_value(index, pcx);
        if is_float(ty) {
            emit_load_float(cx, value, ty);
        } else {
            emit_load_imm(cx, R_ACC, value as u64);
        }
    } else if resolution == Res::Static {
        emit_static_addr(cx, pcx.nodes[n as usize].a, pcx);
        load_from_x0(cx, ty, pcx);
    } else {
        gen_fn_address(cx, index, pcx);
    }
}

pub fn gen_fn_address(cx: &mut FnCtx<Comp>, f: i64, pcx: &Ctx<Comp>) {
    if pcx.fns[f as usize].is_extern {
        emit_extern_symbol_addr(cx, pcx.fns[f as usize].name, pcx);
    } else {
        emit_local_symbol_addr(cx, fn_symbol_prefix(f, pcx), pcx.fns[f as usize].name, pcx);
    }
}

pub fn panic_kind(index_ty: i64, range: bool) -> i64 {
    let signed = is_signed(index_ty);
    if range {
        return if signed { PANIC_RANGE_SIGNED } else { PANIC_RANGE_UNSIGNED };
    }
    if signed { PANIC_INDEX_SIGNED } else { PANIC_INDEX_UNSIGNED }
}

// ---- Operators ----

// Accumulator = accumulator <op> second operand (the one function -O0's
// binary operators go through, from either walk).
pub fn gen_operator(cx: &mut FnCtx<Comp>, op: Tok, operand_ty: i64, result_ty: i64, pcx: &Ctx<Comp>) {
    if is_comparison(op) {
        emit_compare(cx, cond_of_token(op), operand_ty, pcx);
    } else if is_float(operand_ty) {
        emit_float_binary(cx, op, result_ty);
    } else {
        emit_int_binary(cx, op, result_ty);
    }
}

// (0.26.1) Accumulator = <op> accumulator, `-`, `!` or `~` on a scalar of
// type `ty`.
pub fn gen_unop(cx: &mut FnCtx<Comp>, op: Tok, ty: i64) {
    if op == Tok::Minus {
        emit_negate(cx, ty);
    } else if op == Tok::Bang {
        emit_not_bool(cx);
    } else {
        emit_bitnot(cx, ty);
    }
}

// Accumulator = accumulator (of type `from`) as `to`.
pub fn gen_cast(cx: &mut FnCtx<Comp>, from: i64, to: i64, pcx: &Ctx<Comp>) {
    if from == TY_NEVER || from == to {
        return;
    }
    if is_float(from) && is_float(to) {
        emit_float_to_float(cx, from, to);
    } else if is_float(to) {
        emit_int_to_float(cx, from, to);
    } else if is_float(from) {
        emit_float_to_int(cx, from, to);
    } else if from != TY_BOOL {
        // Integers and pointers: the accumulator is canonical for `from`,
        // so this truncates or extends.
        emit_normalize(cx, to, pcx);
    }
}

// ---- Aggregates ----

// A struct, tuple or array literal, built in a new frame slot.
pub fn gen_aggregate(cx: &mut FnCtx<Comp>, n: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let ty = pcx.nodes[n as usize].ty;
        let kind = pcx.nodes[n as usize].kind;
        let slot = alloc_slot_for(ty, pcx);
        for i in 0..pcx.nodes[n as usize].count {
            let elem = child(n, i, pcx);
            let mut value = elem;
            let mut offset: i64 = 0;
            let mut elem_ty: i64 = 0;
            if kind == StructLit {
                let s = pcx.types[ty as usize].a;
                value = pcx.nodes[elem as usize].b;
                offset = field_offset(s, pcx.nodes[elem as usize].x, pcx);
                elem_ty = (*struct_field(s, pcx.nodes[elem as usize].x, pcx)).ty;
            } else if kind == Tuple {
                offset = tuple_offset(ty, i, pcx);
                elem_ty = type_elem(ty, i, pcx);
            } else {
                elem_ty = pcx.types[ty as usize].a;
                offset = i * type_size(elem_ty, pcx);
            }
            gen_expr(cx, value, pbody, pcx);
            store_to_frame(cx, elem_ty, slot - offset, pcx);
        }
        emit_frame_addr(cx, R_ACC, slot, pcx);
    }
}

// (0.26.1) Array slot `slot` of type ty = the accumulator's value (an
// element's; a compound one's address), in each element.
pub fn gen_repeat_fill(cx: &mut FnCtx<Comp>, ty: i64, slot: i64, pcx: &mut Ctx<Comp>) {
    let elem_ty = pcx.types[ty as usize].a;
    let count = pcx.types[ty as usize].b;
    let elem_size = type_size(elem_ty, pcx);
    if count > 0 && !is_void(elem_ty) && elem_size > 0 {
        let top = new_label(cx);
        if is_compound(elem_ty, pcx) {
            // Copies from the value's address, keeping the cursor and the
            // count in frame slots (copies may call memcpy).
            let source = alloc_slot(8, 8, pcx);
            let cursor = alloc_slot(8, 8, pcx);
            let remaining = alloc_slot(8, 8, pcx);
            store_reg_to_frame(cx, R_ACC, source, pcx);
            emit_frame_addr(cx, R_ACC, slot, pcx);
            store_reg_to_frame(cx, R_ACC, cursor, pcx);
            emit_load_imm(cx, R_ACC, count as u64);
            store_reg_to_frame(cx, R_ACC, remaining, pcx);
            emit_label(cx, top);
            load_reg_from_frame(cx, R_SECOND, cursor, pcx);
            load_reg_from_frame(cx, R_ACC, source, pcx);
            emit_copy(cx, elem_size);
            load_reg_from_frame(cx, R_ACC, cursor, pcx);
            emit_add_imm(cx, R_ACC, elem_size);
            emit_store(cx, TY_U64, R_ACC, R_ADDR, pcx);
            load_reg_from_frame(cx, R_ACC, remaining, pcx);
            emit_decrement(cx, R_ACC);
            emit_store(cx, TY_U64, R_ACC, R_ADDR, pcx);
            emit_jump_unless_zero_result(cx, top);
        } else {
            emit_frame_addr(cx, R_LOOP_PTR, slot, pcx);
            emit_load_imm(cx, R_LOOP_COUNT, count as u64);
            emit_label(cx, top);
            emit_store(cx, elem_ty, R_ACC, R_LOOP_PTR, pcx);
            emit_add_imm(cx, R_LOOP_PTR, elem_size);
            emit_decrement(cx, R_LOOP_COUNT);
            emit_jump_unless_zero_result(cx, top);
        }
    }
}

// ---- Enums and slices ----

// (0.26.1) The rest of a slicing (node n, of a base of type base_ty), its
// base (a slice's or an array's address, a pointer's value, or with
// late_pointer its location) at frame slot `slot` (16 bytes), lo at
// low_slot, hi at high_slot when given; `length` a slot of 8 bytes: what
// the base holds read, the bounds checked, the slice made at slot.
pub fn gen_slice_tail(cx: &mut FnCtx<Comp>, n: i64, base_ty: i64, late_pointer: bool,
    has_high: bool, bound_ty: i64, slot: i64, length: i64, low_slot: i64, high_slot: i64,
    pcx: &mut Ctx<Comp>) {
    let inclusive = pcx.nodes[pcx.nodes[n as usize].b as usize].c != 0;
    let elem_size = type_size(pcx.types[base_ty as usize].a, pcx);
    if is_slice(base_ty, pcx) {
        load_reg_from_frame(cx, R_SECOND, slot, pcx);
        emit_load_reg(cx, R_ACC, R_SECOND);
        store_reg_to_frame(cx, R_ACC, slot, pcx);
        emit_add_imm(cx, R_SECOND, 8);
        emit_load_reg(cx, R_ACC, R_SECOND);
        store_reg_to_frame(cx, R_ACC, length, pcx);
    } else if late_pointer {
        load_reg_from_frame(cx, R_SECOND, slot, pcx);
        emit_load_reg(cx, R_ACC, R_SECOND);
        store_reg_to_frame(cx, R_ACC, slot, pcx);
    } else if pcx.types[base_ty as usize].kind == TyKind::Array {
        emit_load_imm(cx, R_ACC, pcx.types[base_ty as usize].b as u64);
        store_reg_to_frame(cx, R_ACC, length, pcx);
    }
    if !has_high {
        load_reg_from_frame(cx, R_ACC, length, pcx);
        store_reg_to_frame(cx, R_ACC, high_slot, pcx);
    }
    if pcx.types[base_ty as usize].kind != TyKind::Ptr {
        let ok = new_label(cx);
        let fail = new_label(cx);
        // hi <= length (hi < length for `..=`), then lo <= hi (+ 1).
        load_reg_from_frame(cx, R_SECOND, length, pcx);
        load_reg_from_frame(cx, R_ACC, high_slot, pcx);
        emit_compare_jump(cx, if inclusive { Cond::Ge } else { Cond::Gt }, false, fail);
        if inclusive {
            emit_add_imm(cx, R_ACC, 1);
        }
        emit_move_to_second(cx, TY_U64);
        load_reg_from_frame(cx, R_ACC, low_slot, pcx);
        emit_compare_jump(cx, Cond::Le, false, ok);
        emit_label(cx, fail);
        load_reg_from_frame(cx, R_ACC, length, pcx);
        push_x0(cx, pcx);
        load_reg_from_frame(cx, R_SECOND, high_slot, pcx);
        if inclusive {
            emit_add_imm(cx, R_SECOND, 1);
        }
        load_reg_from_frame(cx, R_ACC, low_slot, pcx);
        pop_x(cx, R_ADDR, pcx);
        let pcx_site3 = site_of(n, 0, pcx);
        emit_panic(cx, panic_kind(bound_ty, range: true), pcx, pcx_site3);
        emit_label(cx, ok);
    }
    // ptr += lo * size; len = hi (+ 1) - lo.
    load_reg_from_frame(cx, R_ACC, low_slot, pcx);
    load_reg_from_frame(cx, R_SECOND, slot, pcx);
    emit_index_addr(cx, elem_size);
    store_reg_to_frame(cx, R_ACC, slot, pcx);
    load_reg_from_frame(cx, R_ACC, low_slot, pcx);
    emit_move_to_second(cx, TY_U64);
    load_reg_from_frame(cx, R_ACC, high_slot, pcx);
    if inclusive {
        emit_add_imm(cx, R_ACC, 1);
    }
    emit_int_binary(cx, Tok::Minus, TY_U64);
    store_reg_to_frame(cx, R_ACC, slot - 8, pcx);
    emit_frame_addr(cx, R_ACC, slot, pcx);
}

// ---- Assignment ----
