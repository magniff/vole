// --check-alloc's allocation sites in gen0 (0.16): as middle/checkalloc.vl,
// for the -O0 code generator: std::CHECK_ALLOC_SITE = the call's site,
// right before the call (its arguments are on the stack).

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::TY_U64;
use crate::gen0::gen::expr::emit_static_addr;
use crate::gen0::target::{R_ACC, R_SECOND, emit_store, emit_string_addr, pop_x, push_x0};
use crate::middle::checkalloc::{drop_needs_site, needs_site, site_static, site_text};
use crate::middle::ctx::FnCtx;

// Before generating call n's call sequence: its site, when it needs one.
pub fn site_before_call(cx: inout FnCtx, n: i64, pcx: inout Ctx<Comp>) {
    if !needs_site(n, pcx.gen_cur_fn, &pcx) {
        return;
    }
    emit_string_addr(&cx, site_text(pcx.nodes[n].start, &pcx));
    push_x0(&cx, &pcx);
    emit_static_addr(&cx, site_static(&pcx), &pcx);
    pop_x(&cx, R_SECOND, &pcx);
    emit_store(&cx, TY_U64, R_SECOND, R_ACC, pcx);
}

// (0.26.1) Before a drop's shim call (the places IR's `drop(P)`): its
// site, source position pos, when it needs one (as middle/checkalloc.vl's
// site_before_drop).
pub fn site_before_drop(cx: inout FnCtx, pos: i64, pcx: inout Ctx<Comp>) {
    if !drop_needs_site(pcx.gen_cur_fn, &pcx) {
        return;
    }
    emit_string_addr(&cx, site_text(pos, &pcx));
    push_x0(&cx, &pcx);
    emit_static_addr(&cx, site_static(&pcx), &pcx);
    pop_x(&cx, R_SECOND, &pcx);
    emit_store(&cx, TY_U64, R_SECOND, R_ACC, pcx);
}
