// -O0 from the places IR (0.26.1, docs/design/places-ir.md §8 step 5):
// a function's kept body (places/keep.vl) generated by gen0, in place of
// the AST walk of mod.vl (which VOLE_LOWER=ast and --no-places keep).
//
// Every local is a frame slot (a parameter's: the one gen_params gives
// its AST local; a static: its address, made at each use); the AST's
// locals are given their IR locals' slots, so that what is generated
// again from the AST (a contract check's conditions and shown operands)
// reads the same memory. The blocks are emitted in reverse postorder, a
// label each (an empty block that jumps on is its target's). A place
// becomes its address in the accumulator (a frame offset when it is a
// local's part at a constant offset); an operand its value (a compound
// one's address). Calls, intrinsics and vector operations go through
// the AST walk's functions with their operands bound (G_BOUND: gen_expr
// of a bound node generates the IR's operand instead), or for one the
// builder made, the call sequence itself. Which bodies are generated
// here is middle/lower/places.vl's take_body (the same as at -O1 and
// -O2); the others, and an atomic intrinsic's, by mod.vl's gen_function.

use crate::back::abi::returns_through_pointer;
use crate::back::dwarf::{DEBUG_INFO, dbg_function_begin, dbg_function_end};
use crate::base::{buf_bytes, buf_clear, buf_slice};
use crate::base::comp::Comp;
use crate::front::ast::{DEFERS, DEFER_LOOPS, NODES, NodeKind, child};
use crate::front::check::{LOCALS, LOCAL_COUNT};
use crate::front::consteval::{const_value, f64_of_bits, float_const, wrap_int};
use crate::front::contracts::sites::site_of;
use crate::front::distinct::{enum_niche, erase_type};
use crate::front::lexer::Tok;
use crate::front::types::{
    ENUMS, FNS, TYPES, TY_BOOL, TY_I64, TY_NEVER, TY_U64, TyKind, VARIANTS, field_offset, fn_param,
    is_compound, is_float, is_slice, is_vector, is_void, tuple_offset, type_elem, type_size,
    variant_field, variant_field_offset,
};
use crate::gen0::gen::{
    CUR_FN, FRAME_SIZE, OVERALIGNED, RESULT_SLOT, RETURN_LABEL, STMT_POS, alloc_slot,
    alloc_slot_for, fn_is_global, fn_symbol_prefix, gen_main_arch_init, gen_params,
    gen_return_value, load_from_x0, pop_second_operand, stmt_loc, store_reg_to_frame,
    store_to_frame,
};
use crate::gen0::gen::call::{gen_call, gen_call_sequence, gen_contract_check_of, gen_pass_arg};
use crate::gen0::gen::checkalloc::site_before_call;
use crate::gen0::gen::expr::{
    emit_static_addr, gen_cast, gen_fn_address, gen_operator, gen_repeat_fill, gen_slice_tail,
    gen_string_id, gen_unop, panic_kind,
};
use crate::gen0::gen::vector::{
    gen_vecop, gen_vector_binary, gen_vector_negate, vector_assign_lanes, vector_value_to_slot,
};
use crate::gen0::target::{
    DEPTH, R_ACC, R_ADDR, R_RESULT, R_SECOND, emit_add_imm, emit_compare, emit_compare_jump,
    emit_copy, emit_epilogue, emit_frame_addr, emit_frame_reserve, emit_function_start,
    emit_index_addr, emit_int_binary, emit_jump, emit_jump_if_zero, emit_label, emit_load,
    emit_load_float, emit_load_imm, emit_load_reg, emit_move_to_second, emit_normalize, emit_panic,
    emit_store, emit_string_addr, new_label, pop_d, pop_x, push_value, push_x0,
};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Cond;
use crate::middle::lower::atomic::atomic_intrinsic;
use crate::middle::lower::places::{
    is_forward, local_type, op_fresh, op_type, place_ty, take_body, token_of,
};
use crate::places::cfg::RPO;
use crate::places::ir::{
    AK_CLOSURE, AK_STRUCT, AK_TUPLE, AK_VARIANT, BO_ADD, BO_AND, BO_EQ, BO_GE, BO_GT, BO_LE, BO_LT,
    BO_MUL, BO_NE, BO_OR, BO_XOR, DS_FLAG, DS_KEPT, IK_ARCH, IK_CONTRACT, IK_PANIC, IK_VECTOR,
    LF_STATIC, OK_CONST, OK_COPY, OK_CSTR, OK_FLOAT, OK_FN, OK_INT, OK_MOVE, OK_PLACE, OK_STR,
    OK_UNIT, PJ_CONST, PJ_DEREF, PJ_FIELD, PJ_INDEX, PJ_UNION, PJ_VARIANT, PStmt, P_LOCALS, P_STMTS,
    P_TARGETS, RV_AGG, RV_BINARY, RV_CAST, RV_DISCR, RV_LEN, RV_REF, RV_REPEAT, RV_SLICE, RV_UNARY,
    RV_USE, SK_ASSERT, SK_ASSIGN, SK_CALL, SK_DROP, SK_INTRINSIC, TK_GOTO, TK_RETURN, TK_SWITCH,
    UO_NEG, UO_NOT, block_count, block_len, block_start, block_term, full_place_type, has_flag,
    local_count, op_a, op_b, op_kind, proj_kind, proj_parent, proj_val,
};
use crate::places::keep::free_body;
use crate::places::shim::drop_shim_fn;

// The AST nodes bound to IR operands, as triples (node, operand list,
// index): gen_expr of such a node generates the operand (gen_bound).
pub static var G_BOUND: Vec<i64, Comp> = Vec::new_in(Comp {});

// Per local of the body held: its frame slot (-1: none: void, or a
// static). Per block: its label, and the block it forwards to.
static var SLOT: Vec<i64, Comp> = Vec::new_in(Comp {});
static var LABEL: Vec<i64, Comp> = Vec::new_in(Comp {});
static var FWD: Vec<i64, Comp> = Vec::new_in(Comp {});
// The block emitted after the current one (-1: none), so that a jump to
// it is left out.
static var NEXT: i64 = -1;
// The emitted blocks in order (gen_blocks); the slots share_slots hands
// out, by size and alignment, and the last mention of their last user.
static var ORDER: Vec<i64, Comp> = Vec::new_in(Comp {});
static var POOL_SLOT: Vec<i64, Comp> = Vec::new_in(Comp {});
static var POOL_SIZE: Vec<i64, Comp> = Vec::new_in(Comp {});
static var POOL_ALIGN: Vec<i64, Comp> = Vec::new_in(Comp {});
static var POOL_LAST: Vec<i64, Comp> = Vec::new_in(Comp {});

// Per local: its mentions in the body (count_mentions).
static var MENTIONS: Vec<i64, Comp> = Vec::new_in(Comp {});
// Per local: whether the accumulator carries it (find_acc_only): no slot,
// written and read in the accumulator (write_place, gen_place_value).
static var ACC_ONLY: Vec<bool, Comp> = Vec::new_in(Comp {});
// Per emitted block: its predecessors, a list (P_HEAD, then P_NEXT) of
// the blocks in P_FROM.
static var P_HEAD: Vec<i64, Comp> = Vec::new_in(Comp {});
static var P_NEXT: Vec<i64, Comp> = Vec::new_in(Comp {});
static var P_FROM: Vec<i64, Comp> = Vec::new_in(Comp {});
// Per block: whether it has nothing but a return (return_block), and the
// local the accumulator holds at its start (-1: none known; every
// predecessor's last statement wrote it, or each one's switch read it).
static var RET_BLOCK: Vec<bool, Comp> = Vec::new_in(Comp {});
static var START_HOLD: Vec<i64, Comp> = Vec::new_in(Comp {});

// Function f (its Fn node: item) generated from its kept body: false
// when it has none (or one take_body leaves to the AST walk), or is an
// atomic intrinsic.
pub fn gen_places_function(cx: sink *FnCtx, item: i64, f: i64) -> bool {
    if atomic_intrinsic(f) >= 0 {
        return false;
    }
    if !take_body(f, true) {
        return false;
    }
    gen_body(cx, item, f);
    free_body(f);
    true
}

// Generates the operand node n is bound to; false when it is not bound.
pub fn gen_bound(cx: sink *FnCtx, n: i64) -> bool {
    var k = 0;
    while k < G_BOUND.len() as i64 {
        if G_BOUND[k] == n {
            gen_op(cx, G_BOUND[k + 1], G_BOUND[k + 2]);
            return true;
        }
        k += 3;
    }
    false
}

// Binds AST node e to operand i at `ops`: a place's value or address, or
// a unit (nothing: its expression, a call, ran in the statement before;
// generating it again would run it twice); a constant is left to the AST
// (a check's site is one).
fn bind(e: i64, ops: i64, i: i64) {
    let k = op_kind(ops, i);
    if k != OK_COPY && k != OK_MOVE && k != OK_PLACE && k != OK_UNIT {
        return;
    }
    G_BOUND.push(e);
    G_BOUND.push(ops);
    G_BOUND.push(i);
}

fn unbind() {
    G_BOUND.clear();
}

// ---- The function ----

// As mod.vl's gen_function: the prologue, the parameters, the blocks,
// the epilogue.
fn gen_body(cx: sink *FnCtx, item: i64, f: i64) {
    // UNSAFE: NODES, FNS and LOCALS are the checker's raw tables, cx the code
    // generator's raw context pointer (as in mod.vl's gen_function).
    // SAFETY: item is f's Fn node and f below FN_COUNT; ast is checked against
    // LOCAL_COUNT before LOCALS is written; cx points at compile_program's live
    // FnCtx; code generation is single-threaded.
    unsafe {
        CUR_FN = f;
        DEFERS.count = 0;
        DEFER_LOOPS.count = 0;
        buf_clear(cx.code);
        DEPTH = 0;
        FRAME_SIZE = 0;
        OVERALIGNED.count = 0;
        RETURN_LABEL = new_label(cx);
        STMT_POS = -1;
        dbg_function_begin(cx, f, fn_symbol_prefix(f), NODES[item].start);
        emit_function_start(cx, fn_symbol_prefix(f), FNS[f].name, fn_is_global(f));
        let ret = FNS[f].ret;
        RESULT_SLOT = 0;
        if returns_through_pointer(cx, ret) {
            RESULT_SLOT = alloc_slot(8, 8);
            emit_frame_addr(cx, R_ADDR, RESULT_SLOT);
            emit_store(cx, TY_U64, R_RESULT, R_ADDR);
        }
        gen_params(cx, item, f);
        gen_main_arch_init(cx, f);
        let n = local_count();
        SLOT.clear();
        for _ in 0..n {
            SLOT.push(-1);
        }
        for i in 0..FNS[f].param_count {
            let ast = NODES[child(item, i)].x;
            if i + 1 < n && ast >= 0 && !is_void(fn_param(f, i)) {
                SLOT[i + 1] = LOCALS[ast].offset;
            }
        }
        forward_blocks();
        scan_locals();
        for l in 0..n {
            let ty = local_type(l);
            if has_flag(l, LF_STATIC) || is_void(ty) || ty == TY_NEVER || ACC_ONLY[l] {
                continue;
            }
            if SLOT[l] < 0 && !shares_slot(l) && (MENTIONS[l] > 0 || P_LOCALS[l].src >= 0) {
                SLOT[l] = alloc_slot_for(ty);
            }
            let ast = P_LOCALS[l].src;
            if ast >= 0 && ast < LOCAL_COUNT {
                LOCALS[ast].offset = SLOT[l];
            }
        }
        share_slots();
        gen_blocks(cx);
        emit_label(cx, RETURN_LABEL);
        if is_void(ret) && FNS[f].name == crate::gen0::gen::MAIN_SYM {
            // `main` without a result exits with 0.
            emit_load_imm(cx, R_ACC, 0);
        }
        emit_epilogue(cx);
        emit_frame_reserve(cx, FRAME_SIZE);
        buf_bytes(cx.asm, buf_slice(cx.code));
        dbg_function_end(cx);
    }
}

// The blocks in reverse postorder, each its label, its statements and
// its terminator.
fn gen_blocks(cx: sink *FnCtx) {
    LABEL.clear();
    for _ in 0..block_count() {
        LABEL.push(0);
    }
    for i in 0..RPO.len() as i64 {
        let b = RPO[i];
        if FWD[b] == b {
            LABEL[b] = new_label(cx);
        }
    }
    // (the emitted blocks, in order: not a block only an inlined return
    // reached)
    let first = FWD[RPO[0]];
    ORDER.clear();
    for i in 0..RPO.len() as i64 {
        let b = RPO[i];
        if FWD[b] == b && (P_HEAD[b] >= 0 || b == first) {
            ORDER.push(b);
        }
    }
    if ORDER.len() as i64 == 0 || ORDER[0] != first {
        emit_jump(cx, LABEL[first]);
    }
    for i in 0..ORDER.len() as i64 {
        let b = ORDER[i];
        NEXT = if i + 1 < ORDER.len() as i64 { ORDER[i + 1] } else { -1 };
        if jumped_to(b, if i > 0 { ORDER[i - 1] } else { -1 }) {
            emit_label(cx, LABEL[b]);
        }
        let start = block_start(b);
        let len = block_len(b);
        for j in 0..len {
            gen_stmt(cx, start + j);
        }
        gen_term(cx, block_term(b));
    }
    NEXT = -1;
}

// Each block's forward (FWD: itself, or for an empty block that jumps on,
// where it leads), whether it has nothing but a return (RET_BLOCK), each
// emitted block's predecessors (a jump to a block with nothing but a
// return is the return itself: no edge), and the local the accumulator
// holds at each block's start (START_HOLD).
fn forward_blocks() {
    let nb = block_count();
    FWD.clear();
    P_HEAD.clear();
    P_NEXT.clear();
    P_FROM.clear();
    RET_BLOCK.clear();
    START_HOLD.clear();
    for b in 0..nb {
        FWD.push(b);
        P_HEAD.push(-1);
        RET_BLOCK.push(false);
        START_HOLD.push(-1);
    }
    for i in 0..RPO.len() as i64 {
        let b = RPO[i];
        RET_BLOCK[b] = return_block(b);
        var t = b;
        var steps = 0;
        while steps < 64 && is_forward(t) {
            t = P_STMTS[block_term(t)].a;
            steps += 1;
        }
        if steps < 64 {
            FWD[b] = t;
        }
    }
    for i in 0..RPO.len() as i64 {
        let b = RPO[i];
        if FWD[b] != b {
            continue;
        }
        let t = P_STMTS[block_term(b)];
        if t.kind == TK_GOTO && RET_BLOCK[t.a] {
            continue;
        }
        let holds = end_hold(b);
        for k in 0..crate::places::ir::succ_count(b) {
            let to = FWD[crate::places::ir::succ(b, k)];
            // (its first predecessor's, then -1 when another's differs)
            if P_HEAD[to] < 0 {
                START_HOLD[to] = holds;
            } else if START_HOLD[to] != holds {
                START_HOLD[to] = -1;
            }
            P_FROM.push(b);
            P_NEXT.push(P_HEAD[to]);
            P_HEAD[to] = P_FROM.len() as i64 - 1;
        }
    }
    START_HOLD[FWD[RPO[0]]] = -1;
}

// The local the accumulator holds at the end of block b (-1: none): its
// switch's operand, or what its last statement before a jump wrote.
fn end_hold(b: i64) -> i64 {
    let t = P_STMTS[block_term(b)];
    if t.kind == TK_SWITCH {
        let k = op_kind(t.ops, 0);
        if (k == OK_COPY || k == OK_MOVE) && op_b(t.ops, 0) == 0 {
            return op_a(t.ops, 0);
        }
        return -1;
    }
    if t.kind != TK_GOTO {
        return -1;
    }
    var j = block_term(b) - 1;
    while j >= block_start(b) {
        if does_something(j) {
            let s = P_STMTS[j];
            return if writes_held(s, s.a) { s.a } else { -1 };
        }
        j -= 1;
    }
    -1
}

// The one pass over the body's statements before it is generated:
//
// - each local's mentions (MENTIONS; M_FIRST, M_LAST, M_BLOCK, M_WRITTEN,
//   M_ORDER for share_slots): as a statement's place, an operand, an
//   index or a drop's flag;
// - the locals the accumulator carries (ACC_ONLY): a scalar statement
//   temporary (or the result _0, a compound one's address) whose every
//   read is what its statement generates first and finds in the
//   accumulator: written by the statement before it in its block, or,
//   at a block's start, at the end of every predecessor (START_HOLD).
//   Neither store nor load: the AST walk's value in the accumulator
//   across `&&`, `||` and an `if`'s arms.
fn scan_locals() {
    let n = local_count();
    MENTIONS.clear();
    M_FIRST.clear();
    M_LAST.clear();
    M_BLOCK.clear();
    M_WRITTEN.clear();
    M_ORDER.clear();
    ACC_ONLY.clear();
    for l in 0..n {
        MENTIONS.push(0);
        M_FIRST.push(0);
        M_LAST.push(0);
        M_BLOCK.push(-1);
        M_WRITTEN.push(false);
        let ty = local_type(l);
        ACC_ONLY.push((l == 0 || l > crate::places::ir::B_PARAMS && P_LOCALS[l].src < 0
            && !is_compound(ty)) && !has_flag(l, LF_STATIC) && !is_void(ty) && ty != TY_NEVER
            && !has_flag(l, crate::places::ir::LF_BORROWED));
    }
    let first = FWD[RPO[0]];
    for i in 0..RPO.len() as i64 {
        let b = RPO[i];
        // (an emitted block: not one only an inlined return reached)
        let emitted = FWD[b] == b && (P_HEAD[b] >= 0 || b == first);
        let start = block_start(b);
        // (the local the accumulator holds before the statement)
        var held = START_HOLD[b];
        for j in 0..block_len(b) + 1 {
            let at = start + j;
            let s = P_STMTS[at];
            let k = s.kind;
            if k == crate::places::ir::SK_LIVE || k == crate::places::ir::SK_DEAD
                || k == crate::places::ir::SK_NOP {
                continue;
            }
            // (the operands read first, then the place written)
            for o in 0..s.nops {
                let ok = op_kind(s.ops, o);
                if ok != OK_COPY && ok != OK_MOVE && ok != OK_PLACE {
                    continue;
                }
                let l = op_a(s.ops, o);
                let p = op_b(s.ops, o);
                mention_place(l, p, at, b, ok == OK_PLACE);
                if ACC_ONLY[l] && !(emitted && l == held && ok != OK_PLACE && p == 0
                    && (o == 0 && reads_first(at, l) || o == 1 && reads_second(at, l))) {
                    ACC_ONLY[l] = false;
                }
            }
            // (the result, read by a return)
            if emitted && held != 0 && ACC_ONLY[0]
                && (k == TK_RETURN || k == TK_GOTO && RET_BLOCK[s.a]) {
                ACC_ONLY[0] = false;
            }
            var writes = false;
            if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC {
                if s.b == 0 {
                    // (a whole write)
                    let w = MENTIONS[s.a] == 0;
                    mention(s.a, at, b, false);
                    if w {
                        M_WRITTEN[s.a] = true;
                    }
                    if ACC_ONLY[s.a] {
                        writes = leaves_in_acc(s);
                        if emitted && !writes {
                            ACC_ONLY[s.a] = false;
                        }
                    }
                } else {
                    mention_place(s.a, s.b, at, b, false);
                    ACC_ONLY[s.a] = false;
                }
            } else if k == SK_DROP || k == crate::places::ir::SK_MENTION {
                mention_place(s.a, s.b, at, b, true);
                ACC_ONLY[s.a] = false;
                if k == SK_DROP && s.c == DS_FLAG {
                    mention(s.d, at, b, false);
                    ACC_ONLY[s.d] = false;
                }
            }
            if k != crate::places::ir::SK_MENTION {
                held = if writes { s.a } else { -1 };
            }
        }
    }
}

// Local l mentioned by statement `at` of block b (`placed`: its address
// taken, or a part of it).
fn mention(l: i64, at: i64, b: i64, placed: bool) {
    if MENTIONS[l] == 0 {
        M_FIRST[l] = at;
        M_BLOCK[l] = b;
        M_ORDER.push(l);
    } else if M_BLOCK[l] != b {
        M_BLOCK[l] = -2;
    }
    M_LAST[l] = at;
    MENTIONS[l] += 1;
    if placed {
        // (its storage named: not shared)
        M_BLOCK[l] = -2;
    }
}

// Place (l, p) mentioned (its index locals too, which are not carried).
fn mention_place(l: i64, p: i64, at: i64, b: i64, placed: bool) {
    if p == 0 {
        mention(l, at, b, placed);
        return;
    }
    mention(l, at, b, placed || !const_chain(p));
    var q = p;
    while q > 0 {
        if proj_kind(q) == PJ_INDEX {
            let v = proj_val(q);
            mention(v, at, b, false);
            ACC_ONLY[v] = false;
        }
        q = proj_parent(q);
    }
}

// Whether statement s, writing its local whole, leaves the value in the
// accumulator (its generation ends with write_place).
fn leaves_in_acc(s: PStmt) -> bool {
    if s.kind != SK_ASSIGN {
        return s.kind == SK_CALL || s.c == IK_ARCH || s.c == IK_VECTOR;
    }
    let dt = place_ty(s.a, 0);
    if s.c == RV_AGG {
        return s.d == AK_VARIANT && !is_compound(dt);
    }
    !(s.c == RV_BINARY && is_vector(dt))
}

// Whether statement s writes local l whole and leaves it in the
// accumulator.
fn writes_held(s: PStmt, l: i64) -> bool {
    (s.kind == SK_ASSIGN || s.kind == SK_CALL || s.kind == SK_INTRINSIC) && s.a == l && s.b == 0
        && leaves_in_acc(s)
}

// Per local: its first and last mention (statement indices), its block
// (-1: none, -2: several, or its storage named), whether its first
// mention writes it whole; the locals in the order of their first
// mention (in reverse postorder).
static var M_FIRST: Vec<i64, Comp> = Vec::new_in(Comp {});
static var M_LAST: Vec<i64, Comp> = Vec::new_in(Comp {});
static var M_BLOCK: Vec<i64, Comp> = Vec::new_in(Comp {});
static var M_WRITTEN: Vec<bool, Comp> = Vec::new_in(Comp {});
static var M_ORDER: Vec<i64, Comp> = Vec::new_in(Comp {});

// Whether local l is a statement temporary that may share its slot with
// another: not the AST's, not a parameter or the result, mentioned in
// one block only, written whole first, its storage not named (no
// address taken of it: a reference, a slice of it, a drop).
fn shares_slot(l: i64) -> bool {
    l > crate::places::ir::B_PARAMS && P_LOCALS[l].src < 0 && M_BLOCK[l] >= 0 && M_WRITTEN[l]
        && !has_flag(l, crate::places::ir::LF_BORROWED) && !ACC_ONLY[l]
}

// The slots of the statement temporaries (shares_slot), each one's
// reused by a later one of the same size and alignment once the earlier
// is last mentioned (a linear scan per block: a temporary is dead past
// its block). Shared slots keep the frame small, its offsets in reach of
// one instruction.

fn share_slots() {
    POOL_SLOT.clear();
    POOL_SIZE.clear();
    POOL_ALIGN.clear();
    POOL_LAST.clear();
    var block = -1;
    for i in 0..M_ORDER.len() as i64 {
        let l = M_ORDER[i];
        if SLOT[l] >= 0 || !shares_slot(l) {
            continue;
        }
        let ty = local_type(l);
        if has_flag(l, LF_STATIC) || is_void(ty) || ty == TY_NEVER {
            continue;
        }
        if M_BLOCK[l] != block {
            block = M_BLOCK[l];
            for k in 0..POOL_LAST.len() as i64 {
                POOL_LAST[k] = -1;
            }
        }
        let size = if is_compound(ty) { crate::front::types::align_to(type_size(ty), 8) }
            else { type_size(ty) };
        let align = crate::front::types::type_align(ty);
        var found = -1;
        for k in 0..POOL_SLOT.len() as i64 {
            if POOL_SIZE[k] == size && POOL_ALIGN[k] == align && POOL_LAST[k] < M_FIRST[l] {
                found = k;
                break;
            }
        }
        if found >= 0 {
            SLOT[l] = POOL_SLOT[found];
            POOL_LAST[found] = M_LAST[l];
        } else {
            SLOT[l] = alloc_slot_for(ty);
            POOL_SLOT.push(SLOT[l]);
            POOL_SIZE.push(size);
            POOL_ALIGN.push(align);
            POOL_LAST.push(M_LAST[l]);
        }
    }
}

// Whether statement (or terminator) `at` does something (not a storage
// marker or a no-op).
fn does_something(at: i64) -> bool {
    let k = P_STMTS[at].kind;
    k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC || k == SK_DROP || k == SK_ASSERT
        || k == TK_GOTO || k == TK_SWITCH || k == TK_RETURN
        || k == crate::places::ir::TK_UNREACHABLE
}

// Whether block b has nothing but a return.
fn return_block(b: i64) -> bool {
    for j in 0..block_len(b) {
        if does_something(block_start(b) + j) {
            return false;
        }
    }
    P_STMTS[block_term(b)].kind == TK_RETURN
}

// Whether statement `at` reads local l (whole, its value) before anything
// else: the operand its generation starts with.
fn reads_first(at: i64, l: i64) -> bool {
    let s = P_STMTS[at];
    let k = s.kind;
    if k == TK_RETURN || k == TK_GOTO && RET_BLOCK[s.a] {
        return l == 0;
    }
    if s.nops == 0 || op_b(s.ops, 0) != 0 || op_a(s.ops, 0) != l {
        return false;
    }
    let ok = op_kind(s.ops, 0);
    if ok != OK_COPY && ok != OK_MOVE {
        return false;
    }
    if k == TK_SWITCH || k == SK_ASSERT {
        return true;
    }
    if k == SK_ASSIGN {
        let rv = s.c;
        if rv == RV_USE || rv == RV_CAST {
            return true;
        }
        if rv == RV_BINARY || rv == RV_UNARY {
            return !is_vector(op_type(s.ops, 0));
        }
        return false;
    }
    // (a call of a function: its first argument first)
    if k == SK_CALL && s.c >= 0 {
        return !bound_call(s) || plain_call(s);
    }
    false
}

// R_SECOND = operand i at `ops` when that takes no stack and leaves the
// accumulator: an integer constant, or an 8-byte integer (or pointer)
// in the frame; false (nothing emitted) otherwise.
fn gen_second(cx: sink *FnCtx, ops: i64, i: i64) -> bool {
    let k = op_kind(ops, i);
    if k == OK_INT || k == OK_CONST {
        let t = erase_type(op_b(ops, i));
        if is_float(t) {
            return false;
        }
        let v = if k == OK_INT { wrap_int(op_a(ops, i), t) } else { const_value(op_a(ops, i)) };
        emit_load_imm(cx, R_SECOND, v as u64);
        return true;
    }
    if k != OK_COPY && k != OK_MOVE {
        return false;
    }
    let l = op_a(ops, i);
    let p = op_b(ops, i);
    let ty = place_ty(l, p);
    if p == 0 && ACC_ONLY[l] || !in_frame(l, p) || is_float(ty) || is_compound(ty)
        || type_size(ty) != 8 {
        return false;
    }
    emit_frame_addr(cx, R_SECOND, SLOT[l] - chain_offset(l, p));
    emit_load_reg(cx, R_SECOND, R_SECOND);
    true
}

// Whether operand i at `ops` is read into the accumulator without
// R_SECOND (its frame slot, a constant), as an assert's index after its
// length.
fn simple_first(ops: i64, i: i64) -> bool {
    let k = op_kind(ops, i);
    if k == OK_INT || k == OK_CONST {
        return !is_float(erase_type(op_b(ops, i)));
    }
    if k != OK_COPY && k != OK_MOVE {
        return false;
    }
    let l = op_a(ops, i);
    let ty = place_ty(l, op_b(ops, i));
    !has_flag(l, LF_STATIC) && const_chain(op_b(ops, i)) && !is_float(ty) && !is_compound(ty)
}

// Whether operand i at `ops` is a local the accumulator carries.
fn is_carried(ops: i64, i: i64) -> bool {
    let k = op_kind(ops, i);
    (k == OK_COPY || k == OK_MOVE) && op_b(ops, i) == 0 && ACC_ONLY[op_a(ops, i)]
}

// Whether operand i at `ops` is local l's whole value.
fn op_is_local(ops: i64, i: i64, l: i64) -> bool {
    let k = op_kind(ops, i);
    (k == OK_COPY || k == OK_MOVE) && op_a(ops, i) == l && op_b(ops, i) == 0
}

// The operator of binary operation bo with its operands swapped: itself
// when it commutes, the reverse comparison; Tok::Eof when neither.
fn swapped(bo: i64) -> Tok {
    if bo == BO_ADD || bo == BO_MUL || bo == BO_AND || bo == BO_OR || bo == BO_XOR || bo == BO_EQ
        || bo == BO_NE {
        return token_of(bo);
    }
    if bo == BO_LT { Tok::Gt } else if bo == BO_GT { Tok::Lt } else if bo == BO_LE { Tok::GtEq }
    else if bo == BO_GE { Tok::LtEq } else { Tok::Eof }
}

// Whether the first operand of statement `at` reads local l, the second
// local l, and its operator may swap them.
fn reads_second(at: i64, l: i64) -> bool {
    let s = P_STMTS[at];
    if s.kind == SK_ASSERT {
        // (the length, the index then read without R_SECOND)
        return s.nops == 2 && op_is_local(s.ops, 1, l) && !op_is_local(s.ops, 0, l)
            && simple_first(s.ops, 0) && !(op_kind(s.ops, 0) != OK_INT
                && op_kind(s.ops, 0) != OK_CONST && op_a(s.ops, 0) == l);
    }
    if s.kind != SK_ASSIGN || s.c != RV_BINARY || s.nops != 2 || !op_is_local(s.ops, 1, l)
        || op_is_local(s.ops, 0, l) || is_vector(op_type(s.ops, 0)) {
        return false;
    }
    swapped(s.d) != Tok::Eof
}

// Whether a jump lands at block b, emitted after block `prev` (-1: first):
// a predecessor other than prev, or prev's switch (its jumps name their
// targets); the function's jump to its first block.
fn jumped_to(b: i64, prev: i64) -> bool {
    if prev < 0 && b != FWD[RPO[0]] || prev >= 0 && b == FWD[RPO[0]] {
        return true;
    }
    var e = P_HEAD[b];
    while e >= 0 {
        let from = P_FROM[e];
        if from != prev || P_STMTS[block_term(from)].kind != TK_GOTO {
            return true;
        }
        e = P_NEXT[e];
    }
    false
}

// A jump to block b (forwarded), unless it is the next one emitted.
fn jump_to(cx: sink *FnCtx, b: i64) {
    let t = FWD[b];
    if t != NEXT {
        emit_jump(cx, LABEL[t]);
    }
}

// ---- Places and operands ----

// Whether projection list p is a local's part at a constant offset (no
// `*`, no index).
fn const_chain(p: i64) -> bool {
    var q = p;
    while q > 0 {
        let k = proj_kind(q);
        if k == PJ_DEREF || k == PJ_INDEX {
            return false;
        }
        q = proj_parent(q);
    }
    true
}

// The offset of projection p (a field, a union's field, a constant
// index) in the place of its parent, of local l.
fn proj_offset(l: i64, p: i64) -> i64 {
    // UNSAFE: TYPES is the checker's raw table of types.
    // SAFETY: pt is the checked (erased) type of p's parent, below TYPE_COUNT.
    unsafe {
        let parent = proj_parent(p);
        let k = proj_kind(p);
        let v = proj_val(p);
        if k == PJ_VARIANT {
            return 0;
        }
        let pt = place_ty(l, parent);
        if k == PJ_CONST {
            return v * type_size(TYPES[pt].a);
        }
        if parent > 0 && proj_kind(parent) == PJ_VARIANT {
            return variant_field_offset(proj_val(parent), v);
        }
        let tk = TYPES[pt].kind;
        if tk == TyKind::Struct {
            return field_offset(TYPES[pt].a, v);
        }
        if tk == TyKind::Tuple {
            return tuple_offset(pt, v);
        }
        // (a slice's pointer and length)
        v * 8
    }
}

// The offset of place (l, p) in l, p a constant chain.
fn chain_offset(l: i64, p: i64) -> i64 {
    var off = 0;
    var q = p;
    while q > 0 {
        off += proj_offset(l, q);
        q = proj_parent(q);
    }
    off
}

// Whether place (l, p) is in l's frame slot at a constant offset.
fn in_frame(l: i64, p: i64) -> bool {
    !has_flag(l, LF_STATIC) && SLOT[l] >= 0 && const_chain(p)
}

// Accumulator = the address of place (l, p).
fn gen_place_addr(cx: sink *FnCtx, l: i64, p: i64) {
    // UNSAFE: P_LOCALS is the places IR's table and TYPES the checker's.
    // SAFETY: l is a local of the body held (below local_count), pt the checked
    // type of p's parent.
    unsafe {
        if in_frame(l, p) {
            emit_frame_addr(cx, R_ACC, SLOT[l] - chain_offset(l, p));
            return;
        }
        if p == 0 {
            // (a static's: its symbol)
            emit_static_addr(cx, P_LOCALS[l].src);
            return;
        }
        let parent = proj_parent(p);
        let k = proj_kind(p);
        if k == PJ_DEREF {
            gen_place_value(cx, l, parent);
            return;
        }
        if k == PJ_VARIANT {
            gen_place_addr(cx, l, parent);
            return;
        }
        if k == PJ_FIELD || k == PJ_UNION || k == PJ_CONST {
            gen_place_addr(cx, l, parent);
            let off = proj_offset(l, p);
            if off != 0 {
                emit_add_imm(cx, R_ACC, off);
            }
            return;
        }
        // PJ_INDEX: element v (a local) of an array, a slice's buffer or a
        // pointer's
        let pt = place_ty(l, parent);
        let elem_size = type_size(TYPES[pt].a);
        if TYPES[pt].kind == TyKind::Ptr {
            gen_place_value(cx, l, parent);
        } else if is_slice(pt) {
            gen_place_addr(cx, l, parent);
            emit_load_reg(cx, R_ACC, R_ACC);
        } else {
            gen_place_addr(cx, l, parent);
        }
        push_x0(cx);
        gen_place_value(cx, proj_val(p), 0);
        pop_x(cx, R_SECOND);
        emit_index_addr(cx, elem_size);
    }
}

// Accumulator = the value of place (l, p) (a compound one's address).
fn gen_place_value(cx: sink *FnCtx, l: i64, p: i64) {
    if p == 0 && ACC_ONLY[l] {
        return;
    }
    let ty = place_ty(l, p);
    if is_void(ty) || ty == TY_NEVER {
        return;
    }
    gen_place_addr(cx, l, p);
    load_from_x0(cx, ty);
}

// Place (l, p) = the accumulator's value, of the place's type (a compound
// one's address, copied).
fn write_place(cx: sink *FnCtx, l: i64, p: i64) {
    let ty = place_ty(l, p);
    if is_void(ty) || ty == TY_NEVER {
        return;
    }
    if p == 0 && ACC_ONLY[l] {
        return;
    }
    if in_frame(l, p) {
        store_to_frame(cx, ty, SLOT[l] - chain_offset(l, p));
        return;
    }
    // (the value waits on the stack while the address is made, as
    // expr.vl's gen_assign)
    push_value(cx, ty);
    gen_place_addr(cx, l, p);
    emit_move_to_second(cx, TY_U64);
    if is_float(ty) {
        pop_d(cx, 0);
    } else {
        pop_x(cx, R_ACC);
    }
    if is_compound(ty) {
        emit_copy(cx, type_size(ty));
    } else {
        emit_store(cx, ty, R_ACC, R_SECOND);
    }
}

// Accumulator = operand i at `ops` (a compound one's address).
fn gen_op(cx: sink *FnCtx, ops: i64, i: i64) {
    let k = op_kind(ops, i);
    let a = op_a(ops, i);
    let b = op_b(ops, i);
    if k == OK_COPY || k == OK_MOVE {
        gen_place_value(cx, a, b);
    } else if k == OK_PLACE {
        gen_place_addr(cx, a, b);
    } else if k == OK_INT {
        emit_load_imm(cx, R_ACC, wrap_int(a, erase_type(b)) as u64);
    } else if k == OK_FLOAT {
        let t = erase_type(b);
        emit_load_float(cx, float_const(f64_of_bits(a), t), t);
    } else if k == OK_STR {
        gen_string_id(cx, a);
    } else if k == OK_CSTR {
        emit_string_addr(cx, a);
    } else if k == OK_FN {
        gen_fn_address(cx, a);
    } else if k == OK_CONST {
        let t = erase_type(b);
        let value = const_value(a);
        if is_float(t) {
            emit_load_float(cx, value, t);
        } else {
            emit_load_imm(cx, R_ACC, value as u64);
        }
    }
}

// ---- Statements ----

fn gen_stmt(cx: sink *FnCtx, at: i64) {
    let s = P_STMTS[at];
    let k = s.kind;
    if k != SK_ASSIGN && k != SK_CALL && k != SK_INTRINSIC && k != SK_DROP && k != SK_ASSERT {
        return;
    }
    if DEBUG_INFO && s.node > 0 {
        stmt_loc(cx, NODES[s.node].start);
    }
    if k == SK_ASSIGN {
        gen_assign(cx, s);
    } else if k == SK_CALL {
        gen_call_stmt(cx, s);
    } else if k == SK_INTRINSIC {
        gen_intrinsic_stmt(cx, s);
    } else if k == SK_DROP {
        gen_drop(cx, s);
    } else {
        // AK_BOUNDS: the index, as unsigned, below the length (the
        // helper is given both, as expr.vl's gen_index_addr)
        if is_carried(s.ops, 1) {
            // (the length in the accumulator; the index read without
            // R_SECOND: simple_first)
            emit_move_to_second(cx, TY_U64);
            gen_op(cx, s.ops, 0);
        } else {
            gen_op(cx, s.ops, 0);
            if !gen_second(cx, s.ops, 1) {
                push_x0(cx);
                gen_op(cx, s.ops, 1);
                emit_move_to_second(cx, TY_U64);
                pop_x(cx, R_ACC);
            }
        }
        let ok = new_label(cx);
        emit_compare_jump(cx, Cond::Lt, false, ok);
        emit_panic(cx, panic_kind(op_type(s.ops, 0), false), site_of(s.d, 0));
        emit_label(cx, ok);
    }
}

// `drop(P)` kept: its type's drop shim called with `&mut P`; under a flag
// (DS_FLAG, flag local d): only when the flag is true.
fn gen_drop(cx: sink *FnCtx, s: PStmt) {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is a shim's function (drop_shim_fn), below FN_COUNT.
    unsafe {
        if s.c != DS_KEPT && s.c != DS_FLAG {
            return;
        }
        let f = drop_shim_fn(full_place_type(s.a, s.b));
        if f < 0 {
            return;
        }
        var skip = 0;
        if s.c == DS_FLAG {
            skip = new_label(cx);
            gen_place_value(cx, s.d, 0);
            emit_jump_if_zero(cx, skip);
        }
        if s.node > 0 {
            crate::gen0::gen::checkalloc::site_before_drop(cx,
                crate::places::print::drop_pos(s.node));
        }
        gen_place_addr(cx, s.a, s.b);
        var arg_types: [i64; 1] = [fn_param(f, 0)];
        gen_pass_arg(cx, arg_types[0], false);
        gen_call_sequence(cx, f, &arg_types as *i64, 1, FNS[f].param_count, false, 1,
            FNS[f].ret);
        if skip != 0 {
            emit_label(cx, skip);
        }
    }
}

fn gen_assign(cx: sink *FnCtx, s: PStmt) {
    let rv = s.c;
    let dl = s.a;
    let dp = s.b;
    let dt = place_ty(dl, dp);
    // UNSAFE: NODES and TYPES are the checker's raw tables.
    // SAFETY: s.e is the statement's node when it has one (a vector
    // operation's), t a checked type.
    unsafe {
        if rv == RV_USE || rv == RV_REF {
            gen_op(cx, s.ops, 0);
        } else if rv == RV_BINARY {
            let ot = op_type(s.ops, 0);
            if is_vector(ot) {
                gen_vector_assign(cx, s, dt);
                return;
            }
            // (the second operand first, the operator swapped, when the
            // accumulator holds it: find_acc_only)
            let swap = is_carried(s.ops, 1);
            gen_op(cx, s.ops, if swap { 1 } else { 0 });
            if is_float(ot) || !gen_second(cx, s.ops, if swap { 0 } else { 1 }) {
                push_value(cx, ot);
                gen_op(cx, s.ops, if swap { 0 } else { 1 });
                pop_second_operand(cx, ot);
            }
            gen_operator(cx, if swap { swapped(s.d) } else { token_of(s.d) }, ot, dt);
        } else if rv == RV_UNARY {
            if is_vector(dt) {
                bind(NODES[s.e].b, s.ops, 0);
                gen_vector_negate(cx, NODES[s.e].b, dt);
                unbind();
            } else {
                gen_op(cx, s.ops, 0);
                let tok = if s.d == UO_NEG { Tok::Minus } else if s.d == UO_NOT { Tok::Bang }
                    else { Tok::Tilde };
                gen_unop(cx, tok, dt);
            }
        } else if rv == RV_CAST {
            gen_op(cx, s.ops, 0);
            gen_cast(cx, op_type(s.ops, 0), erase_type(s.d));
        } else if rv == RV_DISCR {
            gen_discriminant(cx, s.ops);
        } else if rv == RV_LEN {
            let t = op_type(s.ops, 0);
            if TYPES[t].kind == TyKind::Array {
                emit_load_imm(cx, R_ACC, TYPES[t].b as u64);
            } else {
                gen_op(cx, s.ops, 0);
                emit_add_imm(cx, R_ACC, 8);
                emit_load(cx, TY_U64, R_ACC);
            }
        } else if rv == RV_AGG {
            gen_aggregate(cx, s, dt);
            return;
        } else if rv == RV_REPEAT {
            let slot = alloc_slot_for(dt);
            gen_op(cx, s.ops, 0);
            gen_repeat_fill(cx, dt, slot);
            emit_frame_addr(cx, R_ACC, slot);
        } else if rv == RV_SLICE {
            gen_slice(cx, s);
        } else {
            return;
        }
        write_place(cx, dl, dp);
    }
}

// A binary operation on vectors (its node: the Binary, or the Assign of
// `v op= x`), by vector.vl's functions.
fn gen_vector_assign(cx: sink *FnCtx, s: PStmt, dt: i64) {
    // UNSAFE: NODES is the checker's raw table of nodes.
    // SAFETY: s.e is the vector operation's node (scan_body leaves a body with
    // a vector operation without one to the AST walk).
    unsafe {
        let n = s.e;
        if NODES[n].kind == NodeKind::Assign {
            gen_op(cx, s.ops, 1);
            let b = vector_value_to_slot(cx, dt);
            let addr = alloc_slot(8, 8);
            gen_place_addr(cx, s.a, s.b);
            store_reg_to_frame(cx, R_ACC, addr);
            vector_assign_lanes(cx, token_of(s.d), dt, b, addr);
            return;
        }
        bind(NODES[n].b, s.ops, 0);
        bind(NODES[n].c, s.ops, 1);
        gen_vector_binary(cx, NODES[n].op, NODES[n].b, NODES[n].c, dt);
        unbind();
        write_place(cx, s.a, s.b);
    }
}

// Accumulator = the discriminant of place ops[0], an enum: a scalar
// enum's value, the null niche's test, else the tag in memory.
fn gen_discriminant(cx: sink *FnCtx, ops: i64) {
    // UNSAFE: the checker's TYPES, ENUMS and VARIANTS are raw tables.
    // SAFETY: t is the checked enum type of operand 0, so TYPES[t].a is an ENUMS
    // index; v stays below VARIANT_COUNT.
    unsafe {
        let t = op_type(ops, 0);
        let e = TYPES[t].a;
        let tag = ENUMS[e].tag;
        if !is_compound(t) {
            gen_place_value(cx, op_a(ops, 0), op_b(ops, 0));
            return;
        }
        gen_op(cx, ops, 0);
        if !enum_niche(e) {
            emit_load(cx, tag, R_ACC);
            return;
        }
        // (the variant with the pointer when it is not null)
        var some = 0;
        var none = 0;
        for v in 0..crate::front::types::VARIANT_COUNT {
            if VARIANTS[v].enum_id == e {
                if VARIANTS[v].field_count == 1 {
                    some = wrap_int(VARIANTS[v].discr, tag);
                } else {
                    none = wrap_int(VARIANTS[v].discr, tag);
                }
            }
        }
        emit_load(cx, TY_U64, R_ACC);
        emit_load_imm(cx, R_SECOND, 0);
        emit_compare(cx, Cond::Ne, TY_U64);
        if some == 1 && none == 0 {
            return;
        }
        emit_load_imm(cx, R_SECOND, (some - none) as u64);
        emit_int_binary(cx, Tok::Star, tag);
        emit_add_imm(cx, R_ACC, none);
        emit_normalize(cx, tag);
    }
}

// An aggregate into its place: built there when it is in a frame slot
// and no operand reads its local, else in a new slot then copied.
fn gen_aggregate(cx: sink *FnCtx, s: PStmt, dt: i64) {
    // UNSAFE: the checker's TYPES, ENUMS and VARIANTS are raw tables,
    // struct_field returns a raw pointer into the checker's field table.
    // SAFETY: dt is the place's checked type (an enum's for a variant, so
    // TYPES[dt].a is an ENUMS index); s.e is the builder's variant of that enum;
    // i is below the struct's field count (the builder makes one operand a field).
    unsafe {
        let ak = s.d;
        if ak == AK_VARIANT && !is_compound(dt) {
            let v = s.e;
            emit_load_imm(cx, R_ACC, wrap_int(VARIANTS[v].discr, ENUMS[TYPES[dt].a].tag) as u64);
            write_place(cx, s.a, s.b);
            return;
        }
        var in_place = in_frame(s.a, s.b);
        for i in 0..s.nops {
            let k = op_kind(s.ops, i);
            if (k == OK_COPY || k == OK_MOVE || k == OK_PLACE) && op_a(s.ops, i) == s.a {
                in_place = false;
            }
        }
        let base = if in_place { SLOT[s.a] - chain_offset(s.a, s.b) } else { alloc_slot_for(dt) };
        if ak == AK_VARIANT {
            let v = s.e;
            let tag = ENUMS[TYPES[dt].a].tag;
            if enum_niche(TYPES[dt].a) {
                if s.nops == 1 {
                    gen_op(cx, s.ops, 0);
                } else {
                    emit_load_imm(cx, R_ACC, 0);
                }
                store_to_frame(cx, TY_U64, base);
            } else {
                for i in 0..s.nops {
                    gen_op(cx, s.ops, i);
                    store_to_frame(cx, erase_type(variant_field(v, i)),
                        base - variant_field_offset(v, i));
                }
                emit_load_imm(cx, R_ACC, wrap_int(VARIANTS[v].discr, tag) as u64);
                store_to_frame(cx, tag, base);
            }
        } else {
            for i in 0..s.nops {
                var offset = 0;
                var elem_ty = 0;
                if ak == AK_STRUCT || ak == AK_CLOSURE {
                    let st = TYPES[dt].a;
                    offset = field_offset(st, i);
                    elem_ty = erase_type((*crate::front::types::struct_field(st, i)).ty);
                } else if ak == AK_TUPLE {
                    offset = tuple_offset(dt, i);
                    elem_ty = erase_type(type_elem(dt, i));
                } else {
                    elem_ty = erase_type(TYPES[dt].a);
                    offset = i * type_size(elem_ty);
                }
                // (a union literal's fields not written: `const ()`)
                if op_kind(s.ops, i) == OK_UNIT {
                    continue;
                }
                gen_op(cx, s.ops, i);
                store_to_frame(cx, elem_ty, base - offset);
            }
        }
        if !in_place {
            emit_frame_addr(cx, R_ACC, base);
            write_place(cx, s.a, s.b);
        }
    }
}

// Accumulator = `base[lo..hi]` (node s.d), as expr.vl's gen_slicing: the
// base (a pointer's value, a slice's or an array's address), the bounds
// (absent: OK_UNIT), then gen_slice_tail.
fn gen_slice(cx: sink *FnCtx, s: PStmt) {
    // UNSAFE: TYPES is the checker's raw table of types.
    // SAFETY: bt is operand 0's checked type.
    unsafe {
        let bt = op_type(s.ops, 0);
        let slot = alloc_slot(16, 8);
        let length = alloc_slot(8, 8);
        let low_slot = alloc_slot(8, 8);
        let high_slot = alloc_slot(8, 8);
        if TYPES[bt].kind == TyKind::Ptr {
            gen_place_value(cx, op_a(s.ops, 0), op_b(s.ops, 0));
        } else {
            gen_op(cx, s.ops, 0);
        }
        store_reg_to_frame(cx, R_ACC, slot);
        var bound_ty = TY_U64;
        if op_kind(s.ops, 1) != OK_UNIT {
            gen_op(cx, s.ops, 1);
            bound_ty = op_type(s.ops, 1);
        } else {
            emit_load_imm(cx, R_ACC, 0);
        }
        store_reg_to_frame(cx, R_ACC, low_slot);
        let has_high = op_kind(s.ops, 2) != OK_UNIT;
        if has_high {
            gen_op(cx, s.ops, 2);
            bound_ty = op_type(s.ops, 2);
            store_reg_to_frame(cx, R_ACC, high_slot);
        }
        gen_slice_tail(cx, s.d, bt, false, has_high, bound_ty, slot, length, low_slot, high_slot);
    }
}

// ---- Calls and intrinsics ----

// A call: by call.vl's gen_call of its node with the operands bound (its
// intrinsics, contracts and convention), or, for one the builder made,
// the call sequence itself.
fn gen_call_stmt(cx: sink *FnCtx, s: PStmt) {
    // UNSAFE: NODES, FNS and TYPES are the checker's raw tables; arg_types is a
    // local array passed by its address.
    // SAFETY: n is the statement's node (0: none), f a FNS index when >= 0, the
    // callee's type a checked fn type otherwise; arg_types has 64 entries and
    // count is checked against it.
    unsafe {
        let n = s.node;
        let f = s.c;
        let skip = if f < 0 { 1 } else { 0 };
        // (a compound result made in its destination's slot: into_dest)
        let into = into_dest(s);
        if bound_call(s) {
            if f < 0 {
                bind(NODES[n].a, s.ops, 0);
            }
            for i in 0..NODES[n].count {
                bind(child(n, i), s.ops, i + skip);
            }
            if into != 0 {
                crate::gen0::gen::call::RESULT_INTO = into;
            }
            gen_call(cx, n);
            crate::gen0::gen::call::RESULT_INTO = 0;
            unbind();
            if into == 0 {
                write_place(cx, s.a, s.b);
            }
            return;
        }
        var param_count = 0;
        var ret = 0;
        var variadic = false;
        var callee_ty = 0;
        if f >= 0 {
            param_count = FNS[f].param_count;
            ret = FNS[f].ret;
            variadic = FNS[f].variadic;
        } else {
            callee_ty = op_type(s.ops, 0);
            param_count = TYPES[callee_ty].count;
            ret = TYPES[callee_ty].a;
        }
        let count = s.nops - skip;
        if count > 64 {
            crate::base::die(c"places: a call with more than 64 arguments");
        }
        var arg_types: [i64; 64] = [0; 64];
        var pushed = 0;
        for i in 0..count {
            var ty = op_type(s.ops, i + skip);
            if i < param_count {
                ty = if f >= 0 { fn_param(f, i) } else { type_elem(callee_ty, i) };
            }
            gen_op(cx, s.ops, i + skip);
            if gen_pass_arg(cx, ty, op_fresh(s.ops, i + skip)) {
                arg_types[i] = ty;
                pushed += 1;
            }
        }
        if f < 0 {
            gen_op(cx, s.ops, 0);
            push_x0(cx);
            pushed += 1;
        }
        if n > 0 && NODES[n].kind == NodeKind::Call {
            site_before_call(cx, n);
        }
        crate::gen0::gen::call::RESULT_INTO = into;
        gen_call_sequence(cx, f, &arg_types as *i64, count, param_count, variadic, pushed, ret);
        if into == 0 {
            write_place(cx, s.a, s.b);
        }
    }
}

// The frame slot call s makes its compound result in, its destination's
// (0: a new one, then copied): a whole local in the frame that nothing
// borrows (the callee cannot see it before it returns) and no operand of
// the call names; a plain call (plain_call: its convention's, no
// intrinsic's).
fn into_dest(s: PStmt) -> i64 {
    let l = s.a;
    if s.b != 0 || s.c < 0 || SLOT[l] <= 0 || has_flag(l, LF_STATIC) || ACC_ONLY[l]
        || has_flag(l, crate::places::ir::LF_BORROWED) || !is_compound(local_type(l))
        || l <= crate::places::ir::B_PARAMS || bound_call(s) && !plain_call(s) {
        return 0;
    }
    for i in 0..s.nops {
        let k = op_kind(s.ops, i);
        if (k == OK_COPY || k == OK_MOVE || k == OK_PLACE) && op_a(s.ops, i) == l {
            return 0;
        }
    }
    SLOT[l]
}

// Whether call s, of function s.c through gen_call, is an ordinary one: no
// contract check, no std::arch intrinsic (whose own forms neither read
// their arguments first nor make a result by the call sequence).
fn plain_call(s: PStmt) -> bool {
    s.c >= 0 && s.c != crate::front::contracts::checks::CHECK_FN
        && crate::arch::intrinsic_of_fn(s.c) < 0
}

// Whether call s is generated by gen_call of its node, its operands bound.
fn bound_call(s: PStmt) -> bool {
    let n = s.node;
    let skip = if s.c < 0 { 1 } else { 0 };
    n > 0 && NODES[n].kind == NodeKind::Call && NODES[n].x - 1 == s.c
        && NODES[n].count + skip == s.nops
}

fn gen_intrinsic_stmt(cx: sink *FnCtx, s: PStmt) {
    // UNSAFE: NODES is the checker's raw table of nodes.
    // SAFETY: s.d is the intrinsic's node (the EnumPanic, the contract check's
    // or the vector or std::arch call), below NODE_COUNT.
    unsafe {
        let n = s.d;
        if s.c == IK_PANIC {
            gen_op(cx, s.ops, 0);
            gen_cast(cx, op_type(s.ops, 0), TY_I64);
            emit_panic(cx, NODES[n].x, site_of(n, 0));
            return;
        }
        if s.c == IK_CONTRACT {
            // An assert's condition (which may change state) is the IR's,
            // evaluated once; a requires', ensures' or invariant's (pure) is
            // generated again from the AST (its locals are the IR's slots).
            let check = NODES[child(n, 2)].a;
            if crate::front::contracts::checks::CHECK_KIND.get(check)
                == crate::front::contracts::checks::CHK_ASSERT {
                gen_op(cx, s.ops, 0);
                gen_contract_check_of(cx, n);
            } else {
                gen_call(cx, n);
            }
            return;
        }
        if s.c == IK_VECTOR {
            var j = 0;
            if NODES[n].a != 0 {
                bind(NODES[n].a, s.ops, 0);
                j = 1;
            }
            for i in 0..NODES[n].count {
                bind(child(n, i), s.ops, i + j);
            }
            gen_vecop(cx, n);
        } else if s.c == IK_ARCH {
            for i in 0..NODES[n].count {
                bind(child(n, i), s.ops, i);
            }
            gen_call(cx, n);
        } else {
            return;
        }
        unbind();
        write_place(cx, s.a, s.b);
    }
}

// ---- Terminators ----

fn gen_term(cx: sink *FnCtx, at: i64) {
    let s = P_STMTS[at];
    let k = s.kind;
    if k == TK_GOTO && !RET_BLOCK[s.a] {
        jump_to(cx, s.a);
    } else if k == TK_SWITCH {
        gen_switch(cx, s);
    } else if k == TK_RETURN || k == TK_GOTO {
        // (a return, or a jump to a block with nothing but one: the return
        // itself)
        // UNSAFE: FNS is the checker's raw table of functions.
        // SAFETY: CUR_FN is the function being generated.
        let ret = unsafe { FNS[CUR_FN].ret };
        if !is_void(ret) && ret != TY_NEVER {
            gen_place_value(cx, 0, 0);
            gen_return_value(cx, ret);
        }
        if NEXT >= 0 {
            emit_jump(cx, RETURN_LABEL);
        }
    }
}

// `switch op [v: b, .., otherwise: c]`: a bool's a branch, else a compare
// and jump per value.
fn gen_switch(cx: sink *FnCtx, s: PStmt) {
    let ty = op_type(s.ops, 0);
    gen_op(cx, s.ops, 0);
    if s.b == 1 && P_TARGETS[s.a] == 0 && ty == TY_BOOL {
        let when_false = FWD[P_TARGETS[s.a + 1]];
        let otherwise = FWD[s.c];
        if when_false != otherwise {
            if when_false == NEXT {
                crate::gen0::target::emit_jump_if_nonzero(cx, LABEL[otherwise]);
                return;
            }
            emit_jump_if_zero(cx, LABEL[when_false]);
        }
        jump_to(cx, otherwise);
        return;
    }
    for i in 0..s.b {
        emit_load_imm(cx, R_SECOND, wrap_int(P_TARGETS[s.a + 2 * i], ty) as u64);
        emit_compare_jump(cx, Cond::Eq, false, LABEL[FWD[P_TARGETS[s.a + 2 * i + 1]]]);
    }
    jump_to(cx, s.c);
}
