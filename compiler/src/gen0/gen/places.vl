// -O0 from the places IR (0.26.1, docs/design/places-ir.md §8 step 5):
// a function's kept body (places/keep.vl) generated by gen0, in place of
// the AST walk of mod.vl (0.26.2: whose function walk is gone).
//
// Every local is a frame slot (a parameter's: the one gen_params gives
// its AST local; a static: its address, made at each use); the AST's
// locals are given their IR locals' slots, so that what is generated
// again from the AST (a contract check's conditions and shown operands)
// reads the same memory. The blocks are emitted in reverse postorder, a
// label each (an empty block that jumps on is its target's). A place
// becomes its address in the accumulator (a frame offset when it is a
// local's part at a constant offset); an operand its value (a compound
// one's address). Calls, intrinsics and vector operations go through
// the AST walk's functions with their operands bound (G_BOUND: gen_expr
// of a bound node generates the IR's operand instead), or for one the
// builder made, the call sequence itself. Which bodies are generated
// here is middle/lower/places.vl's take_body (the same as at -O1 and
// -O2); the others, and an atomic intrinsic's, by mod.vl's gen_function.

use crate::back::abi::returns_through_pointer;
use crate::back::dwarf::{dbg_function_begin, dbg_function_end};
use crate::base::{buf_append, buf_clear};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, child};
use crate::front::consteval::{const_value, f64_of_bits, float_const, wrap_int};
use crate::front::contracts::sites::site_of;
use crate::front::distinct::{enum_niche, erase_type};
use crate::front::lexer::Tok;
use crate::front::types::{
    TY_BOOL, TY_I64, TY_NEVER, TY_U64, TyKind, field_offset, fn_param, int_bits, is_compound,
    is_float, is_integer, is_signed, is_slice, is_vector, is_void, struct_field, tuple_offset,
    type_elem, type_size, variant_field, variant_field_offset,
};
use crate::gen0::gen::{
    alloc_slot, alloc_slot_for, fn_is_global, fn_symbol_prefix, gen_main_arch_init, gen_params,
    gen_return_value, load_from_x0, pop_second_operand, stmt_loc, store_reg_to_frame,
    store_to_frame,
};
use crate::gen0::gen::call::{gen_call, gen_call_sequence, gen_pass_arg};
use crate::gen0::gen::checkalloc::site_before_call;
use crate::gen0::gen::expr::{
    emit_static_addr, gen_cast, gen_expr, gen_fn_address, gen_operator, gen_repeat_fill,
    gen_slice_tail, gen_string_id, gen_unop, panic_kind,
};
use crate::gen0::gen::vector::{
    gen_vecop, gen_vector_binary, gen_vector_negate, vector_assign_lanes, vector_value_to_slot,
};
use crate::gen0::target::{
    R_ACC, R_ADDR, R_RESULT, R_SECOND, arith_panic_kind, emit_add_imm, emit_check_imm,
    emit_checked_binary, emit_compare, emit_compare_jump, emit_copy, emit_epilogue, emit_frame_addr,
    emit_frame_reserve, emit_function_start, emit_index_addr, emit_int_binary, emit_jump,
    emit_jump_if_zero, emit_label, emit_load, emit_load_float, emit_load_imm, emit_load_reg,
    emit_min_check, emit_move_to_second, emit_normalize, emit_panic, emit_panic_site_popped,
    emit_store, emit_string_addr, message_kind, new_label, pop_d, pop_x, push_value, push_x0,
};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Cond;
use crate::middle::lower::atomic::atomic_intrinsic;
use crate::middle::lower::places::{
    is_forward, local_type, op_fresh, op_type, place_ty, take_body, token_of,
};
use crate::places::ir::{
    AK_CLOSURE, AK_STRUCT, AK_TUPLE, AK_VARIANT, BO_ADD, BO_AND, BO_DIV, BO_EQ, BO_GE, BO_GT, BO_LE,
    BO_LT, BO_MUL, BO_NE, BO_OR, BO_REM, BO_SHL, BO_SHR, BO_XOR, Body, DS_FLAG, DS_KEPT, IK_ARCH,
    IK_CONTRACT, IK_PANIC, IK_VECTOR, LF_STATIC, OK_CONST, OK_COPY, OK_CSTR, OK_FLOAT, OK_FN,
    OK_INT, OK_MOVE, OK_PLACE, OK_STR, OK_UNIT, PJ_CONST, PJ_DEREF, PJ_FIELD, PJ_INDEX, PJ_UNION,
    PJ_VARIANT, PStmt, RV_AGG, RV_BINARY, RV_CAST, RV_CHECKED, RV_DISCR, RV_LEN, RV_REF, RV_REPEAT,
    RV_SLICE, RV_UNARY, RV_USE, SK_ASSERT, SK_ASSIGN, SK_CALL, SK_DROP, SK_INTRINSIC, TK_GOTO,
    TK_RETURN, TK_SWITCH, UO_NEG, UO_NOT, block_count, block_len, block_start, block_term,
    full_place_type, has_flag, local_count, op_a, op_b, op_kind, proj_kind, proj_parent, proj_val,
};
use crate::places::keep::free_body;
use crate::places::shim::drop_shim_fn;

// Function f (its Fn node: item) generated from its kept body: false
// when it has none (or one take_body leaves to the AST walk), or is an
// atomic intrinsic.
pub fn gen_places_function(cx: &mut FnCtx<Comp>, item: i64, f: i64, pbody: &mut Body<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    if atomic_intrinsic(f, pcx) >= 0 {
        return false;
    }
    if !take_body(f, true, pbody, pcx) {
        return false;
    }
    gen_body(cx, item, f, pbody, pcx);
    free_body(f, pcx);
    true
}

// Generates the operand node n is bound to; false when it is not bound.
pub fn gen_bound(cx: &mut FnCtx<Comp>, n: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let mut k: i64 = 0;
    while k < pcx.g_bound.len() as i64 {
        if pcx.g_bound[k as usize] == n {
            gen_op(cx, pcx.g_bound[(k + 1) as usize], pcx.g_bound[(k + 2) as usize], pbody, pcx);
            return true;
        }
        k += 3;
    }
    false
}

// Binds AST node e to operand i at `ops`: a place's value or address, a
// constant, or a unit (nothing: its expression, a call, ran in the
// statement before; generating it again would run it twice). A check's
// site is left to the AST's constant (gen_expr).
fn bind(e: i64, ops: i64, i: i64, pcx: &mut Ctx<Comp>) {
    if crate::middle::lower::places::is_site(e, pcx) {
        return;
    }
    pcx.g_bound.push(e);
    pcx.g_bound.push(ops);
    pcx.g_bound.push(i);
}

fn unbind(pcx: &mut Ctx<Comp>) {
    pcx.g_bound.clear();
}

// ---- The function ----

// As mod.vl's gen_function: the prologue, the parameters, the blocks,
// the epilogue.
fn gen_body(cx: &mut FnCtx<Comp>, item: i64, f: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    pcx.gen_cur_fn = f;
    buf_clear(cx.code);
    pcx.depth = 0;
    pcx.frame_size = 0;
    pcx.overaligned.clear();
    pcx.return_label = new_label(cx);
    pcx.stmt_pos = -1;
    dbg_function_begin(cx, f, fn_symbol_prefix(f, pcx), pcx.nodes[item as usize].start, pcx);
    emit_function_start(cx, fn_symbol_prefix(f, pcx), pcx.fns[f as usize].name,
        fn_is_global(f, pcx), pcx);
    let ret = pcx.fns[f as usize].ret;
    pcx.result_slot = 0;
    if returns_through_pointer(cx, ret, pcx) {
        pcx.result_slot = alloc_slot(8, 8, pcx);
        emit_frame_addr(cx, R_ADDR, pcx.result_slot, pcx);
        emit_store(cx, TY_U64, R_RESULT, R_ADDR, pcx);
    }
    let n = local_count(pbody);
    pcx.slot.clear();
    for _ in 0..n {
        pcx.slot.push(-1);
    }
    // (the parameters' slots: gen_params' param_slot)
    gen_params(cx, item, f, pcx);
    gen_main_arch_init(cx, f, pcx);
    forward_blocks(pbody, pcx);
    scan_locals(pbody, pcx);
    for l in 0..n {
        let ty = local_type(l, pcx);
        if has_flag(l, LF_STATIC, pbody) || is_void(ty) || ty == TY_NEVER
            || pcx.acc_only[l as usize] {
            continue;
        }
        if pcx.slot[l as usize] < 0 && !shares_slot(l, pbody, pcx)
            && (pcx.mentions[l as usize] > 0 || pbody.locals[l as usize].src >= 0) {
            pcx.slot[l as usize] = alloc_slot_for(ty, pcx);
        }
        let ast = pbody.locals[l as usize].src;
        if ast >= 0 && ast < pcx.locals.len() as i64 {
            pcx.locals[ast as usize].offset = pcx.slot[l as usize];
        }
    }
    share_slots(pbody, pcx);
    gen_blocks(cx, pbody, pcx);
    emit_label(cx, pcx.return_label);
    if is_void(ret) && pcx.fns[f as usize].name == pcx.main_sym {
        // `main` without a result exits with 0.
        emit_load_imm(cx, R_ACC, 0);
    }
    emit_epilogue(cx);
    emit_frame_reserve(cx, pcx.frame_size);
    buf_append(cx.asm, cx.code);
    dbg_function_end(cx, pcx);
}

// The blocks in reverse postorder, each its label, its statements and
// its terminator.
fn gen_blocks(cx: &mut FnCtx<Comp>, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    pcx.label.clear();
    for _ in 0..block_count(pbody) {
        pcx.label.push(0);
    }
    for i in 0..pbody.rpo.len() {
        let b = pbody.rpo[i];
        if pcx.gen0_fwd[b as usize] == b {
            pcx.label[b as usize] = new_label(cx);
        }
    }
    // (the emitted blocks, in order: not a block only an inlined return
    // reached)
    let first = pcx.gen0_fwd[pbody.rpo[0] as usize];
    pcx.order.clear();
    for i in 0..pbody.rpo.len() {
        let b = pbody.rpo[i];
        if pcx.gen0_fwd[b as usize] == b && (pcx.p_head[b as usize] >= 0 || b == first) {
            pcx.order.push(b);
        }
    }
    if pcx.order.len() == 0 || pcx.order[0] != first {
        emit_jump(cx, pcx.label[first as usize]);
    }
    for i in 0..pcx.order.len() as i64 {
        let b = pcx.order[i as usize];
        pcx.next = if i + 1 < pcx.order.len() as i64 { pcx.order[(i + 1) as usize] } else { -1 };
        if jumped_to(b, if i > 0 { pcx.order[(i - 1) as usize] } else { -1 }, pbody, pcx) {
            emit_label(cx, pcx.label[b as usize]);
        }
        let start = block_start(b, pbody);
        let len = block_len(b, pbody);
        for j in 0..len {
            gen_stmt(cx, start + j, pbody, pcx);
        }
        gen_term(cx, block_term(b, pbody), pbody, pcx);
    }
    pcx.next = -1;
}

// Each block's forward (FWD: itself, or for an empty block that jumps on,
// where it leads), whether it has nothing but a return (RET_BLOCK), each
// emitted block's predecessors (a jump to a block with nothing but a
// return is the return itself: no edge), and the local the accumulator
// holds at each block's start (START_HOLD).
fn forward_blocks(pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let nb = block_count(pbody);
    pcx.gen0_fwd.clear();
    pcx.p_head.clear();
    pcx.p_next.clear();
    pcx.p_from.clear();
    pcx.places_ret_block.clear();
    pcx.start_hold.clear();
    for b in 0..nb {
        pcx.gen0_fwd.push(b);
        pcx.p_head.push(-1);
        pcx.places_ret_block.push(false);
        pcx.start_hold.push(-1);
    }
    for i in 0..pbody.rpo.len() {
        let b = pbody.rpo[i];
        pcx.places_ret_block[b as usize] = return_block(b, pbody);
        let mut t = b;
        let mut steps: i64 = 0;
        while steps < 64 && is_forward(t, pbody) {
            t = pbody.stmts[block_term(t, pbody) as usize].a;
            steps += 1;
        }
        if steps < 64 {
            pcx.gen0_fwd[b as usize] = t;
        }
    }
    for i in 0..pbody.rpo.len() {
        let b = pbody.rpo[i];
        if pcx.gen0_fwd[b as usize] != b {
            continue;
        }
        let t = pbody.stmts[block_term(b, pbody) as usize];
        if t.kind == TK_GOTO && pcx.places_ret_block[t.a as usize] {
            continue;
        }
        let holds = end_hold(b, pbody, pcx);
        for k in 0..crate::places::ir::succ_count(b, pbody) {
            let to = pcx.gen0_fwd[crate::places::ir::succ(b, k, pbody) as usize];
            // (its first predecessor's, then -1 when another's differs)
            if pcx.p_head[to as usize] < 0 {
                pcx.start_hold[to as usize] = holds;
            } else if pcx.start_hold[to as usize] != holds {
                pcx.start_hold[to as usize] = -1;
            }
            pcx.p_from.push(b);
            pcx.p_next.push(pcx.p_head[to as usize]);
            pcx.p_head[to as usize] = pcx.p_from.len() as i64 - 1;
        }
    }
    { let at_ix = pcx.gen0_fwd[pbody.rpo[0] as usize] as usize; pcx.start_hold[at_ix] = -1 };
}

// The local the accumulator holds at the end of block b (-1: none): its
// switch's operand, or what its last statement before a jump wrote.
fn end_hold(b: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let t = pbody.stmts[block_term(b, pbody) as usize];
    if t.kind == TK_SWITCH {
        let k = op_kind(t.ops, 0, pbody);
        if (k == OK_COPY || k == OK_MOVE) && op_b(t.ops, 0, pbody) == 0 {
            return op_a(t.ops, 0, pbody);
        }
        return -1;
    }
    if t.kind != TK_GOTO {
        return -1;
    }
    let mut j = block_term(b, pbody) - 1;
    while j >= block_start(b, pbody) {
        if does_something(j, pbody) {
            let s = pbody.stmts[j as usize];
            return if writes_held(s, s.a, pbody, pcx) { s.a } else { -1 };
        }
        j -= 1;
    }
    -1
}

// The one pass over the body's statements before it is generated:
//
// - each local's mentions (MENTIONS; M_FIRST, M_LAST, M_BLOCK, M_WRITTEN,
//   M_ORDER for share_slots): as a statement's place, an operand, an
//   index or a drop's flag;
// - the locals the accumulator carries (ACC_ONLY): a scalar statement
//   temporary (or the result _0, a compound one's address) whose every
//   read is what its statement generates first and finds in the
//   accumulator: written by the statement before it in its block, or,
//   at a block's start, at the end of every predecessor (START_HOLD).
//   Neither store nor load: the AST walk's value in the accumulator
//   across `&&`, `||` and an `if`'s arms.
fn scan_locals(pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let n = local_count(pbody);
    pcx.mentions.clear();
    pcx.m_first.clear();
    pcx.m_last.clear();
    pcx.m_block.clear();
    pcx.m_written.clear();
    pcx.m_order.clear();
    pcx.acc_only.clear();
    for l in 0..n {
        pcx.mentions.push(0);
        pcx.m_first.push(0);
        pcx.m_last.push(0);
        pcx.m_block.push(-1);
        pcx.m_written.push(false);
        let ty = local_type(l, pcx);
        pcx.acc_only.push((l == 0 || l > pbody.params && pbody.locals[l as usize].src < 0
            && !is_compound(ty, pcx)) && !has_flag(l, LF_STATIC, pbody) && !is_void(ty)
            && ty != TY_NEVER
            && !has_flag(l, crate::places::ir::LF_BORROWED, pbody));
    }
    let first = pcx.gen0_fwd[pbody.rpo[0] as usize];
    for i in 0..pbody.rpo.len() {
        let b = pbody.rpo[i];
        // (an emitted block: not one only an inlined return reached)
        let emitted = pcx.gen0_fwd[b as usize] == b && (pcx.p_head[b as usize] >= 0 || b == first);
        let start = block_start(b, pbody);
        // (the local the accumulator holds before the statement)
        let mut held = pcx.start_hold[b as usize];
        for j in 0..block_len(b, pbody) + 1 {
            let at = start + j;
            let s = pbody.stmts[at as usize];
            let k = s.kind;
            if k == crate::places::ir::SK_LIVE || k == crate::places::ir::SK_DEAD
                || k == crate::places::ir::SK_NOP {
                continue;
            }
            // (the operands read first, then the place written)
            for o in 0..s.nops {
                let ok = op_kind(s.ops, o, pbody);
                if ok != OK_COPY && ok != OK_MOVE && ok != OK_PLACE {
                    continue;
                }
                let l = op_a(s.ops, o, pbody);
                let p = op_b(s.ops, o, pbody);
                mention_place(l, p, at, b, ok == OK_PLACE, pbody, pcx);
                if pcx.acc_only[l as usize] && !(emitted && l == held && ok != OK_PLACE && p == 0
                    && (o == 0 && reads_first(at, l, pbody, pcx)
                        || o == 1 && reads_second(at, l, pbody, pcx))) {
                    pcx.acc_only[l as usize] = false;
                }
            }
            // (the result, read by a return)
            if emitted && held != 0 && pcx.acc_only[0]
                && (k == TK_RETURN || k == TK_GOTO && pcx.places_ret_block[s.a as usize]) {
                pcx.acc_only[0] = false;
            }
            let mut writes = false;
            if k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC {
                if s.b == 0 {
                    // (a whole write)
                    let w = pcx.mentions[s.a as usize] == 0;
                    mention(s.a, at, b, false, pcx);
                    if w {
                        pcx.m_written[s.a as usize] = true;
                    }
                    if pcx.acc_only[s.a as usize] {
                        writes = leaves_in_acc(s, pbody, pcx);
                        if emitted && !writes {
                            pcx.acc_only[s.a as usize] = false;
                        }
                    }
                } else {
                    mention_place(s.a, s.b, at, b, false, pbody, pcx);
                    pcx.acc_only[s.a as usize] = false;
                }
            } else if k == SK_DROP || k == crate::places::ir::SK_MENTION {
                mention_place(s.a, s.b, at, b, true, pbody, pcx);
                pcx.acc_only[s.a as usize] = false;
                if k == SK_DROP && s.c == DS_FLAG {
                    mention(s.d, at, b, false, pcx);
                    pcx.acc_only[s.d as usize] = false;
                }
            }
            if k != crate::places::ir::SK_MENTION {
                held = if writes { s.a } else { -1 };
            }
        }
    }
}

// Local l mentioned by statement `at` of block b (`placed`: its address
// taken, or a part of it).
fn mention(l: i64, at: i64, b: i64, placed: bool, pcx: &mut Ctx<Comp>) {
    if pcx.mentions[l as usize] == 0 {
        pcx.m_first[l as usize] = at;
        pcx.m_block[l as usize] = b;
        pcx.m_order.push(l);
    } else if pcx.m_block[l as usize] != b {
        pcx.m_block[l as usize] = -2;
    }
    pcx.m_last[l as usize] = at;
    pcx.mentions[l as usize] += 1;
    if placed {
        // (its storage named: not shared)
        pcx.m_block[l as usize] = -2;
    }
}

// Place (l, p) mentioned (its index locals too, which are not carried).
fn mention_place(l: i64, p: i64, at: i64, b: i64, placed: bool, pbody: &Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    if p == 0 {
        mention(l, at, b, placed, pcx);
        return;
    }
    mention(l, at, b, placed || !const_chain(p, pbody), pcx);
    let mut q = p;
    while q > 0 {
        if proj_kind(q, pbody) == PJ_INDEX {
            let v = proj_val(q, pbody);
            mention(v, at, b, false, pcx);
            pcx.acc_only[v as usize] = false;
        }
        q = proj_parent(q, pbody);
    }
}

// Whether statement s, writing its local whole, leaves the value in the
// accumulator (its generation ends with write_place).
fn leaves_in_acc(s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    if s.kind != SK_ASSIGN {
        return s.kind == SK_CALL || s.c == IK_ARCH || s.c == IK_VECTOR;
    }
    let dt = place_ty(s.a, 0, pbody, pcx);
    if s.c == RV_AGG {
        return s.d == AK_VARIANT && !is_compound(dt, pcx);
    }
    !(s.c == RV_BINARY && is_vector(dt, pcx))
}

// Whether statement s writes local l whole and leaves it in the
// accumulator.
fn writes_held(s: PStmt, l: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    (s.kind == SK_ASSIGN || s.kind == SK_CALL || s.kind == SK_INTRINSIC) && s.a == l && s.b == 0
        && leaves_in_acc(s, pbody, pcx)
}

// Whether local l is a statement temporary that may share its slot with
// another: not the AST's, not a parameter or the result, mentioned in
// one block only, written whole first, its storage not named (no
// address taken of it: a reference, a slice of it, a drop).
fn shares_slot(l: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> bool {
    l > pbody.params && pbody.locals[l as usize].src < 0 && pcx.m_block[l as usize] >= 0
        && pcx.m_written[l as usize] && !has_flag(l, crate::places::ir::LF_BORROWED, pbody)
        && !pcx.acc_only[l as usize]
}

// The slots of the statement temporaries (shares_slot), each one's
// reused by a later one of the same size and alignment once the earlier
// is last mentioned (a linear scan per block: a temporary is dead past
// its block). Shared slots keep the frame small, its offsets in reach of
// one instruction.

fn share_slots(pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    pcx.pool_slot.clear();
    pcx.pool_size.clear();
    pcx.pool_align.clear();
    pcx.pool_last.clear();
    let mut block: i64 = -1;
    for i in 0..pcx.m_order.len() {
        let l = pcx.m_order[i];
        if pcx.slot[l as usize] >= 0 || !shares_slot(l, pbody, pcx) {
            continue;
        }
        let ty = local_type(l, pcx);
        if has_flag(l, LF_STATIC, pbody) || is_void(ty) || ty == TY_NEVER {
            continue;
        }
        if pcx.m_block[l as usize] != block {
            block = pcx.m_block[l as usize];
            for k in 0..pcx.pool_last.len() {
                pcx.pool_last[k] = -1;
            }
        }
        let size = if is_compound(ty, pcx) { crate::front::types::align_to(type_size(ty, pcx), 8) }
            else { type_size(ty, pcx) };
        let align = crate::front::types::type_align(ty, pcx);
        let mut found: i64 = -1;
        for k in 0..pcx.pool_slot.len() as i64 {
            if pcx.pool_size[k as usize] == size && pcx.pool_align[k as usize] == align
                && pcx.pool_last[k as usize] < pcx.m_first[l as usize] {
                found = k;
                break;
            }
        }
        if found >= 0 {
            pcx.slot[l as usize] = pcx.pool_slot[found as usize];
            pcx.pool_last[found as usize] = pcx.m_last[l as usize];
        } else {
            pcx.slot[l as usize] = alloc_slot_for(ty, pcx);
            pcx.pool_slot.push(pcx.slot[l as usize]);
            pcx.pool_size.push(size);
            pcx.pool_align.push(align);
            pcx.pool_last.push(pcx.m_last[l as usize]);
        }
    }
}

// Whether statement (or terminator) `at` does something (not a storage
// marker or a no-op).
fn does_something(at: i64, pbody: &Body<Comp>) -> bool {
    let k = pbody.stmts[at as usize].kind;
    k == SK_ASSIGN || k == SK_CALL || k == SK_INTRINSIC || k == SK_DROP || k == SK_ASSERT
        || k == TK_GOTO || k == TK_SWITCH || k == TK_RETURN
        || k == crate::places::ir::TK_UNREACHABLE
}

// Whether block b has nothing but a return.
fn return_block(b: i64, pbody: &Body<Comp>) -> bool {
    for j in 0..block_len(b, pbody) {
        if does_something(block_start(b, pbody) + j, pbody) {
            return false;
        }
    }
    pbody.stmts[block_term(b, pbody) as usize].kind == TK_RETURN
}

// Whether statement `at` reads local l (whole, its value) before anything
// else: the operand its generation starts with.
fn reads_first(at: i64, l: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let s = pbody.stmts[at as usize];
    let k = s.kind;
    if k == TK_RETURN || k == TK_GOTO && pcx.places_ret_block[s.a as usize] {
        return l == 0;
    }
    if s.nops == 0 || op_b(s.ops, 0, pbody) != 0 || op_a(s.ops, 0, pbody) != l {
        return false;
    }
    let ok = op_kind(s.ops, 0, pbody);
    if ok != OK_COPY && ok != OK_MOVE {
        return false;
    }
    if k == TK_SWITCH || k == SK_ASSERT {
        return true;
    }
    if k == SK_ASSIGN {
        let rv = s.c;
        if rv == RV_USE || rv == RV_CAST {
            return true;
        }
        if rv == RV_BINARY || rv == RV_UNARY || rv == RV_CHECKED {
            return !is_vector(op_type(s.ops, 0, pbody, pcx), pcx);
        }
        return false;
    }
    // (a call of a function: its first argument first)
    if k == SK_CALL && s.c >= 0 {
        return !bound_call(s, pcx) || plain_call(s, pcx);
    }
    false
}

// R_SECOND = operand i at `ops` when that takes no stack and leaves the
// accumulator: an integer constant, or an 8-byte integer (or pointer)
// in the frame; false (nothing emitted) otherwise.
fn gen_second(cx: &mut FnCtx<Comp>, ops: i64, i: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let k = op_kind(ops, i, pbody);
    if k == OK_INT || k == OK_CONST {
        let t = erase_type(op_b(ops, i, pbody), pcx);
        if is_float(t) {
            return false;
        }
        let v = if k == OK_INT { wrap_int(op_a(ops, i, pbody), t) }
            else { const_value(op_a(ops, i, pbody), pcx) };
        emit_load_imm(cx, R_SECOND, v as u64);
        return true;
    }
    if k != OK_COPY && k != OK_MOVE {
        return false;
    }
    let l = op_a(ops, i, pbody);
    let p = op_b(ops, i, pbody);
    let ty = place_ty(l, p, pbody, pcx);
    if p == 0 && pcx.acc_only[l as usize] || !in_frame(l, p, pbody, pcx) || is_float(ty)
        || is_compound(ty, pcx)
        || type_size(ty, pcx) != 8 {
        return false;
    }
    emit_frame_addr(cx, R_SECOND, pcx.slot[l as usize] - chain_offset(l, p, pbody, pcx), pcx);
    emit_load_reg(cx, R_SECOND, R_SECOND);
    true
}

// Whether operand i at `ops` is read into the accumulator without
// R_SECOND (its frame slot, a constant), as an assert's index after its
// length.
fn simple_first(ops: i64, i: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let k = op_kind(ops, i, pbody);
    if k == OK_INT || k == OK_CONST {
        return !is_float(erase_type(op_b(ops, i, pbody), pcx));
    }
    if k != OK_COPY && k != OK_MOVE {
        return false;
    }
    let l = op_a(ops, i, pbody);
    let ty = place_ty(l, op_b(ops, i, pbody), pbody, pcx);
    !has_flag(l, LF_STATIC, pbody) && const_chain(op_b(ops, i, pbody), pbody) && !is_float(ty)
        && !is_compound(ty, pcx)
}

// Whether operand i at `ops` is a local the accumulator carries.
fn is_carried(ops: i64, i: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> bool {
    let k = op_kind(ops, i, pbody);
    (k == OK_COPY || k == OK_MOVE) && op_b(ops, i, pbody) == 0
        && pcx.acc_only[op_a(ops, i, pbody) as usize]
}

// Whether operand i at `ops` is local l's whole value.
fn op_is_local(ops: i64, i: i64, l: i64, pbody: &Body<Comp>) -> bool {
    let k = op_kind(ops, i, pbody);
    (k == OK_COPY || k == OK_MOVE) && op_a(ops, i, pbody) == l && op_b(ops, i, pbody) == 0
}

// The operator of binary operation bo with its operands swapped: itself
// when it commutes, the reverse comparison; Tok::Eof when neither.
fn swapped(bo: i64) -> Tok {
    if bo == BO_ADD || bo == BO_MUL || bo == BO_AND || bo == BO_OR || bo == BO_XOR || bo == BO_EQ
        || bo == BO_NE {
        return token_of(bo);
    }
    if bo == BO_LT { Tok::Gt } else if bo == BO_GT { Tok::Lt } else if bo == BO_LE { Tok::GtEq }
    else if bo == BO_GE { Tok::LtEq } else { Tok::Eof }
}

// Whether the first operand of statement `at` reads local l, the second
// local l, and its operator may swap them.
fn reads_second(at: i64, l: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let s = pbody.stmts[at as usize];
    if s.kind == SK_ASSERT {
        // (the length, the index then read without R_SECOND)
        return s.nops == 2 && op_is_local(s.ops, 1, l, pbody) && !op_is_local(s.ops, 0, l, pbody)
            && simple_first(s.ops, 0, pbody, pcx) && !(op_kind(s.ops, 0, pbody) != OK_INT
                && op_kind(s.ops, 0, pbody) != OK_CONST && op_a(s.ops, 0, pbody) == l);
    }
    if s.kind != SK_ASSIGN || s.c != RV_BINARY || s.nops != 2 || !op_is_local(s.ops, 1, l, pbody)
        || op_is_local(s.ops, 0, l, pbody) || is_vector(op_type(s.ops, 0, pbody, pcx), pcx) {
        return false;
    }
    swapped(s.d) != Tok::Eof
}

// Whether a jump lands at block b, emitted after block `prev` (-1: first):
// a predecessor other than prev, or prev's switch (its jumps name their
// targets); the function's jump to its first block.
fn jumped_to(b: i64, prev: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> bool {
    if prev < 0 && b != pcx.gen0_fwd[pbody.rpo[0] as usize]
        || prev >= 0 && b == pcx.gen0_fwd[pbody.rpo[0] as usize] {
        return true;
    }
    let mut e = pcx.p_head[b as usize];
    while e >= 0 {
        let from = pcx.p_from[e as usize];
        if from != prev || pbody.stmts[block_term(from, pbody) as usize].kind != TK_GOTO {
            return true;
        }
        e = pcx.p_next[e as usize];
    }
    false
}

// A jump to block b (forwarded), unless it is the next one emitted.
fn jump_to(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) {
    let t = pcx.gen0_fwd[b as usize];
    if t != pcx.next {
        emit_jump(cx, pcx.label[t as usize]);
    }
}

// ---- Places and operands ----

// Whether projection list p is a local's part at a constant offset (no
// `*`, no index).
fn const_chain(p: i64, pbody: &Body<Comp>) -> bool {
    let mut q = p;
    while q > 0 {
        let k = proj_kind(q, pbody);
        if k == PJ_DEREF || k == PJ_INDEX {
            return false;
        }
        q = proj_parent(q, pbody);
    }
    true
}

// The offset of projection p (a field, a union's field, a constant
// index) in the place of its parent, of local l.
fn proj_offset(l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let parent = proj_parent(p, pbody);
    let k = proj_kind(p, pbody);
    let v = proj_val(p, pbody);
    if k == PJ_VARIANT {
        return 0;
    }
    let pt = place_ty(l, parent, pbody, pcx);
    if k == PJ_CONST {
        return v * type_size(pcx.types[pt as usize].a, pcx);
    }
    if parent > 0 && proj_kind(parent, pbody) == PJ_VARIANT {
        return variant_field_offset(proj_val(parent, pbody), v, pcx);
    }
    let tk = pcx.types[pt as usize].kind;
    if tk == TyKind::Struct {
        return field_offset(pcx.types[pt as usize].a, v, pcx);
    }
    if tk == TyKind::Tuple {
        return tuple_offset(pt, v, pcx);
    }
    // (a slice's pointer and length)
    v * 8
}

// The offset of place (l, p) in l, p a constant chain.
fn chain_offset(l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut off: i64 = 0;
    let mut q = p;
    while q > 0 {
        off += proj_offset(l, q, pbody, pcx);
        q = proj_parent(q, pbody);
    }
    off
}

// Whether place (l, p) is in l's frame slot at a constant offset.
fn in_frame(l: i64, p: i64, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> bool {
    !has_flag(l, LF_STATIC, pbody) && pcx.slot[l as usize] >= 0 && const_chain(p, pbody)
}

// Accumulator = the address of place (l, p).
fn gen_place_addr(cx: &mut FnCtx<Comp>, l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if in_frame(l, p, pbody, pcx) {
        emit_frame_addr(cx, R_ACC, pcx.slot[l as usize] - chain_offset(l, p, pbody, pcx), pcx);
        return;
    }
    if p == 0 && (pbody.locals[l as usize].flags & crate::places::ir::LF_STATIC) == 0 {
        // (a zero-sized local, which has no slot: a borrowed `()` or unit
        // struct receiver; nothing is read or written through it)
        emit_frame_addr(cx, R_ACC, 0, pcx);
        return;
    }
    if p == 0 {
        // (a static's: its symbol)
        emit_static_addr(cx, pbody.locals[l as usize].src, pcx);
        return;
    }
    let parent = proj_parent(p, pbody);
    let k = proj_kind(p, pbody);
    if k == PJ_DEREF {
        gen_place_value(cx, l, parent, pbody, pcx);
        return;
    }
    if k == PJ_VARIANT {
        gen_place_addr(cx, l, parent, pbody, pcx);
        return;
    }
    if k == PJ_FIELD || k == PJ_UNION || k == PJ_CONST {
        gen_place_addr(cx, l, parent, pbody, pcx);
        let off = proj_offset(l, p, pbody, pcx);
        if off != 0 {
            emit_add_imm(cx, R_ACC, off);
        }
        return;
    }
    // PJ_INDEX: element v (a local) of an array, a slice's buffer or a
    // pointer's
    let pt = place_ty(l, parent, pbody, pcx);
    let elem_size = type_size(pcx.types[pt as usize].a, pcx);
    if pcx.types[pt as usize].kind == TyKind::Ptr {
        gen_place_value(cx, l, parent, pbody, pcx);
    } else if is_slice(pt, pcx) {
        gen_place_addr(cx, l, parent, pbody, pcx);
        emit_load_reg(cx, R_ACC, R_ACC);
    } else {
        gen_place_addr(cx, l, parent, pbody, pcx);
    }
    push_x0(cx, pcx);
    gen_place_value(cx, proj_val(p, pbody), 0, pbody, pcx);
    pop_x(cx, R_SECOND, pcx);
    emit_index_addr(cx, elem_size);
}

// Accumulator = the value of place (l, p) (a compound one's address).
fn gen_place_value(cx: &mut FnCtx<Comp>, l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if p == 0 && pcx.acc_only[l as usize] {
        return;
    }
    let ty = place_ty(l, p, pbody, pcx);
    if is_void(ty) || ty == TY_NEVER {
        return;
    }
    gen_place_addr(cx, l, p, pbody, pcx);
    load_from_x0(cx, ty, pcx);
}

// Place (l, p) = the accumulator's value, of the place's type (a compound
// one's address, copied).
fn write_place(cx: &mut FnCtx<Comp>, l: i64, p: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let ty = place_ty(l, p, pbody, pcx);
    if is_void(ty) || ty == TY_NEVER {
        return;
    }
    if p == 0 && pcx.acc_only[l as usize] {
        return;
    }
    if in_frame(l, p, pbody, pcx) {
        store_to_frame(cx, ty, pcx.slot[l as usize] - chain_offset(l, p, pbody, pcx), pcx);
        return;
    }
    // (the value waits on the stack while the address is made, as
    // expr.vl's gen_assign)
    push_value(cx, ty, pcx);
    gen_place_addr(cx, l, p, pbody, pcx);
    emit_move_to_second(cx, TY_U64);
    if is_float(ty) {
        pop_d(cx, 0, pcx);
    } else {
        pop_x(cx, R_ACC, pcx);
    }
    if is_compound(ty, pcx) {
        emit_copy(cx, type_size(ty, pcx));
    } else {
        emit_store(cx, ty, R_ACC, R_SECOND, pcx);
    }
}

// Accumulator = operand i at `ops` (a compound one's address).
fn gen_op(cx: &mut FnCtx<Comp>, ops: i64, i: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let k = op_kind(ops, i, pbody);
    let a = op_a(ops, i, pbody);
    let b = op_b(ops, i, pbody);
    if k == OK_COPY || k == OK_MOVE {
        gen_place_value(cx, a, b, pbody, pcx);
    } else if k == OK_PLACE {
        gen_place_addr(cx, a, b, pbody, pcx);
    } else if k == OK_INT {
        emit_load_imm(cx, R_ACC, wrap_int(a, erase_type(b, pcx)) as u64);
    } else if k == OK_FLOAT {
        let t = erase_type(b, pcx);
        emit_load_float(cx, float_const(f64_of_bits(a), t), t);
    } else if k == OK_STR {
        gen_string_id(cx, a, pcx);
    } else if k == OK_CSTR {
        emit_string_addr(cx, a);
    } else if k == OK_FN {
        gen_fn_address(cx, a, pcx);
    } else if k == OK_CONST {
        let t = erase_type(b, pcx);
        let value = const_value(a, pcx);
        if is_float(t) {
            emit_load_float(cx, value, t);
        } else {
            emit_load_imm(cx, R_ACC, value as u64);
        }
    }
}

// ---- Statements ----

fn gen_stmt(cx: &mut FnCtx<Comp>, at: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let s = pbody.stmts[at as usize];
    let k = s.kind;
    if k != SK_ASSIGN && k != SK_CALL && k != SK_INTRINSIC && k != SK_DROP && k != SK_ASSERT {
        return;
    }
    if pcx.debug_info && s.node > 0 {
        stmt_loc(cx, pcx.nodes[s.node as usize].start, pcx);
    }
    if k == SK_ASSIGN {
        gen_assign(cx, s, pbody, pcx);
    } else if k == SK_CALL {
        gen_call_stmt(cx, s, pbody, pcx);
    } else if k == SK_INTRINSIC {
        gen_intrinsic_stmt(cx, s, pbody, pcx);
    } else if k == SK_DROP {
        gen_drop(cx, s, pbody, pcx);
    } else {
        // AK_BOUNDS: the index, as unsigned, below the length (the
        // helper is given both, as expr.vl's gen_index_addr)
        if is_carried(s.ops, 1, pbody, pcx) {
            // (the length in the accumulator; the index read without
            // R_SECOND: simple_first)
            emit_move_to_second(cx, TY_U64);
            gen_op(cx, s.ops, 0, pbody, pcx);
        } else {
            gen_op(cx, s.ops, 0, pbody, pcx);
            if !gen_second(cx, s.ops, 1, pbody, pcx) {
                push_x0(cx, pcx);
                gen_op(cx, s.ops, 1, pbody, pcx);
                emit_move_to_second(cx, TY_U64);
                pop_x(cx, R_ACC, pcx);
            }
        }
        let ok = new_label(cx);
        emit_compare_jump(cx, Cond::Lt, false, ok);
        let pcx_site1 = site_of(s.d, 0, pcx);
        emit_panic(cx, panic_kind(op_type(s.ops, 0, pbody, pcx), false), pcx,
            pcx_site1);
        emit_label(cx, ok);
    }
}

// `drop(P)` kept: its type's drop shim called with `&mut P`; under a flag
// (DS_FLAG, flag local d): only when the flag is true.
fn gen_drop(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    if s.c != DS_KEPT && s.c != DS_FLAG {
        return;
    }
    let f = drop_shim_fn(full_place_type(s.a, s.b, pbody, pcx), pcx);
    if f < 0 {
        return;
    }
    let mut skip: i64 = 0;
    if s.c == DS_FLAG {
        skip = new_label(cx);
        gen_place_value(cx, s.d, 0, pbody, pcx);
        emit_jump_if_zero(cx, skip);
    }
    if s.node > 0 {
        crate::gen0::gen::checkalloc::site_before_drop(cx,
            crate::places::print::drop_pos(s.node, pcx), pcx);
    }
    gen_place_addr(cx, s.a, s.b, pbody, pcx);
    let mut arg_types: [i64; 1] = [fn_param(f, 0, pcx)];
    gen_pass_arg(cx, arg_types[0], false, pcx);
    gen_call_sequence(cx, f, &mut arg_types[..], 1,
        pcx.fns[f as usize].param_count, false, 1, pcx.fns[f as usize].ret, pcx);
    if skip != 0 {
        emit_label(cx, skip);
    }
}

fn gen_assign(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let rv = s.c;
    let dl = s.a;
    let dp = s.b;
    let dt = place_ty(dl, dp, pbody, pcx);
    if rv == RV_USE || rv == RV_REF {
        gen_op(cx, s.ops, 0, pbody, pcx);
    } else if rv == RV_BINARY || rv == RV_CHECKED && s.nops == 2 {
        let ot = op_type(s.ops, 0, pbody, pcx);
        if is_vector(ot, pcx) {
            gen_vector_assign(cx, s, dt, pbody, pcx);
            return;
        }
        // (the second operand first, the operator swapped, when the
        // accumulator holds it: find_acc_only)
        let swap = is_carried(s.ops, 1, pbody, pcx);
        gen_op(cx, s.ops, if swap { 1 } else { 0 }, pbody, pcx);
        if is_float(ot) || !gen_second(cx, s.ops, if swap { 0 } else { 1 }, pbody, pcx) {
            push_value(cx, ot, pcx);
            gen_op(cx, s.ops, if swap { 0 } else { 1 }, pbody, pcx);
            pop_second_operand(cx, ot, pcx);
        }
        let tok = if swap { swapped(s.d) } else { token_of(s.d) };
        if rv == RV_CHECKED {
            // (0.26.3, decision 6) Rust's checks: a shift's amount, as
            // unsigned, below the bits; `+ - *` by their result
            let kind = arith_panic_kind(s.d, false, false, pcx);
            let site = site_of(s.e, 0, pcx);
            if s.d == BO_SHL || s.d == BO_SHR {
                emit_check_imm(cx, true, int_bits(ot), true, kind, site, pcx);
                gen_operator(cx, tok, ot, dt, pcx);
            } else {
                emit_checked_binary(cx, tok, ot, kind, site, pcx);
            }
        } else {
            if (s.d == BO_DIV || s.d == BO_REM) && is_integer(ot) {
                gen_division_checks(cx, s, ot, pbody, pcx);
            }
            gen_operator(cx, tok, ot, dt, pcx);
        }
    } else if rv == RV_UNARY || rv == RV_CHECKED {
        if is_vector(dt, pcx) {
            bind(pcx.nodes[s.e as usize].b, s.ops, 0, pcx);
            gen_vector_negate(cx, pcx.nodes[s.e as usize].b, dt, pbody, pcx);
            unbind(pcx);
        } else {
            gen_op(cx, s.ops, 0, pbody, pcx);
            if rv == RV_CHECKED {
                // (0.26.3) `-x`: x is not a signed MIN, or is an
                // unsigned 0 (below 1)
                let kind = arith_panic_kind(UO_NEG, true, false, pcx);
                if is_signed(dt) {
                    emit_check_imm(cx, false, (0 - 1) << (int_bits(dt) - 1) as u64, false,
                        kind, site_of(s.e, 0, pcx), pcx);
                } else {
                    emit_check_imm(cx, false, 1, true, kind, site_of(s.e, 0, pcx), pcx);
                }
            }
            let tok = if s.d == UO_NEG { Tok::Minus } else if s.d == UO_NOT { Tok::Bang }
                else { Tok::Tilde };
            gen_unop(cx, tok, dt);
        }
    } else if rv == RV_CAST {
        gen_op(cx, s.ops, 0, pbody, pcx);
        gen_cast(cx, op_type(s.ops, 0, pbody, pcx), erase_type(s.d, pcx), pcx);
    } else if rv == RV_DISCR {
        gen_discriminant(cx, s.ops, pbody, pcx);
    } else if rv == RV_LEN {
        let t = op_type(s.ops, 0, pbody, pcx);
        if pcx.types[t as usize].kind == TyKind::Array {
            emit_load_imm(cx, R_ACC, pcx.types[t as usize].b as u64);
        } else {
            gen_op(cx, s.ops, 0, pbody, pcx);
            emit_add_imm(cx, R_ACC, 8);
            emit_load(cx, TY_U64, R_ACC, pcx);
        }
    } else if rv == RV_AGG {
        gen_aggregate(cx, s, dt, pbody, pcx);
        return;
    } else if rv == RV_REPEAT {
        let slot = alloc_slot_for(dt, pcx);
        gen_op(cx, s.ops, 0, pbody, pcx);
        gen_repeat_fill(cx, dt, slot, pcx);
        emit_frame_addr(cx, R_ACC, slot, pcx);
    } else if rv == RV_SLICE {
        gen_slice(cx, s, pbody, pcx);
    } else {
        return;
    }
    write_place(cx, dl, dp, pbody, pcx);
}

// (0.26.3, decision 6) The checks of an integer `a / b` or `a % b`
// (R_ACC a, R_SECOND b), at every level: b is not 0, and (signed) not a
// MIN / -1, each Rust's panic at its node. A constant divisor needs
// neither, or only the second when it is -1.
fn gen_division_checks(cx: &mut FnCtx<Comp>, s: PStmt, ot: i64, pbody: &Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    let site = site_of(s.e, 0, pcx);
    let k = op_kind(s.ops, 1, pbody);
    let known = k == OK_INT || k == OK_CONST;
    let value: i64 = if k
        == OK_INT { wrap_int(op_a(s.ops, 1, pbody), erase_type(op_b(s.ops, 1, pbody), pcx)) }
        else if k == OK_CONST { const_value(op_a(s.ops, 1, pbody), pcx) } else { 0 };
    if !known || value == 0 {
        emit_check_imm(cx, true, 0, false, arith_panic_kind(s.d, false, true, pcx), site, pcx);
    }
    if is_signed(ot) && (!known || value == 0 - 1) {
        emit_min_check(cx, ot, arith_panic_kind(s.d, false, false, pcx), site, pcx);
    }
}

// A binary operation on vectors (its node: the Binary, or the Assign of
// `v op= x`), by vector.vl's functions.
fn gen_vector_assign(cx: &mut FnCtx<Comp>, s: PStmt, dt: i64, pbody: &Body<Comp>,
    pcx: &mut Ctx<Comp>) {
    let n = s.e;
    if pcx.nodes[n as usize].kind == NodeKind::Assign {
        gen_op(cx, s.ops, 1, pbody, pcx);
        let b = vector_value_to_slot(cx, dt, pcx);
        let addr = alloc_slot(8, 8, pcx);
        gen_place_addr(cx, s.a, s.b, pbody, pcx);
        store_reg_to_frame(cx, R_ACC, addr, pcx);
        vector_assign_lanes(cx, token_of(s.d), dt, b, addr, pcx);
        return;
    }
    bind(pcx.nodes[n as usize].b, s.ops, 0, pcx);
    bind(pcx.nodes[n as usize].c, s.ops, 1, pcx);
    gen_vector_binary(cx, pcx.nodes[n as usize].op, pcx.nodes[n as usize].b,
        pcx.nodes[n as usize].c, dt, pbody, pcx);
    unbind(pcx);
    write_place(cx, s.a, s.b, pbody, pcx);
}

// Accumulator = the discriminant of place ops[0], an enum: a scalar
// enum's value, the null niche's test, else the tag in memory.
fn gen_discriminant(cx: &mut FnCtx<Comp>, ops: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // UNSAFE: the checker's TYPES, ENUMS and VARIANTS are raw tables.
    // SAFETY: t is the checked enum type of operand 0, so TYPES[t].a is an ENUMS
    // index; v stays below VARIANT_COUNT.
    unsafe {
        let t = op_type(ops, 0, pbody, pcx);
        let e = pcx.types[t as usize].a;
        let tag = (pcx.enums[e as usize]).tag;
        if !is_compound(t, pcx) {
            gen_place_value(cx, op_a(ops, 0, pbody), op_b(ops, 0, pbody), pbody, pcx);
            return;
        }
        gen_op(cx, ops, 0, pbody, pcx);
        if !enum_niche(e, pcx) {
            emit_load(cx, tag, R_ACC, pcx);
            return;
        }
        // (the variant with the pointer when it is not null)
        let mut some: i64 = 0;
        let mut none: i64 = 0;
        for v in 0..pcx.variants.len() as i64 {
            if pcx.variants[v as usize].enum_id == e {
                if pcx.variants[v as usize].field_count == 1 {
                    some = wrap_int(pcx.variants[v as usize].discr, tag);
                } else {
                    none = wrap_int(pcx.variants[v as usize].discr, tag);
                }
            }
        }
        emit_load(cx, TY_U64, R_ACC, pcx);
        emit_load_imm(cx, R_SECOND, 0);
        emit_compare(cx, Cond::Ne, TY_U64, pcx);
        if some == 1 && none == 0 {
            return;
        }
        emit_load_imm(cx, R_SECOND, (some - none) as u64);
        emit_int_binary(cx, Tok::Star, tag);
        emit_add_imm(cx, R_ACC, none);
        emit_normalize(cx, tag, pcx);
    }
}

// An aggregate into its place: built there when it is in a frame slot
// and no operand reads its local, else in a new slot then copied.
fn gen_aggregate(cx: &mut FnCtx<Comp>, s: PStmt, dt: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // UNSAFE: the checker's TYPES, ENUMS and VARIANTS are raw tables,
    // struct_field returns a raw pointer into the checker's field table.
    // SAFETY: dt is the place's checked type (an enum's for a variant, so
    // TYPES[dt].a is an ENUMS index); s.e is the builder's variant of that enum;
    // i is below the struct's field count (the builder makes one operand a field).
    unsafe {
        let ak = s.d;
        if ak == AK_VARIANT && !is_compound(dt, pcx) {
            let v = s.e;
            emit_load_imm(cx, R_ACC,
                wrap_int(pcx.variants[v as usize].discr,
                    (pcx.enums[pcx.types[dt as usize].a as usize]).tag) as u64);
            write_place(cx, s.a, s.b, pbody, pcx);
            return;
        }
        let mut in_place = in_frame(s.a, s.b, pbody, pcx);
        for i in 0..s.nops {
            let k = op_kind(s.ops, i, pbody);
            if (k == OK_COPY || k == OK_MOVE || k == OK_PLACE) && op_a(s.ops, i, pbody) == s.a {
                in_place = false;
            }
        }
        let base = if in_place { pcx.slot[s.a as usize] - chain_offset(s.a, s.b, pbody, pcx) }
            else { alloc_slot_for(dt, pcx) };
        if ak == AK_VARIANT {
            let v = s.e;
            let tag = (pcx.enums[pcx.types[dt as usize].a as usize]).tag;
            if enum_niche(pcx.types[dt as usize].a, pcx) {
                if s.nops == 1 {
                    gen_op(cx, s.ops, 0, pbody, pcx);
                } else {
                    emit_load_imm(cx, R_ACC, 0);
                }
                store_to_frame(cx, TY_U64, base, pcx);
            } else {
                for i in 0..s.nops {
                    gen_op(cx, s.ops, i, pbody, pcx);
                    store_to_frame(cx, erase_type(variant_field(v, i, pcx), pcx),
                        base - variant_field_offset(v, i, pcx), pcx);
                }
                emit_load_imm(cx, R_ACC, wrap_int(pcx.variants[v as usize].discr, tag) as u64);
                store_to_frame(cx, tag, base, pcx);
            }
        } else {
            for i in 0..s.nops {
                let mut offset: i64 = 0;
                let mut elem_ty: i64 = 0;
                if ak == AK_STRUCT || ak == AK_CLOSURE {
                    let st = pcx.types[dt as usize].a;
                    offset = field_offset(st, i, pcx);
                    elem_ty = erase_type((struct_field(st, i, pcx)).ty, pcx);
                } else if ak == AK_TUPLE {
                    offset = tuple_offset(dt, i, pcx);
                    elem_ty = erase_type(type_elem(dt, i, pcx), pcx);
                } else {
                    elem_ty = erase_type(pcx.types[dt as usize].a, pcx);
                    offset = i * type_size(elem_ty, pcx);
                }
                // (a union literal's fields not written: `const ()`)
                if op_kind(s.ops, i, pbody) == OK_UNIT {
                    continue;
                }
                gen_op(cx, s.ops, i, pbody, pcx);
                store_to_frame(cx, elem_ty, base - offset, pcx);
            }
        }
        if !in_place {
            emit_frame_addr(cx, R_ACC, base, pcx);
            write_place(cx, s.a, s.b, pbody, pcx);
        }
    }
}

// Accumulator = `base[lo..hi]` (node s.d), as expr.vl's gen_slicing: the
// base (a pointer's value, a slice's or an array's address), the bounds
// (absent: OK_UNIT), then gen_slice_tail.
fn gen_slice(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let bt = op_type(s.ops, 0, pbody, pcx);
    let slot = alloc_slot(16, 8, pcx);
    let length = alloc_slot(8, 8, pcx);
    let low_slot = alloc_slot(8, 8, pcx);
    let high_slot = alloc_slot(8, 8, pcx);
    if pcx.types[bt as usize].kind == TyKind::Ptr {
        gen_place_value(cx, op_a(s.ops, 0, pbody), op_b(s.ops, 0, pbody), pbody, pcx);
    } else {
        gen_op(cx, s.ops, 0, pbody, pcx);
    }
    store_reg_to_frame(cx, R_ACC, slot, pcx);
    let mut bound_ty = TY_U64;
    if op_kind(s.ops, 1, pbody) != OK_UNIT {
        gen_op(cx, s.ops, 1, pbody, pcx);
        bound_ty = op_type(s.ops, 1, pbody, pcx);
    } else {
        emit_load_imm(cx, R_ACC, 0);
    }
    store_reg_to_frame(cx, R_ACC, low_slot, pcx);
    let has_high = op_kind(s.ops, 2, pbody) != OK_UNIT;
    if has_high {
        gen_op(cx, s.ops, 2, pbody, pcx);
        bound_ty = op_type(s.ops, 2, pbody, pcx);
        store_reg_to_frame(cx, R_ACC, high_slot, pcx);
    }
    gen_slice_tail(cx, s.d, bt, false, has_high, bound_ty, slot, length, low_slot, high_slot,
        pcx);
}

// ---- Calls and intrinsics ----

// A call: by call.vl's gen_call of its node with the operands bound (its
// intrinsics, contracts and convention), or, for one the builder made,
// the call sequence itself.
fn gen_call_stmt(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let n = s.node;
    let f = s.c;
    let skip: i64 = if f < 0 { 1 } else { 0 };
    // (a compound result made in its destination's slot: into_dest)
    let into = into_dest(s, pbody, pcx);
    if bound_call(s, pcx) {
        if f < 0 {
            bind(pcx.nodes[n as usize].a, s.ops, 0, pcx);
        }
        for i in 0..pcx.nodes[n as usize].count {
            bind(child(n, i, pcx), s.ops, i + skip, pcx);
        }
        if into != 0 {
            pcx.result_into = into;
        }
        gen_call(cx, n, pbody, pcx);
        pcx.result_into = 0;
        unbind(pcx);
        if into == 0 {
            write_place(cx, s.a, s.b, pbody, pcx);
        }
        return;
    }
    let mut param_count: i64 = 0;
    let mut ret: i64 = 0;
    let mut variadic = false;
    let mut callee_ty: i64 = 0;
    if f >= 0 {
        param_count = pcx.fns[f as usize].param_count;
        ret = pcx.fns[f as usize].ret;
        variadic = pcx.fns[f as usize].variadic;
    } else {
        callee_ty = op_type(s.ops, 0, pbody, pcx);
        param_count = pcx.types[callee_ty as usize].count;
        ret = pcx.types[callee_ty as usize].a;
    }
    let count = s.nops - skip;
    if count > 64 {
        crate::base::die(c"places: a call with more than 64 arguments");
    }
    let mut arg_types: [i64; 64] = [0i64; 64];
    let mut pushed: i64 = 0;
    for i in 0..count {
        let mut ty = op_type(s.ops, i + skip, pbody, pcx);
        if i < param_count {
            ty = if f >= 0 { fn_param(f, i, pcx) } else { type_elem(callee_ty, i, pcx) };
        }
        gen_op(cx, s.ops, i + skip, pbody, pcx);
        if gen_pass_arg(cx, ty, op_fresh(s.ops, i + skip, pbody), pcx) {
            arg_types[i as usize] = ty;
            pushed += 1;
        }
    }
    if f < 0 {
        gen_op(cx, s.ops, 0, pbody, pcx);
        push_x0(cx, pcx);
        pushed += 1;
    }
    if n > 0 && pcx.nodes[n as usize].kind == NodeKind::Call {
        site_before_call(cx, n, pcx);
    }
    pcx.result_into = into;
    gen_call_sequence(cx, f, &mut arg_types[..], count, param_count, variadic,
        pushed, ret, pcx);
    if into == 0 {
        write_place(cx, s.a, s.b, pbody, pcx);
    }
}

// The frame slot call s makes its compound result in, its destination's
// (0: a new one, then copied): a whole local in the frame that nothing
// borrows (the callee cannot see it before it returns) and no operand of
// the call names; a plain call (plain_call: its convention's, no
// intrinsic's).
fn into_dest(s: PStmt, pbody: &Body<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let l = s.a;
    if s.b != 0 || s.c < 0 || pcx.slot[l as usize] <= 0 || has_flag(l, LF_STATIC, pbody)
        || pcx.acc_only[l as usize] || has_flag(l, crate::places::ir::LF_BORROWED, pbody)
        || !is_compound(local_type(l, pcx), pcx)
        || l <= pbody.params || bound_call(s, pcx) && !plain_call(s, pcx) {
        return 0;
    }
    for i in 0..s.nops {
        let k = op_kind(s.ops, i, pbody);
        if (k == OK_COPY || k == OK_MOVE || k == OK_PLACE) && op_a(s.ops, i, pbody) == l {
            return 0;
        }
    }
    pcx.slot[l as usize]
}

// Whether call s, of function s.c through gen_call, is an ordinary one: no
// contract check, no std::arch intrinsic (whose own forms neither read
// their arguments first nor make a result by the call sequence).
fn plain_call(s: PStmt, pcx: &Ctx<Comp>) -> bool {
    s.c >= 0 && s.c != pcx.check_fn
        && crate::arch::intrinsic_of_fn(s.c, pcx) < 0
}

// Whether call s is generated by gen_call of its node, its operands bound.
fn bound_call(s: PStmt, pcx: &Ctx<Comp>) -> bool {
    let n = s.node;
    let skip: i64 = if s.c < 0 { 1 } else { 0 };
    n > 0 && pcx.nodes[n as usize].kind == NodeKind::Call && pcx.nodes[n as usize].x - 1 == s.c
        && pcx.nodes[n as usize].count + skip == s.nops
}

// (0.26.2) A check's failing path, the places IR's (as middle/lower's
// lower_contract_failure): ops[1] the site, ops[2..] the shown values
// (widened to 64 bits), the helper called with the message, whose text
// alone is the AST's; the block ends in `unreachable`.
fn gen_contract_failure(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    // UNSAFE: shown is a raw IntVec this function owns; NODES is the checker's
    // raw table.
    // SAFETY: check_values fills shown, whose data is freed once here; s.d is
    // the check's call node, below NODE_COUNT.
    unsafe {
        let n = s.d;
        let check = pcx.nodes[child(n, 2, pcx) as usize].a;
        let mut shown: Vec<i64, Comp> = Vec::new_in(Comp {});
        crate::front::contracts::checks::check_values(n, s.e, &mut shown, pcx);
        // (the site: a `$pre` function's SITE parameter, or the check's
        // own, the AST's constant)
        let site_kind = op_kind(s.ops, 1, pbody);
        if site_kind == OK_COPY || site_kind == OK_MOVE {
            gen_op(cx, s.ops, 1, pbody, pcx);
            gen_cast(cx, op_type(s.ops, 1, pbody, pcx), TY_I64, pcx);
        } else {
            gen_expr(cx, child(n, 1, pcx), pbody, pcx);
        }
        push_x0(cx, pcx);
        let count = s.nops - 2;
        for i in 0..count {
            let ty = op_type(s.ops, i + 2, pbody, pcx);
            gen_op(cx, s.ops, i + 2, pbody, pcx);
            gen_cast(cx, ty, if is_signed(ty) { TY_I64 } else { TY_U64 }, pcx);
            push_x0(cx, pcx);
        }
        if count > 2 {
            pop_x(cx, R_ADDR, pcx);
        }
        if count > 1 {
            pop_x(cx, R_SECOND, pcx);
        }
        if count > 0 {
            pop_x(cx, R_ACC, pcx);
        }
        let kind = message_kind(crate::front::contracts::checks::check_message(check, s.e, &shown,
            pcx.gen_cur_fn, pcx), pcx);
        emit_panic_site_popped(cx, kind, pcx);
    }
}

fn gen_intrinsic_stmt(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let n = s.d;
    if s.c == IK_PANIC {
        gen_op(cx, s.ops, 0, pbody, pcx);
        gen_cast(cx, op_type(s.ops, 0, pbody, pcx), TY_I64, pcx);
        let pcx_site2 = site_of(n, 0, pcx);
        emit_panic(cx, pcx.nodes[n as usize].x, pcx, pcx_site2);
        return;
    }
    if s.c == IK_CONTRACT {
        gen_contract_failure(cx, s, pbody, pcx);
        return;
    }
    if s.c == IK_VECTOR {
        let mut j: i64 = 0;
        if pcx.nodes[n as usize].a != 0 {
            bind(pcx.nodes[n as usize].a, s.ops, 0, pcx);
            j = 1;
        }
        for i in 0..pcx.nodes[n as usize].count {
            bind(child(n, i, pcx), s.ops, i + j, pcx);
        }
        gen_vecop(cx, n, pbody, pcx);
    } else if s.c == IK_ARCH {
        for i in 0..pcx.nodes[n as usize].count {
            bind(child(n, i, pcx), s.ops, i, pcx);
        }
        gen_call(cx, n, pbody, pcx);
    } else {
        return;
    }
    unbind(pcx);
    write_place(cx, s.a, s.b, pbody, pcx);
}

// ---- Terminators ----

fn gen_term(cx: &mut FnCtx<Comp>, at: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let s = pbody.stmts[at as usize];
    let k = s.kind;
    if k == TK_GOTO && !pcx.places_ret_block[s.a as usize] {
        jump_to(cx, s.a, pcx);
    } else if k == TK_SWITCH {
        gen_switch(cx, s, pbody, pcx);
    } else if k == TK_RETURN || k == TK_GOTO {
        // (a return, or a jump to a block with nothing but one: the return
        // itself)
        let ret = pcx.fns[pcx.gen_cur_fn as usize].ret;
        if !is_void(ret) && ret != TY_NEVER {
            gen_place_value(cx, 0, 0, pbody, pcx);
            gen_return_value(cx, ret, pcx);
        }
        if pcx.next >= 0 {
            emit_jump(cx, pcx.return_label);
        }
    }
}

// `switch op [v: b, .., otherwise: c]`: a bool's a branch, else a compare
// and jump per value.
fn gen_switch(cx: &mut FnCtx<Comp>, s: PStmt, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let ty = op_type(s.ops, 0, pbody, pcx);
    gen_op(cx, s.ops, 0, pbody, pcx);
    if s.b == 1 && pbody.targets[s.a as usize] == 0 && ty == TY_BOOL {
        let when_false = pcx.gen0_fwd[pbody.targets[(s.a + 1) as usize] as usize];
        let otherwise = pcx.gen0_fwd[s.c as usize];
        if when_false != otherwise {
            if when_false == pcx.next {
                crate::gen0::target::emit_jump_if_nonzero(cx, pcx.label[otherwise as usize]);
                return;
            }
            emit_jump_if_zero(cx, pcx.label[when_false as usize]);
        }
        jump_to(cx, otherwise, pcx);
        return;
    }
    for i in 0..s.b {
        emit_load_imm(cx, R_SECOND, wrap_int(pbody.targets[(s.a + 2 * i) as usize], ty) as u64);
        emit_compare_jump(cx, Cond::Eq, false,
            pcx.label[pcx.gen0_fwd[pbody.targets[(s.a + 2 * i + 1) as usize] as usize] as usize]);
    }
    jump_to(cx, s.c, pcx);
}
