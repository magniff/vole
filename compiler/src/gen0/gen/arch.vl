// -O0's calls of std::arch's intrinsics (0.19, docs/design/arch.md §5.1):
// the arguments are evaluated into frame slots in order, the vector
// operands loaded into v0-v2 (xmm0-xmm2), the scalar ones into x0-x2
// (rax, rcx, rdx), and the instruction is written by the machine layer
// with those registers: its table's template (INTR) or 0.10's vector
// operation (the generic forms), as -O1 and -O2 write them; the result
// (v0/xmm0, x0/rax) is stored into a new slot (a vector) or stays in the
// accumulator. Loads and stores are checked as 0.10's v.load(s, i) and
// copy the bytes; has() and detect() are constants. (T1 may route the
// generic forms through 0.10's lane-by-lane code, to keep -O0 an
// independent oracle for them.)

use crate::arch::{
    FORM_BITS, FORM_CAST, FORM_FEAT, FORM_INTR, FORM_INTR_MEM, FORM_LOAD, FORM_LOAD_DUP, FORM_STORE,
    FORM_VBIN, FORM_VCMP, FORM_VEXT, FORM_VINS, FORM_VNEG, FORM_VSEL, FORM_VSPLAT, FORM_VSUM,
    MEM_LOAD, intr_param_is_const, intrinsic_is_foreign,
};
use crate::back::mc_arm64::arch::ma_intr;
use crate::back::mc_arm64::vector::{ma_vbin, ma_vcmp, ma_vext, ma_vsplat};
use crate::back::mc_x86_64::arch::mx_intr;
use crate::back::mc_x86_64::vector::{mx_vbin, mx_vcmp, mx_vext, mx_vsplat};
use crate::base::die;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::ast::child;
use crate::front::consteval::const_eval;
use crate::front::features::{feature_call_bit, feature_call_value};
use crate::front::lexer::Tok;
use crate::front::types::{
    TY_U64, is_compound, is_float, is_vector, is_void, tuple_offset, type_elem, type_size,
};
use crate::gen0::gen::{alloc_slot, fn_symbol_prefix, load_reg_from_frame, store_reg_to_frame};
use crate::gen0::gen::expr::gen_operand;
use crate::gen0::gen::vector::{gen_vector_address, gen_vector_to_slot};
use crate::gen0::target::{
    R_ACC, R_ADDR, R_SECOND, emit_call, emit_copy, emit_frame_addr, emit_int_binary, emit_load_imm,
    emit_normalize, emit_store, ins, o, oi, on,
};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, Op};
use crate::places::ir::Body;

// The registers the operands and the result take: vector k in 32 + k,
// scalar k in k (x0-x2 / rax rcx rdx: the machine layer's numbers).
const VREG: i64 = 32;

// Call n of intrinsic id (its declaration is function f) into the
// accumulator (a vector's slot address); false for a call left to
// gen_call (a bits.* intrinsic: its body is called).
pub fn gen_intrinsic(cx: &mut FnCtx<Comp>, n: i64, f: i64, id: i64, pbody: &Body<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let ret = pcx.fns[f as usize].ret;
        let form = (pcx.intrs[id as usize]).form;
        if form == FORM_BITS {
            return false;
        }
        if intrinsic_is_foreign(id, pcx) {
            // (dead: under a constant-false has/detect; T2 makes the rest
            // errors)
            if get_x86() { ins(cx, c"ud2"); } else { ins(cx, c"brk #1"); }
            if is_compound(ret, pcx) {
                emit_frame_addr(cx, R_ACC, alloc_slot(type_size(ret, pcx), 16, pcx), pcx);
            }
            return true;
        }
        if form == FORM_FEAT {
            let value = feature_call_value(n, pcx);
            let word = crate::back::isel::arch::arch_std_fn(false, pcx);
            if value >= 0 || word < 0 {
                emit_load_imm(cx, R_ACC, if value > 0 { 1 } else { 0 });
                return true;
            }
            // (0.19 T3) tested at run time: std's word (filled by main's
            // first call, or by this one in a library), then its bit
            emit_call(cx, fn_symbol_prefix(word, pcx), pcx.fns[word as usize].name, false, false, 0,
                pcx);
            emit_load_imm(cx, R_SECOND, feature_call_bit(n, pcx) as u64);
            emit_int_binary(cx, Tok::Shr, TY_U64);
            emit_load_imm(cx, R_SECOND, 1);
            emit_int_binary(cx, Tok::Amp, TY_U64);
            return true;
        }
        if form == FORM_LOAD || form == FORM_STORE {
            let s = (pcx.intrs[id as usize]).mem_param;
            let arg = child(n, s, pcx);
            // (0.19 T1: a raw:: pointer form has no index: the pointer, then
            // the vector to store)
            let raw = pcx.fns[f as usize].param_count < (pcx.intrs[id as usize]).nparams;
            let mut ptr: i64 = 0;
            if raw {
                ptr = alloc_slot(8, 8, pcx);
                gen_operand(cx, arg, pbody, pcx);
                store_reg_to_frame(cx, R_ACC, ptr, pcx);
            } else {
                let elem = pcx.types[pcx.nodes[arg as usize].ty as usize].a;
                let count = (pcx.intrs[id as usize]).mem_bytes / type_size(elem, pcx);
                ptr = gen_vector_address(cx, arg, child(n, s + 1, pcx), count, elem, pbody, pcx);
            }
            let bytes = (pcx.intrs[id as usize]).mem_bytes;
            if form == FORM_LOAD {
                let r = alloc_slot(bytes, 16, pcx);
                load_reg_from_frame(cx, R_ACC, ptr, pcx);
                emit_frame_addr(cx, R_SECOND, r, pcx);
                emit_copy(cx, bytes);
                emit_frame_addr(cx, R_ACC, r, pcx);
            } else {
                let v = gen_vector_to_slot(cx, child(n, if raw { s + 1 } else { s + 2 }, pcx),
                    pbody, pcx);
                load_reg_from_frame(cx, R_SECOND, ptr, pcx);
                emit_frame_addr(cx, R_ACC, v, pcx);
                emit_copy(cx, bytes);
            }
            return true;
        }
        if form == FORM_INTR_MEM {
            // (T6) vld2q/vst2q: the checked address in the first register,
            // the pair in v30, v31 (the template's <u>, <t>), the instruction
            let s = (pcx.intrs[id as usize]).mem_param;
            let arg = child(n, s, pcx);
            let raw = pcx.fns[f as usize].param_count < (pcx.intrs[id as usize]).nparams;
            let load = (pcx.intrs[id as usize]).mem == MEM_LOAD;
            let tuple = if load { ret }
                else { pcx.nodes[child(n, if raw { s + 1 } else { s + 2 }, pcx) as usize].ty };
            let half = type_elem(tuple, 0, pcx);
            let mut ptr: i64 = 0;
            if raw {
                ptr = alloc_slot(8, 8, pcx);
                gen_operand(cx, arg, pbody, pcx);
                store_reg_to_frame(cx, R_ACC, ptr, pcx);
            } else {
                let elem = pcx.types[pcx.nodes[arg as usize].ty as usize].a;
                ptr = gen_vector_address(cx, arg, child(n, s + 1, pcx),
                    (pcx.intrs[id as usize]).mem_bytes / type_size(elem, pcx), elem, pbody,
                    pcx);
            }
            let mut regs: [i64; 8] = [-1; 8];
            let imms: [i64; 8] = [0i64; 8];
            regs[s as usize] = R_ACC;
            if load {
                load_reg_from_frame(cx, R_ACC, ptr, pcx);
                if get_x86() { mx_intr(cx, id, VREG, &regs[..], &imms[..], pcx); }
                else { ma_intr(cx, id, VREG, &regs[..], &imms[..], pcx); }
                let r = alloc_slot(type_size(tuple, pcx), 16, pcx);
                emit_frame_addr(cx, R_ADDR, r, pcx);
                store_register(cx, VREG + 30, half, pcx);
                emit_frame_addr(cx, R_ADDR, r - tuple_offset(tuple, 1, pcx), pcx);
                store_register(cx, VREG + 31, half, pcx);
                emit_frame_addr(cx, R_ACC, r, pcx);
                return true;
            }
            let v = gen_vector_to_slot(cx, child(n, if raw { s + 1 } else { s + 2 }, pcx), pbody,
                pcx);
            emit_frame_addr(cx, R_ADDR, v, pcx);
            load_register(cx, VREG + 30, half, pcx);
            emit_frame_addr(cx, R_ADDR, v - tuple_offset(tuple, 1, pcx), pcx);
            load_register(cx, VREG + 31, half, pcx);
            load_reg_from_frame(cx, R_ACC, ptr, pcx);
            if get_x86() { mx_intr(cx, id, VREG, &regs[..], &imms[..], pcx); }
            else { ma_intr(cx, id, VREG, &regs[..], &imms[..], pcx); }
            return true;
        }
        if form == FORM_LOAD_DUP {
            // (T6) the element's checked address (or the raw:: pointer) in the
            // first register, then the instruction (ld1r)
            let s = (pcx.intrs[id as usize]).mem_param;
            let arg = child(n, s, pcx);
            let mut ptr: i64 = 0;
            if pcx.fns[f as usize].param_count < (pcx.intrs[id as usize]).nparams {
                ptr = alloc_slot(8, 8, pcx);
                gen_operand(cx, arg, pbody, pcx);
                store_reg_to_frame(cx, R_ACC, ptr, pcx);
            } else {
                ptr = gen_vector_address(cx, arg, child(n, s + 1, pcx), 1,
                    pcx.types[pcx.nodes[arg as usize].ty as usize].a, pbody, pcx);
            }
            load_reg_from_frame(cx, R_ACC, ptr, pcx);
            let mut regs: [i64; 8] = [-1; 8];
            let imms: [i64; 8] = [0i64; 8];
            regs[s as usize] = R_ACC;
            if get_x86() { mx_intr(cx, id, VREG, &regs[..], &imms[..], pcx); }
            else { ma_intr(cx, id, VREG, &regs[..], &imms[..], pcx); }
            let r = alloc_slot(type_size(ret, pcx), 16, pcx);
            emit_frame_addr(cx, R_ADDR, r, pcx);
            store_register(cx, VREG, ret, pcx);
            emit_frame_addr(cx, R_ACC, r, pcx);
            return true;
        }
        if form == FORM_CAST {
            let v = gen_vector_to_slot(cx, child(n, 0, pcx), pbody, pcx);
            emit_frame_addr(cx, R_ACC, v, pcx);
            return true;
        }
        // The operands into slots, in order; the immediates' values.
        let count = (pcx.intrs[id as usize]).nparams;
        let mut slots: [i64; 8] = [0i64; 8];
        let mut imms: [i64; 8] = [0i64; 8];
        let mut regs: [i64; 8] = [-1; 8];
        for k in 0..count {
            let e = child(n, k, pcx);
            if intr_param_is_const(id, k, pcx) {
                imms[k as usize] = const_eval(e, pcx);
            } else if is_vector(pcx.nodes[e as usize].ty, pcx) {
                slots[k as usize] = gen_vector_to_slot(cx, e, pbody, pcx);
            } else if is_float(pcx.nodes[e as usize].ty) {
                // (a float in the float accumulator, d0/xmm0)
                let slot = alloc_slot(8, 8, pcx);
                gen_operand(cx, e, pbody, pcx);
                emit_frame_addr(cx, R_ADDR, slot, pcx);
                emit_store(cx, pcx.nodes[e as usize].ty, R_ACC, R_ADDR, pcx);
                slots[k as usize] = slot;
            } else {
                // (the canonical 64 bits)
                let slot = alloc_slot(8, 8, pcx);
                gen_operand(cx, e, pbody, pcx);
                store_reg_to_frame(cx, R_ACC, slot, pcx);
                slots[k as usize] = slot;
            }
        }
        // ... then into their registers.
        for k in 0..count {
            let e = child(n, k, pcx);
            if intr_param_is_const(id, k, pcx) {
                continue;
            }
            let ty = pcx.nodes[e as usize].ty;
            regs[k as usize] = if is_vector(ty, pcx) || is_float(ty) { VREG + k } else { k };
            emit_frame_addr(cx, R_ADDR, slots[k as usize], pcx);
            load_register(cx, regs[k as usize], ty, pcx);
        }
        let vector_result = is_vector(ret, pcx);
        let mut wide = type_size(ret, pcx) == 32;
        for k in 0..count {
            if !intr_param_is_const(id, k, pcx)
                && type_size(pcx.nodes[child(n, k, pcx) as usize].ty, pcx) == 32 {
                wide = true;
            }
        }
        // (a float result in v0: the float accumulator's d0/s0)
        let d: i64 = if vector_result || is_float(ret) { VREG } else { 0 };
        let work = if (pcx.intrs[id as usize]).work
            != 0 { (pcx.sym_primitive[(pcx.intrs[id as usize]).work as usize]) }
            else { ret };
        // (T6: the forms of an exact generic operation are their instruction
        // here, so that -O0 checks the operation -O1 and -O2 make)
        if form == FORM_INTR || form == FORM_VNEG || form == FORM_VINS || form == FORM_VSEL
            || form == FORM_VSUM {
            if get_x86() { mx_intr(cx, id, d, &regs[..], &imms[..], pcx); }
            else { ma_intr(cx, id, d, &regs[..], &imms[..], pcx); }
            if get_x86() && wide && !vector_result {
                // (0.19: -O0 keeps no value in a register: the ymm state is
                // clean after each 256-bit intrinsic; a 256-bit result is
                // stored first)
                ins(cx, c"vzeroupper");
            }
        } else if form == FORM_VSPLAT {
            if get_x86() { mx_vsplat(cx, work, d, regs[0], pcx); }
            else { ma_vsplat(cx, work, d, regs[0], pcx); }
        } else if form == FORM_VEXT {
            let vt = pcx.nodes[child(n, 0, pcx) as usize].ty;
            if get_x86() { mx_vext(cx, vt, d, regs[0], imms[1], pcx); }
            else { ma_vext(cx, vt, d, regs[0], imms[1], pcx); }
        } else if form == FORM_VBIN {
            let raw = (pcx.intrs[id as usize]).form_arg;
            let op = raw as Op;
            if get_x86() { mx_vbin(cx, op, work, d, regs[0], regs[1], pcx); }
            else { ma_vbin(cx, op, work, d, regs[0], regs[1], pcx); }
        } else if form == FORM_VCMP {
            let raw = (pcx.intrs[id as usize]).form_arg;
            let cond = raw as Cond;
            if get_x86() { mx_vcmp(cx, cond, work, d, regs[0], regs[1], pcx); }
            else { ma_vcmp(cx, cond, work, d, regs[0], regs[1], pcx); }
        } else {
            die(c"internal error: an intrinsic of a form not generated yet at -O0 (0.19 Phase 0)");
        }
        if vector_result {
            let r = alloc_slot(type_size(ret, pcx), 16, pcx);
            emit_frame_addr(cx, R_ADDR, r, pcx);
            store_register(cx, VREG, ret, pcx);
            emit_frame_addr(cx, R_ACC, r, pcx);
        } else if !is_void(ret) && !is_float(ret) {
            emit_normalize(cx, ret, pcx);
        }
        true
    }
}

// Register r (the machine layer's number) = the value of type ty at the
// address in R_ADDR (x9 / r11).
fn load_register(cx: &mut FnCtx<Comp>, r: i64, ty: i64, pcx: &Ctx<Comp>) {
    let size = type_size(ty, pcx);
    if get_x86() && size == 32 {
        // (0.19: AVX's 256-bit registers)
        o(cx, c"    vmovdqu (%r11), %ymm");
        oi(cx, r - 32);
        on(cx);
        return;
    }
    if get_x86() {
        o(cx, if r
            >= 32 {
            if size == 16 { c"    movups (%r11), %xmm" } else { c"    movsd (%r11), %xmm" }
        }
            else { c"    movq (%r11), " });
        if r >= 32 {
            oi(cx, r - 32);
        } else {
            o(cx, if r == 0 { c"%rax" } else if r == 1 { c"%rcx" } else { c"%rdx" });
        }
        on(cx);
        return;
    }
    o(cx, c"    ldr ");
    if r >= 32 {
        o(cx, if size == 16 { c"q" } else if size == 4 { c"s" } else { c"d" });
        oi(cx, r - 32);
    } else {
        o(cx, c"x");
        oi(cx, r);
    }
    o(cx, c", [x9]");
    on(cx);
}

// The value of type ty in register r into the memory at R_ADDR.
fn store_register(cx: &mut FnCtx<Comp>, r: i64, ty: i64, pcx: &Ctx<Comp>) {
    let size = type_size(ty, pcx);
    if get_x86() && size == 32 {
        o(cx, c"    vmovdqu %ymm");
        oi(cx, r - 32);
        o(cx, c", (%r11)");
        on(cx);
        ins(cx, c"vzeroupper");
        return;
    }
    if get_x86() {
        o(cx, if size == 16 { c"    movups %xmm" } else { c"    movsd %xmm" });
        oi(cx, r - 32);
        o(cx, c", (%r11)");
        on(cx);
        return;
    }
    o(cx, if size == 16 { c"    str q" } else { c"    str d" });
    oi(cx, r - 32);
    o(cx, c", [x9]");
    on(cx);
}
