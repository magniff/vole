// Calls (gen0): the arguments evaluated and passed by the platform's C
// convention (classified by abi.vl: registers, pieces, the stack,
// variadic arguments), compound arguments by a pointer to a copy, and the
// call itself, direct or through a pointer.

use crate::arch::intrinsic_of_fn;
use crate::back::abi::{
    AbiClass, abi_classify, abi_piece_locations, abi_stack_location, abi_variadic_piece_locations,
    return_piece_reg, returns_through_pointer, variadic_kind,
};
use crate::back::emit::machine::{arg_reg, m_load, m_store, reg_sp, xl_from_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::ast::child;
use crate::front::check::type_error;
use crate::front::types::{
    TY_BOOL, TY_U64, TY_U8, align_to, fn_param, is_compound, is_float, is_integer, is_void, max_i64,
    scalar_type, type_align, type_elem, type_size,
};
use crate::gen0::gen::{alloc_slot, alloc_slot_for, fn_symbol_prefix};
use crate::gen0::gen::arch::gen_intrinsic;
use crate::gen0::gen::checkalloc::site_before_call;
use crate::gen0::gen::expr::gen_operand;
use crate::gen0::target::{
    R_ACC, R_ADDR, R_RESULT, R_SECOND, arg_location, emit_call, emit_call_indirect, emit_copy,
    emit_frame_addr, emit_load_arg_reg, emit_load_callee, emit_normalize, emit_sp_add, emit_sp_sub,
    emit_stack_arg, first_int_arg, push_value, push_x0, variadic_arg_location,
};
use crate::gen0::x86_64::{x64_realign_pushed, x64_restore_sp};
use crate::middle::ctx::FnCtx;
use crate::middle::lower::is_fresh;
use crate::places::ir::Body;

pub fn gen_call(cx: &mut FnCtx<Comp>, n: i64, pbody: &Body<Comp>, pcx: &mut Ctx<Comp>) {
    let callee = pcx.nodes[n as usize].a;
    let direct = pcx.nodes[n as usize].x - 1;
    // (0.19: std::arch's intrinsics)
    let intr = intrinsic_of_fn(direct, pcx);
    if intr >= 0 && gen_intrinsic(cx, n, direct, intr, pbody, pcx) {
        return;
    }
    let mut param_count: i64 = 0;
    let mut ret: i64 = 0;
    let mut variadic = false;
    let mut callee_ty: i64 = 0;
    if direct >= 0 {
        param_count = pcx.fns[direct as usize].param_count;
        ret = pcx.fns[direct as usize].ret;
        variadic = pcx.fns[direct as usize].variadic;
    } else {
        callee_ty = pcx.nodes[callee as usize].ty;
        param_count = pcx.types[callee_ty as usize].count;
        ret = pcx.types[callee_ty as usize].a;
    }
    let count = pcx.nodes[n as usize].count;
    if count > 64 {
        type_error(n, c"too many arguments (at most 64 are supported)", pcx);
    }
    // The type of each passed argument (0 for unit arguments, not passed).
    let mut arg_types: [i64; 64] = [0i64; 64];
    let mut pushed: i64 = 0;
    for i in 0..count {
        let arg = child(n, i, pcx);
        let mut ty = pcx.nodes[arg as usize].ty;
        if i < param_count {
            ty = if direct >= 0 { fn_param(direct, i, pcx) }
                else { type_elem(callee_ty, i, pcx) };
        }
        gen_operand(cx, arg, pbody, pcx);
        if gen_pass_arg(cx, ty, is_fresh(arg, pcx), pcx) {
            arg_types[i as usize] = ty;
            pushed += 1;
        }
    }
    if direct < 0 {
        gen_operand(cx, callee, pbody, pcx);
        push_x0(cx, pcx);
        pushed += 1;
    }
    // (0.16: --check-alloc's allocation site, the arguments pushed)
    site_before_call(cx, n, pcx);
    gen_call_sequence(cx, direct, arg_types.as_mut_ptr() as *mut i64, count, param_count, variadic,
        pushed, ret, pcx);
}

// (0.26.1) An argument of type ty, in the accumulator, pushed for a call
// (gen_call_sequence): a compound one as the address of a private copy,
// of a multiple of 8 bytes (read in pieces), unless it is `fresh` (a new
// temporary). False for a unit argument, which is not passed.
pub fn gen_pass_arg(cx: &mut FnCtx<Comp>, ty: i64, fresh: bool, pcx: &mut Ctx<Comp>) -> bool {
    if is_void(ty) {
        return false;
    }
    if is_compound(ty, pcx) && !fresh {
        let copy = alloc_slot_for(ty, pcx);
        emit_frame_addr(cx, R_SECOND, copy, pcx);
        emit_copy(cx, type_size(ty, pcx));
        emit_frame_addr(cx, R_ACC, copy, pcx);
    }
    push_value(cx, ty, pcx);
    true
}

// Where each argument goes (see arg_location): `locations[i]` for scalars,
// pointers to copies (AbiClass::Ref) and copies on the stack (AbiClass::Stack), the
// pieces' locations at `pieces[4 * i + k]` for aggregates in pieces;
// `kinds[i]` is the ABI kind. Returns the size of the outgoing stack area,
// and the number of float registers used in `float_regs`.
fn assign_arg_locations(cx: &mut FnCtx<Comp>, arg_types: *mut i64, count: i64, param_count: i64,
    variadic: bool, ret: i64, locations: *mut i64, pieces: *mut i64, kinds: *mut AbiClass,
    float_regs: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut state: [i64; 3] = [first_int_arg(cx, ret, pcx), 0, 0];
        for i in 0..count {
            let ty = (*arg_types.add(i as usize));
            if ty == 0 {
                continue;
            }
            let extra = variadic && i >= param_count;
            let kind = if extra { variadic_kind(cx, ty, pcx) } else { abi_classify(cx, ty, pcx) };
            (*kinds.add(i as usize)) = kind;
            if extra && kind == AbiClass::Pieces {
                abi_variadic_piece_locations(cx, ty, state.as_mut_ptr() as *mut i64,
                    pieces.add((4 * i) as usize), pcx);
            } else if extra && kind != AbiClass::Stack {
                (*locations.add(i as usize)) = variadic_arg_location(if kind
                    == AbiClass::Ref { TY_U64 }
                    else { ty }, state.as_mut_ptr() as *mut i64, pcx);
            } else if kind == AbiClass::Pieces {
                abi_piece_locations(cx, ty, state.as_mut_ptr() as *mut i64,
                    pieces.add((4 * i) as usize), pcx);
            } else if kind == AbiClass::Stack {
                (*locations.add(i as usize)) = abi_stack_location(ty,
                    state.as_mut_ptr() as *mut i64, pcx);
            } else {
                (*locations.add(i as usize)) = arg_location(if kind == AbiClass::Ref { TY_U64 }
                    else { ty },
                    state.as_mut_ptr() as *mut i64, pcx);
            }
        }
        *float_regs = state[1];
        align_to(state[2], 16)
    }
}

// Moves the pushed arguments into their registers and stack slots. The
// k-th pushed temporary is at sp + stack_size + 16 * (pushed - 1 - k); an
// aggregate's temporary holds its address (of a private copy).
fn place_args(cx: &mut FnCtx<Comp>, arg_types: *mut i64, count: i64, param_count: i64,
    variadic: bool, locations: *mut i64, pieces: *mut i64, kinds: *mut AbiClass, stack_size: i64,
    pushed: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let scratch: i64 = if get_x86() { 10 } else { 16 };
        let temp_int: i64 = if get_x86() { 11 } else { 17 };
        let temp_float: i64 = if get_x86() { 40 } else { 48 };
        let mut k: i64 = 0;
        for i in 0..count {
            let ty = (*arg_types.add(i as usize));
            if ty == 0 {
                continue;
            }
            let from = stack_size + 16 * (pushed - 1 - k);
            k += 1;
            let kind = (*kinds.add(i as usize));
            if kind == AbiClass::Pieces {
                abi_classify(cx, ty, pcx);
                m_load(cx, TY_U64, scratch, reg_sp(), from, pcx);
                for p in 0..cx.abi_piece_count {
                    let location = (*pieces.add((4 * i + p) as usize));
                    let piece_ty = cx.abi_piece_ty[p as usize];
                    let offset = cx.abi_piece_offset[p as usize];
                    if location < 16 {
                        m_load(cx, piece_ty, arg_reg(xl_from_c(location)), scratch, offset, pcx);
                    } else {
                        let temp = if is_float(piece_ty) { temp_float } else { temp_int };
                        m_load(cx, piece_ty, temp, scratch, offset, pcx);
                        m_store(cx, piece_ty, temp, reg_sp(), location - 16, pcx);
                    }
                }
                continue;
            }
            let location = (*locations.add(i as usize));
            if kind == AbiClass::Stack {
                // The aggregate's bytes, in 8-byte pieces (its copy is a
                // multiple of 8 bytes).
                m_load(cx, TY_U64, scratch, reg_sp(), from, pcx);
                let mut offset: i64 = 0;
                while offset < type_size(ty, pcx) {
                    m_load(cx, TY_U64, temp_int, scratch, offset, pcx);
                    m_store(cx, TY_U64, temp_int, reg_sp(), location - 16 + offset, pcx);
                    offset += 8;
                }
                continue;
            }
            let value_ty = if kind == AbiClass::Ref { TY_U64 } else { ty };
            let promote = variadic && i >= param_count;
            if location >= 16 {
                emit_stack_arg(cx, value_ty, from, location - 16, promote, pcx);
            } else {
                emit_load_arg_reg(cx, location, value_ty, from, promote, pcx);
            }
        }
    }
}

// Moves the pushed arguments into place, calls, and pops them. A compound
// result is in a new frame slot (through the result pointer, or stored
// from the result registers; RESULT_INTO's when set).
pub fn gen_call_sequence(cx: &mut FnCtx<Comp>, direct: i64, arg_types: *mut i64, count: i64,
    param_count: i64, variadic: bool, pushed: i64, ret: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut locations: [i64; 64] = [0i64; 64];
        let mut pieces: [i64; 256] = [0i64; 256];
        let mut kinds: [AbiClass; 64] = [AbiClass::Scalar; 64];
        let mut float_regs: i64 = 0;
        let stack_size = assign_arg_locations(cx, arg_types, count, param_count, variadic, ret,
            locations.as_mut_ptr() as *mut i64, pieces.as_mut_ptr() as *mut i64,
            kinds.as_mut_ptr() as *mut AbiClass, &mut float_regs, pcx);
        // An aggregate aligned above 16 copied onto the stack (x86-64) must be
        // aligned there: the pushed arguments move down so that the stack area
        // is, and sp is restored from a frame slot after the call.
        let mut over: i64 = 0;
        for i in 0..count {
            if kinds[i as usize] == AbiClass::Stack {
                let t = if (*arg_types.add(i as usize)) < 0 { 0 - (*arg_types.add(i as usize)) }
                    else { (*arg_types.add(i as usize)) };
                over = max_i64(over, type_align(t, pcx));
            }
        }
        let mut saved_sp: i64 = 0;
        if over > 16 && get_x86() {
            saved_sp = alloc_slot(8, 8, pcx);
            x64_realign_pushed(cx, pushed, stack_size, over, saved_sp);
        }
        if stack_size > 0 {
            emit_sp_sub(cx, stack_size);
        }
        place_args(cx, arg_types, count, param_count, variadic, locations.as_mut_ptr() as *mut i64,
            pieces.as_mut_ptr() as *mut i64, kinds.as_mut_ptr() as *mut AbiClass, stack_size,
            pushed, pcx);
        if direct < 0 {
            emit_load_callee(cx, stack_size);
        }
        let mut result_slot: i64 = 0;
        let through_pointer = returns_through_pointer(cx, ret, pcx);
        if is_compound(ret, pcx) {
            result_slot = if pcx.result_into != 0 { pcx.result_into }
                else { alloc_slot_for(ret, pcx) };
        }
        pcx.result_into = 0;
        if through_pointer {
            emit_frame_addr(cx, R_RESULT, result_slot, pcx);
        }
        if direct >= 0 {
            emit_call(cx, fn_symbol_prefix(direct, pcx), pcx.fns[direct as usize].name,
                pcx.fns[direct as usize].is_extern || pcx.fns[direct as usize].export, variadic,
                float_regs, pcx);
        } else {
            emit_call_indirect(cx);
        }
        if saved_sp != 0 {
            x64_restore_sp(cx, saved_sp);
            pcx.depth -= pushed;
        } else {
            emit_drop_temps_now(cx, stack_size, pushed, pcx);
        }
        if is_compound(ret, pcx) {
            if !through_pointer {
                abi_classify(cx, ret, pcx);
                emit_frame_addr(cx, R_ADDR, result_slot, pcx);
                let base: i64 = if get_x86() { 11 } else { 9 };
                for k in 0..cx.abi_piece_count {
                    let arg_v = cx.abi_piece_ty[k as usize];
                    let return_piece_reg_v = return_piece_reg(cx, k, pcx);
                    m_store(cx, arg_v, return_piece_reg_v, base,
                        cx.abi_piece_offset[k as usize], pcx);
                }
            }
            emit_frame_addr(cx, R_ACC, result_slot, pcx);
        } else if is_integer(scalar_type(ret, pcx)) || ret == TY_BOOL {
            emit_normalize(cx, if ret == TY_BOOL { TY_U8 } else { ret }, pcx);
        }
    }
}

fn emit_drop_temps_now(cx: &mut FnCtx<Comp>, stack_size: i64, pushed: i64, pcx: &mut Ctx<Comp>) {
    let total = stack_size + 16 * pushed;
    if total > 0 {
        emit_sp_add(cx, total);
    }
    pcx.depth -= pushed;
}
