static var FRAME_SIZE: i64 = 0;
static var RETURN_LABEL: i64 = 0;
// Frame slot holding the result pointer of a function returning a
// compound value.
static var RESULT_SLOT: i64 = 0;
static var CUR_FN: i64 = 0;
pub static var MAIN_SYM: i64 = 0;
// --emit-ir: print the optimized IR instead of assembly.
pub static var EMIT_IR: bool = false;
// --emit-mir: the IR after instruction selection (isel.vl).
pub static var EMIT_MIR: bool = false;

// Slots aligned above 16 (offset, alignment, size triples): the frame
// pointer is only 16-aligned, so their address is rounded up at run time,
// inside room left for it (see emit_frame_addr).
pub static var OVERALIGNED: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };

// A new frame slot; returns its offset below the frame pointer.
fn alloc_slot(size: i64, align: i64) -> i64 {
    var a = align;
    if a < 1 {
        a = 1;
    }
    if a > 16 {
        FRAME_SIZE = align_to(FRAME_SIZE + size + a - 16, 16);
        OVERALIGNED.push(FRAME_SIZE);
        OVERALIGNED.push(a);
        OVERALIGNED.push(size);
        return FRAME_SIZE;
    }
    FRAME_SIZE = align_to(FRAME_SIZE + size, a);
    FRAME_SIZE
}

// The slot aligned above 16 holding frame offset `offset` (the offset of
// a slot, or of a field inside one: `slot - field`), as its index in
// OVERALIGNED, or -1.
pub fn overaligned_slot(offset: i64) -> i64 {
    unsafe {
        var i = 0;
        while i < OVERALIGNED.count {
            let slot = OVERALIGNED.data[i];
            if offset <= slot && offset > slot - OVERALIGNED.data[i + 2] {
                return i;
            }
            i += 3;
        }
        -1
    }
}

// A frame slot for a value of type `ty`; compound values get a multiple
// of 8 bytes, so that they can be read and written in 8-byte pieces.
fn alloc_slot_for(ty: i64) -> i64 {
    let size = if is_compound(ty) { align_to(type_size(ty), 8) } else { type_size(ty) };
    alloc_slot(size, type_align(ty))
}

pub fn fn_symbol_prefix(f: i64) -> *u8 {
    if unsafe { FNS[f].is_extern || FNS[f].export || FNS[f].name == MAIN_SYM } { global_prefix() }
    else { function_prefix() }
}

// Whether function f has a global (C-visible) symbol.
pub fn fn_is_global(f: i64) -> bool {
    unsafe { FNS[f].name == MAIN_SYM || FNS[f].export }
}

pub fn static_symbol_prefix(s: i64) -> *u8 {
    if unsafe { STATICS[s].linkage != 0 } { global_prefix() } else { static_prefix() }
}

// (0.25.5) The statics the program's code names: gen_data leaves out a
// static nothing names (std's statics come with their section of std, its
// functions only with what the program calls). -O0's code generator marks
// each it addresses (emit_static_addr); at -O1 and -O2 the live functions'
// IR is read before the emission (statics_named_by_ir), and the emission
// checks that it names no other (back::emit::operands::materialize).
static var STATIC_NAMED: Vec<bool, Comp> = Vec::new_in(Comp {});

pub fn static_named(s: i64) {
    while STATIC_NAMED.len() as i64 <= s {
        STATIC_NAMED.push(false);
    }
    STATIC_NAMED[s] = true;
}

pub fn is_static_named(s: i64) -> bool {
    s < STATIC_NAMED.len() as i64 && STATIC_NAMED[s]
}

// -O1, -O2, before the emission: the statics the live functions' IR
// addresses (GADDR; at -O2 optimized, at -O1 every function's as
// lowered, which -O1's optimizer only takes from), and std::arch::detect's word, which
// instruction selection addresses later (back::isel::arch).
pub fn statics_named_by_ir(cx: sink *FnCtx) {
    // UNSAFE: the IR's tables (IRFUNCS, a function's blocks and
    // instructions in cx) and SYM_STATIC are the compiler's raw arrays.
    // SAFETY: fi < IRFUNC_COUNT; ir_enter makes cx's tables fi's, which
    // hold its blocks and their instruction lists (first, next: 0 ends);
    // a GADDR's imm is a static's symbol (materialize reads SYM_STATIC so),
    // and so is ARCH_WORD_SYM when not 0.
    unsafe {
        for fi in 0..IRFUNC_COUNT {
            // (-O1 optimizes each function as it emits it: every one
            // lowered, as its inlining may take any)
            if FN_LIVE[fi] == 0 && !PER_FUNCTION {
                continue;
            }
            ir_enter(cx, fi);
            for b in IRFUNCS[fi].blocks.items() {
                if cx.blocks[b].removed != 0 {
                    continue;
                }
                var v = cx.blocks[b].first;
                while v != 0 {
                    if cx.insts[v].op == Op::GAddr {
                        static_named(SYM_STATIC[cx.insts[v].imm] - 1);
                    }
                    v = cx.insts[v].next;
                }
            }
        }
        let word = crate::back::isel::arch::ARCH_WORD_SYM;
        if word > 0 && SYM_STATIC[word] > 0 {
            static_named(SYM_STATIC[word] - 1);
        }
    }
}

// ---- The program ----

pub fn compile_program(cx: sink *FnCtx, output: *u8) {
    unsafe {
        var t = timer_now();
        phase_time(0 as *u8);
        // (0.26.2) Both code generators read the places IR only, each
        // function's kept body (middle/lower/places.vl, gen0/gen/places.vl)
        if crate::places::PLACES_OFF {
            crate::base::die(
                c"--no-places: removed in 0.26.2 (the code generators read the places IR only)");
        }
        crate::places::keep::KEEP_BODIES = true;
        init_ast();
        ERR_KIND = c"parser error";
        let program = parse_program();
        // (0.18: test items only in test builds, front/tests; `check` sees them)
        crate::front::tests::drop_test_items(program);
        if IMPORTED_START >= 0 {
            drop_shadowed_imports(program);
        }
        timer_add(T_PARSE, t);
        t = timer_now();
        MAIN_SYM = intern_c(c"main");
        init_types();
        init_declarations();
        ERR_KIND = c"type error";
        check_program(program);
        timer_add(T_CHECK, t);
        flush_warnings();
        // (0.25.3) an executable needs fn main; the phases on a terminal
        crate::back::objfile::linkfail::require_main();
        build_checked();
        // (0.16)
        if PRINT_EFFECTS {
            let out = buf_new();
            print_effects(out);
            buf_write_fd(out, STDOUT);
        }
        if EMIT_HEADER {
            emit_c_header(program, output);
            return;
        }
        DATA = buf_new();
        phase_time(c"front end");
        build_compiling();
        if OPT_LEVEL > 0 || EMIT_IR {
            t = timer_now();
            lower_program(cx, program);
            // (0.16: the effects checked against the IR)
            if VERIFY_EFFECTS {
                verify_effects(cx);
            }
            // (0.10: profiles, on the IR as lowered)
            profile_after_lowering(cx);
            // (0.18: --coverage's counters, middle/coverage.vl)
            crate::middle::coverage::coverage_after_lowering(cx);
            // (0.17: --trace's frames)
            trace_after_lowering(cx);
            // (0.19: std::arch::detect's word: main fills it)
            crate::back::isel::arch::arch_after_lowering(cx);
            flush_warnings();
            timer_add(T_LOWER, t);
            phase_time(c"lowering");
            if TIME_PASSES {
                crate::middle::lower::places::lower_stats();
            }
            PER_FUNCTION = OPT_LEVEL == 1 && !EMIT_IR && !EMIT_MIR;
            if TIME_PASSES {
                T_IR_BYTES[0] = ir_tables_bytes(cx);
            }
            optimize_program(cx);
            // (0.18: --print-checks, tools/query/checks.vl)
            if crate::tools::query::checks::PRINT_CHECKS != 0 as *u8 {
                crate::tools::query::checks::print_checks();
                return;
            }
            if TIME_PASSES {
                T_IR_BYTES[1] = ir_tables_bytes(cx);
            }
            if EMIT_IR {
                for fi in 0..IRFUNC_COUNT {
                    if FN_LIVE[fi] != 0 {
                        ir_enter(cx, fi);
                        print_ir_func(cx, cx.asm, fi);
                    }
                }
                write_dump(cx.asm, output);
                parallel_end();
                return;
            }
            if EMIT_MIR {
                t = timer_now();
                select_instructions(cx);
                timer_add(T_ISEL, t);
                for fi in 0..IRFUNC_COUNT {
                    if FN_LIVE[fi] != 0 {
                        ir_enter(cx, fi);
                        print_ir_func(cx, cx.asm, fi);
                    }
                }
                write_dump(cx.asm, output);
                parallel_end();
                return;
            }
        }
        t = timer_now();
        emit_file_header(cx);
        asm_stream_begin();
        if OPT_LEVEL > 0 {
            timer_add(T_CODEGEN, t);
            // (0.25.5: the statics the code names; gen_data writes those)
            statics_named_by_ir(cx);
            // (0.17: each function selected, allocated and emitted, then
            // freed; at -O1 optimized there too)
            emit_ir_functions(cx);
            t = timer_now();
            print_stats();
        } else {
            // (0.18.1: the assembler on a thread of its own, beside the
            // code generation)
            let threaded = assembler_thread_wanted();
            if threaded {
                asm_thread_start();
            }
            // (0.26.1: from the kept bodies, gen0's places.vl, and the drop
            // shims those call; 0.26.2: only; an atomic intrinsic's body is its
            // instructions, gen_atomic_function)
            for item in kids(program) {
                if NODES[item].kind == Fn {
                    let f = NODES[item].x - 1;
                    if !places::gen_places_function(cx, item, f) {
                        if crate::middle::lower::atomic::atomic_intrinsic(f) < 0 {
                            crate::middle::lower::places::lower_stats();
                            crate::base::die(c"places: a function not generated from its body");
                        }
                        gen_atomic_function(cx, item);
                    }
                    if threaded {
                        asm_hand_over(cx);
                    } else {
                        asm_flush(cx);
                    }
                }
            }
            {
                for id in 0..crate::places::shim::shim_count() {
                    let f = crate::places::shim::shim_fn(id);
                    if f < 0 {
                        continue;
                    }
                    if !places::gen_places_function(cx, crate::places::front::fn_node(f), f) {
                        crate::middle::lower::places::lower_stats();
                        crate::base::die(c"places: a drop shim not generated from its body");
                    }
                    if threaded {
                        asm_hand_over(cx);
                    } else {
                        asm_flush(cx);
                    }
                }
            }
            if TIME_PASSES {
                crate::middle::lower::places::lower_stats();
            }
            if threaded {
                asm_thread_finish();
            }
        }
        timer_add(T_CODEGEN, t);
        t = timer_now();
        emit_runtime(cx);
        // (0.19: x86-64's cpuid and xgetbv, for std::arch::detect)
        crate::back::isel::arch::emit_arch_runtime(cx);
        dbg_text_end(cx);
        gen_data();
        buf_bytes(cx.asm, buf_slice(DATA));
        if DEBUG_INFO {
            let producer = buf_new();
            buf_fmt(producer, f"volec {cstr(version())}\0");
            dbg_sections(cx, out_path(0), BUFS[producer].data);
        }
        emit_file_trailer(cx);
        dbg_place_locs(cx);
        write_output(cx, output);
        // (0.18.1: the code cache's new entries, back::codecache)
        cc_end();
        timer_add(T_OUTPUT, t);
        phase_time(c"data and output");
        timer_report();
    }
}

// (0.18.1) An --emit-ir or --emit-mir dump: to stdout when the output is
// `-` (no -o given), else to the file.
fn write_dump(b: i64, output: *u8) {
    unsafe {
        if output[0] == '-' && output[1] == 0 {
            buf_write_fd(b, STDOUT);
        } else {
            buf_write_file(b, output);
        }
    }
}

fn gen_data() {
    unsafe {
        data_section(writable: false);
        for id in 0..STR_COUNT {
            data_string(id);
        }
        let scratch = buf_new();
        for s in 0..STATIC_COUNT {
            let item = STATICS[s].node;
            let ty = STATICS[s].ty;
            if STATICS[s].linkage == 1 {
                // Defined in C.
                continue;
            }
            // (0.25.5) one no code names (C can name it only when exported:
            // linkage 2)
            if STATICS[s].linkage == 0 && !is_static_named(s) {
                continue;
            }
            buf_clear(scratch);
            let init = NODES[item].c;
            if NODES[init].kind == CStr {
                // A C string (0.4): the address of its bytes. (In the
                // writable section: the address is relocated at load time.)
                data_section(writable: true);
                data_align(8);
                if STATICS[s].linkage == 2 {
                    buf_fmt(DATA, f".globl {cstr(global_prefix())}{SYMS[NODES[item].a].text}\n");
                }
                data_label(static_symbol_prefix(s), NODES[item].a);
                buf_fmt(DATA, f"    .quad {cstr(local_prefix())}str.{NODES[init].a}\n");
                continue;
            }
            const_emit(init, ty, scratch);
            // (with addresses in it, in the writable section: relocated at
            // load time)
            let relocs = CONST_RELOCS.count > 0;
            // (0.21: an atomic or a lock changes through a shared reference)
            let writable = STATICS[s].mutable || relocs || is_interior_type(ty);
            // (0.25.5: all zero, it takes no room in the object)
            if writable && !relocs && BUFS[scratch].len > 0 && all_zero(buf_slice(scratch)) {
                bss_section();
            } else {
                data_section(writable);
            }
            data_align(type_align(ty));
            if STATICS[s].linkage == 2 {
                buf_fmt(DATA, f".globl {cstr(global_prefix())}{SYMS[NODES[item].a].text}\n");
            }
            data_label(static_symbol_prefix(s), NODES[item].a);
            let bytes = buf_slice(scratch);
            var done = 0;
            var r = 0;
            while r < CONST_RELOCS.count {
                let at = CONST_RELOCS.data[r];
                data_bytes(bytes[done..at]);
                buf_fmt(DATA, f"    .quad {cstr(local_prefix())}str.{CONST_RELOCS.data[r + 1]}\n");
                done = at + 8;
                r += 2;
            }
            data_bytes(bytes[done..bytes.len as i64]);
            if BUFS[scratch].len == 0 {
                buf_str(DATA, c"    .space 1\n");
            }
        }
    }
}

// ---- Functions ----

// (0.21) An atomic intrinsic's function: its body is its instructions, on
// the argument registers (gen_atomic_body); the places IR has none.
fn gen_atomic_function(cx: sink *FnCtx, item: i64) {
    // UNSAFE: NODES and FNS are the checker's raw tables, cx the code
    // generator's raw context pointer.
    // SAFETY: item is a Fn node, f below FN_COUNT; cx points at
    // compile_program's live FnCtx; code generation is single-threaded.
    unsafe {
        let f = NODES[item].x - 1;
        CUR_FN = f;
        buf_clear(cx.code);
        DEPTH = 0;
        FRAME_SIZE = 0;
        OVERALIGNED.count = 0;
        RETURN_LABEL = new_label(cx);
        STMT_POS = -1;
        dbg_function_begin(cx, f, fn_symbol_prefix(f), NODES[item].start);
        emit_function_start(cx, fn_symbol_prefix(f), FNS[f].name, fn_is_global(f));
        RESULT_SLOT = 0;
        if returns_through_pointer(cx, FNS[f].ret) {
            RESULT_SLOT = alloc_slot(8, 8);
            emit_frame_addr(cx, R_ADDR, RESULT_SLOT);
            emit_store(cx, TY_U64, R_RESULT, R_ADDR);
        }
        gen_atomic_body(cx, f);
        gen_main_arch_init(cx, f);
        emit_label(cx, RETURN_LABEL);
        emit_epilogue(cx);
        emit_frame_reserve(cx, FRAME_SIZE);
        buf_bytes(cx.asm, buf_slice(cx.code));
        dbg_function_end(cx);
    }
}

// (0.19 T3) std::arch::detect's word, filled before main's body (f).
fn gen_main_arch_init(cx: sink *FnCtx, f: i64) {
    // UNSAFE: FNS is the checker's raw table of functions.
    // SAFETY: f is the function being generated and init std's (both below
    // FN_COUNT: arch_std_fn gives -1 when std has none).
    unsafe {
        if FNS[f].name == MAIN_SYM && crate::arch::ARCH_USED
            && crate::front::features::any_runtime_detect() {
            let init = crate::back::isel::arch::arch_std_fn(true);
            if init >= 0 {
                // (its argument: the build's features)
                emit_load_imm(cx, R_ACC, crate::arch::features::build_features() as u64);
                if X86 {
                    ins(cx, c"movq %rax, %rdi");
                }
                emit_call(cx, fn_symbol_prefix(init), FNS[init].name, false, false, 0);
            }
        }
    }
}

// (-g) The position of the statement being generated (-1: none).
static var STMT_POS: i64 = -1;

// (-g) Starts the code of the statement at `pos`.
fn stmt_loc(cx: sink *FnCtx, pos: i64) {
    STMT_POS = pos;
    unsafe { dbg_loc(cx.code, pos); }
}

// Stores the incoming parameters in their frame slots, in order (so a
// register is saved before another parameter's move can reuse it).
// Aggregates in registers are stored piece by piece; those passed by
// reference or on the stack are copied once every register is saved.
fn gen_params(cx: sink *FnCtx, item: i64, f: i64) {
    unsafe {
        var state: [i64; 3] = [first_int_arg(cx, FNS[f].ret), 0, 0];
        var pending: [i64; 64] = [0; 64];
        var pending_count = 0;
        var pieces: [i64; 4] = [0; 4];
        for i in 0..FNS[f].param_count {
            let ty = fn_param(f, i);
            if is_void(ty) {
                continue;
            }
            let kind = abi_classify(cx, ty);
            let local = NODES[child(item, i)].x;
            if kind == AbiClass::Pieces {
                abi_piece_locations(cx, ty, &state as *i64, &pieces as *i64);
                if local < 0 {
                    continue;
                }
                let slot = alloc_slot_for(ty);
                LOCALS[local].offset = slot;
                for k in 0..cx.abi_piece_count {
                    // On x86-64 a piece on the stack is copied as an integer of
                    // its size: through the float accumulator it would
                    // overwrite the first float argument register (xmm0),
                    // which a later parameter may still be in. Not on AArch64,
                    // whose int accumulator is x0, the first int argument
                    // register (an HFA on the stack, after the float registers
                    // ran out, may come before int parameters still in
                    // registers); its float registers are all taken by earlier
                    // parameters then.
                    var piece_ty = cx.abi_piece_ty[k];
                    if X86 && pieces[k] >= 16 && is_float(piece_ty) {
                        piece_ty = if piece_ty == TY_F32 { TY_U32 } else { TY_U64 };
                    }
                    emit_load_param(cx, pieces[k], piece_ty);
                    store_to_frame(cx, piece_ty, slot - cx.abi_piece_offset[k]);
                }
                continue;
            }
            var location = 0;
            if kind == AbiClass::Stack {
                location = abi_stack_location(ty, &state as *i64);
            } else {
                location = arg_location(if kind == AbiClass::Ref { TY_U64 } else { ty },
                    &state as *i64);
            }
            if local < 0 {
                continue;
            }
            let slot = alloc_slot_for(ty);
            LOCALS[local].offset = slot;
            if kind == AbiClass::Scalar {
                emit_load_param(cx, location, ty);
                emit_frame_addr(cx, R_ADDR, slot);
                emit_store(cx, ty, R_ACC, R_ADDR);
                continue;
            }
            // The accumulator = the address of the caller's copy.
            if kind == AbiClass::Stack {
                m_lea(cx, 0, reg_fp(), location);
            } else {
                emit_load_param(cx, location, TY_U64);
            }
            let pointer_slot = alloc_slot(8, 8);
            emit_frame_addr(cx, R_ADDR, pointer_slot);
            emit_store(cx, TY_U64, R_ACC, R_ADDR);
            pending[pending_count] = local;
            pending[pending_count + 1] = pointer_slot;
            pending_count += 2;
        }
        var i = 0;
        while i < pending_count {
            let local = pending[i];
            emit_frame_addr(cx, R_ADDR, pending[i + 1]);
            emit_load_reg(cx, R_ACC, R_ADDR);
            emit_frame_addr(cx, R_SECOND, LOCALS[local].offset);
            emit_copy(cx, type_size(LOCALS[local].ty));
            i += 2;
        }
    }
}

// The accumulator holds the function's result: hand it to the caller (in
// registers, or copied through the result pointer, which x86-64 also
// returns in rax).
fn gen_return_value(cx: sink *FnCtx, ret: i64) {
    unsafe {
        if !is_compound(ret) {
            return;
        }
        if returns_through_pointer(cx, ret) {
            emit_frame_addr(cx, R_ADDR, RESULT_SLOT);
            emit_load_reg(cx, R_SECOND, R_ADDR);
            emit_copy(cx, type_size(ret));
            if X86 {
                load_reg_from_frame(cx, R_ACC, RESULT_SLOT);
            }
            return;
        }
        let size = type_size(ret);
        if size % 8 != 0 {
            // Read in whole pieces from a copy of a multiple of 8 bytes.
            let copy = alloc_slot_for(ret);
            emit_frame_addr(cx, R_SECOND, copy);
            emit_copy(cx, size);
            emit_frame_addr(cx, R_ACC, copy);
        }
        abi_classify(cx, ret);
        // The address moves out of the accumulator (a result register).
        let base = if X86 { 11 } else { 16 };
        m_mov(cx, base, 0, TY_U64);
        for k in 0..cx.abi_piece_count {
            m_load(cx, cx.abi_piece_ty[k], return_piece_reg(cx, k), base, cx.abi_piece_offset[k]);
        }
    }
}

// ---- Statements ----

// Stores the accumulator (of type `ty`) in the frame slot at `offset`.
fn store_to_frame(cx: sink *FnCtx, ty: i64, offset: i64) {
    if is_void(ty) {
        return;
    }
    if is_compound(ty) {
        emit_frame_addr(cx, R_SECOND, offset);
        emit_copy(cx, type_size(ty));
        return;
    }
    emit_frame_addr(cx, R_ADDR, offset);
    emit_store(cx, ty, R_ACC, R_ADDR);
}

// ---- Values: the accumulator, temporaries, frame slots ----

// The accumulator holds the address of a value of type `ty`: load it if it
// is a scalar.
fn load_from_x0(cx: sink *FnCtx, ty: i64) {
    if !is_compound(ty) && !is_void(ty) {
        emit_load(cx, ty, R_ACC);
    }
}

// Moves the accumulator to the second operand and pops the first one into
// the accumulator.
fn pop_second_operand(cx: sink *FnCtx, ty: i64) {
    emit_move_to_second(cx, ty);
    if is_float(ty) {
        pop_d(cx, 0);
    } else {
        pop_x(cx, R_ACC);
    }
}

// The 8 bytes of frame slot `offset` = <reg> (R_ADDR keeps the address).
fn store_reg_to_frame(cx: sink *FnCtx, reg: i64, offset: i64) {
    emit_frame_addr(cx, R_ADDR, offset);
    emit_store(cx, TY_U64, reg, R_ADDR);
}

// <reg> = the 8 bytes of frame slot `offset` (R_ADDR keeps the address).
fn load_reg_from_frame(cx: sink *FnCtx, reg: i64, offset: i64) {
    emit_frame_addr(cx, R_ADDR, offset);
    emit_load_reg(cx, reg, R_ADDR);
}
