// The intrinsic tables' parser (0.19): tables.vl's lines into IntrInfo
// (mod.vl), on the first use, once; and the instruction tables
// (insn_a64.def, insn_x86.def) the assemblers read for the mnemonics they
// do not know themselves. compiler/arch/README.md gives the formats; a
// malformed line is an internal error (the tables are the compiler's).

use crate::arch::{
    ARCH_AARCH64, ARCH_PORTABLE, ARCH_X86_64, FEAT_DETECT, FEAT_HAS, FIELD_COUNT, FORM_BITS,
    FORM_CAST, FORM_FEAT, FORM_HINT, FORM_INTR, FORM_INTR_MEM, FORM_LOAD, FORM_LOAD_DUP, FORM_STORE,
    FORM_VBIN, FORM_VCMP, FORM_VEXT, FORM_VINS, FORM_VNEG, FORM_VSEL, FORM_VSPLAT, FORM_VSUM,
    F_FEATURES, F_FLAGS, F_FORM, F_MEMORY, F_NAME, F_SIGNATURE, IF_COMMUTATIVE, IF_PURE,
    IF_TIED_SHIFT, IntrInfo, MEM_LOAD, MEM_NONE, MEM_RAW, MEM_STORE, init_name_table, intr_text,
};
use crate::arch::features::feature_bit_in;
use crate::arch::tables::{insn_a64_source, insn_x86_source, intrinsics_source};
use crate::back::objfile::{NameMap, name_get, name_put};
use crate::base::{BUFS, IntVec, buf_new, die, grow, intern};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::X86;
use crate::middle::ir::{BITS_LEADING, BITS_ONES, BITS_TRAILING, Cond, Op};

const PARAM_WIDTH: i64 = 5;

extern "C" {
    fn memchr(s: *u8, c: i32, n: u64) -> *u8;
}

pub fn param_entry(p: i64, k: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe { pcx.params.data[p * PARAM_WIDTH + k] }
}

// The type text of parameter p (an index as IntrInfo.params + k).
pub fn param_type_text(p: i64, pcx: Ctx<Comp>) -> [u8] {
    unsafe { BUFS[pcx.table_buf].data[param_entry(p, 1, pcx)..param_entry(p, 2, pcx)] }
}

fn byte(i: i64, pcx: Ctx<Comp>) -> u8 {
    unsafe { pcx.table_text[i] }
}

fn text(a: i64, b: i64, pcx: Ctx<Comp>) -> [u8] {
    unsafe { BUFS[pcx.table_buf].data[a..b] }
}

fn is(a: i64, b: i64, word: [u8], pcx: Ctx<Comp>) -> bool {
    if b - a != word.len as i64 {
        return false;
    }
    for i in 0..b - a {
        if byte(a + i, pcx) != word[i] {
            return false;
        }
    }
    true
}

fn starts(a: i64, b: i64, word: [u8], pcx: Ctx<Comp>) -> bool {
    b - a >= word.len as i64 && is(a, a + word.len as i64, word, pcx)
}

fn bad(what: *u8) -> ! {
    die(what);
}

// An integer at [a, b), decimal (with a sign) or 0x hexadecimal.
fn number(a: i64, b: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe { number_in(a, b, pcx) }
}

unsafe fn number_in(a: i64, b: i64, pcx: Ctx<Comp>) -> i64 {
    var i = a;
    var negative = false;
    if i < b && byte(i, pcx) == '-' {
        negative = true;
        i += 1;
    }
    var v = 0;
    if b - i > 2 && byte(i, pcx) == '0' && byte(i + 1, pcx) == 'x' {
        i += 2;
        while i < b {
            let c = byte(i, pcx);
            let d = if c >= '0' && c <= '9' { (c - '0') as i64 }
                else if c >= 'a' && c <= 'f' { (c - 'a') as i64 + 10 }
                else { bad(c"internal error: arch table: bad hexadecimal number") };
            v = v * 16 + d;
            i += 1;
        }
    } else {
        while i < b {
            let c = byte(i, pcx);
            if c < '0' || c > '9' {
                bad(c"internal error: arch table: bad number");
            }
            v = v * 10 + (c - '0') as i64;
            i += 1;
        }
    }
    if negative { -v } else { v }
}

fn trim_start(a: i64, b: i64, pcx: Ctx<Comp>) -> i64 {
    var i = a;
    while i < b && byte(i, pcx) == ' ' {
        i += 1;
    }
    i
}

fn trim_end(a: i64, b: i64, pcx: Ctx<Comp>) -> i64 {
    var i = b;
    while i > a && byte(i - 1, pcx) == ' ' {
        i -= 1;
    }
    i
}

// Splits the line [a, b) at " | " into FIELDS (want fields); false when it
// has another count. (0.25: the '|'s found by memchr)
fn split_fields(a: i64, b: i64, want: i64, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        let t = pcx.table_text;
        var start = a;
        var n = 0;
        while true {
            // (the next " | " from start, else b)
            var sep = b;
            var q = start + 1;
            while q + 1 < b {
                let bar = memchr(&t[q], '|' as i32, (b - 1 - q) as u64);
                if bar == 0 as *u8 {
                    break;
                }
                q += bar as i64 - (&t[q]) as i64;
                if t[q - 1] == ' ' && t[q + 1] == ' ' {
                    sep = q - 1;
                    break;
                }
                q += 1;
            }
            pcx.table_fields.push(trim_start(start, sep, pcx));
            pcx.table_fields.push(trim_end(start, sep, pcx));
            n += 1;
            if sep == b {
                break;
            }
            start = sep + 3;
        }
        n == want
    }
}

// The table, parsed on the first call.
pub fn load_table(pcx: inout Ctx<Comp>) {
    unsafe {
        if pcx.table_buf >= 0 {
            return;
        }
        pcx.table_buf = buf_new();
        intrinsics_source(pcx.table_buf);
        init_name_table(&pcx);
        let len = BUFS[pcx.table_buf].len;
        let t = BUFS[pcx.table_buf].data;
        pcx.table_text = t;
        var arch = ARCH_PORTABLE;
        var a = 0;
        while a < len {
            // (the end of the line, by memchr)
            let nl = memchr(&t[a], '\n' as i32, (len - a) as u64);
            let b = if nl == 0 as *u8 { len } else { a + (nl as i64 - (&t[a]) as i64) };
            if byte(a, pcx) == '=' {
                arch = if is(a + 2, b, "aarch64", pcx) { ARCH_AARCH64 }
                    else if is(a + 2, b, "x86_64", pcx) { ARCH_X86_64 } else { ARCH_PORTABLE };
            } else {
                parse_intrinsic(a, b, arch, &pcx);
            }
            a = b + 1;
        }
        crate::arch::template::reserve_slot_names();
        for id in 0..pcx.intr_count {
            if pcx.intrs[id].form == FORM_INTR_MEM {
                link_parts(id, &pcx);
            }
        }
    }
}

// (T6) The two permutes an `intr.mem` intrinsic is made of at -O1 and -O2:
// vld2q_T (a deinterleaving load) is two vector loads, then vuzp1q_T and
// vuzp2q_T; vst2q_T is vzip1q_T and vzip2q_T, then two vector stores.
// Their ids in part1 and part2 (made while the table is parsed: no symbol
// is made later).
fn link_parts(id: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let name = intr_text(id, F_NAME, pcx);
        let load = name.len > 6 && name[0..6] == "vld2q_";
        let store = name.len > 6 && name[0..6] == "vst2q_";
        if !load && !store {
            bad(c"internal error: arch table: an intr.mem intrinsic lowering does not know");
        }
        var tmp: [u8; 48] = [0; 48];
        let rest = name.len as i64 - 6;
        if rest > 40 {
            bad(c"internal error: arch table: a name too long");
        }
        for k in 0..2 {
            let head = if load { "vuzp" } else { "vzip" };
            for j in 0..4 {
                tmp[j] = head[j];
            }
            tmp[4] = if k == 0 { '1' } else { '2' };
            tmp[5] = 'q';
            tmp[6] = '_';
            for j in 0..rest {
                tmp[7 + j] = name[6 + j];
            }
            let part = pcx.intr_by_name[intern(tmp[0..7 + rest])] - 1;
            if part < 0 {
                bad(c"internal error: arch table: an intr.mem intrinsic without its permutes");
            }
            if k == 0 {
                pcx.intrs[id].part1 = part;
            } else {
                pcx.intrs[id].part2 = part;
            }
        }
    }
}

fn field_start(base: i64, f: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe { pcx.table_fields.data[base + 2 * f] }
}

fn field_end(base: i64, f: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe { pcx.table_fields.data[base + 2 * f + 1] }
}

fn parse_intrinsic(a: i64, b: i64, arch: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let base = pcx.table_fields.count;
        if !split_fields(a, b, FIELD_COUNT, &pcx) {
            bad(c"internal error: arch table: a line without its 11 columns");
        }
        let id = pcx.intr_count;
        pcx.intrs = grow(pcx.intrs, pcx.intr_count, &pcx.intr_cap);
        pcx.intr_count += 1;
        let name = intern(text(field_start(base, F_NAME, pcx), field_end(base, F_NAME, pcx), pcx));
        pcx.intrs[id] = IntrInfo {
            name, arch, features: 0, form: 0, form_arg: 0, work: 0,
            params: pcx.params.count / PARAM_WIDTH,
            nparams: 0, ret_start: 0, ret_end: 0, consts: 0, flags: 0, mem: MEM_NONE, mem_param: -1,
            mem_bytes: 0, fields: base, part1: -1, part2: -1,
        };
        if pcx.intr_by_name[name] != 0 {
            bad(c"internal error: arch table: an intrinsic named twice");
        }
        pcx.intr_by_name[name] = id + 1;
        parse_features(id, field_start(base, F_FEATURES, pcx), field_end(base, F_FEATURES, pcx),
            arch, &pcx);
        parse_signature(id, field_start(base, F_SIGNATURE, pcx), field_end(base, F_SIGNATURE, pcx),
            &pcx);
        parse_form(id, field_start(base, F_FORM, pcx), field_end(base, F_FORM, pcx), &pcx);
        parse_flags(id, field_start(base, F_FLAGS, pcx), field_end(base, F_FLAGS, pcx), &pcx);
        parse_memory(id, field_start(base, F_MEMORY, pcx), field_end(base, F_MEMORY, pcx), &pcx);
    }
}

// `neon`, `crc`, `sse4.2`, comma-separated; `-`: none.
fn parse_features(id: i64, a: i64, b: i64, arch: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if is(a, b, "-", pcx) {
            return;
        }
        var i = a;
        while i < b {
            var j = i;
            while j < b && byte(j, pcx) != ',' {
                j += 1;
            }
            let bit = feature_bit_in(text(trim_start(i, j, pcx), trim_end(i, j, pcx), pcx), arch);
            if bit < 0 {
                bad(c"internal error: arch table: an unknown feature");
            }
            pcx.intrs[id].features |= 1 << bit as u64;
            i = j + 1;
        }
    }
}

// `(a: T, n: const LO..=HI) -> R` or `(s: [u8], i: i64, v: T)`.
fn parse_signature(id: i64, a: i64, b: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if a >= b || byte(a, pcx) != '(' {
            bad(c"internal error: arch table: a signature without '('");
        }
        var close = a;
        while close < b && byte(close, pcx) != ')' {
            close += 1;
        }
        if close >= b {
            bad(c"internal error: arch table: a signature without ')'");
        }
        var i = a + 1;
        var k = 0;
        while i < close {
            var j = i;
            var depth = 0;
            while j < close && !(byte(j, pcx) == ',' && depth == 0) {
                if byte(j, pcx) == '[' || byte(j, pcx) == '(' {
                    depth += 1;
                } else if byte(j, pcx) == ']' || byte(j, pcx) == ')' {
                    depth -= 1;
                }
                j += 1;
            }
            let s = trim_start(i, j, pcx);
            let e = trim_end(i, j, pcx);
            var colon = s;
            while colon < e && byte(colon, pcx) != ':' {
                colon += 1;
            }
            if colon >= e {
                bad(c"internal error: arch table: a parameter without its type");
            }
            let ts = trim_start(colon + 1, e, pcx);
            pcx.params.push(intern(text(s, colon, pcx)));
            if starts(ts, e, "const ", pcx) {
                // `const LO..=HI`
                let r = trim_start(ts + 6, e, pcx);
                var dots = r;
                while dots + 2 < e && !(byte(dots, pcx) == '.' && byte(dots + 1, pcx) == '.') {
                    dots += 1;
                }
                if dots + 2 >= e || byte(dots + 2, pcx) != '=' {
                    bad(c"internal error: arch table: an immediate without LO..=HI");
                }
                pcx.params.push(ts);
                pcx.params.push(ts);
                pcx.params.push(number(r, dots, pcx));
                pcx.params.push(number(dots + 3, e, pcx));
                pcx.intrs[id].consts |= 1 << k as u64;
            } else {
                pcx.params.push(ts);
                pcx.params.push(e);
                pcx.params.push(1);
                pcx.params.push(0);
            }
            k += 1;
            i = j + 1;
        }
        pcx.intrs[id].nparams = k;
        let r = trim_start(close + 1, b, pcx);
        if starts(r, b, "->", pcx) {
            pcx.intrs[id].ret_start = trim_start(r + 2, b, pcx);
            pcx.intrs[id].ret_end = b;
        } else {
            pcx.intrs[id].ret_start = b;
            pcx.intrs[id].ret_end = b;
        }
    }
}

// `intr`, `load`, `vbin.add`, `vcmp.eq:v16i8`, `bits.ones`, `feat.has` ...
fn parse_form(id: i64, a: i64, b: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        var e = a;
        while e < b && byte(e, pcx) != ':' {
            e += 1;
        }
        if e < b {
            pcx.intrs[id].work = intern(text(e + 1, b, pcx));
        }
        var dot = a;
        while dot < e && byte(dot, pcx) != '.' {
            dot += 1;
        }
        let arg_start = if dot < e { dot + 1 } else { e };
        var form = 0;
        var arg = 0;
        if is(a, e, "intr", pcx) { form = FORM_INTR; }
        else if is(a, e, "intr.mem", pcx) { form = FORM_INTR_MEM; }
        else if is(a, e, "load", pcx) { form = FORM_LOAD; }
        else if is(a, e, "store", pcx) { form = FORM_STORE; }
        else if is(a, e, "cast", pcx) { form = FORM_CAST; }
        else if is(a, e, "vsplat", pcx) { form = FORM_VSPLAT; }
        else if is(a, e, "vext", pcx) { form = FORM_VEXT; }
        else if is(a, e, "hint", pcx) { form = FORM_HINT; }
        else if is(a, e, "vneg", pcx) { form = FORM_VNEG; }
        else if is(a, e, "vins", pcx) { form = FORM_VINS; }
        else if is(a, e, "vsel", pcx) { form = FORM_VSEL; }
        else if is(a, e, "vsum", pcx) { form = FORM_VSUM; }
        else if is(a, e, "load.dup", pcx) { form = FORM_LOAD_DUP; }
        else if is(a, dot, "vbin", pcx) {
            form = FORM_VBIN;
            arg = if is(arg_start, e, "add", pcx) { Op::Add as i64 }
                else if is(arg_start, e, "sub", pcx) { Op::Sub as i64 }
                else if is(arg_start, e, "mul", pcx) { Op::Mul as i64 }
                else if is(arg_start, e, "and", pcx) { Op::And as i64 }
                else if is(arg_start, e, "or", pcx) { Op::Or as i64 }
                else if is(arg_start, e, "xor", pcx) { Op::Xor as i64 }
                else if is(arg_start, e, "div", pcx) { Op::Div as i64 }
                else { bad(c"internal error: arch table: an unknown vbin") };
        } else if is(a, dot, "vcmp", pcx) {
            form = FORM_VCMP;
            arg = if is(arg_start, e, "eq", pcx) { Cond::Eq as i64 }
                else if is(arg_start, e, "gt", pcx) { Cond::Gt as i64 }
                else if is(arg_start, e, "ge", pcx) { Cond::Ge as i64 }
                else if is(arg_start, e, "lt", pcx) { Cond::Lt as i64 }
                else if is(arg_start, e, "le", pcx) { Cond::Le as i64 }
                else { bad(c"internal error: arch table: an unknown vcmp") };
        } else if is(a, dot, "bits", pcx) {
            form = FORM_BITS;
            arg = if is(arg_start, e, "ones", pcx) { BITS_ONES }
                else if is(arg_start, e, "leading", pcx) { BITS_LEADING }
                else if is(arg_start, e, "trailing", pcx) { BITS_TRAILING }
                else { bad(c"internal error: arch table: an unknown bits count") };
        } else if is(a, dot, "feat", pcx) {
            form = FORM_FEAT;
            arg = if is(arg_start, e, "has", pcx) { FEAT_HAS }
                else if is(arg_start, e, "detect", pcx) { FEAT_DETECT }
                else { bad(c"internal error: arch table: an unknown feat") };
        } else {
            bad(c"internal error: arch table: an unknown IR form");
        }
        pcx.intrs[id].form = form;
        pcx.intrs[id].form_arg = arg;
    }
}

// The index of parameter `name` of intrinsic id, or -1.
fn param_index(id: i64, a: i64, b: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let name = intern(text(a, b, pcx));
        for k in 0..pcx.intrs[id].nparams {
            if param_entry(pcx.intrs[id].params + k, 0, pcx) == name {
                return k;
            }
        }
        -1
    }
}

// `pure commutative tied=a`, space-separated; `-`: none.
fn parse_flags(id: i64, a: i64, b: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        var i = a;
        while i < b {
            var j = i;
            while j < b && byte(j, pcx) != ' ' {
                j += 1;
            }
            if is(i, j, "pure", pcx) {
                pcx.intrs[id].flags |= IF_PURE;
            } else if is(i, j, "commutative", pcx) {
                pcx.intrs[id].flags |= IF_COMMUTATIVE;
            } else if starts(i, j, "tied=", pcx) {
                let k = param_index(id, i + 5, j, pcx);
                if k < 0 {
                    bad(c"internal error: arch table: tied to an unknown parameter");
                }
                pcx.intrs[id].flags |= (k + 1) << IF_TIED_SHIFT as u64;
            } else if !is(i, j, "-", pcx) {
                bad(c"internal error: arch table: an unknown flag");
            }
            i = trim_start(j, b, pcx);
        }
    }
}

// `none`, `raw`, `load(s, 16)`, `store(s, 16)`.
fn parse_memory(id: i64, a: i64, b: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if is(a, b, "none", pcx) || is(a, b, "-", pcx) {
            return;
        }
        if is(a, b, "raw", pcx) {
            pcx.intrs[id].mem = MEM_RAW;
            return;
        }
        let load = starts(a, b, "load(", pcx);
        if !load && !starts(a, b, "store(", pcx) {
            bad(c"internal error: arch table: an unknown memory column");
        }
        let open = if load { a + 5 } else { a + 6 };
        var comma = open;
        while comma < b && byte(comma, pcx) != ',' {
            comma += 1;
        }
        let k = param_index(id, open, comma, pcx);
        if k < 0 || comma >= b || byte(b - 1, pcx) != ')' {
            bad(c"internal error: arch table: a memory column without its slice");
        }
        pcx.intrs[id].mem = if load { MEM_LOAD } else { MEM_STORE };
        pcx.intrs[id].mem_param = k;
        pcx.intrs[id].mem_bytes = number(trim_start(comma + 1, b - 1, pcx), b - 1, pcx);
    }
}

// ---- The instruction tables ----
//
// insn_a64.def: mnemonic | class | bits | syntax; insn_x86.def: mnemonic |
// class | prefix | map | opcode | flags. By mnemonic (a NameMap, as the
// assembler's own tables: it reads nothing the rest of the compiler grows
// while it runs on a thread): index + 1, the lines' fields in INSN_FIELDS
// (INSN_WIDTH each). Loaded by the front end (load_insns, from
// virtual.vl) when a program names std::arch; read-only after.

static var INSN_BUF: i64 = -1;
static var INSN_BY_NAME: NameMap = NameMap {
    ptrs: 0 as *i64, lens: 0 as *i64, vals: 0 as *i64, size: 0, count: 0,
};
static var INSN_FIELDS: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
const INSN_WIDTH: i64 = 12;

fn insn_byte(i: i64) -> u8 {
    unsafe { BUFS[INSN_BUF].data[i] }
}

pub fn load_insns() {
    unsafe {
        if INSN_BUF >= 0 {
            return;
        }
        // (the target's table only: the two architectures share mnemonics,
        // crc32b among them; set_target runs before the modules load)
        INSN_BUF = buf_new();
        if X86 {
            insn_x86_source(INSN_BUF);
        } else {
            insn_a64_source(INSN_BUF);
        }
        let len = BUFS[INSN_BUF].len;
        var a = 0;
        while a < len {
            var b = a;
            while b < len && insn_byte(b) != '\n' {
                b += 1;
            }
            let base = INSN_FIELDS.count;
            var start = a;
            var n = 0;
            var i = a;
            while i <= b && n < INSN_WIDTH / 2 {
                let at_sep = i + 2 < b && insn_byte(i) == ' ' && insn_byte(i + 1) == '|'
                    && insn_byte(i + 2) == ' ';
                if i == b || at_sep {
                    var s = start;
                    while s < i && insn_byte(s) == ' ' {
                        s += 1;
                    }
                    var e = i;
                    while e > s && insn_byte(e - 1) == ' ' {
                        e -= 1;
                    }
                    INSN_FIELDS.push(s);
                    INSN_FIELDS.push(e);
                    n += 1;
                    if i == b {
                        break;
                    }
                    i += 3;
                    start = i;
                    continue;
                }
                i += 1;
            }
            while n < INSN_WIDTH / 2 {
                INSN_FIELDS.push(b);
                INSN_FIELDS.push(b);
                n += 1;
            }
            // (a mnemonic of several lines: its first, the encoder tries the
            // next ones)
            let mn = BUFS[INSN_BUF].data[INSN_FIELDS.data[base]..INSN_FIELDS.data[base + 1]];
            if name_get(INSN_BY_NAME, mn) == 0 {
                name_put(&INSN_BY_NAME, mn, base / INSN_WIDTH + 1);
            }
            a = b + 1;
        }
    }
}

// The line of mnemonic `name` in the instruction tables, or -1 (also
// before the front end loaded them: no program named std::arch).
pub fn insn_named(name: [u8]) -> i64 {
    if INSN_BUF < 0 {
        return -1;
    }
    name_get(INSN_BY_NAME, name) - 1
}

// Field f of instruction line k, as text.
pub fn insn_text(k: i64, f: i64) -> [u8] {
    unsafe {
        // (past the last line: no mnemonic, which ends a run of lines)
        if k < 0 || (k + 1) * INSN_WIDTH > INSN_FIELDS.count {
            return "";
        }
        let s = INSN_FIELDS.data[k * INSN_WIDTH + 2 * f];
        let e = INSN_FIELDS.data[k * INSN_WIDTH + 2 * f + 1];
        BUFS[INSN_BUF].data[s..e]
    }
}

// Field f of instruction line k as a hexadecimal number (`0x2e202c00`,
// `66`, `0f38`), 0 for `-`.
pub fn insn_hex(k: i64, f: i64) -> i64 {
    let t = insn_text(k, f);
    var i = 0;
    if t.len >= 2 && t[0] == '0' && t[1] == 'x' {
        i = 2;
    }
    var v = 0;
    while i < t.len as i64 {
        let c = t[i];
        if c >= '0' && c <= '9' {
            v = v * 16 + (c - '0') as i64;
        } else if c >= 'a' && c <= 'f' {
            v = v * 16 + (c - 'a') as i64 + 10;
        } else {
            return v;
        }
        i += 1;
    }
    v
}
