// The virtual modules std::arch, std::arch::aarch64 and std::arch::x86_64
// (0.19, docs/design/arch.md §2.1). When a program names `arch` (and std),
// the loader (front/modules: load_modules) calls load_arch_modules, which
// makes the three modules with a source each: the vendor types of the
// architecture's module (ACLE's as aliases of the portable vectors,
// Intel's __m128i ... as aliases of distinct opaque types), and one
// declaration per intrinsic the program's tokens name, nothing else:
//
//     #[intrinsic(ID)]
//     pub fn vqsubq_u8(a: uint8x16_t, b: uint8x16_t) -> uint8x16_t;
//
// A declaration has no body (the parser takes `;` after #[intrinsic]); a
// `bits.*` intrinsic has std's function of its count as its body, which a
// target without the instruction calls. Their sources are `<std::arch>`,
// `<std::arch::aarch64>` and `<std::arch::x86_64>`; each architecture's
// `raw` submodule holds the pointer forms of its memory intrinsics, unsafe
// (`raw::vld1q_u8(p: *u8)`, raw_declaration).

use crate::arch::{
    ARCH_AARCH64, ARCH_PORTABLE, ARCH_X86_64, FORM_BITS, MEM_LOAD, MEM_STORE, intr_param_is_const,
    intr_param_name, intr_ret_text, intrinsic_named,
};
use crate::arch::table::{load_insns, load_table, param_type_text};
use crate::base::{add_source, buf_bytes, buf_int, buf_new, buf_str, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::lexer::{Tok, lex_range};
use crate::front::modules::{add_module, module_at, within_std};
use crate::middle::ir::{BITS_LEADING, BITS_ONES};
use crate::middle::lower::ssa::HMap;

// Whether position pos is in a virtual module's source.
pub fn in_arch_source(pos: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.arch_src_start >= 0 && pos >= pcx.arch_src_start && pos < pcx.arch_src_end
}

// The modules, when the program names `arch` and std; once.
pub fn load_arch_modules(pcx: &mut Ctx<Comp>) {
    if pcx.std_module < 0 || pcx.arch_module >= 0 {
        return;
    }
    let arch = intern_c(c"arch", pcx);
    // (0.19 T3: #[multiversion] needs std::arch::detect for its dispatcher)
    let multiversion = intern_c(c"multiversion", pcx);
    let std_sym = intern_c(c"std", pcx);
    let mut named = false;
    let mut versions = false;
    let mut imported = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
    // (0.25) `in_use`: between a `use` and its `;`; an alias of std
    // (`use std as s`) makes `s::arch` std's
    let mut mark: i64 = -1;
    let mut in_use = false;
    let mut use_from_std = false;
    let mut std_aliased = false;
    let mut arch_in_path = false;
    for i in 0..pcx.toks.len() as i64 {
        let kind = pcx.toks[i as usize].kind;
        if kind == Tok::Ident {
            let sym = pcx.toks[i as usize].value as i64;
            if sym == multiversion && i >= 2 && pcx.toks[(i - 1) as usize].kind == Tok::LBracket
                && pcx.toks[(i - 2) as usize].kind == Tok::Hash {
                versions = true;
                named = true;
            }
            if sym == arch {
                if !within_std(module_at(pcx.toks[i as usize].start, pcx), pcx) {
                    // (0.25) the program's own `crate::arch` is not std's
                    if arch_names_std(i, std_sym, in_use, pcx) {
                        named = true;
                    } else if i >= 1 && pcx.toks[(i - 1) as usize].kind == Tok::ColonColon {
                        arch_in_path = true;
                    }
                } else if !in_std_use_line(mark, i, pcx) {
                    named = true;
                } else {
                    // (0.21) a `use std::arch::..` line of std's (std::str's,
                    // std::collections::group's headers, always read): the
                    // names it imports
                    let mut j = i + 1;
                    while j < pcx.toks.len() as i64 && pcx.toks[j as usize].kind != Tok::Semi {
                        if pcx.toks[j as usize].kind == Tok::Ident {
                            imported.put(pcx.toks[j as usize].value as i64 + 1, 1);
                        }
                        j += 1;
                    }
                }
            }
            if in_use && pcx.toks[(i - 1) as usize].kind == Tok::Use {
                use_from_std = sym == std_sym;
            }
        } else if kind == Tok::As && in_use && use_from_std
            && !within_std(module_at(pcx.toks[i as usize].start, pcx), pcx) {
            std_aliased = true;
        } else if kind == Tok::Use {
            in_use = true;
            use_from_std = false;
        } else if kind == Tok::Semi {
            in_use = false;
        }
        if kind == Tok::Use {
            mark = 2 * i + 1;
        } else if kind == Tok::Semi || kind == Tok::RBrace {
            mark = 2 * i;
        }
    }
    if std_aliased && arch_in_path {
        named = true;
    }
    // (0.21) std names the modules only when the sections read use what
    // its `use` lines import: the tables cost more than a small
    // program's compilation
    if !named && imported.count > 0 {
        mark = -1;
        for i in 0..pcx.toks.len() as i64 {
            let k = pcx.toks[i as usize].kind;
            if k == Tok::Ident {
                if imported.get(pcx.toks[i as usize].value as i64 + 1) != 0
                    && !in_std_use_line(mark, i, pcx) {
                    named = true;
                    break;
                }
            } else if k == Tok::Use {
                mark = 2 * i + 1;
            } else if k == Tok::Semi || k == Tok::RBrace {
                mark = 2 * i;
            }
        }
    }
    if !named && pcx.query_wanted.len() as i64 == 0 {
        if imported.count > 0 {
            // (0.21) the modules, empty, for std's `use` lines: an import of
            // std's that finds nothing imports nothing (front/modules/lookup)
            pcx.arch_module = add_module(arch, pcx.std_module, true, pcx);
            pcx.a64_module = add_module(intern_c(c"aarch64", pcx), pcx.arch_module, true,
                pcx);
            pcx.x86_module = add_module(intern_c(c"x86_64", pcx), pcx.arch_module, true, pcx);
        }
        return;
    }
    pcx.arch_used = true;
    load_table(pcx);
    // (the assemblers' tables too: read-only once codegen starts)
    load_insns();
    // The intrinsics the tokens name, each once.
    let mut wanted: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut seen: Vec<i64, Comp> = Vec::new_in(Comp {});
    for _ in 0..pcx.intrs.len() as i64 {
        seen.push(0);
    }
    mark = -1;
    for i in 0..pcx.toks.len() as i64 {
        let k = pcx.toks[i as usize].kind;
        if k == Tok::Ident {
            let id = intrinsic_named(pcx.toks[i as usize].value as i64, pcx);
            if id >= 0 && (seen[id as usize]) == 0 && !in_std_use_line(mark, i, pcx) {
                (seen[id as usize]) = 1;
                wanted.push(id);
            }
        } else if k == Tok::Use {
            mark = 2 * i + 1;
        } else if k == Tok::Semi || k == Tok::RBrace {
            mark = 2 * i;
        }
    }
    for k in 0..pcx.query_wanted.len() as i64 {
        let id = intrinsic_named(intern_c((pcx.query_wanted[k as usize]) as *mut u8,
            pcx), pcx);
        if id >= 0 && (seen[id as usize]) == 0 {
            (seen[id as usize]) = 1;
            wanted.push(id);
        }
    }
    if versions {
        let id = intrinsic_named(intern_c(c"detect", pcx), pcx);
        if id >= 0 && (seen[id as usize]) == 0 {
            (seen[id as usize]) = 1;
            wanted.push(id);
        }
    }
    pcx.arch_module = add_module(arch, pcx.std_module, true, pcx);
    pcx.a64_module = add_module(intern_c(c"aarch64", pcx), pcx.arch_module, true, pcx);
    pcx.x86_module = add_module(intern_c(c"x86_64", pcx), pcx.arch_module, true, pcx);
    let raw = intern_c(c"raw", pcx);
    let a64_raw = add_module(raw, pcx.a64_module, true, pcx);
    let x86_raw = add_module(raw, pcx.x86_module, true, pcx);
    let first = add_arch_source(c"<std::arch>", pcx.arch_module, ARCH_PORTABLE, &mut wanted,
        false, pcx);
    pcx.arch_src_start = first;
    add_arch_source(c"<std::arch::aarch64>", pcx.a64_module, ARCH_AARCH64, &mut wanted, false,
        pcx);
    add_arch_source(c"<std::arch::x86_64>", pcx.x86_module, ARCH_X86_64, &mut wanted, false,
        pcx);
    add_arch_source(c"<std::arch::aarch64::raw>", a64_raw, ARCH_AARCH64, &mut wanted, true,
        pcx);
    add_arch_source(c"<std::arch::x86_64::raw>", x86_raw, ARCH_X86_64, &mut wanted, true, pcx);
    pcx.arch_src_end = pcx.files[(pcx.files.len() as i64 - 1) as usize].end;
}

// (0.20) Whether token i is a name of a `use` line of std's (its
// re-exports, `pub use num::{count_ones, ..}`): not a use of the
// intrinsic. (0.25) The backward scan kept forward by the caller: `mark`
// is the last `use`, `;` or `}` before token i, as 2 * its index (+ 1 for
// a `use`), or -1; token i is in a `use` line when that is a `use` among
// the 255 tokens before it.
fn in_std_use_line(mark: i64, i: i64, pcx: &mut Ctx<Comp>) -> bool {
    mark >= 0 && mark % 2 == 1 && i - mark / 2 < 256
        && within_std(module_at(pcx.toks[i as usize].start, pcx), pcx)
}

// (0.25) Whether token i, `arch` outside std, may name std::arch: after
// `std::`, or first in a path (`arch::aarch64::..`), or in a `use` line
// (`use std::{io, arch}`) not after a path's `::`. Not: a variable, a
// field, `mod arch;`, the program's own `crate::arch`, `super::arch`,
// `x::arch` (unless std is aliased, which the caller checks).
fn arch_names_std(i: i64, std_sym: i64, in_use: bool, pcx: &Ctx<Comp>) -> bool {
    if i >= 1 && pcx.toks[(i - 1) as usize].kind == Tok::ColonColon {
        return i >= 2 && pcx.toks[(i - 2) as usize].kind == Tok::Ident
            && pcx.toks[(i - 2) as usize].value as i64 == std_sym;
    }
    in_use || i + 1 < pcx.toks.len() as i64 && pcx.toks[(i + 1) as usize].kind == Tok::ColonColon
}

// Module m's source: its types and the declarations of the wanted
// intrinsics of architecture `arch` (raw: the pointer forms of the memory
// ones, 0.19 T1), lexed; the start of its text.
fn add_arch_source(path: *const u8, m: i64, arch: i64, wanted: &mut Vec<i64, Comp>, raw: bool,
    pcx: &mut Ctx<Comp>) -> i64 {
    let text = buf_new();
    if arch == ARCH_AARCH64 {
        acle_types(text);
    } else if arch == ARCH_X86_64 {
        intel_types(text);
    }
    for k in 0..wanted.len() as i64 {
        let id = (wanted[k as usize]);
        if (pcx.intrs[id as usize]).arch != arch {
            continue;
        }
        if !raw {
            declaration(text, id, pcx);
            pcx.arch_ext_features |= (pcx.intrs[id as usize]).features;
        }
        else if (pcx.intrs[id as usize]).mem == MEM_LOAD
            || (pcx.intrs[id as usize]).mem == MEM_STORE {
            raw_declaration(text, id, pcx);
        }
    }
    let start = add_source(path, text, pcx, 0);
    { let at_ix = (pcx.files.len() as i64 - 1) as usize; pcx.files[at_ix].module = m };
    lex_range(start, pcx.files[(pcx.files.len() as i64 - 1) as usize].end, last: false,
        pcx: pcx);
    start
}

// ACLE's vector types: aliases of the portable ones (poly lanes are
// unsigned; p128 is v2u64, low lane first), and their tuples
// (`uint8x16x2_t = (v16u8, v16u8)`, x3, x4: 0.19 T1).
fn acle_types(text: i64) {
    let widths: [i64; 4] = [8i64, 16, 32, 64];
    for s in 0..4 {
        let prefix = if s == 0 { c"int" } else if s == 1 { c"uint" } else if s == 2 { c"poly" }
            else { c"float" };
        let letter = if s == 0 { c"i" } else if s == 3 { c"f" } else { c"u" };
        for w in 0..4 {
            let bits = widths[w as usize];
            if (s == 2 && bits == 32) || (s == 3 && bits < 32) {
                continue;
            }
            for half in 0..2 {
                let lanes = (if half == 0 { 64 } else { 128 }) / bits;
                for count in 1..5 {
                    buf_str(text, c"pub type ");
                    buf_str(text, prefix);
                    buf_int(text, bits);
                    buf_str(text, c"x");
                    buf_int(text, lanes);
                    if count > 1 {
                        buf_str(text, c"x");
                        buf_int(text, count);
                    }
                    buf_str(text, if count > 1 { c"_t = (" } else { c"_t = " });
                    for k in 0..count {
                        if k > 0 {
                            buf_str(text, c", ");
                        }
                        buf_str(text, c"v");
                        buf_int(text, lanes);
                        buf_str(text, letter);
                        buf_int(text, bits);
                    }
                    buf_str(text, if count > 1 { c");\n" } else { c";\n" });
                }
            }
        }
    }
    buf_str(text, c"pub type p8 = u8;\npub type p16 = u16;\npub type p64 = u64;\n");
    buf_str(text, c"pub type p128 = v2u64;\n");
}

// Intel's vector types: distinct opaque types of 16 and 32 bytes, with no
// operators and no lanes (front/types.vl: their names are not
// spellable but here).
fn intel_types(text: i64) {
    let names: [*const u8; 6] = [c"__m128i", c"__m128", c"__m128d", c"__m256i", c"__m256",
        c"__m256d"];
    for i in 0..6 {
        buf_str(text, c"pub type ");
        buf_str(text, names[i as usize]);
        buf_str(text, c" = __vole");
        buf_str(text, names[i as usize]);
        buf_str(text, c";\n");
    }
}

// `#[intrinsic(ID)] pub fn NAME(PARAMS) -> RET;` (an immediate is an i64;
// a bits.* intrinsic has std's function as its body; a store form's
// slice is `&mut [T]`, 0.19.1).
fn declaration(text: i64, id: i64, pcx: &Ctx<Comp>) {
    buf_str(text, c"#[intrinsic(");
    buf_int(text, id);
    buf_str(text, c")]\npub fn ");
    buf_bytes(text, sym_text((pcx.intrs[id as usize]).name, pcx));
    buf_str(text, c"(");
    for k in 0..(pcx.intrs[id as usize]).nparams {
        if k > 0 {
            buf_str(text, c", ");
        }
        buf_bytes(text, sym_text(intr_param_name(id, k, pcx), pcx));
        buf_str(text, c": ");
        if intr_param_is_const(id, k, pcx) {
            buf_str(text, c"i64");
        } else {
            // (0.19.1) a store's slice is written: `&mut [T]` (the
            // table writes `[T]` for both directions)
            let ty = param_type_text((pcx.intrs[id as usize]).params + k, pcx);
            if (pcx.intrs[id as usize]).mem == MEM_STORE
                && k == (pcx.intrs[id as usize]).mem_param {
                buf_str(text, c"&mut ");
            } else if ty.len() > 0 && ty[0] == b'[' {
                buf_str(text, c"&");
            }
            buf_bytes(text, ty);
        }
    }
    buf_str(text, c")");
    let ret = intr_ret_text(id, pcx);
    if ret.len() > 0 {
        buf_str(text, c" -> ");
        buf_bytes(text, ret);
    }
    if (pcx.intrs[id as usize]).form == FORM_BITS {
        let f = (pcx.intrs[id as usize]).form_arg;
        buf_str(text, if f == BITS_ONES { c" { super::count_ones(" }
            else if f == BITS_LEADING { c" { super::leading_zeros(" }
            else { c" { super::trailing_zeros(" });
        buf_bytes(text, sym_text(intr_param_name(id, 0, pcx), pcx));
        buf_str(text, c") }\n");
        return;
    }
    buf_str(text, c";\n");
}

// (0.19 T1) The pointer form of memory intrinsic id, for raw::NAME:
// `#[intrinsic(ID)] pub unsafe fn NAME(p: *T, ...) -> RET;`, the slice and
// its index replaced by a pointer: to the lanes' type (`*u8` for
// `vld1q_u8`), or to the vector for Intel's integer forms
// (`_mm_loadu_si128(p: *__m128i)`), as the vendors declare them. Lowering
// and -O0 tell it by its parameter count (one fewer).
fn raw_declaration(text: i64, id: i64, pcx: &Ctx<Comp>) {
    let s = (pcx.intrs[id as usize]).mem_param;
    let slice = param_type_text((pcx.intrs[id as usize]).params + s, pcx);
    let elem = &slice[1..(slice.len() as i64 - 1) as usize];
    let vector = if (pcx.intrs[id as usize]).mem == MEM_LOAD { intr_ret_text(id, pcx) }
        else { param_type_text((pcx.intrs[id as usize]).params + s + 2, pcx) };
    buf_str(text, c"#[intrinsic(");
    buf_int(text, id);
    buf_str(text, c")]\npub unsafe fn ");
    buf_bytes(text, sym_text((pcx.intrs[id as usize]).name, pcx));
    buf_str(text, c"(");
    let mut first = true;
    for k in 0..(pcx.intrs[id as usize]).nparams {
        if k == s + 1 {
            continue;
        }
        if !first {
            buf_str(text, c", ");
        }
        first = false;
        if k == s {
            buf_str(text,
                if (pcx.intrs[id as usize]).mem == MEM_LOAD { c"p: *const " }
                else { c"p: *mut " });
            buf_bytes(text,
                if (pcx.intrs[id as usize]).arch == ARCH_X86_64 && elem == b"u8" { vector }
                else { elem });
            continue;
        }
        buf_bytes(text, sym_text(intr_param_name(id, k, pcx), pcx));
        buf_str(text, c": ");
        buf_bytes(text, param_type_text((pcx.intrs[id as usize]).params + k, pcx));
    }
    buf_str(text, c")");
    let ret = intr_ret_text(id, pcx);
    if ret.len() > 0 {
        buf_str(text, c" -> ");
        buf_bytes(text, ret);
    }
    buf_str(text, c";\n");
}
