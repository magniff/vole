// (0.21) The encodings of the atomic instructions (back/mc_arm64/atomic.vl
// writes them): load-acquire and store-release (ldar, stlr), the exclusive
// pairs (ldxr, ldaxr, stxr, stlxr), LSE's cas, swp and ld<op> with their
// ordering (a, l, al) and width (b, h) suffixes, dmb, clrex, and mrs of
// tpidr_el0 (thread-locals).

use crate::back::enc_arm64::{C_X, get_ops, word};
use crate::back::objfile::assemble::{asm_error, get_op_count, get_op_end, get_op_start, text_is};
use crate::base::comp::Comp;
use crate::middle::ctx::FnCtx;

// The size field (bits 31-30) of an access of register operand k with
// width suffix `w` ('b', 'h' or 0).
fn size_field(cx: &mut FnCtx<Comp>, k: i64, w: u8) -> i64 {
    unsafe {
        if w == b'b' {
            return 0;
        }
        if w == b'h' {
            return 1 << 30;
        }
        if (*get_ops().add(k as usize)).cls == C_X { 3 << 30 } else { 2 << 30 }
    }
}

fn reg(cx: &mut FnCtx<Comp>, k: i64) -> i64 {
    unsafe { (*get_ops().add(k as usize)).reg }
}

// Whether `name` is `base` followed by an optional width suffix (b, h),
// which goes to *w.
fn base_width(name: &[u8], base: &[u8], w: &mut u8) -> bool {
    if name.len() < base.len() || &name[0..base.len()] != base {
        return false;
    }
    let rest = &name[base.len()..];
    if rest.len() == 0 {
        *w = 0;
        return true;
    }
    if rest.len() == 1 && (rest[0] == b'b' || rest[0] == b'h') {
        *w = rest[0];
        return true;
    }
    false
}

// The LSE family `name` starts with: its encoding without size, ordering
// and registers, the length of the base, or (-1, 0).
fn lse_base(name: &[u8]) -> (i64, i64) {
    let bases: [&[u8]; 10] = [b"cas", b"swp", b"ldadd", b"ldclr", b"ldeor", b"ldset", b"ldsmax",
        b"ldsmin", b"ldumax", b"ldumin"];
    let codes: [i64; 10] = [0x08a07c00i64, 0x38208000, 0x38200000, 0x38201000, 0x38202000,
        0x38203000, 0x38204000, 0x38205000, 0x38206000, 0x38207000];
    for i in 0..10 {
        let b = bases[i as usize];
        if name.len() >= b.len() && name[0..b.len()] == b {
            return (codes[i as usize], b.len() as i64);
        }
    }
    (-1, 0)
}

// Encodes instruction `name` (its operands parsed) when it is one of these;
// whether it was.
pub fn a64_atomic(cx: &mut FnCtx<Comp>, name: &[u8]) -> bool {
    let mut w: u8 = 0;
    let exclusive_loads: [&[u8]; 3] = [b"ldar", b"ldxr", b"ldaxr"];
    let load_codes: [i64; 3] = [0x08dffc00i64, 0x085f7c00, 0x085ffc00];
    for i in 0..3 {
        if base_width(name, exclusive_loads[i as usize], &mut w) {
            word(load_codes[i as usize] | size_field(cx, 0, w) | reg(cx, 1) << 5 | reg(cx, 0));
            return true;
        }
    }
    if base_width(name, b"stlr", &mut w) {
        word(0x089ffc00 | size_field(cx, 0, w) | reg(cx, 1) << 5 | reg(cx, 0));
        return true;
    }
    if base_width(name, b"stxr", &mut w) || base_width(name, b"stlxr", &mut w) {
        let rel = name[2] == b'l';
        let base: i64 = if rel { 0x0800fc00 } else { 0x08007c00 };
        word(base | size_field(cx, 1, w) | reg(cx, 0) << 16 | reg(cx, 2) << 5 | reg(cx, 1));
        return true;
    }
    if name == b"dmb" {
        if get_op_count() != 1 {
            asm_error(cx, c"wrong number of operands");
        }
        let crm: i64 = if text_is(cx, get_op_start()[0], get_op_end()[0], c"ish") { 11 }
            else if text_is(cx, get_op_start()[0], get_op_end()[0], c"ishld") { 9 }
            else if text_is(cx, get_op_start()[0], get_op_end()[0], c"ishst") { 10 }
            else if text_is(cx, get_op_start()[0], get_op_end()[0], c"sy") { 15 }
            else { asm_error(cx, c"bad barrier option") };
        word(0xd50330bf | crm << 8);
        return true;
    }
    if name == b"clrex" {
        word(0xd5033f5f);
        return true;
    }
    if name == b"mrs" {
        if get_op_count() != 2 || !text_is(cx, get_op_start()[1], get_op_end()[1], c"tpidr_el0") {
            asm_error(cx, c"mrs: only tpidr_el0");
        }
        word(0xd53bd040 | reg(cx, 0));
        return true;
    }
    let (code, n) = lse_base(name);
    if code < 0 {
        return false;
    }
    let mut rest = &name[n as usize..];
    let mut acq: i64 = 0;
    let mut rel: i64 = 0;
    if rest.len() >= 2 && rest[0] == b'a' && rest[1] == b'l' {
        acq = 1;
        rel = 1;
        rest = &rest[2..];
    } else if rest.len() >= 1 && rest[0] == b'a' {
        acq = 1;
        rest = &rest[1..];
    } else if rest.len() >= 1 && rest[0] == b'l' {
        rel = 1;
        rest = &rest[1..];
    }
    if rest.len() > 1 || rest.len() == 1 && rest[0] != b'b' && rest[0] != b'h' {
        return false;
    }
    w = if rest.len() == 1 { rest[0] } else { 0 };
    if get_op_count() != 3 {
        asm_error(cx, c"wrong number of operands");
    }
    let size = size_field(cx, 1, w);
    if code == 0x08a07c00 {
        // cas: L is bit 22, o0 bit 15.
        word(code | size | acq << 22 | rel << 15 | reg(cx, 0) << 16 | reg(cx, 2) << 5
            | reg(cx, 1));
    } else {
        word(code | size | acq << 23 | rel << 22 | reg(cx, 0) << 16 | reg(cx, 2) << 5
            | reg(cx, 1));
    }
    true
}
