// AArch64 instruction encoding for the object writer (objfile.vl): the
// instructions the code generator writes (arm64.vl, mc_arm64.vl,
// emit.vl), in their assembly syntax, to 32-bit words. Where the syntax
// leaves a choice (`ldr` with a negative offset is `ldur`; `mov` of an
// immediate is movz, movn or orr; `cmp x, #-1` is `cmn`), the choice is
// the one LLVM's assembler makes, so that the object matches `cc -c`.

mod operands;
mod simd;
mod atomic;

use crate::back::enc_arm64::atomic::a64_atomic;
use crate::back::enc_arm64::operands::parse_operand;
use crate::back::enc_arm64::simd::a64_table_instruction;
use crate::back::objfile::{
    Asm, FX_A64_ADR, FX_A64_B14, FX_A64_B19, FX_A64_B26, FX_A64_GOTPAGE, FX_A64_GOTPAGEOFF,
    FX_A64_PAGE, FX_A64_PAGEOFF, fixup, here, names_get, names_put, out32,
};
use crate::back::objfile::assemble::{asm_error, mnemonic_copy, text_is};
use crate::base::comp::Comp;
use crate::base::target::get_elf;

// Operand kinds.
const K_REG: i64 = 1;
const K_IMM: i64 = 2;
const K_MEM: i64 = 3;
const K_SYM: i64 = 4;
const K_SHIFT: i64 = 5;
const K_COND: i64 = 6;
// (0.19) A register list `{v1.16b, v2.16b}`: its first register (reg, cls,
// imm, shift as a vector register's), amount = the count.
const K_LIST: i64 = 7;

// Register classes.
const C_X: i64 = 1;
const C_W: i64 = 2;
const C_D: i64 = 3;
const C_S: i64 = 4;
// (0.10) q, h and b registers; v<n>.<arrangement> (imm: the element size,
// 0 b to 3 d; shift: Q, 1 for 128 bits); v<n>.<e>[i] (imm: the element
// size; amount: the index).
const C_Q: i64 = 5;
const C_H: i64 = 6;
const C_B: i64 = 7;
const C_V: i64 = 8;
const C_VL: i64 = 9;

// Symbol modifiers.
const M_NONE: i64 = 0;
const M_PAGE: i64 = 1;
const M_PAGEOFF: i64 = 2;
const M_GOTPAGE: i64 = 3;
const M_GOTPAGEOFF: i64 = 4;

// An operand. Registers: `reg` (0-31), `cls`, `sp` (sp itself). Memory:
// base `reg`; an offset `imm`, or an index register `index` (with `amount`
// of lsl), or a symbol `sym` with `modifier`; `pre`: written back (`!`).
// Shifts: `shift` (0 lsl, 1 lsr, 2 asr) by `amount`.
#[derive(Clone, Copy)] pub struct AOp {
    kind: i64, reg: i64, cls: i64, sp: bool, imm: i64, index: i64, index_cls: i64, amount: i64,
    sym: i64, modifier: i64, shift: i64, pre: bool,
}

// No operand.
pub fn aop_none() -> AOp {
    AOp {
        kind: 0, reg: 0, cls: 0, sp: false, imm: 0, index: 0, index_cls: 0, amount: 0, sym: 0,
        modifier: 0, shift: 0, pre: false,
    }
}

const A_ADD: i64 = 1;
const A_SUB: i64 = 2;
const A_ADDS: i64 = 3;
const A_SUBS: i64 = 4;
const A_CMP: i64 = 5;
const A_CMN: i64 = 6;
const A_AND: i64 = 7;
const A_ORR: i64 = 8;
const A_EOR: i64 = 9;
const A_ANDS: i64 = 10;
const A_TST: i64 = 11;
const A_MOV: i64 = 12;
const A_MOVZ: i64 = 13;
const A_MOVK: i64 = 14;
const A_MVN: i64 = 15;
const A_NEG: i64 = 16;
const A_LSL: i64 = 17;
const A_LSR: i64 = 18;
const A_ASR: i64 = 19;
const A_MUL: i64 = 20;
const A_MADD: i64 = 21;
const A_MSUB: i64 = 22;
const A_SDIV: i64 = 23;
const A_UDIV: i64 = 24;
const A_SXTB: i64 = 25;
const A_SXTH: i64 = 26;
const A_SXTW: i64 = 27;
const A_UBFX: i64 = 28;
const A_CSET: i64 = 29;
const A_CSEL: i64 = 30;
const A_CSINC: i64 = 31;
const A_FCSEL: i64 = 32;
const A_B: i64 = 33;
const A_BL: i64 = 34;
const A_BR: i64 = 35;
const A_BLR: i64 = 36;
const A_RET: i64 = 37;
const A_CBZ: i64 = 38;
const A_CBNZ: i64 = 39;
const A_TBZ: i64 = 40;
const A_TBNZ: i64 = 41;
const A_BRK: i64 = 42;
const A_ADR: i64 = 43;
const A_ADRP: i64 = 44;
const A_LDR: i64 = 45;
const A_STR: i64 = 46;
const A_LDRB: i64 = 47;
const A_STRB: i64 = 48;
const A_LDRH: i64 = 49;
const A_STRH: i64 = 50;
const A_LDRSB: i64 = 51;
const A_LDRSH: i64 = 52;
const A_LDRSW: i64 = 53;
const A_LDP: i64 = 54;
const A_STP: i64 = 55;
const A_FADD: i64 = 56;
const A_FSUB: i64 = 57;
const A_FMUL: i64 = 58;
const A_FDIV: i64 = 59;
const A_FCMP: i64 = 60;
const A_FNEG: i64 = 61;
const A_FABS: i64 = 62;
const A_FSQRT: i64 = 63;
const A_FRINTM: i64 = 64;
const A_FRINTA: i64 = 65;
const A_FRINTP: i64 = 66;
const A_FRINTZ: i64 = 67;
const A_FMOV: i64 = 68;
const A_FCVT: i64 = 69;
const A_SCVTF: i64 = 70;
const A_UCVTF: i64 = 71;
const A_FCVTZS: i64 = 72;
const A_FCVTZU: i64 = 73;
const A_DUP: i64 = 74;
const A_SMOV: i64 = 75;
const A_ADDV: i64 = 76;
const A_ADDP: i64 = 77;
const A_FADDP: i64 = 78;
const A_CMEQ: i64 = 79;
const A_CMGT: i64 = 80;
const A_CMGE: i64 = 81;
const A_FCMEQ: i64 = 82;
const A_FCMGT: i64 = 83;
const A_FCMGE: i64 = 84;
const A_BSL: i64 = 85;
const A_BIT: i64 = 86;
const A_BIF: i64 = 87;
const A_SMULH: i64 = 88;
const A_UMULH: i64 = 89;

// (0.16: the bit counts, ma_bits)
const A_CNT: i64 = 90;
const A_CLZ: i64 = 91;
const A_RBIT: i64 = 92;

const A_UMLAL: i64 = 93;
// (0.19: unsigned compares and lane moves, for the unsigned vectors)
const A_CMHI: i64 = 94;
const A_CMHS: i64 = 95;
const A_UMOV: i64 = 96;

// (0.20) ror Xd, Xn, #k: extr Xd, Xn, Xn, #k (isel's rotate).
const A_ROR: i64 = 97;

fn def(name: &[u8], code: i64, asm: &mut Asm<Comp>) {
    names_put(&mut asm.mn, name, code);
}

pub fn init_a64(asm: &mut Asm<Comp>) {
    def(b"add", A_ADD, asm); def(b"sub", A_SUB, asm); def(b"adds", A_ADDS, asm);
    def(b"subs", A_SUBS, asm);
    def(b"cmp", A_CMP, asm); def(b"cmn", A_CMN, asm); def(b"and", A_AND, asm);
    def(b"orr", A_ORR, asm);
    def(b"eor", A_EOR, asm); def(b"ands", A_ANDS, asm); def(b"tst", A_TST, asm);
    def(b"mov", A_MOV, asm);
    def(b"movz", A_MOVZ, asm); def(b"movk", A_MOVK, asm); def(b"mvn", A_MVN, asm);
    def(b"neg", A_NEG, asm);
    def(b"lsl", A_LSL, asm); def(b"lsr", A_LSR, asm); def(b"asr", A_ASR, asm);
    def(b"mul", A_MUL, asm);
    def(b"madd", A_MADD, asm); def(b"msub", A_MSUB, asm); def(b"sdiv", A_SDIV, asm);
    def(b"udiv", A_UDIV, asm);
    def(b"smulh", A_SMULH, asm); def(b"umulh", A_UMULH, asm);
    def(b"sxtb", A_SXTB, asm); def(b"sxth", A_SXTH, asm); def(b"sxtw", A_SXTW, asm);
    def(b"ubfx", A_UBFX, asm);
    def(b"cset", A_CSET, asm); def(b"csel", A_CSEL, asm); def(b"csinc", A_CSINC, asm);
    def(b"fcsel", A_FCSEL, asm);
    def(b"b", A_B, asm); def(b"bl", A_BL, asm); def(b"br", A_BR, asm); def(b"blr", A_BLR, asm);
    def(b"ret", A_RET, asm);
    def(b"dup", A_DUP, asm); def(b"smov", A_SMOV, asm); def(b"addv", A_ADDV, asm);
    def(b"addp", A_ADDP, asm);
    def(b"faddp", A_FADDP, asm); def(b"cmeq", A_CMEQ, asm); def(b"cmgt", A_CMGT, asm);
    def(b"cmge", A_CMGE, asm);
    def(b"fcmeq", A_FCMEQ, asm); def(b"fcmgt", A_FCMGT, asm); def(b"fcmge", A_FCMGE, asm);
    def(b"bsl", A_BSL, asm);
    def(b"bit", A_BIT, asm); def(b"bif", A_BIF, asm);
    def(b"cbz", A_CBZ, asm); def(b"cbnz", A_CBNZ, asm); def(b"tbz", A_TBZ, asm);
    def(b"tbnz", A_TBNZ, asm);
    def(b"brk", A_BRK, asm); def(b"adr", A_ADR, asm); def(b"adrp", A_ADRP, asm);
    def(b"ldr", A_LDR, asm); def(b"str", A_STR, asm); def(b"ldrb", A_LDRB, asm);
    def(b"strb", A_STRB, asm);
    def(b"ldrh", A_LDRH, asm); def(b"strh", A_STRH, asm); def(b"ldrsb", A_LDRSB, asm);
    def(b"ldrsh", A_LDRSH, asm);
    def(b"ldrsw", A_LDRSW, asm); def(b"ldp", A_LDP, asm); def(b"stp", A_STP, asm);
    def(b"fadd", A_FADD, asm); def(b"fsub", A_FSUB, asm); def(b"fmul", A_FMUL, asm);
    def(b"fdiv", A_FDIV, asm);
    def(b"fcmp", A_FCMP, asm); def(b"fneg", A_FNEG, asm); def(b"fabs", A_FABS, asm);
    def(b"fsqrt", A_FSQRT, asm);
    def(b"frintm", A_FRINTM, asm); def(b"frinta", A_FRINTA, asm); def(b"frintp", A_FRINTP, asm);
    def(b"frintz", A_FRINTZ, asm);
    def(b"fmov", A_FMOV, asm); def(b"fcvt", A_FCVT, asm); def(b"scvtf", A_SCVTF, asm);
    def(b"ucvtf", A_UCVTF, asm);
    def(b"fcvtzs", A_FCVTZS, asm); def(b"fcvtzu", A_FCVTZU, asm);
    def(b"cnt", A_CNT, asm); def(b"clz", A_CLZ, asm); def(b"rbit", A_RBIT, asm);
    def(b"umlal", A_UMLAL, asm);
    def(b"cmhi", A_CMHI, asm); def(b"cmhs", A_CMHS, asm); def(b"umov", A_UMOV, asm);
    def(b"ror", A_ROR, asm);
}

#[inline]
fn tchar(i: i64, asm: &mut Asm<Comp>) -> u8 {
    asm.text[i as usize]
}

// A condition code at [a, b), or -1.
fn cond_code(a: i64, b: i64, asm: &mut Asm<Comp>) -> i64 {
    if b - a != 2 {
        return -1;
    }
    let names: [&[u8]; 16] = [b"eq", b"ne", b"hs", b"lo", b"mi", b"pl", b"vs", b"vc", b"hi",
        b"ls", b"ge", b"lt", b"gt", b"le", b"cs", b"cc"];
    for i in 0..16 {
        if text_is(a, b, names[i as usize], asm) {
            return if i == 14 { 2 } else if i == 15 { 3 } else { i };
        }
    }
    -1
}

// The element size of letter c (b h s d: 0 to 3), or -1.
fn elem_size_of(c: u8) -> i64 {
    if c == b'b' { return 0; }
    if c == b'h' { return 1; }
    if c == b's' { return 2; }
    if c == b'd' { return 3; }
    -1
}

// ---- Helpers ----

fn word(w: i64, asm: &mut Asm<Comp>) {
    out32(w, asm);
}

fn sf(k: i64, asm: &mut Asm<Comp>) -> i64 {
    if asm.a64[k as usize].cls == C_X { 1 << 31 } else { 0 }
}

fn r(k: i64, asm: &mut Asm<Comp>) -> i64 {
    asm.a64[k as usize].reg
}

fn need(n: i64, asm: &mut Asm<Comp>) {
    if asm.op_count != n {
        asm_error("wrong number of operands", asm);
    }
}

fn is_imm(k: i64, asm: &mut Asm<Comp>) -> bool {
    k < asm.op_count && asm.a64[k as usize].kind == K_IMM
}

fn is_float(k: i64, asm: &mut Asm<Comp>) -> bool {
    asm.a64[k as usize].cls == C_D || asm.a64[k as usize].cls == C_S
}

// The type field of a floating-point instruction: 1 double, 0 single.
fn ftype(k: i64, asm: &mut Asm<Comp>) -> i64 {
    if asm.a64[k as usize].cls == C_D { 1 << 22 } else { 0 }
}

// A logical immediate (bitmask) for a register of `width` bits: the
// N:immr:imms fields at bit 10, or -1 when the value is not one.
fn logical_imm(value: i64, width: i64) -> i64 {
    let mut v = value;
    if width == 32 {
        v = v & 0xffffffff;
        v = v | (v << 32);
    }
    if v == 0 || v == -1 {
        return -1;
    }
    // The smallest repeating element.
    let mut size: i64 = 64;
    while size > 2 {
        let half = size / 2;
        let mask = (1 << half) - 1;
        if (v & mask) != ((v >> half) & mask) {
            break;
        }
        size = half;
    }
    let mask: i64 = if size == 64 { -1 } else { (1 << size) - 1 };
    let elem = v & mask;
    // elem must be a rotated run of ones: count them and find the rotation.
    let ones = ((0i64..size)).filter(|x| ({ let i = *x; ((elem >> i) & 1) != 0 })).count() as i64;
    let run: i64 = if ones == 64 { -1 } else { (1i64 << ones).wrapping_sub(1) };
    let mut rot: i64 = -1;
    for rr in 0..size {
        // rotate `run` right by rr within size bits
        let rotated = if rr == 0 { run } else { ((run >> rr) | (run << (size - rr))) & mask };
        if rotated == elem {
            rot = rr;
            break;
        }
    }
    if rot < 0 {
        return -1;
    }
    let n: i64 = if size == 64 { 1 } else { 0 };
    let imms = ((0 - size * 2) & 0x3f) | (ones - 1);
    let immr = rot;
    (n << 22) | (immr << 16) | ((imms & 0x3f) << 10)
}

fn cond_of(k: i64, asm: &mut Asm<Comp>) -> i64 {
    if asm.a64[k as usize].kind != K_COND {
        asm_error("expected a condition", asm);
    }
    asm.a64[k as usize].imm
}

// ---- Instructions ----

// add/sub/adds/subs: op 0 add, 1 sub; s: set flags. rd may be 31 (cmp).
fn addsub(op: i64, s: i64, rd: i64, rn_k: i64, m_k: i64, asm: &mut Asm<Comp>) {
    let x = sf(rn_k, asm);
    if is_imm(m_k, asm) {
        let mut imm = asm.a64[m_k as usize].imm;
        let mut o = op;
        if imm < 0 {
            imm = 0 - imm;
            o = 1 - o;
        }
        let mut sh: i64 = 0;
        if m_k + 1 < asm.op_count && asm.a64[(m_k + 1) as usize].kind == K_SHIFT {
            if asm.a64[(m_k + 1) as usize].amount == 12 {
                sh = 1;
            }
        } else if imm > 4095 && (imm & 4095) == 0 && imm <= 0xfff000 {
            imm = imm >> 12;
            sh = 1;
        }
        if imm > 4095 {
            asm_error("immediate out of range", asm);
        }
        word(x | o << 30 | s << 29 | 0x11000000 | sh << 22 | imm << 10 | r(rn_k, asm) << 5
            | rd, asm);
        return;
    }
    if asm.a64[m_k as usize].kind == K_SYM {
        if asm.a64[m_k as usize].modifier != M_PAGEOFF {
            asm_error("expected @PAGEOFF", asm);
        }
        fixup(FX_A64_PAGEOFF, here(asm), asm.a64[m_k as usize].sym, 0, 0, false, asm);
        word(x | op << 30 | s << 29 | 0x11000000 | r(rn_k, asm) << 5 | rd, asm);
        return;
    }
    // Registers: the extended form when sp is involved (as LLVM does).
    let rd_sp = asm.a64[0].kind == K_REG && asm.a64[0].sp && rd == 31
        && s == 0;
    if asm.a64[rn_k as usize].sp || rd_sp {
        word(x | op << 30 | s << 29 | 0x0b200000 | r(m_k, asm) << 16 | 3 << 13
            | r(rn_k, asm) << 5 | rd, asm);
        return;
    }
    let mut shift: i64 = 0;
    let mut amount: i64 = 0;
    if m_k + 1 < asm.op_count && asm.a64[(m_k + 1) as usize].kind == K_SHIFT {
        shift = asm.a64[(m_k + 1) as usize].shift;
        amount = asm.a64[(m_k + 1) as usize].amount;
    }
    word(x | op << 30 | s << 29 | 0x0b000000 | shift << 22 | r(m_k, asm) << 16 | amount << 10
        | r(rn_k, asm) << 5 | rd,
        asm);
}

// and/orr/eor/ands: opc 0 and, 1 orr, 2 eor, 3 ands.
fn logical(opc: i64, rd: i64, rn_k: i64, m_k: i64, asm: &mut Asm<Comp>) {
    let x = sf(rn_k, asm);
    if is_imm(m_k, asm) {
        let enc = logical_imm(asm.a64[m_k as usize].imm, if x != 0 { 64 } else { 32 });
        if enc < 0 {
            asm_error("not a logical immediate", asm);
        }
        word(x | opc << 29 | 0x12000000 | enc | r(rn_k, asm) << 5 | rd, asm);
        return;
    }
    let mut shift: i64 = 0;
    let mut amount: i64 = 0;
    if m_k + 1 < asm.op_count && asm.a64[(m_k + 1) as usize].kind == K_SHIFT {
        shift = asm.a64[(m_k + 1) as usize].shift;
        amount = asm.a64[(m_k + 1) as usize].amount;
    }
    word(x | opc << 29 | 0x0a000000 | shift << 22 | r(m_k, asm) << 16 | amount << 10
        | r(rn_k, asm) << 5 | rd, asm);
}

// mov of an immediate: movz, movn, or orr with a logical immediate.
fn mov_imm(k_rd: i64, value: i64, asm: &mut Asm<Comp>) {
    let x = sf(k_rd, asm);
    let width: i64 = if x != 0 { 64 } else { 32 };
    let v = if width == 32 { value & 0xffffffff } else { value };
    for hw in 0..width / 16 {
        let sh = hw * 16;
        if (v & !(0xffff << sh)) == 0 {
            word(x | 0x52800000 | hw << 21 | ((v >> sh) & 0xffff) << 5 | r(k_rd, asm), asm);
            return;
        }
    }
    let nv = if width == 32 { !value & 0xffffffff } else { !value };
    for hw in 0..width / 16 {
        let sh = hw * 16;
        if (nv & !(0xffff << sh)) == 0 {
            word(x | 0x12800000 | hw << 21 | ((nv >> sh) & 0xffff) << 5 | r(k_rd, asm), asm);
            return;
        }
    }
    let enc = logical_imm(value, width);
    if enc >= 0 {
        word(x | 1 << 29 | 0x12000000 | enc | 31 << 5 | r(k_rd, asm), asm);
        return;
    }
    asm_error("immediate cannot be moved in one instruction", asm);
}

// Loads and stores of one register. size: log2 bytes; `unscaled`: the
// opcode of the unscaled-offset form (ldur...), from which the others
// derive.
fn load_store(unscaled: i64, size: i64, asm: &mut Asm<Comp>) {
    need(if asm.op_count == 3 { 3 } else { 2 }, asm);
    let rt = r(0, asm);
    let m = asm.a64[1];
    if m.kind != K_MEM {
        asm_error("expected a memory operand", asm);
    }
    if asm.op_count == 3 {
        // post-index: [base], #imm
        word(unscaled | (asm.a64[2].imm & 0x1ff) << 12 | 1 << 10 | m.reg << 5 | rt,
            asm);
        return;
    }
    if m.pre {
        word(unscaled | (m.imm & 0x1ff) << 12 | 3 << 10 | m.reg << 5 | rt, asm);
        return;
    }
    if m.index >= 0 {
        let s: i64 = if m.amount != 0 { 1 } else { 0 };
        let option: i64 = if m.index_cls == C_W { 6 } else { 3 };
        word(unscaled | 0x00200800 | m.index << 16 | option << 13 | s << 12 | m.reg << 5 | rt,
            asm);
        return;
    }
    if m.sym >= 0 {
        let kind = if m.modifier == M_GOTPAGEOFF { FX_A64_GOTPAGEOFF }
            else if m.modifier == M_PAGEOFF { FX_A64_PAGEOFF }
            else { asm_error("expected @PAGEOFF", asm) };
        fixup(kind, here(asm), m.sym, 0, 0, false, asm);
        word(unscaled | 1 << 24 | m.reg << 5 | rt, asm);
        return;
    }
    let off = m.imm;
    let scale = 1 << size;
    if off >= 0 && (off & (scale - 1)) == 0 && off / scale < 4096 {
        word(unscaled | 1 << 24 | (off / scale) << 10 | m.reg << 5 | rt, asm);
        return;
    }
    if off < -256 || off > 255 {
        asm_error("offset out of range", asm);
    }
    word(unscaled | (off & 0x1ff) << 12 | m.reg << 5 | rt, asm);
}

// The unscaled opcode (ldur form) for ldr/str of register class cls.
fn ldst_opcode(load: bool, cls: i64) -> i64 {
    let base: i64 = if cls == C_X { 0xf8000000 } else if cls == C_W { 0xb8000000 }
        else if cls == C_D { 0xfc000000 } else { 0xbc000000 };
    if load { base | 0x00400000 } else { base }
}

fn ldst_size(cls: i64) -> i64 {
    if cls == C_X || cls == C_D { 3 } else { 2 }
}

// ldp/stp.
fn pair(load: bool, asm: &mut Asm<Comp>) {
    let cls = asm.a64[0].cls;
    let base: i64 = if cls == C_X { 0x28000000 | 2 << 30 }
        else if cls == C_Q { 0x2c000000 | 2 << 30 }
        else if cls == C_D { 0x2c000000 | 1 << 30 } else if cls == C_W { 0x28000000 }
        else { 0x2c000000 };
    let l: i64 = if load { 1 << 22 } else { 0 };
    let scale: i64 = if cls == C_Q { 16 } else if cls == C_X || cls == C_D { 8 } else { 4 };
    let m = asm.a64[2];
    let mut mode: i64 = 2;
    let mut off = m.imm;
    if asm.op_count == 4 {
        mode = 1;
        off = asm.a64[3].imm;
    } else if m.pre {
        mode = 3;
    }
    let imm7 = (off / scale) & 0x7f;
    word(base | mode << 23 | l | imm7 << 15 | r(1, asm) << 10 | m.reg << 5 | r(0, asm), asm);
}

fn fp2(base_double: i64, asm: &mut Asm<Comp>) {
    word((base_double & !(1 << 22)) | ftype(0, asm) | r(1, asm) << 5 | r(0, asm), asm);
}

fn fp3(base_double: i64, asm: &mut Asm<Comp>) {
    word((base_double & !(1 << 22)) | ftype(0, asm) | r(2, asm) << 16 | r(1, asm) << 5 | r(0, asm),
        asm);
}

// Conversions between general and floating-point registers: `base` for a
// single-precision value and a 32-bit register; the 64-bit register and
// the double variants add sf and type.
fn conv(base: i64, gp_k: i64, fp_k: i64, asm: &mut Asm<Comp>) {
    word(base | sf(gp_k, asm) | ftype(fp_k, asm) | r(1, asm) << 5 | r(0, asm), asm);
}

// imm5 of an element of size `size` (0 b to 3 d) at `index`.
fn imm5(size: i64, index: i64) -> i64 {
    (index << (size + 1) as u64) | (1 << size as u64)
}

fn is_simd(k: i64, asm: &mut Asm<Comp>) -> bool {
    let cls = asm.a64[k as usize].cls;
    (asm.a64[k as usize].kind == K_REG || asm.a64[k as usize].kind == K_LIST)
        && (cls == C_V || cls == C_VL || cls == C_Q || cls == C_H || cls == C_B)
}

// Advanced SIMD (0.10): the forms vector code uses (mc_arm64.vl).
fn a64_simd(code: i64, asm: &mut Asm<Comp>) {
    let o0 = asm.a64[0];
    let o1 = asm.a64[1];
    if code == A_LDR || code == A_STR {
        load_store(if code == A_LDR { 0x3cc00000 } else { 0x3c800000 }, 4, asm);
        return;
    }
    let q = o0.shift << 30;
    if code == A_UMLAL {
        // (0.16) umlal vd.2d, vn.2s, vm.s[i], by element (index 0, 1)
        need(3, asm);
        let index = asm.a64[2].amount;
        word(0x2f802000 | (index & 1) << 21 | (index >> 1) << 11 | (r(2, asm) & 31) << 16
            | r(1, asm) << 5 | r(0, asm), asm);
        return;
    }
    if asm.op_count == 3 && o0.cls == C_V {
        let rm = r(2, asm) << 16 | r(1, asm) << 5 | r(0, asm);
        let size = o0.imm << 22;
        let sz: i64 = (if o0.imm == 3 { 1 } else { 0 }) << 22;
        let w = if code == A_ADD { 0x0e208400 | size }
            else if code == A_SUB { 0x2e208400 | size }
            else if code == A_MUL { 0x0e209c00 | size }
            else if code == A_CMEQ { 0x2e208c00 | size }
            else if code == A_CMGT { 0x0e203400 | size }
            else if code == A_CMGE { 0x0e203c00 | size }
            else if code == A_CMHI { 0x2e203400 | size }
            else if code == A_CMHS { 0x2e203c00 | size }
            else if code == A_AND { 0x0e201c00 }
            else if code == A_ORR { 0x0ea01c00 }
            else if code == A_EOR { 0x2e201c00 }
            else if code == A_BSL { 0x2e601c00 }
            else if code == A_BIT { 0x2ea01c00 }
            else if code == A_BIF { 0x2ee01c00 }
            else if code == A_FADD { 0x0e20d400 | sz }
            else if code == A_FSUB { 0x0ea0d400 | sz }
            else if code == A_FMUL { 0x2e20dc00 | sz }
            else if code == A_FDIV { 0x2e20fc00 | sz }
            else if code == A_FCMEQ { 0x0e20e400 | sz }
            else if code == A_FCMGE { 0x2e20e400 | sz }
            else if code == A_FCMGT { 0x2ea0e400 | sz }
            else if code == A_FADDP { 0x2e20d400 | sz }
            else { asm_error("unknown vector instruction", asm) };
        word(w | q | rm, asm);
        return;
    }
    need(2, asm);
    let rr = r(1, asm) << 5 | r(0, asm);
    if code == A_MOV && o0.cls == C_V {
        word(0x0ea01c00 | q | r(1, asm) << 16 | rr, asm);
    } else if (code == A_NEG || code == A_FNEG || code == A_MVN) && o0.cls == C_V {
        let sz: i64 = (if o0.imm == 3 { 1 } else { 0 }) << 22;
        let w: i64 = if code == A_NEG { 0x2e20b800 | o0.imm << 22 }
            else if code == A_FNEG { 0x2ea0f800 | sz } else { 0x2e205800 };
        word(w | q | rr, asm);
    } else if code == A_DUP && o1.cls == C_VL {
        word(0x0e000400 | q | imm5(o1.imm, o1.amount) << 16 | rr, asm);
    } else if code == A_DUP {
        word(0x0e000c00 | q | imm5(o0.imm, 0) << 16 | rr, asm);
    } else if code == A_MOV && o0.cls == C_VL && o1.cls == C_VL {
        word(0x6e000400 | imm5(o0.imm, o0.amount) << 16 | (o1.amount << o1.imm as u64) << 11
            | rr,
            asm);
    } else if code == A_MOV && o0.cls == C_VL {
        word(0x4e001c00 | imm5(o0.imm, o0.amount) << 16 | rr, asm);
    } else if code == A_MOV && (o0.cls == C_X || o0.cls == C_W) {
        word((if o0.cls == C_X { 0x4e003c00 } else { 0x0e003c00 })
            | imm5(o1.imm, o1.amount) << 16 | rr, asm);
    } else if code == A_MOV {
        word(0x5e000400 | imm5(o1.imm, o1.amount) << 16 | rr, asm);
    } else if code == A_UMOV {
        word((if o0.cls == C_X { 0x4e003c00 } else { 0x0e003c00 })
            | imm5(o1.imm, o1.amount) << 16 | rr, asm);
    } else if code == A_SMOV {
        word((if o0.cls == C_X { 0x4e002c00 } else { 0x0e002c00 })
            | imm5(o1.imm, o1.amount) << 16 | rr, asm);
    } else if code == A_ADDV {
        word(0x0e31b800 | o1.shift << 30 | o1.imm << 22 | rr, asm);
    } else if code == A_CNT {
        word(0x0e205800 | q | rr, asm);
    } else if code == A_ADDP {
        word(0x5ef1b800 | rr, asm);
    } else if code == A_FADDP {
        word(0x7e30d800 | (if o1.imm == 3 { 1 << 22 } else { 0 }) | rr, asm);
    } else {
        asm_error("unknown vector instruction", asm);
    }
}

pub fn a64_instruction(a: i64, b: i64, asm: &mut Asm<Comp>) {
    let mut room = [0u8; 32];
    let name_len = mnemonic_copy(a, b, &mut room, asm);
    let name = &room[..name_len];
    for k in 0..asm.op_count {
        parse_operand(k, asm);
    }
    if asm.op_count > 0 && (is_simd(0, asm) || (asm.op_count > 1 && is_simd(1, asm))) {
        let code = mnemonic(name, asm);
        // (0.15: ldp and stp of q registers)
        if code == A_LDP || code == A_STP {
            pair(code == A_LDP, asm);
            return;
        }
        // (0.19: the intrinsics' instructions, compiler/arch/insn_a64.def,
        // before the chain: a line whose class fits the operands)
        if a64_table_instruction(name,
            asm) {
            return;
        }
        a64_simd(code, asm);
        return;
    }
    if b - a > 2 && asm.text[a as usize] == b'b' && asm.text[(a + 1) as usize] == b'.' {
        let cc = cond_code(a + 2, b, asm);
        if cc < 0 {
            asm_error("bad condition", asm);
        }
        fixup(FX_A64_B19, here(asm), asm.a64[0].sym, 0, 0, false, asm);
        word(0x54000000 | cc, asm);
        return;
    }
    let code = mnemonic(name,
        asm);
    // (0.19: the table first for a SIMD scalar operand, `sqadd d0, d1, d2`;
    // else only for a mnemonic the chain does not know)
    let fp = asm.op_count > 0 && asm.a64[0].kind == K_REG
        && asm.a64[0].cls >= C_D;
    if (code == 0 || fp)
        && a64_table_instruction(name,
            asm) {
        return;
    }
    if code == 0 {
        // (0.21: the atomics, enc_arm64/atomic.vl)
        if a64_atomic(name, asm) {
            return;
        }
        asm_error("unknown instruction", asm);
        return;
    }
    if code == A_ADD || code == A_SUB || code == A_ADDS || code == A_SUBS {
        need(if asm.op_count == 4 { 4 } else { 3 }, asm);
        let op: i64 = if code == A_SUB || code == A_SUBS { 1 } else { 0 };
        let s: i64 = if code == A_ADDS || code == A_SUBS { 1 } else { 0 };
        addsub(op, s, r(0, asm), 1, 2, asm);
    } else if code == A_CMP || code == A_CMN {
        addsub(if code == A_CMP { 1 } else { 0 }, 1, 31, 0, 1, asm);
    } else if code == A_AND || code == A_ORR || code == A_EOR || code == A_ANDS {
        let opc: i64 = if code == A_AND { 0 } else if code == A_ORR { 1 }
            else if code == A_EOR { 2 } else { 3 };
        logical(opc, r(0, asm), 1, 2, asm);
    } else if code == A_TST {
        logical(3, 31, 0, 1, asm);
    } else if code == A_MOV {
        need(2, asm);
        if is_imm(1, asm) {
            mov_imm(0, asm.a64[1].imm, asm);
        } else if asm.a64[0].sp || asm.a64[1].sp {
            word(sf(0, asm) | 0x11000000 | r(1, asm) << 5 | r(0, asm), asm);
        } else {
            word(sf(0, asm) | 0x2a000000 | r(1, asm) << 16 | 31 << 5 | r(0, asm), asm);
        }
    } else if code == A_MOVZ || code == A_MOVK {
        let hw: i64 = if asm.op_count == 3 { asm.a64[2].amount / 16 } else { 0 };
        let base: i64 = if code == A_MOVZ { 0x52800000 } else { 0x72800000 };
        word(sf(0, asm) | base | hw << 21 | (asm.a64[1].imm & 0xffff) << 5
            | r(0, asm), asm);
    } else if code == A_MVN {
        word(sf(0, asm) | 0x2a200000 | r(1, asm) << 16 | 31 << 5 | r(0, asm), asm);
    } else if code == A_NEG {
        word(sf(0, asm) | 0x4b000000 | r(1, asm) << 16 | 31 << 5 | r(0, asm), asm);
    } else if code == A_LSL || code == A_LSR || code == A_ASR {
        let x = sf(0, asm);
        if is_imm(2, asm) {
            let width: i64 = if x != 0 { 64 } else { 32 };
            let n: i64 = if x != 0 { 1 << 22 } else { 0 };
            let s = asm.a64[2].imm;
            if code == A_LSL {
                word(x | n | 0x53000000 | ((width - s) % width) << 16 | (width - 1 - s) << 10
                    | r(1, asm) << 5 | r(0, asm),
                    asm);
            } else {
                let base: i64 = if code == A_LSR { 0x53000000 } else { 0x13000000 };
                word(x | n | base | s << 16 | (width - 1) << 10 | r(1, asm) << 5 | r(0, asm),
                    asm);
            }
        } else {
            let op2: i64 = if code == A_LSL { 0x2000 } else if code == A_LSR { 0x2400 }
                else { 0x2800 };
            word(x | 0x1ac00000 | op2 | r(2, asm) << 16 | r(1, asm) << 5 | r(0, asm), asm);
        }
    } else if code == A_MUL {
        word(sf(0, asm) | 0x1b000000 | r(2, asm) << 16 | 31 << 10 | r(1, asm) << 5 | r(0, asm),
            asm);
    } else if code == A_MADD || code == A_MSUB {
        let o0: i64 = if code == A_MSUB { 1 << 15 } else { 0 };
        word(sf(0, asm) | 0x1b000000 | o0 | r(2, asm) << 16 | r(3, asm) << 10 | r(1, asm) << 5
            | r(0, asm),
            asm);
    } else if code == A_SMULH || code == A_UMULH {
        // (0.11) 64-bit only.
        word(0x9b407c00 | (if code == A_UMULH { 0x800000 } else { 0 }) | r(2, asm) << 16
            | r(1, asm) << 5 | r(0, asm), asm);
    } else if code == A_SDIV || code == A_UDIV {
        word(sf(0, asm) | 0x1ac00000 | (if code == A_SDIV { 0xc00 } else { 0x800 })
            | r(2, asm) << 16 | r(1, asm) << 5 | r(0, asm), asm);
    } else if code == A_SXTB || code == A_SXTH || code == A_SXTW {
        let x = sf(0, asm);
        let n: i64 = if x != 0 { 1 << 22 } else { 0 };
        let imms: i64 = if code == A_SXTB { 7 } else if code == A_SXTH { 15 } else { 31 };
        word(x | n | 0x13000000 | imms << 10 | r(1, asm) << 5 | r(0, asm), asm);
    } else if code == A_ROR {
        // extr Rd, Rn, Rn, #k (N = sf)
        let x = sf(0, asm);
        let n: i64 = if x != 0 { 1 << 22 } else { 0 };
        let k = asm.a64[2].imm;
        word(x | n | 0x13800000 | r(1, asm) << 16 | k << 10 | r(1, asm) << 5 | r(0, asm), asm);
    } else if code == A_UBFX {
        let x = sf(0, asm);
        let n: i64 = if x != 0 { 1 << 22 } else { 0 };
        let lsb = asm.a64[2].imm;
        let width = asm.a64[3].imm;
        word(x | n | 0x53000000 | lsb << 16 | (lsb + width - 1) << 10 | r(1, asm) << 5
            | r(0, asm), asm);
    } else if code == A_CSET {
        let cc = cond_of(1, asm) ^ 1;
        word(sf(0, asm) | 0x1a9f07e0 | cc << 12 | r(0, asm), asm);
    } else if code == A_CSEL || code == A_CSINC {
        let o2: i64 = if code == A_CSINC { 0x400 } else { 0 };
        word(sf(0, asm) | 0x1a800000 | o2 | r(2, asm) << 16 | cond_of(3, asm) << 12
            | r(1, asm) << 5 | r(0, asm), asm);
    } else if code == A_FCSEL {
        word(0x1e200c00 | ftype(0, asm) | r(2, asm) << 16 | cond_of(3, asm) << 12
            | r(1, asm) << 5 | r(0, asm),
            asm);
    } else if code == A_B || code == A_BL {
        fixup(FX_A64_B26, here(asm), asm.a64[0].sym, 0, 0, false, asm);
        word(if code == A_B { 0x14000000 } else { 0x94000000 }, asm);
    } else if code == A_BR {
        word(0xd61f0000 | r(0, asm) << 5, asm);
    } else if code == A_BLR {
        word(0xd63f0000 | r(0, asm) << 5, asm);
    } else if code == A_RET {
        word(0xd65f03c0, asm);
    } else if code == A_CBZ || code == A_CBNZ {
        fixup(FX_A64_B19, here(asm), asm.a64[1].sym, 0, 0, false, asm);
        word(sf(0, asm) | (if code == A_CBZ { 0x34000000 } else { 0x35000000 }) | r(0, asm),
            asm);
    } else if code == A_TBZ || code == A_TBNZ {
        let bit = asm.a64[1].imm;
        fixup(FX_A64_B14, here(asm), asm.a64[2].sym, 0, 0, false, asm);
        word((bit >> 5) << 31 | (if code == A_TBZ { 0x36000000 } else { 0x37000000 })
            | (bit & 31) << 19 | r(0, asm), asm);
    } else if code == A_BRK {
        word(0xd4200000 | (asm.a64[0].imm & 0xffff) << 5, asm);
    } else if code == A_ADR {
        fixup(FX_A64_ADR, here(asm), asm.a64[1].sym, 0, 0, false, asm);
        word(0x10000000 | r(0, asm), asm);
    } else if code == A_ADRP {
        let kind = if asm.a64[1].modifier == M_GOTPAGE { FX_A64_GOTPAGE }
            else if asm.a64[1].modifier == M_PAGE
            || (get_elf() && asm.a64[1].modifier == M_NONE) { FX_A64_PAGE }
            else { asm_error("expected @PAGE", asm) };
        fixup(kind, here(asm), asm.a64[1].sym, 0, 0, false, asm);
        word(0x90000000 | r(0, asm), asm);
    } else if code == A_LDR || code == A_STR {
        load_store(ldst_opcode(code == A_LDR, asm.a64[0].cls),
            ldst_size(asm.a64[0].cls), asm);
    } else if code == A_LDRB || code == A_STRB {
        load_store(if code == A_LDRB { 0x38400000 } else { 0x38000000 }, 0, asm);
    } else if code == A_LDRH || code == A_STRH {
        load_store(if code == A_LDRH { 0x78400000 } else { 0x78000000 }, 1, asm);
    } else if code == A_LDRSB || code == A_LDRSH {
        let w = asm.a64[0].cls == C_W;
        let base: i64 = if code == A_LDRSB { 0x38000000 } else { 0x78000000 };
        load_store(base | (if w { 0x00c00000 } else { 0x00800000 }),
            if code == A_LDRSB { 0 } else { 1 }, asm);
    } else if code == A_LDRSW {
        load_store(0xb8800000, 2, asm);
    } else if code == A_LDP || code == A_STP {
        pair(code == A_LDP, asm);
    } else if code == A_FADD {
        fp3(0x1e602800, asm);
    } else if code == A_FSUB {
        fp3(0x1e603800, asm);
    } else if code == A_FMUL {
        fp3(0x1e600800, asm);
    } else if code == A_FDIV {
        fp3(0x1e601800, asm);
    } else if code == A_FCMP {
        word(0x1e202000 | ftype(0, asm) | r(1, asm) << 16 | r(0, asm) << 5, asm);
    } else if code == A_FNEG {
        fp2(0x1e614000, asm);
    } else if code == A_FABS {
        fp2(0x1e60c000, asm);
    } else if code == A_FSQRT {
        fp2(0x1e61c000, asm);
    } else if code == A_FRINTM {
        fp2(0x1e654000, asm);
    } else if code == A_FRINTA {
        fp2(0x1e664000, asm);
    } else if code == A_FRINTP {
        fp2(0x1e64c000, asm);
    } else if code == A_FRINTZ {
        fp2(0x1e65c000, asm);
    } else if code == A_FMOV {
        if is_float(0, asm) && is_float(1, asm) {
            fp2(0x1e604000, asm);
        } else if is_float(0, asm) {
            // fmov d, x / fmov s, w
            word(sf(1, asm) | 0x1e270000 | ftype(0, asm) | r(1, asm) << 5 | r(0, asm), asm);
        } else {
            word(sf(0, asm) | 0x1e260000 | ftype(1, asm) | r(1, asm) << 5 | r(0, asm), asm);
        }
    } else if code == A_CLZ || code == A_RBIT {
        need(2, asm);
        word(sf(0, asm) | (if code == A_CLZ { 0x5ac01000 } else { 0x5ac00000 }) | r(1, asm) << 5
            | r(0, asm),
            asm);
    } else if code == A_FCVT {
        // to double from single: type 0, opc 01; to single from double: type 1, opc 00
        if asm.a64[0].cls == C_D {
            word(0x1e22c000 | r(1, asm) << 5 | r(0, asm), asm);
        } else {
            word(0x1e624000 | r(1, asm) << 5 | r(0, asm), asm);
        }
    } else if code == A_SCVTF || code == A_UCVTF {
        conv(if code == A_SCVTF { 0x1e220000 } else { 0x1e230000 }, 1, 0, asm);
    } else if code == A_FCVTZS || code == A_FCVTZU {
        conv(if code == A_FCVTZS { 0x1e380000 } else { 0x1e390000 }, 0, 1, asm);
    } else {
        asm_error("unknown instruction", asm);
    }
}

// The code of mnemonic t (0: none).
fn mnemonic(t: &[u8], asm: &mut Asm<Comp>) -> i64 {
    names_get(&asm.mn, t)
}
