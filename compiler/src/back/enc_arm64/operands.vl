// The operands of an AArch64 instruction of the assembler (enc_arm64):
// registers, vector registers, symbols with their modifiers, immediates
// and addresses.

use crate::back::enc_arm64::{
    AOp, C_B, C_D, C_H, C_Q, C_S, C_V, C_VL, C_W, C_X, K_COND, K_IMM, K_LIST, K_MEM, K_REG, K_SHIFT,
    K_SYM, M_GOTPAGE, M_GOTPAGEOFF, M_NONE, M_PAGE, M_PAGEOFF, cond_code, elem_size_of, tchar,
};
use crate::back::objfile::{Asm, asym_text};
use crate::back::objfile::assemble::{asm_error, parse_number, text_is};
use crate::base::comp::Comp;

// ---- Operands ----

// A register at [a, b): sets op.reg, op.cls, op.sp; false if not one.
fn parse_reg(a: i64, b: i64, op: &mut AOp, asm: &mut Asm<Comp>) -> bool {
    // (0.17: sp, xzr and wzr told by their bytes, not by text_is: every
    // register operand is asked)
    let c0 = tchar(a, asm);
    if b - a == 2 && c0 == b's' && tchar(a + 1, asm) == b'p' {
        op.reg = 31;
        op.cls = C_X;
        op.sp = true;
        return true;
    }
    if b - a == 3 && (c0 == b'x' || c0 == b'w') && tchar(a + 1, asm) == b'z'
        && tchar(a + 2, asm) == b'r' {
        op.reg = 31;
        op.cls = if tchar(a, asm) == b'x' { C_X } else { C_W };
        op.sp = false;
        return true;
    }
    if tchar(a, asm) == b'v' && parse_vreg(a, b, op, asm) {
        return true;
    }
    if b - a < 2 || b - a > 3 {
        return false;
    }
    let c = tchar(a, asm);
    let cls = if c == b'x' { C_X } else if c == b'w' { C_W } else if c == b'd' { C_D }
        else if c == b's' { C_S } else if c == b'q' { C_Q } else if c == b'h' { C_H }
        else if c == b'b' { C_B } else { 0 };
    if cls == 0 {
        return false;
    }
    let mut n: i64 = 0;
    for i in a + 1..b {
        let d = tchar(i, asm);
        if d < b'0' || d > b'9' {
            return false;
        }
        n = n * 10 + (d - b'0') as i64;
    }
    op.reg = n;
    op.cls = cls;
    op.sp = false;
    true
}

// v<n>.<arrangement> or v<n>.<e>[i] at [a, b) (0.10).
fn parse_vreg(a: i64, b: i64, op: &mut AOp, asm: &mut Asm<Comp>) -> bool {
    let mut i = a + 1;
    let mut n: i64 = 0;
    while i < b && tchar(i, asm) >= b'0' && tchar(i, asm) <= b'9' {
        n = n * 10 + (tchar(i, asm) - b'0') as i64;
        i += 1;
    }
    if i == a + 1 || i >= b || tchar(i, asm) != b'.' {
        return false;
    }
    i += 1;
    op.reg = n;
    op.sp = false;
    if i + 1 < b && tchar(i + 1, asm) == b'[' {
        let size = elem_size_of(tchar(i, asm));
        if size < 0 || tchar(b - 1, asm) != b']' {
            return false;
        }
        op.cls = C_VL;
        op.imm = size;
        op.amount = parse_number(i + 2, b - 1, asm);
        return true;
    }
    let mut lanes: i64 = 0;
    while i < b && tchar(i, asm) >= b'0' && tchar(i, asm) <= b'9' {
        lanes = lanes * 10 + (tchar(i, asm) - b'0') as i64;
        i += 1;
    }
    // (0.19) a group of lanes as one element: sdot's `v2.4b[1]`, a 32-bit
    // element
    if lanes > 0 && i + 1 < b && tchar(i + 1, asm) == b'[' {
        let lsize = elem_size_of(tchar(i, asm));
        if lsize < 0 || tchar(b - 1, asm) != b']' {
            return false;
        }
        let bytes = lanes << lsize as u64;
        op.cls = C_VL;
        op.imm = if bytes == 4 { 2 } else if bytes == 8 { 3 } else { 1 };
        op.amount = parse_number(i + 2, b - 1, asm);
        return true;
    }
    if i + 1 != b {
        return false;
    }
    // (0.19) `.1q`: pmull's 128-bit result, size 4
    let size: i64 = if tchar(i, asm) == b'q' { 4 } else { elem_size_of(tchar(i, asm)) };
    if size < 0 {
        return false;
    }
    op.cls = C_V;
    op.imm = size;
    op.shift = if lanes << size as u64 == 16 { 1 } else { 0 };
    true
}

fn skip_spaces(i: i64, b: i64, asm: &mut Asm<Comp>) -> i64 {
    let mut k = i;
    while k < b && (tchar(k, asm) == b' ' || tchar(k, asm) == b'\t') {
        k += 1;
    }
    k
}

// A symbol with an optional modifier at [a, b): `sym@PAGEOFF`... on
// Mach-O, `:lo12:sym`, `:got:sym`, `:got_lo12:sym` on ELF (where adrp's
// plain `sym` is its page).
fn parse_sym(a: i64, b: i64, op: &mut AOp, asm: &mut Asm<Comp>) {
    unsafe {
        if tchar(a, asm) == b':' {
            let mut colon = a + 1;
            while colon < b && tchar(colon, asm) != b':' {
                colon += 1;
            }
            if colon >= b {
                asm_error("bad symbol modifier", asm);
            }
            op.sym = asym_text(colon + 1, b, asm);
            if text_is(a + 1, colon, b"lo12", asm) {
                op.modifier = M_PAGEOFF;
            } else if text_is(a + 1, colon, b"got", asm) {
                op.modifier = M_GOTPAGE;
            } else if text_is(a + 1, colon, b"got_lo12", asm) {
                op.modifier = M_GOTPAGEOFF;
            } else {
                asm_error("unknown symbol modifier", asm);
            }
            return;
        }
        let mut at = a;
        while at < b && tchar(at, asm) != b'@' {
            at += 1;
        }
        op.sym = asym_text(a, at, asm);
        op.modifier = M_NONE;
        if at < b {
            if text_is(at + 1, b, b"PAGE", asm) {
                op.modifier = M_PAGE;
            } else if text_is(at + 1, b, b"PAGEOFF", asm) {
                op.modifier = M_PAGEOFF;
            } else if text_is(at + 1, b, b"GOTPAGE", asm) {
                op.modifier = M_GOTPAGE;
            } else if text_is(at + 1, b, b"GOTPAGEOFF", asm) {
                op.modifier = M_GOTPAGEOFF;
            } else {
                asm_error("unknown symbol modifier", asm);
            }
        }
    }
}

pub fn parse_operand(k: i64, asm: &mut Asm<Comp>) {
    unsafe {
        let a = asm.op_start[k as usize];
        let b = asm.op_end[k as usize];
        let mut op = AOp {
            kind: 0, reg: 0, cls: 0, sp: false, imm: 0, index: -1, index_cls: 0, amount: 0, sym: -1,
            modifier: 0, shift: 0, pre: false,
        };
        let c = tchar(a, asm);
        if c == b'#' {
            op.kind = K_IMM;
            // (0.19: `#0.0`, the float compares against zero)
            op.imm = if text_is(a + 1, b, b"0.0", asm) { 0 } else { parse_number(a + 1, b, asm) };
        } else if c == b'{' {
            // (0.19) a register list: its first register, and the count
            op.kind = K_LIST;
            let mut i = a + 1;
            let mut count: i64 = 0;
            while i < b && tchar(i, asm) != b'}' {
                i = skip_spaces(i, b, asm);
                let mut j = i;
                while j < b && tchar(j, asm) != b',' && tchar(j, asm) != b'}' {
                    j += 1;
                }
                let mut e = j;
                while e > i && tchar(e - 1, asm) == b' ' {
                    e -= 1;
                }
                let mut item = AOp {
                    kind: 0, reg: 0, cls: 0, sp: false, imm: 0, index: -1, index_cls: 0,
                    amount: 0, sym: -1, modifier: 0, shift: 0, pre: false,
                };
                if !parse_reg(i, e, &mut item, asm) {
                    asm_error("bad register list", asm);
                }
                if count == 0 {
                    op.reg = item.reg;
                    op.cls = item.cls;
                    op.imm = item.imm;
                    op.shift = item.shift;
                }
                count += 1;
                i = if j < b && tchar(j, asm) == b',' { j + 1 } else { j };
            }
            op.amount = count;
        } else if c == b'[' {
            op.kind = K_MEM;
            let mut e = b;
            if tchar(e - 1, asm) == b'!' {
                op.pre = true;
                e -= 1;
            }
            if tchar(e - 1, asm) != b']' {
                asm_error("bad memory operand", asm);
            }
            e -= 1;
            // [base(, x)*]
            let mut i = a + 1;
            let mut j = i;
            while j < e && tchar(j, asm) != b',' {
                j += 1;
            }
            if !parse_reg(i, j, &mut op, asm) {
                asm_error("bad base register", asm);
            }
            if j < e {
                i = skip_spaces(j + 1, e, asm);
                j = i;
                while j < e && tchar(j, asm) != b',' {
                    j += 1;
                }
                if tchar(i, asm) == b'#' {
                    op.imm = parse_number(i + 1, j, asm);
                } else {
                    let mut idx = AOp {
                        kind: 0, reg: 0, cls: 0, sp: false, imm: 0, index: -1, index_cls: 0,
                        amount: 0, sym: -1, modifier: 0, shift: 0, pre: false,
                    };
                    if parse_reg(i, j, &mut idx, asm) {
                        op.index = idx.reg;
                        op.index_cls = idx.cls;
                        if j < e {
                            i = skip_spaces(j + 1, e, asm);
                            if !text_is(i, i + 5, b"lsl #", asm) {
                                asm_error("bad index shift", asm);
                            }
                            op.amount = parse_number(i + 5, e, asm);
                        }
                    } else {
                        let base_reg = op.reg;
                        let base_cls = op.cls;
                        let base_sp = op.sp;
                        parse_sym(i, j, &mut op, asm);
                        op.reg = base_reg;
                        op.cls = base_cls;
                        op.sp = base_sp;
                    }
                }
            }
        }
        else if (c == b'l' || c == b'a')
            && (text_is(a, a + 4, b"lsl ", asm) || text_is(a, a + 4, b"lsr ", asm)
                || text_is(a, a + 4, b"asr ", asm)) {
            op.kind = K_SHIFT;
            op.shift = if c == b'l' { if tchar(a + 2, asm) == b'l' { 0 } else { 1 } } else { 2 };
            let i = skip_spaces(a + 4, b, asm);
            if tchar(i, asm) != b'#' {
                asm_error("bad shift", asm);
            }
            op.amount = parse_number(i + 1, b, asm);
        } else if parse_reg(a, b, &mut op, asm) {
            op.kind = K_REG;
        } else if cond_code(a, b, asm) >= 0 {
            op.kind = K_COND;
            op.imm = cond_code(a, b, asm);
        } else {
            op.kind = K_SYM;
            parse_sym(a, b, &mut op, asm);
        }
        asm.a64[k as usize] = op;
    }
}
