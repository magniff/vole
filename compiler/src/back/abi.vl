// The C calling convention for aggregates (structs, tuples, arrays, enums
// with fields and slices passed or returned by value), shared by the -O0
// code generator and the IR back end, so that every function follows C's
// convention and can be handed to C.
//
// AArch64 (AAPCS64; Apple's variant on macOS): a homogeneous float
// aggregate (one to four floats of one type) goes in consecutive v
// registers, or entirely on the stack (and no further v register is used);
// another aggregate of up to 16 bytes goes in one or two x registers (an
// aligned pair for one aligned to 16, except on Apple's), or entirely on
// the stack (and no further x register is used); a larger one is copied by
// the caller and passed by reference. Results: an HFA in v0-v3, up to 16
// bytes in x0/x1, larger ones through the pointer in x8. On the stack,
// AAPCS64 gives every argument 8-byte slots; Apple's packs scalars and
// homogeneous float aggregates at their alignment, and passes every
// variadic argument on the stack, where AAPCS64 passes them as named ones.
//
// x86-64 (System V): an aggregate of up to 16 bytes is split into
// eightbytes, each INTEGER (an rdi/rsi/... register) when it holds any
// non-float, else SSE (an xmm register); it goes in registers only when
// all of its eightbytes fit, else entirely on the stack (and the registers
// stay available). A larger one (MEMORY) is copied onto the stack. Results:
// INTEGER eightbytes in rax then rdx, SSE ones in xmm0 then xmm1; MEMORY
// ones through a hidden pointer (the first argument), returned in rax.
//
// An aggregate passed in registers is a list of pieces: (scalar type,
// offset). A piece is read and written whole, so the memory holding such an
// aggregate is a multiple of 8 bytes (frame slots are; see new_slot_for).

// How a value is passed.
use crate::back::regalloc::intervals::min_i64;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::ast::REPR_PACKED;
use crate::front::distinct::enum_niche;
use crate::front::types::{
    TY_F32, TY_F64, TY_U16, TY_U32, TY_U64, TY_U8, TyKind, align_to, enum_variant, field_offset,
    get_enums, in_fregs, is_compound, is_float, is_void, made_vector_half, max_i64, scalar_type,
    struct_field, tuple_offset, type_align, type_elem, type_size, variant_field,
    variant_field_offset,
};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::ir_type;

#[derive(Clone, Copy, PartialEq, Eq)] pub enum AbiClass {
    // A scalar, in a register (or a stack slot).
    Scalar,
    // In registers (or on the stack, in the same layout), as pieces.
    Pieces,
    // By reference: a pointer to a copy (AArch64, over 16 bytes).
    Ref,
    // Copied onto the stack (x86-64 MEMORY, over 16 bytes); results of
    // both kinds go through a result pointer.
    Stack,
}

// How a value of type `ty` is passed; for AbiClass::Pieces, its pieces.
pub fn abi_classify(cx: &mut FnCtx, ty: i64, pcx: &Ctx<Comp>) -> AbiClass {
    unsafe {
        cx.abi_piece_count = 0;
        if !is_compound(ty, pcx) {
            return AbiClass::Scalar;
        }
        let size = type_size(ty, pcx);
        // (0.26.2) Decided by the size, without the leaves (a large array's
        // are many): over 64 bytes it is no HFA (four floats of at most 16
        // bytes) on AArch64, and over 16 bytes MEMORY on x86-64.
        if !get_x86() && size > 64 {
            return AbiClass::Ref;
        }
        if get_x86() && size > 16 {
            return AbiClass::Stack;
        }
        cx.abi_leaves.count = 0;
        abi_leaves(cx, ty, 0, pcx);
        if !get_x86() {
            let mut elem: i64 = 0;
            let mut count: i64 = 0;
            if is_hfa(cx, size, &mut elem, &mut count, pcx) {
                for i in 0..count {
                    abi_add_piece(cx, elem, i * type_size(elem, pcx));
                }
                return AbiClass::Pieces;
            }
            if size > 16 {
                return AbiClass::Ref;
            }
            let mut offset: i64 = 0;
            while offset < size {
                abi_add_piece(cx, int_piece_type(size - offset), offset);
                offset += 8;
            }
            return AbiClass::Pieces;
        }
        if size > 16 || has_unaligned_leaf(cx, pcx) {
            return AbiClass::Stack;
        }
        let mut offset: i64 = 0;
        while offset < size {
            let chunk = min_i64(8, size - offset);
            let mut integer = false;
            let mut f32_only = true;
            let mut any = false;
            let mut i: i64 = 0;
            while i < cx.abi_leaves.count {
                let at = (*cx.abi_leaves.data.add(i as usize));
                let leaf = (*cx.abi_leaves.data.add((i + 1) as usize));
                if at < offset + 8 && at + type_size(leaf, pcx) > offset {
                    any = true;
                    if !is_float(leaf) {
                        integer = true;
                    }
                    if leaf != TY_F32 {
                        f32_only = false;
                    }
                }
                i += 2;
            }
            if !any {
                // Padding only (NO_CLASS): no register.
            } else if integer {
                abi_add_piece(cx, int_piece_type(chunk), offset);
            } else if f32_only && chunk <= 4 {
                abi_add_piece(cx, TY_F32, offset);
            } else {
                abi_add_piece(cx, TY_F64, offset);
            }
            offset += 8;
        }
        AbiClass::Pieces
    }
}

// Whether a leaf sits at an offset that is not a multiple of its
// alignment (in a packed struct): such aggregates are MEMORY on x86-64.
fn has_unaligned_leaf(cx: &mut FnCtx, pcx: &Ctx<Comp>) -> bool {
    let mut i: i64 = 0;
    while i < cx.abi_leaves.count {
        if unsafe { (*cx.abi_leaves.data.add(i as usize)) % type_align(
            (*cx.abi_leaves.data.add((i + 1) as usize)), pcx) != 0 } {
            return true;
        }
        i += 2;
    }
    false
}

fn abi_add_piece(cx: &mut FnCtx, ty: i64, offset: i64) {
    cx.abi_piece_ty[cx.abi_piece_count as usize] = ty;
    cx.abi_piece_offset[cx.abi_piece_count as usize] = offset;
    cx.abi_piece_count += 1;
}

// The integer type of a piece of `left` bytes (read whole: 3 bytes are
// read as 4, 5 to 8 as 8).
fn int_piece_type(left: i64) -> i64 {
    if left >= 5 { return TY_U64; }
    if left >= 3 { return TY_U32; }
    if left == 2 { return TY_U16; }
    TY_U8
}

// Appends the scalar leaves of `ty` at `offset` to ABI_LEAVES; the fields
// of every variant of an enum overlap (a union). (0.26.2) Under a cap
// (cx.leaves_cap), it stops once it has more leaves than that.
pub fn abi_leaves(cx: &mut FnCtx, ty: i64, offset: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if leaves_full(cx) {
            return;
        }
        let kind = pcx.types[ty as usize].kind;
        if kind == TyKind::Vector {
            if cx.leaves_whole_vectors && type_size(ty, pcx) == 32 {
                // (0.19: a 256-bit vector is two 128-bit halves,
                // middle/lower/vector.vl)
                let half = made_vector_half(ty, pcx);
                cx.abi_leaves.push(offset);
                cx.abi_leaves.push(half);
                cx.abi_leaves.push(offset + 16);
                cx.abi_leaves.push(half);
                return;
            }
            if cx.leaves_whole_vectors {
                cx.abi_leaves.push(offset);
                cx.abi_leaves.push(ty);
                return;
            }
            let elem = pcx.types[ty as usize].a;
            for i in 0..pcx.types[ty as usize].b {
                if leaves_full(cx) {
                    return;
                }
                abi_leaves(cx, elem, offset + i * type_size(elem, pcx), pcx);
            }
        } else if kind == TyKind::Struct {
            let s = pcx.types[ty as usize].a;
            for i in 0..pcx.structs[s as usize].field_count {
                if leaves_full(cx) {
                    return;
                }
                abi_leaves(cx, (*struct_field(s, i, pcx)).ty,
                    offset + field_offset(s, i, pcx), pcx);
            }
        } else if kind == TyKind::Tuple {
            for i in 0..pcx.types[ty as usize].count {
                if leaves_full(cx) {
                    return;
                }
                abi_leaves(cx, type_elem(ty, i, pcx), offset + tuple_offset(ty, i, pcx), pcx);
            }
        } else if kind == TyKind::Array {
            let elem = pcx.types[ty as usize].a;
            let size = type_size(elem, pcx);
            for i in 0..pcx.types[ty as usize].b {
                if leaves_full(cx) {
                    return;
                }
                abi_leaves(cx, elem, offset + i * size, pcx);
            }
        } else if kind == TyKind::Slice {
            cx.abi_leaves.push(offset);
            cx.abi_leaves.push(TY_U64);
            cx.abi_leaves.push(offset + 8);
            cx.abi_leaves.push(TY_U64);
        }
        else if kind == TyKind::Enum && is_compound(ty, pcx)
            && enum_niche(pcx.types[ty as usize].a, pcx) {
            // (0.18: the null niche: one pointer)
            cx.abi_leaves.push(offset);
            cx.abi_leaves.push(TY_U64);
        } else if kind == TyKind::Enum && is_compound(ty, pcx) {
            let e = pcx.types[ty as usize].a;
            cx.abi_leaves.push(offset);
            cx.abi_leaves.push((*get_enums().add(e as usize)).tag);
            for i in 0..(*get_enums().add(e as usize)).variant_count {
                let v = enum_variant(e, i);
                for k in 0..pcx.variants[v as usize].field_count {
                    if leaves_full(cx) {
                        return;
                    }
                    abi_leaves(cx, variant_field(v, k, pcx),
                        offset + variant_field_offset(v, k, pcx), pcx);
                }
            }
        } else if !is_void(ty) {
            cx.abi_leaves.push(offset);
            cx.abi_leaves.push(scalar_type(ty, pcx));
        }
    }
}

// (0.26.2) Whether abi_leaves has more leaves than its cap asks for.
fn leaves_full(cx: &mut FnCtx) -> bool {
    // UNSAFE: cx is the raw context pointer every classification takes.
    // SAFETY: cx points at the caller's live FnCtx, one per thread.
    unsafe { cx.leaves_cap > 0 && cx.abi_leaves.count > 2 * cx.leaves_cap }
}

// Whether the leaves are one to four floats of one type, one after the
// other, filling the aggregate's `total` bytes (an AArch64 homogeneous
// float aggregate has no padding); leaves that coincide (the members of a
// union) count once.
fn is_hfa(cx: *mut FnCtx, total: i64, elem: &mut i64, count: &mut i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let n = cx.abi_leaves.count / 2;
        if n < 1 {
            return false;
        }
        let first = (*cx.abi_leaves.data.add(1));
        if !is_float(first) {
            return false;
        }
        let size = type_size(first, pcx);
        // Every leaf is a float of that type at a multiple of its size, and the
        // offsets used are 0, size, 2 * size... without a gap.
        let mut highest: i64 = -1;
        for i in 0..n {
            let offset = (*cx.abi_leaves.data.add((2 * i) as usize));
            if (*cx.abi_leaves.data.add((2 * i + 1) as usize)) != first || offset % size != 0 {
                return false;
            }
            highest = max_i64(highest, offset / size);
        }
        if highest > 3 || (highest + 1) * size != total {
            return false;
        }
        for k in 0..highest + 1 {
            if !(0i64..n).any(|i| (*cx.abi_leaves.data.add((2 * i) as usize)) == k * size) {
                return false;
            }
        }
        *elem = first;
        *count = highest + 1;
        true
    }
}

// The locations of the pieces of the aggregate of type `ty` just
// classified (see arg_location for locations and `state`), in
// `locations`. An aggregate aligned to 16 starts at a multiple of 16 on
// the stack, and in an even x register under AAPCS64 (Apple's AArch64
// convention does not round it).
pub fn abi_piece_locations(cx: &mut FnCtx, ty: i64, state: *mut i64, locations: *mut i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        let size = type_size(ty, pcx);
        let aapcs = !get_x86() && !pcx.apple_a64;
        let wide = (if aapcs { natural_align(ty, pcx) } else { type_align(ty, pcx) }) >= 16;
        let n = cx.abi_piece_count;
        let mut ints: i64 = 0;
        let mut floats: i64 = 0;
        for i in 0..n {
            if is_float(cx.abi_piece_ty[i as usize]) {
                floats += 1;
            } else {
                ints += 1;
            }
        }
        let int_limit: i64 = if get_x86() { 6 } else { 8 };
        if aapcs && wide && ints > 0 {
            (*state.add(0)) = align_to((*state.add(0)), 2);
        }
        if (*state.add(0)) + ints <= int_limit && (*state.add(1)) + floats <= 8 {
            for i in 0..n {
                if is_float(cx.abi_piece_ty[i as usize]) {
                    (*locations.add(i as usize)) = 8 + (*state.add(1));
                    (*state.add(1)) += 1;
                } else {
                    (*locations.add(i as usize)) = (*state.add(0));
                    (*state.add(0)) += 1;
                }
            }
            return;
        }
        // On the stack, laid out as in memory.
        if !get_x86() {
            if floats > 0 {
                (*state.add(1)) = 8;
            } else {
                (*state.add(0)) = 8;
            }
        }
        // Apple's AArch64 convention passes a homogeneous float aggregate on
        // the stack as its elements: at the element's alignment, taking its
        // exact size (a union of three f32 takes 12 bytes at a multiple of 4),
        // where other aggregates take 8-byte slots (as every one does under
        // AAPCS64).
        let hfa = !get_x86() && pcx.apple_a64 && ints == 0 && !wide;
        let base = align_to((*state.add(2)),
            if wide && aapcs { 16 } else if wide { type_align(ty, pcx) }
            else if hfa { type_size(cx.abi_piece_ty[0], pcx) } else { 8 });
        for i in 0..n {
            (*locations.add(i as usize)) = 16 + base + cx.abi_piece_offset[i as usize];
        }
        (*state.add(2)) = base + if hfa { size } else { align_to(size, 8) };
    }
}

// The alignment AAPCS64 places an aggregate by (an even register pair, a
// stack slot): its natural alignment, that of its fields (packing
// included) without its own repr(align), as GCC and clang have it.
fn natural_align(ty: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.types[ty as usize].kind != TyKind::Struct {
            return type_align(ty, pcx);
        }
        let s = pcx.types[ty as usize].a;
        let mut align: i64 = 1;
        for i in 0..pcx.structs[s as usize].field_count {
            let mut field = type_align((*struct_field(s, i, pcx)).ty, pcx);
            if (pcx.structs[s as usize].repr & REPR_PACKED) != 0
                && field > pcx.structs[s as usize].align {
                field = pcx.structs[s as usize].align;
            }
            align = max_i64(align, field);
        }
        align
    }
}

// The stack offset (from the outgoing area) of an aggregate copied onto the
// stack (AbiClass::Stack): at a multiple of its alignment when that is 16
// or more (as clang and GCC place them).
pub fn abi_stack_location(ty: i64, state: *mut i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let base = align_to((*state.add(2)),
            if type_align(ty, pcx) >= 16 { type_align(ty, pcx) } else { 8 });
        (*state.add(2)) = base + align_to(type_size(ty, pcx), 8);
        16 + base
    }
}

// The `...` arguments of a C function: aggregates are classified as named
// ones; on x86-64 and under AAPCS64 they also go where named ones would, on
// Apple's AArch64 every variadic argument goes on the stack (an aggregate in pieces as its
// bytes, homogeneous float aggregates of any size included; a larger one
// by reference, in an 8-byte slot). Classifies ty.
pub fn variadic_kind(cx: &mut FnCtx, ty: i64, pcx: &Ctx<Comp>) -> AbiClass {
    abi_classify(cx, ty, pcx)
}

// The locations of the pieces of a variadic aggregate passed by value (see
// variadic_by_reference), classified just before.
pub fn abi_variadic_piece_locations(cx: &mut FnCtx, ty: i64, state: *mut i64, locations: *mut i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        if get_x86() || !pcx.apple_a64 {
            abi_piece_locations(cx, ty, state, locations, pcx);
            return;
        }
        let base = align_to((*state.add(2)), if type_align(ty, pcx) >= 16 { 16 } else { 8 });
        for i in 0..cx.abi_piece_count {
            (*locations.add(i as usize)) = 16 + base + cx.abi_piece_offset[i as usize];
        }
        (*state.add(2)) = base + align_to(type_size(ty, pcx), 8);
    }
}

// Whether a function returning `ret` gets a result pointer (does not
// change the pieces of the last classified aggregate).
pub fn returns_through_pointer(cx: &mut FnCtx, ret: i64, pcx: &Ctx<Comp>) -> bool {
    if !is_compound(ret, pcx) {
        return false;
    }
    // (0.26.2) Decided by the size, without the leaves, as abi_classify
    let size = type_size(ret, pcx);
    if get_x86() && size > 16 || !get_x86() && size > 64 {
        return true;
    }
    if !get_x86() && size <= 16 {
        return false;
    }
    cx.abi_leaves.count = 0;
    abi_leaves(cx, ret, 0, pcx);
    if get_x86() {
        return has_unaligned_leaf(cx, pcx);
    }
    let mut elem: i64 = 0;
    let mut count: i64 = 0;
    type_size(ret, pcx) > 16 && !is_hfa(cx, type_size(ret, pcx), &mut elem, &mut count, pcx)
}

// The machine register of return piece i (x0/x1 or rax/rdx, v0-v3 or
// xmm0/xmm1).
pub fn return_piece_reg(cx: &mut FnCtx, i: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut float = false;
    let index = return_piece_index(cx, i, &mut float, pcx);
    if float {
        return 32 + index;
    }
    if get_x86() && index == 1 { 2 } else { index }
}

// The register returning piece i of an aggregate result: x0, x1 / rax, rdx
// for integers (0, 1: the argument-register numbering of the machine
// layer is not used here), v0-v3 / xmm0, xmm1 for floats and (0.19, the
// vole convention) vectors; as (is_float, index) in `float`.
fn return_piece_index(cx: &mut FnCtx, i: i64, float: &mut bool, pcx: &Ctx<Comp>) -> i64 {
    let mut ints: i64 = 0;
    let mut floats: i64 = 0;
    for k in 0..i {
        if in_fregs(cx.abi_piece_ty[k as usize], pcx) {
            floats += 1;
        } else {
            ints += 1;
        }
    }
    *float = in_fregs(cx.abi_piece_ty[i as usize], pcx);
    if *float { floats } else { ints }
}

// ---- The vole convention (0.5) ----
//
// Plain `fn`s compiled at -O1 and -O2 call each other with a convention of
// their own; C's is kept by everything C can reach or call: functions
// imported from C or defined `extern "C"`, `main`, variadic functions,
// calls through `extern "C" fn` pointers, the run-time helpers, and every
// function at -O0 (the oracle). The two never meet: a plain `fn` value only
// ever holds a plain function of the same program (the types `fn` and
// `extern "C" fn` do not convert into each other), and a program is
// compiled at one level. `main`, called by C, is the one plain function
// whose value can be taken while it follows C's convention; for a `main`
// taking only scalars (in registers) and returning a scalar, as C's `main`
// does, the two conventions agree.
//
// The convention: every argument is a list of scalars, passed one by one,
// each in the next free register of its class (AArch64: x0-x15 and d0-d7,
// d16-d23; x86-64: rdi, rsi, rdx, rcx, r8, r9, rax and xmm0-xmm13), or else
// in the next 8-byte slot of the stack area. An aggregate (struct, tuple,
// array, enum with fields, slice) of at most four scalar leaves that do not
// overlap is its leaves; (0.19) a vector is one leaf (a 256-bit one two
// 128-bit halves), passed in the float registers whole, a vector register,
// or in a stack slot of its size, at a multiple of it; another one of at most 32 bytes is its 8-byte
// chunks (read as integers); a larger one is a pointer to the caller's
// copy. Results: up to four pieces in x0-x3 / rax, rdx, rcx, rsi and d0-d3
// / xmm0-xmm3; a larger aggregate through a result pointer passed as the
// first argument (and not returned). The scalars of the first registers go
// where C's convention puts them, so a function taking scalars that fit in
// C's registers and returning a scalar follows both.

// Whether function f follows C's convention.
pub fn fn_uses_c(f: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.opt_level == 0 || pcx.fns[f as usize].is_extern || pcx.fns[f as usize].export
        || pcx.fns[f as usize].variadic || pcx.fns[f as usize].name == pcx.main_sym
}

// Whether calls through a pointer of fn type t follow C's convention.
pub fn fn_type_uses_c(t: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.opt_level == 0 || crate::front::types::fn_ty_c(t, pcx)
}

// How a value of type `ty` is passed under C's convention (c) or
// vole's; for AbiClass::Pieces, its pieces.
pub fn conv_classify(cx: &mut FnCtx, c: bool, ty: i64, pcx: &Ctx<Comp>) -> AbiClass {
    if c { abi_classify(cx, ty, pcx) } else { tabi_classify(cx, ty, pcx) }
}

// Whether a function returning `ret` gets a result pointer (does not
// change the pieces of the last classified aggregate).
pub fn conv_returns_through_pointer(cx: &mut FnCtx, c: bool, ret: i64, pcx: &Ctx<Comp>) -> bool {
    if c {
        return returns_through_pointer(cx, ret, pcx);
    }
    if !is_compound(ret, pcx) {
        return false;
    }
    cx.abi_leaves.count = 0;
    tabi_leaves(cx, ret, pcx);
    !leaves_as_pieces(cx, pcx) && type_size(ret, pcx) > 32
}

// The leaves of `ty` under the vole convention: (0.19) a vector is one
// leaf, in a vector register; a 256-bit one two.
fn tabi_leaves(cx: &mut FnCtx, ty: i64, pcx: &Ctx<Comp>) {
    let saved = cx.leaves_whole_vectors;
    let saved_cap = cx.leaves_cap;
    cx.leaves_whole_vectors = true;
    // (0.26.2: more than four are not pieces, leaves_as_pieces)
    cx.leaves_cap = 4;
    abi_leaves(cx, ty, 0, pcx);
    cx.leaves_whole_vectors = saved;
    cx.leaves_cap = saved_cap;
}

// The vole convention's classification (see above).
pub fn tabi_classify(cx: &mut FnCtx, ty: i64, pcx: &Ctx<Comp>) -> AbiClass {
    cx.abi_piece_count = 0;
    if !is_compound(ty, pcx) {
        return AbiClass::Scalar;
    }
    cx.abi_leaves.count = 0;
    tabi_leaves(cx, ty, pcx);
    if leaves_as_pieces(cx, pcx) {
        let mut i: i64 = 0;
        while i < cx.abi_leaves.count {
            unsafe {
                abi_add_piece(cx, ir_type((*cx.abi_leaves.data.add((i + 1) as usize)), pcx),
                    (*cx.abi_leaves.data.add(i as usize)));
            }
            i += 2;
        }
        return AbiClass::Pieces;
    }
    let size = type_size(ty, pcx);
    if size > 32 {
        return AbiClass::Ref;
    }
    let mut offset: i64 = 0;
    while offset < size {
        abi_add_piece(cx, int_piece_type(size - offset), offset);
        offset += 8;
    }
    AbiClass::Pieces
}

// Whether the leaves just collected are at most four that do not overlap.
fn leaves_as_pieces(cx: &mut FnCtx, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let n = cx.abi_leaves.count / 2;
        if n > 4 {
            return false;
        }
        for i in 0..n {
            let a = (*cx.abi_leaves.data.add((2 * i) as usize));
            let a_end = a + type_size((*cx.abi_leaves.data.add((2 * i + 1) as usize)), pcx);
            for j in i + 1..n {
                let b = (*cx.abi_leaves.data.add((2 * j) as usize));
                let b_end = b + type_size((*cx.abi_leaves.data.add((2 * j + 1) as usize)), pcx);
                if a < b_end && b < a_end {
                    return false;
                }
            }
        }
        true
    }
}

// The machine register of return piece i of the last classified aggregate
// under either convention.
pub fn conv_return_piece_reg(cx: &mut FnCtx, c: bool, i: i64, pcx: &Ctx<Comp>) -> i64 {
    if c {
        return return_piece_reg(cx, i, pcx);
    }
    let mut float = false;
    let index = return_piece_index(cx, i, &mut float, pcx);
    if float {
        return 32 + index;
    }
    if !get_x86() {
        return index;
    }
    // rax, rdx, rcx, rsi.
    if index == 0 { 0 } else if index == 1 { 2 } else if index == 2 { 1 } else { 6 }
}
