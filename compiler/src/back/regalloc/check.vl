// The checker of --verify-regalloc (regalloc/mod.vl): every allocation
// simulated over the control flow graph.

use crate::back::emit::machine::call_returns_through_pointer;
use crate::back::emit::operands::{PM_FIELDS, PM_LOC, pm_dst, pm_kind, pm_result, pm_src, pm_value};
use crate::back::mc_x86_64::ops::ovf_uses_rdx;
use crate::back::regalloc::{LOC_NONE, LOC_REMAT, USE_REG};
use crate::back::regalloc::intervals::is_returns_twice_call;
use crate::back::regalloc::locations::{
    plan_end_moves, plan_gap_moves, plan_start_moves, stored_at_def, tloc, vloc,
};
use crate::back::regalloc::prepare::{
    is_emitted, is_fused_compare, is_live_use, term_uses, tracked, use_kind,
};
use crate::back::regalloc::scan::is_callee_saved_reg;
use crate::base::{alloc_array, buf_fmt, buf_new, buf_write_fd, cstr, die, exit, free, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::in_fregs;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, get_irfuncs, ir_operand, ir_operand_count};
use crate::middle::ir::Op::{Const, Div, MulH, Pack, Param, Phi, Piece, Rem, Shl, Shr};

// ---- Checking (--verify-regalloc) ----
//
// Simulates the moves, definitions and clobbers of the allocation over the
// control flow graph, with the contents of every register and spill slot
// (a value, or -1 when unknown), and checks that every use finds its value
// where the allocation says it is.

fn check_fail(cx: &mut FnCtx, v: i64, message: *mut u8, pcx: &Ctx<Comp>) -> ! {
    unsafe {
        let out = buf_new();
        let name = sym_text(pcx.fns[(*get_irfuncs().add(cx.irf as usize)).f as usize].name, pcx);
        buf_fmt(out,
            { let name = str::from_utf8(name).unwrap();
                format_args("internal error: register allocation of {name}: {} (v{v})\n",
                    str::from_utf8(cstr(message)).unwrap()) });
        buf_write_fd(out, 2);
        exit(1);
    }
}

// The state slot of location loc.
fn check_index(loc: i64) -> i64 {
    if loc >= 0 && loc < 64 {
        return loc;
    }
    if loc < 0 {
        return 64 + (0 - loc - 1);
    }
    -1
}

fn check_get(state: *mut i64, loc: i64) -> i64 {
    let k = check_index(loc);
    if k < 0 { -1 } else { unsafe { (*state.add(k as usize)) } }
}

fn check_set(state: *mut i64, loc: i64, v: i64) {
    let k = check_index(loc);
    if k >= 0 {
        unsafe { (*state.add(k as usize)) = v; }
    }
}

// Value v is used at pos, needing `kind`.
fn check_use(cx: &mut FnCtx, state: *mut i64, v: i64, pos: i64, kind: i64, pcx: &Ctx<Comp>) {
    if !is_live_use(cx, v, kind) {
        return;
    }
    let loc = vloc(cx, v, pos);
    if loc == LOC_NONE {
        check_fail(cx, v, c"an operand without a location", pcx);
    }
    if kind == USE_REG && (loc < 0 || loc >= 64) {
        check_fail(cx, v, c"an operand not in a register", pcx);
    }
    if loc == LOC_REMAT {
        return;
    }
    if check_get(state, loc) != v {
        check_fail(cx, v, c"an operand not where it should be", pcx);
    }
}

// Applies the moves in PM (all sources read first), then clears them.
fn check_moves(cx: &mut FnCtx, state: *mut i64, pcx: &Ctx<Comp>) {
    unsafe {
        let n = cx.pm.count / PM_FIELDS;
        for i in 0..n {
            let value = pm_value(cx, i);
            if pm_kind(cx, i) == PM_LOC && value != 0
                && check_get(state, pm_src(cx, i)) != value {
                check_fail(cx, value, c"a move of the wrong value", pcx);
            }
        }
        for i in 0..n {
            check_set(&mut *state, pm_dst(cx, i), pm_result(cx, i));
        }
        cx.pm.count = 0;
    }
}

fn check_clobber(cx: &mut FnCtx, state: *mut i64, v: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        if op.is_call() {
            let all = is_returns_twice_call(cx, v, pcx);
            for r in 0..64 {
                if all || !is_callee_saved_reg(r) {
                    (*state.add(r as usize)) = -1;
                }
            }
            return;
        }
        if get_x86() && !in_fregs((*cx.insts.add(v as usize)).ty, pcx) && pcx.x86_alloc_acd {
            if op == Div || op == Rem || op == MulH
                || op == Op::Ovf && ovf_uses_rdx((*cx.insts.add(v as usize)).imm) {
                (*state.add(0)) = -1;
                (*state.add(2)) = -1;
            }
            if (op == Shl || op == Shr)
                && (*cx.insts.add((*cx.insts.add(v as usize)).b as usize)).op != Const {
                (*state.add(1)) = -1;
            }
        }
    }
}

// Value v defined at pos: in its location, and in its slot when it is
// stored there.
fn check_def(cx: &mut FnCtx, state: *mut i64, v: i64, pos: i64) {
    unsafe {
        let t = tracked(cx, v);
        if t < 0 {
            return;
        }
        let loc = tloc(cx, t, pos);
        if loc >= 0 && loc < 64 {
            (*state.add(loc as usize)) = v;
        }
        if stored_at_def(cx, t) {
            check_set(state, 0 - (1 + (*cx.rv_slot.add(t as usize))), v);
        }
    }
}

fn ra_check_block(cx: &mut FnCtx, state: *mut i64, b: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let k = (*cx.blocks.add(b as usize)).order;
        let start = (*cx.bstart.data.add(k as usize));
        plan_start_moves(cx, b);
        check_moves(cx, state, pcx);
        // Phis and parameters.
        let mut v = (*cx.blocks.add(b as usize)).first;
        while v != 0 {
            let t = tracked(cx, v);
            let op = (*cx.insts.add(v as usize)).op;
            if t >= 0 && (op == Phi || op == Param) {
                let loc = tloc(cx, t, start);
                if op == Param {
                    check_set(&mut *state, loc, v);
                } else if check_get(state, loc) != v {
                    check_fail(cx, v, c"a phi not where it should be", pcx);
                }
                if stored_at_def(cx, t) {
                    check_set(&mut *state, 0 - (1 + (*cx.rv_slot.add(t as usize))), v);
                }
            }
            v = (*cx.insts.add(v as usize)).next;
        }
        v = (*cx.blocks.add(b as usize)).first;
        while v != 0 {
            let op = (*cx.insts.add(v as usize)).op;
            if op == Phi || op == Param || is_fused_compare(cx, v) {
                v = (*cx.insts.add(v as usize)).next;
                continue;
            }
            let p = (*cx.insts.add(v as usize)).mark;
            plan_gap_moves(cx, p - 1);
            check_moves(cx, state, pcx);
            if op == Piece || op == Pack {
                // Defined by their call; read by the RET.
                v = (*cx.insts.add(v as usize)).next;
                continue;
            }
            for i in 0..ir_operand_count(cx, v) {
                let operand = ir_operand(cx, v, i);
                if operand != 0
                    && !(op.is_call() && i == 2 && !call_returns_through_pointer(cx, v, pcx)) {
                    let use_kind_v = use_kind(cx, v, i, pcx);
                    check_use(cx, state, operand, p, use_kind_v, pcx);
                }
            }
            check_clobber(cx, &mut *state, v, pcx);
            if op.is_call() && (*cx.insts.add(v as usize)).c != 0
                && !call_returns_through_pointer(cx, v, pcx) {
                let arg_v = (*cx.insts.add(v as usize)).c;
                let use_kind_v1 = use_kind(cx, v, 2, pcx);
                check_use(cx, state, arg_v, p + 2, use_kind_v1, pcx);
            }
            if is_emitted(cx, v) {
                check_def(cx, &mut *state, v, p + 2);
            }
            if op.is_call() {
                let mut w = (*cx.insts.add(v as usize)).next;
                while w != 0 {
                    if (*cx.insts.add(w as usize)).op == Piece && (*cx.insts.add(w as usize)).a == v
                        && tracked(cx, w) >= 0 {
                        check_def(cx, &mut *state, w, p + 2);
                    }
                    w = (*cx.insts.add(w as usize)).next;
                }
            }
            v = (*cx.insts.add(v as usize)).next;
        }
        let end = (*cx.bend.data.add(k as usize));
        plan_gap_moves(cx, end - 1);
        check_moves(cx, state, pcx);
        let mut out: [i64; 8] = [0i64; 8];
        let count = term_uses(cx, b, out.as_mut_ptr() as *mut i64, pcx);
        for i in 0..count {
            check_use(cx, state, out[(2 * i) as usize], end, out[(2 * i + 1) as usize], pcx);
        }
        plan_end_moves(cx, b);
        check_moves(cx, state, pcx);
    }
}

pub fn check_allocation(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let n = cx.order.count;
        cx.check_width = 64 + cx.spill_count;
        // Per layout index: the state at the end of the block (-2: not reached
        // yet).
        let exits = alloc_array::<i64>(n * cx.check_width + 1);
        for i in 0..n * cx.check_width {
            (*exits.add(i as usize)) = -2;
        }
        let state = alloc_array::<i64>(cx.check_width + 1);
        let mut changed = true;
        let mut rounds: i64 = 0;
        while changed {
            changed = false;
            rounds += 1;
            if rounds > 1000 {
                die(c"internal error: the register allocation check does not settle");
            }
            for k in 0..n {
                let b = (*cx.order.data.add(k as usize));
                // The meet of the predecessors' exits (unknown where they
                // disagree).
                let mut first = true;
                for i in 0..cx.check_width {
                    (*state.add(i as usize)) = -1;
                }
                for p in (*cx.blocks.add(b as usize)).preds.items() {
                    let pk = (*cx.blocks.add(p as usize)).order;
                    if pk < 0 || (*exits.add((pk * cx.check_width) as usize)) == -2 {
                        continue;
                    }
                    for j in 0..cx.check_width {
                        let x = (*exits.add((pk * cx.check_width + j) as usize));
                        if first {
                            (*state.add(j as usize)) = x;
                        } else if (*state.add(j as usize)) != x {
                            (*state.add(j as usize)) = -1;
                        }
                    }
                    first = false;
                }
                if first && k != 0 {
                    continue;
                }
                ra_check_block(cx, state, b, pcx);
                // -2 marks "not reached": a reached state never holds it.
                for j in 0..cx.check_width {
                    let x: i64 = if (*state.add(j as usize)) == -2 { -1 }
                        else { (*state.add(j as usize)) };
                    if (*exits.add((k * cx.check_width + j) as usize)) != x {
                        (*exits.add((k * cx.check_width + j) as usize)) = x;
                        changed = true;
                    }
                }
            }
        }
        free(exits as *mut u8);
        free(state as *mut u8);
    }
}
