// The linear scan (regalloc/mod.vl): the registers each class of value
// may get, intervals given free registers or registers taken from others,
// splits at loop entries, and spill slots for the values that go to the
// stack.

use crate::back::regalloc::{ON_STACK, POS_MAX, UNASSIGNED, USE_REG};
use crate::back::regalloc::intervals::{
    block_at, covers, gap_before, min_i64, move_point_before, next_intersection, next_use, ra_end,
    ra_start, split_at, split_point,
};
use crate::base::{IntVec, die, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{in_fregs, is_vector, max_i64, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Op::Phi;

// ---- Registers ----

// The registers allocated, in order of preference: caller-saved first.
fn class_regs(float: bool, vector: bool, regs: *mut i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut n: i64 = 0;
        if get_x86() {
            if float {
                for r in 2..14 { (*regs.add(n as usize)) = 32 + r; n += 1; }
                (*regs.add(n as usize)) = 32; n += 1;
                (*regs.add(n as usize)) = 33; n += 1;
                return n;
            }
            let list: [i64; 12] = [6i64, 7, 8, 9, 0, 1, 2, 3, 12, 13, 14, 15];
            for i in 0..12 {
                if is_allocatable(list[i as usize], pcx) {
                    (*regs.add(n as usize)) = list[i as usize];
                    n += 1;
                }
            }
            return n;
        }
        if float {
            for r in 16..30 { (*regs.add(n as usize)) = 32 + r; n += 1; }
            for r in 0..8 { (*regs.add(n as usize)) = 32 + r; n += 1; }
            if !vector {
                for r in 8..16 { (*regs.add(n as usize)) = 32 + r; n += 1; }
            }
            return n;
        }
        for r in 9..16 { (*regs.add(n as usize)) = r; n += 1; }
        for r in 0..9 { (*regs.add(n as usize)) = r; n += 1; }
        for r in 19..29 { (*regs.add(n as usize)) = r; n += 1; }
        n
    }
}

pub fn is_allocatable(r: i64, pcx: &Ctx<Comp>) -> bool {
    if get_x86() {
        if r >= 32 {
            return r < 46;
        }
        if r == 0 || r == 1 || r == 2 {
            return pcx.x86_alloc_acd;
        }
        return r == 3 || r == 6 || r == 7 || r == 8 || r == 9 || (r >= 12 && r <= 15);
    }
    if r >= 32 {
        return r < 62;
    }
    r <= 15 || (r >= 19 && r <= 28)
}

pub fn is_callee_saved_reg(r: i64) -> bool {
    if get_x86() {
        return r == 3 || (r >= 12 && r <= 15);
    }
    (r >= 19 && r <= 28) || (r >= 40 && r <= 47)
}

// ---- Linear scan ----

fn heap_less(cx: &mut FnCtx, a: i64, b: i64) -> bool {
    let sa = ra_start(cx, a);
    let sb = ra_start(cx, b);
    sa < sb || (sa == sb && a < b)
}

fn heap_push(cx: &mut FnCtx, i: i64) {
    unsafe {
        cx.unhandled.push(i);
        let mut k = cx.unhandled.count - 1;
        while k > 0 {
            let parent = (k - 1) / 2;
            if !heap_less(cx, (*cx.unhandled.data.add(k as usize)), (*cx.unhandled.data.add(parent as usize))) {
                break;
            }
            let t = (*cx.unhandled.data.add(k as usize));
            (*cx.unhandled.data.add(k as usize)) = (*cx.unhandled.data.add(parent as usize));
            (*cx.unhandled.data.add(parent as usize)) = t;
            k = parent;
        }
    }
}

fn heap_pop(cx: &mut FnCtx) -> i64 {
    unsafe {
        let top = (*cx.unhandled.data.add(0));
        cx.unhandled.count -= 1;
        let n = cx.unhandled.count;
        if n > 0 {
            (*cx.unhandled.data.add(0)) = (*cx.unhandled.data.add(n as usize));
            let mut k: i64 = 0;
            loop {
                let l = 2 * k + 1;
                let r = l + 1;
                let mut m = k;
                if l < n && heap_less(cx, (*cx.unhandled.data.add(l as usize)), (*cx.unhandled.data.add(m as usize))) {
                    m = l;
                }
                if r < n && heap_less(cx, (*cx.unhandled.data.add(r as usize)), (*cx.unhandled.data.add(m as usize))) {
                    m = r;
                }
                if m == k {
                    break;
                }
                let t = (*cx.unhandled.data.add(k as usize));
                (*cx.unhandled.data.add(k as usize)) = (*cx.unhandled.data.add(m as usize));
                (*cx.unhandled.data.add(m as usize)) = t;
                k = m;
            }
        }
        top
    }
}

fn iv_float(cx: &mut FnCtx, i: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe { in_fregs((*cx.insts.add((*cx.ra_vals.data.add((*cx.ivs.add(i as usize)).value as usize)) as usize)).ty, pcx) }
}

// A vector (0.10): in a float register, but never in one whose upper half
// a call may change (d8-d15 keep only their low 64 bits on AArch64).
fn iv_vector(cx: &mut FnCtx, i: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe { is_vector((*cx.insts.add((*cx.ra_vals.data.add((*cx.ivs.add(i as usize)).value as usize)) as usize)).ty, pcx) }
}

// Whether register r may hold interval i.
fn reg_fits(cx: &mut FnCtx, i: i64, r: i64, pcx: &Ctx<Comp>) -> bool {
    r >= 0 && (r >= 32) == iv_float(cx, i, pcx) && is_allocatable(r, pcx)
        && !(iv_vector(cx, i, pcx) && !get_x86() && r >= 40 && r < 48)
}

fn iv_remat(cx: &mut FnCtx, i: i64) -> bool {
    unsafe { (*cx.insts.add((*cx.ra_vals.data.add((*cx.ivs.add(i as usize)).value as usize)) as usize)).op.is_remat() }
}

// How soon a use at `pos` comes after `from`, for choosing what to spill:
// uses in loops count as nearer (by 4 per level), remat values are cheap
// to bring back; between equals, the nearer position.
fn use_distance(cx: &mut FnCtx, i: i64, pos: i64, from: i64) -> i64 {
    if pos >= POS_MAX {
        return POS_MAX;
    }
    let depth = unsafe { min_i64((*cx.ldepth.data.add(block_at(cx, pos) as usize)), 6) };
    let raw = pos - from;
    let mut d = raw >> (2 * depth) as u64;
    // A constant is cheap to bring back, unless it is needed by the very
    // next instruction (two constants needed there would take each
    // other's register forever).
    if iv_remat(cx, i) && raw > 4 {
        d = d * 4 + 3;
    }
    (d << 20) | min_i64(raw, 0xfffff)
}

// The register the value of interval i would like, or -1: its partner's
// (a phi and its operands), else the register it arrives in or goes to.
fn hint_reg(cx: &mut FnCtx, i: i64) -> i64 {
    unsafe {
        let t = (*cx.ivs.add(i as usize)).value;
        let mut other = (*cx.rv_hint.add(t as usize));
        // The partner's register, or (not allocated yet) its own partner's.
        for _ in 0..2 {
            if other < 0 || other == t {
                break;
            }
            let mut j = (*cx.rv_first.add(other as usize));
            while j >= 0 {
                if (*cx.ivs.add(j as usize)).reg >= 0 {
                    return (*cx.ivs.add(j as usize)).reg;
                }
                j = (*cx.ivs.add(j as usize)).next;
            }
            other = (*cx.rv_hint.add(other as usize));
        }
        (*cx.rv_hreg.add(t as usize))
    }
}

fn assign(cx: &mut FnCtx, i: i64, r: i64) {
    unsafe { (*cx.ivs.add(i as usize)).reg = r; }
    if is_callee_saved_reg(r) {
        cx.callee_used[r as usize] = 1;
    }
}

fn ra_dominators(cx: &mut FnCtx) {
    unsafe {
        if cx.ra_idom_ready {
            return;
        }
        cx.ra_idom_ready = true;
        let n = cx.order.count;
        cx.ra_idom.count = 0;
        for k in 0..n {
            cx.ra_idom.push(if k == 0 { 0 } else { -1 });
        }
        let mut changed = true;
        while changed {
            changed = false;
            for k in 1..n {
                let b = (*cx.order.data.add(k as usize));
                let mut idom: i64 = -1;
                for i in 0..(*cx.blocks.add(b as usize)).preds.count {
                    let pk = (*cx.blocks.add((*(*cx.blocks.add(b as usize)).preds.data.add(i as usize)) as usize)).order;
                    if pk < 0 || (*cx.ra_idom.data.add(pk as usize)) < 0 {
                        continue;
                    }
                    if idom < 0 {
                        idom = pk;
                    } else {
                        let mut x = pk;
                        let mut y = idom;
                        while x != y {
                            while x > y {
                                x = (*cx.ra_idom.data.add(x as usize));
                            }
                            while y > x {
                                y = (*cx.ra_idom.data.add(y as usize));
                            }
                        }
                        idom = x;
                    }
                }
                if idom != (*cx.ra_idom.data.add(k as usize)) {
                    (*cx.ra_idom.data.add(k as usize)) = idom;
                    changed = true;
                }
            }
        }
    }
}

fn ra_dominates(cx: &mut FnCtx, a: i64, x: i64) -> bool {
    let mut y = x;
    while y > a {
        unsafe { y = (*cx.ra_idom.data.add(y as usize)); }
    }
    y == a
}

// Whether interval i (a whole value) can move to its second location at
// the start of block k (in no loop): k dominates every block at or after
// it where the value lives. (A block in no loop reaches only blocks after
// it in the layout, a reverse post-order: going back takes a back edge,
// into a loop that would contain it. So no block before k where the value
// lives can see the second location.)
fn entry_split_ok(cx: &mut FnCtx, i: i64, k: i64) -> bool {
    ra_dominators(cx);
    let n = cx.order.count;
    unsafe {
        for j in 0..(*cx.ivs.add(i as usize)).ranges.count / 2 {
            let from = (*(*cx.ivs.add(i as usize)).ranges.data.add((2 * j) as usize));
            let to = (*(*cx.ivs.add(i as usize)).ranges.data.add((2 * j + 1) as usize));
            let mut b = max_i64(block_at(cx, from), k);
            while b < n && (*cx.bstart.data.add(b as usize)) < to {
                if !ra_dominates(cx, k, b) {
                    return false;
                }
                b += 1;
            }
        }
    }
    true
}

// A value defined in the entry block (a parameter, mostly) that would take
// a callee-saved register for its whole lifetime: it keeps a caller-saved
// one (its hint first) until just before that one is needed elsewhere (a
// call, usually), when that is past the entry block, and the rest goes on.
// Moving it into the callee-saved register there rather than at the entry
// costs the same move, and leaves the paths that return before any call
// without a frame (shrink-wrapping, see emit.vl).
fn try_entry_split(cx: &mut FnCtx, cur: i64, hint: i64, regs: *mut i64, n: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let start = ra_start(cx, cur);
        if block_at(cx, start) != 0 || (*cx.rv_first.add((*cx.ivs.add(cur as usize)).value as usize)) != cur || cx.returns_twice {
            return false;
        }
        let mut c: i64 = -1;
        if reg_fits(cx, cur, hint, pcx) && !is_callee_saved_reg(hint)
            && cx.free_until[hint as usize] > (*cx.bend.data.add(0)) {
            c = hint;
        } else {
            for k in 0..n {
                let r = (*regs.add(k as usize));
                if !is_callee_saved_reg(r) && (c < 0 || cx.free_until[r as usize] > cx.free_until[c as usize]) {
                    c = r;
                }
            }
        }
        if c < 0 || cx.free_until[c as usize] <= (*cx.bend.data.add(0)) {
            return false;
        }
        let end = ra_end(cx, cur);
        if cx.free_until[c as usize] >= end {
            // Free all along: no callee-saved register is needed at all.
            assign(cx, cur, c);
            return true;
        }
        // Out of loops, where every later use passes: in the block of the
        // conflict, or at the start of the last block before it that is in no
        // loop and dominates the rest of the value's blocks (in layout order,
        // a loop run before it may come after it).
        let limit = cx.free_until[c as usize];
        let mut k = block_at(cx, limit);
        let mut split: i64 = -1;
        if (*cx.ldepth.data.add(k as usize)) == 0 && entry_split_ok(cx, cur, k) {
            split = move_point_before(cx, limit, start + 1);
        }
        while split < 0 && k > 0 {
            if (*cx.ldepth.data.add(k as usize)) == 0 && (*cx.bstart.data.add(k as usize)) < limit && entry_split_ok(cx, cur, k) {
                split = (*cx.bstart.data.add(k as usize));
            }
            k -= 1;
        }
        if split <= start || split >= end || block_at(cx, split) == 0 {
            return false;
        }
        assign(cx, cur, c);
        let split_at_v = split_at(cx, cur, split);
        heap_push(cx, split_at_v);
        true
    }
}

// Whether v is a phi of a loop header (a block with a back edge into it).
fn is_loop_phi(cx: &mut FnCtx, v: i64) -> bool {
    unsafe {
        if (*cx.insts.add(v as usize)).op != Phi {
            return false;
        }
        let b = (*cx.insts.add(v as usize)).block;
        let k = (*cx.blocks.add(b as usize)).order;
        for i in 0..(*cx.blocks.add(b as usize)).preds.count {
            if (*cx.blocks.add((*(*cx.blocks.add(b as usize)).preds.data.add(i as usize)) as usize)).order >= k {
                return true;
            }
        }
        false
    }
}

// After build_intervals: which registers' fixed ranges are the same.
fn find_same_fixed(cx: &mut FnCtx) {
    unsafe {
        for r in 0..64 {
            cx.fixed_canon[r as usize] = r;
            cx.fix_at[r as usize] = 0;
            if (*cx.fixed.add(r as usize)).count == 0 {
                continue;
            }
            for q in 0..r {
                if cx.fixed_canon[q as usize] == q && (*cx.fixed.add(q as usize)).count == (*cx.fixed.add(r as usize)).count
                    && same_ranges(cx.fixed.add(q as usize), cx.fixed.add(r as usize)) {
                    cx.fixed_canon[r as usize] = q;
                    break;
                }
            }
        }
    }
}

fn same_ranges(a: *mut IntVec, b: *mut IntVec) -> bool {
    unsafe {
        for i in 0..a.count {
            if (*a.data.add(i as usize)) != (*b.data.add(i as usize)) {
                return false;
            }
        }
    }
    true
}

// next_intersection(&FIXED[r], &IVS[i].ranges, from), shared (see
// FIXED_CANON).
fn fixed_intersection(cx: &mut FnCtx, r: i64, i: i64, from: i64) -> i64 {
    unsafe {
        let c = cx.fixed_canon[r as usize];
        if cx.fix_at[c as usize] == cx.fix_step && cx.fix_iv[c as usize] == i && cx.fix_from[c as usize] == from {
            return cx.fix_x[c as usize];
        }
        let x = next_intersection(cx.fixed.add(c as usize), &mut (*cx.ivs.add(i as usize)).ranges, from);
        cx.fix_at[c as usize] = cx.fix_step;
        cx.fix_iv[c as usize] = i;
        cx.fix_from[c as usize] = from;
        cx.fix_x[c as usize] = x;
        x
    }
}

// Whether interval i lives across a call: every caller-saved register of
// `regs` is clobbered somewhere in it.
fn crosses_calls(cx: &mut FnCtx, i: i64, regs: *mut i64, n: i64) -> bool {
    unsafe {
        let mut any = false;
        for k in 0..n {
            let r = (*regs.add(k as usize));
            if is_callee_saved_reg(r) {
                continue;
            }
            any = true;
            if (*cx.fixed.add(r as usize)).count == 0 || fixed_intersection(cx, r, i, 0) == POS_MAX {
                return false;
            }
        }
        any
    }
}

// Gives interval cur register r, free for its whole lifetime: unless r is
// callee-saved and an entry split keeps it in a caller-saved one first.
fn assign_whole(cx: &mut FnCtx, cur: i64, r: i64, hint: i64, regs: *mut i64, n: i64, pcx: &Ctx<Comp>) {
    if is_callee_saved_reg(r) && try_entry_split(cx, cur, hint, regs, n, pcx) {
        return;
    }
    assign(cx, cur, r);
}

fn try_allocate_free(cx: &mut FnCtx, cur: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        cx.fix_step += 1;
        let mut regs: [i64; 32] = [0i64; 32];
        let n = class_regs(iv_float(cx, cur, pcx), iv_vector(cx, cur, pcx), regs.as_mut_ptr() as *mut i64, pcx);
        let start = ra_start(cx, cur);
        let end = ra_end(cx, cur);
        for k in 0..n {
            cx.free_until[regs[k as usize] as usize] = POS_MAX;
        }
        for k in 0..cx.active.count {
            cx.free_until[(*cx.ivs.add((*cx.active.data.add(k as usize)) as usize)).reg as usize] = 0;
        }
        for a in cx.inactive.items() {
            let r = (*cx.ivs.add(a as usize)).reg;
            if cx.free_until[r as usize] > 0 {
                let x = next_intersection(&mut (*cx.ivs.add(a as usize)).ranges, &mut (*cx.ivs.add(cur as usize)).ranges, start);
                if x < cx.free_until[r as usize] {
                    cx.free_until[r as usize] = x;
                }
            }
        }
        for k in 0..n {
            let r = regs[k as usize];
            if cx.free_until[r as usize] > 0 && (*cx.fixed.add(r as usize)).count > 0 {
                let x = fixed_intersection(cx, r, cur, start);
                if x < cx.free_until[r as usize] {
                    cx.free_until[r as usize] = x;
                }
            }
        }
        let hint = hint_reg(cx, cur);
        // Out of loops, a value that lives across no call does not follow its
        // hint into a callee-saved register: the move the hint saves runs
        // once, the frame it may force on paths that need none (see
        // shrink-wrapping in emit.vl) every time.
        let cheap_hint = !is_callee_saved_reg(hint) || (*cx.ldepth.data.add(block_at(cx, start) as usize)) != 0
            || crosses_calls(cx, cur, regs.as_mut_ptr() as *mut i64, n);
        if reg_fits(cx, cur, hint, pcx) && cx.free_until[hint as usize] >= end && cheap_hint {
            assign_whole(cx, cur, hint, hint, regs.as_mut_ptr() as *mut i64, n, pcx);
            return true;
        }
        // The partner not allocated yet will need a callee-saved register (it
        // lives across a call): one free now can be both's.
        let partner = (*cx.rv_hint.add((*cx.ivs.add(cur as usize)).value as usize));
        if hint < 0 && partner >= 0 && partner != (*cx.ivs.add(cur as usize)).value && (*cx.rv_first.add(partner as usize)) >= 0
            && is_loop_phi(cx, (*cx.ra_vals.data.add((*cx.ivs.add(cur as usize)).value as usize)))
            && (*cx.ivs.add((*cx.rv_first.add(partner as usize)) as usize)).reg == UNASSIGNED
            && crosses_calls(cx, (*cx.rv_first.add(partner as usize)), regs.as_mut_ptr() as *mut i64, n) {
            for k in 0..n {
                let r = regs[k as usize];
                if is_callee_saved_reg(r) && cx.free_until[r as usize] >= end {
                    assign_whole(cx, cur, r, hint, regs.as_mut_ptr() as *mut i64, n, pcx);
                    return true;
                }
            }
        }
        // Else the argument or result register the value goes to, when the
        // partner's is taken.
        let to = (*cx.rv_hreg.add((*cx.ivs.add(cur as usize)).value as usize));
        if to != hint && reg_fits(cx, cur, to, pcx) && cx.free_until[to as usize] >= end {
            assign_whole(cx, cur, to, hint, regs.as_mut_ptr() as *mut i64, n, pcx);
            return true;
        }
        let mut best = regs[0];
        for k in 0..n {
            let r = regs[k as usize];
            if cx.free_until[r as usize] >= end {
                assign_whole(cx, cur, r, hint, regs.as_mut_ptr() as *mut i64, n, pcx);
                return true;
            }
            if cx.free_until[r as usize] > cx.free_until[best as usize] {
                best = r;
            }
        }
        if cx.free_until[best as usize] <= start {
            return false;
        }
        // Free for a first part only.
        let split = split_point(cx, start + 1, cx.free_until[best as usize]);
        if split <= start {
            return false;
        }
        assign(cx, cur, best);
        let split_at_v = split_at(cx, cur, split);
        heap_push(cx, split_at_v);
        true
    }
}

// Interval a gives up its register from pos on: the rest goes to the
// stack until just before its next use in a register.
fn spill_from(cx: &mut FnCtx, a: i64, pos: i64) {
    unsafe {
        let mut rest = a;
        if ra_start(cx, a) < pos {
            rest = split_at(cx, a, pos);
        }
        (*cx.ivs.add(rest as usize)).reg = ON_STACK;
        let start = ra_start(cx, rest);
        let u = next_use(cx, rest, start, USE_REG);
        if u == POS_MAX {
            return;
        }
        let split = split_point(cx, start + 1, gap_before(u));
        if split <= start {
            // Needed in a register right away: allocate it again.
            (*cx.ivs.add(rest as usize)).reg = UNASSIGNED;
            heap_push(cx, rest);
            return;
        }
        let split_at_v = split_at(cx, rest, split);
        heap_push(cx, split_at_v);
    }
}

fn remove_at(list: &mut IntVec, k: i64) {
    unsafe {
        (*list.data.add(k as usize)) = (*list.data.add((list.count - 1) as usize));
        list.count -= 1;
    }
}

fn allocate_blocked(cx: &mut FnCtx, cur: i64, pcx: &Ctx<Comp>) {
    unsafe {
        cx.fix_step += 1;
        let mut regs: [i64; 32] = [0i64; 32];
        let n = class_regs(iv_float(cx, cur, pcx), iv_vector(cx, cur, pcx), regs.as_mut_ptr() as *mut i64, pcx);
        let start = ra_start(cx, cur);
        for k in 0..n {
            cx.use_pos[regs[k as usize] as usize] = POS_MAX;
            cx.block_pos[regs[k as usize] as usize] = POS_MAX;
        }
        for a in cx.active.items() {
            let r = (*cx.ivs.add(a as usize)).reg;
            let next_use_v = next_use(cx, a, start, USE_REG);
            let u = use_distance(cx, a, next_use_v, start);
            if u < cx.use_pos[r as usize] {
                cx.use_pos[r as usize] = u;
            }
        }
        for a in cx.inactive.items() {
            let r = (*cx.ivs.add(a as usize)).reg;
            if next_intersection(&mut (*cx.ivs.add(a as usize)).ranges, &mut (*cx.ivs.add(cur as usize)).ranges, start) < POS_MAX {
                let next_use_v1 = next_use(cx, a, start, USE_REG);
                let u = use_distance(cx, a, next_use_v1, start);
                if u < cx.use_pos[r as usize] {
                    cx.use_pos[r as usize] = u;
                }
            }
        }
        let end = ra_end(cx, cur);
        let first = next_use(cx, cur, start, USE_REG);
        if first == POS_MAX {
            (*cx.ivs.add(cur as usize)).reg = ON_STACK;
            return;
        }
        // A register is a candidate when no fixed interval takes it before
        // the first use, nor before a place to give it back; the best one is
        // taken from the intervals whose next use is farthest.
        let mut best: i64 = -1;
        for k in 0..n {
            let r = regs[k as usize];
            if (*cx.fixed.add(r as usize)).count > 0 {
                let x = fixed_intersection(cx, r, cur, start);
                cx.block_pos[r as usize] = x;
                if x <= first || (x < end && split_point(cx, start + 1, x) <= start) {
                    continue;
                }
            }
            if best < 0 || cx.use_pos[r as usize] > cx.use_pos[best as usize] {
                best = r;
            }
        }
        let split = split_point(cx, start + 1, gap_before(first));
        if split > start && (best < 0 || cx.use_pos[best as usize] <= use_distance(cx, cur, first, start)) {
            // Every register is needed as soon: to the stack until its first
            // use.
            (*cx.ivs.add(cur as usize)).reg = ON_STACK;
            let split_at_v = split_at(cx, cur, split);
            heap_push(cx, split_at_v);
            return;
        }
        if best < 0 {
            die(c"internal error: no register for an operand");
        }
        assign(cx, cur, best);
        if cx.block_pos[best as usize] < ra_end(cx, cur) {
            let at = split_point(cx, start + 1, cx.block_pos[best as usize]);
            if at <= start {
                die(c"internal error: no place to split before a fixed register");
            }
            let split_at_v1 = split_at(cx, cur, at);
            heap_push(cx, split_at_v1);
        }
        // Take the register from the intervals holding it.
        let mut k: i64 = 0;
        while k < cx.active.count {
            let a = (*cx.active.data.add(k as usize));
            if (*cx.ivs.add(a as usize)).reg == best {
                remove_at(&mut cx.active, k);
                spill_from(cx, a, start);
            } else {
                k += 1;
            }
        }
        k = 0;
        while k < cx.inactive.count {
            let a = (*cx.inactive.data.add(k as usize));
            if (*cx.ivs.add(a as usize)).reg == best
                && next_intersection(&mut (*cx.ivs.add(a as usize)).ranges, &mut (*cx.ivs.add(cur as usize)).ranges, start) < POS_MAX {
                remove_at(&mut cx.inactive, k);
                spill_from(cx, a, start);
            } else {
                k += 1;
            }
        }
    }
}

pub fn linear_scan(cx: &mut FnCtx, pcx: &Ctx<Comp>) {
    unsafe {
        for r in 0..64 {
            cx.callee_used[r as usize] = 0;
        }
        find_same_fixed(cx);
        cx.active.count = 0;
        cx.inactive.count = 0;
        cx.unhandled.count = 0;
        for t in 0..cx.ra_vals.count {
            heap_push(cx, (*cx.rv_first.add(t as usize)));
        }
        let mut steps: i64 = 0;
        while cx.unhandled.count > 0 {
            let cur = heap_pop(cx);
            steps += 1;
            if steps > 64 * (cx.ra_vals.count + 16) * 16 {
                die(c"internal error: register allocation does not finish");
            }
            let pos = ra_start(cx, cur);
            let mut k: i64 = 0;
            while k < cx.active.count {
                let a = (*cx.active.data.add(k as usize));
                if ra_end(cx, a) <= pos {
                    remove_at(&mut cx.active, k);
                } else if !covers(cx, a, pos) {
                    remove_at(&mut cx.active, k);
                    cx.inactive.push(a);
                } else {
                    k += 1;
                }
            }
            k = 0;
            while k < cx.inactive.count {
                let a = (*cx.inactive.data.add(k as usize));
                if ra_end(cx, a) <= pos {
                    remove_at(&mut cx.inactive, k);
                } else if covers(cx, a, pos) {
                    remove_at(&mut cx.inactive, k);
                    cx.active.push(a);
                } else {
                    k += 1;
                }
            }
            if !try_allocate_free(cx, cur, pcx) {
                allocate_blocked(cx, cur, pcx);
            }
            if (*cx.ivs.add(cur as usize)).reg >= 0 {
                cx.active.push(cur);
            }
        }
        sort_split_moves(cx);
        assign_spill_slots(cx, pcx);
    }
}

fn sort_split_moves(cx: &mut FnCtx) {
    unsafe {
        // Insertion sort by gap (stable), on (gap, value) pairs.
        let n = cx.split_moves.count / 2;
        for i in 1..n {
            let g = (*cx.split_moves.data.add((2 * i) as usize));
            let t = (*cx.split_moves.data.add((2 * i + 1) as usize));
            let mut j = i;
            while j > 0 && (*cx.split_moves.data.add((2 * (j - 1)) as usize)) > g {
                (*cx.split_moves.data.add((2 * j) as usize)) = (*cx.split_moves.data.add((2 * (j - 1)) as usize));
                (*cx.split_moves.data.add((2 * j + 1) as usize)) = (*cx.split_moves.data.add((2 * (j - 1) + 1) as usize));
                j -= 1;
            }
            (*cx.split_moves.data.add((2 * j) as usize)) = g;
            (*cx.split_moves.data.add((2 * j + 1) as usize)) = t;
        }
    }
}

// Spill slots: a value that is on the stack anywhere gets one, shared
// with values whose lifetimes (from definition to last use) do not
// overlap its own.
fn assign_spill_slots(cx: &mut FnCtx, pcx: &Ctx<Comp>) {
    unsafe {
        cx.spill_count = 0;
        let mut spilled = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for t in 0..cx.ra_vals.count {
            if (*cx.insts.add((*cx.ra_vals.data.add(t as usize)) as usize)).op.is_remat() {
                continue;
            }
            let mut i = (*cx.rv_first.add(t as usize));
            while i >= 0 {
                if (*cx.ivs.add(i as usize)).reg == ON_STACK {
                    spilled.push(t);
                    break;
                }
                i = (*cx.ivs.add(i as usize)).next;
            }
        }
        // By start of lifetime (values are numbered in layout order, but phis
        // and parameters come first in their block: sort to be sure).
        let n = spilled.count;
        for i in 1..n {
            let t = (*spilled.data.add(i as usize));
            let s = value_start(cx, t);
            let mut j = i;
            while j > 0 && value_start(cx, (*spilled.data.add((j - 1) as usize))) > s {
                (*spilled.data.add(j as usize)) = (*spilled.data.add((j - 1) as usize));
                j -= 1;
            }
            (*spilled.data.add(j as usize)) = t;
        }
        // slot_end[i]: where the lifetime of the value in slot i ends. A
        // vector (0.10) takes two slots, the first of them even (the spill
        // area is then 16-aligned); a 256-bit one (0.19, x86-64's ymm) four,
        // the first a multiple of four.
        let mut slot_end = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        cx.spill_vectors = false;
        for i in 0..n {
            let t = (*spilled.data.add(i as usize));
            let s = value_start(cx, t);
            let ty = (*cx.insts.add((*cx.ra_vals.data.add(t as usize)) as usize)).ty;
            let wide = is_vector(ty, pcx);
            let step: i64 = if !wide { 1 } else if type_size(ty, pcx) == 32 { 4 } else { 2 };
            let mut slot: i64 = -1;
            let mut k: i64 = 0;
            while k + step <= slot_end.count {
                let mut free = !cx.returns_twice;
                for j in 0..step {
                    if (*slot_end.data.add((k + j) as usize)) > s {
                        free = false;
                    }
                }
                if free {
                    slot = k;
                    break;
                }
                k += step;
            }
            if slot < 0 {
                while slot_end.count % step != 0 {
                    slot_end.push(0);
                }
                slot = slot_end.count;
                for _ in 0..step {
                    slot_end.push(0);
                }
            }
            for j in 0..step {
                (*slot_end.data.add((slot + j) as usize)) = value_end(cx, t);
            }
            if wide {
                cx.spill_vectors = true;
            }
            (*cx.rv_slot.add(t as usize)) = slot;
        }
        cx.spill_count = slot_end.count;
        free(spilled.data as *mut u8);
        free(slot_end.data as *mut u8);
    }
}

pub fn value_start(cx: *mut FnCtx, t: i64) -> i64 {
    unsafe { ra_start(&mut *cx, (*cx.rv_first.add(t as usize))) }
}

fn value_end(cx: &mut FnCtx, t: i64) -> i64 {
    unsafe {
        let mut i = (*cx.rv_first.add(t as usize));
        while (*cx.ivs.add(i as usize)).next >= 0 {
            i = (*cx.ivs.add(i as usize)).next;
        }
        ra_end(cx, i)
    }
}
