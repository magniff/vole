// Where the allocation (regalloc/mod.vl) put each value: its location
// at a position, the blocks that need the frame, and the moves that
// reconcile locations inside blocks and on edges.

use crate::back::emit::operands::{PM_LOC, PM_REMAT, pm_add};
use crate::back::regalloc::{LOC_NONE, LOC_REMAT, ON_STACK, UNASSIGNED};
use crate::back::regalloc::intervals::{block_at, ra_start, trailing_zeros};
use crate::back::regalloc::prepare::{live_set, tracked};
use crate::back::regalloc::scan::{is_callee_saved_reg, value_start};
use crate::base::die;
use crate::front::types::max_i64;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Term, ir_arg};
use crate::middle::ir::Op::Phi;
use crate::middle::ir::cfg::{pred_index, succ_count};

// The interval of dense index t holding position pos.
fn interval_at(cx: &mut FnCtx, t: i64, pos: i64) -> i64 {
    unsafe {
        let mut i = (*cx.rv_first.add(t as usize));
        while (*cx.ivs.add(i as usize)).next >= 0
            && ra_start(cx, (*cx.ivs.add(i as usize)).next) <= pos {
            i = (*cx.ivs.add(i as usize)).next;
        }
        i
    }
}

// The location of dense index t at position pos.
pub fn tloc(cx: &mut FnCtx, t: i64, pos: i64) -> i64 {
    unsafe {
        let r = { let at_ix = interval_at(cx, t, pos) as usize; (*cx.ivs.add(at_ix)) }.reg;
        if r >= 0 {
            return r;
        }
        if r == UNASSIGNED {
            die(c"internal error: an interval without a location");
        }
        if (*cx.insts.add((*cx.ra_vals.data.add(t as usize)) as usize)).op.is_remat() {
            return LOC_REMAT;
        }
        0 - (1 + (*cx.rv_slot.add(t as usize)))
    }
}

// The location of value v at position pos.
pub fn vloc(cx: &mut FnCtx, v: i64, pos: i64) -> i64 {
    let t = tracked(cx, v);
    if t < 0 {
        return LOC_NONE;
    }
    tloc(cx, t, pos)
}

// Whether value v (dense index t) is stored to its spill slot when it is
// defined.
pub fn stored_at_def(cx: &mut FnCtx, t: i64) -> bool {
    unsafe { (*cx.rv_slot.add(t as usize)) >= 0 }
}

// Shrink-wrapping (see emit.vl): marks in `need` (per layout index)
// the blocks where some value is in a callee-saved register or on the
// stack, or is stored to its spill slot, and the predecessors of a block
// that starts with one there (their edge moves may write it).
pub fn mark_frame_blocks(cx: &mut FnCtx, need: *mut i64) {
    unsafe {
        for t in 0..cx.ra_vals.count {
            let v = (*cx.ra_vals.data.add(t as usize));
            let mut i = (*cx.rv_first.add(t as usize));
            if i < 0 {
                continue;
            }
            if (*cx.rv_slot.add(t as usize)) >= 0 {
                (*need.add({ let at_arg1 = value_start(cx, t); block_at(cx, at_arg1) } as usize)) = 1;
            }
            while i >= 0 {
                let r = (*cx.ivs.add(i as usize)).reg;
                if (r >= 0 && is_callee_saved_reg(r))
                    || (r == ON_STACK && !(*cx.insts.add(v as usize)).op.is_remat()) {
                    for j in 0..(*cx.ivs.add(i as usize)).ranges.count / 2 {
                        mark_frame_range(cx, need,
                            (*(*cx.ivs.add(i as usize)).ranges.data.add((2 * j) as usize)),
                            (*(*cx.ivs.add(i as usize)).ranges.data.add((2 * j + 1) as usize)));
                    }
                }
                i = (*cx.ivs.add(i as usize)).next;
            }
        }
    }
}

fn mark_frame_range(cx: &mut FnCtx, need: *mut i64, from: i64, to: i64) {
    unsafe {
        let mut k = max_i64(block_at(cx, from), 0);
        while k < cx.order.count && (*cx.bstart.data.add(k as usize)) < to {
            (*need.add(k as usize)) = 1;
            if from <= (*cx.bstart.data.add(k as usize)) {
                let b = (*cx.order.data.add(k as usize));
                for p in (*cx.blocks.add(b as usize)).preds.items() {
                    if (*cx.blocks.add(p as usize)).order >= 0 {
                        (*need.add((*cx.blocks.add(p as usize)).order as usize)) = 1;
                    }
                }
            }
            k += 1;
        }
    }
}

// ---- Moves ----
//
// The moves of the allocation, shared by the emitter (which emits them)
// and the checker (which simulates them): each adds to PM (see 51_emit).

// Value v (dense index t) goes from `from` to `to`, where it is live
// across: a register or the stack. The stack needs no move (the value is
// there since its definition, or is rematerialized).
fn add_relocation(cx: &mut FnCtx, t: i64, from: i64, to: i64) {
    unsafe {
        if from == to || to < 0 || to == LOC_REMAT {
            return;
        }
        let v = (*cx.ra_vals.data.add(t as usize));
        if from == LOC_REMAT {
            pm_add(cx, to, PM_REMAT, v, (*cx.insts.add(v as usize)).ty, v, v);
        } else {
            pm_add(cx, to, PM_LOC, from, (*cx.insts.add(v as usize)).ty, v, v);
        }
    }
}

// The moves in the gap at q.
pub fn plan_gap_moves(cx: &mut FnCtx, q: i64) {
    unsafe {
        let n = cx.split_moves.count / 2;
        let mut i = gap_index(cx, q);
        while i < n && (*cx.split_moves.data.add((2 * i) as usize)) == q {
            let t = (*cx.split_moves.data.add((2 * i + 1) as usize));
            let tloc_v = tloc(cx, t, q - 1);
            let tloc_v1 = tloc(cx, t, q);
            add_relocation(cx, t, tloc_v, tloc_v1);
            i += 1;
        }
    }
}

// The first entry of SPLIT_MOVES at gap q or later.
pub fn gap_index(cx: &mut FnCtx, q: i64) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = cx.split_moves.count / 2;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if unsafe { (*cx.split_moves.data.add((2 * mid) as usize)) < q } {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

// The moves of the edge from b to s: the values live into s, and its phis.
fn plan_edge_moves(cx: &mut FnCtx, b: i64, s: i64) {
    unsafe {
        let from_pos = (*cx.bend.data.add((*cx.blocks.add(b as usize)).order as usize)) + 1;
        let to_pos = (*cx.bstart.data.add((*cx.blocks.add(s as usize)).order as usize));
        let live_in = live_set(cx, cx.live_in, (*cx.blocks.add(s as usize)).order);
        for w in 0..cx.live_words {
            let mut bits = (*live_in.add(w as usize));
            while bits != 0 {
                let bit = trailing_zeros(bits);
                bits &= bits - 1;
                let t = w * 64 + bit;
                let tloc_v = tloc(cx, t, from_pos);
                let tloc_v1 = tloc(cx, t, to_pos);
                add_relocation(cx, t, tloc_v, tloc_v1);
            }
        }
        let index = pred_index(cx, s, b);
        let mut phi = (*cx.blocks.add(s as usize)).first;
        while phi != 0 && (*cx.insts.add(phi as usize)).op == Phi {
            let t = tracked(cx, phi);
            if t >= 0 {
                let dst = tloc(cx, t, to_pos);
                let arg = ir_arg(cx, phi, index);
                let a = tracked(cx, arg);
                if (*cx.insts.add(arg as usize)).op.is_remat() || a < 0 {
                    pm_add(cx, dst, PM_REMAT, arg, (*cx.insts.add(phi as usize)).ty, arg, phi);
                } else {
                    let src = tloc(cx, a, from_pos);
                    if src == LOC_REMAT {
                        pm_add(cx, dst, PM_REMAT, arg, (*cx.insts.add(phi as usize)).ty, arg, phi);
                    } else {
                        pm_add(cx, dst, PM_LOC, src, (*cx.insts.add(phi as usize)).ty, arg, phi);
                    }
                }
            }
            phi = (*cx.insts.add(phi as usize)).next;
        }
    }
}

// The moves at the start of block b: those of its edge when its single
// predecessor has other successors.
pub fn plan_start_moves(cx: &mut FnCtx, b: i64) {
    unsafe {
        if (*cx.blocks.add(b as usize)).preds.count == 1 {
            let p = (*(*cx.blocks.add(b as usize)).preds.data.add(0));
            if succ_count(cx, p) > 1 {
                plan_edge_moves(cx, p, b);
            }
        }
    }
}

// The moves at the end of block b, after its last instruction: those of
// its edge when it has a single successor.
pub fn plan_end_moves(cx: &mut FnCtx, b: i64) {
    unsafe {
        if (*cx.blocks.add(b as usize)).term == Term::Jump {
            plan_edge_moves(cx, b, (*cx.blocks.add(b as usize)).s0);
        }
    }
}
