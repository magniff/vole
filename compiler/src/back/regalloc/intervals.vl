// Lifetime intervals (regalloc/mod.vl): built from liveness, with fixed
// intervals for the registers that calls and instructions clobber, and
// hints for the registers values would like; their ranges and uses looked
// up, and an interval split in two.

use crate::arch::intr_tied_operand;
use crate::back::abi::{conv_classify, conv_return_piece_reg, fn_uses_c};
use crate::back::emit::calls::{call_locations, callee_result};
use crate::back::emit::function::param_locations;
use crate::back::emit::machine::{
    arg_reg, call_returns_through_pointer, call_uses_c, reg_ret, xl_is_stack,
};
use crate::back::mc_arm64::atomic::{ATOMIC_SCRATCH, atomic_needs_scratch};
use crate::back::mc_x86_64::atomic::atomic_needs_rax;
use crate::back::mc_x86_64::ops::{is_commutative, ovf_uses_rdx};
use crate::back::regalloc::{Interval, POS_MAX, UNASSIGNED, USE_NONE, USE_REG};
use crate::back::regalloc::prepare::{
    bit_clear, bit_set, is_fused_compare, is_live_use, live_set, term_uses, tracked, use_kind,
};
use crate::back::regalloc::scan::{is_allocatable, is_callee_saved_reg};
use crate::base::{alloc_array, die, free, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{in_fregs, is_compound, max_i64};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, Term, get_irfuncs, ir_arg, ir_operand, ir_operand_count};
use crate::middle::ir::Op::{
    BNot, Call, CallC, Const, Conv, Div, MulH, Neg, Pack, Param, Phi, Piece, Rem, Select, Shl, Shr,
};

// ---- Intervals ----

fn iv_new(cx: &mut FnCtx<Comp>, t: i64) -> i64 {
    let i = cx.ivs.len() as i64;
    cx.ivs.push(Interval {
        value: t, reg: UNASSIGNED,
        ranges: Vec::new_in(Comp {}),
        uses: Vec::new_in(Comp {}),
        next: -1,
    });
    i
}

// Drops every interval (their ranges and uses with them) and empties the
// fixed ones' ranges, which keep their room for the next function.
fn iv_reset(cx: &mut FnCtx<Comp>) {
    cx.ivs.clear();
    for r in 0..cx.fixed.len() {
        cx.fixed[r].clear();
    }
}

pub fn ra_start(cx: &mut FnCtx<Comp>, i: i64) -> i64 {
    cx.ivs[i as usize].ranges[0]
}

pub fn ra_end(cx: &mut FnCtx<Comp>, i: i64) -> i64 {
    let ranges = &cx.ivs[i as usize].ranges;
    ranges[ranges.len() - 1]
}

// While building (backwards), ranges and uses are kept in descending
// order, then reversed.

// Adds [from, to) below the ranges so far (merging with the lowest one).
fn rev_add_range(list: &mut Vec<i64, Comp>, from: i64, to: i64) {
    let n = list.len();
    if n > 0 && to >= list[n - 2] {
        if from < list[n - 2] {
            list[n - 2] = from;
        }
        if to > list[n - 1] {
            list[n - 1] = to;
        }
        return;
    }
    list.push(from);
    list.push(to);
}

fn rev_add_use(cx: &mut FnCtx<Comp>, t: i64, pos: i64, kind: i64) {
    let i = cx.rv_first[t as usize];
    let uses = &mut cx.ivs[i as usize].uses;
    let n = uses.len();
    if n > 0 && uses[n - 2] == pos {
        if kind > uses[n - 1] {
            uses[n - 1] = kind;
        }
        return;
    }
    uses.push(pos);
    uses.push(kind);
}

// Value t is used at `pos` (in the block starting at `start`).
fn ra_add_use(cx: &mut FnCtx<Comp>, t: i64, start: i64, pos: i64, kind: i64, live: *mut u64) {
    let i = cx.rv_first[t as usize];
    rev_add_range(&mut cx.ivs[i as usize].ranges, start, pos + 1);
    rev_add_use(cx, t, pos, kind);
    bit_set(live, t);
}

// Value t is defined at `pos` (in the block starting at `start`).
fn add_def(cx: &mut FnCtx<Comp>, t: i64, start: i64, pos: i64, kind: i64, live: *mut u64) {
    let i = cx.rv_first[t as usize];
    let ranges = &mut cx.ivs[i as usize].ranges;
    let n = ranges.len();
    if n > 0 && ranges[n - 2] == start && ranges[n - 1] > pos {
        ranges[n - 2] = pos;
    } else {
        // Never used after: it still needs a place to be written.
        ranges.push(pos);
        ranges.push(pos + 1);
    }
    if kind != USE_NONE {
        rev_add_use(cx, t, pos, kind);
    }
    bit_clear(live, t);
}

fn reverse_pairs(list: &mut Vec<i64, Comp>) {
    let n = list.len() / 2;
    for i in 0..n / 2 {
        let j = n - 1 - i;
        list.swap(2 * i, 2 * j);
        list.swap(2 * i + 1, 2 * j + 1);
    }
}

fn add_fixed(cx: &mut FnCtx<Comp>, r: i64, from: i64, to: i64) {
    rev_add_range(&mut cx.fixed[r as usize], from, to);
}

// ---- Calls that return twice ----
//
// setjmp and the like return again when something longjmps to them: then
// the code after them runs again with the registers as the longjmp left
// them (callee-saved ones as they were at the setjmp) and the frame as it
// is now. So no register keeps a value across such a call (it clobbers
// every register: what lives across is on the stack, stored before),
// spill slots are not shared in its function (a slot reused after the
// call would be wrong after the second return), and the function is never
// a sibling caller, nor inlined, nor inlined into.

// (a slice, not a C string: no strlen per comparison; is_returns_twice_call
// runs for every call of every function the inliner and the attribute pass
// look at, and was a sixth of the self-compile at -O2)
fn sym_is(name: i64, s: &[u8], pcx: &Ctx<Comp>) -> bool {
    sym_text(name, pcx) == s
}

pub fn is_returns_twice_call(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        let mut name: i64 = 0;
        if op == Call {
            name = pcx.fns[(cx.insts[v as usize]).imm as usize].name;
        } else if op == CallC {
            name = (cx.insts[v as usize]).imm;
        } else {
            return false;
        }
        sym_is(name, b"setjmp", pcx) || sym_is(name, b"_setjmp", pcx)
            || sym_is(name, b"sigsetjmp", pcx) || sym_is(name, b"__sigsetjmp", pcx)
            || sym_is(name, b"savectx", pcx) || sym_is(name, b"vfork", pcx)
            || sym_is(name, b"getcontext", pcx)
    }
}

pub fn calls_returns_twice(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        for b in (*get_irfuncs().add(fi as usize)).blocks.items() {
            if (*cx.blocks.add(b as usize)).removed == 0 {
                let mut v = (*cx.blocks.add(b as usize)).first;
                while v != 0 {
                    if is_returns_twice_call(cx, v, pcx) {
                        return true;
                    }
                    v = (cx.insts[v as usize]).next;
                }
            }
        }
    }
    false
}

// Registers clobbered by the instruction at p (besides its result).
fn add_clobbers(cx: &mut FnCtx<Comp>, v: i64, p: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        if op.is_call() {
            // (0.17: the registers from a list made once per function,
            // CLOBBERED, not from tests of all 64 per call)
            if is_returns_twice_call(cx, v, pcx) {
                for r in 0..64 {
                    if is_allocatable(r, pcx) {
                        add_fixed(cx, r, p + 1, p + 2);
                    }
                }
            } else {
                for k in 0..cx.clobbered.len() as i64 {
                    add_fixed(cx, (cx.clobbered[k as usize]), p + 1, p + 2);
                }
            }
            return;
        }
        if op == Op::Atomic {
            // (0.21) The loops' scratch register (AArch64), rax (x86-64's
            // cmpxchg): mc_arm64/atomic.vl, mc_x86_64/atomic.vl.
            let kind = (cx.insts[v as usize]).imm & 255;
            if get_x86() {
                if atomic_needs_rax(kind) && is_allocatable(0, pcx) {
                    add_fixed(cx, 0, p, p + 3);
                }
            } else if atomic_needs_scratch(kind, pcx) && is_allocatable(ATOMIC_SCRATCH, pcx) {
                add_fixed(cx, ATOMIC_SCRATCH, p, p + 3);
            }
            return;
        }
        if get_x86() && !in_fregs((cx.insts[v as usize]).ty, pcx) {
            // Division and MULH use rax and rdx, shifts by a register cl, from
            // the reading of the operands to the writing of the result.
            if (op == Div || op == Rem || op == MulH
                || op == Op::Ovf && ovf_uses_rdx((cx.insts[v as usize]).imm))
                && is_allocatable(0, pcx) {
                add_fixed(cx, 0, p, p + 3);
                add_fixed(cx, 2, p, p + 3);
            }
            if (op == Shl || op == Shr)
                && (cx.insts[(cx.insts[v as usize]).b as usize]).op != Const
                && is_allocatable(1, pcx) {
                add_fixed(cx, 1, p, p + 3);
            }
        }
    }
}

// The pieces of call v's aggregate result (PIECE instructions after it in
// its block): defined by the call, in its result registers (as hints).
fn add_piece_defs(cx: &mut FnCtx<Comp>, v: i64, start: i64, p: i64, live: *mut u64, pcx: &Ctx<Comp>) {
    unsafe {
        // (0.17: only a call returning an aggregate has pieces; the scan of
        // the rest of the block for every call was quadratic in its calls)
        if !is_compound(callee_result(cx, v, pcx), pcx) {
            return;
        }
        let mut w = (cx.insts[v as usize]).next;
        let mut classified = false;
        while w != 0 {
            if (cx.insts[w as usize]).op == Piece && (cx.insts[w as usize]).a == v {
                if !classified {
                    let call_uses_c_v = call_uses_c(cx, v, pcx);
                    let callee_result_v = callee_result(cx, v, pcx);
                    conv_classify(cx, call_uses_c_v, callee_result_v, pcx);
                    classified = true;
                }
                let t = tracked(cx, w);
                if t >= 0 {
                    add_def(cx, t, start, p + 2, USE_REG, live);
                    if cx.rv_hreg[t as usize] < 0 {
                        let call_uses_c_v1 = call_uses_c(cx, v, pcx);
                        cx.rv_hreg[t as usize] = conv_return_piece_reg(cx, call_uses_c_v1,
                            (cx.insts[w as usize]).imm, pcx);
                    }
                }
            }
            w = (cx.insts[w as usize]).next;
        }
    }
}

// The hints of instruction v (at p): its result's register, its operands'.
fn add_hints(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        let t = tracked(cx, v);
        if op.is_call() {
            if t >= 0 && cx.rv_hreg[t as usize] < 0 {
                cx.rv_hreg[t as usize] = reg_ret(in_fregs((cx.insts[v as usize]).ty,
                    pcx));
            }
            let mut locations: [i64; 64] = [0i64; 64];
            let mut copies: [i64; 64] = [0i64; 64];
            let mut float_regs: i64 = 0;
            call_locations(cx, v, locations.as_mut_ptr() as *mut i64,
                copies.as_mut_ptr() as *mut i64, &mut float_regs, pcx);
            for i in 0..(cx.insts[v as usize]).nargs {
                let ir_arg_v = ir_arg(cx, v, i);
                let a = tracked(cx, ir_arg_v);
                if a >= 0 && !xl_is_stack(locations[i as usize])
                    && cx.rv_hreg[a as usize] < 0
                    && (*cx.regalloc_uses.add(ir_arg(cx, v, i) as usize)) == 1 {
                    cx.rv_hreg[a as usize] = arg_reg(locations[i as usize]);
                }
            }
            return;
        }
        if t < 0 {
            return;
        }
        if op.is_binary() || op == Neg || op == BNot || op == Conv {
            let a = tracked(cx, (cx.insts[v as usize]).a);
            if a >= 0 && cx.rv_hint[t as usize] < 0
                && in_fregs((cx.insts[(cx.insts[v as usize]).a as usize]).ty, pcx)
                == in_fregs((cx.insts[v as usize]).ty, pcx) {
                cx.rv_hint[t as usize] = a;
            }
        }
        // (0.19) An intrinsic whose instruction overwrites an operand: its
        // result in that operand's register (no move first).
        if op == Op::Intr {
            let k = intr_tied_operand((cx.insts[v as usize]).imm, pcx);
            if k >= 0 {
                let ir_operand_v = ir_operand(cx, v, k);
                let a = tracked(cx, ir_operand_v);
                if a >= 0 && cx.rv_hint[t as usize] < 0 {
                    cx.rv_hint[t as usize] = a;
                }
            }
        }
        if op == Select && get_x86() {
            // cmov into the register of the value it replaces: that value
            // would like the select's register. The select itself would like
            // the register of an operand used only here (free once it is
            // read): the one it replaces, else the other (an inverted cmov);
            // either way no movq first.
            let b = tracked(cx, (cx.insts[v as usize]).b);
            if b >= 0 && cx.rv_hint[b as usize] < 0
                && (*cx.regalloc_uses.add((cx.insts[v as usize]).b as usize)) == 1 {
                cx.rv_hint[b as usize] = t;
            }
            let a = tracked(cx, (cx.insts[v as usize]).a);
            if cx.rv_hint[t as usize] < 0 {
                if b >= 0 && (*cx.regalloc_uses.add((cx.insts[v as usize]).b as usize)) == 1 {
                    cx.rv_hint[t as usize] = b;
                }
                else if a >= 0
                    && (*cx.regalloc_uses.add((cx.insts[v as usize]).a as usize)) == 1 {
                    cx.rv_hint[t as usize] = a;
                }
            }
        }
    }
}

pub fn build_intervals(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        iv_reset(cx);
        cx.clobbered.clear();
        for r in 0..64 {
            if is_allocatable(r, pcx) && !is_callee_saved_reg(r) {
                cx.clobbered.push(r);
            }
        }
        cx.split_moves.clear();
        for t in 0..cx.ra_vals.len() as i64 {
            cx.rv_first[t as usize] = iv_new(cx, t);
            cx.rv_slot[t as usize] = -1;
            cx.rv_hint[t as usize] = -1;
            cx.rv_hreg[t as usize] = -1;
        }
        let live = alloc_array::<u64>(cx.live_words + 1);
        let mut out: [i64; 8] = [0i64; 8];
        let mut k = cx.order.len() as i64 - 1;
        while k >= 0 {
            let b = (cx.order[k as usize]);
            let start = (cx.bstart[k as usize]);
            let end = (cx.bend[k as usize]);
            let live_out = live_set(cx, cx.live_out, k);
            for w in 0..cx.live_words {
                (*live.add(w as usize)) = (*live_out.add(w as usize));
                let mut bits = (*live_out.add(w as usize));
                while bits != 0 {
                    let bit = trailing_zeros(bits);
                    bits &= bits - 1;
                    let t = w * 64 + bit;
                    rev_add_range(
                        &mut (cx.ivs[cx.rv_first[t as usize] as usize]).ranges, start,
                        end + 2);
                }
            }
            let count = term_uses(cx, b, out.as_mut_ptr() as *mut i64, pcx);
            for i in 0..count {
                let t = tracked(cx, out[(2 * i) as usize]);
                if t >= 0 && is_live_use(cx, out[(2 * i) as usize], out[(2 * i + 1) as usize]) {
                    ra_add_use(cx, t, start, end, out[(2 * i + 1) as usize], &mut *live);
                }
            }
            if (*cx.blocks.add(b as usize)).term == Term::Ret && count > 0 {
                let t = tracked(cx, out[0]);
                if t >= 0 && cx.rv_hreg[t as usize] < 0
                    && !is_compound(pcx.fns[(*get_irfuncs().add(cx.irf as usize)).f as usize].ret,
                        pcx) {
                    cx.rv_hreg[t as usize] = reg_ret(
                        in_fregs((cx.insts[out[0] as usize]).ty, pcx));
                }
                let pack = (*cx.blocks.add(b as usize)).cond;
                if (cx.insts[pack as usize]).op == Pack {
                    let f = (*get_irfuncs().add(cx.irf as usize)).f;
                    conv_classify(cx, fn_uses_c(f, pcx), pcx.fns[f as usize].ret, pcx);
                    for i in 0..count {
                        let a = tracked(cx, out[(2 * i) as usize]);
                        if a >= 0 && cx.rv_hreg[a as usize] < 0 {
                            cx.rv_hreg[a as usize] = conv_return_piece_reg(cx,
                                fn_uses_c(f, pcx), i, pcx);
                        }
                    }
                }
            }
            let mut v = (*cx.blocks.add(b as usize)).last;
            while v != 0 {
                let op = (cx.insts[v as usize]).op;
                if op != Phi && op != Param && op != Piece && op != Pack
                    && !is_fused_compare(cx, v) {
                    let p = (cx.insts[v as usize]).mark;
                    let t = tracked(cx, v);
                    if t >= 0 {
                        add_def(cx, t, start, p + 2,
                            if op.is_remat() { USE_NONE } else { USE_REG }, &mut *live);
                    }
                    if op.is_call() {
                        add_piece_defs(cx, v, start, p, &mut *live, pcx);
                    }
                    add_clobbers(cx, v, p, pcx);
                    add_hints(cx, v, pcx);
                    for i in 0..ir_operand_count(cx, v) {
                        let operand = ir_operand(cx, v, i);
                        let kind = use_kind(cx, v, i, pcx);
                        let a = tracked(cx, operand);
                        if a >= 0 && is_live_use(cx, operand, kind) {
                            // An aggregate result in registers is stored through
                            // its address after the call.
                            let at = if op.is_call() && i == 2
                                && !call_returns_through_pointer(cx, v, pcx) { p + 2 } else { p };
                            ra_add_use(cx, a, start, at, kind, &mut *live);
                        }
                    }
                }
                v = (cx.insts[v as usize]).prev;
            }
            // Phis and parameters, defined at the start (parameters may come
            // after other instructions of the entry block).
            v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let t = tracked(cx, v);
                let op = (cx.insts[v as usize]).op;
                if t >= 0 && (op == Phi || op == Param) {
                    add_def(cx, t, start, start, USE_NONE, &mut *live);
                }
                v = (cx.insts[v as usize]).next;
            }
            k -= 1;
        }
        free(live as *mut u8);
        for t in 0..cx.ra_vals.len() as i64 {
            let i = cx.rv_first[t as usize];
            reverse_pairs(&mut cx.ivs[i as usize].ranges);
            reverse_pairs(&mut cx.ivs[i as usize].uses);
        }
        for r in 0..64 {
            reverse_pairs(&mut cx.fixed[r as usize]);
        }
        phi_hints(cx);
        param_hints(cx, pcx);
    }
}

// A phi operand would like its phi's register; a phi, the register of the
// phi it flows into, else of an operand (coalescing them removes moves).
// Whether value w's hint is only the operand it is computed from (see
// add_hints), which a phi it flows into overrides: the phi's register
// saves a move on the edge (a loop's back edge, often), the operand's
// nothing on AArch64, and on x86-64 nothing either when the operation
// commutes or has one operand (its result in the phi's register costs
// the same move as in the operand's).
fn operand_hint_only(cx: &mut FnCtx<Comp>, w: i64, t: i64) -> bool {
    unsafe {
        let op = (cx.insts[w as usize]).op;
        if op == Select && get_x86()
            && (cx.rv_hint[t as usize] == tracked(cx, (cx.insts[w as usize]).a)
                || cx.rv_hint[t as usize] == tracked(cx, (cx.insts[w as usize]).b)) {
            return true;
        }
        if !(op.is_binary() || op == Neg || op == BNot || op == Conv)
            || cx.rv_hint[t as usize] != tracked(cx, (cx.insts[w as usize]).a) {
            return false;
        }
        !get_x86() || !op.is_binary() || is_commutative(op)
    }
}

fn phi_hints(cx: &mut FnCtx<Comp>) {
    unsafe {
        for k in 0..cx.order.len() as i64 {
            let mut v = (*cx.blocks.add((cx.order[k as usize]) as usize)).first;
            while v != 0 && (cx.insts[v as usize]).op == Phi {
                let t = tracked(cx, v);
                if t >= 0 {
                    for i in 0..(cx.insts[v as usize]).nargs {
                        let w = ir_arg(cx, v, i);
                        let a = tracked(cx, w);
                        if a >= 0
                            && (cx.rv_hint[a as usize] < 0 || operand_hint_only(cx, w, a)) {
                            cx.rv_hint[a as usize] = t;
                        }
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
        }
        // A phi's own hint: the value it gets on a back edge (the loop's
        // value, moved on every iteration when they differ), else the first.
        for k in 0..cx.order.len() as i64 {
            let b = (cx.order[k as usize]);
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 && (cx.insts[v as usize]).op == Phi {
                let t = tracked(cx, v);
                if t >= 0 && cx.rv_hint[t as usize] < 0 {
                    for i in 0..(cx.insts[v as usize]).nargs {
                        let ir_arg_v = ir_arg(cx, v, i);
                        let a = tracked(cx, ir_arg_v);
                        let p = ((*cx.blocks.add(b as usize)).preds[i as usize]);
                        if a >= 0 && a != t && (*cx.blocks.add(p as usize)).order >= k {
                            cx.rv_hint[t as usize] = a;
                        }
                    }
                    for i in 0..(cx.insts[v as usize]).nargs {
                        let ir_arg_v1 = ir_arg(cx, v, i);
                        let a = tracked(cx, ir_arg_v1);
                        if a >= 0 && cx.rv_hint[t as usize] < 0 {
                            cx.rv_hint[t as usize] = a;
                        }
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
        }
    }
}

// Parameters would like the register they arrive in.
fn param_hints(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let f = (*get_irfuncs().add(cx.irf as usize)).f;
        let mut locations: [i64; 64] = [0i64; 64];
        let mut pieces: [i64; 256] = [0i64; 256];
        if pcx.fns[f as usize].param_count > 64 {
            return;
        }
        param_locations(cx, f, locations.as_mut_ptr() as *mut i64, pieces.as_mut_ptr() as *mut i64,
            pcx);
        let mut v = (*cx.blocks.add((*get_irfuncs().add(cx.irf as usize)).entry as usize)).first;
        while v != 0 {
            let t = tracked(cx, v);
            if (cx.insts[v as usize]).op == Param && t >= 0
                && (cx.insts[v as usize]).imm >= 0 {
                let index = (cx.insts[v as usize]).imm;
                let piece = (cx.insts[v as usize]).imm2;
                let location = if piece > 0 { pieces[(4 * index + piece - 1) as usize] }
                    else { locations[index as usize] };
                if piece >= 0 && !xl_is_stack(location) {
                    cx.rv_hreg[t as usize] = arg_reg(location);
                }
            }
            v = (cx.insts[v as usize]).next;
        }
    }
}

// The number of 0 bits below the lowest 1 bit of bits (64 for 0): the
// 1 bits of the mask below it, counted a few operations at a time (std's
// count_ones; 0.28.0: not a loop, the borrow checker's set walks call it
// for every bit).
pub fn trailing_zeros(bits: u64) -> i64 {
    let m = !bits & bits.wrapping_sub(1u64);
    let a = m - ((m >> 1) & 0x5555555555555555);
    let b = (a & 0x3333333333333333) + ((a >> 2) & 0x3333333333333333);
    let c = (b + (b >> 4)) & 0x0f0f0f0f0f0f0f0f;
    (c.wrapping_mul(0x0101010101010101u64) >> 56) as i64
}

// The index of the last range of `list` starting at or before pos, or -1.
fn ra_range_at(list: &[i64], pos: i64) -> i64 {
    let mut lo: usize = 0;
    let mut hi = list.len() / 2;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if list[2 * mid] <= pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo as i64 - 1
}

pub fn covers(cx: &mut FnCtx<Comp>, i: i64, pos: i64) -> bool {
    let ranges = &cx.ivs[i as usize].ranges;
    let r = ra_range_at(ranges, pos);
    r >= 0 && pos < ranges[(2 * r + 1) as usize]
}

// The first position at or after `from` in both range lists, or POS_MAX.
pub fn next_intersection(a: &[i64], b: &[i64], from: i64) -> i64 {
    let mut i = ra_range_at(a, from);
    if i < 0 {
        i = 0;
    }
    let mut j = ra_range_at(b, from);
    if j < 0 {
        j = 0;
    }
    let mut i = i as usize;
    let mut j = j as usize;
    let na = a.len() / 2;
    let nb = b.len() / 2;
    while i < na && j < nb {
        let lo = max_i64(max_i64(a[2 * i], b[2 * j]), from);
        let hi = min_i64(a[2 * i + 1], b[2 * j + 1]);
        if lo < hi {
            return lo;
        }
        if a[2 * i + 1] < b[2 * j + 1] {
            i += 1;
        } else {
            j += 1;
        }
    }
    POS_MAX
}

// The first use of interval i at or after pos needing at least `kind`.
pub fn next_use(cx: &mut FnCtx<Comp>, i: i64, pos: i64, kind: i64) -> i64 {
    let uses = &cx.ivs[i as usize].uses;
    let n = uses.len() / 2;
    let mut lo: usize = 0;
    let mut hi = n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if uses[2 * mid] < pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    while lo < n {
        if uses[2 * lo + 1] >= kind {
            return uses[2 * lo];
        }
        lo += 1;
    }
    POS_MAX
}

pub fn min_i64(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

// The layout index of the block holding position pos.
pub fn block_at(cx: &mut FnCtx<Comp>, pos: i64) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = cx.bstart.len() as i64;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if (cx.bstart[mid as usize]) <= pos {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo - 1
}

fn is_block_start(cx: &mut FnCtx<Comp>, pos: i64) -> bool {
    let k = block_at(cx, pos);
    k >= 0 && (cx.bstart[k as usize]) == pos
}

// Splits interval i at pos: i keeps what comes before, the new interval
// (returned) the rest. A split inside a block, where the value is live,
// moves it in the gap at pos (only gaps hold moves: a split anywhere else
// must leave the rest on the stack).
pub fn split_at(cx: &mut FnCtx<Comp>, i: i64, pos: i64) -> i64 {
    let value = cx.ivs[i as usize].value;
    let next = cx.ivs[i as usize].next;
    // The rest is built apart and pushed last: the new interval's place
    // in IVS may move the table, and i's lists are read while it is filled.
    let mut rest = Interval {
        value: value, reg: UNASSIGNED,
        ranges: Vec::new_in(Comp {}),
        uses: Vec::new_in(Comp {}),
        next: next,
    };
    let part = &mut cx.ivs[i as usize];
    let n = part.ranges.len() / 2;
    let mut r: usize = 0;
    while r < n && part.ranges[2 * r + 1] <= pos {
        r += 1;
    }
    let mut live_across = false;
    let mut cut: usize = 0;
    if r < n && part.ranges[2 * r] < pos {
        live_across = true;
        rest.ranges.push(pos);
        rest.ranges.push(part.ranges[2 * r + 1]);
        part.ranges[2 * r + 1] = pos;
        cut = r + 1;
        r += 1;
    } else {
        cut = r;
    }
    rest.ranges.extend_from_slice(&part.ranges[2 * r..]);
    part.ranges.truncate(2 * cut);
    let m = part.uses.len() / 2;
    let mut u: usize = 0;
    while u < m && part.uses[2 * u] < pos {
        u += 1;
    }
    rest.uses.extend_from_slice(&part.uses[2 * u..]);
    part.uses.truncate(2 * u);
    if part.ranges.is_empty() || rest.ranges.is_empty() {
        die(c"internal error: empty interval after a split");
    }
    let child = cx.ivs.len() as i64;
    cx.ivs[i as usize].next = child;
    cx.ivs.push(rest);
    if live_across && !is_block_start(cx, pos) && pos % 4 == 3 {
        cx.split_moves.push(pos);
        cx.split_moves.push(value);
    }
    child
}

// The latest position at or before max where a value can move (a gap, or
// a block start), not before min; -1 if there is none.
pub fn move_point_before(cx: &mut FnCtx<Comp>, max: i64, min: i64) -> i64 {
    let k = block_at(cx, max);
    let start = (cx.bstart[k as usize]);
    let end = (cx.bend[k as usize]);
    let mut q: i64 = 0;
    if max >= end {
        q = end - 1;
    } else {
        q = max - (max + 1) % 4;
        if q < start + 3 {
            q = start;
        }
    }
    if q < min { -1 } else { q }
}

// Where to split between min and max for a value to come back into a
// register (or change register): the last move point before max, or the
// start of the outermost block in between when that is less deep in loops
// (so that reloads leave loops).
pub fn split_point(cx: &mut FnCtx<Comp>, min: i64, max: i64) -> i64 {
    let kmin = block_at(cx, min);
    let kmax = block_at(cx, max);
    if kmax > kmin {
        let mut best = kmax;
        let mut k = kmax;
        while k > kmin {
            if (cx.ldepth[k as usize]) < (cx.ldepth[best as usize]) {
                best = k;
            }
            k -= 1;
        }
        if best != kmax {
            return (cx.bstart[best as usize]);
        }
    }
    move_point_before(cx, max, min)
}

// The gap before the instruction using a value at `use_pos` (p for an
// operand, p + 2 for a result, the end of a block for the terminator).
pub fn gap_before(use_pos: i64) -> i64 {
    use_pos - 1 - use_pos % 4
}
