// What register allocation (regalloc/mod.vl) starts from: use counts,
// critical edges split, the blocks in layout order, what each use of a
// value needs, positions, and liveness.

use crate::back::abi::{conv_returns_through_pointer, fn_uses_c};
use crate::back::emit::blocks::{fits_cmp_imm, is_cmp_imm_operand};
use crate::back::emit::machine::{call_returns_through_pointer, m_int_imm_ok};
use crate::back::regalloc::{USE_ANY, USE_NONE, USE_REG};
use crate::back::regalloc::locations::vloc;
use crate::base::{IntVec, alloc_array, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{is_compound, is_float};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Op, Term, get_irfuncs, ir_arg, ir_enter, ir_new_block, ir_operand, ir_operand_count, ir_set_arg,
};
use crate::middle::ir::Op::{
    Cmp, Const, Div, Lea, Load, LoadX, Pack, Param, Phi, Piece, Rem, Select, Slot, Store, StoreX,
    Test,
};
use crate::middle::ir::cfg::{pred_index, redirect_succ, succ, succ_count};

// ---- Preparation ----

// Counts the uses of every value of function fi (before it is emitted).
pub fn count_uses(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        free(cx.regalloc_uses as *mut u8);
        free(cx.reg_used as *mut u8);
        cx.regalloc_uses = alloc_array::<i64>(cx.insts.len() as i64 + 1);
        cx.reg_used = alloc_array::<i64>(cx.insts.len() as i64 + 1);
        while cx.fixed.len() < 64 {
            cx.fixed.push(Vec::new_in(Comp {}));
        }
        for b in (*get_irfuncs().add(fi as usize)).blocks.items() {
            if (cx.blocks[b as usize]).removed != 0 {
                continue;
            }
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                for k in 0..ir_operand_count(cx, v) {
                    let operand = ir_operand(cx, v, k);
                    if operand != 0 {
                        (*cx.regalloc_uses.add(operand as usize)) += 1;
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
            let cond = (cx.blocks[b as usize]).cond;
            if cond != 0 {
                (*cx.regalloc_uses.add(cond as usize)) += 1;
            }
        }
    }
}

// Splits every critical edge (from a block with several successors to one
// with several predecessors) with an empty block, so that the moves of
// each edge have a place of their own.
pub fn split_critical_edges(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        let count = (*get_irfuncs().add(fi as usize)).blocks.len() as i64;
        for i in 0..count {
            let b = ((*get_irfuncs().add(fi as usize)).blocks[i as usize]);
            if (cx.blocks[b as usize]).removed != 0 || succ_count(cx, b) < 2 {
                continue;
            }
            if (cx.blocks[b as usize]).term == Term::Branch
                && (cx.blocks[b as usize]).s0 == (cx.blocks[b as usize]).s1 {
                // Both ways lead to the same block: a jump (one edge less).
                let s = (cx.blocks[b as usize]).s0;
                let first = pred_index(cx, s, b);
                let mut second: i64 = -1;
                for j in first + 1..(cx.blocks[s as usize]).preds.len() as i64 {
                    if second < 0
                        && ((cx.blocks[s as usize]).preds[j as usize]) == b {
                        second = j;
                    }
                }
                if second >= 0 {
                    for j in second..(cx.blocks[s as usize]).preds.len() as i64 - 1 {
                        ((cx.blocks[s as usize]).preds[j as usize]) = (
                            (cx.blocks[s as usize]).preds[(j + 1) as usize]);
                    }
                    (cx.blocks[s as usize]).preds.pop();
                    let mut phi = (cx.blocks[s as usize]).first;
                    while phi != 0 && (cx.insts[phi as usize]).op == Phi {
                        let gone = ir_arg(cx, phi, second);
                        if gone != 0 {
                            (*cx.regalloc_uses.add(gone as usize)) -= 1;
                        }
                        for j in second..(cx.insts[phi as usize]).nargs - 1 {
                            let ir_arg_v = ir_arg(cx, phi, j + 1);
                            ir_set_arg(cx, phi, j, ir_arg_v);
                        }
                        (cx.insts[phi as usize]).nargs -= 1;
                        phi = (cx.insts[phi as usize]).next;
                    }
                }
                (*cx.regalloc_uses.add((cx.blocks[b as usize]).cond as usize)) -= 1;
                (cx.blocks[b as usize]).cond = 0;
                (cx.blocks[b as usize]).term = Term::Jump;
                (cx.blocks[b as usize]).s1 = 0;
                continue;
            }
            let mut k: i64 = 0;
            while k < succ_count(cx, b) {
                let s = succ(cx, b, k);
                k += 1;
                if (cx.blocks[s as usize]).preds.len() as i64 < 2 {
                    continue;
                }
                let e = ir_new_block(cx);
                (cx.blocks[e as usize]).sealed = 1;
                (cx.blocks[e as usize]).term = Term::Jump;
                (cx.blocks[e as usize]).s0 = s;
                (cx.blocks[e as usize]).preds.push(b);
                redirect_succ(cx, b, s, e);
                // Same index in the predecessor list, so the phis still match.
                let index = pred_index(cx, s, b);
                ((cx.blocks[s as usize]).preds[index as usize]) = e;
            }
        }
    }
}

// Lays out the reachable blocks in reverse post-order (BLOCKS[b].order is
// the layout index, -1 for unreachable blocks), and finds their loop
// depths (LDEPTH, for the back end).
pub fn layout_blocks(cx: &mut FnCtx<Comp>, fi: i64) {
    layout_order(cx, fi);
    loop_depths(cx);
}

// (0.17) The reverse post-order alone (BLOCKS[b].order, ORDER): what the
// middle end's users of the layout need (dominators, unreachable blocks);
// the loop depths cost a walk of every loop's blocks.
pub fn layout_order(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        for b in (*get_irfuncs().add(fi as usize)).blocks.items() {
            (cx.blocks[b as usize]).order = -1;
            (cx.blocks[b as usize]).mark = 0;
        }
        cx.order.clear();
        // Iterative depth-first search; post-order into ORDER, reversed below.
        let mut stack = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let entry = (*get_irfuncs().add(fi as usize)).entry;
        stack.push(entry);
        stack.push(0);
        (cx.blocks[entry as usize]).mark = 1;
        while stack.len() as i64 > 0 {
            let b = (stack[(stack.len() as i64 - 2) as usize]);
            let next = (stack[(stack.len() as i64 - 1) as usize]);
            if next < succ_count(cx, b) {
                (stack[(stack.len() as i64 - 1) as usize]) = next + 1;
                let arg_v = succ_count(cx, b) - 1 - next;
                // The second successor first, so that the first one comes
                // right after the block when it can.
                let s = succ(cx, b, arg_v);
                if (cx.blocks[s as usize]).mark == 0 {
                    (cx.blocks[s as usize]).mark = 1;
                    stack.push(s);
                    stack.push(0);
                }
            } else {
                stack.truncate(stack.len() as i64 - 2);
                cx.order.push(b);
            }
        }
        let n = cx.order.len() as i64;
        for i in 0..n / 2 {
            let t = (cx.order[i as usize]);
            (cx.order[i as usize]) = (cx.order[(n - 1 - i) as usize]);
            (cx.order[(n - 1 - i) as usize]) = t;
        }
        for i in 0..n {
            { let at_ix = (cx.order[i as usize]) as usize;
                (cx.blocks[at_ix]).order = i };
        }
        free(stack.data as *mut u8);
    }
}

// The loop depth of each block of the layout (LDEPTH, by layout index).
fn loop_depths(cx: &mut FnCtx<Comp>) {
    unsafe {
        let n = cx.order.len() as i64;
        let mut stack = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        // Loops: an edge to a block not later in the order is a back edge
        // (the graph is reducible); the loop of header h is h and the blocks
        // reaching a latch without passing h.
        cx.ldepth.clear();
        for _ in 0..n {
            cx.ldepth.push(0);
        }
        // (0.17) The marks of the previous walk are cleared, not every
        // block's for every header: that was quadratic in the blocks of a
        // function with many loops. The first walk clears them all, the
        // DFS's.
        let mut walked = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut first_walk = true;
        for h in 0..n {
            let header = (cx.order[h as usize]);
            stack.clear();
            for &p in (cx.blocks[header as usize]).preds.as_slice() {
                if (cx.blocks[p as usize]).order >= h {
                    stack.push(p);
                }
            }
            if stack.len() as i64 == 0 {
                continue;
            }
            if first_walk {
                for k in 0..n {
                    { let at_ix = (cx.order[k as usize]) as usize;
                        (cx.blocks[at_ix]).mark = 0 };
                }
                first_walk = false;
            } else {
                for k in 0..walked.len() as i64 {
                    (cx.blocks[(walked[k as usize]) as usize]).mark = 0;
                }
            }
            walked.clear();
            (cx.blocks[header as usize]).mark = 1;
            walked.push(header);
            (cx.ldepth[h as usize]) += 1;
            while stack.len() as i64 > 0 {
                let b = stack.pop();
                if (cx.blocks[b as usize]).mark != 0
                    || (cx.blocks[b as usize]).order < 0 {
                    continue;
                }
                (cx.blocks[b as usize]).mark = 1;
                walked.push(b);
                (cx.ldepth[(cx.blocks[b as usize]).order as usize]) += 1;
                for &x in (cx.blocks[b as usize]).preds.as_slice() {
                    stack.push(x);
                }
            }
        }
        free(stack.data as *mut u8);
        free(walked.data as *mut u8);
    }
}

// Whether compare (or test) `v` is fused into the branch that ends its
// block.
pub fn is_fused_compare(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    unsafe {
        let b = (cx.insts[v as usize]).block;
        ((cx.insts[v as usize]).op == Cmp || (cx.insts[v as usize]).op == Test
            || (cx.insts[v as usize]).op == Op::Ovf && !get_x86())
            && (*cx.regalloc_uses.add(v as usize)) == 1
            && (cx.blocks[b as usize]).term == Term::Branch
            && (cx.blocks[b as usize]).cond == v && (cx.insts[v as usize]).next == 0
            && !is_float((cx.insts[v as usize]).imm2)
    }
}

// How instruction v uses its operand i (see ir_operand).
pub fn use_kind(cx: &mut FnCtx<Comp>, v: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let operand = ir_operand(cx, v, i);
        if operand == 0 {
            return USE_NONE;
        }
        let op = (cx.insts[v as usize]).op;
        if op.is_call() {
            if i == 2 && (cx.insts[operand as usize]).op == Slot
                && !call_returns_through_pointer(&mut *cx, v, pcx) {
                return USE_NONE;
            }
            return USE_ANY;
        }
        if op == Piece {
            return USE_NONE;
        }
        if op == Pack {
            return USE_ANY;
        }
        if op == Phi {
            return USE_ANY;
        }
        if (op == Load || op == Store) && i == 0 && (cx.insts[operand as usize]).op == Slot {
            return USE_NONE;
        }
        // AArch64's csel and csinc read a 0 from xzr.
        if op == Select && i < 2 && !get_x86() && is_zero_operand(&mut *cx, operand) {
            return USE_NONE;
        }
        // x86-64's indexed forms address a frame slot from %rsp.
        if (op == LoadX || op == StoreX || op == Lea) && i == 0
            && (cx.insts[operand as usize]).op == Slot {
            return USE_NONE;
        }
        // An integer comparison with a constant that fits compares with an
        // immediate.
        if op == Cmp && i == 1 && is_cmp_imm_operand(&mut *cx, v) {
            return USE_NONE;
        }
        if op.is_binary() && i == 1 && !is_float((cx.insts[v as usize]).ty) && op != Div
            && op != Rem && (cx.insts[operand as usize]).op == Const
            && m_int_imm_ok(op, (cx.insts[v as usize]).ty,
                (cx.insts[operand as usize]).imm) {
            return USE_NONE;
        }
        USE_REG
    }
}

// The operands the terminator of block b reads (at BEND), with their
// kinds: up to four (value, kind) pairs in out; returns the count.
pub fn term_uses(cx: &mut FnCtx<Comp>, b: i64, out: *mut i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let cond = (cx.blocks[b as usize]).cond;
        let term = (cx.blocks[b as usize]).term;
        if cond == 0 {
            return 0;
        }
        if term == Term::Ret && (cx.insts[cond as usize]).op == Pack {
            // The pieces of an aggregate result.
            for i in 0..(cx.insts[cond as usize]).nargs {
                (*out.add((2 * i) as usize)) = ir_arg(cx, cond, i);
                (*out.add((2 * i + 1) as usize)) = USE_ANY;
            }
            return (cx.insts[cond as usize]).nargs;
        }
        if term == Term::Ret {
            let ret = pcx.fns[(*get_irfuncs().add(cx.irf as usize)).f as usize].ret;
            if is_compound(ret, pcx)
                && !conv_returns_through_pointer(cx,
                    fn_uses_c((*get_irfuncs().add(cx.irf as usize)).f, pcx), ret, pcx)
                && (cx.insts[cond as usize]).op == Slot {
                return 0;
            }
            (*out.add(0)) = cond;
            (*out.add(1)) = USE_ANY;
            return 1;
        }
        if term == Term::Branch && is_fused_compare(cx, cond)
            && ((cx.insts[cond as usize]).op == Test
                || (cx.insts[cond as usize]).op == Op::Ovf) {
            (*out.add(0)) = (cx.insts[cond as usize]).a;
            (*out.add(1)) = USE_REG;
            if (cx.insts[cond as usize]).b == 0 {
                return 1;
            }
            (*out.add(2)) = (cx.insts[cond as usize]).b;
            (*out.add(3)) = USE_REG;
            return 2;
        }
        if term == Term::Branch && is_fused_compare(cx, cond) {
            (*out.add(0)) = (cx.insts[cond as usize]).a;
            (*out.add(1)) = USE_REG;
            let rhs = (cx.insts[cond as usize]).b;
            if (cx.insts[rhs as usize]).op == Const
                && fits_cmp_imm((cx.insts[rhs as usize]).imm) {
                return 1;
            }
            (*out.add(2)) = rhs;
            (*out.add(3)) = USE_REG;
            return 2;
        }
        if term == Term::Branch || term == Term::Switch {
            (*out.add(0)) = cond;
            (*out.add(1)) = USE_REG;
            return 1;
        }
        0
    }
}

// Whether a use of kind `kind` of value `v` makes it live: remat values
// only when they are needed in a register (else they are rematerialized
// where they are needed).
pub fn is_live_use(cx: &mut FnCtx<Comp>, v: i64, kind: i64) -> bool {
    unsafe { kind == USE_REG || (kind == USE_ANY && !(cx.insts[v as usize]).op.is_remat()) }
}

// Whether `v` is computed where it is defined.
pub fn is_emitted(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        if op == Phi || op == Param || op == Piece || op == Pack {
            return false;
        }
        if op.is_remat() {
            if (cx.insts[v as usize]).aux == 0 {
                return false;
            }
            let loc = vloc(cx, v, (cx.insts[v as usize]).mark + 2);
            return loc >= 0 && loc < 64;
        }
        op.has_side_effect() || (*cx.regalloc_uses.add(v as usize)) > 0
    }
}

fn needs_location(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        if (cx.insts[v as usize]).ty == 0 || (*cx.regalloc_uses.add(v as usize)) == 0
            || is_fused_compare(cx, v) {
            return false;
        }
        !op.is_remat() || (*cx.reg_used.add(v as usize)) != 0
    }
}

// ---- Positions and liveness ----

// The per-value tables, n entries each, every one -1 (build_intervals
// fills them); their room is kept from one function to the next.
fn ra_reserve(cx: &mut FnCtx<Comp>, n: i64) {
    let n = n as usize;
    cx.rv_first.clear();
    cx.rv_first.resize(n, -1);
    cx.rv_slot.clear();
    cx.rv_slot.resize(n, -1);
    cx.rv_hint.clear();
    cx.rv_hint.resize(n, -1);
    cx.rv_hreg.clear();
    cx.rv_hreg.resize(n, -1);
}

// Marks the values some use needs in a register.
pub fn mark_reg_uses(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let mut out: [i64; 8] = [0i64; 8];
        for at_k in 0..cx.order.len() {
            let b = cx.order[at_k];
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                if !is_fused_compare(cx, v) {
                    for i in 0..ir_operand_count(cx, v) {
                        if use_kind(cx, v, i, pcx) == USE_REG {
                            (*cx.reg_used.add(ir_operand(cx, v, i) as usize)) = 1;
                        }
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
            let n = term_uses(cx, b, out.as_mut_ptr() as *mut i64, pcx);
            for i in 0..n {
                if out[(2 * i + 1) as usize] == USE_REG {
                    (*cx.reg_used.add(out[(2 * i) as usize] as usize)) = 1;
                }
            }
        }
    }
}

// Numbers the instructions and the allocated values.
pub fn number_positions(cx: &mut FnCtx<Comp>) {
    unsafe {
        cx.bstart.clear();
        cx.bend.clear();
        cx.ra_vals.clear();
        let mut pos: i64 = 0;
        for at_k in 0..cx.order.len() {
            let b = cx.order[at_k];
            let start = pos;
            cx.bstart.push(start);
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let op = (cx.insts[v as usize]).op;
                if op == Phi || op == Param {
                    (cx.insts[v as usize]).mark = start;
                } else {
                    pos += 4;
                    (cx.insts[v as usize]).mark = pos;
                }
                (cx.insts[v as usize]).aux = 0;
                if needs_location(cx, v) {
                    cx.ra_vals.push(v);
                    (cx.insts[v as usize]).aux = cx.ra_vals.len() as i64;
                }
                v = (cx.insts[v as usize]).next;
            }
            pos += 4;
            cx.bend.push(pos);
            pos += 4;
        }
        ra_reserve(cx, cx.ra_vals.len() as i64);
    }
}

pub fn bit_set(set: *mut u64, i: i64) {
    unsafe { (*set.add((i >> 6) as usize)) |= (1 as u64) << (i & 63) as u64; }
}

pub fn bit_clear(set: *mut u64, i: i64) {
    unsafe { (*set.add((i >> 6) as usize)) &= !((1 as u64) << (i & 63) as u64); }
}

fn bit_get(set: *mut u64, i: i64) -> bool {
    unsafe { ((*set.add((i >> 6) as usize)) >> (i & 63) as u64) & 1 != 0 }
}

pub fn live_set(cx: &mut FnCtx<Comp>, sets: *mut u64, k: i64) -> *mut u64 {
    unsafe { sets.add((k * cx.live_words) as usize) }
}

// The dense index of operand `v` if it is allocated, else -1.
pub fn tracked(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    if v == 0 {
        return -1;
    }
    unsafe { (cx.insts[v as usize]).aux - 1 }
}

pub fn compute_liveness(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let n = cx.order.len() as i64;
        cx.live_words = (cx.ra_vals.len() as i64 + 63) / 64 + 1;
        free(cx.live_in as *mut u8);
        free(cx.live_out as *mut u8);
        cx.live_in = alloc_array::<u64>(n * cx.live_words + 1);
        cx.live_out = alloc_array::<u64>(n * cx.live_words + 1);
        let gen = alloc_array::<u64>(n * cx.live_words + 1);
        let kill = alloc_array::<u64>(n * cx.live_words + 1);
        let mut out: [i64; 8] = [0i64; 8];
        for k in 0..n {
            let b = (cx.order[k as usize]);
            let g = live_set(cx, gen, k);
            let d = live_set(cx, kill, k);
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                if (cx.insts[v as usize]).op != Phi && !is_fused_compare(cx, v) {
                    for i in 0..ir_operand_count(cx, v) {
                        let operand = ir_operand(cx, v, i);
                        let t = tracked(cx, operand);
                        let arg_v = t >= 0
                            && {
                            let at_arg2 = use_kind(cx, v, i, pcx); is_live_use(cx, operand, at_arg2)
                        };
                        if arg_v
                            && !bit_get(d, t) {
                            bit_set(&mut *g, t);
                        }
                    }
                }
                let t = tracked(cx, v);
                if t >= 0 {
                    bit_set(&mut *d, t);
                }
                v = (cx.insts[v as usize]).next;
            }
            let count = term_uses(cx, b, out.as_mut_ptr() as *mut i64, pcx);
            for i in 0..count {
                let t = tracked(cx, out[(2 * i) as usize]);
                if t >= 0 && is_live_use(cx, out[(2 * i) as usize], out[(2 * i + 1) as usize])
                    && !bit_get(d, t) {
                    bit_set(&mut *g, t);
                }
            }
        }
        let mut changed = true;
        while changed {
            changed = false;
            let mut k = n - 1;
            while k >= 0 {
                let b = (cx.order[k as usize]);
                let live_out = live_set(cx, cx.live_out, k);
                for i in 0..succ_count(cx, b) {
                    let s = succ(cx, b, i);
                    let sk = (cx.blocks[s as usize]).order;
                    let sin = live_set(cx, cx.live_in, sk);
                    for w in 0..cx.live_words {
                        (*live_out.add(w as usize)) |= (*sin.add(w as usize));
                    }
                    // Phi operands flowing from b.
                    let index = pred_index(cx, s, b);
                    let mut phi = (cx.blocks[s as usize]).first;
                    while phi != 0 && (cx.insts[phi as usize]).op == Phi {
                        let arg = ir_arg(cx, phi, index);
                        let t = tracked(cx, arg);
                        if t >= 0 && tracked(cx, phi) >= 0 && is_live_use(cx, arg, USE_ANY) {
                            bit_set(&mut *live_out, t);
                        }
                        phi = (cx.insts[phi as usize]).next;
                    }
                }
                let live_in = live_set(cx, cx.live_in, k);
                let g = live_set(cx, gen, k);
                let d = live_set(cx, kill, k);
                for w in 0..cx.live_words {
                    let value = (*g.add(w as usize))
                        | ((*live_out.add(w as usize)) & !(*d.add(w as usize)));
                    if value != (*live_in.add(w as usize)) {
                        (*live_in.add(w as usize)) = value;
                        changed = true;
                    }
                }
                k -= 1;
            }
        }
        free(gen as *mut u8);
        free(kill as *mut u8);
    }
}

// Whether `v` is the integer constant 0 (read from xzr on AArch64).
pub fn is_zero_operand(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    unsafe {
        (cx.insts[v as usize]).op == Const && (cx.insts[v as usize]).imm == 0
            && !is_float((cx.insts[v as usize]).ty)
    }
}
