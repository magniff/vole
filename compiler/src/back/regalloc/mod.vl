// Register allocation for the IR back end: linear scan on SSA form, with
// lifetime holes and interval splitting (C. Wimmer and H. Mössenböck,
// "Optimized Interval Splitting in a Linear Scan Register Allocator", VEE
// 2005; C. Wimmer and M. Franz, "Linear Scan Register Allocation on SSA
// Form", CGO 2010).
//
// Positions. Blocks are laid out in reverse post-order (ORDER); block k
// starts at BSTART[k], a multiple of 4, where its phis (and in the entry
// block the parameters) are defined. Its instructions follow 4 apart: the
// one at p reads its operands at p, clobbers registers at p + 1 (a call:
// every caller-saved register) and writes its result at p + 2, and p - 1
// is the gap before it, where moves go. The terminator reads its operands
// at BEND[k]; values live out of the block reach BEND[k] + 2.
//
// Intervals. A value's lifetime is a list of ranges [from, to), with holes,
// and the positions where it is used, with what each use needs: USE_REG a
// register, USE_ANY a register or the stack (call arguments, phi operands,
// returned values: they are moved into place). Uses as immediates or as
// frame addresses are not uses at all. Liveness comes from the usual
// backward data flow over the blocks. Constants and addresses (is_remat)
// get an interval only when some use needs them in a register; on the
// stack, they are rematerialized.
//
// Allocation walks the intervals by start. An interval gets a register
// that is free for its whole lifetime when there is one (its hint first:
// the register of a phi partner, or the argument or result register it
// goes to), else the register free longest, for a first part: the rest is
// split off and allocated later. When none is free at all, the register
// whose next use is farthest (uses in loops count as nearer) is taken
// from the intervals holding it, which go to the stack until just before
// their next use; or, when its own first use is farther still, the
// interval itself goes to the stack until then. Splits that reload a value
// move to a block boundary outside loops when there is one between the
// last and the next use. Registers clobbered by calls (or fixed by an
// instruction) are fixed intervals.
//
// Spilling. A value that goes to the stack anywhere is stored once, right
// after its definition (Wimmer's spill store elimination): going to the
// stack costs nothing, coming back is one load. Values whose lifetimes do
// not overlap share spill slots.
//
// Resolution. A split inside a block becomes a move in the gap where it
// falls. On each edge (critical edges are split first), the locations of
// the values live into the successor and of its phis are reconciled by
// one parallel move, at the end of the predecessor (when it has a single
// successor) or at the start of the successor. emit.vl emits these
// moves; the checker (check.vl, --verify-regalloc) simulates them.
//
// Locations (vloc): 0-31 the integer registers (hardware numbers), 32-63
// the float registers (32 + n), -(1 + i) spill slot i, LOC_REMAT a value
// rematerialized where it is needed, LOC_NONE no location.

pub mod prepare;
pub mod intervals;
pub mod scan;
pub mod locations;
pub mod check;

use crate::back::regalloc::intervals::build_intervals;
use crate::back::regalloc::prepare::{
    compute_liveness, mark_reg_uses, number_positions, split_critical_edges,
};
use crate::back::regalloc::scan::linear_scan;
use crate::base::{buf_fmt, buf_new, buf_str, buf_write_fd, sym_text};
use crate::middle::ir::ir_enter;

// What other modules import from the allocator, from its parts.
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::middle::ctx::FnCtx;

use intervals::calls_returns_twice;
use prepare::layout_blocks;

pub const LOC_NONE: i64 = 1000000;
pub const LOC_REMAT: i64 = 1000001;
// An interval's register when it is on the stack, or not allocated yet.
const ON_STACK: i64 = -1;
const UNASSIGNED: i64 = -2;
const POS_MAX: i64 = 0x3fffffffffffffff;

// What a use needs.
pub const USE_NONE: i64 = 0;
const USE_ANY: i64 = 1;
const USE_REG: i64 = 2;

// A part of a value's lifetime, with one location.
pub struct Interval<A: std::alloc::Allocator> {
    // The value (a dense index into RA_VALS) and its location: a register,
    // ON_STACK or UNASSIGNED.
    value: i64, reg: i64,
    // [from, to) pairs and (position, kind) pairs, ascending.
    ranges: Vec<i64, A>, uses: Vec<i64, A>,
    // The next part of the same value (split off this one), or -1.
    next: i64,
}

// ---- The allocation ----

// Allocates function `fi`: layout, positions, liveness, intervals and
// locations.
pub fn allocate_registers(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    ir_enter(cx, fi, pcx);
    cx.ra_idom_ready = false;
    cx.returns_twice = calls_returns_twice(cx, fi, pcx);
    split_critical_edges(cx, fi, pcx);
    layout_blocks(cx, fi);
    mark_reg_uses(cx, pcx);
    number_positions(cx);
    compute_liveness(cx, pcx);
    build_intervals(cx, pcx);
    linear_scan(cx, pcx);
    if pcx.print_regalloc {
        print_allocation(cx, pcx);
    }
}

fn print_allocation(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let out = buf_new();
        buf_fmt(out,
            format_args("regalloc {}:\n",
                str::from_utf8(
                    sym_text(pcx.fns[pcx.ir_fn[cx.irf as usize] as usize].name, pcx)).unwrap()));
        for k in 0..cx.order.len() as i64 {
            buf_fmt(out,
                format_args("  b{} [{}, {}] depth {}\n", (cx.order[k as usize]),
                    (cx.bstart[k as usize]), (cx.bend[k as usize]),
                    (cx.ldepth[k as usize])));
        }
        for t in 0..cx.ra_vals.len() as i64 {
            buf_fmt(out, format_args("  v{}", (cx.ra_vals[t as usize])));
            if cx.rv_hint[t as usize] >= 0 {
                buf_fmt(out,
                    format_args(" hint v{}",
                        (cx.ra_vals[cx.rv_hint[t as usize] as usize])));
            }
            if cx.rv_hreg[t as usize] >= 0 {
                buf_fmt(out, format_args(" hint r{}", cx.rv_hreg[t as usize]));
            }
            let mut i = cx.rv_first[t as usize];
            while i >= 0 {
                buf_str(out, c" |");
                if cx.ivs[i as usize].reg >= 0 {
                    buf_fmt(out, format_args(" r{}", cx.ivs[i as usize].reg));
                } else {
                    buf_str(out, c" stack");
                }
                for r in 0..cx.ivs[i as usize].ranges.len() as i64 / 2 {
                    buf_fmt(out,
                        format_args(" [{},{})",
                            (cx.ivs[i as usize].ranges[(2 * r) as usize]),
                            (cx.ivs[i as usize].ranges[(2 * r + 1) as usize])));
                }
                i = cx.ivs[i as usize].next;
            }
            buf_str(out, c"\n");
        }
        buf_write_fd(out, 2);
    }
}
