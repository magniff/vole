// Debug information (0.11, `-g`): DWARF line tables, so that debuggers and
// backtraces see source lines.
//
// The assembly carries it as the system assemblers expect it: `.file N
// "path"` and `.loc N line column` before instructions (a statement's
// first instruction; both back ends know the source position of what they
// emit: the -O0 generator per statement, the IR per instruction, from the
// statement it was lowered from), and the sections a compiler writes
// itself: .debug_abbrev and .debug_info (a compile unit for the program,
// with a subprogram per function: name, address range, declaration line)
// as data, and an empty .debug_line whose start the unit refers to. The
// assembler (objfile.vl, or `cc -c` of the same text) makes the line
// program from the `.loc`s into that section. Without `-g` nothing of this
// is written, and nothing else changes: the code is the same with and
// without it.
//
// DWARF 4, 32-bit. Positions in the compiler's own synthesized sources
// (`<std>`, `<C import>`...) have no line: code from them keeps the line
// of the code before it.

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_fmt, buf_new, buf_reserve, buf_slice, buf_str, buf_uint, cstr,
    get_bufs, get_src, memcmp, out_path, root_dir, strlen, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::gen0::target::{emit_symbol_ref, local_prefix};
use crate::middle::ctx::FnCtx;

// ---- Source positions ----

// The offsets in SRC where lines start (made once, when first needed:
// every source is loaded by then).
static mut LINE_STARTS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut SRC_END: i64 = 0;

fn init_lines(pcx: &Ctx<Comp>) {
    let last = pcx.files[(pcx.files.len() as i64 - 1) as usize].end;
    set_src_end(last);
    { let mut line_starts_copy = get_line_starts(); line_starts_copy.push(0);
        set_line_starts(line_starts_copy); }
    for i in 0..last {
        if get_src()[i as usize] == b'\n' {
            { let mut line_starts_copy = get_line_starts(); line_starts_copy.push(i + 1);
                set_line_starts(line_starts_copy); }
        }
    }
}

// The index of the line holding position `pos`.
fn line_index(pos: i64) -> i64 {
    unsafe {
        let mut lo: i64 = 0;
        let mut hi = get_line_starts().count - 1;
        while lo < hi {
            let mid = (lo + hi + 1) / 2;
            if (*get_line_starts().data.add(mid as usize)) <= pos {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo
    }
}

// The file holding position `pos`.
fn file_of(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = pcx.files.len() as i64 - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if pcx.files[mid as usize].start <= pos {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    lo
}

// (0.17) The file holding position `pos` and its line there (from 1), as
// file << 32 | line: --trace's sites (middle/trace.vl).
pub fn file_and_line(pos: i64, pcx: &Ctx<Comp>) -> i64 {
    if get_line_starts().count == 0 {
        init_lines(pcx);
    }
    let file = file_of(pos, pcx);
    let line = line_index(pos) - line_index(pcx.files[file as usize].start) + 1;
    (file << 32) | line
}

// The `.file` number of each file of FILES (0: none yet).
static mut FILE_NUMBERS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut FILES_USED: i64 = 0;

// Writes the `.loc` of source position `pos` to buffer `out` (and the
// `.file` of its file, the first time); nothing for a position of a
// synthesized source, or -1.
pub fn dbg_loc(out: i64, pos: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if !pcx.debug_info || pos < 0 {
            return;
        }
        if get_line_starts().count == 0 {
            init_lines(pcx);
        }
        if pos >= get_src_end() {
            return;
        }
        let file = file_of(pos, pcx);
        let path = pcx.files[file as usize].path;
        if (*path.add(0)) == b'<' {
            return;
        }
        while get_file_numbers().count <= file {
            { let mut file_numbers_copy = get_file_numbers(); file_numbers_copy.push(0);
                set_file_numbers(file_numbers_copy); }
        }
        if (*get_file_numbers().data.add(file as usize)) == 0 {
            set_files_used(get_files_used() + (1));
            (*get_file_numbers().data.add(file as usize)) = get_files_used();
            let files_used_now = get_files_used();
            buf_fmt(out, format_args("    .file {files_used_now} "));
            // (0.18) the file by its absolute path, the root's directory and
            // its root-relative name: the assembler resolves a relative
            // `.file` against its own current directory, which need not
            // be the root's (cc assembling `-S` output elsewhere)
            let root = root_dir(pcx);
            if (*root.add(0)) != 0 {
                let full = buf_new();
                buf_str(full, root);
                buf_byte(full, b'/');
                buf_str(full, out_path(file, pcx));
                buf_byte(full, 0);
                quoted(out, (*get_bufs().add(full as usize)).data);
            } else {
                quoted(out, out_path(file, pcx));
            }
            buf_byte(out, b'\n');
        }
        let line = line_index(pos);
        let first = line_index(pcx.files[file as usize].start);
        buf_fmt(out,
            format_args("    .loc {} {} ", (*get_file_numbers().data.add(file as usize)),
                line - first + 1));
        buf_fmt(out, format_args("{}\n", pos - (*get_line_starts().data.add(line as usize)) + 1));
    }
}

// "<s>", with " and \ escaped.
fn quoted(out: i64, s: *mut u8) {
    unsafe {
        buf_byte(out, b'"');
        let n = strlen(s) as i64;
        for i in 0..n {
            if (*s.add(i as usize)) == b'"' || (*s.add(i as usize)) == b'\\' {
                buf_byte(out, b'\\');
            }
            buf_byte(out, (*s.add(i as usize)));
        }
        buf_byte(out, b'"');
    }
}

// ---- Functions ----

// Per function emitted: its FNS index, the symbol prefix of its label,
// its position (the declaration) and the number of its end label.
static mut DBG_FNS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut DBG_PREFIX: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut DBG_POS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };

// Before function f's label (in ASM): the line of its declaration, at
// `pos`, for its first instruction.
pub fn dbg_function_begin(cx: &mut FnCtx<Comp>, f: i64, prefix: *mut u8, pos: i64, pcx: &Ctx<Comp>) {
    if !pcx.debug_info {
        return;
    }
    dbg_loc(cx.asm, pos, pcx);
    { let mut dbg_fns_copy = get_dbg_fns(); dbg_fns_copy.push(f); set_dbg_fns(dbg_fns_copy); }
    { let mut dbg_prefix_copy = get_dbg_prefix(); dbg_prefix_copy.push(prefix as i64);
        set_dbg_prefix(dbg_prefix_copy); }
    { let mut dbg_pos_copy = get_dbg_pos(); dbg_pos_copy.push(pos); set_dbg_pos(dbg_pos_copy); }
}

// After the function's last instruction (in ASM): its end label.
pub fn dbg_function_end(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    if !pcx.debug_info {
        return;
    }
    end_label(cx.asm, get_dbg_fns().count - 1);
    buf_str(cx.asm, c":\n");
}

fn end_label(out: i64, i: i64) {
    buf_fmt(out, format_args("{}dbg.end{i}", str::from_utf8(cstr(local_prefix())).unwrap()));
}

// The end of the code (in ASM, after the last instruction of the text
// section).
pub fn dbg_text_end(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    if !pcx.debug_info || get_dbg_fns().count == 0 {
        return;
    }
    buf_fmt(cx.asm,
        format_args("{}dbg.text_end:\n", str::from_utf8(cstr(local_prefix())).unwrap()));
}

// ---- The sections ----

fn section(cx: &mut FnCtx<Comp>, name: *mut u8) {
    if get_elf() {
        buf_str(cx.asm, c"\n.section .");
        buf_str(cx.asm, name);
        buf_str(cx.asm, c",\"\",@progbits\n");
    } else {
        buf_str(cx.asm, c"\n.section __DWARF,__");
        buf_str(cx.asm, name);
        buf_str(cx.asm, c",regular,debug\n");
    }
}

fn label(cx: &mut FnCtx<Comp>, name: *mut u8) {
    buf_fmt(cx.asm,
        format_args("{}{}:\n", str::from_utf8(cstr(local_prefix())).unwrap(),
            str::from_utf8(cstr(name)).unwrap()));
}

// `.byte` lines for a list of bytes.
fn bytes(cx: &mut FnCtx<Comp>, b: &[u8]) {
    let mut i: i64 = 0;
    while i < b.len() as i64 {
        buf_str(cx.asm, c"    .byte ");
        let mut k: i64 = 0;
        while k < 16 && i < b.len() as i64 {
            if k > 0 {
                buf_byte(cx.asm, b',');
            }
            buf_uint(cx.asm, b[i as usize] as u64);
            i += 1;
            k += 1;
        }
        buf_byte(cx.asm, b'\n');
    }
}

// A null-terminated string, as bytes.
fn string(b: i64, s: &[u8]) {
    buf_bytes(b, s);
    buf_byte(b, 0);
}

fn uleb(b: i64, value: i64) {
    let mut v = value;
    loop {
        let low = v & 127;
        v = v >> 7;
        if v == 0 {
            buf_byte(b, low as u8);
            return;
        }
        buf_byte(b, (low | 128) as u8);
    }
}

// A reference to the start of another debug section: its offset, 0 on
// Mach-O (one unit per object, not relocated), a relocated label on ELF
// (the linker concatenates the sections of every object).
fn section_offset(cx: &mut FnCtx<Comp>, name: *mut u8) {
    if get_elf() {
        buf_str(cx.asm, c"    .long ");
        buf_str(cx.asm, local_prefix());
        buf_str(cx.asm, name);
        buf_byte(cx.asm, b'\n');
    } else {
        buf_str(cx.asm, c"    .long 0\n");
    }
}

// A function's label as an operand.
fn function_symbol(cx: &mut FnCtx<Comp>, i: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let f = (*get_dbg_fns().data.add(i as usize));
        // (emit_symbol_ref writes to CODE)
        let out = cx.code;
        cx.code = cx.asm;
        emit_symbol_ref(cx, (*get_dbg_prefix().data.add(i as usize)) as *mut u8,
            pcx.fns[f as usize].name, pcx);
        cx.code = out;
    }
}

// .debug_abbrev, .debug_info and the (empty) .debug_line of the program
// `main_path` (appended to ASM).
pub fn dbg_sections(cx: &mut FnCtx<Comp>, main_path: *mut u8, producer: *mut u8, pcx: &Ctx<Comp>) {
    unsafe {
        if !pcx.debug_info || get_dbg_fns().count == 0 {
            return;
        }
        // The abbreviations: 1 the compile unit, 2 a subprogram, 3 one
        // without a declaration (from a synthesized source).
        section(cx, c"debug_abbrev");
        label(cx, c"dbg.abbrev");
        let ab = buf_new();
        let abbrev: [u8; 46] = [
            1, 0x11, 1, // DW_TAG_compile_unit, children
            0x25, 0x08, // DW_AT_producer, DW_FORM_string
            0x13, 0x05, // DW_AT_language, DW_FORM_data2
            0x03, 0x08, // DW_AT_name, DW_FORM_string
            0x10, 0x17, // DW_AT_stmt_list, DW_FORM_sec_offset
            0x1b, 0x08, // DW_AT_comp_dir, DW_FORM_string
            0x11, 0x01, // DW_AT_low_pc, DW_FORM_addr
            0x12, 0x06, // DW_AT_high_pc, DW_FORM_data4
            0, 0,
            2, 0x2e, 0, // DW_TAG_subprogram, no children
            0x03, 0x08, // DW_AT_name, DW_FORM_string
            0x11, 0x01, // DW_AT_low_pc, DW_FORM_addr
            0x12, 0x06, // DW_AT_high_pc, DW_FORM_data4
            0x3a, 0x0f, // DW_AT_decl_file, DW_FORM_udata
            0x3b, 0x0f, // DW_AT_decl_line, DW_FORM_udata
            0, 0,
            3, 0x2e, 0, // DW_TAG_subprogram, no children
            0x03, 0x08, // DW_AT_name, DW_FORM_string
            0x11, 0x01, // DW_AT_low_pc, DW_FORM_addr
            0x12, 0x06, // DW_AT_high_pc, DW_FORM_data4
            0, 0,
            0,
        ];
        buf_bytes(ab, &abbrev[0..46]);
        bytes(cx, buf_slice(ab));
        // The compile unit.
        section(cx, c"debug_info");
        label(cx, c"dbg.info");
        buf_fmt(cx.asm,
            format_args("    .long {}dbg.info_end - {}",
                str::from_utf8(cstr(local_prefix())).unwrap(),
                str::from_utf8(cstr(local_prefix())).unwrap()));
        buf_str(cx.asm, c"dbg.info_start\n");
        label(cx, c"dbg.info_start");
        let version = buf_new();
        buf_byte(version, 4);
        buf_byte(version, 0);
        bytes(cx, buf_slice(version));
        section_offset(cx, c"dbg.abbrev");
        let b = buf_new();
        buf_byte(b, 8);
        buf_byte(b, 1);
        string(b,
            std::slice::from_raw_parts(producer.add((0) as usize),
                (strlen(producer) as i64 - (0)) as usize));
        // DW_LANG_C99: the closest the debuggers know.
        buf_byte(b, 0x0c);
        buf_byte(b, 0);
        string(b,
            std::slice::from_raw_parts(main_path.add((0) as usize),
                (strlen(main_path) as i64 - (0)) as usize));
        bytes(cx, buf_slice(b));
        section_offset(cx, c"dbg.line");
        // (0.18) DW_AT_comp_dir: the root file's directory, which the
        // file names are relative to (out_path), not the current one.
        let dir = buf_new();
        let root = root_dir(pcx);
        if (*root.add(0)) != 0 {
            string(dir,
                std::slice::from_raw_parts(root.add((0) as usize),
                    (strlen(root) as i64 - (0)) as usize));
        } else {
            string(dir, std::slice::from_raw_parts(c".".add((0) as usize), (1 - (0)) as usize));
        }
        bytes(cx, buf_slice(dir));
        buf_str(cx.asm, c"    .quad ");
        function_symbol(cx, 0, pcx);
        buf_fmt(cx.asm,
            format_args("\n    .long {}dbg.text_end - ",
                str::from_utf8(cstr(local_prefix())).unwrap()));
        function_symbol(cx, 0, pcx);
        buf_byte(cx.asm, b'\n');
        // The functions.
        for i in 0..get_dbg_fns().count {
            let f = (*get_dbg_fns().data.add(i as usize));
            let pos = (*get_dbg_pos().data.add(i as usize));
            let file: i64 = if pos >= 0 && pos < get_src_end() { file_of(pos, pcx) } else { -1 };
            let declared = file >= 0 && file < get_file_numbers().count
                && (*get_file_numbers().data.add(file as usize)) > 0;
            let s = buf_new();
            buf_byte(s, if declared { 2 } else { 3 });
            let display = pcx.fns[f as usize].display;
            string(s,
                if display > 0 { sym_text(display, pcx) }
                else { sym_text(pcx.fns[f as usize].name, pcx) });
            bytes(cx, buf_slice(s));
            buf_str(cx.asm, c"    .quad ");
            function_symbol(cx, i, pcx);
            buf_str(cx.asm, c"\n    .long ");
            end_label(cx.asm, i);
            buf_str(cx.asm, c" - ");
            function_symbol(cx, i, pcx);
            buf_byte(cx.asm, b'\n');
            if declared {
                let d = buf_new();
                uleb(d, (*get_file_numbers().data.add(file as usize)));
                uleb(d, line_index(pos) - line_index(pcx.files[file as usize].start) + 1);
                bytes(cx, buf_slice(d));
            }
        }
        let end = buf_new();
        buf_byte(end, 0);
        bytes(cx, buf_slice(end));
        label(cx, c"dbg.info_end");
        // The line program goes here (written by the assembler).
        section(cx, c"debug_line");
        label(cx, c"dbg.line");
    }
}

// ---- Placing the `.loc`s, and call frame information ----

// Whether bytes [a, b) of `t` are an instruction: an indented line that is
// neither a directive nor a label.
fn is_instruction(t: *mut u8, a: i64, b: i64) -> bool {
    unsafe {
        let mut i = a;
        while i < b && ((*t.add(i as usize)) == b' ' || (*t.add(i as usize)) == b'\t') {
            i += 1;
        }
        if i == a || i >= b || (*t.add(i as usize)) == b'.' {
            return false;
        }
        (*t.add((b - 1) as usize)) != b':'
    }
}

// Whether bytes [a, b) of `t` are the directive `word` (indented or not)
// followed by a space.
fn is_directive(t: *mut u8, a: i64, b: i64, word: *mut u8) -> bool {
    unsafe {
        let mut i = a;
        while i < b && ((*t.add(i as usize)) == b' ' || (*t.add(i as usize)) == b'\t') {
            i += 1;
        }
        let n = strlen(word) as i64;
        i + n < b && memcmp(t.add(i as usize), word, n as u64) == 0
            && (*t.add((i + n) as usize)) == b' '
    }
}

// Whether bytes [a, b) of `t` are exactly `s`.
fn line_is(t: *mut u8, a: i64, b: i64, s: *mut u8) -> bool {
    unsafe {
        let n = strlen(s) as i64;
        b - a == n && memcmp(t.add(a as usize), s, n as u64) == 0
    }
}

// The next line from `i` that is not a `.loc`: its start, its end in `end`.
fn next_line(t: *mut u8, n: i64, i: i64, end: &mut i64) -> i64 {
    unsafe {
        let mut a = i;
        while a < n {
            let mut e = a;
            while e < n && (*t.add(e as usize)) != b'\n' {
                e += 1;
            }
            if !is_directive(t, a, e, c".loc") {
                *end = e;
                return a;
            }
            a = e + 1;
        }
        *end = n;
        n
    }
}

// The standard prologue: the frame pointer and return address saved, the
// frame pointer set.
fn prologue_first() -> *mut u8 {
    if get_x86() { c"    pushq %rbp" } else { c"    stp x29, x30, [sp, #-16]!" }
}

fn prologue_second() -> *mut u8 {
    if get_x86() { c"    movq %rsp, %rbp" } else { c"    mov x29, sp" }
}

// Rewrites ASM so that every `.loc` comes right before an instruction: a
// `.loc` waits for the next instruction (past labels and data), and one
// replaced by another before it is dropped, as is one repeating the last
// (in the same function). The system assemblers attach a `.loc` to the
// next instruction too, but GNU as also makes a row of one followed by
// another: written this way, every assembler makes the same rows.
//
// On Mach-O, every function that sets up the standard frame at its entry
// gets its call frame information (`.cfi_*`), which the assembler makes
// compact unwind information of: lldb unwinds through -O0's code (whose
// pushes and pops of temporaries its instruction-based unwinder takes for a
// prologue and an epilogue) with it.
pub fn dbg_place_locs(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        if !pcx.debug_info {
            return;
        }
        let t = (*get_bufs().add(cx.asm as usize)).data;
        let n = (*get_bufs().add(cx.asm as usize)).len;
        let out = buf_new();
        buf_reserve(out, n + n / 8);
        let cfi = !get_elf();
        let mut in_text = false;
        let mut cfi_open = false;
        // 1: a function's label was just written (its prologue may follow);
        // 2: its first instruction was the prologue's first one.
        let mut fn_state: i64 = 0;
        let mut pending_start: i64 = -1;
        let mut pending_end: i64 = -1;
        let mut last_start: i64 = -1;
        let mut last_end: i64 = -1;
        let mut i: i64 = 0;
        while i < n {
            let mut e = i;
            while e < n && (*t.add(e as usize)) != b'\n' {
                e += 1;
            }
            if is_loc(t, i, e) {
                pending_start = i;
                pending_end = e;
                i = e + 1;
                continue;
            }
            let label = e > i && (*t.add((e - 1) as usize)) == b':' && (*t.add(i as usize)) != b' ';
            let section = is_directive(t, i, e, c".section") || line_is(t, i, e, c".text")
                || line_is(t, i, e, c".data");
            if cfi && cfi_open
                && (section || (label && (!is_local_label(t, i, e) || is_dbg_end(t, i, e)))) {
                buf_str(out, c"    .cfi_endproc\n");
                cfi_open = false;
            }
            if section {
                in_text = is_directive(t, i, e, c".section")
                    && memcmp(t.add((i + 9) as usize), c"__TEXT,__text", 13) == 0
                    || line_is(t, i, e, c".text");
            }
            if is_instruction(t, i, e) {
                let mut cfi_after = false;
                if cfi && fn_state == 1 && line_is(t, i, e, prologue_first()) {
                    let mut e2: i64 = 0;
                    let a2 = next_line(t, n, e + 1, &mut e2);
                    if line_is(t, a2, e2, prologue_second()) {
                        buf_str(out, c"    .cfi_startproc\n");
                        cfi_open = true;
                        fn_state = 2;
                    } else {
                        fn_state = 0;
                    }
                } else if fn_state == 2 {
                    cfi_after = true;
                    fn_state = 0;
                } else {
                    fn_state = 0;
                }
                if pending_start >= 0 {
                    let same = last_start >= 0
                        && pending_end - pending_start == last_end - last_start
                        && memcmp(t.add(pending_start as usize), t.add(last_start as usize),
                            (last_end - last_start) as u64)
                        == 0;
                    if !same {
                        buf_fmt(out,
                            format_args("{}\n",
                                str::from_utf8(
                                    std::slice::from_raw_parts(t.add((pending_start) as usize),
                                        (pending_end - (pending_start)) as usize)).unwrap()));
                        last_start = pending_start;
                        last_end = pending_end;
                    }
                    pending_start = -1;
                }
                buf_fmt(out,
                    format_args("{}\n",
                        str::from_utf8(std::slice::from_raw_parts(t.add((i) as usize),
                            (e - (i)) as usize)).unwrap()));
                if cfi_after {
                    if get_x86() {
                        buf_str(out, c"    .cfi_def_cfa_offset 16\n    .cfi_offset %rbp, -16\n    .cfi_def_cfa_register %rbp\n");
                    } else {
                        buf_str(out, c"    .cfi_def_cfa w29, 16\n    .cfi_offset w30, -8\n    .cfi_offset w29, -16\n");
                    }
                }
                i = e + 1;
                continue;
            }
            if label && in_text && !is_local_label(t, i, e) {
                // A function's label: its first row is written even when it
                // repeats the last one.
                last_start = -1;
                fn_state = 1;
            }
            buf_fmt(out,
                format_args("{}\n",
                    str::from_utf8(std::slice::from_raw_parts(t.add((i) as usize),
                        (e - (i)) as usize)).unwrap()));
            i = e + 1;
        }
        if cfi_open {
            buf_str(out, c"    .cfi_endproc\n");
        }
        cx.asm = out;
    }
}

fn is_loc(t: *mut u8, a: i64, b: i64) -> bool {
    is_directive(t, a, b, c".loc")
}

// Whether a label is one of the ends dbg_function_end and dbg_text_end
// write.
fn is_dbg_end(t: *mut u8, a: i64, b: i64) -> bool {
    unsafe {
        let p = local_prefix();
        let k = strlen(p) as i64;
        b - a > k + 7 && memcmp(t.add((a + k) as usize), c"dbg.end", 7) == 0
            || b - a > k + 12 && memcmp(t.add((a + k) as usize), c"dbg.text_end", 12) == 0
    }
}

fn is_local_label(t: *mut u8, a: i64, b: i64) -> bool {
    unsafe {
        let p = local_prefix();
        let k = strlen(p) as i64;
        b - a > k && memcmp(t.add(a as usize), p, k as u64) == 0
    }
}

// (0.28.0) LINE_STARTS's accessors: every use of it is one of them.
fn get_line_starts() -> IntVec {
    // UNSAFE: the -g line and function tables, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: a task reaches its writers (dbg_function_begin, dbg_loc,
    // init_lines) only under -g (dbg_function_begin returns unless
    // debug_info, emit_loc is called only if debug_info) or, for
    // init_lines/LINE_STARTS/SRC_END, through file_and_line <-
    // vectorize::loop_line only when --vec-stats=FN reports; -g and
    // --vec-stats=FN make the compile serial (parallel::serial_only:
    // threads_for 1, no assembler thread), and the join and the assembler
    // thread do not reach it; other uses (trace_after_lowering,
    // dbg_sections, dbg_place_locs) are the main thread's; so one thread at
    // a time
    unsafe { LINE_STARTS }
}

fn set_line_starts(v: IntVec) {
    // UNSAFE: the -g line and function tables, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: a task reaches its writers (dbg_function_begin, dbg_loc,
    // init_lines) only under -g (dbg_function_begin returns unless
    // debug_info, emit_loc is called only if debug_info) or, for
    // init_lines/LINE_STARTS/SRC_END, through file_and_line <-
