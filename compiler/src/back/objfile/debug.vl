// What -g adds to the object (0.11): the `.cfi_*` directives, made into
// Mach-O's compact unwind section, and `.file` / `.loc`, made into the
// DWARF line program of .debug_line once layout has fixed the addresses.

use crate::back::objfile::{
    get_atext, get_cur_sec, get_frags, set_frags, get_frag_cap, set_frag_cap, get_frag_count, set_frag_count, Frag, get_open, get_sec_align, set_sec_align, SEC_DEBUG_LINE, SEC_TEXT,
    SEC_UNWIND, get_sec_used, set_sec_used, TAIL_NONE, here, reloc, w16, w32, w64, w8,
};
use crate::back::objfile::assemble::{asm_error, is_space, parse_number, text_is};
use crate::back::objfile::resolve::{
    ELF_A64_ABS64, ELF_X64_64, MACHO_A64_UNSIGNED, MACHO_X64_UNSIGNED,
};
use crate::base::{get_bufs, IntVec, alloc_zeroed, buf_byte, buf_bytes, buf_new, grow, memcpy, strlen};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::middle::ctx::FnCtx;

// ---- Call frame information (0.11, -g, Mach-O) ----
//
// The `.cfi_*` directives describe the standard frame a function sets up
// at its entry (the frame pointer and return address saved, the frame
// pointer the CFA's base): what Mach-O's compact unwind encoding says in
// one word per function, as LLVM writes it from them (debuggers unwind
// with it, without having to understand the code).

// Per function: its start and end (fragment, offset) each.
static mut CFI_FNS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut CFI_OPS: i64 = 0;

pub fn cfi_directive(cx: &mut FnCtx, a: i64, b: i64) {
    unsafe {
        if get_elf() {
            asm_error(cx, c"call frame information is written on Mach-O only");
        }
        if text_is(cx, a, b, c".cfi_startproc") {
            { let mut cfi_fns_copy = get_cfi_fns(); cfi_fns_copy.push(get_open()); set_cfi_fns(cfi_fns_copy); }
            { let mut cfi_fns_copy = get_cfi_fns(); cfi_fns_copy.push(here() - (*get_frags().add(get_open() as usize)).start); set_cfi_fns(cfi_fns_copy); }
            set_cfi_ops(0);
        } else if text_is(cx, a, b, c".cfi_endproc") {
            if get_cfi_ops() != 3 {
                asm_error(cx, c"call frame information other than the standard frame");
            }
            { let mut cfi_fns_copy = get_cfi_fns(); cfi_fns_copy.push(get_open()); set_cfi_fns(cfi_fns_copy); }
            { let mut cfi_fns_copy = get_cfi_fns(); cfi_fns_copy.push(here() - (*get_frags().add(get_open() as usize)).start); set_cfi_fns(cfi_fns_copy); }
        }
        else if text_is(cx, a, b, c".cfi_def_cfa") || text_is(cx, a, b, c".cfi_offset")
            || text_is(cx, a, b, c".cfi_def_cfa_offset")
            || text_is(cx, a, b, c".cfi_def_cfa_register") {
            // (the standard frame's three, in the order the back ends write
            // them)
            set_cfi_ops(get_cfi_ops() + (1));
        } else {
            asm_error(cx, c"unknown CFI directive");
        }
    }
}

// The compact unwind entries: per function its address (relocated), size,
// encoding (a frame: UNWIND_ARM64_MODE_FRAME, UNWIND_X86_64_MODE_RBP_FRAME),
// and no personality or LSDA.
pub fn compact_unwind(pcx: &mut Ctx<Comp>) {
    unsafe {
        let out = pcx.sec_buf[SEC_UNWIND as usize];
        { let mut sec_used_copy = get_sec_used(); sec_used_copy[SEC_UNWIND as usize] = true; set_sec_used(sec_used_copy); }
        { let mut sec_align_copy = get_sec_align(); sec_align_copy[SEC_UNWIND as usize] = 3; set_sec_align(sec_align_copy); }
        // An empty fragment, at the section's start, for its symbol.
        set_frags({ let mut frag_cap_copy = get_frag_cap(); let r_copy = grow(get_frags(), get_frag_count(), &mut frag_cap_copy); set_frag_cap(frag_cap_copy); r_copy });
        (*get_frags().add(get_frag_count() as usize)) = Frag {
            sec: SEC_UNWIND, start: 0, len: 0, tail: TAIL_NONE, arg: 0, sym: -1, long: false,
            addr: 0, atom: -1,
        };
        set_frag_count(get_frag_count() + (1));
        let mut k: i64 = 0;
        while k < get_cfi_fns().count {
            let start = (*get_frags().add((*get_cfi_fns().data.add(k as usize)) as usize)).addr + (*get_cfi_fns().data.add((k + 1) as usize));
            let end = (*get_frags().add((*get_cfi_fns().data.add((k + 2) as usize)) as usize)).addr + (*get_cfi_fns().data.add((k + 3) as usize));
            reloc(SEC_UNWIND, (*get_bufs().add(out as usize)).len,
                if get_x86() { MACHO_X64_UNSIGNED } else { MACHO_A64_UNSIGNED }, -1 - SEC_TEXT, start,
                false, 3, pcx);
            w64(out, start);
            w32(out, end - start);
            w32(out, if get_x86() { 0x01000000 } else { 0x04000000 });
            w64(out, 0);
            w64(out, 0);
            k += 4;
        }
    }
}

// ---- DWARF line tables (0.11, -g) ----
//
// `.file N "path"` names file N; `.loc N line column` gives the source
// position of the next instruction: a row of the line table. The rows make
// the line program of .debug_line (DWARF 4), written after layout, where
// the addresses are known; its one sequence covers the text section.

static mut LOC_PENDING: bool = false;
static mut LOC_FILE: i64 = 0;
static mut LOC_LINE: i64 = 0;
static mut LOC_COL: i64 = 0;
// Rows: (fragment, offset, file, line, column) each.
static mut ROWS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
// Per file number: its directory (an index in DIRS, 0 for none) and name
// (name_copy's copies, DIRS' too), as the system assemblers split a path.
static mut FILE_DIR: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut FILE_NAME: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
static mut DIRS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };

pub fn line_row() {
    unsafe {
        set_loc_pending(false);
        if get_cur_sec() != SEC_TEXT {
            return;
        }
        { let mut rows_copy = get_rows(); rows_copy.push(get_open()); set_rows(rows_copy); }
        { let mut rows_copy = get_rows(); rows_copy.push(here() - (*get_frags().add(get_open() as usize)).start); set_rows(rows_copy); }
        { let mut rows_copy = get_rows(); rows_copy.push(get_loc_file()); set_rows(rows_copy); }
        { let mut rows_copy = get_rows(); rows_copy.push(get_loc_line()); set_rows(rows_copy); }
        { let mut rows_copy = get_rows(); rows_copy.push(get_loc_col()); set_rows(rows_copy); }
    }
}

// .file N "path"
pub fn dwarf_file(cx: &mut FnCtx, a: i64, b: i64) {
    unsafe {
        let t = get_atext();
        let mut i = a;
        let start = i;
        while i < b && !is_space((*t.add(i as usize))) {
            i += 1;
        }
        let n = parse_number(cx, start, i);
        while i < b && (*t.add(i as usize)) != b'"' {
            i += 1;
        }
        if i >= b {
            asm_error(cx, c"expected a file name");
        }
        i += 1;
        let path = buf_new();
        while i < b && (*t.add(i as usize)) != b'"' {
            if (*t.add(i as usize)) == b'\\' && i + 1 < b {
                i += 1;
            }
            buf_byte(path, (*t.add(i as usize)));
            i += 1;
        }
        let p = (*get_bufs().add(path as usize)).data;
        let len = (*get_bufs().add(path as usize)).len;
        let mut slash = len - 1;
        while slash >= 0 && (*p.add(slash as usize)) != b'/' {
            slash -= 1;
        }
        while get_file_name().count <= n {
            { let mut file_name_copy = get_file_name(); file_name_copy.push(0); set_file_name(file_name_copy); }
            { let mut file_dir_copy = get_file_dir(); file_dir_copy.push(0); set_file_dir(file_dir_copy); }
        }
        (*get_file_name().data.add(n as usize)) = name_copy(std::slice::from_raw_parts(p.add((slash + 1) as usize), (len - (slash + 1)) as usize));
        if slash > 0 {
            let dir = std::slice::from_raw_parts(p.add((0) as usize), (slash - (0)) as usize);
            let mut d: i64 = 0;
            while d < get_dirs().count && name_bytes((*get_dirs().data.add(d as usize))) != dir {
                d += 1;
            }
            if d == get_dirs().count {
                { let mut dirs_copy = get_dirs(); dirs_copy.push(name_copy(dir)); set_dirs(dirs_copy); }
            }
            (*get_file_dir().data.add(n as usize)) = d + 1;
        }
    }
}

// (0.27.0) A file table's name: a NUL-terminated copy of bytes, as an
// i64 (0: none). The assembler, on a thread of its own, interns no symbol:
// the program's symbols are the main thread's.
fn name_copy(bytes: &[u8]) -> i64 {
    // UNSAFE: a C-style copy, the bytes and the NUL after them.
    // SAFETY: copy has bytes.len + 1 bytes (zeroed: the NUL); bytes.ptr has
    // bytes.len.
    unsafe {
        let n = bytes.len() as i64;
        let copy = alloc_zeroed(n + 1);
        memcpy(copy, bytes.ptr, n as u64);
        copy as i64
    }
}

// The bytes of a name name_copy made.
fn name_bytes(name: i64) -> &'static [u8] {
    // UNSAFE: name is a pointer kept as an i64, read as a C string.
    // SAFETY: name_copy made it, NUL-terminated, and it is never freed.
    unsafe {
        let p = name as *mut u8;
        std::slice::from_raw_parts(p.add((0) as usize), (strlen(p) as i64 - (0)) as usize)
    }
}

fn uleb(out: i64, value: i64) {
    let mut v = value;
    loop {
        let low = v & 127;
        v = v >> 7;
        if v == 0 {
            w8(out, low);
            return;
        }
        w8(out, low | 128);
    }
}

fn sleb(out: i64, value: i64) {
    let mut v = value;
    loop {
        let low = v & 127;
        v = v >> 7;
        if (v == 0 && (low & 64) == 0) || (v == -1 && (low & 64) != 0) {
            w8(out, low);
            return;
        }
        w8(out, low | 128);
    }
}

const LINE_BASE: i64 = -5;
const LINE_RANGE: i64 = 14;
const OPCODE_BASE: i64 = 13;

// The line program, after the contents of .debug_line (a label at most).
pub fn line_program(pcx: &mut Ctx<Comp>) {
    unsafe {
        let out = pcx.sec_buf[SEC_DEBUG_LINE as usize];
        { let mut sec_used_copy = get_sec_used(); sec_used_copy[SEC_DEBUG_LINE as usize] = true; set_sec_used(sec_used_copy); }
        let start = (*get_bufs().add(out as usize)).len;
        w32(out, 0);
        w16(out, 4);
        w32(out, 0);
        let header_start = (*get_bufs().add(out as usize)).len;
        w8(out, 1);
        w8(out, 1);
        w8(out, 1);
        w8(out, LINE_BASE & 255);
        w8(out, LINE_RANGE);
        w8(out, OPCODE_BASE);
        let lengths: [i64; 12] = [0i64, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1];
        for i in 0..12 {
            w8(out, lengths[i as usize]);
        }
        for d in 0..get_dirs().count {
            buf_bytes(out, name_bytes((*get_dirs().data.add(d as usize))));
            w8(out, 0);
        }
        w8(out, 0);
        for f in 1..get_file_name().count {
            if (*get_file_name().data.add(f as usize)) == 0 {
                // (a number not named: an empty name keeps the numbering)
                w8(out, 0);
                w8(out, 0);
                w8(out, 0);
                w8(out, 0);
                continue;
            }
            buf_bytes(out, name_bytes((*get_file_name().data.add(f as usize))));
            w8(out, 0);
            uleb(out, (*get_file_dir().data.add(f as usize)));
            w8(out, 0);
            w8(out, 0);
        }
        w8(out, 0);
        let header_len = (*get_bufs().add(out as usize)).len - header_start;
        // The program: the sequence's address (relocated: the text section's
        // start plus the first row's offset), then one row per entry.
        let mut addr = (*get_frags().add((*get_rows().data.add(0)) as usize)).addr + (*get_rows().data.add(1));
        w8(out, 0);
        uleb(out, 9);
        w8(out, 2);
        reloc(SEC_DEBUG_LINE, (*get_bufs().add(out as usize)).len,
            if get_elf() && get_x86() { ELF_X64_64 } else if get_elf() { ELF_A64_ABS64 }
            else if get_x86() { MACHO_X64_UNSIGNED } else { MACHO_A64_UNSIGNED }, -1 - SEC_TEXT, addr,
            false, 3, pcx);
        w64(out, if get_elf() { 0 } else { addr });
        let mut file: i64 = 1;
        let mut line: i64 = 1;
        let mut col: i64 = 0;
        let mut k: i64 = 0;
        while k < get_rows().count {
            let row_addr = (*get_frags().add((*get_rows().data.add(k as usize)) as usize)).addr + (*get_rows().data.add((k + 1) as usize));
            let row_file = (*get_rows().data.add((k + 2) as usize));
            let row_line = (*get_rows().data.add((k + 3) as usize));
            let row_col = (*get_rows().data.add((k + 4) as usize));
            if row_file != file {
                w8(out, 4);
                uleb(out, row_file);
                file = row_file;
            }
            if row_col != col {
                w8(out, 5);
                uleb(out, row_col);
                col = row_col;
            }
            let mut dl = row_line - line;
            let da = row_addr - addr;
            if dl < LINE_BASE || dl >= LINE_BASE + LINE_RANGE {
                w8(out, 3);
                sleb(out, dl);
                dl = 0;
            }
            let special = (dl - LINE_BASE) + LINE_RANGE * da + OPCODE_BASE;
            if special <= 255 {
                w8(out, special);
            } else {
                w8(out, 2);
                uleb(out, da);
                if dl != 0 {
                    w8(out, (dl - LINE_BASE) + OPCODE_BASE);
                } else {
                    w8(out, 1);
                }
            }
            line = row_line;
            addr = row_addr;
            k += 5;
        }
        // The end of the sequence: the end of the text section.
        let end = (*get_bufs().add(pcx.sec_buf[SEC_TEXT as usize] as usize)).len;
        if end > addr {
            w8(out, 2);
            uleb(out, end - addr);
        }
        w8(out, 0);
        uleb(out, 1);
        w8(out, 1);
        let total = (*get_bufs().add(out as usize)).len - start - 4;
        let d = (*get_bufs().add(out as usize)).data;
        for i in 0..4 {
            (*d.add((start + i) as usize)) = ((total >> (8 * i)) & 255) as u8;
            (*d.add((start + 6 + i) as usize)) = ((header_len >> (8 * i)) & 255) as u8;
        }
    }
}

// (0.28.0) CFI_FNS's accessors: every use of it is one of them.
pub fn get_cfi_fns() -> IntVec {
    // UNSAFE: the assembler's state, a process-wide static mut that the
    // main thread and the assembler thread use in turn; Rust has no safe
    // access to a static mut
    // SAFETY: one thread at a time uses it: the main thread before
    // asm_thread_start (assembler_begin, from asm_stream_begin, runs before
    // it in compile_program) and after asm_thread_finish's pthread_join,
    // the assembler thread (asm_thread_main -> assemble_bytes) in between;
    // pthread_create and pthread_join order the hand-overs; no worker
    // reaches it, the -O0 main thread's code generation between start and
    // finish (gen_places_function, gen_atomic_function, asm_hand_over and
    // the loop around them) touches none of it, and at -O1+ there is no
    // assembler thread (only the main thread assembles, in join_task's
    // asm_flush); accessed through the accessor's raw pointer, no reference
    // kept
    unsafe { CFI_FNS }
}

pub fn set_cfi_fns(v: IntVec) {
    // UNSAFE: the assembler's state, a process-wide static mut that the
    // main thread and the assembler thread use in turn; Rust has no safe
    // access to a static mut
    // SAFETY: one thread at a time uses it: the main thread before
    // asm_thread_start (assembler_begin, from asm_stream_begin, runs before
    // it in compile_program) and after asm_thread_finish's pthread_join,
    // the assembler thread (asm_thread_main -> assemble_bytes) in between;
    // pthread_create and pthread_join order the hand-overs; no worker
    // reaches it, the -O0 main thread's code generation between start and
    // finish (gen_places_function, gen_atomic_function, asm_hand_over and
    // the loop around them) touches none of it, and at -O1+ there is no
    // assembler thread (only the main thread assembles, in join_task's
    // asm_flush); accessed through the accessor's raw pointer, no reference
    // kept
    unsafe {
        CFI_FNS = v;
    }
}

