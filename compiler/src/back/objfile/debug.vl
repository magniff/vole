// What -g adds to the object (0.11): the `.cfi_*` directives, made into
// Mach-O's compact unwind section, and `.file` / `.loc`, made into the
// DWARF line program of .debug_line once layout has fixed the addresses.

use crate::back::objfile::{
    Asm, Frag, SEC_DEBUG_LINE, SEC_TEXT, SEC_UNWIND, TAIL_NONE, here, reloc, w16, w32, w64, w8,
};
use crate::back::objfile::assemble::{asm_error, is_space, parse_number, text_is};
use crate::back::objfile::resolve::{
    ELF_A64_ABS64, ELF_X64_64, MACHO_A64_UNSIGNED, MACHO_X64_UNSIGNED,
};
use crate::base::{buf_bytes, buf_len, buf_set};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};

// ---- Call frame information (0.11, -g, Mach-O) ----
//
// The `.cfi_*` directives describe the standard frame a function sets up
// at its entry (the frame pointer and return address saved, the frame
// pointer the CFA's base): what Mach-O's compact unwind encoding says in
// one word per function, as LLVM writes it from them (debuggers unwind
// with it, without having to understand the code).

pub fn cfi_directive(a: i64, b: i64, asm: &mut Asm<Comp>) {
    unsafe {
        if get_elf() {
            asm_error("call frame information is written on Mach-O only", asm);
        }
        if text_is(a, b, b".cfi_startproc", asm) {
            asm.cfi_fns.push(asm.open);
            asm.cfi_fns.push(here(asm) - asm.frags[asm.open as usize].start);
            asm.cfi_ops = 0;
        } else if text_is(a, b, b".cfi_endproc", asm) {
            if asm.cfi_ops != 3 {
                asm_error("call frame information other than the standard frame", asm);
            }
            asm.cfi_fns.push(asm.open);
            asm.cfi_fns.push(here(asm) - asm.frags[asm.open as usize].start);
        }
        else if text_is(a, b, b".cfi_def_cfa", asm) || text_is(a, b, b".cfi_offset", asm)
            || text_is(a, b, b".cfi_def_cfa_offset", asm)
            || text_is(a, b, b".cfi_def_cfa_register", asm) {
            // (the standard frame's three, in the order the back ends write
            // them)
            asm.cfi_ops = asm.cfi_ops + (1);
        } else {
            asm_error("unknown CFI directive", asm);
        }
    }
}

// The compact unwind entries: per function its address (relocated), size,
// encoding (a frame: UNWIND_ARM64_MODE_FRAME, UNWIND_X86_64_MODE_RBP_FRAME),
// and no personality or LSDA.
pub fn compact_unwind(asm: &mut Asm<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let out = pcx.sec_buf[SEC_UNWIND as usize];
        asm.sec_used[SEC_UNWIND as usize] = true;
        asm.sec_align[SEC_UNWIND as usize] = 3;
        // An empty fragment, at the section's start, for its symbol.
        asm.frags.push(Frag {
            sec: SEC_UNWIND, start: 0, len: 0, tail: TAIL_NONE, arg: 0, sym: -1, long: false,
            addr: 0, atom: -1,
        });
        let mut k: i64 = 0;
        while k < asm.cfi_fns.len() as i64 {
            let start = asm.frags[(asm.cfi_fns[k as usize]) as usize].addr + (
                asm.cfi_fns[(k + 1) as usize]);
            let end = asm.frags[(asm.cfi_fns[(k + 2) as usize]) as usize].addr + (
                asm.cfi_fns[(k + 3) as usize]);
            reloc(SEC_UNWIND, buf_len(out),
                if get_x86() { MACHO_X64_UNSIGNED } else { MACHO_A64_UNSIGNED }, -1 - SEC_TEXT,
                start, false, 3, pcx);
            w64(out, start);
            w32(out, end - start);
            w32(out, if get_x86() { 0x01000000 } else { 0x04000000 });
            w64(out, 0);
            w64(out, 0);
            k += 4;
        }
    }
}

// ---- DWARF line tables (0.11, -g) ----
//
// `.file N "path"` names file N; `.loc N line column` gives the source
// position of the next instruction: a row of the line table. The rows make
// the line program of .debug_line (DWARF 4), written after layout, where
// the addresses are known; its one sequence covers the text section.

pub fn line_row(asm: &mut Asm<Comp>) {
    unsafe {
        asm.loc_pending = false;
        if asm.cur_sec != SEC_TEXT {
            return;
        }
        asm.rows.push(asm.open);
        asm.rows.push(here(asm) - asm.frags[asm.open as usize].start);
        asm.rows.push(asm.loc_file);
        asm.rows.push(asm.loc_line);
        asm.rows.push(asm.loc_col);
    }
}

// .file N "path"
pub fn dwarf_file(a: i64, b: i64, asm: &mut Asm<Comp>) {
    unsafe {
        let mut i = a;
        let start = i;
        while i < b && !is_space(asm.text[i as usize]) {
            i += 1;
        }
        let n = parse_number(start, i, asm);
        while i < b && asm.text[i as usize] != b'"' {
            i += 1;
        }
        if i >= b {
            asm_error("expected a file name", asm);
        }
        i += 1;
        let mut path: Vec<u8, Comp> = Vec::new_in(Comp {});
        while i < b && asm.text[i as usize] != b'"' {
            if asm.text[i as usize] == b'\\' && i + 1 < b {
                i += 1;
            }
            path.push(asm.text[i as usize]);
            i += 1;
        }
        // The directory and the name: around the last '/'.
        let slash = match path.iter().rposition(|c| *c == b'/') {
            Some(k) => k as i64,
            None => -1,
        };
        while asm.file_name.len() as i64 <= n {
            asm.file_name.push(0);
            asm.file_dir.push(0);
        }
        asm.file_name[n as usize] = name_copy(&path[(slash + 1) as usize..], &mut asm.dbg_names);
        if slash > 0 {
            let dir = &path[..slash as usize];
            let mut d: i64 = 0;
            while d < asm.dirs.len() as i64
                && name_bytes(asm.dirs[d as usize], &asm.dbg_names) != dir {
                d += 1;
            }
            if d == asm.dirs.len() as i64 {
                let copy = name_copy(dir, &mut asm.dbg_names);
                asm.dirs.push(copy);
            }
            asm.file_dir[n as usize] = d + 1;
        }
    }
}

// (0.27.0) A file table's name: a copy of the bytes and a NUL after them
// in `pool` (Asm.dbg_names), as its position + 1 (0: none). The
// assembler, on a thread of its own, interns no symbol: the program's
// symbols are the main thread's.
fn name_copy(bytes: &[u8], pool: &mut Vec<u8, Comp>) -> i64 {
    let at = pool.len() as i64;
    pool.extend_from_slice(bytes);
    pool.push(0);
    at + 1
}

// The bytes of a name name_copy made.
fn name_bytes(name: i64, pool: &[u8]) -> &[u8] {
    let rest = &pool[(name - 1) as usize..];
    match rest.iter().position(|c| *c == 0) {
        Some(n) => &rest[..n],
        None => rest,
    }
}

fn uleb(out: i64, value: i64) {
    let mut v = value;
    loop {
        let low = v & 127;
        v = v >> 7;
        if v == 0 {
            w8(out, low);
            return;
        }
        w8(out, low | 128);
    }
}

fn sleb(out: i64, value: i64) {
    let mut v = value;
    loop {
        let low = v & 127;
        v = v >> 7;
        if (v == 0 && (low & 64) == 0) || (v == -1 && (low & 64) != 0) {
            w8(out, low);
            return;
        }
        w8(out, low | 128);
    }
}

const LINE_BASE: i64 = -5;
const LINE_RANGE: i64 = 14;
const OPCODE_BASE: i64 = 13;

// The line program, after the contents of .debug_line (a label at most).
pub fn line_program(asm: &mut Asm<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let out = pcx.sec_buf[SEC_DEBUG_LINE as usize];
        asm.sec_used[SEC_DEBUG_LINE as usize] = true;
        let start = buf_len(out);
        w32(out, 0);
        w16(out, 4);
        w32(out, 0);
        let header_start = buf_len(out);
        w8(out, 1);
        w8(out, 1);
        w8(out, 1);
        w8(out, LINE_BASE & 255);
        w8(out, LINE_RANGE);
        w8(out, OPCODE_BASE);
        let lengths: [i64; 12] = [0i64, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1];
        for i in 0..12 {
            w8(out, lengths[i as usize]);
        }
        for d in 0..asm.dirs.len() as i64 {
            buf_bytes(out, name_bytes(asm.dirs[d as usize], &asm.dbg_names));
            w8(out, 0);
        }
        w8(out, 0);
        for f in 1..asm.file_name.len() as i64 {
            if (asm.file_name[f as usize]) == 0 {
                // (a number not named: an empty name keeps the numbering)
                w8(out, 0);
                w8(out, 0);
                w8(out, 0);
                w8(out, 0);
                continue;
            }
            buf_bytes(out, name_bytes(asm.file_name[f as usize], &asm.dbg_names));
            w8(out, 0);
            uleb(out, (asm.file_dir[f as usize]));
            w8(out, 0);
            w8(out, 0);
        }
        w8(out, 0);
        let header_len = buf_len(out) - header_start;
        // The program: the sequence's address (relocated: the text section's
        // start plus the first row's offset), then one row per entry.
        let mut addr = asm.frags[(asm.rows[0]) as usize].addr + (asm.rows[1]);
        w8(out, 0);
        uleb(out, 9);
        w8(out, 2);
        reloc(SEC_DEBUG_LINE, buf_len(out),
            if get_elf() && get_x86() { ELF_X64_64 } else if get_elf() { ELF_A64_ABS64 }
            else if get_x86() { MACHO_X64_UNSIGNED } else { MACHO_A64_UNSIGNED }, -1 - SEC_TEXT,
            addr, false, 3, pcx);
        w64(out, if get_elf() { 0 } else { addr });
        let mut file: i64 = 1;
        let mut line: i64 = 1;
        let mut col: i64 = 0;
        let mut k: i64 = 0;
        while k < asm.rows.len() as i64 {
            let row_addr = asm.frags[(asm.rows[k as usize]) as usize].addr + (
                asm.rows[(k + 1) as usize]);
            let row_file = (asm.rows[(k + 2) as usize]);
            let row_line = (asm.rows[(k + 3) as usize]);
            let row_col = (asm.rows[(k + 4) as usize]);
            if row_file != file {
                w8(out, 4);
                uleb(out, row_file);
                file = row_file;
            }
            if row_col != col {
                w8(out, 5);
                uleb(out, row_col);
                col = row_col;
            }
            let mut dl = row_line - line;
            let da = row_addr - addr;
            if dl < LINE_BASE || dl >= LINE_BASE + LINE_RANGE {
                w8(out, 3);
                sleb(out, dl);
                dl = 0;
            }
            let special = (dl - LINE_BASE) + LINE_RANGE * da + OPCODE_BASE;
            if special <= 255 {
                w8(out, special);
            } else {
                w8(out, 2);
                uleb(out, da);
                if dl != 0 {
                    w8(out, (dl - LINE_BASE) + OPCODE_BASE);
                } else {
                    w8(out, 1);
                }
            }
            line = row_line;
            addr = row_addr;
            k += 5;
        }
        // The end of the sequence: the end of the text section.
        let end = buf_len(pcx.sec_buf[SEC_TEXT as usize]);
        if end > addr {
            w8(out, 2);
            uleb(out, end - addr);
        }
        w8(out, 0);
        uleb(out, 1);
        w8(out, 1);
        let total = buf_len(out) - start - 4;
        for i in 0..4 {
            buf_set(out, start + i, ((total >> (8 * i)) & 255) as u8);
            buf_set(out, start + 6 + i, ((header_len >> (8 * i)) & 255) as u8);
        }
    }
}
