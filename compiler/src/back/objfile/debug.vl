    // UNSAFE: the assembler's state, a process-wide static mut that the
    // main thread and the assembler thread use in turn; Rust has no safe
    // access to a static mut
    // SAFETY: one thread at a time uses it: the main thread before
    // asm_thread_start (assembler_begin, from asm_stream_begin, runs before
