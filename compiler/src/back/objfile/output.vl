// What write_output adds around the object (0.16): the C module's symbols
// spelled for assemblers (c_module_symbols), and the link: the command
// that makes the executable (link_command), with what the command line
// added for it (`-l NAME`, `-L DIR`, objects, archives, shared libraries,
// C files) and C's math library when the program calls into it.
//
// (0.25) link_program runs the link. A program of vole objects only (no
// C file, no link argument, no $VOLE_CC) is linked by the system's linker
// run directly, without `sh` and the C driver: the command the driver
// would run (`cc -###`) is asked for once and kept in a file (the link
// template), then reused while the files it names stay what they were.
// `--linker=cc` (or $VOLE_LINKER=cc) links through `cc` as before; so
// does every link the direct one cannot make. On AArch64 macOS the
// compiler links such a program itself (link_macho) when it can: the
// default; `--linker=system` runs ld.

use crate::back::objfile::{get_asym_count, get_asyms};
use crate::base::{
    IntVec, alloc_array, alloc_zeroed, buf_at, buf_byte, buf_bytes, buf_clear, buf_fmt, buf_hex,
    buf_len, buf_new, buf_ptr, buf_slice, buf_str, buf_truncate, buf_write_fd, cstr, die2, fclose,
    fopen, fread, fwrite, realpath, streq, strlen,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::middle::ctx::FnCtx;

extern "C" {
    fn getenv(name: *mut u8) -> *mut u8;
    fn system(command: *mut u8) -> i32;
    static environ: *mut *mut u8;

    fn posix_spawnp(pid: *mut i32, file: *mut u8, actions: *mut u8, attr: *mut u8,
        argv: *mut *mut u8, envp: *mut *mut u8) -> i32;

    fn posix_spawn_file_actions_init(actions: *mut u8) -> i32;
    fn posix_spawn_file_actions_adddup2(actions: *mut u8, fd: i32, to: i32) -> i32;
    fn posix_spawn_file_actions_destroy(actions: *mut u8) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn creat(path: *mut u8, mode: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn unlink(path: *mut u8) -> i32;
    fn rename(from: *mut u8, to: *mut u8) -> i32;
    fn mkdir(path: *mut u8, mode: i32) -> i32;
    fn uname(info: *mut u8) -> i32;
    fn confstr(name: i32, buf: *mut u8, size: u64) -> u64;
    fn getpid() -> i32;
}

// ---- The C module's symbols ----

// The functions of the C module (an impl's methods on a C type, generic
// instances at C types: `id.GN9<c>.div_t`) have `<c>`, its name, in their
// symbols, which no assembler takes. It is spelled `0c_` (as long, and no
// module's name: a name does not start with a digit) in the text, before
// it is written (-S) or assembled: the object and `cc` of the text agree.
pub fn c_module_symbols(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        if pcx.c_module < 0 {
            return;
        }
        let text = buf_ptr(cx.asm);
        let n = buf_len(cx.asm);
        let mut i: i64 = 0;
        while i + 2 < n {
            if (*text.add(i as usize)) == b'<' && (*text.add((i + 1) as usize)) == b'c'
                && (*text.add((i + 2) as usize)) == b'>' {
                (*text.add(i as usize)) = b'0';
                (*text.add((i + 2) as usize)) = b'_';
                i += 3;
            } else {
                i += 1;
            }
        }
    }
}

// ---- The link ----

// Whether path ends with suffix.
unsafe fn ends_with(path: *mut u8, suffix: *mut u8) -> bool {
    let n = strlen(path) as i64;
    let k = strlen(suffix) as i64;
    if n <= k {
        return false;
    }
    for i in 0..k {
        if (*path.add((n - k + i) as usize)) != (*suffix.add(i as usize)) {
            return false;
        }
    }
    true
}

// Whether a command-line input is for the link (an object, an archive, a
// shared library, a C file) rather than vole source.
pub fn is_link_input(path: *mut u8) -> bool {
    unsafe {
        ends_with(path, c".o") || ends_with(path, c".a") || ends_with(path, c".c")
            || ends_with(path, c".so") || ends_with(path, c".dylib")
    }
}

// Adds `-l NAME` (kind 'l'), `-L DIR` ('L') or an input (' ') to the link.
pub fn add_link_arg(kind: u8, text: *mut u8, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.link_args.push(kind as i64);
        pcx.link_args.push(text as i64);
        if kind == b' ' && ends_with(text, c".c") {
            pcx.link_c = true;
        }
    }
}

// Adds an -I directory (the C headers' search path is the C files' too).
pub fn add_link_include(dir: *mut u8, pcx: &mut Ctx<Comp>) {
    pcx.link_includes.push(dir as i64);
}

// Adds name (a C string made of it) to v, unless it is there.
fn add_once(v: &mut IntVec, name: &[u8]) {
    unsafe {
        for i in 0..v.len() as i64 {
            if cstr((v[i as usize]) as *mut u8) == name {
                return;
            }
        }
        let b = buf_new();
        buf_bytes(b, name);
        buf_byte(b, 0);
        v.push(buf_ptr(b) as i64);
    }
}

pub fn add_framework(name: &[u8], pcx: &mut Ctx<Comp>) {
    add_once(&mut pcx.link_frameworks, name);
}

// A link an extern block declares (front::parser::foreign::link_block),
// with the C symbols of its functions and statics (C strings).
pub fn add_link_decl(kind: u8, name: &[u8], syms: &mut IntVec, pcx: &mut Ctx<Comp>) {
    unsafe {
        let b = buf_new();
        buf_bytes(b, name);
        buf_byte(b, 0);
        pcx.link_decls.push(kind as i64);
        pcx.link_decls.push(buf_ptr(b) as i64);
        pcx.link_decls.push(pcx.link_decl_syms.len() as i64);
        pcx.link_decls.push(syms.len() as i64);
        for i in 0..syms.len() as i64 {
            pcx.link_decl_syms.push((syms[i as usize]));
        }
    }
}

// Adds the declared links the program uses to LINK_FRAMEWORKS and
// LINK_LIBS: those whose block has a symbol the object refers to and does
// not define (or no symbol at all).
fn resolve_declared(pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut d: i64 = 0;
        while d < pcx.link_decls.len() as i64 {
            let first = (pcx.link_decls[(d + 2) as usize]);
            let n = (pcx.link_decls[(d + 3) as usize]);
            let mut used = n == 0;
            for s in 0..get_asym_count() {
                if used {
                    break;
                }
                if (*get_asyms().add(s as usize)).defined {
                    continue;
                }
                let mut text = (*get_asyms().add(s as usize)).text;
                if !get_elf() {
                    if text.len() == 0 || text[0] != b'_' {
                        continue;
                    }
                    text = &text[1..text.len()];
                }
                for k in first..first + n {
                    if cstr((pcx.link_decl_syms[k as usize]) as *mut u8) == text {
                        used = true;
                        break;
                    }
                }
            }
            if used {
                let name = cstr((pcx.link_decls[(d + 1) as usize]) as *mut u8);
                if (pcx.link_decls[d as usize]) == b'F' as i64 {
                    add_once(&mut pcx.link_frameworks, name);
                } else {
                    add_once(&mut pcx.link_libs, name);
                }
            }
            d += 4;
        }
        // (0.25.3: kept for a failed link's error, linkfail.vl)
        for i in 0..pcx.link_decls.len() as i64 {
            pcx.link_decls_seen.push((pcx.link_decls[i as usize]));
        }
        pcx.link_decls.clear();
    }
}

// Whether the program links a framework or a library of its own.
fn links_declared(pcx: &Ctx<Comp>) -> bool {
    pcx.link_libs.len() as i64 > 0 || (!get_elf() && pcx.link_frameworks.len() as i64 > 0)
}

// Whether the command line added anything for the link.
pub fn link_args_given(pcx: &Ctx<Comp>) -> bool {
    pcx.link_args.len() as i64 > 0
}

// ---- What a failed link's error names (0.25.3, linkfail.vl) ----

// Word w of the IntVecs of this file that hold C strings (LINK_ARGS'
// texts, LINK_DECLS_SEEN's names, LINK_DECL_SYMS) as that C string.
fn c_word(w: i64) -> *mut u8 {
    w as *mut u8
}

// The command line's inputs for the link (objects, archives, shared
// libraries, C files): how many.
pub fn link_input_count(pcx: &Ctx<Comp>) -> i64 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < pcx.link_args.len() as i64 {
        if pcx.link_args.get(i) == b' ' as i64 {
            n += 1;
        }
        i += 2;
    }
    n
}

// Input k of the link (0 <= k < link_input_count()), a C string.
pub fn link_input(k: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < pcx.link_args.len() as i64 {
        if pcx.link_args.get(i) == b' ' as i64 {
            if n == k {
                return c_word(pcx.link_args.get(i + 1));
            }
            n += 1;
        }
        i += 2;
    }
    panic("link_input: no such input")
}

// Whether the command line names library `name` (`-l name`).
pub fn lib_given(name: &[u8], pcx: &Ctx<Comp>) -> bool {
    let mut i: i64 = 0;
    while i < pcx.link_args.len() as i64 {
        if pcx.link_args.get(i) == b'l' as i64 && cstr(c_word(pcx.link_args.get(i + 1))) == name {
            return true;
        }
        i += 2;
    }
    false
}

// The #[link] whose extern block declares C symbol `sym` (with kind 0),
// or that names `sym` as a library ('l') or a framework ('F'): its index,
// or -1.
pub fn link_decl_of(kind: u8, sym: &[u8], pcx: &Ctx<Comp>) -> i64 {
    let mut d: i64 = 0;
    while d < pcx.link_decls_seen.len() as i64 {
        if kind != 0 {
            if pcx.link_decls_seen.get(d) == kind as i64 && cstr(link_decl_name(d, pcx)) == sym {
                return d;
            }
        } else {
            let first = pcx.link_decls_seen.get(d + 2);
            for s in first..first + pcx.link_decls_seen.get(d + 3) {
                if cstr(c_word(pcx.link_decl_syms.get(s))) == sym {
                    return d;
                }
            }
        }
        d += 4;
    }
    -1
}

// The library or framework #[link] d names (a C string).
pub fn link_decl_name(d: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    c_word(pcx.link_decls_seen.get(d + 1))
}

// Whether #[link] d names a framework.
pub fn link_decl_framework(d: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.link_decls_seen.get(d) == b'F' as i64
}

// The first C symbol of #[link] d's block (a C string), or 0: none.
pub fn link_decl_first(d: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    if pcx.link_decls_seen.get(d + 3) == 0 {
        return 0 as *mut u8;
    }
    c_word(pcx.link_decl_syms.get(pcx.link_decls_seen.get(d + 2)))
}

// s, quoted for the shell.
fn quoted(b: i64, s: *mut u8) {
    unsafe {
        buf_byte(b, b'\'');
        let mut i: i64 = 0;
        while (*s.add(i as usize)) != 0 {
            if (*s.add(i as usize)) == b'\'' {
                buf_str(b, c"'\\''");
            } else {
                buf_byte(b, (*s.add(i as usize)));
            }
            i += 1;
        }
        buf_byte(b, b'\'');
    }
}

// Whether the program calls a function of C's math library (a symbol it
// refers to and does not define, by its name; an `f` or `l` at the end:
// the float and long double forms).
fn uses_libm() -> bool {
    let all = [
        "acos", "asin", "atan", "atan2", "cos", "sin", "tan", "acosh", "asinh", "atanh", "cosh",
        "sinh", "tanh", "exp", "exp2", "expm1", "log", "log10", "log1p", "log2", "logb", "ilogb",
        "pow", "sqrt", "cbrt", "hypot", "erf", "erfc", "tgamma", "lgamma", "ceil", "floor",
        "trunc", "round", "lround", "llround", "rint", "lrint", "llrint", "nearbyint", "fmod",
        "remainder", "remquo", "copysign", "nan", "nextafter", "nexttoward", "fdim", "fmax",
        "fmin", "fma", "fabs", "frexp", "ldexp", "modf", "scalbn", "scalbln", "sincos",
    ];
    let names = &all[..];
    unsafe {
        for s in 0..get_asym_count() {
            if (*get_asyms().add(s as usize)).defined {
                continue;
            }
            let mut name = (*get_asyms().add(s as usize)).text;
            if !get_elf() {
                if name.len() == 0 || name[0] != b'_' {
                    continue;
                }
                name = &name[1..name.len()];
            }
            if name.len() == 0 {
                continue;
            }
            let last = name[(name.len() as i64 - 1) as usize];
            let base = if last == b'f'
                || last == b'l' { &name[0..(name.len() as i64 - 1) as usize] } else { name };
            for i in 0..names.len() {
                if names[i].as_bytes() == name || names[i].as_bytes() == base {
                    return true;
                }
            }
        }
        false
    }
}

// (0.18.1) Whether the program calls pthread_create (a symbol it refers to
// and does not define): glibc before 2.34 has it in libpthread, which is
// linked then (the compiler's own threads, middle::threads).
fn uses_pthreads() -> bool {
    unsafe {
        for s in 0..get_asym_count() {
            if !(*get_asyms().add(s as usize)).defined
                && (*get_asyms().add(s as usize)).text == b"pthread_create" {
                return true;
            }
        }
        false
    }
}

// The command linking the program's object obj_path into executable path:
// cc (or $VOLE_CC), the command line's link arguments in their order
// (C files compiled at the program's -O level, with its -I directories
// and -g), then libm on Linux when the program or a C file may call it
// (Linux links it only when asked; on macOS it is part of libSystem).
pub fn link_command(path: *mut u8, obj_path: *mut u8, pcx: &Ctx<Comp>) -> *mut u8 {
    unsafe {
        let cmd = buf_new();
        let cc = getenv(c"VOLE_CC");
        buf_str(cmd, if cc != 0 as *mut u8 && (*cc.add(0)) != 0 { cc } else { c"cc" });
        if !get_elf() {
            buf_str(cmd, if get_x86() { c" -arch x86_64" } else { c" -arch arm64" });
        }
        if pcx.link_c {
            buf_str(cmd, c" -O");
            buf_byte(cmd, (b'0' as i64 + pcx.opt_level) as u8);
            if pcx.debug_info {
                buf_str(cmd, c" -g");
            }
            for i in 0..pcx.link_includes.len() as i64 {
                buf_str(cmd, c" -I");
                quoted(cmd, (pcx.link_includes[i as usize]) as *mut u8);
            }
        }
        buf_str(cmd, c" -o ");
        quoted(cmd, path);
        buf_byte(cmd, b' ');
        quoted(cmd, obj_path);
        let mut i: i64 = 0;
        while i < pcx.link_args.len() as i64 {
            let kind = (pcx.link_args[i as usize]) as u8;
            buf_byte(cmd, b' ');
            if kind != b' ' {
                buf_byte(cmd, b'-');
                buf_byte(cmd, kind);
            }
            quoted(cmd, (pcx.link_args[(i + 1) as usize]) as *mut u8);
            i += 2;
        }
        if !get_elf() {
            for i in 0..pcx.link_frameworks.len() as i64 {
                buf_str(cmd, c" -framework ");
                quoted(cmd, (pcx.link_frameworks[i as usize]) as *mut u8);
            }
        }
        for i in 0..pcx.link_libs.len() as i64 {
            buf_str(cmd, c" -l");
            quoted(cmd, (pcx.link_libs[i as usize]) as *mut u8);
        }
        if get_elf() && (pcx.link_c || uses_libm()) {
            buf_str(cmd, c" -lm");
        }
        if get_elf() && uses_pthreads() {
            buf_str(cmd, c" -lpthread");
        }
        buf_byte(cmd, 0);
        buf_ptr(cmd)
    }
}

// ---- Running the link (0.25) ----

// The linker: the system's, run directly, through `cc`, or the compiler's
// own (link_macho: programs of vole objects on AArch64 macOS; the
// default, which is the system's for any other program).
pub const LINKER_SYSTEM: i64 = 0;
pub const LINKER_CC: i64 = 1;
pub const LINKER_INTERNAL: i64 = 2;

// The linker named `name` (system, cc, internal), or -1.
fn linker_of_name(name: *mut u8) -> i64 {
    if streq(name, c"system") {
        return LINKER_SYSTEM;
    }
    if streq(name, c"cc") {
        return LINKER_CC;
    }
    if streq(name, c"internal") {
        return LINKER_INTERNAL;
    }
    -1
}

// `--linker=NAME`: whether NAME is a linker.
pub fn set_linker(name: *mut u8, pcx: &mut Ctx<Comp>) -> bool {
    pcx.linker = linker_of_name(name);
    pcx.linker >= 0
}

// The linker this link uses.
fn linker(pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.linker >= 0 {
            return pcx.linker;
        }
        let env = getenv(c"VOLE_LINKER");
        if env == 0 as *mut u8 || (*env.add(0)) == 0 {
            // (link_program falls back to the system's when the internal
            // one does not take the program)
            return LINKER_INTERNAL;
        }
        let l = linker_of_name(env);
        if l < 0 {
            die2(c"$VOLE_LINKER is not a linker (system, cc or internal): ", env);
        }
        l
    }
}

// Links obj_path into the executable path: 0, or the link's exit status
// (the linker said why).
pub fn link_program(path: *mut u8, obj_path: *mut u8, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        resolve_declared(pcx);
        let cc = getenv(c"VOLE_CC");
        // ($VOLE_CC=cc, as tests/run.sh sets it, is the default driver)
        let own = !pcx.link_c && pcx.link_args.len() as i64 == 0
            && (cc == 0 as *mut u8 || (*cc.add(0)) == 0 || streq(cc, c"cc"));
        let how = linker(pcx);
        // (--linker=internal: the compiler's own, when it takes the program;
        // else the system's)
        if own && how == LINKER_INTERNAL && !pcx.debug_info && !links_declared(pcx)
            && crate::back::objfile::link_macho::link_macho(path, obj_path) {
            return 0;
        }
        if own && how != LINKER_CC && link_direct(path, obj_path, pcx) {
            return 0;
        }
        // (0.25.3) through the C driver, its text kept: a failure is read
        // into one error (linkfail.vl), its warnings printed as they were
        let cmd = link_command(path, obj_path, pcx);
        pcx.link_cmd = cmd;
        let lb = buf_new();
        buf_fmt(lb, format_args("{}.log\0", str::from_utf8(cstr(obj_path)).unwrap()));
        let log = buf_ptr(lb);
        let argv = alloc_array::<*mut u8>(4i64);
        (*argv.add(0)) = c"/bin/sh";
        (*argv.add(1)) = c"-c";
        (*argv.add(2)) = cmd;
        (*argv.add(3)) = 0 as *mut u8;
        let status = run_logged(argv, log);
        pcx.link_log = buf_new();
        read_into(log, pcx.link_log);
        unlink(log);
        if status == 0 && buf_len(pcx.link_log) > 0 {
            buf_write_fd(pcx.link_log, 2);
        }
        status
    }
}

// The status of a process as waitpid gives it: its exit code, or 128 +
// the signal that ended it.
fn exit_code(status: i32) -> i64 {
    let s = status as i64;
    if (s & 127) == 0 { (s >> 8) & 255 } else { 128 + (s & 127) }
}

// Runs argv (argv[0] found as a shell finds it; argv ends with 0), its
// stdout and stderr into the file log (made anew): its exit status, 127
// when it could not be run.
fn run_logged(argv: *mut *mut u8, log: *mut u8) -> i64 {
    unsafe {
        let fd = creat(log, 384);
        if fd < 0 {
            return 127;
        }
        // (posix_spawn_file_actions_t is opaque: 8 bytes on macOS, 80 with
        // glibc)
        let actions = alloc_zeroed(256);
        posix_spawn_file_actions_init(actions);
        posix_spawn_file_actions_adddup2(actions, fd, 1);
        posix_spawn_file_actions_adddup2(actions, fd, 2);
        let mut pid = 0 as i32;
        let r = posix_spawnp(&mut pid, (*argv.add(0)), actions, 0 as *mut u8, argv, environ);
        posix_spawn_file_actions_destroy(actions);
        close(fd);
        if r != 0 {
            return 127;
        }
        let mut status = 0 as i32;
        if waitpid(pid, &mut status, 0) != pid {
            return 127;
        }
        exit_code(status)
    }
}

// The file at path, appended to buffer b: whether it could be read.
pub fn read_into(path: *mut u8, b: i64) -> bool {
    unsafe {
        let f = fopen(path, c"rb");
        if f == 0 as *mut u8 {
            return false;
        }
        let chunk = alloc_zeroed(65536);
        loop {
            let got = fread(chunk, 1, 65536, f);
            if got == 0 {
                break;
            }
            buf_bytes(b,
                std::slice::from_raw_parts(chunk.add((0) as usize), (got as i64 - (0)) as usize));
        }
        fclose(f);
        true
    }
}

// The link made by the system's linker run directly, with the link
// template: whether it linked. When it did not, what it printed is not
// shown and its template is dropped: the caller links through `cc`, which
// says why.
fn link_direct(path: *mut u8, obj_path: *mut u8, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let lb = buf_new();
        buf_fmt(lb, format_args("{}.log\0", str::from_utf8(cstr(obj_path)).unwrap()));
        let log = buf_ptr(lb);
        let file = template_file();
        let mut t: i64 = -1;
        if file != 0 as *mut u8 {
            t = template_read(file);
        }
        if t < 0 {
            t = template_make(path, obj_path, log);
            if t < 0 {
                unlink(log);
                return false;
            }
            if file != 0 as *mut u8 {
                template_write(t, file);
            }
        }
        let status = run_logged(template_argv(t, path, obj_path, pcx), log);
        if status == 0 {
            // (the linker's warnings, as cc shows them)
            let out = buf_new();
            if read_into(log, out) && buf_len(out) > 0 {
                buf_write_fd(out, 2);
            }
        } else if file != 0 as *mut u8 {
            unlink(file);
        }
        unlink(log);
        status == 0
    }
}

// ---- The link template ----

// The driver's link command, the output and the object as markers: one
// argument a line, after a first line that stamps it (the real paths of
// the arguments that are absolute paths; they change when the toolchain or
// the SDK does).
const MARK_OUT: *mut u8 = c"@vole-out";
const MARK_OBJ: *mut u8 = c"@vole-obj";

// struct utsname: sysname is the first field, release the third; the
// fields are 256 bytes long on macOS, 65 on Linux.
const UTS_SIZE: i64 = 2048;

// (confstr) The per-user cache directory on macOS.
const CS_DARWIN_USER_CACHE_DIR: i32 = 65538;

// The file of the link template (named by a hash of what the driver's
// answer depends on: the target, the system's release, the environment
// the driver reads), or 0: none ($VOLE_LINK_CACHE=off, or no directory
// for it). Its directory: $VOLE_LINK_CACHE, else the user's cache
// directory (macOS), $XDG_CACHE_HOME or ~/.cache (Linux).
fn template_file() -> *mut u8 {
    unsafe {
        let info = alloc_zeroed(UTS_SIZE);
        if uname(info) != 0 {
            return 0 as *mut u8;
        }
        let macos = streq(info, c"Darwin");
        let field: i64 = if macos { 256 } else { 65 };
        let release = info.add((2 * field) as usize);
        let dir = buf_new();
        let env = getenv(c"VOLE_LINK_CACHE");
        if env != 0 as *mut u8 && (*env.add(0)) != 0 {
            if streq(env, c"off") {
                return 0 as *mut u8;
            }
            buf_str(dir, env);
        } else if macos {
            let room = alloc_zeroed(1024);
            let n = confstr(CS_DARWIN_USER_CACHE_DIR, room, 1024);
            if n == 0 || n > 1024 {
                return 0 as *mut u8;
            }
            buf_str(dir, room);
        } else {
            let xdg = getenv(c"XDG_CACHE_HOME");
            let home = getenv(c"HOME");
            if xdg != 0 as *mut u8 && (*xdg.add(0)) == b'/' {
                buf_str(dir, xdg);
            } else if home != 0 as *mut u8 && (*home.add(0)) == b'/' {
                buf_str(dir, home);
                buf_str(dir, c"/.cache");
                buf_byte(dir, 0);
                mkdir(buf_ptr(dir), 448);
                buf_truncate(dir, buf_len(dir) - 1);
            } else {
                return 0 as *mut u8;
            }
        }
        let key = buf_new();
        buf_str(key, c"vole-link 1\n");
        buf_str(key, if get_elf() { c"elf" } else { c"macho" });
        buf_str(key, if get_x86() { c" x86_64\n" } else { c" arm64\n" });
        buf_str(key, info);
        buf_byte(key, b' ');
        buf_str(key, release);
        buf_byte(key, b'\n');
        let all = [
            c"PATH", c"SDKROOT", c"DEVELOPER_DIR", c"MACOSX_DEPLOYMENT_TARGET", c"COMPILER_PATH",
            c"LIBRARY_PATH", c"GCC_EXEC_PREFIX", c"LD_RUN_PATH",
        ];
        let names = &all[..];
        for i in 0..names.len() {
            let v = getenv(names[i]);
            buf_str(key, names[i]);
            buf_byte(key, b'=');
            if v != 0 as *mut u8 {
                buf_str(key, v);
            }
            buf_byte(key, b'\n');
        }
        let mut h: u64 = 14695981039346656037;
        for i in 0..buf_len(key) {
            h ^= buf_at(key, i) as u64;
            h = h.wrapping_mul(1099511628211u64);
        }
        let at = buf_len(dir);
        if at > 0 && buf_at(dir, at - 1) != b'/' {
            buf_byte(dir, b'/');
        }
        buf_str(dir, c"vole-link-");
        buf_hex(dir, h, 16);
        buf_byte(dir, 0);
        buf_ptr(dir)
    }
}

// The stamp of the arguments in buffer t from offset `from` (one a line),
// appended to buffer b: each absolute path's real path, or `?`.
fn template_stamp(t: i64, from: i64, b: i64) {
    unsafe {
        let text = buf_ptr(t);
        let n = buf_len(t);
        let one = buf_new();
        let real = alloc_zeroed(4096);
        let mut i = from;
        while i < n {
            let mut j = i;
            while j < n && (*text.add(j as usize)) != b'\n' {
                j += 1;
            }
            if j > i && (*text.add(i as usize)) == b'/' {
                buf_clear(one);
                buf_bytes(one,
                    std::slice::from_raw_parts(text.add((i) as usize), (j - (i)) as usize));
                buf_byte(one, 0);
                if realpath(buf_ptr(one), real) != 0 as *mut u8 {
                    buf_str(b, real);
                } else {
                    buf_byte(b, b'?');
                }
                buf_byte(b, b' ');
            }
            i = j + 1;
        }
    }
}

// The template in file, as a buffer, when its stamp holds; else -1.
fn template_read(file: *mut u8) -> i64 {
    unsafe {
        let t = buf_new();
        if !read_into(file, t) {
            return -1;
        }
        let text = buf_ptr(t);
        let n = buf_len(t);
        if n == 0 || (*text.add((n - 1) as usize)) != b'\n' {
            return -1;
        }
        let mut first: i64 = 0;
        while (*text.add(first as usize)) != b'\n' {
            first += 1;
        }
        let stamp = buf_new();
        template_stamp(t, first + 1, stamp);
        if buf_len(stamp) != first
            || &buf_slice(stamp)[..first as usize]
            != std::slice::from_raw_parts(text.add((0) as usize), (first - (0)) as usize) {
            return -1;
        }
        // (one output and one object, each a whole line)
        let mut outs: i64 = 0;
        let mut objs: i64 = 0;
        let mut i = first + 1;
        while i < n {
            let mut j = i;
            while (*text.add(j as usize)) != b'\n' {
                j += 1;
            }
            if std::slice::from_raw_parts(text.add((i) as usize), (j - (i)) as usize)
                == cstr(MARK_OUT) {
                outs += 1;
            }
            else if std::slice::from_raw_parts(text.add((i) as usize), (j - (i)) as usize)
                == cstr(MARK_OBJ) {
                objs += 1;
            }
            i = j + 1;
        }
        if outs != 1 || objs != 1 {
            return -1;
        }
        t
    }
}

// Writes template t to file (under another name first, then renamed:
// links running at once read a whole template or none).
fn template_write(t: i64, file: *mut u8) {
    unsafe {
        let tmp = buf_new();
        buf_fmt(tmp, format_args("{}.{}\0", str::from_utf8(cstr(file)).unwrap(), getpid()));
        let f = fopen(buf_ptr(tmp), c"wb");
        if f == 0 as *mut u8 {
            return;
        }
        let n = buf_len(t) as u64;
        let wrote = fwrite(buf_ptr(t), 1, n, f);
        fclose(f);
        if wrote != n || rename(buf_ptr(tmp), file) != 0 {
            unlink(buf_ptr(tmp));
        }
    }
}

// Whether C string s starts with prefix.
unsafe fn starts_with(s: *mut u8, prefix: *mut u8) -> bool {
    let mut i: i64 = 0;
    while (*prefix.add(i as usize)) != 0 {
        if (*s.add(i as usize)) != (*prefix.add(i as usize)) {
            return false;
        }
        i += 1;
    }
    true
}

// The arguments of a line of `cc -###` (each in double quotes, with `\`
// before a quote, a backslash or `$`, or bare up to a space), appended to
// buffer b, each ended by a NUL, from offset i of text up to the line's
// end; their starts into args.
fn split_line(text: *mut u8, n: i64, from: i64, b: i64, args: &mut IntVec) {
    unsafe {
        let mut i = from;
        loop {
            while i < n && (*text.add(i as usize)) == b' ' {
                i += 1;
            }
            if i >= n || (*text.add(i as usize)) == b'\n' || (*text.add(i as usize)) == b'\r' {
                break;
            }
            args.push(buf_len(b));
            let mut quoted = false;
            while i < n && (*text.add(i as usize)) != b'\n' && (*text.add(i as usize)) != b'\r'
                && (quoted || (*text.add(i as usize)) != b' ') {
                if (*text.add(i as usize)) == b'"' {
                    quoted = !quoted;
                }
                else if (*text.add(i as usize)) == b'\\' && i + 1 < n
                    && (*text.add((i + 1) as usize)) != b'\n' {
                    i += 1;
                    buf_byte(b, (*text.add(i as usize)));
                } else {
                    buf_byte(b, (*text.add(i as usize)));
                }
                i += 1;
            }
            buf_byte(b, 0);
        }
    }
}

// What `cc -print-prog-name=ld` says (the linker collect2 runs), or 0.
fn driver_ld(log: *mut u8) -> *mut u8 {
    unsafe {
        let argv = alloc_array::<*mut u8>(3i64);
        (*argv.add(0)) = c"cc";
        (*argv.add(1)) = c"-print-prog-name=ld";
        if run_logged(argv, log) != 0 {
            return 0 as *mut u8;
        }
        let out = buf_new();
        if !read_into(log, out) {
            return 0 as *mut u8;
        }
        let mut n = buf_len(out);
        while n > 0
            && (buf_at(out, n - 1) == b'\n'
                || buf_at(out, n - 1) == b' ') {
            n -= 1;
        }
        if n == 0 {
            return 0 as *mut u8;
        }
        buf_truncate(out, n);
        buf_byte(out, 0);
        buf_ptr(out)
    }
}

// The link template for linking obj_path into path, from what `cc -###`
// says it would run (the linker itself for gcc's collect2, without its LTO
// plugin), or -1.
fn template_make(path: *mut u8, obj_path: *mut u8, log: *mut u8) -> i64 {
    unsafe {
        let argv = alloc_array::<*mut u8>(8i64);
        (*argv.add(0)) = c"cc";
        (*argv.add(1)) = c"-###";
        let mut k: i64 = 2;
        if !get_elf() {
            (*argv.add(2)) = c"-arch";
            (*argv.add(3)) = if get_x86() { c"x86_64" } else { c"arm64" };
            k = 4;
        }
        (*argv.add(k as usize)) = c"-o";
        (*argv.add((k + 1) as usize)) = path;
        (*argv.add((k + 2) as usize)) = obj_path;
        if run_logged(argv, log) != 0 {
            return -1;
        }
        let out = buf_new();
        if !read_into(log, out) {
            return -1;
        }
        // The link's line: the last with the object among its arguments.
        let text = buf_ptr(out);
        let n = buf_len(out);
        let words = buf_new();
        let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut i: i64 = 0;
        while i < n {
            if (*text.add(i as usize)) == b' ' {
                let b = buf_new();
                let mut line = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
                split_line(text, n, i, b, &mut line);
                let mut has = false;
                for a in 0..line.len() as i64 {
                    if streq(
                        buf_ptr(b).add(
                            (line[a as usize]) as usize), obj_path) {
                        has = true;
                    }
                }
                if has {
                    buf_clear(words);
                    buf_bytes(words,
                        buf_slice(b));
                    args = line;
                }
            }
            while i < n && (*text.add(i as usize)) != b'\n' {
                i += 1;
            }
            i += 1;
        }
        if args.len() as i64 == 0 {
            return -1;
        }
        let body = buf_new();
        let mut outs: i64 = 0;
        let mut objs: i64 = 0;
        let mut a: i64 = 0;
        while a < args.len() as i64 {
            let w = buf_ptr(words).add(
                (args[a as usize]) as usize);
            let mut text_of = w;
            if a == 0 && (streq(w, c"collect2") || (strlen(w) > 9 && ends_with(w, c"/collect2"))) {
                text_of = driver_ld(log);
                if text_of == 0 as *mut u8 {
                    return -1;
                }
            } else if streq(w, c"-plugin") {
                a += 2;
                continue;
            } else if starts_with(w, c"-plugin-opt=") {
                a += 1;
                continue;
            } else if streq(w, c"-o") && a + 1 < args.len() as i64
                && streq(
                    buf_ptr(words).add(
                        (args[(a + 1) as usize]) as usize), path) {
                buf_str(body, c"-o\n");
                text_of = MARK_OUT;
                outs += 1;
                a += 1;
            } else if streq(w, obj_path) {
                text_of = MARK_OBJ;
                objs += 1;
            }
            let mut c: i64 = 0;
            while (*text_of.add(c as usize)) != 0 {
                if (*text_of.add(c as usize)) == b'\n' {
                    return -1;
                }
                c += 1;
            }
            buf_str(body, text_of);
            buf_byte(body, b'\n');
            a += 1;
        }
        if outs != 1 || objs != 1 {
            return -1;
        }
        let t = buf_new();
        template_stamp(body, 0, t);
        buf_byte(t, b'\n');
        buf_bytes(t,
            buf_slice(body));
        t
    }
}

// The link's arguments from template t (ended by 0): the output and the
// object in place of their markers, with libm and libpthread after the
// object on Linux when the program calls into them (as link_command).
fn template_argv(t: i64, path: *mut u8, obj_path: *mut u8, pcx: &Ctx<Comp>) -> *mut *mut u8 {
    unsafe {
        let words = buf_new();
        let n = buf_len(t);
        let mut first: i64 = 0;
        while buf_at(t, first) != b'\n' {
            first += 1;
        }
        buf_bytes(words,
            &buf_slice(t)[(first + 1) as usize..n as usize]);
        let text = buf_ptr(words);
        let m = buf_len(words);
        let mut lines: i64 = 0;
        for i in 0..m {
            if (*text.add(i as usize)) == b'\n' {
                (*text.add(i as usize)) = 0;
                lines += 1;
            }
        }
        let argv = alloc_array::<*mut u8>(
            lines + 3 + 2 * pcx.link_frameworks.len() as i64 + pcx.link_libs.len() as i64);
        let mut k: i64 = 0;
        let mut i: i64 = 0;
        while i < m {
            let w = text.add(i as usize);
            if streq(w, MARK_OUT) {
                (*argv.add(k as usize)) = path;
            } else if streq(w, MARK_OBJ) {
                (*argv.add(k as usize)) = obj_path;
                if get_elf() && uses_libm() {
                    k += 1;
                    (*argv.add(k as usize)) = c"-lm";
                }
                if get_elf() && uses_pthreads() {
                    k += 1;
                    (*argv.add(k as usize)) = c"-lpthread";
                }
                // (what the program declares it links, as link_command)
                if !get_elf() {
                    for f in 0..pcx.link_frameworks.len() as i64 {
                        (*argv.add((k + 1) as usize)) = c"-framework";
                        (*argv.add((k + 2) as usize)) = (pcx.link_frameworks[f as usize]) as *mut u8;
                        k += 2;
                    }
                }
                for l in 0..pcx.link_libs.len() as i64 {
                    let b = buf_new();
                    buf_fmt(b,
                        format_args("-l{}\0",
                            str::from_utf8(cstr((pcx.link_libs[l as usize]) as *mut u8)).unwrap()));
                    k += 1;
                    (*argv.add(k as usize)) = buf_ptr(b);
                }
            } else {
                (*argv.add(k as usize)) = w;
            }
            k += 1;
            i += strlen(w) as i64 + 1;
        }
        argv
    }
}
