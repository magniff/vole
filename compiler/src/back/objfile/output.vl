// What write_output adds around the object (0.16): the C module's symbols
// spelled for assemblers (c_module_symbols), and the link: the command
// that makes the executable (link_command), with what the command line
// added for it (`-l NAME`, `-L DIR`, objects, archives, shared libraries,
// C files) and C's math library when the program calls into it.
//
// (0.25) link_program runs the link. A program of vole objects only (no
// C file, no link argument, no $VOLE_CC) is linked by the system's linker
// run directly, without `sh` and the C driver: the command the driver
// would run (`cc -###`) is asked for once and kept in a file (the link
// template), then reused while the files it names stay what they were.
// `--linker=cc` (or $VOLE_LINKER=cc) links through `cc` as before; so
// does every link the direct one cannot make. On AArch64 macOS the
// compiler links such a program itself (link_macho) when it can: the
// default; `--linker=system` runs ld.

use crate::back::objfile::{Asm, sym_name};
use crate::base::{
    IntVec, alloc_zeroed, buf_append, buf_at, buf_byte, buf_bytes, buf_clear, buf_copy, buf_eq,
    buf_fmt, buf_hex, buf_len, buf_new, buf_ptr, buf_set, buf_str, buf_truncate, buf_write_fd, c_eq,
    cstr, die2, free, realpath, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::middle::ctx::FnCtx;

// UNSAFE: libc's process and system calls that std does not give as the
// link needs them: a child whose two output streams go to one file
// (posix_spawnp with file actions, creat, close, waitpid), the
// environment as C strings (getenv, environ), mkdir with a mode, uname
// and confstr.
// SAFETY: the declarations are POSIX's (macOS's and glibc's headers):
// pointer parameters are C strings or blocks the callee fills, as each
// call's comment says; `environ` is read only, to pass it on.
extern "C" {
    fn getenv(name: *mut u8) -> *mut u8;
    static environ: *mut *mut u8;

    fn posix_spawnp(pid: *mut i32, file: *mut u8, actions: *mut u8, attr: *mut u8,
        argv: *mut *mut u8, envp: *mut *mut u8) -> i32;

    fn posix_spawn_file_actions_init(actions: *mut u8) -> i32;
    fn posix_spawn_file_actions_adddup2(actions: *mut u8, fd: i32, to: i32) -> i32;
    fn posix_spawn_file_actions_destroy(actions: *mut u8) -> i32;
    fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    fn creat(path: *mut u8, mode: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn mkdir(path: *mut u8, mode: i32) -> i32;
    fn uname(info: *mut u8) -> i32;
    fn confstr(name: i32, buf: *mut u8, size: u64) -> u64;
}

// ---- The C module's symbols ----

// The functions of the C module (an impl's methods on a C type, generic
// instances at C types: `id.GN9<c>.div_t`) have `<c>`, its name, in their
// symbols, which no assembler takes. It is spelled `0c_` (as long, and no
// module's name: a name does not start with a digit) in the text, before
// it is written (-S) or assembled: the object and `cc` of the text agree.
pub fn c_module_symbols(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    if pcx.c_module < 0 {
        return;
    }
    let n = buf_len(cx.asm);
    let mut i: i64 = 0;
    while i + 2 < n {
        if buf_at(cx.asm, i) == b'<' && buf_at(cx.asm, i + 1) == b'c'
            && buf_at(cx.asm, i + 2) == b'>' {
            buf_set(cx.asm, i, b'0');
            buf_set(cx.asm, i + 2, b'_');
            i += 3;
        } else {
            i += 1;
        }
    }
}

// ---- The link ----

// Whether path ends with suffix.
fn ends_with(path: *mut u8, suffix: &[u8]) -> bool {
    let p = cstr(path);
    p.len() > suffix.len() && p.ends_with(suffix)
}

// Whether a command-line input is for the link (an object, an archive, a
// shared library, a C file) rather than vole source.
pub fn is_link_input(path: *mut u8) -> bool {
    ends_with(path, b".o") || ends_with(path, b".a") || ends_with(path, b".c")
        || ends_with(path, b".so") || ends_with(path, b".dylib")
}

// Adds `-l NAME` (kind 'l'), `-L DIR` ('L') or an input (' ') to the link.
pub fn add_link_arg(kind: u8, text: *mut u8, pcx: &mut Ctx<Comp>) {
    pcx.link_args.push(kind as i64);
    pcx.link_args.push(text as i64);
    if kind == b' ' && ends_with(text, b".c") {
        pcx.link_c = true;
    }
}

// Adds an -I directory (the C headers' search path is the C files' too).
pub fn add_link_include(dir: *mut u8, pcx: &mut Ctx<Comp>) {
    pcx.link_includes.push(dir as i64);
}

// Adds name (a C string made of it) to v, unless it is there.
fn add_once(v: &mut IntVec, name: &[u8]) {
    for i in 0..v.len() as i64 {
        if c_eq((v[i as usize]) as *mut u8, name) {
            return;
        }
    }
    let b = buf_new();
    buf_bytes(b, name);
    buf_byte(b, 0);
    v.push(buf_ptr(b) as i64);
}

pub fn add_framework(name: &[u8], pcx: &mut Ctx<Comp>) {
    add_once(&mut pcx.link_frameworks, name);
}

// A link an extern block declares (front::parser::foreign::link_block),
// with the C symbols of its functions and statics (C strings).
pub fn add_link_decl(kind: u8, name: &[u8], syms: &mut IntVec, pcx: &mut Ctx<Comp>) {
    let b = buf_new();
    buf_bytes(b, name);
    buf_byte(b, 0);
    pcx.link_decls.push(kind as i64);
    pcx.link_decls.push(buf_ptr(b) as i64);
    pcx.link_decls.push(pcx.link_decl_syms.len() as i64);
    pcx.link_decls.push(syms.len() as i64);
    for i in 0..syms.len() as i64 {
        pcx.link_decl_syms.push((syms[i as usize]));
    }
}

// Adds the declared links the program uses to LINK_FRAMEWORKS and
// LINK_LIBS: those whose block has a symbol the object refers to and does
// not define (or no symbol at all).
fn resolve_declared(asm: &mut Asm<Comp>, pcx: &mut Ctx<Comp>) {
    let mut d: i64 = 0;
    while d < pcx.link_decls.len() as i64 {
        let first = (pcx.link_decls[(d + 2) as usize]);
        let n = (pcx.link_decls[(d + 3) as usize]);
        let mut used = n == 0;
        for s in 0..(asm.syms.len() as i64) {
            if used {
                break;
            }
            if asm.syms[s as usize].defined {
                continue;
            }
            let mut text = sym_name(s, asm);
            if !get_elf() {
                if text.len() == 0 || text[0] != b'_' {
                    continue;
                }
                text = &text[1..text.len()];
            }
            for k in first..first + n {
                if c_eq((pcx.link_decl_syms[k as usize]) as *mut u8, text) {
                    used = true;
                    break;
                }
            }
        }
        if used {
            let name = cstr((pcx.link_decls[(d + 1) as usize]) as *mut u8);
            if (pcx.link_decls[d as usize]) == b'F' as i64 {
                add_once(&mut pcx.link_frameworks, &name);
            } else {
                add_once(&mut pcx.link_libs, &name);
            }
        }
        d += 4;
    }
    // (0.25.3: kept for a failed link's error, linkfail.vl)
    for i in 0..pcx.link_decls.len() as i64 {
        pcx.link_decls_seen.push((pcx.link_decls[i as usize]));
    }
    pcx.link_decls.clear();
}

// Whether the program links a framework or a library of its own.
fn links_declared(pcx: &Ctx<Comp>) -> bool {
    pcx.link_libs.len() as i64 > 0 || (!get_elf() && pcx.link_frameworks.len() as i64 > 0)
}

// Whether the command line added anything for the link.
pub fn link_args_given(pcx: &Ctx<Comp>) -> bool {
    pcx.link_args.len() as i64 > 0
}

// ---- What a failed link's error names (0.25.3, linkfail.vl) ----

// Word w of the IntVecs of this file that hold C strings (LINK_ARGS'
// texts, LINK_DECLS_SEEN's names, LINK_DECL_SYMS) as that C string.
fn c_word(w: i64) -> *mut u8 {
    w as *mut u8
}

// The command line's inputs for the link (objects, archives, shared
// libraries, C files): how many.
pub fn link_input_count(pcx: &Ctx<Comp>) -> i64 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < pcx.link_args.len() as i64 {
        if pcx.link_args.get(i) == b' ' as i64 {
            n += 1;
        }
        i += 2;
    }
    n
}

// Input k of the link (0 <= k < link_input_count()), a C string.
pub fn link_input(k: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < pcx.link_args.len() as i64 {
        if pcx.link_args.get(i) == b' ' as i64 {
            if n == k {
                return c_word(pcx.link_args.get(i + 1));
            }
            n += 1;
        }
        i += 2;
    }
    panic("link_input: no such input")
}

// Whether the command line names library `name` (`-l name`).
pub fn lib_given(name: &[u8], pcx: &Ctx<Comp>) -> bool {
    let mut i: i64 = 0;
    while i < pcx.link_args.len() as i64 {
        if pcx.link_args.get(i) == b'l' as i64 && c_eq(c_word(pcx.link_args.get(i + 1)), name) {
            return true;
        }
        i += 2;
    }
    false
}

// The #[link] whose extern block declares C symbol `sym` (with kind 0),
// or that names `sym` as a library ('l') or a framework ('F'): its index,
// or -1.
pub fn link_decl_of(kind: u8, sym: &[u8], pcx: &Ctx<Comp>) -> i64 {
    let mut d: i64 = 0;
    while d < pcx.link_decls_seen.len() as i64 {
        if kind != 0 {
            if pcx.link_decls_seen.get(d) == kind as i64 && c_eq(link_decl_name(d, pcx), sym) {
                return d;
            }
        } else {
            let first = pcx.link_decls_seen.get(d + 2);
            for s in first..first + pcx.link_decls_seen.get(d + 3) {
                if c_eq(c_word(pcx.link_decl_syms.get(s)), sym) {
                    return d;
                }
            }
        }
        d += 4;
    }
    -1
}

// The library or framework #[link] d names (a C string).
pub fn link_decl_name(d: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    c_word(pcx.link_decls_seen.get(d + 1))
}

// Whether #[link] d names a framework.
pub fn link_decl_framework(d: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.link_decls_seen.get(d) == b'F' as i64
}

// The first C symbol of #[link] d's block (a C string), or 0: none.
pub fn link_decl_first(d: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    if pcx.link_decls_seen.get(d + 3) == 0 {
        return 0 as *mut u8;
    }
    c_word(pcx.link_decl_syms.get(pcx.link_decls_seen.get(d + 2)))
}

// s, quoted for the shell.
fn quoted(b: i64, s: *mut u8) {
    buf_byte(b, b'\'');
    for &c in cstr(s) {
        if c == b'\'' {
            buf_str(b, c"'\\''");
        } else {
            buf_byte(b, c);
        }
    }
    buf_byte(b, b'\'');
}

// The value of the environment variable `name` (a C string), or null
// when it is unset.
fn env_ptr(name: *mut u8) -> *mut u8 {
    // UNSAFE: C's getenv (std's var_in copies the value into a String;
    // the link's code passes these on as C strings).
    // SAFETY: the callers pass C string literals; getenv reads the name up
    // to its NUL and returns null or a NUL-terminated string that stays as
    // it is while the environment is not changed, which the compiler never
    // does (no setenv, no putenv).
    unsafe { getenv(name) }
}

// The same, null when the value is empty too.
fn env_value(name: *mut u8) -> *mut u8 {
    let v = env_ptr(name);
    if v == 0 as *mut u8 || cstr(v).len() == 0 { 0 as *mut u8 } else { v }
}

// Whether the program calls a function of C's math library (a symbol it
// refers to and does not define, by its name; an `f` or `l` at the end:
// the float and long double forms).
fn uses_libm(asm: &mut Asm<Comp>) -> bool {
    let all = [
        "acos", "asin", "atan", "atan2", "cos", "sin", "tan", "acosh", "asinh", "atanh", "cosh",
        "sinh", "tanh", "exp", "exp2", "expm1", "log", "log10", "log1p", "log2", "logb", "ilogb",
        "pow", "sqrt", "cbrt", "hypot", "erf", "erfc", "tgamma", "lgamma", "ceil", "floor",
        "trunc", "round", "lround", "llround", "rint", "lrint", "llrint", "nearbyint", "fmod",
        "remainder", "remquo", "copysign", "nan", "nextafter", "nexttoward", "fdim", "fmax",
        "fmin", "fma", "fabs", "frexp", "ldexp", "modf", "scalbn", "scalbln", "sincos",
    ];
    let names = &all[..];
    for s in 0..(asm.syms.len() as i64) {
        if asm.syms[s as usize].defined {
            continue;
        }
        let mut name = sym_name(s, asm);
        if !get_elf() {
            if name.len() == 0 || name[0] != b'_' {
                continue;
            }
            name = &name[1..name.len()];
        }
        if name.len() == 0 {
            continue;
        }
        let last = name[(name.len() as i64 - 1) as usize];
        let base = if last == b'f'
            || last == b'l' { &name[0..(name.len() as i64 - 1) as usize] } else { name };
        for i in 0..names.len() {
            if names[i].as_bytes() == name || names[i].as_bytes() == base {
                return true;
            }
        }
    }
    false
}

// (0.18.1) Whether the program calls pthread_create (a symbol it refers to
// and does not define): glibc before 2.34 has it in libpthread, which is
// linked then (the compiler's own threads, middle::threads).
fn uses_pthreads(asm: &mut Asm<Comp>) -> bool {
    for s in 0..(asm.syms.len() as i64) {
        if !asm.syms[s as usize].defined
            && sym_name(s, asm) == b"pthread_create" {
            return true;
        }
    }
    false
}

// The command linking the program's object obj_path into executable path:
// cc (or $VOLE_CC), the command line's link arguments in their order
// (C files compiled at the program's -O level, with its -I directories
// and -g), then libm on Linux when the program or a C file may call it
// (Linux links it only when asked; on macOS it is part of libSystem).
pub fn link_command(path: *mut u8, obj_path: *mut u8, asm: &mut Asm<Comp>, pcx: &Ctx<Comp>) -> *mut u8 {
    let cmd = buf_new();
    let cc = env_value(c"VOLE_CC");
    buf_str(cmd, if cc != 0 as *mut u8 { cc } else { c"cc" });
    if !get_elf() {
        buf_str(cmd, if get_x86() { c" -arch x86_64" } else { c" -arch arm64" });
    }
    if pcx.link_c {
        buf_str(cmd, c" -O");
        buf_byte(cmd, (b'0' as i64 + pcx.opt_level) as u8);
        if pcx.debug_info {
            buf_str(cmd, c" -g");
        }
        for i in 0..pcx.link_includes.len() as i64 {
            buf_str(cmd, c" -I");
            quoted(cmd, (pcx.link_includes[i as usize]) as *mut u8);
        }
    }
    buf_str(cmd, c" -o ");
    quoted(cmd, path);
    buf_byte(cmd, b' ');
    quoted(cmd, obj_path);
    let mut i: i64 = 0;
    while i < pcx.link_args.len() as i64 {
        let kind = (pcx.link_args[i as usize]) as u8;
        buf_byte(cmd, b' ');
        if kind != b' ' {
            buf_byte(cmd, b'-');
            buf_byte(cmd, kind);
        }
        quoted(cmd, (pcx.link_args[(i + 1) as usize]) as *mut u8);
        i += 2;
    }
    if !get_elf() {
        for i in 0..pcx.link_frameworks.len() as i64 {
            buf_str(cmd, c" -framework ");
            quoted(cmd, (pcx.link_frameworks[i as usize]) as *mut u8);
        }
    }
    for i in 0..pcx.link_libs.len() as i64 {
        buf_str(cmd, c" -l");
        quoted(cmd, (pcx.link_libs[i as usize]) as *mut u8);
    }
    if get_elf() && (pcx.link_c || uses_libm(asm)) {
        buf_str(cmd, c" -lm");
    }
    if get_elf() && uses_pthreads(asm) {
        buf_str(cmd, c" -lpthread");
    }
    buf_byte(cmd, 0);
    buf_ptr(cmd)
}

// ---- Running the link (0.25) ----

// The linker: the system's, run directly, through `cc`, or the compiler's
// own (link_macho: programs of vole objects on AArch64 macOS; the
// default, which is the system's for any other program).
pub const LINKER_SYSTEM: i64 = 0;
pub const LINKER_CC: i64 = 1;
pub const LINKER_INTERNAL: i64 = 2;

// The linker named `name` (system, cc, internal), or -1.
fn linker_of_name(name: *mut u8) -> i64 {
    if streq(name, c"system") {
        return LINKER_SYSTEM;
    }
    if streq(name, c"cc") {
        return LINKER_CC;
    }
    if streq(name, c"internal") {
        return LINKER_INTERNAL;
    }
    -1
}

// `--linker=NAME`: whether NAME is a linker.
pub fn set_linker(name: *mut u8, pcx: &mut Ctx<Comp>) -> bool {
    pcx.linker = linker_of_name(name);
    pcx.linker >= 0
}

// The linker this link uses.
fn linker(pcx: &Ctx<Comp>) -> i64 {
    if pcx.linker >= 0 {
        return pcx.linker;
    }
    let env = env_value(c"VOLE_LINKER");
    if env == 0 as *mut u8 {
        // (link_program falls back to the system's when the internal
        // one does not take the program)
        return LINKER_INTERNAL;
    }
    let l = linker_of_name(env);
    if l < 0 {
        die2(c"$VOLE_LINKER is not a linker (system, cc or internal): ", env);
    }
    l
}

// Links obj_path into the executable path: 0, or the link's exit status
// (the linker said why).
pub fn link_program(path: *mut u8, obj_path: *mut u8, asm: &mut Asm<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    resolve_declared(asm, pcx);
    let cc = env_value(c"VOLE_CC");
    // ($VOLE_CC=cc, as tests/run.sh sets it, is the default driver)
    let own = !pcx.link_c && pcx.link_args.len() as i64 == 0
        && (cc == 0 as *mut u8 || streq(cc, c"cc"));
    let how = linker(pcx);
    // (--linker=internal: the compiler's own, when it takes the program;
    // else the system's)
    if own && how == LINKER_INTERNAL && !pcx.debug_info && !links_declared(pcx)
        && crate::back::objfile::link_macho::link_macho(path, obj_path) {
        return 0;
    }
    if own && how != LINKER_CC && link_direct(path, obj_path, asm, pcx) {
        return 0;
    }
    // (0.25.3) through the C driver, its text kept: a failure is read
    // into one error (linkfail.vl), its warnings printed as they were
    let cmd = link_command(path, obj_path, asm, pcx);
    pcx.link_cmd = cmd;
    let lb = buf_new();
    buf_fmt(lb, format_args("{}.log\0", str::from_utf8(&cstr(obj_path)).unwrap()));
    let log = buf_ptr(lb);
    let mut argv: Vec<*mut u8, Comp> = Vec::new_in(Comp {});
    argv.push(c"/bin/sh");
    argv.push(c"-c");
    argv.push(cmd);
    let status = run_logged(&mut argv, log);
    pcx.link_log = buf_new();
    read_into(log, pcx.link_log);
    remove_path(log);
    if status == 0 && buf_len(pcx.link_log) > 0 {
        buf_write_fd(pcx.link_log, 2);
    }
    status
}

// The status of a process as waitpid gives it: its exit code, or 128 +
// the signal that ended it.
fn exit_code(status: i32) -> i64 {
    let s = status as i64;
    if (s & 127) == 0 { (s >> 8) & 255 } else { 128 + (s & 127) }
}

// Runs argv (C strings; argv[0] found as a shell finds it), its stdout
// and stderr into the file log (made anew): its exit status, 127 when it
// could not be run. (argv gets the null that ends it for C.)
fn run_logged(argv: &mut Vec<*mut u8, Comp>, log: *mut u8) -> i64 {
    if argv.len() == 0 {
        return 127;
    }
    argv.push(0 as *mut u8);
    // UNSAFE: a child process with its output in a file: creat,
    // posix_spawnp with file actions, waitpid. std's Command pipes or
    // inherits a child's output; it cannot send both streams, in the order
    // written, to one file, which the link's log is.
    // SAFETY: argv is a Vec's block of its length in pointers, the last
    // one null (pushed above), and is not touched while the calls run;
    // every other entry is a C string by its maker: a literal, buf_ptr of
    // a buffer whose last byte written was a NUL and which is not written
    // again, or a path main was given; log is such a buffer's too.
    // `actions` is 256 zeroed bytes, more than posix_spawn_file_actions_t
    // on macOS (8) and glibc (80), initialized before use, destroyed after
    // the spawn, and freed. pid and status are locals the calls write.
    // environ is libc's, which the compiler never changes. fd is closed
    // once, after the spawn has taken its copies.
    unsafe {
        let fd = creat(log, 384);
        if fd < 0 {
            return 127;
        }
        let actions = alloc_zeroed(256);
        posix_spawn_file_actions_init(actions);
        posix_spawn_file_actions_adddup2(actions, fd, 1);
        posix_spawn_file_actions_adddup2(actions, fd, 2);
        let mut pid = 0 as i32;
        let r = posix_spawnp(&mut pid, argv[0], actions, 0 as *mut u8, argv.as_mut_ptr(),
            environ);
        posix_spawn_file_actions_destroy(actions);
        free(actions);
        close(fd);
        if r != 0 {
            return 127;
        }
        let mut status = 0 as i32;
        if waitpid(pid, &mut status, 0) != pid {
            return 127;
        }
        exit_code(status)
    }
}

// The file at path, appended to buffer b: whether it could be read.
pub fn read_into(path: *mut u8, b: i64) -> bool {
    let name = match str::from_utf8(crate::base::c_kept(path)) {
        Ok(name) => name,
        Err(_) => return false,
    };
    let mut f = match std::fs::File::open(name) {
        Ok(f) => f,
        Err(_) => return false,
    };
    let mut chunk: Vec<u8, Comp> = Vec::new_in(Comp {});
    chunk.resize(65536, 0);
    loop {
        match f.read(&mut chunk[..]) {
            Ok(got) => {
                if got == 0 {
                    break;
                }
                buf_bytes(b, &chunk[..got]);
            }
            Err(_) => break,
        }
    }
    true
}

// Removes the file at path (a C string), if it is there.
pub fn remove_path(path: *mut u8) {
    if let Ok(name) = str::from_utf8(&cstr(path)) {
        let _ = std::fs::remove_file(name);
    }
}

// The link made by the system's linker run directly, with the link
// template: whether it linked. When it did not, what it printed is not
// shown and its template is dropped: the caller links through `cc`, which
// says why.
fn link_direct(path: *mut u8, obj_path: *mut u8, asm: &mut Asm<Comp>, pcx: &Ctx<Comp>) -> bool {
    let lb = buf_new();
    buf_fmt(lb, format_args("{}.log\0", str::from_utf8(&cstr(obj_path)).unwrap()));
    let log = buf_ptr(lb);
    let file = template_file();
    let mut t: i64 = -1;
    if file != 0 as *mut u8 {
        t = template_read(file);
    }
    if t < 0 {
        t = template_make(path, obj_path, log);
        if t < 0 {
            remove_path(log);
            return false;
        }
        if file != 0 as *mut u8 {
            template_write(t, file);
        }
    }
    let mut argv = template_argv(t, path, obj_path, asm, pcx);
    let status = run_logged(&mut argv, log);
    if status == 0 {
        // (the linker's warnings, as cc shows them)
        let out = buf_new();
        if read_into(log, out) && buf_len(out) > 0 {
            buf_write_fd(out, 2);
        }
    } else if file != 0 as *mut u8 {
        remove_path(file);
    }
    remove_path(log);
    status == 0
}

// ---- The link template ----

// The driver's link command, the output and the object as markers: one
// argument a line, after a first line that stamps it (the real paths of
// the arguments that are absolute paths; they change when the toolchain or
// the SDK does).
const MARK_OUT: &[u8] = b"@vole-out";
const MARK_OBJ: &[u8] = b"@vole-obj";

// struct utsname: sysname is the first field, release the third; the
// fields are 256 bytes long on macOS, 65 on Linux.
const UTS_SIZE: i64 = 2048;

// (confstr) The per-user cache directory on macOS.
const CS_DARWIN_USER_CACHE_DIR: i32 = 65538;

// The system's name and release (uname's sysname, a space, its release)
// appended to buffer b: whether the system is macOS; None when uname
// fails.
fn system_stamp(b: i64) -> Option<bool> {
    // UNSAFE: C's uname fills a struct utsname, whose layout differs by
    // system; it is read as bytes at the two fields' offsets.
    // SAFETY: info is UTS_SIZE = 2048 zeroed bytes, more than struct
    // utsname on macOS (5 fields of 256 bytes) and on Linux (6 of 65);
    // uname writes NUL-terminated fields; sysname is at offset 0 and
    // release at twice the field's size (512 or 130), both inside the
    // block, and the zeroed rest ends any string; the block is freed after
    // the two copies and not used again.
    unsafe {
        let info = alloc_zeroed(UTS_SIZE);
        if uname(info) != 0 {
            free(info);
            return None;
        }
        let macos = streq(info, c"Darwin");
        let field: i64 = if macos { 256 } else { 65 };
        buf_str(b, info);
        buf_byte(b, b' ');
        buf_str(b, info.add((2 * field) as usize));
        free(info);
        Some(macos)
    }
}

// macOS's per-user cache directory, appended to buffer dir: whether there
// is one.
fn darwin_cache_dir(dir: i64) -> bool {
    // UNSAFE: C's confstr writes the directory into a block.
    // SAFETY: room has 1024 zeroed bytes and confstr is told 1024; it
    // returns the length the value needs with its NUL: 0 is a failure and
    // more than 1024 a value cut short, both refused; otherwise room holds
    // a NUL-terminated string, copied before the block is freed.
    unsafe {
        let room = alloc_zeroed(1024);
        let n = confstr(CS_DARWIN_USER_CACHE_DIR, room, 1024);
        let ok = n != 0 && n <= 1024;
        if ok {
            buf_str(dir, room);
        }
        free(room);
        ok
    }
}

// Makes the directory whose path is buffer dir's bytes (for the user
// only), if it is not there.
fn make_dir(dir: i64) {
    buf_byte(dir, 0);
    // UNSAFE: C's mkdir with a mode (std's create_dir takes none: the
    // cache directory is the user's alone).
    // SAFETY: the buffer's bytes end in the NUL just written; mkdir reads
    // up to it and keeps no pointer; nothing writes the buffer between.
    unsafe { mkdir(buf_ptr(dir), 448); }
    buf_truncate(dir, buf_len(dir) - 1);
}

// The real path of the path in buffer `one` (ended by a NUL), appended to
// buffer b: false when it has none.
fn real_path(one: i64, b: i64) -> bool {
    // UNSAFE: C's realpath (std has no canonicalize).
    // SAFETY: one's bytes end in the NUL the caller wrote last; real has
    // 4096 zeroed bytes, PATH_MAX on Linux and more than macOS's 1024,
    // which is the most realpath writes, NUL-terminated when it succeeds;
    // it is copied before the block is freed.
    unsafe {
        let real = alloc_zeroed(4096);
        let ok = realpath(buf_ptr(one), real) != 0 as *mut u8;
        if ok {
            buf_str(b, real);
        }
        free(real);
        ok
    }
}

// The file of the link template (named by a hash of what the driver's
// answer depends on: the target, the system's release, the environment
// the driver reads), or 0: none ($VOLE_LINK_CACHE=off, or no directory
// for it). Its directory: $VOLE_LINK_CACHE, else the user's cache
// directory (macOS), $XDG_CACHE_HOME or ~/.cache (Linux).
fn template_file() -> *mut u8 {
    let system = buf_new();
    let macos = match system_stamp(system) {
        Some(macos) => macos,
        None => return 0 as *mut u8,
    };
    let dir = buf_new();
    let env = env_value(c"VOLE_LINK_CACHE");
    if env != 0 as *mut u8 {
        if streq(env, c"off") {
            return 0 as *mut u8;
        }
        buf_str(dir, env);
    } else if macos {
        if !darwin_cache_dir(dir) {
            return 0 as *mut u8;
        }
    } else {
        let xdg = env_value(c"XDG_CACHE_HOME");
        let home = env_value(c"HOME");
        if xdg != 0 as *mut u8 && cstr(xdg).starts_with(b"/") {
            buf_str(dir, xdg);
        } else if home != 0 as *mut u8 && cstr(home).starts_with(b"/") {
            buf_str(dir, home);
            buf_str(dir, c"/.cache");
            make_dir(dir);
        } else {
            return 0 as *mut u8;
        }
    }
    let key = buf_new();
    buf_str(key, c"vole-link 1\n");
    buf_str(key, if get_elf() { c"elf" } else { c"macho" });
    buf_str(key, if get_x86() { c" x86_64\n" } else { c" arm64\n" });
    buf_append(key, system);
    buf_byte(key, b'\n');
    let all = [
        c"PATH", c"SDKROOT", c"DEVELOPER_DIR", c"MACOSX_DEPLOYMENT_TARGET", c"COMPILER_PATH",
        c"LIBRARY_PATH", c"GCC_EXEC_PREFIX", c"LD_RUN_PATH",
    ];
    let names = &all[..];
    for i in 0..names.len() {
        let v = env_ptr(names[i]);
        buf_str(key, names[i]);
        buf_byte(key, b'=');
        if v != 0 as *mut u8 {
            buf_str(key, v);
        }
        buf_byte(key, b'\n');
    }
    let mut h: u64 = 14695981039346656037;
    for i in 0..buf_len(key) {
        h ^= buf_at(key, i) as u64;
        h = h.wrapping_mul(1099511628211u64);
    }
    let at = buf_len(dir);
    if at > 0 && buf_at(dir, at - 1) != b'/' {
        buf_byte(dir, b'/');
    }
    buf_str(dir, c"vole-link-");
    buf_hex(dir, h, 16);
    buf_byte(dir, 0);
    buf_ptr(dir)
}

// The stamp of the arguments in buffer t from offset `from` (one a line),
// appended to buffer b: each absolute path's real path, or `?`.
fn template_stamp(t: i64, from: i64, b: i64) {
    let text = buf_copy(t);
    let n = text.len() as i64;
    let one = buf_new();
    let mut i = from;
    while i < n {
        let mut j = i;
        while j < n && text[j as usize] != b'\n' {
            j += 1;
        }
        if j > i && text[i as usize] == b'/' {
            buf_clear(one);
            buf_bytes(one, &text[i as usize..j as usize]);
            buf_byte(one, 0);
            if !real_path(one, b) {
                buf_byte(b, b'?');
            }
            buf_byte(b, b' ');
        }
        i = j + 1;
    }
}

// The template in file, as a buffer, when its stamp holds; else -1.
fn template_read(file: *mut u8) -> i64 {
    let t = buf_new();
    if !read_into(file, t) {
        return -1;
    }
    let text = buf_copy(t);
    let n = text.len();
    if n == 0 || text[n - 1] != b'\n' {
        return -1;
    }
    let mut first: usize = 0;
    while text[first] != b'\n' {
        first += 1;
    }
    let stamp = buf_new();
    template_stamp(t, first as i64 + 1, stamp);
    if !buf_eq(stamp, &text[..first]) {
        return -1;
    }
    // (one output and one object, each a whole line)
    let mut outs: i64 = 0;
    let mut objs: i64 = 0;
    let mut i = first + 1;
    while i < n {
        let mut j = i;
        while text[j] != b'\n' {
            j += 1;
        }
        if &text[i..j] == MARK_OUT {
            outs += 1;
        } else if &text[i..j] == MARK_OBJ {
            objs += 1;
        }
        i = j + 1;
    }
    if outs != 1 || objs != 1 {
        return -1;
    }
    t
}

// Writes template t to file (under another name first, then renamed:
// links running at once read a whole template or none).
fn template_write(t: i64, file: *mut u8) {
    let name = match str::from_utf8(crate::base::c_kept(file)) {
        Ok(name) => name,
        Err(_) => return,
    };
    let tmp = buf_new();
    buf_fmt(tmp, format_args("{name}.{}", std::process::id()));
    let tmp_name = match str::from_utf8(crate::base::buf_done(tmp)) {
        Ok(tmp_name) => tmp_name,
        Err(_) => return,
    };
    if std::fs::write(tmp_name, &buf_copy(t)).is_err()
        || std::fs::rename(tmp_name, name).is_err() {
        let _ = std::fs::remove_file(tmp_name);
    }
}

// The arguments of a line of `cc -###` (each in double quotes, with `\`
// before a quote, a backslash or `$`, or bare up to a space), appended to
// buffer b, each ended by a NUL, from offset `from` of text up to the
// line's end; their starts into args.
fn split_line(text: &[u8], from: i64, b: i64, args: &mut Vec<i64, Comp>) {
    let n = text.len() as i64;
    let mut i = from;
    loop {
        while i < n && text[i as usize] == b' ' {
            i += 1;
        }
        if i >= n || text[i as usize] == b'\n' || text[i as usize] == b'\r' {
            break;
        }
        args.push(buf_len(b));
        let mut quoted = false;
        while i < n && text[i as usize] != b'\n' && text[i as usize] != b'\r'
            && (quoted || text[i as usize] != b' ') {
            if text[i as usize] == b'"' {
                quoted = !quoted;
            } else if text[i as usize] == b'\\' && i + 1 < n && text[(i + 1) as usize] != b'\n' {
                i += 1;
                buf_byte(b, text[i as usize]);
            } else {
                buf_byte(b, text[i as usize]);
            }
            i += 1;
        }
        buf_byte(b, 0);
    }
}

// The word of t that starts at `at` and ends before the next NUL.
fn word_at(t: &[u8], at: i64) -> &[u8] {
    let rest = &t[at as usize..];
    match rest.iter().position(|c| *c == 0) {
        Some(n) => &rest[..n],
        None => rest,
    }
}

// What `cc -print-prog-name=ld` says (the linker collect2 runs), or 0.
fn driver_ld(log: *mut u8) -> *mut u8 {
    let mut argv: Vec<*mut u8, Comp> = Vec::new_in(Comp {});
    argv.push(c"cc");
    argv.push(c"-print-prog-name=ld");
    if run_logged(&mut argv, log) != 0 {
        return 0 as *mut u8;
    }
    let out = buf_new();
    if !read_into(log, out) {
        return 0 as *mut u8;
    }
    let mut n = buf_len(out);
    while n > 0 && (buf_at(out, n - 1) == b'\n' || buf_at(out, n - 1) == b' ') {
        n -= 1;
    }
    if n == 0 {
        return 0 as *mut u8;
    }
    buf_truncate(out, n);
    buf_byte(out, 0);
    buf_ptr(out)
}

// The link template for linking obj_path into path, from what `cc -###`
// says it would run (the linker itself for gcc's collect2, without its LTO
// plugin), or -1.
fn template_make(path: *mut u8, obj_path: *mut u8, log: *mut u8) -> i64 {
    let mut argv: Vec<*mut u8, Comp> = Vec::new_in(Comp {});
    argv.push(c"cc");
    argv.push(c"-###");
    if !get_elf() {
        argv.push(c"-arch");
        argv.push(if get_x86() { c"x86_64" } else { c"arm64" });
    }
    argv.push(c"-o");
    argv.push(path);
    argv.push(obj_path);
    if run_logged(&mut argv, log) != 0 {
        return -1;
    }
    let out = buf_new();
    if !read_into(log, out) {
        return -1;
    }
    let obj = cstr(obj_path);
    let out_name = cstr(path);
    // The link's line: the last with the object among its arguments.
    let text = buf_copy(out);
    let n = text.len() as i64;
    let words = buf_new();
    let mut args: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut i: i64 = 0;
    while i < n {
        if text[i as usize] == b' ' {
            let b = buf_new();
            let mut line: Vec<i64, Comp> = Vec::new_in(Comp {});
            split_line(&text, i, b, &mut line);
            let line_words = buf_copy(b);
            let mut has = false;
            for &at in line.iter() {
                if word_at(&line_words, at) == obj {
                    has = true;
                }
            }
            if has {
                buf_clear(words);
                buf_bytes(words, &line_words);
                args = line;
            }
        }
        while i < n && text[i as usize] != b'\n' {
            i += 1;
        }
        i += 1;
    }
    if args.len() == 0 {
        return -1;
    }
    // (the words are whole: `words` is not written again)
    let all = buf_copy(words);
    let body = buf_new();
    let mut outs: i64 = 0;
    let mut objs: i64 = 0;
    let mut a: usize = 0;
    while a < args.len() {
        let w = word_at(&all, args[a]);
        let mut text_of: &[u8] = w;
        if a == 0 && (w == b"collect2" || (w.len() > 9 && w.ends_with(b"/collect2"))) {
            let ld = driver_ld(log);
            if ld == 0 as *mut u8 {
                return -1;
            }
            text_of = crate::base::c_kept(ld);
        } else if w == b"-plugin" {
            a += 2;
            continue;
        } else if w.starts_with(b"-plugin-opt=") {
            a += 1;
            continue;
        } else if w == b"-o" && a + 1 < args.len() && word_at(&all, args[a + 1]) == out_name {
            buf_str(body, c"-o\n");
            text_of = MARK_OUT;
            outs += 1;
            a += 1;
        } else if w == obj {
            text_of = MARK_OBJ;
            objs += 1;
        }
        if text_of.iter().any(|c| *c == b'\n') {
            return -1;
        }
        buf_bytes(body, text_of);
        buf_byte(body, b'\n');
        a += 1;
    }
    if outs != 1 || objs != 1 {
        return -1;
    }
    let t = buf_new();
    template_stamp(body, 0, t);
    buf_byte(t, b'\n');
    buf_append(t, body);
    t
}

// The link's arguments from template t (C strings): the output and the
// object in place of their markers, with libm and libpthread after the
// object on Linux when the program calls into them (as link_command).
fn template_argv(t: i64, path: *mut u8, obj_path: *mut u8, asm: &mut Asm<Comp>, pcx: &Ctx<Comp>)
    -> Vec<*mut u8, Comp> {
    let text = buf_copy(t);
    let n = text.len();
    let mut argv: Vec<*mut u8, Comp> = Vec::new_in(Comp {});
    // (after the stamp's line)
    let mut i: usize = 0;
    while i < n && text[i] != b'\n' {
        i += 1;
    }
    i += 1;
    while i < n {
        let mut j = i;
        while j < n && text[j] != b'\n' {
            j += 1;
        }
        let w = &text[i..j];
        if w == MARK_OUT {
            argv.push(path);
        } else if w == MARK_OBJ {
            argv.push(obj_path);
            if get_elf() && uses_libm(asm) {
                argv.push(c"-lm");
            }
            if get_elf() && uses_pthreads(asm) {
                argv.push(c"-lpthread");
            }
            // (what the program declares it links, as link_command)
            if !get_elf() {
                for f in 0..pcx.link_frameworks.len() {
                    argv.push(c"-framework");
                    argv.push(pcx.link_frameworks[f] as *mut u8);
                }
            }
            for l in 0..pcx.link_libs.len() {
                let b = buf_new();
                buf_fmt(b,
                    format_args("-l{}\0",
                        str::from_utf8(&cstr(pcx.link_libs[l] as *mut u8)).unwrap()));
                argv.push(buf_ptr(b));
            }
        } else {
            // (the word as a C string of its own)
            let b = buf_new();
            buf_bytes(b, w);
            buf_byte(b, 0);
            argv.push(buf_ptr(b));
        }
        i = j + 1;
    }
    argv
}
