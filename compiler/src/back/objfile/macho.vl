// The Mach-O writer (macOS, both instruction sets): the header, one
// segment of the present sections, their relocations, and the symbol and
// string tables.

use crate::back::objfile::{
    SEC_BSS, SEC_CONST, SEC_COUNT, SEC_DATA, SEC_DEBUG_ABBREV, SEC_DEBUG_INFO, SEC_DEBUG_LINE,
    SEC_NOTE, SEC_TEXT, SEC_UNWIND, align_up, asym, get_asym_count, get_asyms, get_frags,
    get_sec_align, get_sec_used, is_debug, is_temp, pad_to, sym_addr, w16, w32, w64, w8, wname16,
};
use crate::base::{
    IntVec, buf_append, buf_bytes, buf_copy, buf_fmt, buf_len, buf_new, buf_set, buf_write_file,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;

// A section's Mach-O names: its section and its segment.
fn macho_sectname(sec: i64) -> *mut u8 {
    if sec == SEC_TEXT { c"__text" } else if sec == SEC_CONST { c"__const" }
    else if sec == SEC_DATA { c"__data" } else if sec == SEC_DEBUG_ABBREV { c"__debug_abbrev" }
    else if sec == SEC_DEBUG_INFO { c"__debug_info" }
    else if sec == SEC_DEBUG_LINE { c"__debug_line" } else if sec == SEC_BSS { c"__bss" }
    else { c"__compact_unwind" }
}

fn macho_segname(sec: i64) -> *mut u8 {
    if sec == SEC_DATA || sec == SEC_BSS { c"__DATA" } else if is_debug(sec) { c"__DWARF" }
    else if sec == SEC_UNWIND { c"__LD" } else { c"__TEXT" }
}

pub fn macho_write(path: *mut u8, pcx: &mut Ctx<Comp>) {
    unsafe {
        // Sections present: text always, the others when used.
        let mut ord: [i64; 9] = [0i64; 9];
        let mut secs: [i64; 9] = [0i64; 9];
        let mut nsect: i64 = 0;
        for sec in 0..SEC_COUNT {
            if sec != SEC_NOTE
                && (sec == SEC_TEXT || buf_len(pcx.sec_buf[sec as usize]) > 0
                    || get_sec_used()[sec as usize]) {
                secs[nsect as usize] = sec;
                nsect += 1;
                ord[sec as usize] = nsect;
            }
        }
        let mut vm: i64 = 0;
        // (0.25.5) the end of the sections in the file: all but the
        // zerofill one, which is last
        let mut filled: i64 = 0;
        for k in 0..nsect {
            let sec = secs[k as usize];
            vm = align_up(vm, 1 << get_sec_align()[sec as usize]);
            pcx.sec_addr[sec as usize] = vm;
            vm += buf_len(pcx.sec_buf[sec as usize]);
            if sec != SEC_BSS {
                filled = vm;
            }
        }
        // On AArch64 LLVM marks the start of every section (but the debug
        // ones) with a local symbol (ltmp0, ltmp1, ...): the linker keeps a
        // section, even an empty one, by its symbols. The same here.
        if !get_x86() {
            let mut number: i64 = 0;
            for k in 0..nsect {
                let sec = secs[k as usize];
                if is_debug(sec) {
                    continue;
                }
                let name = buf_new();
                buf_fmt(name, format_args("ltmp{number}"));
                number += 1;
                let s = asym(&buf_copy(name));
                let mut first: i64 = 0;
                while (*get_frags().add(first as usize)).sec != sec {
                    first += 1;
                }
                (*get_asyms().add(s as usize)).defined = true;
                (*get_asyms().add(s as usize)).sec = sec;
                (*get_asyms().add(s as usize)).frag = first;
                (*get_asyms().add(s as usize)).off = 0;
            }
        }
        // Symbols: locals (labels that are not temporary, and temporaries a
        // relocation needs), then defined globals, then undefined ones.
        let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for pass in 0..3 {
            for s in 0..get_asym_count() {
                let def = (*get_asyms().add(s as usize)).defined;
                let local = def && !(*get_asyms().add(s as usize)).global
                    && (!is_temp(s) || (*get_asyms().add(s as usize)).in_table);
                let ext = def && (*get_asyms().add(s as usize)).global;
                let undef = !def
                    && ((*get_asyms().add(s as usize)).in_table
                        || (*get_asyms().add(s as usize)).global);
                if (pass == 0 && local) || (pass == 1 && ext) || (pass == 2 && undef) {
                    (*get_asyms().add(s as usize)).index = order.len() as i64;
                    order.push(s);
                }
            }
        }
        let mut nlocal: i64 = 0;
        let mut next: i64 = 0;
        for s in order.items() {
            if (*get_asyms().add(s as usize)).defined && !(*get_asyms().add(s as usize)).global {
                nlocal += 1;
            } else if (*get_asyms().add(s as usize)).defined {
                next += 1;
            }
        }
        let nundef = order.len() as i64 - nlocal - next;
        // Relocations per section.
        let ncmds: i64 = 4;
        let seg_size = 72 + 80 * nsect;
        let cmds_size = seg_size + 24 + 24 + 80;
        // The contents mirror the addresses, as LLVM lays them out (0.11:
        // aligned in the file as in memory, so that the segment's size in
        // the file is its size in memory, which dsymutil checks).
        let mut sec_off: [i64; 9] = [0i64; 9];
        for k in 0..nsect {
            let sec = secs[k as usize];
            sec_off[sec as usize] = if sec == SEC_BSS { 0 }
                else { 32 + cmds_size + pcx.sec_addr[sec as usize] };
        }
        let content_end = 32 + cmds_size + filled;
        let mut off = content_end;
        off = align_up(off, 8);
        let mut rel_off: [i64; 9] = [0i64; 9];
        let mut rel_n: [i64; 9] = [0i64; 9];
        for k in 0..nsect {
            let sec = secs[k as usize];
            rel_off[sec as usize] = off;
            for r in 0..pcx.relocs.len() as i64 {
                if pcx.relocs[r as usize].sec == sec {
                    rel_n[sec as usize] += 1;
                }
            }
            off += 8 * rel_n[sec as usize];
        }
        let sym_off = off;
        off += 16 * order.len() as i64;
        let str_off = off;
        let strs = buf_new();
        w8(strs, 0);
        let mut strx = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..order.len() as i64 {
            strx.push(buf_len(strs));
            buf_bytes(strs, (*get_asyms().add((order[i as usize]) as usize)).text);
            w8(strs, 0);
        }
        pad_to(strs, align_up(buf_len(strs), 8));
        let out = buf_new();
        // Header.
        w32(out, 0xfeedfacf);
        w32(out, if get_x86() { 0x01000007 } else { 0x0100000c });
        w32(out, if get_x86() { 3 } else { 0 });
        w32(out, 1);
        w32(out, ncmds);
        w32(out, cmds_size);
        w32(out, 0);
        w32(out, 0);
        // The segment and its sections.
        w32(out, 0x19);
        w32(out, seg_size);
        wname16(out, c"");
        w64(out, 0);
        w64(out, vm);
        w64(out, 32 + cmds_size);
        w64(out, content_end - (32 + cmds_size));
        w32(out, 7);
        w32(out, 7);
        w32(out, nsect);
        w32(out, 0);
        for k in 0..nsect {
            let sec = secs[k as usize];
            wname16(out, macho_sectname(sec));
            wname16(out, macho_segname(sec));
            w64(out, pcx.sec_addr[sec as usize]);
            w64(out, buf_len(pcx.sec_buf[sec as usize]));
            w32(out, sec_off[sec as usize]);
            w32(out, get_sec_align()[sec as usize]);
            w32(out, if rel_n[sec as usize] > 0 { rel_off[sec as usize] } else { 0 });
            w32(out, rel_n[sec as usize]);
            w32(out,
                if sec == SEC_TEXT { 0x80000400 }
                else if is_debug(sec) || sec == SEC_UNWIND { 0x02000000 }
                else if sec == SEC_BSS { 1 } else { 0 });
            w32(out, 0);
            w32(out, 0);
            w32(out, 0);
        }
        // LC_BUILD_VERSION: macOS 11.0 (arm64) or 10.13 (x86-64).
        w32(out, 0x32);
        w32(out, 24);
        w32(out, 1);
        w32(out, if get_x86() { 0x000a0d00 } else { 0x000b0000 });
        w32(out, 0);
        w32(out, 0);
        // LC_SYMTAB.
        w32(out, 2);
        w32(out, 24);
        w32(out, sym_off);
        w32(out, order.len() as i64);
        w32(out, str_off);
        w32(out, buf_len(strs));
        // LC_DYSYMTAB.
        w32(out, 0xb);
        w32(out, 80);
        w32(out, 0);
        w32(out, nlocal);
        w32(out, nlocal);
        w32(out, next);
        w32(out, nlocal + next);
        w32(out, nundef);
        for i in 0..12 {
            w32(out, 0);
        }
        // Contents (a section-relative relocation holds the address in the
        // object's address space: its section's address added).
        for k in 0..nsect {
            let sec = secs[k as usize];
            if sec == SEC_BSS {
                continue;
            }
            pad_to(out, sec_off[sec as usize]);
            let start = buf_len(out);
            buf_append(out, pcx.sec_buf[sec as usize]);
            if !is_debug(sec) && sec != SEC_UNWIND {
                continue;
            }
            for r in 0..pcx.relocs.len() as i64 {
                if pcx.relocs[r as usize].sec == sec && pcx.relocs[r as usize].sym < 0 {
                    let at = start + pcx.relocs[r as usize].offset;
                    let target = pcx.sec_addr[(-1 - pcx.relocs[r as usize].sym) as usize] + pcx.relocs[r as usize].addend;
                    for i in 0..8 {
                        buf_set(out, (at + i), ((target
                            >> (8 * i)) & 255) as u8)
                            ;
                    }
                }
            }
        }
        pad_to(out, align_up(buf_len(out), 8));
        for k in 0..nsect {
            let sec = secs[k as usize];
            pad_to(out, rel_off[sec as usize]);
            for r in 0..pcx.relocs.len() as i64 {
                if pcx.relocs[r as usize].sec == sec {
                    let rl = pcx.relocs[r as usize];
                    w32(out, rl.offset);
                    let pcrel: i64 = if rl.pcrel { 1 } else { 0 };
                    if rl.sym < 0 {
                        w32(out,
                            ord[(-1 - rl.sym) as usize] | pcrel << 24 | rl.length << 25
                                | rl.rtype << 28);
                    } else {
                        w32(out,
                            (*get_asyms().add(rl.sym as usize)).index | pcrel << 24
                                | rl.length << 25 | 1 << 27 | rl.rtype << 28);
                    }
                }
            }
        }
        pad_to(out, sym_off);
        for i in 0..order.len() as i64 {
            let s = (order[i as usize]);
            w32(out, (strx[i as usize]));
            if (*get_asyms().add(s as usize)).defined {
                w8(out, if (*get_asyms().add(s as usize)).global { 0x0f } else { 0x0e });
                w8(out, ord[(*get_asyms().add(s as usize)).sec as usize]);
                w16(out, 0);
                w64(out, pcx.sec_addr[(*get_asyms().add(s as usize)).sec as usize] + sym_addr(s));
            } else {
                w8(out, 0x01);
                w8(out, 0);
                w16(out, 0);
                w64(out, 0);
            }
        }
        buf_append(out, strs);
        buf_write_file(out, path);
    }
}
