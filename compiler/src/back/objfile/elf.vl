// The ELF writer (Linux): the header, the present sections, a .rela
// section per section with relocations, .symtab, .strtab and .shstrtab.

use crate::back::objfile::{
    SEC_BSS, SEC_CONST, SEC_DATA, SEC_DEBUG_ABBREV, SEC_DEBUG_INFO, SEC_DEBUG_LINE, SEC_NOTE,
    SEC_TEXT, align_up, get_asym_count, get_asyms, get_frags, get_sec_align, get_sec_used, is_debug,
    is_temp, pad_to, sym_addr, w16, w32, w64, w8,
};
use crate::back::objfile::assemble::{MAP_CODE, get_maps};
use crate::base::{
    buf_append, buf_bytes, buf_fmt, buf_len, buf_new, buf_ptr, buf_str, buf_write_file, cstr,
    memcpy,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;

// A section's ELF name.
fn elf_name(sec: i64) -> *mut u8 {
    if sec == SEC_TEXT { c".text" } else if sec == SEC_CONST { c".rodata" }
    else if sec == SEC_DATA { c".data" } else if sec == SEC_NOTE { c".note.GNU-stack" }
    else if sec == SEC_DEBUG_ABBREV { c".debug_abbrev" } else if sec == SEC_BSS { c".bss" }
    else if sec == SEC_DEBUG_INFO { c".debug_info" } else { c".debug_line" }
}

pub fn elf_write(path: *mut u8, pcx: &mut Ctx<Comp>) {
    unsafe {
        // Sections: 0 null, .text, .rodata, .data, .bss when used (0.25.5),
        // .note.GNU-stack, the debug sections when used, then a .rela section
        // per section with relocations, .symtab, .strtab, .shstrtab.
        let mut shndx: [i64; 9] = [0i64; 9];
        let mut present: [i64; 9] = [0i64; 9];
        let mut npresent: i64 = 0;
        let elf_order: [i64; 8] = [SEC_TEXT, SEC_CONST, SEC_DATA, SEC_BSS, SEC_NOTE,
            SEC_DEBUG_ABBREV, SEC_DEBUG_INFO, SEC_DEBUG_LINE];
        for k in 0..8 {
            let sec = elf_order[k as usize];
            let optional = is_debug(sec) || sec == SEC_BSS;
            if !optional || get_sec_used()[sec as usize]
                || buf_len(pcx.sec_buf[sec as usize]) > 0 {
                present[npresent as usize] = sec;
                npresent += 1;
                shndx[sec as usize] = npresent;
            }
        }
        let mut rel_n: [i64; 9] = [0i64; 9];
        for r in 0..pcx.relocs.len() as i64 {
            rel_n[pcx.relocs[r as usize].sec as usize] += 1;
        }
        let mut rela_index: [i64; 9] = [0i64; 9];
        let mut nsh = 1 + npresent;
        for k in 0..npresent {
            let sec = present[k as usize];
            if rel_n[sec as usize] > 0 {
                rela_index[sec as usize] = nsh;
                nsh += 1;
            }
        }
        let symtab_index = nsh;
        let strtab_index = nsh + 1;
        let shstrtab_index = nsh + 2;
        nsh += 3;
        // Symbols: null, the sections, mapping symbols, local labels, then
        // globals.
        let strs = buf_new();
        w8(strs, 0);
        let syms = buf_new();
        for i in 0..24 {
            w8(syms, 0);
        }
        for k in 0..npresent {
            w32(syms, 0);
            w8(syms, 3);
            w8(syms, 0);
            w16(syms, shndx[present[k as usize] as usize]);
            w64(syms, 0);
            w64(syms, 0);
            pcx.secsym[present[k as usize] as usize] = 1 + k;
        }
        let mut count = 1 + npresent;
        // Mapping symbols ($x, $d), local.
        let mut map_name: [i64; 3] = [0i64, 0, 0];
        let mut m: i64 = 0;
        while m < get_maps().len() as i64 {
            let kind = (get_maps()[(m + 3) as usize]);
            if map_name[kind as usize] == 0 {
                map_name[kind as usize] = buf_len(strs);
                buf_str(strs, if kind == MAP_CODE { c"$x" } else { c"$d" });
                w8(strs, 0);
            }
            let f = (get_maps()[(m + 1) as usize]);
            w32(syms, map_name[kind as usize]);
            w8(syms, 0);
            w8(syms, 0);
            w16(syms, shndx[(get_maps()[m as usize]) as usize]);
            w64(syms,
                (*get_frags().add(f as usize)).addr + (get_maps()[(m + 2) as usize]));
            w64(syms, 0);
            count += 1;
            m += 4;
        }
        let mut first_global = count;
        for pass in 0..2 {
            if pass == 1 {
                first_global = count;
            }
            for s in 0..get_asym_count() {
                let def = (*get_asyms().add(s as usize)).defined;
                let local = def && !(*get_asyms().add(s as usize)).global && !is_temp(s);
                let global = (*get_asyms().add(s as usize)).global
                    || (!def && (*get_asyms().add(s as usize)).in_table);
                if (pass == 0 && local) || (pass == 1 && global) {
                    (*get_asyms().add(s as usize)).index = count;
                    count += 1;
                    w32(syms, buf_len(strs));
                    buf_bytes(strs, (*get_asyms().add(s as usize)).text);
                    w8(strs, 0);
                    w8(syms, if pass == 0 { 0 } else { 0x10 });
                    w8(syms, 0);
                    w16(syms,
                        if def { shndx[(*get_asyms().add(s as usize)).sec as usize] } else { 0 });
                    w64(syms, if def { sym_addr(s) } else { 0 });
                    w64(syms, 0);
                }
            }
        }
        let shstr = buf_new();
        w8(shstr, 0);
        let mut name_off: [i64; 20] = [0i64; 20];
        for k in 0..npresent {
            name_off[(1 + k) as usize] = buf_len(shstr);
            buf_str(shstr, elf_name(present[k as usize]));
            w8(shstr, 0);
        }
        for k in 0..npresent {
            let sec = present[k as usize];
            if rel_n[sec as usize] > 0 {
                name_off[rela_index[sec as usize] as usize] = buf_len(shstr);
                buf_fmt(shstr,
                    format_args(".rela{}", str::from_utf8(&cstr(elf_name(sec))).unwrap()));
                w8(shstr, 0);
            }
        }
        name_off[symtab_index as usize] = buf_len(shstr);
        buf_str(shstr, c".symtab");
        w8(shstr, 0);
        name_off[strtab_index as usize] = buf_len(shstr);
        buf_str(shstr, c".strtab");
        w8(shstr, 0);
        name_off[shstrtab_index as usize] = buf_len(shstr);
        buf_str(shstr, c".shstrtab");
        w8(shstr, 0);
        // File: header, contents, relocations, tables, section headers.
        let out = buf_new();
        for i in 0..64 {
            w8(out, 0);
        }
        let mut sec_off: [i64; 20] = [0i64; 20];
        let mut sec_size: [i64; 20] = [0i64; 20];
        for k in 0..npresent {
            let sec = present[k as usize];
            pad_to(out,
                align_up(buf_len(out), 1 << get_sec_align()[sec as usize]));
            sec_off[shndx[sec as usize] as usize] = buf_len(out);
            sec_size[shndx[sec as usize] as usize] = buf_len(pcx.sec_buf[sec as usize]);
            // (0.25.5: .bss has no bytes in the file)
            if sec != SEC_BSS {
                buf_append(out, pcx.sec_buf[sec as usize]);
            }
        }
        for k in 0..npresent {
            let sec = present[k as usize];
            if rel_n[sec as usize] > 0 {
                pad_to(out, align_up(buf_len(out), 8));
                sec_off[rela_index[sec as usize] as usize] = buf_len(out);
                sec_size[rela_index[sec as usize] as usize] = 24 * rel_n[sec as usize];
                for r in 0..pcx.relocs.len() as i64 {
                    if pcx.relocs[r as usize].sec == sec {
                        let rl = pcx.relocs[r as usize];
                        let sym = if rl.sym < 0 { pcx.secsym[(-1 - rl.sym) as usize] }
                            else { (*get_asyms().add(rl.sym as usize)).index };
                        w64(out, rl.offset);
                        w64(out, sym << 32 | rl.rtype);
                        w64(out, rl.addend);
                    }
                }
            }
        }
        pad_to(out, align_up(buf_len(out), 8));
        sec_off[symtab_index as usize] = buf_len(out);
        sec_size[symtab_index as usize] = buf_len(syms);
        buf_append(out, syms);
        sec_off[strtab_index as usize] = buf_len(out);
        sec_size[strtab_index as usize] = buf_len(strs);
        buf_append(out, strs);
        sec_off[shstrtab_index as usize] = buf_len(out);
        sec_size[shstrtab_index as usize] = buf_len(shstr);
        buf_append(out, shstr);
        pad_to(out, align_up(buf_len(out), 8));
        let sh_off = buf_len(out);
        for i in 0..64 {
            w8(out, 0);
        }
        for k in 0..npresent {
            let sec = present[k as usize];
            let i = shndx[sec as usize];
            w32(out, name_off[i as usize]);
            w32(out, if sec == SEC_BSS { 8 } else { 1 });
            w64(out,
                if sec == SEC_TEXT { 6 } else if sec == SEC_DATA || sec == SEC_BSS { 3 }
                else if sec == SEC_CONST { 2 } else { 0 });
            w64(out, 0);
            w64(out, sec_off[i as usize]);
            w64(out, sec_size[i as usize]);
            w32(out, 0);
            w32(out, 0);
            w64(out, 1 << get_sec_align()[sec as usize]);
            w64(out, 0);
        }
        for k in 0..npresent {
            let sec = present[k as usize];
            if rel_n[sec as usize] > 0 {
                let i = rela_index[sec as usize];
                w32(out, name_off[i as usize]);
                w32(out, 4);
                w64(out, 0x40);
                w64(out, 0);
                w64(out, sec_off[i as usize]);
                w64(out, sec_size[i as usize]);
                w32(out, symtab_index);
                w32(out, shndx[sec as usize]);
                w64(out, 8);
                w64(out, 24);
            }
        }
        let tables: [i64; 3] = [symtab_index, strtab_index, shstrtab_index];
        for k in 0..3 {
            let i = tables[k as usize];
            w32(out, name_off[i as usize]);
            w32(out, if k == 0 { 2 } else { 3 });
            w64(out, 0);
            w64(out, 0);
            w64(out, sec_off[i as usize]);
            w64(out, sec_size[i as usize]);
            w32(out, if k == 0 { strtab_index } else { 0 });
            w32(out, if k == 0 { first_global } else { 0 });
            w64(out, if k == 0 { 8 } else { 1 });
            w64(out, if k == 0 { 24 } else { 0 });
        }
        // The header.
        let h = buf_ptr(out);
        let ident: [i64; 8] = [0x7fi64, b'E' as i64, b'L' as i64, b'F' as i64, 2, 1, 1, 0];
        for i in 0..8 {
            (*h.add(i as usize)) = ident[i as usize] as u8;
        }
        let hdr = buf_new();
        w16(hdr, 1);
        w16(hdr, if get_x86() { 62 } else { 183 });
        w32(hdr, 1);
        w64(hdr, 0);
        w64(hdr, 0);
        w64(hdr, sh_off);
        w32(hdr, 0);
        w16(hdr, 64);
        w16(hdr, 0);
        w16(hdr, 0);
        w16(hdr, 64);
        w16(hdr, nsh);
        w16(hdr, shstrtab_index);
        memcpy(h.add(16), buf_ptr(hdr), 48);
        buf_write_file(out, path);
    }
}
