// Object files (0.7): the assembly the code generator wrote (ASM) is
// assembled here, by the compiler itself, into a Mach-O object (macOS,
// both instruction sets) or an ELF one (Linux), so that `cc` only links.
// The text is the single source: `--emit-asm` writes it as it is, and the
// object holds exactly what it says. tests/objcheck.sh links both this
// object and `cc -c` of the same text and compares the results.
//
// The text is the compiler's own, in a small regular subset of the
// assembler syntax (one statement per line; labels `name:`; the
// directives .text, .data, .section, .globl, .p2align, .byte, .long,
// .quad, .space; with -g, 0.11, also .file, .loc and, on Mach-O, the
// .cfi_* of the standard frame; 0.25, in an object's text only,
// `.vole_data`: constant data's bytes, RAW). Lines are assembled in one pass into fragments: runs of
// bytes, each followed by an optional tail whose size depends on where it
// lands (an alignment, or an x86-64 branch that may be short or long).
// Layout places the fragments, relaxing branches as GNU as and LLVM do
// (all short first; one that does not reach grows, until nothing does);
// then fixups are resolved or become relocations, and the object is
// written (macho_write, elf_write).
//
// Instructions are encoded by enc_arm64.vl (AArch64) and enc_x86.vl
// (x86-64).
//
// This file holds the object being built (sections, fragments, symbols,
// fixups, relocations), the byte writers and the driver (write_object,
// write_output); the parts, in the order the driver runs them:
// assemble.vl (the text, line by line), resolve.vl (layout, fixups,
// section contents), debug.vl (what -g adds: the DWARF line program and
// compact unwind), macho.vl and elf.vl (the writers).

pub mod assemble;
mod debug;
mod resolve;
mod macho;
mod elf;
pub mod output;
// (0.25.3) main.missing, and a failed link's error
pub mod linkfail;
mod link_macho;

use crate::back::enc_arm64::init_a64;
use crate::back::enc_x86::init_x86;
use crate::base::{
    alloc_array, alloc_zeroed, buf_byte, buf_fmt, buf_new, buf_reserve, buf_write_file, cstr, die,
    free, get_bufs, grow, memcmp, memcpy, realloc, strlen,
};

use assemble::{assemble_begin, assemble_line, get_mapping, set_hooks, set_mapping};
use debug::{compact_unwind, get_cfi_fns, get_rows, line_program};
use elf::elf_write;
use macho::macho_write;
use resolve::{build_sections, layout, resolve_fixups};

// The assembler's text helpers, used by the instruction encoders.
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::base::term::build_linking;
use crate::base::timer::{T_CODEGEN, T_OUTPUT, timer_now, timer_sub};
use crate::middle::ctx::FnCtx;
use crate::middle::threads::asm_thread_push;

use linkfail::{check_link_inputs, link_failed};
use output::{c_module_symbols, link_program};

// ---- Sections ----

pub const SEC_TEXT: i64 = 0;
pub const SEC_CONST: i64 = 1;
pub const SEC_DATA: i64 = 2;
pub const SEC_NOTE: i64 = 3;
// (0.11, -g) DWARF.
pub const SEC_DEBUG_ABBREV: i64 = 4;
pub const SEC_DEBUG_INFO: i64 = 5;
pub const SEC_DEBUG_LINE: i64 = 6;
// (0.11, -g) Mach-O's compact unwind information, made from the CFI.
pub const SEC_UNWIND: i64 = 7;
// (0.25.5) Zero-initialized data: Mach-O's __DATA,__bss (zerofill), ELF's
// .bss (nobits). Its bytes are laid out as any section's but not written:
// the object says only its size. Last, as a zerofill section must be in
// its segment.
pub const SEC_BSS: i64 = 8;
const SEC_COUNT: i64 = 9;

static mut CUR_SEC: i64 = 0;
static mut SEC_ALIGN: [i64; 9] = [0i64; 9];
static mut SEC_USED: [bool; 9] = [false; 9];

// ---- Fragments ----

const TAIL_NONE: i64 = 0;
const TAIL_ALIGN: i64 = 1;
pub const TAIL_JMP: i64 = 2;
pub const TAIL_JCC: i64 = 3;

// Bytes [start, start + len) of OBJ_BYTES, then the tail: an alignment to
// 2^arg bytes, or a branch (arg: the condition) to symbol `sym`, short or
// long. `addr`: the fragment's offset in its section.
#[derive(Clone, Copy)] struct Frag {
    sec: i64, start: i64, len: i64, tail: i64, arg: i64, sym: i64, long: bool, addr: i64, atom: i64,
}

static mut FRAGS: *mut Frag = 0 as *mut Frag;
static mut FRAG_COUNT: i64 = 0;
static mut FRAG_CAP: i64 = 0;
// The fragment being filled (always the last one).
static mut OPEN: i64 = -1;
// (0.18.1) The assembled bytes, the assembler's own (not a buffer of
// BUFS, which code generation may grow while the assembler runs on a
// thread of its own).
#[derive(Clone, Copy)] pub struct ObjBytes { data: *mut u8, len: i64, cap: i64 }
static mut OBJ: ObjBytes = ObjBytes { data: 0 as *mut u8, len: 0, cap: 0 };

// Room for n more bytes in OBJ.
pub fn obj_reserve(n: i64) {
    unsafe {
        if get_obj().len + n <= get_obj().cap {
            return;
        }
        let mut cap = get_obj().cap * 2;
        while cap < get_obj().len + n {
            cap *= 2;
        }
        let grown = realloc(get_obj().data, cap as u64);
        if grown == 0 as *mut u8 {
            die(c"out of memory");
        }
        { let mut obj_copy = get_obj(); obj_copy.data = grown; set_obj(obj_copy); }
        { let mut obj_copy = get_obj(); obj_copy.cap = cap; set_obj(obj_copy); }
    }
}

// (0.25) Constant data's bytes, put here by the code generator when the
// output is an object (gen0::target's data_bytes): the text names a run
// of them, `.vole_data OFFSET, LENGTH`, instead of spelling it in `.byte`
// lines (12 MB of text for the compiler's 2.9 MB of constants), and the
// assembler copies it. Written and read on the main thread only, after
// the code generation's threads.
static mut RAW: ObjBytes = ObjBytes { data: 0 as *mut u8, len: 0, cap: 0 };

// Appends bytes to RAW; returns their offset there.
pub fn raw_data(bytes: &[u8]) -> i64 {
    { let mut raw_copy = get_raw(); let r_copy = bytes_append(&mut raw_copy, bytes);
        set_raw(raw_copy); r_copy }
}

// Appends bytes to b; returns their offset there.
pub fn bytes_append(b: &mut ObjBytes, bytes: &[u8]) -> i64 {
    unsafe {
        let n = bytes.len() as i64;
        if b.len + n > b.cap {
            let mut cap: i64 = if b.cap == 0 { 65536 } else { b.cap * 2 };
            while cap < b.len + n {
                cap *= 2;
            }
            let grown = realloc(b.data, cap as u64);
            if grown == 0 as *mut u8 {
                die(c"out of memory");
            }
            b.data = grown;
            b.cap = cap;
        }
        let at = b.len;
        memcpy(b.data.add(at as usize), bytes.ptr, n as u64);
        b.len = at + n;
        at
    }
}

fn new_frag(sec: i64) {
    unsafe {
        if get_open() >= 0 {
            (*get_frags().add(get_open() as usize)).len = get_obj().len - (
                *get_frags().add(get_open() as usize)).start;
        }
        set_frags({
            let mut frag_cap_copy = get_frag_cap();
            let r_copy = grow(get_frags(), get_frag_count(), &mut frag_cap_copy);
            set_frag_cap(frag_cap_copy); r_copy
        });
        (*get_frags().add(get_frag_count() as usize)) = Frag {
            sec, start: get_obj().len, len: 0, tail: TAIL_NONE, arg: 0, sym: -1,
            long: false, addr: 0, atom: -1,
        };
        set_open(get_frag_count());
        set_frag_count(get_frag_count() + (1));
    }
}

// Ends the open fragment with a tail, and opens the next.
fn end_frag(tail: i64, arg: i64, sym: i64) {
    unsafe {
        (*get_frags().add(get_open() as usize)).tail = tail;
        (*get_frags().add(get_open() as usize)).arg = arg;
        (*get_frags().add(get_open() as usize)).sym = sym;
        (*get_frags().add(get_open() as usize)).atom = get_cur_atom()[get_cur_sec() as usize];
    }
    new_frag(get_cur_sec());
}

fn switch_section(sec: i64) {
    { let mut sec_used_copy = get_sec_used(); sec_used_copy[sec as usize] = true;
        set_sec_used(sec_used_copy); }
    if sec != get_cur_sec() {
        set_cur_sec(sec);
        new_frag(sec);
    }
}

// The position (in OBJ_BYTES) of the next byte.
pub fn here() -> i64 {
    get_obj().len
}

pub fn out8(b: i64) {
    unsafe {
        obj_reserve(1);
        (*get_obj().data.add(get_obj().len as usize)) = (b & 255) as u8;
        { let mut obj_copy = get_obj(); obj_copy.len += 1; set_obj(obj_copy); }
    }
}

pub fn out16(v: i64) {
    out8(v);
    out8(v >> 8);
}

// (0.17: the four bytes with one check for room, not four buf_byte calls)
pub fn out32(v: i64) {
    unsafe {
        obj_reserve(4);
        let at = get_obj().len;
        let d = get_obj().data;
        (*d.add(at as usize)) = (v & 255) as u8;
        (*d.add((at + 1) as usize)) = ((v >> 8) & 255) as u8;
        (*d.add((at + 2) as usize)) = ((v >> 16) & 255) as u8;
        (*d.add((at + 3) as usize)) = ((v >> 24) & 255) as u8;
        { let mut obj_copy = get_obj(); obj_copy.len = at + 4; set_obj(obj_copy); }
    }
}

pub fn out64(v: i64) {
    out32(v);
    out32(v >> 32);
}

// Reads and writes a little-endian 32-bit word of OBJ_BYTES.
fn get32(pos: i64) -> i64 {
    unsafe {
        let d = get_obj().data;
        ((*d.add(pos as usize)) as i64) | ((*d.add((pos + 1) as usize)) as i64) << 8
            | ((*d.add((pos + 2) as usize)) as i64) << 16
            | ((*d.add((pos + 3) as usize)) as i64) << 24
    }
}

fn put32(pos: i64, v: i64) {
    unsafe {
        let d = get_obj().data;
        (*d.add(pos as usize)) = (v & 255) as u8;
        (*d.add((pos + 1) as usize)) = ((v >> 8) & 255) as u8;
        (*d.add((pos + 2) as usize)) = ((v >> 16) & 255) as u8;
        (*d.add((pos + 3) as usize)) = ((v >> 24) & 255) as u8;
    }
}

// ---- Symbols ----

// A name of the assembly: a label (defined in `sec` at `off` from the
// start of fragment `frag`), or a name only referred to. `in_table`: the
// symbol table needs it (relocations refer to it); `index`: its index
// there.
// (0.18.1: its name its own bytes, not an interned symbol: the assembler
// runs beside code generation's threads, which read the symbols.)
#[derive(Clone, Copy)] struct ASym<'a> {
    text: &'a [u8], hash: u64, defined: bool, global: bool, frag: i64, off: i64, sec: i64,
    in_table: bool,
    index: i64, atom: i64,
}

// Mach-O's atoms: a label that is not temporary starts one, which runs to
// the next. LLVM resolves a pc-relative reference only within one atom
// (else the linker could move them apart): the current atom per section.
static mut CUR_ATOM: [i64; 9] = [-1; 9];

static mut ASYMS: *mut ASym<'_> = 0 as *mut ASym<'_>;
static mut ASYM_COUNT: i64 = 0;
static mut ASYM_CAP: i64 = 0;
// Interned name + 1 -> symbol + 1.
static mut ASYM_TABLE: *mut i64 = 0 as *mut i64;
static mut ASYM_TABLE_SIZE: i64 = 0;

// (0.25) asym's calls: an instruction that made none names no symbol
// (assemble.vl's memo).
static mut ASYM_LOOKUPS: i64 = 0;

pub fn asym(name: &[u8]) -> i64 {
    unsafe {
        set_asym_lookups(get_asym_lookups() + (1));
        if (get_asym_count() + 1) * 2 > get_asym_table_size() {
            asym_rehash();
        }
        let n = name.len() as i64;
        let hash = hash_bytes(name.ptr, n);
        let mask = (get_asym_table_size() - 1) as u64;
        let mut slot = hash & mask;
        while (*get_asym_table().add(slot as usize)) != 0 {
            let s = (*get_asym_table().add(slot as usize)) - 1;
            // (0.25: the hashes first, then memcmp, not the bytes one by one)
            if (*get_asyms().add(s as usize)).hash == hash
                && (*get_asyms().add(s as usize)).text.len() as i64 == n
                && memcmp((*get_asyms().add(s as usize)).text.ptr, name.ptr, n as u64) == 0 {
                return s;
            }
            slot = (slot + 1) & mask;
        }
        set_asyms({
            let mut asym_cap_copy = get_asym_cap();
            let r_copy = grow(get_asyms(), get_asym_count(), &mut asym_cap_copy);
            set_asym_cap(asym_cap_copy); r_copy
        });
        let s = get_asym_count();
        let copy = alloc_zeroed(n + 1);
        memcpy(copy, name.ptr, n as u64);
        (*get_asyms().add(s as usize)) = ASym {
            text: std::slice::from_raw_parts(copy.add((0) as usize), (n - (0)) as usize), hash,
            defined: false, global: false, frag: -1, off: 0, sec: -1,
            in_table: false, index: -1, atom: -1,
        };
        set_asym_count(get_asym_count() + (1));
        (*get_asym_table().add(slot as usize)) = s + 1;
        s
    }
}

// The table of ASYMS by name (index + 1, open addressing), twice as large.
fn asym_rehash() {
    unsafe {
        let size: i64 = if get_asym_table_size() == 0 { 1024 } else { get_asym_table_size() * 2 };
        free(get_asym_table() as *mut u8);
        set_asym_table(alloc_array::<i64>(size));
        set_asym_table_size(size);
        let mask = (size - 1) as u64;
        for s in 0..get_asym_count() {
            let mut slot = (*get_asyms().add(s as usize)).hash & mask;
            while (*get_asym_table().add(slot as usize)) != 0 {
                slot = (slot + 1) & mask;
            }
            (*get_asym_table().add(slot as usize)) = s + 1;
        }
    }
}

// A hash of a name.
fn name_hash(t: &[u8]) -> u64 {
    hash_bytes(t.ptr, t.len() as i64)
}

// (0.25) A hash of bytes [0, n) of p, eight at a time (FNV-1a's byte at a
// time was a chain of multiplications as long as the name).
pub fn hash_bytes(p: *mut u8, n: i64) -> u64 {
    unsafe {
        let mut h: u64 = (n as u64).wrapping_mul(0x9e3779b97f4a7c15u64);
        let mut i: i64 = 0;
        while i + 8 <= n {
            let w = (*p.add(i as usize)) as u64 | ((*p.add((i + 1) as usize)) as u64) << 8
                | ((*p.add((i + 2) as usize)) as u64) << 16
                | ((*p.add((i + 3) as usize)) as u64) << 24
                | ((*p.add((i + 4) as usize)) as u64) << 32
                | ((*p.add((i + 5) as usize)) as u64) << 40
                | ((*p.add((i + 6) as usize)) as u64) << 48
                | ((*p.add((i + 7) as usize)) as u64) << 56;
            h = (h ^ w).wrapping_mul(0xff51afd7ed558ccdu64);
            h = h ^ (h >> 32);
            i += 8;
        }
        let mut w: u64 = 0;
        let mut s: u64 = 0;
        while i < n {
            w = w | ((*p.add(i as usize)) as u64) << s;
            s += 8;
            i += 1;
        }
        h = (h ^ w).wrapping_mul(0xff51afd7ed558ccdu64);
        h ^ (h >> 32)
    }
}

// (0.18.1) A table from names to values (0: none): the assembler's own
// (its mnemonics, registers), so that it reads no table the rest of the
// compiler grows while it runs on a thread of its own. A name is its
// bytes' address and length.
#[derive(Clone, Copy)] pub struct NameMap {
    pub ptrs: *mut i64, pub lens: *mut i64, pub vals: *mut i64, pub size: i64, pub count: i64,
}

fn name_at(m: NameMap, slot: i64) -> &'static [u8] {
    unsafe {
        std::slice::from_raw_parts(((*m.ptrs.add(slot as usize)) as *mut u8).add((0) as usize),
            ((*m.lens.add(slot as usize)) - (0)) as usize)
    }
}

pub fn name_put(m: &mut NameMap, name: &[u8], value: i64) {
    unsafe {
        if (m.count + 1) * 2 > m.size {
            let old = *m;
            m.size = if old.size == 0 { 256 } else { old.size * 2 };
            m.ptrs = alloc_array::<i64>(m.size);
            m.lens = alloc_array::<i64>(m.size);
            m.vals = alloc_array::<i64>(m.size);
            m.count = 0;
            for i in 0..old.size {
                if (*old.vals.add(i as usize)) != 0 {
                    name_put(m,
                        std::slice::from_raw_parts(
                            ((*old.ptrs.add(i as usize)) as *mut u8).add((0) as usize),
                            ((*old.lens.add(i as usize)) - (0)) as usize),
                        (*old.vals.add(i as usize)));
                }
            }
            free(old.ptrs as *mut u8);
            free(old.lens as *mut u8);
            free(old.vals as *mut u8);
        }
        let mask = (m.size - 1) as u64;
        let mut slot = name_hash(name) & mask;
        while (*m.vals.add(slot as usize)) != 0 && name_at(*m, slot as i64) != name {
            slot = (slot + 1) & mask;
        }
        if (*m.vals.add(slot as usize)) == 0 {
            let n = name.len() as i64;
            let copy = alloc_zeroed(n + 1);
            memcpy(copy, name.ptr, n as u64);
            (*m.ptrs.add(slot as usize)) = copy as i64;
            (*m.lens.add(slot as usize)) = n;
            m.count += 1;
        }
        (*m.vals.add(slot as usize)) = value;
    }
}

pub fn name_get(m: NameMap, name: &[u8]) -> i64 {
    unsafe {
        if m.size == 0 {
            return 0;
        }
        let mask = (m.size - 1) as u64;
        let mut slot = name_hash(name) & mask;
        while (*m.vals.add(slot as usize)) != 0 {
            if name_at(m, slot as i64) == name {
                return (*m.vals.add(slot as usize));
            }
            slot = (slot + 1) & mask;
        }
        0
    }
}

// A C string's bytes.
pub fn c_bytes(s: *mut u8) -> &'static [u8] {
    unsafe { std::slice::from_raw_parts(s.add((0) as usize), (strlen(s) as i64 - (0)) as usize) }
}

// A temporary label (L... on Mach-O, .L... on ELF): never in the symbol
// table unless a relocation needs it (Mach-O only; ELF uses the section).
fn is_temp(s: i64) -> bool {
    let t = unsafe { (*get_asyms().add(s as usize)).text };
    if get_elf() { t.len() >= 2 && t[0] == b'.' && t[1] == b'L' }
    else { t.len() >= 1 && t[0] == b'L' }
}

fn sym_addr(s: i64) -> i64 {
    unsafe { (*get_frags().add((*get_asyms().add(s as usize)).frag as usize)).addr + (
        *get_asyms().add(s as usize)).off }
}

// ---- Fixups ----

pub const FX_A64_B26: i64 = 1;
pub const FX_A64_B19: i64 = 2;
pub const FX_A64_B14: i64 = 3;
pub const FX_A64_ADR: i64 = 4;
pub const FX_A64_PAGE: i64 = 5;
pub const FX_A64_PAGEOFF: i64 = 6;
pub const FX_A64_GOTPAGE: i64 = 7;
pub const FX_A64_GOTPAGEOFF: i64 = 8;
pub const FX_X86_BRANCH: i64 = 9;
pub const FX_X86_RIP: i64 = 10;
pub const FX_X86_GOT: i64 = 11;
pub const FX_DIFF32: i64 = 12;
pub const FX_ABS64: i64 = 13;
pub const FX_ABS32: i64 = 14;

// `pos`: the field's position in OBJ_BYTES (an AArch64 instruction, or an
// x86-64 or data field); `frag`: its fragment; `end`: for x86-64, the
// position where the instruction ends (pc); `sym2`: the subtracted label
// of FX_DIFF32. `rex`: an x86-64 GOT load with a REX prefix.
#[derive(Clone, Copy)] struct Fixup {
    kind: i64, frag: i64, pos: i64, sym: i64, sym2: i64, addend: i64, end: i64, rex: bool,
    atom: i64,
}

static mut FIXUPS: *mut Fixup = 0 as *mut Fixup;
static mut FIXUP_COUNT: i64 = 0;
static mut FIXUP_CAP: i64 = 0;

pub fn fixup(kind: i64, pos: i64, sym: i64, addend: i64, end: i64, rex: bool) {
    unsafe {
        set_fixups({
            let mut fixup_cap_copy = get_fixup_cap();
            let r_copy = grow(get_fixups(), get_fixup_count(), &mut fixup_cap_copy);
            set_fixup_cap(fixup_cap_copy); r_copy
        });
        (*get_fixups().add(get_fixup_count() as usize)) = Fixup {
            kind, frag: get_open(), pos, sym, sym2: -1, addend, end, rex,
            atom: get_cur_atom()[get_cur_sec() as usize],
        };
    }
    set_fixup_count(get_fixup_count() + (1));
}

// x86-64 branches whose size layout decides (jmp, jcc to a label).
pub fn emit_relaxable(tail: i64, cond: i64, sym: i64) {
    end_frag(tail, cond, sym);
}

// ---- Relocations ----

// In section `sec` at `offset`: the object format's relocation type
// `rtype`, against symbol `sym` (an ASYMS index, or -1 - section for a
// section of ELF), with `addend` (ELF) and, for Mach-O, pc-relativity and
// the field's length (log2 bytes).
#[derive(Clone, Copy)] pub struct Reloc {
    sec: i64, offset: i64, rtype: i64, sym: i64, addend: i64, pcrel: bool, length: i64,
}

fn reloc(sec: i64, offset: i64, rtype: i64, sym: i64, addend: i64, pcrel: bool, length: i64,
    pcx: &mut Ctx<Comp>) {
    pcx.relocs.push(Reloc { sec, offset, rtype, sym, addend, pcrel, length });
}

// A relocation against symbol s itself (a GOT entry's).
fn reloc_to_symbol(sec: i64, offset: i64, rtype: i64, s: i64, pcrel: bool, pcx: &mut Ctx<Comp>) {
    unsafe { (*get_asyms().add(s as usize)).in_table = true; }
    reloc(sec, offset, rtype, s, 0, pcrel, 2, pcx);
}

// A relocation against symbol s plus `extra`: on ELF a temporary label
// becomes its section's symbol plus the label's offset.
fn reloc_to(sec: i64, offset: i64, rtype: i64, s: i64, extra: i64, pcrel: bool, length: i64,
    pcx: &mut Ctx<Comp>) {
    unsafe {
        if get_elf() && (*get_asyms().add(s as usize)).defined && is_temp(s) {
            reloc(sec, offset, rtype, -1 - (*get_asyms().add(s as usize)).sec, extra + sym_addr(s),
                pcrel, length, pcx);
            return;
        }
        (*get_asyms().add(s as usize)).in_table = true;
        reloc(sec, offset, rtype, s, extra, pcrel, length, pcx);
    }
}

// ---- Output helpers ----

fn w8(out: i64, v: i64) {
    buf_byte(out, (v & 255) as u8);
}

fn w16(out: i64, v: i64) {
    unsafe {
        buf_reserve(out, 2);
        let at = (*get_bufs().add(out as usize)).len;
        let d = (*get_bufs().add(out as usize)).data;
        (*d.add(at as usize)) = (v & 255) as u8;
        (*d.add((at + 1) as usize)) = ((v >> 8) & 255) as u8;
        (*get_bufs().add(out as usize)).len = at + 2;
    }
}

// (0.25: the bytes with one check for room, not a call each)
fn w32(out: i64, v: i64) {
    unsafe {
        buf_reserve(out, 4);
        let at = (*get_bufs().add(out as usize)).len;
        let d = (*get_bufs().add(out as usize)).data;
        (*d.add(at as usize)) = (v & 255) as u8;
        (*d.add((at + 1) as usize)) = ((v >> 8) & 255) as u8;
        (*d.add((at + 2) as usize)) = ((v >> 16) & 255) as u8;
        (*d.add((at + 3) as usize)) = ((v >> 24) & 255) as u8;
        (*get_bufs().add(out as usize)).len = at + 4;
    }
}

fn w64(out: i64, v: i64) {
    w32(out, v);
    w32(out, v >> 32);
}

// A name in a fixed 16-byte field.
fn wname16(out: i64, name: *mut u8) {
    unsafe {
        let n = strlen(name) as i64;
        for i in 0..16 {
            w8(out, if i < n { (*name.add(i as usize)) as i64 } else { 0 });
        }
    }
}

fn pad_to(out: i64, size: i64) {
    while unsafe { (*get_bufs().add(out as usize)).len < size } {
        buf_byte(out, 0);
    }
}

fn align_up(v: i64, a: i64) -> i64 {
    (v + a - 1) & (0 - a)
}

// Whether section `sec` holds DWARF.
pub fn is_debug(sec: i64) -> bool {
    sec >= SEC_DEBUG_ABBREV && sec <= SEC_DEBUG_LINE
}

// ---- The driver ----

// Assembles ASM into an object file at `path` (what asm_flush has not
// assembled yet).
pub fn write_object(cx: &mut FnCtx, path: *mut u8, pcx: &mut Ctx<Comp>) {
    unsafe {
        if !pcx.asm_stream {
            assembler_begin();
        }
        assemble_text(cx);
        if pcx.asm_stream {
            (*get_bufs().add(cx.asm as usize)).len = 0;
        }
        new_frag(get_cur_sec());
        layout();
        resolve_fixups(cx, pcx);
        build_sections(pcx);
        if get_rows().count > 0 {
            line_program(pcx);
        }
        if get_cfi_fns().count > 0 {
            compact_unwind(pcx);
        }
        if get_elf() {
            { let mut sec_align_copy = get_sec_align(); sec_align_copy[SEC_NOTE as usize] = 0;
                set_sec_align(sec_align_copy); }
            elf_write(path, pcx);
        } else {
            macho_write(path, pcx);
        }
    }
}

// The assembler's state before the first line.
fn assembler_begin() {
    set_obj(ObjBytes { data: alloc_zeroed(65536), len: 0, cap: 65536 });
    set_mapping(get_elf() && !get_x86());
    set_hooks(get_mapping());
    set_cur_sec(SEC_TEXT);
    { let mut sec_used_copy = get_sec_used(); sec_used_copy[SEC_TEXT as usize] = true;
        set_sec_used(sec_used_copy); }
    new_frag(SEC_TEXT);
    assemble_begin();
    if get_x86() {
        init_x86();
    } else {
        init_a64();
    }
}

// Assembles the lines in ASM.
fn assemble_text(cx: &mut FnCtx) {
    unsafe {
        assemble_bytes(cx, (*get_bufs().add(cx.asm as usize)).data,
            (*get_bufs().add(cx.asm as usize)).len);
    }
}

// (0.18.1) Assembles the lines of text[0..n] (ATEXT while it runs).
pub fn assemble_bytes(cx: &mut FnCtx, text: *mut u8, n: i64) {
    unsafe {
        set_atext(text);
        let t = text;
        let mut i: i64 = 0;
        while i < n {
            // (0.17: the end of the line by memchr, not byte by byte)
            let nl = memchr(t.add(i as usize), 10, (n - i) as u64);
            let e = if nl == 0 as *mut u8 { n }
                else { i + (nl as i64 - (t.add(i as usize)) as i64) };
            assemble_line(cx, i, e);
            i = e + 1;
        }
    }
}

// (0.18.1) The text being assembled (assemble_text's): the assembler
// reads it here, not from a buffer of BUFS, which code generation may
// grow while the assembler runs on a thread of its own.
static mut ATEXT: *mut u8 = 0 as *mut u8;

// From the first function on (after the file's header): see ASM_STREAM.
pub fn asm_stream_begin(pcx: &mut Ctx<Comp>) {
    if pcx.output_mode != OUT_ASM && !pcx.debug_info {
        pcx.asm_stream = true;
        assembler_begin();
    }
}

// Assembles the text written so far (whole lines: a function's), when
// streaming.
pub fn asm_flush(cx: &mut FnCtx, pcx: &Ctx<Comp>) {
    unsafe {
        if pcx.asm_stream {
            // (its time is the output's, as when the text is assembled at
            // the end, not the code generation's that runs it)
            let t = timer_now(pcx);
            c_module_symbols(cx, pcx);
            assemble_text(cx);
            (*get_bufs().add(cx.asm as usize)).len = 0;
            timer_sub(T_CODEGEN, T_OUTPUT, t, pcx);
        }
    }
}

// (0.18.1) asm_flush on the assembler's thread (middle::threads): the text
// so far, copied, is handed to it.
pub fn asm_hand_over(cx: &mut FnCtx, pcx: &Ctx<Comp>) {
    unsafe {
        if pcx.asm_stream {
            c_module_symbols(cx, pcx);
            let n = (*get_bufs().add(cx.asm as usize)).len;
            let copy = alloc_zeroed(n + 1);
            memcpy(copy, (*get_bufs().add(cx.asm as usize)).data, n as u64);
            asm_thread_push(copy, n);
            (*get_bufs().add(cx.asm as usize)).len = 0;
        }
    }
}

// ---- Output ----

extern "C" {
    fn system(command: *mut u8) -> i32;
    fn unlink(path: *mut u8) -> i32;
    fn getenv(name: *mut u8) -> *mut u8;
    fn memchr(s: *mut u8, c: i32, n: u64) -> *mut u8;
}

// What the compiler writes: assembly (`-S`, `--emit-asm`, or an output
// named *.s), an object (`-c`, or *.o), or an executable linked by `cc`
// (any other output name).
pub const OUT_ASM: i64 = 0;
pub const OUT_OBJECT: i64 = 1;
pub const OUT_EXECUTABLE: i64 = 2;

// The output mode for `path` when no option chose one.
pub fn output_mode_of(path: *mut u8) -> i64 {
    unsafe {
        let n = strlen(path) as i64;
        if n >= 2 && (*path.add((n - 2) as usize)) == b'.'
            && (*path.add((n - 1) as usize)) == b's' {
            return OUT_ASM;
        }
        if n >= 2 && (*path.add((n - 2) as usize)) == b'.'
            && (*path.add((n - 1) as usize)) == b'o' {
            return OUT_OBJECT;
        }
        OUT_EXECUTABLE
    }
}

// Writes the program (ASM) to `path` as the output mode says.
pub fn write_output(cx: &mut FnCtx, path: *mut u8, pcx: &mut Ctx<Comp>) {
    unsafe {
        c_module_symbols(cx, pcx);
        if pcx.output_mode == OUT_ASM {
            buf_write_file(cx.asm, path);
            return;
        }
        if pcx.output_mode == OUT_OBJECT {
            write_object(cx, path, pcx);
            return;
        }
        let obj = buf_new();
        buf_fmt(obj, format_args("{}.vole.o\0", str::from_utf8(cstr(path)).unwrap()));
        let obj_path = (*get_bufs().add(obj as usize)).data;
        write_object(cx, obj_path, pcx);
        // (0.25.3: the link's inputs first, its failure one error)
        check_link_inputs(pcx);
        build_linking(path, pcx);
        let mut status = link_program(path, obj_path, pcx) as i32;
        if status != 0 {
            unlink(obj_path);
            link_failed(status as i64, path, pcx);
        }
        if status == 0 && pcx.debug_info && !get_elf() {
            // (-g) On macOS the debug information stays in the object, which
            // goes: dsymutil gathers it into <path>.dSYM first, as clang does.
            let dsym = buf_new();
            buf_fmt(dsym, format_args("dsymutil '{}'\0", str::from_utf8(cstr(path)).unwrap()));
            status = system((*get_bufs().add(dsym as usize)).data);
        }
        unlink(obj_path);
        if status != 0 {
            die(c"dsymutil failed");
        }
    }
}

// (0.28.0) CUR_SEC's accessors: every use of it is one of them.
pub fn get_cur_sec() -> i64 {
    // UNSAFE: the assembler's state, a process-wide static mut that the
    // main thread and the assembler thread use in turn; Rust has no safe
    // access to a static mut
    // SAFETY: one thread at a time uses it: the main thread before
    // asm_thread_start (assembler_begin, from asm_stream_begin, runs before
    // it in compile_program) and after asm_thread_finish's pthread_join,
    // the assembler thread (asm_thread_main -> assemble_bytes) in between;
    // pthread_create and pthread_join order the hand-overs; no worker
    // reaches it, the -O0 main thread's code generation between start and
    // finish (gen_places_function, gen_atomic_function, asm_hand_over and
    // the loop around them) touches none of it, and at -O1+ there is no
    // assembler thread (only the main thread assembles, in join_task's
    // asm_flush); accessed through the accessor's raw pointer, no reference
    // kept
    unsafe { CUR_SEC }
}

pub fn set_cur_sec(v: i64) {
    // UNSAFE: the assembler's state, a process-wide static mut that the
    // main thread and the assembler thread use in turn; Rust has no safe
    // access to a static mut
    // SAFETY: one thread at a time uses it: the main thread before
    // asm_thread_start (assembler_begin, from asm_stream_begin, runs before
    // it in compile_program) and after asm_thread_finish's pthread_join,
    // the assembler thread (asm_thread_main -> assemble_bytes) in between;
    // pthread_create and pthread_join order the hand-overs; no worker
    // reaches it, the -O0 main thread's code generation between start and
    // finish (gen_places_function, gen_atomic_function, asm_hand_over and
    // the loop around them) touches none of it, and at -O1+ there is no
    // assembler thread (only the main thread assembles, in join_task's
    // asm_flush); accessed through the accessor's raw pointer, no reference
    // kept
    unsafe {
        CUR_SEC = v;
    }
}

