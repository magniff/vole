// Object files (0.7): the assembly the code generator wrote (ASM) is
// assembled here, by the compiler itself, into a Mach-O object (macOS,
// both instruction sets) or an ELF one (Linux), so that `cc` only links.
// The text is the single source: `--emit-asm` writes it as it is, and the
// object holds exactly what it says. tests/objcheck.sh links both this
// object and `cc -c` of the same text and compares the results.
//
// The text is the compiler's own, in a small regular subset of the
// assembler syntax (one statement per line; labels `name:`; the
// directives .text, .data, .section, .globl, .p2align, .byte, .long,
// .quad, .space; with -g, 0.11, also .file, .loc and, on Mach-O, the
// .cfi_* of the standard frame; 0.25, in an object's text only,
// `.vole_data`: constant data's bytes, RAW). Lines are assembled in one pass into fragments: runs of
// bytes, each followed by an optional tail whose size depends on where it
// lands (an alignment, or an x86-64 branch that may be short or long).
// Layout places the fragments, relaxing branches as GNU as and LLVM do
// (all short first; one that does not reach grows, until nothing does);
// then fixups are resolved or become relocations, and the object is
// written (macho_write, elf_write).
//
// Instructions are encoded by enc_arm64.vl (AArch64) and enc_x86.vl
// (x86-64).
//
// This file holds the object being built (sections, fragments, symbols,
// fixups, relocations), the byte writers and the driver (write_object,
// write_output); the parts, in the order the driver runs them:
// assemble.vl (the text, line by line), resolve.vl (layout, fixups,
// section contents), debug.vl (what -g adds: the DWARF line program and
// compact unwind), macho.vl and elf.vl (the writers).

pub mod assemble;
mod debug;
mod resolve;
mod macho;
mod elf;
pub mod output;
// (0.25.3) main.missing, and a failed link's error
pub mod linkfail;
mod link_macho;

use crate::back::enc_arm64::{AOp, aop_none, init_a64};
use crate::back::enc_x86::{XOp, init_x86, xop_none};
use crate::base::{
    alloc_array, alloc_zeroed, buf_byte, buf_clear, buf_copy, buf_fmt, buf_len, buf_new, buf_ptr,
    buf_w16, buf_w32, buf_write_file, cstr, die, free, memcmp, memcpy,
};

use assemble::{Memo, assemble_begin, assemble_line};
use debug::{compact_unwind, line_program};
use elf::elf_write;
use macho::macho_write;
use resolve::{build_sections, layout, resolve_fixups};

// The assembler's text helpers, used by the instruction encoders.
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::base::term::build_linking;
use crate::base::timer::{T_CODEGEN, T_OUTPUT, timer_now, timer_sub};
use crate::middle::ctx::FnCtx;
use crate::middle::threads::asm_thread_push;

use linkfail::{check_link_inputs, link_failed};
use output::{c_module_symbols, link_program};

// ---- The assembler ----

// (0.29) The assembler's state: the text being assembled and the object
// being built from it. One per output; it is the function context's
// (`FnCtx.assembler`: the main thread's, which -O0 lends to the
// assembler's thread from asm_thread_start to asm_thread_finish), and
// every function of the assembler takes it.
pub struct Asm<A: std::alloc::Allocator> {
    // The text being assembled (assemble_bytes's copy of it: the
    // assembler reads no buffer that code generation may grow while the
    // assembler runs on a thread of its own).
    pub text: Vec<u8, A>,
    // The section being filled; each section's alignment (log2) and
    // whether anything names it.
    pub cur_sec: i64,
    pub sec_align: [i64; 9],
    pub sec_used: [bool; 9],
    // The fragments, and the one being filled (always the last one).
    pub frags: Vec<Frag, A>,
    pub open: i64,
    // (0.18.1) The assembled bytes.
    pub obj: Vec<u8, A>,
    // (0.29) The constant data's bytes (Ctx.obj_raw), here while text is
    // assembled on the main thread (assemble_text); empty otherwise.
    pub raw: Vec<u8, A>,
    // Mach-O's atoms: a label that is not temporary starts one, which
    // runs to the next. LLVM resolves a pc-relative reference only within
    // one atom (else the linker could move them apart): the current atom
    // per section.
    pub cur_atom: [i64; 9],
    // The symbols, their names' bytes (ASym.name, name_len), and the
    // table of them by name: symbol + 1 (open addressing; its length a
    // power of two, or 0 before the first symbol).
    pub syms: Vec<ASym, A>,
    pub sym_names: Vec<u8, A>,
    pub sym_table: Vec<i64, A>,
    // (0.25) asym's calls: an instruction that made none names no symbol
    // (assemble.vl's memo).
    pub lookups: i64,
    pub fixups: Vec<Fixup, A>,
    // The statement being assembled: its bytes [line_start, line_end) of
    // the text (for an error), and its operands, [op_start[i], op_end[i])
    // each, split at commas outside brackets and parentheses.
    pub line_start: i64,
    pub line_end: i64,
    pub op_start: [i64; 8],
    pub op_end: [i64; 8],
    pub op_count: i64,
    // (0.25) Each byte's class for split_operands: 1 a comma, 2 an
    // opening bracket or parenthesis, 3 a closing one, 0 any other (one
    // test a byte).
    pub op_class: [u8; 256],
    // Whether the object has mapping symbols (AArch64 ELF); whether an
    // instruction may need more than its encoding: mapping symbols or
    // `.loc`s (one test on the common path); per section the kind last
    // marked; the marks: (section, fragment, offset, kind) each.
    pub mapping: bool,
    pub hooks: bool,
    pub map_state: [i64; 9],
    pub maps: Vec<i64, A>,
    // (0.25) The lines assembled before (assemble.vl): the memos, the
    // table of them by hash (memo + 1, open addressing; its length a power
    // of two or 0), the lines' text, and the hash of the line memo_find
    // was last asked.
    pub memos: Vec<Memo, A>,
    pub memo_table: Vec<i64, A>,
    pub memo_text: Vec<u8, A>,
    pub memo_hash: u64,
    // The encoders' (enc_arm64, enc_x86): the operands of the instruction
    // being encoded, parsed; the mnemonics' codes and x86-64's registers
    // by name.
    pub a64: [AOp; 8],
    pub x86: [XOp; 8],
    pub mn: Names<A>,
    pub xmn: Names<A>,
    pub xregs: Names<A>,
    // (-g, debug.vl) Call frame information: per function its start and
    // end (fragment, offset) each; the directives seen in the open one.
    pub cfi_fns: Vec<i64, A>,
    pub cfi_ops: i64,
    // (-g) The position a `.loc` gave for the next instruction; the line
    // table's rows: (fragment, offset, file, line, column) each.
    pub loc_pending: bool,
    pub loc_file: i64,
    pub loc_line: i64,
    pub loc_col: i64,
    pub rows: Vec<i64, A>,
    // (-g) Per file number: its directory (an index in dirs + 1, 0 for
    // none) and name, as the system assemblers split a path; a name is
    // name_copy's, in dbg_names.
    pub file_dir: Vec<i64, A>,
    pub file_name: Vec<i64, A>,
    pub dirs: Vec<i64, A>,
    pub dbg_names: Vec<u8, A>,
}

pub fn asm_new() -> Asm<Comp> {
    Asm {
        text: Vec::new_in(Comp {}), cur_sec: 0, sec_align: [0i64; 9], sec_used: [false; 9],
        frags: Vec::new_in(Comp {}), open: -1, obj: Vec::new_in(Comp {}),
        raw: Vec::new_in(Comp {}), cur_atom: [-1; 9],
        syms: Vec::new_in(Comp {}), sym_names: Vec::new_in(Comp {}),
        sym_table: Vec::new_in(Comp {}), lookups: 0, fixups: Vec::new_in(Comp {}),
        line_start: 0, line_end: 0, op_start: [0i64; 8], op_end: [0i64; 8], op_count: 0,
        op_class: [0u8; 256], mapping: false, hooks: false, map_state: [0i64; 9],
        maps: Vec::new_in(Comp {}), memos: Vec::new_in(Comp {}), memo_table: Vec::new_in(Comp {}),
        memo_text: Vec::new_in(Comp {}), memo_hash: 0,
        a64: [aop_none(); 8], x86: [xop_none(); 8], mn: names_new(), xmn: names_new(),
        xregs: names_new(), cfi_fns: Vec::new_in(Comp {}), cfi_ops: 0, loc_pending: false,
        loc_file: 0, loc_line: 0, loc_col: 0, rows: Vec::new_in(Comp {}),
        file_dir: Vec::new_in(Comp {}), file_name: Vec::new_in(Comp {}),
        dirs: Vec::new_in(Comp {}), dbg_names: Vec::new_in(Comp {}),
    }
}

// ---- Sections ----

pub const SEC_TEXT: i64 = 0;
pub const SEC_CONST: i64 = 1;
pub const SEC_DATA: i64 = 2;
pub const SEC_NOTE: i64 = 3;
// (0.11, -g) DWARF.
pub const SEC_DEBUG_ABBREV: i64 = 4;
pub const SEC_DEBUG_INFO: i64 = 5;
pub const SEC_DEBUG_LINE: i64 = 6;
// (0.11, -g) Mach-O's compact unwind information, made from the CFI.
pub const SEC_UNWIND: i64 = 7;
// (0.25.5) Zero-initialized data: Mach-O's __DATA,__bss (zerofill), ELF's
// .bss (nobits). Its bytes are laid out as any section's but not written:
// the object says only its size. Last, as a zerofill section must be in
// its segment.
pub const SEC_BSS: i64 = 8;
const SEC_COUNT: i64 = 9;

// ---- Fragments ----

const TAIL_NONE: i64 = 0;
const TAIL_ALIGN: i64 = 1;
pub const TAIL_JMP: i64 = 2;
pub const TAIL_JCC: i64 = 3;

// Bytes [start, start + len) of the object's bytes (Asm.obj), then the
// tail: an alignment to 2^arg bytes, or a branch (arg: the condition) to
// symbol `sym`, short or long. `addr`: the fragment's offset in its
// section.
#[derive(Clone, Copy)] pub struct Frag {
    pub sec: i64, pub start: i64, pub len: i64, pub tail: i64, pub arg: i64, pub sym: i64,
    pub long: bool, pub addr: i64, pub atom: i64,
}

// (0.25) Constant data's bytes (Ctx.obj_raw), put there by the code
// generator when the output is an object (gen0::target's data_bytes): the
// text names a run of them, `.vole_data OFFSET, LENGTH`, instead of
// spelling it in `.byte` lines (12 MB of text for the compiler's 2.9 MB
// of constants), and the assembler copies it. The code generator writes
// them through `&Ctx`, so they are behind a lock; the assembler has them
// (Asm.raw) while it assembles text on the main thread (assemble_text).

// Appends `bytes` to v, as one block.
pub fn append_bytes(v: &mut Vec<u8, Comp>, bytes: &[u8]) {
    let n = bytes.len();
    v.reserve(n);
    // UNSAFE: the bytes are copied as a block into the room reserved for
    // them. std's extend_from_slice pushes one element at a time (a clone,
    // a bounds check and a growth test each): for the assembler's copy of
    // its text that was a third of an -O0 build's "data and output"
    // (measured, 0.29: 6.9 G instructions against 4.5 G).
    // SAFETY: reserve(n) made the capacity at least len + n, so bytes
    // [len, len + n) of v's block are allocated; `bytes` has n readable
    // bytes and is no part of v (a shared borrow beside v's mutable one);
    // memcpy writes exactly those n bytes, so the new length covers only
    // initialized bytes, and u8 has nothing to drop.
    unsafe {
        memcpy(v.as_mut_ptr().add(v.len()), bytes.ptr, n as u64);
        v.set_len(v.len() + n);
    }
}

// Whether a and b are the same bytes.
pub fn same_bytes(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    // UNSAFE: C's memcmp over two slices of one length: the slices' `==`
    // compares a byte at a time, and the assembler compares every line
    // with its memo and every name with its symbol's.
    // SAFETY: both slices have a.len() readable bytes (the lengths are
    // equal, tested above); memcmp reads no more and keeps no pointer.
    unsafe { memcmp(a.ptr, b.ptr, a.len() as u64) == 0 }
}

// Appends bytes to the constant data's bytes; returns their offset there.
pub fn raw_data(bytes: &[u8], pcx: &Ctx<Comp>) -> i64 {
    let mut raw = pcx.obj_raw.lock().unwrap();
    let at = raw.len() as i64;
    append_bytes(&mut *raw, bytes);
    at
}

// Appends bytes [at, at + n) of the constant data's bytes to the object's
// bytes; false when there are no such bytes (or the assembler was not
// given them: the text of -O0's assembler thread names none).
pub fn raw_out(at: i64, n: i64, asm: &mut Asm<Comp>) -> bool {
    if at < 0 || n < 0 || at + n > asm.raw.len() as i64 {
        return false;
    }
    append_bytes(&mut asm.obj, &asm.raw[at as usize..(at + n) as usize]);
    true
}

fn new_frag(sec: i64, asm: &mut Asm<Comp>) {
    let at = asm.obj.len() as i64;
    if asm.open >= 0 {
        asm.frags[asm.open as usize].len = at - asm.frags[asm.open as usize].start;
    }
    asm.open = asm.frags.len() as i64;
    asm.frags.push(Frag {
        sec, start: at, len: 0, tail: TAIL_NONE, arg: 0, sym: -1, long: false, addr: 0, atom: -1,
    });
}

// Ends the open fragment with a tail, and opens the next.
fn end_frag(tail: i64, arg: i64, sym: i64, asm: &mut Asm<Comp>) {
    let atom = asm.cur_atom[asm.cur_sec as usize];
    let f = &mut asm.frags[asm.open as usize];
    f.tail = tail;
    f.arg = arg;
    f.sym = sym;
    f.atom = atom;
    new_frag(asm.cur_sec, asm);
}

fn switch_section(sec: i64, asm: &mut Asm<Comp>) {
    asm.sec_used[sec as usize] = true;
    if sec != asm.cur_sec {
        asm.cur_sec = sec;
        new_frag(sec, asm);
    }
}

// The position (in the object's bytes) of the next byte.
pub fn here(asm: &Asm<Comp>) -> i64 {
    asm.obj.len() as i64
}

pub fn out8(b: i64, asm: &mut Asm<Comp>) {
    asm.obj.push((b & 255) as u8);
}

pub fn out16(v: i64, asm: &mut Asm<Comp>) {
    out8(v, asm);
    out8(v >> 8, asm);
}

// (0.17: the four bytes with one check for room, not four calls)
pub fn out32(v: i64, asm: &mut Asm<Comp>) {
    append_bytes(&mut asm.obj,
        &[(v & 255) as u8, ((v >> 8) & 255) as u8, ((v >> 16) & 255) as u8,
            ((v >> 24) & 255) as u8]);
}

pub fn out64(v: i64, asm: &mut Asm<Comp>) {
    out32(v, asm);
    out32(v >> 32, asm);
}

// Reads and writes a little-endian 32-bit word of the object's bytes.
fn get32(pos: i64, asm: &Asm<Comp>) -> i64 {
    let d = &asm.obj[pos as usize..(pos + 4) as usize];
    (d[0] as i64) | (d[1] as i64) << 8 | (d[2] as i64) << 16 | (d[3] as i64) << 24
}

fn put32(pos: i64, v: i64, asm: &mut Asm<Comp>) {
    let d = &mut asm.obj[pos as usize..(pos + 4) as usize];
    d[0] = (v & 255) as u8;
    d[1] = ((v >> 8) & 255) as u8;
    d[2] = ((v >> 16) & 255) as u8;
    d[3] = ((v >> 24) & 255) as u8;
}

// ---- Symbols ----

// A name of the assembly: a label (defined in `sec` at `off` from the
// start of fragment `frag`), or a name only referred to. `in_table`: the
// symbol table needs it (relocations refer to it); `index`: its index
// there.
// (0.18.1: its name its own bytes, `name_len` of Asm.sym_names from
// `name` on, not an interned symbol: the assembler runs beside code
// generation's threads, which read the symbols.)
#[derive(Clone, Copy)] pub struct ASym {
    pub name: i64, pub name_len: i64, pub hash: u64, pub defined: bool, pub global: bool,
    pub frag: i64, pub off: i64, pub sec: i64, pub in_table: bool, pub index: i64, pub atom: i64,
}

// The name of symbol s.
pub fn sym_name(s: i64, asm: &Asm<Comp>) -> &[u8] {
    let y = &asm.syms[s as usize];
    &asm.sym_names[y.name as usize..(y.name + y.name_len) as usize]
}

// The symbol named `name`, made when the name is new.
pub fn asym(name: &[u8], asm: &mut Asm<Comp>) -> i64 {
    asm.lookups += 1;
    sym_intern(name, &mut asm.syms, &mut asm.sym_names, &mut asm.sym_table)
}

// The symbol named by bytes [a, b) of the text.
pub fn asym_text(a: i64, b: i64, asm: &mut Asm<Comp>) -> i64 {
    asm.lookups += 1;
    sym_intern(&asm.text[a as usize..b as usize], &mut asm.syms, &mut asm.sym_names,
        &mut asm.sym_table)
}

fn sym_intern(name: &[u8], syms: &mut Vec<ASym, Comp>, names: &mut Vec<u8, Comp>,
    table: &mut Vec<i64, Comp>) -> i64 {
    if (syms.len() + 1) * 2 > table.len() {
        // The table by name, twice as large.
        let size: usize = if table.len() == 0 { 1024 } else { table.len() * 2 };
        table.clear();
        table.resize(size, 0);
        let mask = (size - 1) as u64;
        for s in 0..syms.len() {
            let mut slot = syms[s].hash & mask;
            while table[slot as usize] != 0 {
                slot = (slot + 1) & mask;
            }
            table[slot as usize] = s as i64 + 1;
        }
    }
    let hash = hash_bytes(name);
    let mask = (table.len() - 1) as u64;
    let mut slot = hash & mask;
    while table[slot as usize] != 0 {
        let s = table[slot as usize] - 1;
        let y = &syms[s as usize];
        // (0.25: the hashes first, then the bytes)
        if y.hash == hash && y.name_len == name.len() as i64
            && same_bytes(&names[y.name as usize..(y.name + y.name_len) as usize], name) {
            return s;
        }
        slot = (slot + 1) & mask;
    }
    let s = syms.len() as i64;
    syms.push(ASym {
        name: names.len() as i64, name_len: name.len() as i64, hash, defined: false,
        global: false, frag: -1, off: 0, sec: -1, in_table: false, index: -1, atom: -1,
    });
    append_bytes(names, name);
    table[slot as usize] = s + 1;
    s
}

// A hash of a name.
fn name_hash(t: &[u8]) -> u64 {
    hash_bytes(t)
}

// (0.25) A hash of bytes, eight at a time (FNV-1a's byte at a time was a
// chain of multiplications as long as the name).
pub fn hash_bytes(b: &[u8]) -> u64 {
    let n = b.len();
    let mut h: u64 = (n as u64).wrapping_mul(0x9e3779b97f4a7c15u64);
    let mut i: usize = 0;
    while i + 8 <= n {
        let p = &b[i..i + 8];
        let w = p[0] as u64 | (p[1] as u64) << 8 | (p[2] as u64) << 16 | (p[3] as u64) << 24
            | (p[4] as u64) << 32 | (p[5] as u64) << 40 | (p[6] as u64) << 48
            | (p[7] as u64) << 56;
        h = (h ^ w).wrapping_mul(0xff51afd7ed558ccdu64);
        h = h ^ (h >> 32);
        i += 8;
    }
    let mut w: u64 = 0;
    let mut s: u64 = 0;
    while i < n {
        w = w | (b[i] as u64) << s;
        s += 8;
        i += 1;
    }
    h = (h ^ w).wrapping_mul(0xff51afd7ed558ccdu64);
    h ^ (h >> 32)
}

// (0.29) A table from names to values (0: none) that owns its names:
// the assembler's mnemonics and registers (Asm.mn, xmn, xregs). `bytes`:
// the names, one after the other; a slot's name is `lens[slot]` bytes of
// it from `offs[slot]`; `vals[slot]` 0: an empty slot (open addressing;
// the slots' number a power of two, or 0 before the first name).
pub struct Names<A: std::alloc::Allocator> {
    bytes: Vec<u8, A>, offs: Vec<i64, A>, lens: Vec<i64, A>, vals: Vec<i64, A>, count: usize,
}

pub fn names_new() -> Names<Comp> {
    Names {
        bytes: Vec::new_in(Comp {}), offs: Vec::new_in(Comp {}), lens: Vec::new_in(Comp {}),
        vals: Vec::new_in(Comp {}), count: 0,
    }
}

// The slot of `name` in m (its own, or the empty one it would take); m
// has slots.
fn names_slot(m: &Names<Comp>, name: &[u8]) -> usize {
    let mask = (m.vals.len() - 1) as u64;
    let mut slot = (name_hash(name) & mask) as usize;
    while m.vals[slot] != 0
        && &m.bytes[m.offs[slot] as usize..(m.offs[slot] + m.lens[slot]) as usize] != name {
        slot = (slot + 1) & mask as usize;
    }
    slot
}

pub fn names_put(m: &mut Names<Comp>, name: &[u8], value: i64) {
    if (m.count + 1) * 2 > m.vals.len() {
        // Twice the slots, the names put again.
        let size: usize = if m.vals.len() == 0 { 256 } else { m.vals.len() * 2 };
        let mut grown = Names {
            bytes: Vec::new_in(Comp {}), offs: Vec::new_in(Comp {}), lens: Vec::new_in(Comp {}),
            vals: Vec::new_in(Comp {}), count: 0,
        };
        grown.offs.resize(size, 0);
        grown.lens.resize(size, 0);
        grown.vals.resize(size, 0);
        for i in 0..m.vals.len() {
            if m.vals[i] != 0 {
                names_put(&mut grown,
                    &m.bytes[m.offs[i] as usize..(m.offs[i] + m.lens[i]) as usize], m.vals[i]);
            }
        }
        *m = grown;
    }
    let slot = names_slot(m, name);
    if m.vals[slot] == 0 {
        m.offs[slot] = m.bytes.len() as i64;
        m.lens[slot] = name.len() as i64;
        m.bytes.extend_from_slice(name);
        m.count += 1;
    }
    m.vals[slot] = value;
}

pub fn names_get(m: &Names<Comp>, name: &[u8]) -> i64 {
    if m.vals.len() == 0 {
        return 0;
    }
    m.vals[names_slot(m, name)]
}

// (0.18.1) A table from names to values (0: none): the assembler's own
// (its mnemonics, registers), so that it reads no table the rest of the
// compiler grows while it runs on a thread of its own. A name is its
// bytes' address and length.
#[derive(Clone, Copy)] pub struct NameMap {
    pub ptrs: *mut i64, pub lens: *mut i64, pub vals: *mut i64, pub size: i64, pub count: i64,
}

fn name_at(m: NameMap, slot: i64) -> &'static [u8] {
    // UNSAFE: NameMap keeps each name as a pointer and a length in two raw
    // tables (it is a static's type, arch::table's INSN_BY_NAME, which cannot
    // hold a Vec).
    // SAFETY: the callers (name_put, name_get) pass a slot below m.size, the
    // tables' length (masked by size - 1), whose value is not 0: name_put
    // stored there a block of lens[slot] + 1 bytes it allocated and filled,
    // and no name is ever freed, which is what 'static says.
    unsafe {
        std::slice::from_raw_parts(((*m.ptrs.add(slot as usize)) as *mut u8).add((0) as usize),
            ((*m.lens.add(slot as usize)) - (0)) as usize)
    }
}

pub fn name_put(m: &mut NameMap, name: &[u8], value: i64) {
    // UNSAFE: NameMap's raw tables (see name_at): allocated, indexed and
    // freed by hand.
    // SAFETY: ptrs, lens and vals are blocks of m.size entries (alloc_array,
    // zeroed), or unused while m.size is 0, in which case the first branch
    // allocates before any read; every index is below size: i < old.size in
    // the copy, slot masked by size - 1 (a power of two: 256 doubled); the
    // loop ends because the table is at most half full; the old tables are
    // freed once, after their names moved, and `old` is not used again; the
    // copy has n + 1 bytes for name's n.
    unsafe {
        if (m.count + 1) * 2 > m.size {
            let old = *m;
            m.size = if old.size == 0 { 256 } else { old.size * 2 };
            m.ptrs = alloc_array::<i64>(m.size);
            m.lens = alloc_array::<i64>(m.size);
            m.vals = alloc_array::<i64>(m.size);
            m.count = 0;
            for i in 0..old.size {
                if (*old.vals.add(i as usize)) != 0 {
                    name_put(m,
                        std::slice::from_raw_parts(
                            ((*old.ptrs.add(i as usize)) as *mut u8).add((0) as usize),
                            ((*old.lens.add(i as usize)) - (0)) as usize),
                        (*old.vals.add(i as usize)));
                }
            }
            free(old.ptrs as *mut u8);
            free(old.lens as *mut u8);
            free(old.vals as *mut u8);
        }
        let mask = (m.size - 1) as u64;
        let mut slot = name_hash(name) & mask;
        while (*m.vals.add(slot as usize)) != 0 && name_at(*m, slot as i64) != name {
            slot = (slot + 1) & mask;
        }
        if (*m.vals.add(slot as usize)) == 0 {
            let n = name.len() as i64;
            let copy = alloc_zeroed(n + 1);
            memcpy(copy, name.ptr, n as u64);
            (*m.ptrs.add(slot as usize)) = copy as i64;
            (*m.lens.add(slot as usize)) = n;
            m.count += 1;
        }
        (*m.vals.add(slot as usize)) = value;
    }
}

pub fn name_get(m: NameMap, name: &[u8]) -> i64 {
    // UNSAFE: NameMap's raw tables (see name_at).
    // SAFETY: size is not 0 here, so vals is a block of size entries; slot is
    // masked by size - 1; the loop ends at an empty slot, of which a table at
    // most half full has one.
    unsafe {
        if m.size == 0 {
            return 0;
        }
        let mask = (m.size - 1) as u64;
        let mut slot = name_hash(name) & mask;
        while (*m.vals.add(slot as usize)) != 0 {
            if name_at(m, slot as i64) == name {
                return (*m.vals.add(slot as usize));
            }
            slot = (slot + 1) & mask;
        }
        0
    }
}

// A C string's bytes.
pub fn c_bytes(s: *mut u8) -> &'static [u8] {
    // UNSAFE: a C string seen as a slice (base::c_bytes)
    // SAFETY: not checked here: s must be a C string that is never freed
    // or written again (the object writer passes symbol and section
    // names, which are literals or kept for the process); the 'static
    // is that promise, as cstr's
    unsafe { crate::base::c_bytes(s) }
}

// A temporary label (L... on Mach-O, .L... on ELF): never in the symbol
// table unless a relocation needs it (Mach-O only; ELF uses the section).
fn is_temp(s: i64, asm: &Asm<Comp>) -> bool {
    let t = sym_name(s, asm);
    if get_elf() { t.len() >= 2 && t[0] == b'.' && t[1] == b'L' }
    else { t.len() >= 1 && t[0] == b'L' }
}

fn sym_addr(s: i64, asm: &Asm<Comp>) -> i64 {
    let y = &asm.syms[s as usize];
    asm.frags[y.frag as usize].addr + y.off
}

// ---- Fixups ----

pub const FX_A64_B26: i64 = 1;
pub const FX_A64_B19: i64 = 2;
pub const FX_A64_B14: i64 = 3;
pub const FX_A64_ADR: i64 = 4;
pub const FX_A64_PAGE: i64 = 5;
pub const FX_A64_PAGEOFF: i64 = 6;
pub const FX_A64_GOTPAGE: i64 = 7;
pub const FX_A64_GOTPAGEOFF: i64 = 8;
pub const FX_X86_BRANCH: i64 = 9;
pub const FX_X86_RIP: i64 = 10;
pub const FX_X86_GOT: i64 = 11;
pub const FX_DIFF32: i64 = 12;
pub const FX_ABS64: i64 = 13;
pub const FX_ABS32: i64 = 14;

// `pos`: the field's position in OBJ_BYTES (an AArch64 instruction, or an
// x86-64 or data field); `frag`: its fragment; `end`: for x86-64, the
// position where the instruction ends (pc); `sym2`: the subtracted label
// of FX_DIFF32. `rex`: an x86-64 GOT load with a REX prefix.
#[derive(Clone, Copy)] struct Fixup {
    kind: i64, frag: i64, pos: i64, sym: i64, sym2: i64, addend: i64, end: i64, rex: bool,
    atom: i64,
}

pub fn fixup(kind: i64, pos: i64, sym: i64, addend: i64, end: i64, rex: bool, asm: &mut Asm<Comp>) {
    asm.fixups.push(Fixup {
        kind, frag: asm.open, pos, sym, sym2: -1, addend, end, rex,
        atom: asm.cur_atom[asm.cur_sec as usize],
    });
}

// x86-64 branches whose size layout decides (jmp, jcc to a label).
pub fn emit_relaxable(tail: i64, cond: i64, sym: i64, asm: &mut Asm<Comp>) {
    end_frag(tail, cond, sym, asm);
}

// ---- Relocations ----

// In section `sec` at `offset`: the object format's relocation type
// `rtype`, against symbol `sym` (an ASYMS index, or -1 - section for a
// section of ELF), with `addend` (ELF) and, for Mach-O, pc-relativity and
// the field's length (log2 bytes).
#[derive(Clone, Copy)] pub struct Reloc {
    sec: i64, offset: i64, rtype: i64, sym: i64, addend: i64, pcrel: bool, length: i64,
}

fn reloc(sec: i64, offset: i64, rtype: i64, sym: i64, addend: i64, pcrel: bool, length: i64,
    pcx: &mut Ctx<Comp>) {
    pcx.relocs.push(Reloc { sec, offset, rtype, sym, addend, pcrel, length });
}

// A relocation against symbol s itself (a GOT entry's).
fn reloc_to_symbol(sec: i64, offset: i64, rtype: i64, s: i64, pcrel: bool, asm: &mut Asm<Comp>,
    pcx: &mut Ctx<Comp>) {
    unsafe { asm.syms[s as usize].in_table = true; }
    reloc(sec, offset, rtype, s, 0, pcrel, 2, pcx);
}

// A relocation against symbol s plus `extra`: on ELF a temporary label
// becomes its section's symbol plus the label's offset.
fn reloc_to(sec: i64, offset: i64, rtype: i64, s: i64, extra: i64, pcrel: bool, length: i64,
    asm: &mut Asm<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        if get_elf() && asm.syms[s as usize].defined && is_temp(s, asm) {
            reloc(sec, offset, rtype, -1 - asm.syms[s as usize].sec,
                extra + sym_addr(s, asm), pcrel, length, pcx);
            return;
        }
        asm.syms[s as usize].in_table = true;
        reloc(sec, offset, rtype, s, extra, pcrel, length, pcx);
    }
}

// ---- Output helpers ----

fn w8(out: i64, v: i64) {
    buf_byte(out, (v & 255) as u8);
}

fn w16(out: i64, v: i64) {
    buf_w16(out, v);
}

// (0.25: the bytes with one check for room, not a call each: buf_w32)
fn w32(out: i64, v: i64) {
    buf_w32(out, v);
}

fn w64(out: i64, v: i64) {
    w32(out, v);
    w32(out, v >> 32);
}

// A name in a fixed 16-byte field.
fn wname16(out: i64, name: &[u8]) {
    for i in 0..16 {
        w8(out, if i < name.len() { name[i] as i64 } else { 0 });
    }
}

fn pad_to(out: i64, size: i64) {
    while buf_len(out) < size {
        buf_byte(out, 0);
    }
}

fn align_up(v: i64, a: i64) -> i64 {
    (v + a - 1) & (0 - a)
}

// Whether section `sec` holds DWARF.
pub fn is_debug(sec: i64) -> bool {
    sec >= SEC_DEBUG_ABBREV && sec <= SEC_DEBUG_LINE
}

// ---- The driver ----

// Assembles ASM into an object file at `path` (what asm_flush has not
// assembled yet).
pub fn write_object(cx: &mut FnCtx<Comp>, path: *mut u8, pcx: &mut Ctx<Comp>) {
    if !pcx.asm_stream {
        assembler_begin(&mut cx.assembler);
    }
    assemble_text(cx, pcx);
    if pcx.asm_stream {
        buf_clear(cx.asm);
    }
    let asm = &mut cx.assembler;
    new_frag(asm.cur_sec, asm);
    layout(asm);
    resolve_fixups(asm, pcx);
    build_sections(asm, pcx);
    if asm.rows.len() as i64 > 0 {
        line_program(asm, pcx);
    }
    if asm.cfi_fns.len() as i64 > 0 {
        compact_unwind(asm, pcx);
    }
    if get_elf() {
        asm.sec_align[SEC_NOTE as usize] = 0;
        elf_write(path, asm, pcx);
    } else {
        macho_write(path, asm, pcx);
    }
}

// The assembler's state before the first line.
fn assembler_begin(asm: &mut Asm<Comp>) {
    // (a new object: nothing of an earlier one)
    *asm = asm_new();
    asm.obj.reserve(65536);
    asm.mapping = get_elf() && !get_x86();
    asm.hooks = asm.mapping;
    asm.cur_sec = SEC_TEXT;
    asm.sec_used[SEC_TEXT as usize] = true;
    new_frag(SEC_TEXT, asm);
    assemble_begin(asm);
    if get_x86() {
        init_x86(asm);
    } else {
        init_a64(asm);
    }
}

// Assembles the lines in ASM.
fn assemble_text(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    // (the constant data's bytes are the assembler's while it runs: the
    // lock is held, so nothing is added to them meanwhile)
    let mut raw = pcx.obj_raw.lock().unwrap();
    std::mem::swap(&mut *raw, &mut cx.assembler.raw);
    assemble_bytes(&buf_copy(cx.asm), &mut cx.assembler);
    std::mem::swap(&mut *raw, &mut cx.assembler.raw);
}

// The position of the first newline of text at or after `from`, or
// text.len().
fn line_end(text: &[u8], from: usize) -> usize {
    let rest = &text[from..];
    // UNSAFE: C's memchr (0.17: the end of the line by memchr, not byte by
    // byte). The search written over the slice, a byte and a bounds check
    // at a time, cost 0.6 G instructions of an -O0 build's 4.7 G of "data
    // and output" (measured, 0.29).
    // SAFETY: rest has rest.len() readable bytes (a slice's); memchr reads
    // no further and returns null or a pointer to one of them, so the
    // difference from rest.ptr is below rest.len(), and from + it is below
    // text.len().
    let p = unsafe { memchr(rest.ptr, 10, rest.len() as u64) };
    if p == 0 as *mut u8 { text.len() } else { from + (p as usize - rest.ptr as usize) }
}

// (0.18.1) Assembles the lines of `text` (Asm.text while it runs: a copy,
// which the assembler's functions read by position).
pub fn assemble_bytes(text: &[u8], asm: &mut Asm<Comp>) {
    asm.text.clear();
    append_bytes(&mut asm.text, text);
    let n = text.len();
    let mut i: usize = 0;
    while i < n {
        let e = line_end(text, i);
        assemble_line(i as i64, e as i64, asm);
        i = e + 1;
    }
}

// From the first function on (after the file's header): see ASM_STREAM.
pub fn asm_stream_begin(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    if pcx.output_mode != OUT_ASM && !pcx.debug_info {
        pcx.asm_stream = true;
        assembler_begin(&mut cx.assembler);
    }
}

// Assembles the text written so far (whole lines: a function's), when
// streaming.
pub fn asm_flush(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    if pcx.asm_stream {
        // (its time is the output's, as when the text is assembled at
        // the end, not the code generation's that runs it)
        let t = timer_now(pcx);
        c_module_symbols(cx, pcx);
        assemble_text(cx, pcx);
        buf_clear(cx.asm);
        timer_sub(T_CODEGEN, T_OUTPUT, t, pcx);
    }
}

// (0.18.1) asm_flush on the assembler's thread (middle::threads): the text
// so far, copied, is handed to it.
pub fn asm_hand_over(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    // UNSAFE: the text goes to the assembler's thread as a malloc'd block
    // (asm_thread_push's queue holds a pointer and a length; the thread frees
    // it): a copy made with memcpy.
    // SAFETY: copy has n + 1 bytes (alloc_zeroed dies when out of memory);
    // buf_ptr(cx.asm) is the buffer's block of buf_len(cx.asm) = n bytes, and
    // no buffer call comes between taking the pointer and the copy; this
    // thread gives the copy away and does not touch it again.
    unsafe {
        if pcx.asm_stream {
            c_module_symbols(cx, pcx);
            let n = buf_len(cx.asm);
            let copy = alloc_zeroed(n + 1);
            memcpy(copy, buf_ptr(cx.asm), n as u64);
            asm_thread_push(copy, n, pcx);
            buf_clear(cx.asm);
        }
    }
}

// ---- Output ----

// UNSAFE: libc's system and unlink, which std does not wrap as the
// compiler uses them (a shell command line; a path as a C string), and
// memchr (line_end's search).
// SAFETY: the declarations are libc's (int system(const char *), int
// unlink(const char *), void *memchr(const void *, int, size_t)): the
// first two read their argument up to its NUL, memchr the bytes it is
// told, and none keeps a pointer; each call says why its arguments fit.
extern "C" {
    fn system(command: *mut u8) -> i32;
    fn unlink(path: *mut u8) -> i32;
    fn memchr(s: *mut u8, c: i32, n: u64) -> *mut u8;
}

// What the compiler writes: assembly (`-S`, `--emit-asm`, or an output
// named *.s), an object (`-c`, or *.o), or an executable linked by `cc`
// (any other output name).
pub const OUT_ASM: i64 = 0;
pub const OUT_OBJECT: i64 = 1;
pub const OUT_EXECUTABLE: i64 = 2;

// The output mode for `path` when no option chose one.
pub fn output_mode_of(path: *mut u8) -> i64 {
    let p = cstr(path);
    if p.ends_with(b".s") {
        return OUT_ASM;
    }
    if p.ends_with(b".o") {
        return OUT_OBJECT;
    }
    OUT_EXECUTABLE
}

// Writes the program (ASM) to `path` as the output mode says.
pub fn write_output(cx: &mut FnCtx<Comp>, path: *mut u8, pcx: &mut Ctx<Comp>) {
    c_module_symbols(cx, pcx);
    if pcx.output_mode == OUT_ASM {
        buf_write_file(cx.asm, path);
        return;
    }
    if pcx.output_mode == OUT_OBJECT {
        write_object(cx, path, pcx);
        return;
    }
    let obj = buf_new();
    buf_fmt(obj, format_args("{}.vole.o\0", str::from_utf8(&cstr(path)).unwrap()));
    let obj_path = buf_ptr(obj);
    write_object(cx, obj_path, pcx);
    // (0.25.3: the link's inputs first, its failure one error)
    check_link_inputs(pcx);
    build_linking(path, pcx);
    let mut status = link_program(path, obj_path, &mut cx.assembler, pcx) as i32;
    if status != 0 {
        remove_object(obj);
        link_failed(status as i64, path, pcx);
    }
    if status == 0 && pcx.debug_info && !get_elf() {
        // (-g) On macOS the debug information stays in the object, which
        // goes: dsymutil gathers it into <path>.dSYM first, as clang does.
        let dsym = buf_new();
        buf_fmt(dsym, format_args("dsymutil '{}'\0", str::from_utf8(&cstr(path)).unwrap()));
        // UNSAFE: C's system: std has no call that runs a shell command
        // line.
        // SAFETY: the command is buffer `dsym`'s bytes, which end in the
        // NUL the format above wrote; nothing is appended to the buffer
        // between the format and the call, and system keeps no pointer.
        status = unsafe { system(buf_ptr(dsym)) };
    }
    remove_object(obj);
    if status != 0 {
        die(c"dsymutil failed");
    }
}

// Removes the temporary object whose path (with its NUL) is buffer `obj`.
fn remove_object(obj: i64) {
    // UNSAFE: C's unlink, on the path the linker was given as a C string.
    // SAFETY: buffer `obj` holds the path and the NUL write_output's
    // format wrote after it, and is not written again; unlink reads up to
    // that NUL and keeps no pointer.
    unsafe { unlink(buf_ptr(obj)); }
}
