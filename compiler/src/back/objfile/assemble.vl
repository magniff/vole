// The assembler proper (objfile): each line of the text is a label, a
// directive or an instruction (encoded by enc_arm64.vl or enc_x86.vl),
// appended to the object being built (mod.vl) as bytes, symbols and
// fixups. Here: errors, scanning a line and its operands, numbers and
// data values, AArch64 ELF mapping symbols, and the directives.

use crate::back::enc_arm64::a64_instruction;
use crate::back::enc_x86::x86_instruction;
use crate::back::objfile::{
    get_asyms, get_asym_lookups, get_atext, get_cur_atom, set_cur_atom, get_cur_sec, get_fixups, get_fixup_count, get_frags, get_frag_count, FX_ABS32,
    FX_ABS64, FX_DIFF32, get_obj, set_obj, get_open, ObjBytes, get_raw, get_sec_align, set_sec_align, SEC_BSS, SEC_CONST, SEC_DATA,
    SEC_DEBUG_ABBREV, SEC_DEBUG_INFO, SEC_DEBUG_LINE, SEC_NOTE, SEC_TEXT, TAIL_ALIGN, asym,
    bytes_append, end_frag, fixup, hash_bytes, here, is_debug, is_temp, obj_reserve, out32, out64,
    out8, switch_section,
};
use crate::back::objfile::debug::{
    set_loc_col, set_loc_file, set_loc_line, get_loc_pending, set_loc_pending, cfi_directive, dwarf_file, line_row,
};
use crate::base::{IntVec, alloc_array, cstr, exit, free, grow, memcmp, memcpy, memset};
use crate::base::target::get_x86;
use crate::middle::ctx::FnCtx;

// ---- Errors ----

static mut LINE_START: i64 = 0;
static mut LINE_END: i64 = 0;

pub fn asm_error(cx: &mut FnCtx, message: *mut u8) -> ! {
    unsafe {
        let line = std::slice::from_raw_parts(get_atext().add((get_line_start()) as usize), (get_line_end() - (get_line_start())) as usize);
        // Not base's buffers: this runs on -O0's assembler thread (and on a
        // joining main thread at -O1+), where another thread may grow BUFS.
        // eprint writes straight to stderr under std's print lock.
        eprint("{}", { let line = str::from_utf8(line).unwrap(); format_args("internal error: cannot assemble: {}: {line}\n", str::from_utf8(cstr(message)).unwrap()) });
        exit(1)
    }
}

// ---- Lines ----

#[inline]
pub fn is_space(c: u8) -> bool {
    c == b' ' || c == b'\t'
}

// Whether bytes [a, b) of the text spell `word`.
// (0.17: compared byte by byte, stopping at the first difference, without
// strlen and memcmp: the assembler asks it of every directive and operand
// against many words, a tenth of -O0)
pub fn text_is(cx: &mut FnCtx, a: i64, b: i64, word: *mut u8) -> bool {
    unsafe {
        let t = get_atext();
        let n = b - a;
        for i in 0..n {
            let c = (*word.add(i as usize));
            if c == 0 || c != (*t.add((a + i) as usize)) {
                return false;
            }
        }
        (*word.add(n as usize)) == 0
    }
}

// The operands of the statement being assembled: [OP_START[i], OP_END[i])
// of the text, split at commas outside brackets and parentheses.
static mut OP_START: [i64; 8] = [0i64, 0, 0, 0, 0, 0, 0, 0];
static mut OP_END: [i64; 8] = [0i64, 0, 0, 0, 0, 0, 0, 0];
static mut OP_COUNT: i64 = 0;

// (0.25) Each byte's class for split_operands: 1 a comma, 2 an opening
// bracket or parenthesis, 3 a closing one, 0 any other (one test a byte).
static mut OP_CLASS: [u8; 256] = [0; 256];

fn split_operands(cx: &mut FnCtx, a: i64, b: i64) {
    unsafe {
        let t = get_atext();
        let mut count: i64 = 0;
        let mut i = a;
        while i < b {
            while i < b && is_space((*t.add(i as usize))) {
                i += 1;
            }
            if i >= b {
                break;
            }
            let start = i;
            let mut depth: i64 = 0;
            while i < b {
                let k = get_op_class()[(*t.add(i as usize)) as i64 as usize];
                if k != 0 {
                    if k == 1 {
                        if depth == 0 {
                            break;
                        }
                    } else if k == 2 {
                        depth += 1;
                    } else {
                        depth -= 1;
                    }
                }
                i += 1;
            }
            let mut end = i;
            while end > start && is_space((*t.add((end - 1) as usize))) {
                end -= 1;
            }
            if count == 8 {
                set_op_count(count);
                asm_error(cx, c"too many operands");
            }
            { let mut op_start_copy = get_op_start(); op_start_copy[count as usize] = start; set_op_start(op_start_copy); }
            { let mut op_end_copy = get_op_end(); op_end_copy[count as usize] = end; set_op_end(op_end_copy); }
            count += 1;
            i += 1;
        }
        set_op_count(count);
    }
}

// A number at [a, b): decimal or 0x hex, maybe negative.
pub fn parse_number(cx: &mut FnCtx, a: i64, b: i64) -> i64 {
    unsafe {
        let t = get_atext();
        let mut i = a;
        let mut neg = false;
        if i < b && (*t.add(i as usize)) == b'-' {
            neg = true;
            i += 1;
        }
        let mut v: u64 = 0;
        if i + 1 < b && (*t.add(i as usize)) == b'0' && ((*t.add((i + 1) as usize)) == b'x' || (*t.add((i + 1) as usize)) == b'X') {
            i += 2;
            while i < b {
                let c = (*t.add(i as usize));
                let d = if c >= b'0' && c <= b'9' { (c - b'0') as u64 }
                    else if c >= b'a' && c <= b'f' { (c - b'a') as u64 + 10 }
                    else if c >= b'A' && c <= b'F' { (c - b'A') as u64 + 10 }
                    else { asm_error(cx, c"bad number") };
                v = v * 16 + d;
                i += 1;
            }
        } else {
            if i >= b {
                asm_error(cx, c"bad number");
            }
            while i < b {
                let c = (*t.add(i as usize));
                if c < b'0' || c > b'9' {
                    asm_error(cx, c"bad number");
                }
                v = v * 10 + (c - b'0') as u64;
                i += 1;
            }
        }
        if neg { (v as i64).wrapping_neg() } else { v as i64 }
    }
}

pub fn is_digit_start(c: u8) -> bool {
    (c >= b'0' && c <= b'9') || c == b'-'
}

// A data value: a number, a symbol, or `A - B` (two labels).
fn data_value(cx: &mut FnCtx, a: i64, b: i64, size: i64) {
    unsafe {
        let t = get_atext();
        if is_digit_start((*t.add(a as usize))) {
            if size == 4 { out32(parse_number(cx, a, b)); }
            else { out64(parse_number(cx, a, b)); }
            return;
        }
        let mut minus = a;
        while minus < b && (*t.add(minus as usize)) != b'-' {
            minus += 1;
        }
        if minus < b {
            let mut e1 = minus;
            while e1 > a && is_space((*t.add((e1 - 1) as usize))) {
                e1 -= 1;
            }
            let mut s2 = minus + 1;
            while s2 < b && is_space((*t.add(s2 as usize))) {
                s2 += 1;
            }
            if size != 4 {
                asm_error(cx, c"a difference of labels must be a .long");
            }
            let s1 = asym(std::slice::from_raw_parts(t.add((a) as usize), (e1 - (a)) as usize));
            let s2sym = asym(std::slice::from_raw_parts(t.add((s2) as usize), (b - (s2)) as usize));
            fixup(FX_DIFF32, here(), s1, 0, 0, false);
            (*get_fixups().add((get_fixup_count() - 1) as usize)).sym2 = s2sym;
            out32(0);
            return;
        }
        if size == 4 {
            // (0.11) A 32-bit reference: the offset of a debug section (ELF).
            fixup(FX_ABS32, here(), asym(std::slice::from_raw_parts(t.add((a) as usize), (b - (a)) as usize)), 0, 0, false);
            out32(0);
            return;
        }
        fixup(FX_ABS64, here(), asym(std::slice::from_raw_parts(t.add((a) as usize), (b - (a)) as usize)), 0, 0, false);
        out64(0);
    }
}

// ---- AArch64 ELF mapping symbols ----
//
// The AArch64 ELF ABI marks where code ($x) and data ($d) start in a
// section, as GNU as does (disassemblers show data in code, such as jump
// tables, as data): (section, fragment, offset, kind) for each change.

// Whether the object has mapping symbols (AArch64 ELF).
static mut MAPPING: bool = false;
// Whether an instruction may need more than its encoding: mapping symbols
// or `.loc`s (one test on the common path).
static mut HOOKS: bool = false;
pub const MAP_CODE: i64 = 1;
const MAP_DATA: i64 = 2;
static mut MAP_STATE: [i64; 9] = [0i64; 9];
static mut MAPS: IntVec = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };

fn mapping(kind: i64) {
    unsafe {
        if get_map_state()[get_cur_sec() as usize] == kind || is_debug(get_cur_sec()) {
            return;
        }
        { let mut map_state_copy = get_map_state(); map_state_copy[get_cur_sec() as usize] = kind; set_map_state(map_state_copy); }
        { let mut maps_copy = get_maps(); maps_copy.push(get_cur_sec()); set_maps(maps_copy); }
        { let mut maps_copy = get_maps(); maps_copy.push(get_open()); set_maps(maps_copy); }
        { let mut maps_copy = get_maps(); maps_copy.push(here() - (*get_frags().add(get_open() as usize)).start); set_maps(maps_copy); }
        { let mut maps_copy = get_maps(); maps_copy.push(kind); set_maps(maps_copy); }
    }
}

fn directive(cx: &mut FnCtx, a: i64, b: i64, rest: i64, end: i64) {
    unsafe {
        let t = get_atext();
        if get_cur_sec() == SEC_BSS && !text_is(cx, a, b, c".space") && !text_is(cx, a, b, c".p2align")
            && !text_is(cx, a, b, c".globl") && !text_is(cx, a, b, c".section")
            && !text_is(cx, a, b, c".text") && !text_is(cx, a, b, c".data") {
            // (0.25.5) a zerofill section holds no bytes but zeros
            asm_error(cx, c"data in a zero-fill section (only .space)");
        }
        if text_is(cx, a, b, c".byte") {
            if get_mapping() {
                mapping(MAP_DATA);
            }
            let mut i = rest;
            while i < end {
                let mut v: i64 = 0;
                while i < end && (*t.add(i as usize)) >= b'0' && (*t.add(i as usize)) <= b'9' {
                    v = v * 10 + ((*t.add(i as usize)) - b'0') as i64;
                    i += 1;
                }
                out8(v);
                while i < end && ((*t.add(i as usize)) == b',' || is_space((*t.add(i as usize)))) {
                    i += 1;
                }
            }
            return;
        }
        if text_is(cx, a, b, c".vole_data") {
            // (0.25) bytes of RAW (mod.vl): `.vole_data OFFSET, LENGTH`
            if get_mapping() {
                mapping(MAP_DATA);
            }
            split_operands(cx, rest, end);
            if get_op_count() != 2 {
                asm_error(cx, c"bad .vole_data");
            }
            let at = parse_number(cx, get_op_start()[0], get_op_end()[0]);
            let n = parse_number(cx, get_op_start()[1], get_op_end()[1]);
            if at < 0 || n < 0 || at + n > get_raw().len {
                asm_error(cx, c"bad .vole_data");
            }
            obj_reserve(n);
            memcpy(get_obj().data.add(get_obj().len as usize), get_raw().data.add(at as usize), n as u64);
            { let mut obj_copy = get_obj(); obj_copy.len += n; set_obj(obj_copy); }
            return;
        }
        if text_is(cx, a, b, c".long") || text_is(cx, a, b, c".quad") {
            if get_mapping() {
                mapping(MAP_DATA);
            }
            split_operands(cx, rest, end);
            for k in 0..get_op_count() {
                data_value(cx, get_op_start()[k as usize], get_op_end()[k as usize], if (*t.add((b - 1) as usize)) == b'g' { 4 } else { 8 });
            }
            return;
        }
        if text_is(cx, a, b, c".p2align") {
            let n = parse_number(cx, rest, end);
            if n > get_sec_align()[get_cur_sec() as usize] {
                { let mut sec_align_copy = get_sec_align(); sec_align_copy[get_cur_sec() as usize] = n; set_sec_align(sec_align_copy); }
            }
            if n > 0 {
                end_frag(TAIL_ALIGN, n, -1);
            }
            return;
        }
        if text_is(cx, a, b, c".space") {
            if get_mapping() && get_cur_sec() != SEC_BSS {
                mapping(MAP_DATA);
            }
            let n = parse_number(cx, rest, end);
            obj_reserve(n);
            memset(get_obj().data.add(get_obj().len as usize), 0, n as u64);
            { let mut obj_copy = get_obj(); obj_copy.len += n; set_obj(obj_copy); }
            return;
        }
        if text_is(cx, a, b, c".globl") {
            let s = asym(std::slice::from_raw_parts(t.add((rest) as usize), (end - (rest)) as usize));
            (*get_asyms().add(s as usize)).global = true;
            return;
        }
        if text_is(cx, a, b, c".text") {
            switch_section(SEC_TEXT);
            return;
        }
        if text_is(cx, a, b, c".data") {
            switch_section(SEC_DATA);
            return;
        }
        if text_is(cx, a, b, c".section") {
            if text_is(cx, rest, end, c"__TEXT,__text") {
                switch_section(SEC_TEXT);
            }
            else if text_is(cx, rest, end, c"__TEXT,__const")
                || text_is(cx, rest, end, c".rodata") {
                switch_section(SEC_CONST);
            } else if text_is(cx, rest, end, c"__DATA,__data") {
                switch_section(SEC_DATA);
            } else if text_is(cx, rest, end, c"__DATA,__bss,zerofill")
                || text_is(cx, rest, end, c".bss,\"aw\",@nobits") {
                // (0.25.5) zero-initialized statics
                switch_section(SEC_BSS);
            } else if end - rest > 15 && text_is(cx, rest, rest + 15, c".note.GNU-stack") {
                switch_section(SEC_NOTE);
            }
            else if text_is(cx, rest, end, c"__DWARF,__debug_abbrev,regular,debug")
                || text_is(cx, rest, end, c".debug_abbrev,\"\",@progbits") {
                switch_section(SEC_DEBUG_ABBREV);
            }
            else if text_is(cx, rest, end, c"__DWARF,__debug_info,regular,debug")
                || text_is(cx, rest, end, c".debug_info,\"\",@progbits") {
                switch_section(SEC_DEBUG_INFO);
            }
            else if text_is(cx, rest, end, c"__DWARF,__debug_line,regular,debug")
                || text_is(cx, rest, end, c".debug_line,\"\",@progbits") {
                switch_section(SEC_DEBUG_LINE);
            } else {
                asm_error(cx, c"unknown section");
            }
            return;
        }
        // (0.19: the instruction sets the system assemblers need named,
        // mc_arm64/arch.vl; this one knows them all)
        if text_is(cx, a, b, c".arch_extension") || text_is(cx, a, b, c".arch") {
            return;
        }
        if text_is(cx, a, b, c".loc") {
            split_operands(cx, rest, end);
            // .loc file line column
            let mut fields: [i64; 3] = [0i64, 0, 0];
            let mut k: i64 = 0;
            let mut i = rest;
            while i < end && k < 3 {
                while i < end && is_space((*t.add(i as usize))) {
                    i += 1;
                }
                let start = i;
                while i < end && !is_space((*t.add(i as usize))) {
                    i += 1;
                }
                fields[k as usize] = parse_number(cx, start, i);
                k += 1;
            }
            set_loc_file(fields[0]);
            set_loc_line(fields[1]);
            set_loc_col(fields[2]);
            set_loc_pending(true);
            set_hooks(true);
            return;
        }
        if text_is(cx, a, b, c".file") {
            dwarf_file(cx, rest, end);
            return;
        }
        if end - rest >= 0 && b - a > 5 && text_is(cx, a, a + 5, c".cfi_") {
            cfi_directive(cx, a, b);
            return;
        }
        asm_error(cx, c"unknown directive");
    }
}

fn label(cx: &mut FnCtx, a: i64, b: i64) {
    unsafe {
        let s = asym(std::slice::from_raw_parts(get_atext().add((a) as usize), (b - (a)) as usize));
        if (*get_asyms().add(s as usize)).defined {
            asm_error(cx, c"label defined twice");
        }
        (*get_asyms().add(s as usize)).defined = true;
        (*get_asyms().add(s as usize)).frag = get_open();
        (*get_asyms().add(s as usize)).off = here() - (*get_frags().add(get_open() as usize)).start;
        (*get_asyms().add(s as usize)).sec = get_cur_sec();
        if !is_temp(s) {
            { let mut cur_atom_copy = get_cur_atom(); cur_atom_copy[get_cur_sec() as usize] = s; set_cur_atom(cur_atom_copy); }
        }
        (*get_asyms().add(s as usize)).atom = get_cur_atom()[get_cur_sec() as usize];
    }
}

// ---- Lines assembled before (0.25) ----
//
// An instruction that names no symbol (`ldr x0, [x29, #-24]`, `sub sp,
// sp, #16`) assembles to the same bytes wherever it is. Its bytes are kept
// by its text, and a line spelling it again is copied, not parsed and
// encoded: 87% of the lines of the compiler's -O0 code (fewer than 8000
// distinct ones), half of its -O2 code. An instruction is kept when its
// encoding asked for no symbol and made no fixup and no fragment.

#[derive(Clone, Copy)] struct Memo { hash: u64, text: i64, len: i64, code: i64, code2: i64, size: i64 }

static mut MEMOS: *mut Memo = 0 as *mut Memo;
static mut MEMO_COUNT: i64 = 0;
static mut MEMO_CAP: i64 = 0;
// Memo + 1 by hash (open addressing).
static mut MEMO_TABLE: *mut i64 = 0 as *mut i64;
static mut MEMO_SIZE: i64 = 0;
// The lines' text.
static mut MEMO_TEXT: ObjBytes = ObjBytes { data: 0 as *mut u8, len: 0, cap: 0 };
// The hash of the line memo_find was last asked.
static mut MEMO_HASH: u64 = 0;
// (bounds the memory a program of only distinct lines takes)
const MEMO_LIMIT: i64 = 1 << 20;

// The state before an object's first line: no line known, the bytes'
// classes for split_operands.
pub fn assemble_begin() {
    unsafe {
        { let mut op_class_copy = get_op_class(); op_class_copy[b',' as i64 as usize] = 1; set_op_class(op_class_copy); }
        { let mut op_class_copy = get_op_class(); op_class_copy[b'[' as i64 as usize] = 2; set_op_class(op_class_copy); }
        { let mut op_class_copy = get_op_class(); op_class_copy[b'(' as i64 as usize] = 2; set_op_class(op_class_copy); }
        { let mut op_class_copy = get_op_class(); op_class_copy[b'{' as i64 as usize] = 2; set_op_class(op_class_copy); }
        { let mut op_class_copy = get_op_class(); op_class_copy[b']' as i64 as usize] = 3; set_op_class(op_class_copy); }
        { let mut op_class_copy = get_op_class(); op_class_copy[b')' as i64 as usize] = 3; set_op_class(op_class_copy); }
        { let mut op_class_copy = get_op_class(); op_class_copy[b'}' as i64 as usize] = 3; set_op_class(op_class_copy); }
        free(get_memo_table() as *mut u8);
        set_memo_table(0 as *mut i64);
        set_memo_size(0);
        set_memo_count(0);
        { let mut memo_text_copy = get_memo_text(); memo_text_copy.len = 0; set_memo_text(memo_text_copy); }
    }
}

// The memo of line [a, b) of t, or -1 (MEMO_HASH: the line's hash).
fn memo_find(t: *mut u8, a: i64, b: i64) -> i64 {
    unsafe {
        let h = hash_bytes(t.add(a as usize), b - a);
        set_memo_hash(h);
        if get_memo_size() == 0 {
            return -1;
        }
        let n = b - a;
        let mask = (get_memo_size() - 1) as u64;
        let mut slot = h & mask;
        while (*get_memo_table().add(slot as usize)) != 0 {
            let m = (*get_memo_table().add(slot as usize)) - 1;
            if (*get_memos().add(m as usize)).hash == h && (*get_memos().add(m as usize)).len == n
                && memcmp(get_memo_text().data.add((*get_memos().add(m as usize)).text as usize), t.add(a as usize), n as u64) == 0 {
                return m;
            }
            slot = (slot + 1) & mask;
        }
        -1
    }
}

// Keeps line [a, b) of t (hash MEMO_HASH), assembled to OBJ's bytes from
// `start` on.
fn memo_add(t: *mut u8, a: i64, b: i64, start: i64) {
    unsafe {
        let size = get_obj().len - start;
        if size < 1 || size > 16 || get_memo_count() >= MEMO_LIMIT {
            return;
        }
        if (get_memo_count() + 1) * 2 > get_memo_size() {
            memo_rehash();
        }
        let mut code: [i64; 2] = [0i64, 0];
        for k in 0..size {
            code[(k / 8) as usize] = code[(k / 8) as usize] | ((*get_obj().data.add((start + k) as usize)) as i64) << (k % 8 * 8);
        }
        let text = { let mut memo_text_copy = get_memo_text(); let r_copy = bytes_append(&mut memo_text_copy, std::slice::from_raw_parts(t.add((a) as usize), (b - (a)) as usize)); set_memo_text(memo_text_copy); r_copy };
        set_memos({ let mut memo_cap_copy = get_memo_cap(); let r_copy = grow(get_memos(), get_memo_count(), &mut memo_cap_copy); set_memo_cap(memo_cap_copy); r_copy });
        (*get_memos().add(get_memo_count() as usize)) = Memo {
            hash: get_memo_hash(), text, len: b - a, code: code[0], code2: code[1], size,
        };
        let mask = (get_memo_size() - 1) as u64;
        let mut slot = get_memo_hash() & mask;
        while (*get_memo_table().add(slot as usize)) != 0 {
            slot = (slot + 1) & mask;
        }
        (*get_memo_table().add(slot as usize)) = get_memo_count() + 1;
        set_memo_count(get_memo_count() + (1));
    }
}

// MEMO_TABLE twice as large.
fn memo_rehash() {
    unsafe {
        let size: i64 = if get_memo_size() == 0 { 4096 } else { get_memo_size() * 2 };
        free(get_memo_table() as *mut u8);
        set_memo_table(alloc_array::<i64>(size));
        set_memo_size(size);
        let mask = (size - 1) as u64;
        for m in 0..get_memo_count() {
            let mut slot = (*get_memos().add(m as usize)).hash & mask;
            while (*get_memo_table().add(slot as usize)) != 0 {
                slot = (slot + 1) & mask;
            }
            (*get_memo_table().add(slot as usize)) = m + 1;
        }
    }
}

// Writes memo m's bytes.
fn memo_out(m: i64) {
    unsafe {
        let size = (*get_memos().add(m as usize)).size;
        if size == 4 {
            out32((*get_memos().add(m as usize)).code);
            return;
        }
        obj_reserve(size);
        for k in 0..size {
            let word = if k < 8 { (*get_memos().add(m as usize)).code } else { (*get_memos().add(m as usize)).code2 };
            (*get_obj().data.add((get_obj().len + k) as usize)) = ((word >> (k % 8 * 8)) & 255) as u8;
        }
        { let mut obj_copy = get_obj(); obj_copy.len += size; set_obj(obj_copy); }
    }
}

pub fn assemble_line(cx: &mut FnCtx, a: i64, b: i64) {
    unsafe {
        let t = get_atext();
        let mut i = a;
        while i < b && is_space((*t.add(i as usize))) {
            i += 1;
        }
        let mut e = b;
        while e > i && is_space((*t.add((e - 1) as usize))) {
            e -= 1;
        }
        if i >= e {
            return;
        }
        set_line_start(i);
        set_line_end(e);
        // (0.25) an instruction assembled before: its bytes
        let memo = (*t.add(i as usize)) != b'.' && (*t.add((e - 1) as usize)) != b':';
        if memo {
            let m = memo_find(t, i, e);
            if m >= 0 {
                if get_hooks() {
                    if get_loc_pending() {
                        line_row();
                    }
                    if get_mapping() {
                        mapping(MAP_CODE);
                    }
                }
                memo_out(m);
                return;
            }
        }
        let mut w = i;
        while w < e && !is_space((*t.add(w as usize))) {
            w += 1;
        }
        if w == e && (*t.add((e - 1) as usize)) == b':' {
            label(cx, i, e - 1);
            return;
        }
        let mut r = w;
        while r < e && is_space((*t.add(r as usize))) {
            r += 1;
        }
        if (*t.add(i as usize)) == b'.' {
            directive(cx, i, w, r, e);
            return;
        }
        split_operands(cx, r, e);
        if get_hooks() {
            // (a row of the line table, a mapping symbol)
            if get_loc_pending() {
                line_row();
            }
            if get_mapping() {
                mapping(MAP_CODE);
            }
        }
        let lookups = get_asym_lookups();
        let fixups = get_fixup_count();
        let frags = get_frag_count();
        let start = get_obj().len;
        if get_x86() {
            x86_instruction(cx, i, w);
        } else {
            a64_instruction(cx, i, w);
        }
        if memo && get_asym_lookups() == lookups && get_fixup_count() == fixups && get_frag_count() == frags {
            memo_add(t, i, e, start);
        }
    }
}

// (0.28.0) LINE_START's accessors: every use of it is one of them.
fn get_line_start() -> i64 {
    // UNSAFE: the assembler's state, a process-wide static mut that the
    // main thread and the assembler thread use in turn; Rust has no safe
    // access to a static mut
    // SAFETY: one thread at a time uses it: the main thread before
    // asm_thread_start (assembler_begin, from asm_stream_begin, runs before
    // it in compile_program) and after asm_thread_finish's pthread_join,
    // the assembler thread (asm_thread_main -> assemble_bytes) in between;
    // pthread_create and pthread_join order the hand-overs; no worker
    // reaches it, the -O0 main thread's code generation between start and
    // finish (gen_places_function, gen_atomic_function, asm_hand_over and
    // the loop around them) touches none of it, and at -O1+ there is no
    // assembler thread (only the main thread assembles, in join_task's
    // asm_flush); accessed through the accessor's raw pointer, no reference
    // kept
    unsafe { LINE_START }
}

fn set_line_start(v: i64) {
    // UNSAFE: the assembler's state, a process-wide static mut that the
    // main thread and the assembler thread use in turn; Rust has no safe
    // access to a static mut
    // SAFETY: one thread at a time uses it: the main thread before
    // asm_thread_start (assembler_begin, from asm_stream_begin, runs before
    // it in compile_program) and after asm_thread_finish's pthread_join,
    // the assembler thread (asm_thread_main -> assemble_bytes) in between;
    // pthread_create and pthread_join order the hand-overs; no worker
    // reaches it, the -O0 main thread's code generation between start and
    // finish (gen_places_function, gen_atomic_function, asm_hand_over and
    // the loop around them) touches none of it, and at -O1+ there is no
    // assembler thread (only the main thread assembles, in join_task's
    // asm_flush); accessed through the accessor's raw pointer, no reference
    // kept
    unsafe {
        LINE_START = v;
    }
}

