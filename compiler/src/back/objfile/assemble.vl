// The assembler proper (objfile): each line of the text is a label, a
// directive or an instruction (encoded by enc_arm64.vl or enc_x86.vl),
// appended to the object being built (mod.vl) as bytes, symbols and
// fixups. Here: errors, scanning a line and its operands, numbers and
// data values, AArch64 ELF mapping symbols, and the directives.

use crate::back::enc_arm64::a64_instruction;
use crate::back::enc_x86::x86_instruction;
use crate::back::objfile::{
    Asm, FX_ABS32, FX_ABS64, FX_DIFF32, SEC_BSS, SEC_CONST, SEC_DATA, SEC_DEBUG_ABBREV,
    SEC_DEBUG_INFO, SEC_DEBUG_LINE, SEC_NOTE, SEC_TEXT, TAIL_ALIGN, asym_text, end_frag, fixup,
    hash_bytes, here, is_debug, is_temp, out32, out64, out8, raw_out, switch_section,
};
use crate::back::objfile::debug::{cfi_directive, dwarf_file, line_row};
use crate::base::exit;
use crate::base::comp::Comp;
use crate::base::target::get_x86;

// ---- Errors ----

pub fn asm_error(message: &str, asm: &Asm<Comp>) -> ! {
    let line = &asm.text[asm.line_start as usize..asm.line_end as usize];
    // Not base's buffers: this runs on -O0's assembler thread (and on a
    // joining main thread at -O1+), where another thread may grow BUFS.
    // eprint writes straight to stderr under std's print lock.
    eprint("{}",
        { let line = str::from_utf8(line).unwrap();
            format_args("internal error: cannot assemble: {message}: {line}\n") });
    std::process::exit(1)
}

// ---- Lines ----

#[inline]
pub fn is_space(c: u8) -> bool {
    c == b' ' || c == b'\t'
}

// Whether bytes [a, b) of the text spell `word`.
pub fn text_is(a: i64, b: i64, word: &[u8], asm: &Asm<Comp>) -> bool {
    b - a == word.len() as i64 && &asm.text[a as usize..b as usize] == word
}

// A copy of bytes [a, b) of the text, a mnemonic, in `room`: its length.
// (The encoders hold the mnemonic while they write to the assembler, which
// owns the text.)
pub fn mnemonic_copy(a: i64, b: i64, room: &mut [u8; 32], asm: &Asm<Comp>) -> usize {
    let n = (b - a) as usize;
    if n > 32 {
        asm_error("unknown instruction", asm);
    }
    room[..n].copy_from_slice(&asm.text[a as usize..b as usize]);
    n
}

fn split_operands(a: i64, b: i64, asm: &mut Asm<Comp>) {
    unsafe {
        let mut count: i64 = 0;
        let mut i = a;
        while i < b {
            while i < b && is_space(asm.text[i as usize]) {
                i += 1;
            }
            if i >= b {
                break;
            }
            let start = i;
            let mut depth: i64 = 0;
            while i < b {
                let k = asm.op_class[asm.text[i as usize] as i64 as usize];
                if k != 0 {
                    if k == 1 {
                        if depth == 0 {
                            break;
                        }
                    } else if k == 2 {
                        depth += 1;
                    } else {
                        depth -= 1;
                    }
                }
                i += 1;
            }
            let mut end = i;
            while end > start && is_space(asm.text[(end - 1) as usize]) {
                end -= 1;
            }
            if count == 8 {
                asm.op_count = count;
                asm_error("too many operands", asm);
            }
            asm.op_start[count as usize] = start;
            asm.op_end[count as usize] = end;
            count += 1;
            i += 1;
        }
        asm.op_count = count;
    }
}

// A number at [a, b): decimal or 0x hex, maybe negative.
pub fn parse_number(a: i64, b: i64, asm: &mut Asm<Comp>) -> i64 {
    unsafe {
        let mut i = a;
        let mut neg = false;
        if i < b && asm.text[i as usize] == b'-' {
            neg = true;
            i += 1;
        }
        let mut v: u64 = 0;
        if i + 1 < b && asm.text[i as usize] == b'0'
            && (asm.text[(i + 1) as usize] == b'x' || asm.text[(i + 1) as usize] == b'X') {
            i += 2;
            while i < b {
                let c = asm.text[i as usize];
                let d = if c >= b'0' && c <= b'9' { (c - b'0') as u64 }
                    else if c >= b'a' && c <= b'f' { (c - b'a') as u64 + 10 }
                    else if c >= b'A' && c <= b'F' { (c - b'A') as u64 + 10 }
                    else { asm_error("bad number", asm) };
                v = v * 16 + d;
                i += 1;
            }
        } else {
            if i >= b {
                asm_error("bad number", asm);
            }
            while i < b {
                let c = asm.text[i as usize];
                if c < b'0' || c > b'9' {
                    asm_error("bad number", asm);
                }
                v = v * 10 + (c - b'0') as u64;
                i += 1;
            }
        }
        if neg { (v as i64).wrapping_neg() } else { v as i64 }
    }
}

pub fn is_digit_start(c: u8) -> bool {
    (c >= b'0' && c <= b'9') || c == b'-'
}

// A data value: a number, a symbol, or `A - B` (two labels).
fn data_value(a: i64, b: i64, size: i64, asm: &mut Asm<Comp>) {
    unsafe {
        if is_digit_start(asm.text[a as usize]) {
            if size == 4 { out32(parse_number(a, b, asm), asm); }
            else { out64(parse_number(a, b, asm), asm); }
            return;
        }
        let mut minus = a;
        while minus < b && asm.text[minus as usize] != b'-' {
            minus += 1;
        }
        if minus < b {
            let mut e1 = minus;
            while e1 > a && is_space(asm.text[(e1 - 1) as usize]) {
                e1 -= 1;
            }
            let mut s2 = minus + 1;
            while s2 < b && is_space(asm.text[s2 as usize]) {
                s2 += 1;
            }
            if size != 4 {
                asm_error("a difference of labels must be a .long", asm);
            }
            let s1 = asym_text(a, e1, asm);
            let s2sym = asym_text(s2, b, asm);
            fixup(FX_DIFF32, here(asm), s1, 0, 0, false, asm);
            let last = asm.fixups.len() - 1;
            asm.fixups[last].sym2 = s2sym;
            out32(0, asm);
            return;
        }
        if size == 4 {
            // (0.11) A 32-bit reference: the offset of a debug section (ELF).
            fixup(FX_ABS32, here(asm),
                asym_text(a, b, asm), 0,
                0, false, asm);
            out32(0, asm);
            return;
        }
        fixup(FX_ABS64, here(asm),
            asym_text(a, b, asm), 0, 0,
            false, asm);
        out64(0, asm);
    }
}

// ---- AArch64 ELF mapping symbols ----
//
// The AArch64 ELF ABI marks where code ($x) and data ($d) start in a
// section, as GNU as does (disassemblers show data in code, such as jump
// tables, as data): (section, fragment, offset, kind) for each change.

pub const MAP_CODE: i64 = 1;
const MAP_DATA: i64 = 2;

fn mapping(kind: i64, asm: &mut Asm<Comp>) {
    unsafe {
        if asm.map_state[asm.cur_sec as usize] == kind || is_debug(asm.cur_sec) {
            return;
        }
        asm.map_state[asm.cur_sec as usize] = kind;
        asm.maps.push(asm.cur_sec);
        asm.maps.push(asm.open);
        asm.maps.push(here(asm) - asm.frags[asm.open as usize].start);
        asm.maps.push(kind);
    }
}

fn directive(a: i64, b: i64, rest: i64, end: i64, asm: &mut Asm<Comp>) {
    unsafe {
        if asm.cur_sec == SEC_BSS && !text_is(a, b, b".space", asm)
            && !text_is(a, b, b".p2align", asm) && !text_is(a, b, b".globl", asm)
            && !text_is(a, b, b".section", asm)
            && !text_is(a, b, b".text", asm) && !text_is(a, b, b".data", asm) {
            // (0.25.5) a zerofill section holds no bytes but zeros
            asm_error("data in a zero-fill section (only .space)", asm);
        }
        if text_is(a, b, b".byte", asm) {
            if asm.mapping {
                mapping(MAP_DATA, asm);
            }
            let mut i = rest;
            while i < end {
                let mut v: i64 = 0;
                while i < end && asm.text[i as usize] >= b'0' && asm.text[i as usize] <= b'9' {
                    v = v * 10 + (asm.text[i as usize] - b'0') as i64;
                    i += 1;
                }
                out8(v, asm);
                while i < end && (asm.text[i as usize] == b',' || is_space(asm.text[i as usize])) {
                    i += 1;
                }
            }
            return;
        }
        if text_is(a, b, b".vole_data", asm) {
            // (0.25) bytes of RAW (mod.vl): `.vole_data OFFSET, LENGTH`
            if asm.mapping {
                mapping(MAP_DATA, asm);
            }
            split_operands(rest, end, asm);
            if asm.op_count != 2 {
                asm_error("bad .vole_data", asm);
            }
            let at = parse_number(asm.op_start[0], asm.op_end[0], asm);
            let n = parse_number(asm.op_start[1], asm.op_end[1], asm);
            if !raw_out(at, n, asm) {
                asm_error("bad .vole_data", asm);
            }
            return;
        }
        if text_is(a, b, b".long", asm) || text_is(a, b, b".quad", asm) {
            if asm.mapping {
                mapping(MAP_DATA, asm);
            }
            split_operands(rest, end, asm);
            for k in 0..asm.op_count {
                data_value(asm.op_start[k as usize], asm.op_end[k as usize],
                    if asm.text[(b - 1) as usize] == b'g' { 4 } else { 8 }, asm);
            }
            return;
        }
        if text_is(a, b, b".p2align", asm) {
            let n = parse_number(rest, end, asm);
            if n > asm.sec_align[asm.cur_sec as usize] {
                asm.sec_align[asm.cur_sec as usize] = n;
            }
            if n > 0 {
                end_frag(TAIL_ALIGN, n, -1, asm);
            }
            return;
        }
        if text_is(a, b, b".space", asm) {
            if asm.mapping && asm.cur_sec != SEC_BSS {
                mapping(MAP_DATA, asm);
            }
            let n = parse_number(rest, end, asm);
            if n < 0 {
                asm_error("bad .space", asm);
            }
            let len = asm.obj.len() + n as usize;
            asm.obj.resize(len, 0);
            return;
        }
        if text_is(a, b, b".globl", asm) {
            let s = asym_text(rest, end, asm);
            asm.syms[s as usize].global = true;
            return;
        }
        if text_is(a, b, b".text", asm) {
            switch_section(SEC_TEXT, asm);
            return;
        }
        if text_is(a, b, b".data", asm) {
            switch_section(SEC_DATA, asm);
            return;
        }
        if text_is(a, b, b".section", asm) {
            if text_is(rest, end, b"__TEXT,__text", asm) {
                switch_section(SEC_TEXT, asm);
            }
            else if text_is(rest, end, b"__TEXT,__const", asm)
                || text_is(rest, end, b".rodata", asm) {
                switch_section(SEC_CONST, asm);
            } else if text_is(rest, end, b"__DATA,__data", asm) {
                switch_section(SEC_DATA, asm);
            } else if text_is(rest, end, b"__DATA,__bss,zerofill", asm)
                || text_is(rest, end, b".bss,\"aw\",@nobits", asm) {
                // (0.25.5) zero-initialized statics
                switch_section(SEC_BSS, asm);
            } else if end - rest > 15 && text_is(rest, rest + 15, b".note.GNU-stack", asm) {
                switch_section(SEC_NOTE, asm);
            }
            else if text_is(rest, end, b"__DWARF,__debug_abbrev,regular,debug", asm)
                || text_is(rest, end, b".debug_abbrev,\"\",@progbits", asm) {
                switch_section(SEC_DEBUG_ABBREV, asm);
            }
            else if text_is(rest, end, b"__DWARF,__debug_info,regular,debug", asm)
                || text_is(rest, end, b".debug_info,\"\",@progbits", asm) {
                switch_section(SEC_DEBUG_INFO, asm);
            }
            else if text_is(rest, end, b"__DWARF,__debug_line,regular,debug", asm)
                || text_is(rest, end, b".debug_line,\"\",@progbits", asm) {
                switch_section(SEC_DEBUG_LINE, asm);
            } else {
                asm_error("unknown section", asm);
            }
            return;
        }
        // (0.19: the instruction sets the system assemblers need named,
        // mc_arm64/arch.vl; this one knows them all)
        if text_is(a, b, b".arch_extension", asm) || text_is(a, b, b".arch", asm) {
            return;
        }
        if text_is(a, b, b".loc", asm) {
            split_operands(rest, end, asm);
            // .loc file line column
            let mut fields: [i64; 3] = [0i64, 0, 0];
            let mut k: i64 = 0;
            let mut i = rest;
            while i < end && k < 3 {
                while i < end && is_space(asm.text[i as usize]) {
                    i += 1;
                }
                let start = i;
                while i < end && !is_space(asm.text[i as usize]) {
                    i += 1;
                }
                fields[k as usize] = parse_number(start, i, asm);
                k += 1;
            }
            asm.loc_file = fields[0];
            asm.loc_line = fields[1];
            asm.loc_col = fields[2];
            asm.loc_pending = true;
            asm.hooks = true;
            return;
        }
        if text_is(a, b, b".file", asm) {
            dwarf_file(rest, end, asm);
            return;
        }
        if end - rest >= 0 && b - a > 5 && text_is(a, a + 5, b".cfi_", asm) {
            cfi_directive(a, b, asm);
            return;
        }
        asm_error("unknown directive", asm);
    }
}

fn label(a: i64, b: i64, asm: &mut Asm<Comp>) {
    let s = asym_text(a, b, asm);
    if asm.syms[s as usize].defined {
        asm_error("label defined twice", asm);
    }
    let off = here(asm) - asm.frags[asm.open as usize].start;
    if !is_temp(s, asm) {
        asm.cur_atom[asm.cur_sec as usize] = s;
    }
    let y = &mut asm.syms[s as usize];
    y.defined = true;
    y.frag = asm.open;
    y.off = off;
    y.sec = asm.cur_sec;
    y.atom = asm.cur_atom[asm.cur_sec as usize];
}

// ---- Lines assembled before (0.25) ----
//
// An instruction that names no symbol (`ldr x0, [x29, #-24]`, `sub sp,
// sp, #16`) assembles to the same bytes wherever it is. Its bytes are kept
// by its text, and a line spelling it again is copied, not parsed and
// encoded: 87% of the lines of the compiler's -O0 code (fewer than 8000
// distinct ones), half of its -O2 code. An instruction is kept when its
// encoding asked for no symbol and made no fixup and no fragment.

#[derive(Clone, Copy)] pub struct Memo {
    pub hash: u64, pub text: i64, pub len: i64, pub code: i64, pub code2: i64, pub size: i64,
}

// (bounds the memory a program of only distinct lines takes)
const MEMO_LIMIT: i64 = 1 << 20;

// The state before an object's first line: no line known, the bytes'
// classes for split_operands.
pub fn assemble_begin(asm: &mut Asm<Comp>) {
    asm.op_class[b',' as usize] = 1;
    asm.op_class[b'[' as usize] = 2;
    asm.op_class[b'(' as usize] = 2;
    asm.op_class[b'{' as usize] = 2;
    asm.op_class[b']' as usize] = 3;
    asm.op_class[b')' as usize] = 3;
    asm.op_class[b'}' as usize] = 3;
    asm.memos.clear();
    asm.memo_table.clear();
    asm.memo_text.clear();
}

// The memo of line [a, b) of the text, or -1 (Asm.memo_hash: the line's
// hash).
fn memo_find(a: i64, b: i64, asm: &mut Asm<Comp>) -> i64 {
    let line = &asm.text[a as usize..b as usize];
    let h = hash_bytes(line);
    asm.memo_hash = h;
    if asm.memo_table.len() == 0 {
        return -1;
    }
    let mask = (asm.memo_table.len() - 1) as u64;
    let mut slot = h & mask;
    while asm.memo_table[slot as usize] != 0 {
        let m = asm.memo_table[slot as usize] - 1;
        let memo = &asm.memos[m as usize];
        if memo.hash == h && memo.len == b - a
            && &asm.memo_text[memo.text as usize..(memo.text + memo.len) as usize] == line {
            return m;
        }
        slot = (slot + 1) & mask;
    }
    -1
}

// Keeps line [a, b) of the text (hash Asm.memo_hash), assembled to the
// object's bytes from `start` on.
fn memo_add(a: i64, b: i64, start: i64, asm: &mut Asm<Comp>) {
    let size = asm.obj.len() as i64 - start;
    if size < 1 || size > 16 || asm.memos.len() as i64 >= MEMO_LIMIT {
        return;
    }
    if (asm.memos.len() + 1) * 2 > asm.memo_table.len() {
        memo_rehash(asm);
    }
    let mut code: [i64; 2] = [0i64, 0];
    for k in 0..size {
        code[(k / 8) as usize] = code[(k / 8) as usize]
            | (asm.obj[(start + k) as usize] as i64) << (k % 8 * 8);
    }
    let text = asm.memo_text.len() as i64;
    asm.memo_text.extend_from_slice(&asm.text[a as usize..b as usize]);
    asm.memos.push(Memo {
        hash: asm.memo_hash, text, len: b - a, code: code[0], code2: code[1], size,
    });
    let mask = (asm.memo_table.len() - 1) as u64;
    let mut slot = asm.memo_hash & mask;
    while asm.memo_table[slot as usize] != 0 {
        slot = (slot + 1) & mask;
    }
    asm.memo_table[slot as usize] = asm.memos.len() as i64;
}

// Asm.memo_table twice as large.
fn memo_rehash(asm: &mut Asm<Comp>) {
    let size: usize = if asm.memo_table.len() == 0 { 4096 } else { asm.memo_table.len() * 2 };
    asm.memo_table.clear();
    asm.memo_table.resize(size, 0);
    let mask = (size - 1) as u64;
    for m in 0..asm.memos.len() {
        let mut slot = asm.memos[m].hash & mask;
        while asm.memo_table[slot as usize] != 0 {
            slot = (slot + 1) & mask;
        }
        asm.memo_table[slot as usize] = m as i64 + 1;
    }
}

// Writes memo m's bytes.
fn memo_out(m: i64, asm: &mut Asm<Comp>) {
    let memo = asm.memos[m as usize];
    if memo.size == 4 {
        out32(memo.code, asm);
        return;
    }
    for k in 0..memo.size {
        let word = if k < 8 { memo.code } else { memo.code2 };
        asm.obj.push(((word >> (k % 8 * 8)) & 255) as u8);
    }
}

pub fn assemble_line(a: i64, b: i64, asm: &mut Asm<Comp>) {
    unsafe {
        let mut i = a;
        while i < b && is_space(asm.text[i as usize]) {
            i += 1;
        }
        let mut e = b;
        while e > i && is_space(asm.text[(e - 1) as usize]) {
            e -= 1;
        }
        if i >= e {
            return;
        }
        asm.line_start = i;
        asm.line_end = e;
        // (0.25) an instruction assembled before: its bytes
        let memo = asm.text[i as usize] != b'.' && asm.text[(e - 1) as usize] != b':';
        if memo {
            let m = memo_find(i, e, asm);
            if m >= 0 {
                if asm.hooks {
                    if asm.loc_pending {
                        line_row(asm);
                    }
                    if asm.mapping {
                        mapping(MAP_CODE, asm);
                    }
                }
                memo_out(m, asm);
                return;
            }
        }
        let mut w = i;
        while w < e && !is_space(asm.text[w as usize]) {
            w += 1;
        }
        if w == e && asm.text[(e - 1) as usize] == b':' {
            label(i, e - 1, asm);
            return;
        }
        let mut r = w;
        while r < e && is_space(asm.text[r as usize]) {
            r += 1;
        }
        if asm.text[i as usize] == b'.' {
            directive(i, w, r, e, asm);
            return;
        }
        split_operands(r, e, asm);
        if asm.hooks {
            // (a row of the line table, a mapping symbol)
            if asm.loc_pending {
                line_row(asm);
            }
            if asm.mapping {
                mapping(MAP_CODE, asm);
            }
        }
        let lookups = asm.lookups;
        let fixups = (asm.fixups.len() as i64);
        let frags = (asm.frags.len() as i64);
        let start = asm.obj.len() as i64;
        if get_x86() {
            x86_instruction(i, w, asm);
        } else {
            a64_instruction(i, w, asm);
        }
        if memo && asm.lookups == lookups && (asm.fixups.len() as i64) == fixups
            && (asm.frags.len() as i64) == frags {
            memo_add(i, e, start, asm);
        }
    }
}
