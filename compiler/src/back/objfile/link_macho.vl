    b"unlockpt", b"unsetenv", b"usleep", b"utimes", b"vsnprintf", b"wait", b"wait4", b"waitpid",
    b"wcslen", b"write"];
const LIBSYSTEM_COUNT: i64 = 406;

// Whether a symbol's name (with its underscore) is one of LIBSYSTEM's.
fn in_libsystem(name: &[u8]) -> bool {
    if name.len() == 0 || name[0] != b'_' {
        return false;
    }
    let bare = &name[1..];
    for i in 0..LIBSYSTEM_COUNT {
        if LIBSYSTEM[i as usize] == bare {
            return true;
        }
    }
    false
}

// ---- Bytes ----

fn get16(d: &[u8], at: i64) -> i64 {
    d[at as usize] as i64 | (d[(at + 1) as usize] as i64) << 8
}

fn get32(d: &[u8], at: i64) -> i64 {
    get16(d, at) | get16(d, at + 2) << 16
}

fn get64(d: &[u8], at: i64) -> i64 {
    get32(d, at) | get32(d, at + 4) << 32
}

fn put8(d: &mut [u8], at: i64, v: i64) {
    d[at as usize] = (v & 255) as u8;
}

fn put16(d: &mut [u8], at: i64, v: i64) {
    put8(d, at, v);
    put8(d, at + 1, v >> 8);
}

fn put32(d: &mut [u8], at: i64, v: i64) {
    put16(d, at, v);
    put16(d, at + 2, v >> 16);
}

fn put64(d: &mut [u8], at: i64, v: i64) {
    put32(d, at, v);
    put32(d, at + 4, v >> 32);
}

// Big-endian, for the code signature.
fn putbe32(d: &mut [u8], at: i64, v: i64) {
    put8(d, at, v >> 24);
    put8(d, at + 1, v >> 16);
    put8(d, at + 2, v >> 8);
    put8(d, at + 3, v);
}

fn putbe64(d: &mut [u8], at: i64, v: i64) {
    putbe32(d, at, v >> 32);
    putbe32(d, at + 4, v);
}

// The bytes of `name` at d[at] (a name in a 16-byte field, a string, a
// table: the field's other bytes stay as they are).
fn put_name(d: &mut [u8], at: i64, name: &[u8]) {
    d[at as usize..at as usize + name.len()].copy_from_slice(name);
}

// Whether the 16-byte field at d[at] holds name.
fn name_is(d: &[u8], at: i64, name: &[u8]) -> bool {
    for i in 0..16 {
        let c = if i < name.len() { name[i] } else { 0 };
        if d[at as usize + i] != c {
            return false;
        }
    }
    true
}

// ---- SHA-256 ----

const K256: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

fn rotr(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

// The 64-byte blocks of s from `at`, n of them, into state h (FIPS 180-4).
fn sha_blocks_portable(h: &mut [u32; 8], s: &[u8], at: i64, n: i64) {
    let mut w: [u32; 64] = [0; 64];
    for blk in 0..n {
        let base = at + 64 * blk;
        for i in 0..16 {
            let p = base + 4 * i;
            w[i as usize] = (s[p as usize] as u32) << 24 | (s[(p + 1) as usize] as u32) << 16
                | (s[(p + 2) as usize] as u32) << 8 | s[(p + 3) as usize] as u32;
        }
        for i in 16..64 {
            let s0 = rotr(w[(i - 15) as usize], 7) ^ rotr(w[(i - 15) as usize], 18)
                ^ (w[(i - 15) as usize] >> 3);
            let s1 = rotr(w[(i - 2) as usize], 17) ^ rotr(w[(i - 2) as usize], 19)
                ^ (w[(i - 2) as usize] >> 10);
            w[i as usize] = w[(i - 16) as usize] + s0 + w[(i - 7) as usize] + s1;
        }
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        let mut e = h[4];
        let mut f = h[5];
        let mut g = h[6];
        let mut hh = h[7];
        for i in 0..64 {
            let t1 = hh + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (!e & g)) + K256[
                i as usize]
                + w[i as usize];
            let t2 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }
        h[0] += a;
        h[1] += b;
        h[2] += c;
        h[3] += d;
        h[4] += e;
        h[5] += f;
        h[6] += g;
        h[7] += hh;
    }
}

// The same by the sha2 instructions.
fn sha_blocks_hw(h: &mut [u32; 8], s: &[u8], at: i64, n: i64) {
    let k = &K256[..];
    let mut abcd = vld1q_u32(&h[..], 0);
    let mut efgh = vld1q_u32(&h[..], 4);
    for blk in 0..n {
        let p = at + 64 * blk;
        let mut m0 = vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(s, p)));
        let mut m1 = vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(s, p + 16)));
        let mut m2 = vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(s, p + 32)));
        let mut m3 = vreinterpretq_u32_u8(vrev32q_u8(vld1q_u8(s, p + 48)));
        let abcd0 = abcd;
        let efgh0 = efgh;
        for g in 0..16 {
            let wk = vaddq_u32(m0, vld1q_u32(k, 4 * g));
            let a = abcd;
            abcd = vsha256hq_u32(abcd, efgh, wk);
            efgh = vsha256h2q_u32(efgh, a, wk);
            let next = if g < 12 { vsha256su1q_u32(vsha256su0q_u32(m0, m1), m2, m3) } else { m0 };
            m0 = m1;
            m1 = m2;
            m2 = m3;
            m3 = next;
        }
        abcd = vaddq_u32(abcd, abcd0);
        efgh = vaddq_u32(efgh, efgh0);
    }
    vst1q_u32(&mut h[..], 0, abcd);
    vst1q_u32(&mut h[..], 4, efgh);
}

fn sha_blocks(h: &mut [u32; 8], s: &[u8], at: i64, n: i64) {
    if detect("sha2") {
        sha_blocks_hw(h, s, at, n);
    } else {
        sha_blocks_portable(h, s, at, n);
    }
}

// SHA-256 of d.
fn sha256(d: &[u8]) -> [u8; 32] {
    let n = d.len() as i64;
    let mut h: [u32; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab,
        0x5be0cd19,
    ];
    let full = n / 64;
    sha_blocks(&mut h, d, 0, full);
    // The rest, then 0x80, zeros and the length in bits: one block or two.
    let mut tail: [u8; 128] = [0; 128];
    let rest = n - 64 * full;
    for i in 0..rest {
        tail[i as usize] = d[(64 * full + i) as usize];
    }
    tail[rest as usize] = 0x80;
    let blocks: i64 = if rest < 56 { 1 } else { 2 };
    let bits = n * 8;
    for i in 0..8 {
        tail[(64 * blocks - 1 - i) as usize] = ((bits >> (8 * i)) & 255) as u8;
    }
    sha_blocks(&mut h, &tail[..], 0, blocks);
    let mut out = [0u8; 32];
    for i in 0..8 {
        putbe32(&mut out[..], 4 * i, h[i as usize] as i64);
    }
    out
}

// ---- The object ----

// Section kinds: the object's three, the two the link adds, and (0.25.5)
// the object's zerofill __bss.
const K_TEXT: i64 = 0;
const K_CONST: i64 = 1;
const K_DATA: i64 = 2;
const K_STUBS: i64 = 3;
const K_GOT: i64 = 4;
const K_BSS: i64 = 5;

// Relocation types (ARM64_RELOC_*).
const R_UNSIGNED: i64 = 0;
const R_BRANCH26: i64 = 2;
const R_PAGE21: i64 = 3;
const R_PAGEOFF12: i64 = 4;
const R_GOT_PAGE21: i64 = 5;
const R_GOT_PAGEOFF12: i64 = 6;
const R_ADDEND: i64 = 10;

const BASE: i64 = 0x100000000;
const PAGE: i64 = 0x4000;

// The link: the object (OB, its bytes), its sections by kind, its symbols,
// and what the output adds (imports, stubs, GOT slots).
struct Link<'a, A: std::alloc::Allocator> {
    ob: &'a [u8],
    // per kind (6): in the object (offset, address, size, alignment as a
    // power of 2, relocations' offset and count), whether present; in
    // the output (address, file offset, section ordinal)
    in_off: [i64; 6],
    in_addr: [i64; 6],
    size: [i64; 6],
    align: [i64; 6],
    rel_off: [i64; 6],
    rel_n: [i64; 6],
    present: [bool; 6],
    addr: [i64; 6],
    file: [i64; 6],
    ord: [i64; 6],
    // the object's section ordinals (1..) by kind, -1 for none
    ord_kind: [i64; 16],
    symoff: i64,
    nsyms: i64,
    stroff: i64,
    // per symbol: its kind (-1: undefined), its import (-1), its GOT
    // slot (-1), its index in the output's symbol table (-1: none)
    sym_kind: Vec<i64, A>,
    sym_import: Vec<i64, A>,
    sym_got: Vec<i64, A>,
    sym_index: Vec<i64, A>,
    imports: Vec<i64, A>,
    // per import, its stub (-1: none)
    stub_of: Vec<i64, A>,
    stubs: Vec<i64, A>,
    got: Vec<i64, A>,
}

// The symbol's name: the bytes of the object's string table from the
// symbol's offset to the next NUL.
fn sym_name<'a>(l: &Link<'a, Comp>, s: i64) -> &'a [u8] {
    let rest = &l.ob[(l.stroff + get32(l.ob, l.symoff + 16 * s)) as usize..];
    match rest.iter().position(|c| *c == 0) {
        Some(n) => &rest[..n],
        None => rest,
    }
}

fn sym_value(l: &Link<'_, Comp>, s: i64) -> i64 {
    get64(l.ob, l.symoff + 16 * s + 8)
}

// A defined symbol's address in the output.
fn sym_addr(l: &Link<'_, Comp>, s: i64) -> i64 {
    let k = l.sym_kind[s as usize];
    l.addr[k as usize] + sym_value(l, s) - l.in_addr[k as usize]
}

// Reads the object's header, sections and symbols: whether it is one
// link_macho takes.
fn read_object(l: &mut Link<'_, Comp>, n: i64) -> bool {
    let d = l.ob;
    if n < 32 || get32(d, 0) != 0xfeedfacf || get32(d, 4) != 0x0100000c || get32(d, 12) != 1 {
        return false;
    }
    for i in 0..16 {
        l.ord_kind[i as usize] = -1;
    }
    let ncmds = get32(d, 16);
    let mut c: i64 = 32;
    let mut nsect: i64 = 0;
    for _ in 0..ncmds {
        let cmd = get32(d, c);
        let size = get32(d, c + 4);
        if cmd == 0x19 {
            let ns = get32(d, c + 64);
            for i in 0..ns {
                let s = c + 72 + 80 * i;
                let mut k: i64 = -1;
                if name_is(d, s, b"__text") && name_is(d, s + 16, b"__TEXT") {
                    k = K_TEXT;
                } else if name_is(d, s, b"__const") && name_is(d, s + 16, b"__TEXT") {
                    k = K_CONST;
                } else if name_is(d, s, b"__data") && name_is(d, s + 16, b"__DATA") {
                    k = K_DATA;
                } else if name_is(d, s, b"__bss") && name_is(d, s + 16, b"__DATA")
                    && (get32(d, s + 64) & 0xff) == 1 && get32(d, s + 60) == 0 {
                    // (0.25.5) zerofill: no bytes in the file, no
                    // relocations
                    k = K_BSS;
                }
                if k < 0 || l.present[k as usize] || nsect >= 15 {
                    return false;
                }
                nsect += 1;
                l.ord_kind[nsect as usize] = k;
                l.present[k as usize] = true;
                l.in_addr[k as usize] = get64(d, s + 32);
                l.size[k as usize] = get64(d, s + 40);
                l.in_off[k as usize] = get32(d, s + 48);
                l.align[k as usize] = get32(d, s + 52);
                l.rel_off[k as usize] = get32(d, s + 56);
                l.rel_n[k as usize] = get32(d, s + 60);
                if (k != K_BSS && l.in_off[k as usize] + l.size[k as usize] > n)
                    || l.rel_off[k as usize] + 8 * l.rel_n[k as usize] > n {
                    return false;
                }
            }
        } else if cmd == 2 {
            l.symoff = get32(d, c + 8);
            l.nsyms = get32(d, c + 12);
            l.stroff = get32(d, c + 16);
            if l.symoff + 16 * l.nsyms > n || l.stroff + get32(d, c + 20) > n {
                return false;
            }
        } else if cmd != 0x32 && cmd != 0xb {
            return false;
        }
        c += size;
    }
    if !l.present[K_TEXT as usize] || l.rel_n[K_CONST as usize] > 0 {
        return false;
    }
    l.sym_kind.resize((l.nsyms + 1) as usize, 0);
    l.sym_import.resize((l.nsyms + 1) as usize, 0);
    l.sym_got.resize((l.nsyms + 1) as usize, 0);
    l.sym_index.resize((l.nsyms + 1) as usize, 0);
    for s in 0..l.nsyms {
        let e = l.symoff + 16 * s;
        let ty = d[(e + 4) as usize] as i64;
        l.sym_import[s as usize] = -1;
        l.sym_got[s as usize] = -1;
        l.sym_index[s as usize] = -1;
        if (ty & 0xe0) != 0 {
            // a debugging symbol
            return false;
        }
        if (ty & 0x0e) == 0x0e {
            let sect = d[(e + 5) as usize] as i64;
            if sect < 1 || sect > 15 || l.ord_kind[sect as usize] < 0 {
                return false;
            }
            l.sym_kind[s as usize] = l.ord_kind[sect as usize];
        } else if (ty & 0x0e) == 0 && (ty & 1) == 1 {
            l.sym_kind[s as usize] = -1;
        } else {
            return false;
        }
    }
    true
}

// Symbol s's import (made when first asked for), or -1: not one libSystem
// has.
fn import_of(l: &mut Link<'_, Comp>, s: i64) -> i64 {
    if l.sym_import[s as usize] >= 0 {
        return l.sym_import[s as usize];
    }
    if !in_libsystem(sym_name(l, s)) {
        return -1;
    }
    l.sym_import[s as usize] = l.imports.len() as i64;
    l.imports.push(s);
    l.sym_import[s as usize]
}

// Symbol s's GOT slot (made when first asked for).
fn got_of(l: &mut Link<'_, Comp>, s: i64) -> i64 {
    if l.sym_got[s as usize] < 0 {
        l.sym_got[s as usize] = l.got.len() as i64;
        l.got.push(s);
    }
    l.sym_got[s as usize]
}

// The relocations, a first time: what they need (imports, stubs, GOT
// slots), and whether link_macho takes them all.
fn scan_relocations(l: &mut Link<'_, Comp>) -> bool {
    let d = l.ob;
    for k in 0..3 {
        if !l.present[k as usize] {
            continue;
        }
        for r in 0..l.rel_n[k as usize] {
            let at = l.rel_off[k as usize] + 8 * r;
            let addr = get32(d, at);
            let info = get32(d, at + 4);
            let sym = info & 0xffffff;
            let length = (info >> 25) & 3;
            let ext = (info >> 27) & 1;
            let ty = (info >> 28) & 15;
            if (addr & 0x80000000) != 0 || addr >= l.size[k as usize] {
                return false;
            }
            if ty == R_ADDEND && k == K_TEXT {
                continue;
            }
            if k == K_DATA {
                if ty != R_UNSIGNED || length != 3
                    || ((l.in_addr[k as usize] + addr) & 7) != 0 {
                    return false;
                }
                if ext == 1 {
                    if sym >= l.nsyms {
                        return false;
                    }
                    if l.sym_kind[sym as usize] < 0 && import_of(l, sym) < 0 {
                        return false;
                    }
                } else if sym < 1 || sym > 15 || l.ord_kind[sym as usize] < 0 {
                    return false;
                }
                continue;
            }
            if ext != 1 || sym >= l.nsyms || length != 2 {
                return false;
            }
            let undefined = l.sym_kind[sym as usize] < 0;
            if ty == R_BRANCH26 {
                if undefined {
                    let i = import_of(l, sym);
                    if i < 0 {
                        return false;
                    }
                    // (a stub per import called, in the order of the
                    // first call)
                    while l.stub_of.len() as i64 <= i {
                        l.stub_of.push(-1);
                    }
                    if (l.stub_of[i as usize]) < 0 {
                        (l.stub_of[i as usize]) = l.stubs.len() as i64;
                        l.stubs.push(sym);
                    }
                }
            } else if ty == R_GOT_PAGE21 || ty == R_GOT_PAGEOFF12 {
                if undefined && import_of(l, sym) < 0 {
                    return false;
                }
            } else if ty == R_PAGE21 || ty == R_PAGEOFF12 {
                if undefined {
                    return false;
                }
            } else {
                return false;
            }
        }
    }
    // The GOT: the stubs' slots first, in the stubs' order, then those
    // GOT_LOAD reaches.
    for i in 0..l.stubs.len() as i64 {
        got_of(l, (l.stubs[i as usize]));
    }
    for r in 0..l.rel_n[K_TEXT as usize] {
        let at = l.rel_off[K_TEXT as usize] + 8 * r;
        let info = get32(d, at + 4);
        let ty = (info >> 28) & 15;
        if ty == R_GOT_PAGE21 || ty == R_GOT_PAGEOFF12 {
            got_of(l, info & 0xffffff);
        }
    }
    true
}

// An instruction's new immediate for a relocation of type ty to target
// from pc, or -1 when it does not fit (the link goes to ld).
fn patch(insn: i64, ty: i64, pc: i64, target: i64) -> i64 {
    if ty == R_BRANCH26 {
        let delta = target - pc;
        if (delta & 3) != 0 || delta >= (1 << 27) || delta < 0 - (1 << 27) {
            return -1;
        }
        return (insn & 0xfc000000) | ((delta >> 2) & 0x3ffffff);
    }
    if ty == R_PAGE21 || ty == R_GOT_PAGE21 {
        let delta = (target >> 12) - (pc >> 12);
        if delta >= (1 << 20) || delta < 0 - (1 << 20) {
            return -1;
        }
        return (insn & 0x9f00001f) | ((delta & 3) << 29) | (((delta >> 2) & 0x7ffff) << 5);
    }
    // PAGEOFF12: an add (unscaled) or a load or store (scaled by its size).
    let lo = target & 0xfff;
    let mut scale: i64 = 0;
    if (insn & 0x3b000000) == 0x39000000 {
        scale = (insn >> 30) & 3;
        if (insn & 0x04800000) == 0x04800000 && scale == 0 {
            scale = 4;
        }
    } else if (insn & 0x1f800000) != 0x11000000 {
        return -1;
    }
    if (lo & ((1 << scale) - 1)) != 0 {
        return -1;
    }
    (insn & 0xffc003ff) | ((lo >> scale) << 10)
}

// The fixups of a segment: per 8-byte slot of its first `slots`, 0 (none),
// 1 + the value (a rebase's target or a bind) in VALUE.
struct Fixups<A: std::alloc::Allocator> { kind: Vec<u8, A>, value: Vec<i64, A> }

fn fixups_new(size: i64) -> Fixups<Comp> {
    let slots = (size / 8 + 1) as usize;
    let mut f = Fixups { kind: Vec::new_in(Comp {}), value: Vec::new_in(Comp {}) };
    f.kind.resize(slots, 0);
    f.value.resize(slots, 0);
    f
}

// A rebase to target, or a bind to import i with addend a.
fn rebase(f: &mut Fixups<Comp>, offset: i64, target: i64) {
    f.kind[(offset / 8) as usize] = 1;
    f.value[(offset / 8) as usize] = target & 0xfffffffff;
}

fn bind(f: &mut Fixups<Comp>, offset: i64, i: i64, a: i64) {
    f.kind[(offset / 8) as usize] = 2;
    f.value[(offset / 8) as usize] = i | a << 24 | 1 << 63;
}

// Writes the segment's fixups (at file offset `file` of out) as chains,
// and its dyld_chained_starts_in_segment into out at `at` (segment_offset
// `vmoff`, `pages` pages): the bytes it took.
fn write_chains(f: &Fixups<Comp>, out: &mut [u8], file: i64, at: i64, vmoff: i64, pages: i64) -> i64 {
    let size = 22 + 2 * pages;
    put32(out, at, size);
    put16(out, at + 4, PAGE);
    put16(out, at + 6, 2);
    put64(out, at + 8, vmoff);
    put32(out, at + 16, 0);
    put16(out, at + 20, pages);
    for p in 0..pages {
        put16(out, at + 22 + 2 * p, 0xffff);
    }
    let mut prev: i64 = -1;
    for s in 0..f.kind.len() as i64 {
        if f.kind[s as usize] == 0 {
            continue;
        }
        let off = 8 * s;
        put64(out, file + off, f.value[s as usize]);
        if prev >= 0 && prev / PAGE == off / PAGE {
            let word = get64(&out[..], file + prev) | ((off - prev) / 4) << 51;
            put64(out, file + prev, word);
        } else {
            put16(out, at + 22 + 2 * (off / PAGE), off % PAGE);
        }
        prev = off;
    }
    size
}

// Whether a symbol goes to the output's symbol table as a local: not an
// assembler temporary (L...) nor a section's marker (ltmpN).
fn keep_local(name: &[u8]) -> bool {
    !(name.starts_with(b"L") || name.starts_with(b"ltmp"))
}

// The file name in path (the signature's identifier).
fn base_name(path: &[u8]) -> &[u8] {
    match path.iter().rposition(|c| *c == b'/') {
        Some(at) => &path[at + 1..],
        None => path,
    }
}

fn uleb_len(v: i64) -> i64 {
    let mut n: i64 = 1;
    let mut x = v >> 7;
    while x != 0 {
        n += 1;
        x = x >> 7;
    }
    n
}

// Links the object at obj_path into the executable path: whether it did
// (false: link_macho does not take this program, or could not write it;
// the system's linker links).
pub fn link_macho(path: *mut u8, obj_path: *mut u8) -> bool {
    if get_elf() || get_x86() {
        return false;
    }
    let ob = buf_new();
    if !read_into(obj_path, ob) {
        return false;
    }
    // (the object's bytes, whole: buffer `ob` is not written again)
    let mut l = Link {
        ob: crate::base::buf_done(ob),
        in_off: [0i64; 6], in_addr: [0i64; 6], size: [0i64; 6], align: [0i64; 6],
        rel_off: [0i64; 6],
        rel_n: [0i64; 6], present: [false; 6], addr: [0i64; 6], file: [0i64; 6], ord: [0i64; 6],
        ord_kind: [0i64; 16], symoff: 0, nsyms: 0, stroff: 0,
        sym_kind: Vec::new_in(Comp {}), sym_import: Vec::new_in(Comp {}),
        sym_got: Vec::new_in(Comp {}), sym_index: Vec::new_in(Comp {}),
        imports: Vec::new_in(Comp {}), stub_of: Vec::new_in(Comp {}),
        stubs: Vec::new_in(Comp {}), got: Vec::new_in(Comp {}),
    };
    if !read_object(&mut l, buf_len(ob)) || !scan_relocations(&mut l) {
        return false;
    }
    let mut main_sym: i64 = -1;
    for s in 0..l.nsyms {
        if l.sym_kind[s as usize] == K_TEXT && sym_name(&l, s) == b"_main" {
            main_sym = s;
        }
    }
    if main_sym < 0 {
        return false;
    }
    let nstubs = l.stubs.len() as i64;
    let ngot = l.got.len() as i64;
    l.present[K_STUBS as usize] = nstubs > 0;
    l.size[K_STUBS as usize] = 12 * nstubs;
    l.align[K_STUBS as usize] = 2;
    l.present[K_GOT as usize] = ngot > 0;
    l.size[K_GOT as usize] = 8 * ngot;
    l.align[K_GOT as usize] = 3;
    if l.present[K_CONST as usize] && l.size[K_CONST as usize] == 0 {
        l.present[K_CONST as usize] = false;
    }
    let has_data = l.present[K_DATA as usize] && l.size[K_DATA as usize] > 0;
    l.present[K_DATA as usize] = has_data;
    let has_bss = l.present[K_BSS as usize] && l.size[K_BSS as usize] > 0;
    l.present[K_BSS as usize] = has_bss;
    // (0.25.5) the __DATA segment: __data, then the zerofill __bss
    let ndata: i64 = (if has_data { 1 } else { 0 }) + (if has_bss { 1 } else { 0 });

    // ---- The layout ----
    let order = [K_TEXT, K_STUBS, K_CONST, K_GOT, K_DATA, K_BSS];
    let mut nsect: i64 = 0;
    let mut ntext: i64 = 0;
    for i in 0..6 {
        let k = order[i as usize];
        if l.present[k as usize] {
            nsect += 1;
            l.ord[k as usize] = nsect;
            if i < 3 {
                ntext += 1;
            }
        }
    }
    let ident = base_name(crate::base::c_kept(path));
    let ident_len = ident.len() as i64 + 1;
    // load commands: __PAGEZERO, __TEXT, __DATA_CONST, __DATA,
    // __LINKEDIT, then the others (16 chained fixups, 16 exports trie,
    // 24 symtab, 80 dysymtab, 32 dylinker, 24 uuid, 32 build version,
    // 16 source version, 24 main, 56 libSystem, 16 code signature)
    let mut nseg: i64 = 3;
    let mut cmds = 72 + 72 + 80 * ntext + 72;
    if l.present[K_GOT as usize] {
        nseg += 1;
        cmds += 72 + 80;
    }
    if ndata > 0 {
        nseg += 1;
        cmds += 72 + 80 * ndata;
    }
    let ncmds = nseg + 11;
    cmds += 16 + 16 + 24 + 80 + 32 + 24 + 32 + 16 + 24 + 56 + 16;
    let mut at = 32 + cmds;
    for i in 0..3 {
        let k = order[i as usize];
        if l.present[k as usize] {
            at = align_up(at, 1 << l.align[k as usize]);
            l.file[k as usize] = at;
            l.addr[k as usize] = BASE + at;
            at += l.size[k as usize];
        }
    }
    let text_size = align_up(at, PAGE);
    let mut seg = text_size;
    let mut dc_off: i64 = 0;
    let mut dc_size: i64 = 0;
    if l.present[K_GOT as usize] {
        dc_off = seg;
        l.file[K_GOT as usize] = seg;
        l.addr[K_GOT as usize] = BASE + seg;
        dc_size = align_up(l.size[K_GOT as usize], PAGE);
        seg += dc_size;
    }
    // (the __DATA segment: da_size in memory, da_file of it in the
    // file; __bss only in memory, so __LINKEDIT's address, le_vm, is
    // past its file offset, le_off, by the zerofill pages)
    let mut da_off: i64 = 0;
    let mut da_size: i64 = 0;
    let mut da_file: i64 = 0;
    if ndata > 0 {
        da_off = seg;
        let mut used: i64 = 0;
        if has_data {
            l.file[K_DATA as usize] = seg;
            l.addr[K_DATA as usize] = BASE + seg;
            used = l.size[K_DATA as usize];
            da_file = align_up(used, PAGE);
        }
        if has_bss {
            used = align_up(used, 1 << l.align[K_BSS as usize]);
            l.file[K_BSS as usize] = 0;
            l.addr[K_BSS as usize] = BASE + seg + used;
            used += l.size[K_BSS as usize];
        }
        da_size = align_up(used, PAGE);
    }
    let le_off = seg + da_file;
    let le_vm = seg + da_size;

    // ---- __LINKEDIT, but the signature ----
    // The symbols: locals, the defined globals (with
    // __mh_execute_header), the imports.
    let mut nlocal: i64 = 0;
    let mut next: i64 = 0;
    let strs = buf_new();
    crate::base::buf_byte(strs, b' ');
    crate::base::buf_byte(strs, 0);
    let mut syms: Vec<i64, Comp> = Vec::new_in(Comp {});
    for pass in 0..2 {
        for s in 0..l.nsyms {
            let k = l.sym_kind[s as usize];
            if k < 0 {
                continue;
            }
            let ext = (l.ob[(l.symoff + 16 * s + 4) as usize] & 1) == 1;
            if (pass == 0 && !ext && keep_local(sym_name(&l, s))) || (pass == 1 && ext) {
                l.sym_index[s as usize] = syms.len() as i64;
                syms.push(s);
                if pass == 0 {
                    nlocal += 1;
                } else {
                    next += 1;
                }
            }
        }
        if pass == 1 {
            syms.push(-1);
            next += 1;
        }
    }
    for i in 0..l.imports.len() as i64 {
        let s = (l.imports[i as usize]);
        l.sym_index[s as usize] = syms.len() as i64;
        syms.push(s);
    }
    let nundef = l.imports.len() as i64;
    let lk = buf_new();
    // the chained fixups: header, starts in image, starts in the two
    // segments, imports, their names
    let fx_size_guess = 64 + 4 * nseg + 2 * (22 + 2 * (dc_size + da_file) / PAGE) + 4 * nundef;
    let mut names_size: i64 = 0;
    for i in 0..l.imports.len() as i64 {
        names_size += sym_name(&l, l.imports[i as usize]).len() as i64 + 1;
    }
    let fx_cap = align_up(fx_size_guess + names_size + 64, 8);
    let symtab_off = align_up(fx_cap + 32, 8);
    let indirect_off = symtab_off + 16 * syms.len() as i64;
    let nindirect = nstubs + ngot;
    let strtab_off = indirect_off + 4 * nindirect;
    // the strings
    let mut strx: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..syms.len() as i64 {
        let s = (syms[i as usize]);
        strx.push(buf_len(strs));
        crate::base::buf_bytes(strs,
            if s < 0 { b"__mh_execute_header" } else { sym_name(&l, s) });
        crate::base::buf_byte(strs, 0);
    }
    while buf_len(strs) % 8 != 0 {
        crate::base::buf_byte(strs, 0);
    }
    let strtab_size = buf_len(strs);
    let sig_off_rel = align_up(strtab_off + strtab_size, 16);
    let code_limit = le_off + sig_off_rel;
    let pages = (code_limit + 4095) / 4096;
    let cd_size = 88 + ident_len + 32 * pages;
    let sig_size = align_up(20 + cd_size, 16);
    let le_size = sig_off_rel + sig_size;
    let total = le_off + le_size;
    let mut image: Vec<u8, Comp> = Vec::new_in(Comp {});
    image.resize(total as usize, 0);
    let out = &mut image[..];

    // ---- The header and load commands ----
    put32(out, 0, 0xfeedfacf);
    put32(out, 4, 0x0100000c);
    put32(out, 8, 0);
    put32(out, 12, 2);
    put32(out, 16, ncmds);
    put32(out, 20, cmds);
    put32(out, 24, 0x00200085);
    let mut c: i64 = 32;
    // __PAGEZERO
    put32(out, c, 0x19);
    put32(out, c + 4, 72);
    put_name(out, c + 8, b"__PAGEZERO");
    put64(out, c + 32, BASE);
    c += 72;
    // __TEXT
    put32(out, c, 0x19);
    put32(out, c + 4, 72 + 80 * ntext);
    put_name(out, c + 8, b"__TEXT");
    put64(out, c + 24, BASE);
    put64(out, c + 32, text_size);
    put64(out, c + 40, 0);
    put64(out, c + 48, text_size);
    put32(out, c + 56, 5);
    put32(out, c + 60, 5);
    put32(out, c + 64, ntext);
    c += 72;
    for i in 0..6 {
        let k = order[i as usize];
        if !l.present[k as usize] {
            continue;
        }
        if i == 3 || i == 4 || (i == 5 && !has_data) {
            // the segment of __got, or of __data and __bss
            let off = if i == 3 { dc_off } else { da_off };
            let size = if i == 3 { dc_size } else { da_size };
            let filesize = if i == 3 { dc_size } else { da_file };
            let n: i64 = if i == 3 { 1 } else { ndata };
            put32(out, c, 0x19);
            put32(out, c + 4, 72 + 80 * n);
            put_name(out, c + 8, if i == 3 { b"__DATA_CONST" } else { b"__DATA" });
            put64(out, c + 24, BASE + off);
            put64(out, c + 32, size);
            // (no bytes in the file, no offset there: as ld writes it)
            put64(out, c + 40, if filesize == 0 { 0 } else { off });
            put64(out, c + 48, filesize);
            put32(out, c + 56, 3);
            put32(out, c + 60, 3);
            put32(out, c + 64, n);
            put32(out, c + 68, if i == 3 { 0x10 } else { 0 });
            c += 72;
        }
        put_name(out, c,
            if k == K_TEXT { b"__text" } else if k == K_STUBS { b"__stubs" }
            else if k == K_CONST { b"__const" } else if k == K_GOT { b"__got" }
            else if k == K_BSS { b"__bss" } else { b"__data" });
        put_name(out, c + 16,
            if i < 3 { b"__TEXT" } else if i == 3 { b"__DATA_CONST" } else { b"__DATA" });
        put64(out, c + 32, l.addr[k as usize]);
        put64(out, c + 40, l.size[k as usize]);
        put32(out, c + 48, l.file[k as usize]);
        put32(out, c + 52, l.align[k as usize]);
        put32(out, c + 64,
            if k == K_TEXT { 0x80000400 } else if k == K_STUBS { 0x80000408 }
            else if k == K_GOT { 6 } else if k == K_BSS { 1 } else { 0 });
        put32(out, c + 68, if k == K_GOT { nstubs } else { 0 });
        put32(out, c + 72, if k == K_STUBS { 12 } else { 0 });
        c += 80;
    }
    // __LINKEDIT
    put32(out, c, 0x19);
    put32(out, c + 4, 72);
    put_name(out, c + 8, b"__LINKEDIT");
    put64(out, c + 24, BASE + le_vm);
    put64(out, c + 32, align_up(le_size, PAGE));
    put64(out, c + 40, le_off);
    put64(out, c + 48, le_size);
    put32(out, c + 56, 1);
    put32(out, c + 60, 1);
    c += 72;
    let fixups_cmd = c;
    put32(out, c, 0x80000034);
    put32(out, c + 4, 16);
    c += 16;
    let trie_cmd = c;
    put32(out, c, 0x80000033);
    put32(out, c + 4, 16);
    c += 16;
    put32(out, c, 2);
    put32(out, c + 4, 24);
    put32(out, c + 8, le_off + symtab_off);
    put32(out, c + 12, syms.len() as i64);
    put32(out, c + 16, le_off + strtab_off);
    put32(out, c + 20, strtab_size);
    c += 24;
    put32(out, c, 0xb);
    put32(out, c + 4, 80);
    put32(out, c + 8, 0);
    put32(out, c + 12, nlocal);
    put32(out, c + 16, nlocal);
    put32(out, c + 20, next);
    put32(out, c + 24, nlocal + next);
    put32(out, c + 28, nundef);
    put32(out, c + 56, le_off + indirect_off);
    put32(out, c + 60, nindirect);
    c += 80;
    put32(out, c, 0xe);
    put32(out, c + 4, 32);
    put32(out, c + 8, 12);
    put_name(out, c + 12, b"/usr/lib/dyld");
    c += 32;
    let uuid_at = c + 8;
    put32(out, c, 0x1b);
    put32(out, c + 4, 24);
    c += 24;
    // macOS 12.0, SDK 26.0 (0.25.5: with SDK 12.0, which it wrote
    // before, the system's libraries keep their old behaviour: libmalloc's
    // tiny free scanned its regions for pages to give back, and the
    // compiler linked here ran its -O2 self-compile in 470G instructions
    // instead of 46G; 13.0 is enough for that, 26.0 is the release vole
    // was tested on, and a fixed one keeps the bytes the same on every
    // machine); the tool: ld (3), 0.25
    put32(out, c, 0x32);
    put32(out, c + 4, 32);
    put32(out, c + 8, 1);
    put32(out, c + 12, 0x000c0000);
    put32(out, c + 16, 0x001a0000);
    put32(out, c + 20, 1);
    put32(out, c + 24, 3);
    put32(out, c + 28, 0x00001900);
    c += 32;
    put32(out, c, 0x2a);
    put32(out, c + 4, 16);
    c += 16;
    put32(out, c, 0x80000028);
    put32(out, c + 4, 24);
    put64(out, c + 8, sym_addr(&l, main_sym) - BASE);
    c += 24;
    put32(out, c, 0xc);
    put32(out, c + 4, 56);
    put32(out, c + 8, 24);
    put32(out, c + 12, 2);
    put32(out, c + 16, 0x054c0000);
    put32(out, c + 20, 0x00010000);
    put_name(out, c + 24, b"/usr/lib/libSystem.B.dylib");
    c += 56;
    put32(out, c, 0x1d);
    put32(out, c + 4, 16);
    put32(out, c + 8, le_off + sig_off_rel);
    put32(out, c + 12, sig_size);

    // ---- The sections ----
    for k in 0..3 {
        if l.present[k as usize] {
            put_name(out, l.file[k as usize],
                &l.ob[l.in_off[k as usize] as usize..(l.in_off[k as usize]
                    + l.size[k as usize]) as usize]);
        }
    }
    for i in 0..nstubs {
        let s = (l.stubs[i as usize]);
        let pc = l.addr[K_STUBS as usize] + 12 * i;
        let slot = l.addr[K_GOT as usize] + 8 * l.sym_got[s as usize];
        let at_stub = l.file[K_STUBS as usize] + 12 * i;
        put32(out, at_stub, patch(0x90000010, R_PAGE21, pc, slot));
        put32(out, at_stub + 4, patch(0xf9400210, R_PAGEOFF12, pc + 4, slot));
        put32(out, at_stub + 8, 0xd61f0200);
    }
    // The text's relocations.
    let mut addend: i64 = 0;
    for r in 0..l.rel_n[K_TEXT as usize] {
        let ra = l.rel_off[K_TEXT as usize] + 8 * r;
        let off = get32(l.ob, ra);
        let info = get32(l.ob, ra + 4);
        let sym = info & 0xffffff;
        let ty = (info >> 28) & 15;
        if ty == R_ADDEND {
            addend = if (sym & 0x800000) != 0 { sym - 0x1000000 } else { sym };
            continue;
        }
        let pc = l.addr[K_TEXT as usize] + off;
        let mut target: i64 = 0;
        if ty == R_GOT_PAGE21 || ty == R_GOT_PAGEOFF12 {
            target = l.addr[K_GOT as usize] + 8 * l.sym_got[sym as usize];
        } else if l.sym_kind[sym as usize] < 0 {
            // (a call of an import: its stub)
            target = l.addr[K_STUBS as usize] + 12 * (
                l.stub_of[l.sym_import[sym as usize] as usize]);
        } else {
            target = sym_addr(&l, sym) + addend;
        }
        addend = 0;
        let insn = get32(&out[..], l.file[K_TEXT as usize] + off);
        let patched = patch(insn, ty, pc, target);
        if patched < 0 {
            return false;
        }
        put32(out, l.file[K_TEXT as usize] + off, patched);
    }
    // The fixups: the GOT's slots, the data's pointers.
    let mut fx_got = fixups_new(l.size[K_GOT as usize]);
    for g in 0..ngot {
        let s = (l.got[g as usize]);
        if l.sym_kind[s as usize] < 0 {
            bind(&mut fx_got, 8 * g, l.sym_import[s as usize], 0);
        } else {
            rebase(&mut fx_got, 8 * g, sym_addr(&l, s));
        }
    }
    let mut fx_data = fixups_new(l.size[K_DATA as usize]);
    for r in 0..l.rel_n[K_DATA as usize] {
        let ra = l.rel_off[K_DATA as usize] + 8 * r;
        let off = get32(l.ob, ra);
        let info = get32(l.ob, ra + 4);
        let sym = info & 0xffffff;
        let ext = (info >> 27) & 1;
        let value = get64(&out[..], l.file[K_DATA as usize] + off);
        if ext == 0 {
            let k = l.ord_kind[sym as usize];
            rebase(&mut fx_data, off, l.addr[k as usize] + value - l.in_addr[k as usize]);
        } else if l.sym_kind[sym as usize] >= 0 {
            rebase(&mut fx_data, off, sym_addr(&l, sym) + value);
        } else {
            if value < 0 || value > 255 {
                return false;
            }
            bind(&mut fx_data, off, l.sym_import[sym as usize], value);
        }
    }

    // ---- __LINKEDIT ----
    // dyld_chained_fixups_header (28 bytes, then starts at 32)
    let starts: i64 = 32;
    put32(out, le_off + starts, nseg);
    let mut w = align_up(starts + 4 + 4 * nseg, 8);
    let mut segi: i64 = 0;
    // (segments: __PAGEZERO, __TEXT, [__DATA_CONST], [__DATA], __LINKEDIT)
    segi = 2;
    if l.present[K_GOT as usize] {
        put32(out, le_off + starts + 4 + 4 * segi, w - starts);
        w += write_chains(&fx_got, out, dc_off, le_off + w, dc_off, dc_size / PAGE);
        w = align_up(w, 8);
        segi += 1;
    }
    // (the pages in the file only, as ld counts them: the kernel maps a
    // page the chains name from the file, so naming a zerofill page
    // there maps __LINKEDIT's bytes into __bss; none for a __DATA of
    // __bss only)
    if has_data {
        put32(out, le_off + starts + 4 + 4 * segi, w - starts);
        w += write_chains(&fx_data, out, da_off, le_off + w, da_off, da_file / PAGE);
        w = align_up(w, 8);
    }
    let imports_off = w;
    w += 4 * nundef;
    let symbols_off = w;
    for i in 0..nundef {
        let name = sym_name(&l, l.imports[i as usize]);
        put32(out, le_off + imports_off + 4 * i, 1 | (w - symbols_off) << 9);
        put_name(out, le_off + w, name);
        w += name.len() as i64 + 1;
    }
    let fx_size = align_up(w, 8);
    if fx_size > fx_cap {
        return false;
    }
    put32(out, le_off + 0, 0);
    put32(out, le_off + 4, starts);
    put32(out, le_off + 8, imports_off);
    put32(out, le_off + 12, symbols_off);
    put32(out, le_off + 16, nundef);
    put32(out, le_off + 20, 1);
    put32(out, le_off + 24, 0);
    put32(out, fixups_cmd + 8, le_off);
    put32(out, fixups_cmd + 12, fx_size);
    // The exports trie: __mh_execute_header at 0.
    let trie = fx_cap;
    put8(out, le_off + trie, 0);
    put8(out, le_off + trie + 1, 1);
    put_name(out, le_off + trie + 2, b"__mh_execute_header");
    put8(out, le_off + trie + 22, 23);
    put8(out, le_off + trie + 23, 2);
    put32(out, trie_cmd + 8, le_off + trie);
    put32(out, trie_cmd + 12, 32);
    // The symbol table.
    for i in 0..syms.len() as i64 {
        let s = (syms[i as usize]);
        let e = symtab_off + 16 * i;
        put32(out, le_off + e, (strx[i as usize]));
        if s < 0 {
            put8(out, le_off + e + 4, 0x0f);
            put8(out, le_off + e + 5, 1);
            put16(out, le_off + e + 6, 0x10);
            put64(out, le_off + e + 8, BASE);
        } else if l.sym_kind[s as usize] < 0 {
            put8(out, le_off + e + 4, 0x01);
            put16(out, le_off + e + 6, 0x0100);
        } else {
            put8(out, le_off + e + 4, l.ob[(l.symoff + 16 * s + 4) as usize] as i64);
            put8(out, le_off + e + 5, l.ord[l.sym_kind[s as usize] as usize]);
            put64(out, le_off + e + 8, sym_addr(&l, s));
        }
    }
    // The indirect symbols: the stubs', then the GOT's.
    for i in 0..nstubs {
        put32(out, le_off + indirect_off + 4 * i,
            l.sym_index[(l.stubs[i as usize]) as usize]);
    }
    for g in 0..ngot {
        let s = (l.got[g as usize]);
        put32(out, le_off + indirect_off + 4 * (nstubs + g),
            if l.sym_kind[s as usize] < 0 { l.sym_index[s as usize] }
            else { 0x80000000 });
    }
    put_name(out, le_off + strtab_off, &buf_copy(strs));

    // ---- The signature ----
    let sig = le_off + sig_off_rel;
    putbe32(out, sig, 0xfade0cc0);
    putbe32(out, sig + 4, 20 + cd_size);
    putbe32(out, sig + 8, 1);
    putbe32(out, sig + 12, 0);
    putbe32(out, sig + 16, 20);
    let cd = sig + 20;
    putbe32(out, cd, 0xfade0c02);
    putbe32(out, cd + 4, cd_size);
    putbe32(out, cd + 8, 0x20400);
    putbe32(out, cd + 12, 0x20002);
    putbe32(out, cd + 16, 88 + ident_len);
    putbe32(out, cd + 20, 88);
    putbe32(out, cd + 24, 0);
    putbe32(out, cd + 28, pages);
    putbe32(out, cd + 32, code_limit);
    put8(out, cd + 36, 32);
    put8(out, cd + 37, 2);
    put8(out, cd + 38, 0);
    put8(out, cd + 39, 12);
    putbe64(out, cd + 64, 0);
    putbe64(out, cd + 72, text_size);
    putbe64(out, cd + 80, 1);
    put_name(out, cd + 88, ident);
    let hashes = cd + 88 + ident_len;
    for p in 0..pages {
        let from = 4096 * p;
        let n: i64 = if from + 4096 <= code_limit { 4096 } else { code_limit - from };
        let digest = sha256(&out[from as usize..(from + n) as usize]);
        put_name(out, hashes + 32 * p, &digest[..]);
    }
    // The UUID: of the page hashes (with the UUID zero), then page 0
    // again.
    let mut uuid = sha256(&out[hashes as usize..(hashes + 32 * pages) as usize]);
    uuid[6] = (uuid[6] & 0x0f) | 0x40;
    uuid[8] = (uuid[8] & 0x3f) | 0x80;
    put_name(out, uuid_at, &uuid[..16]);
    let first_page = sha256(
        &out[..(if code_limit < 4096 { code_limit } else { 4096 }) as usize]);
    put_name(out, hashes, &first_page[..]);
    // ---- The file: written aside, then renamed over path ----
    let name = match str::from_utf8(crate::base::c_kept(path)) {
        Ok(name) => name,
        Err(_) => return false,
    };
    let tmp = buf_new();
    crate::base::buf_fmt(tmp, format_args("{name}.{}.tmp\0", std::process::id()));
    let tmp_name = match str::from_utf8(
        &crate::base::buf_done(tmp)[..(buf_len(tmp) - 1) as usize]) {
        Ok(tmp_name) => tmp_name,
        Err(_) => return false,
    };
    if std::fs::write(tmp_name, &image[..]).is_err() || !make_executable(tmp)
        || std::fs::rename(tmp_name, name).is_err() {
        let _ = std::fs::remove_file(tmp_name);
        return false;
    }
    true
}

// Makes the file whose path (with its NUL) is buffer `path` executable
// (rwxr-xr-x): whether it could.
fn make_executable(path: i64) -> bool {
    // UNSAFE: C's chmod (see the extern block).
    // SAFETY: the buffer's last byte is the NUL link_macho's format wrote,
    // and it is not written again; chmod reads up to it.
    unsafe { chmod(buf_ptr(path), 493) == 0 }
}
