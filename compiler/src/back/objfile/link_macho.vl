    b"stat", b"strcasecmp", b"strcat", b"strchr", b"strcmp", b"strcpy", b"strcspn", b"strdup",
    b"strerror", b"strftime", b"strlen", b"strncasecmp", b"strncmp", b"strncpy", b"strndup",
