// A program with no fn main, and a link that failed (0.25.3): one vole
// error each, naming what failed, instead of the linker's or the C
// driver's text first.
//
// main.missing (require_main): an executable of a program without fn main
// is an error after the checks, before any code is made; with an object,
// an archive, a library or a C file on the command line (which may define
// main), the link says so, and its `main` is that error too.
//
// A failed link (link_failed) is read from what the C driver printed
// (output.vl's LINK_LOG): the shapes of ld64 and ld-prime (macOS), GNU
// ld and lld (Linux), and the driver's:
//
//   link.undefined     symbols no input defines: `Undefined symbols for
//                      architecture A:` then `"_f", referenced from:`,
//                      "undefined reference to `f'", `undefined symbol: f`;
//                      at the extern declaration of the first (by name),
//                      with the #[link] of its block
//   link.no-library    `library 'x' not found`, `library not found for
//                      -lx`, `cannot find -lx`, `unable to find library -lx`
//   link.no-framework  `framework 'X' not found`, `framework not found X`
//   link.duplicate     `duplicate symbol '_f' in:`, "multiple definition
//                      of `f'", `duplicate symbol: f`
//   link.c-file        a C file of the command line that does not compile
//                      (`x.c:3:5: error: ...`): its errors under the error
//   link.no-linker     the C driver cannot be run (the shell's 127)
//   link.failed        anything else: the linker's lines under the error
//
// and, before the link, link.no-input: an input of the command line (an
// object, an archive, a library, a C file) that is not there. `--verbose`
// prints the link's command and the linker's whole text after the error.

use std::process::exit;

use crate::back::objfile::OUT_EXECUTABLE;
use crate::back::objfile::output::{
    lib_given, link_decl_first, link_decl_framework, link_decl_name, link_decl_of, link_input,
    link_input_count,
};
use crate::base::{
    IntVec, STDERR, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, buf_write_fd, cstr,
    sym_name,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_position, buf_tool_command, err_begin, err_end, err_fmt, err_help, err_try_fmt,
    err_try_tool, print_diagnostic, put_try_lines,
};
use crate::base::target::get_elf;
use crate::base::term::{build_failed, file_info};
use crate::front::ast::{Node, NodeKind};
use crate::front::types::FnInfo;

// The most lines of the linker's (or the C compiler's) text under an
// error.
const MAX_LINES: i64 = 20;

// ---- main.missing ----

// The program's root file (the first that is not std's or a C header's),
// or -1.
fn root_file(pcx: &Ctx<Comp>) -> i64 {
    for f in 0..pcx.files.len() as i64 {
        if cstr(file_info(f, pcx).path)[0] != b'<' {
            return f;
        }
    }
    -1
}

// A file's path (its C string, `file_info(f, pcx).path`) as positions
// print it (without `./`): a view of the string, never freed or written,
// not of pcx (src-buffer.md, views of other storage).
fn root_path(path: *mut u8) -> &'static [u8] {
    let s = cstr(path);
    if s.len() > 2 && s[0] == b'.' && s[1] == b'/' { &s[2..s.len()] } else { s }
}

// FILE without its directory and .vl.
fn stem(path: &[u8]) -> &[u8] {
    let mut from = path.len() as i64;
    while from > 0 && path[(from - 1) as usize] != b'/' {
        from -= 1;
    }
    let to = if path.len() >= 3
        && path[(path.len() as i64 - 3) as usize..] == b".vl" { path.len() as i64 - 3 } else {
        path.len() as i64
    };
    if to > from { &path[from as usize..to as usize] } else { b"main" }
}

// main.missing's help.
fn main_help() -> *mut u8 {
    c"a program starts at its fn main, and this one has none; an object (-c) needs none"
}

// main.missing's help and its two try: lines (fn main added to the root;
// the root built as an object) into a diagnostic's text.
fn main_tail(t: i64, root: &[u8], pcx: &Ctx<Comp>) {
    buf_fmt(t, format_args("  = help: {}\n", str::from_utf8(cstr(main_help())).unwrap()));
    buf_fmt(t,
        { let root = str::from_utf8(root).unwrap();
            format_args("  = try: printf '\\nfn main() -> i32 {{\\n    0\\n}}\\n' >> {root}\n") });
    buf_str(t, c"  = try: ");
    let args = buf_new();
    buf_fmt(args, format_args("-c -o {}.o", str::from_utf8(stem(root)).unwrap()));
    buf_tool_command(t, buf_slice(args), true, pcx);
    buf_byte(t, b'\n');
}

// Function f of the checker (0 <= f < FN_COUNT).
fn fn_info(f: i64, pcx: &Ctx<Comp>) -> FnInfo {
    if f < 0 || f >= pcx.fns.len() as i64 {
        panic("linkfail::fn_info: no such function");
    }
    // UNSAFE: FNS is the checker's C-style array of functions
    // (front::types), a raw pointer indexed unchecked.
    // SAFETY: 0 <= f < FN_COUNT (checked above): the entries the checker
    // made, each filled before it is counted; the entry is copied out.
    unsafe { pcx.fns[f as usize] }
}

// Node n of the AST (0 <= n < NODE_COUNT).
fn node(n: i64, pcx: &Ctx<Comp>) -> Node {
    if n < 0 || n >= pcx.nodes.len() as i64 {
        panic("linkfail::node: no such node");
    }
    pcx.nodes[n as usize]
}

// After the checks of a build that makes an executable: an error when the
// program has no fn main and nothing else of the link may define it.
pub fn require_main(pcx: &mut Ctx<Comp>) {
    if pcx.output_mode != OUT_EXECUTABLE || pcx.emit_header || pcx.emit_ir || pcx.emit_mir {
        return;
    }
    if link_input_count(pcx) > 0 {
        return;
    }
    for f in 0..pcx.fns.len() as i64 {
        let info = fn_info(f, pcx);
        if info.name == pcx.main_sym && !info.is_extern {
            return;
        }
    }
    let f = root_file(pcx);
    if f < 0 {
        return;
    }
    let root = root_path(file_info(f, pcx).path);
    pcx.err_kind = c"main.missing";
    err_begin(file_info(f, pcx).start, pcx);
    err_fmt({ let root = str::from_utf8(root).unwrap(); format_args("'{root}' has no fn main") },
        pcx);
    err_help(main_help(), pcx);
    err_try_fmt({
        let root = str::from_utf8(root).unwrap();
        format_args("printf '\\nfn main() -> i32 {{\\n    0\\n}}\\n' >> {root}")
    }, pcx);
    let args = buf_new();
    buf_fmt(args, format_args("-c -o {}.o", str::from_utf8(stem(root)).unwrap()));
    err_try_tool(buf_slice(args), true, pcx);
    err_end(pcx);
}

// ---- A failed link ----

// The byte that ends the line at i of text (its '\n', or text's end).
fn line_end(text: &[u8], i: i64) -> i64 {
    let mut e = i;
    while e < text.len() as i64 && text[e as usize] != b'\n' {
        e += 1;
    }
    e
}

// The error, then (--verbose) the link and its text, then the build's
// `Failed`; exit 1. `text` is the human form, at pos (-1: none).
fn fail(pos: i64, text: i64, pcx: &mut Ctx<Comp>) -> ! {
    print_diagnostic(pos, buf_slice(text), pcx);
    if pcx.link_verbose && pcx.link_cmd != 0 as *mut u8 {
        let out = buf_new();
        buf_fmt(out,
            format_args("note: the link: {}\n", str::from_utf8(cstr(pcx.link_cmd)).unwrap()));
        if pcx.link_log >= 0 {
            let log = buf_slice(pcx.link_log);
            let mut i: i64 = 0;
            while i < log.len() as i64 {
                let e = line_end(log, i);
                buf_str(out, c"    ");
                buf_bytes(out, &log[i as usize..e as usize]);
                buf_byte(out, b'\n');
                i = e + 1;
            }
        }
        buf_write_fd(out, STDERR);
    }
    build_failed(pcx);
    exit(1i32)
}

// A diagnostic's text: `error[kind]: message`, its position when pos >=
// 0, its help.
fn head(kind: *mut u8, message: &[u8], pos: i64, help: &[u8], pcx: &mut Ctx<Comp>) -> i64 {
    let t = buf_new();
    buf_fmt(t,
        { let message = str::from_utf8(message).unwrap();
            format_args("error[{}]: {message}\n", str::from_utf8(cstr(kind)).unwrap()) });
    if pos >= 0 {
        buf_str(t, c" --> ");
        buf_position(t, pos, pcx);
        buf_byte(t, b'\n');
    }
    if help.len() > 0 {
        buf_fmt(t, { let help = str::from_utf8(help).unwrap(); format_args("  = help: {help}\n") });
    }
    t
}

// Where in s pattern starts, from `from`, or -1.
fn find(s: &[u8], pattern: &[u8], from: i64) -> i64 {
    let mut i = from;
    while i + pattern.len() as i64 <= s.len() as i64 {
        if &s[i as usize..(i + pattern.len() as i64) as usize] == pattern {
            return i;
        }
        i += 1;
    }
    -1
}

// The text after `pattern` in l up to byte `stop` (or l's end); "" when l
// has no pattern.
fn after<'a>(l: &'a [u8], pattern: &'a [u8], stop: u8) -> &'a [u8] {
    let at = find(l, pattern, 0);
    if at < 0 {
        return b"";
    }
    let from = at + pattern.len() as i64;
    let mut e = from;
    while e < l.len() as i64 && l[e as usize] != stop {
        e += 1;
    }
    &l[from as usize..e as usize]
}

// A symbol as C names it: macOS's linker spells it with a `_` first.
fn c_name(s: &[u8]) -> &[u8] {
    if !get_elf() && s.len() > 1 && s[0] == b'_' { &s[1..s.len()] } else { s }
}

// Adds name to v (buffers), once.
fn add_name(v: &mut IntVec, name: &[u8]) {
    if name.len() == 0 {
        return;
    }
    for i in 0..v.count {
        if buf_slice(v.get(i)) == name {
            return;
        }
    }
    let b = buf_new();
    buf_bytes(b, name);
    v.push(b);
}

// Whether a sorts before b, byte by byte.
fn less(a: &[u8], b: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i < a.len() as i64 && i < b.len() as i64 {
        if a[i as usize] != b[i as usize] {
            return a[i as usize] < b[i as usize];
        }
        i += 1;
    }
    a.len() < b.len()
}

// v's names sorted (the linkers list them in orders of their own).
fn sort_names(v: &mut IntVec) {
    for i in 1..v.count {
        let mut j = i;
        while j > 0 && less(buf_slice(v.get(j)), buf_slice(v.get(j - 1))) {
            let t = v.get(j);
            { let at_arg2 = v.get(j - 1); v.set(j, at_arg2) };
            v.set(j - 1, t);
            j -= 1;
        }
    }
}

fn name_at(v: IntVec, i: i64) -> &'static [u8] {
    buf_slice(v.get(i))
}

// Where the program declares C symbol sym (an extern fn or static), or -1.
fn declared_at(sym: &[u8], pcx: &Ctx<Comp>) -> i64 {
    for n in 0..pcx.nodes.len() as i64 {
        let x = node(n, pcx);
        if x.kind == NodeKind::ExternFn || (x.kind == NodeKind::Static && x.y == 1) {
            let link = pcx.link_names.get(x.a + 1);
            if cstr(sym_name(if link > 0 { link - 1 } else { x.a }, pcx)) == sym {
                return x.start;
            }
        }
    }
    -1
}

// The C driver the link ran: the first word of its command (cc, or
// $VOLE_CC).
fn driver(pcx: &Ctx<Comp>) -> &[u8] {
    if pcx.link_cmd == 0 as *mut u8 {
        return b"cc";
    }
    let cmd = cstr(pcx.link_cmd);
    let mut e: i64 = 0;
    while e < cmd.len() as i64 && cmd[e as usize] != b' ' {
        e += 1;
    }
    &cmd[0..e as usize]
}

// Whether line l is a C compiler's error at a C file (`x.c:3:5: error:`).
fn c_error_line(l: &[u8]) -> bool {
    let colon = find(l, b".c:", 0);
    colon > 0 && (find(l, b": error:", colon) > 0 || find(l, b": fatal error:", colon) > 0)
}

// Whether line l is the driver's or the linker's own (not a C file's).
fn tool_line(l: &[u8]) -> bool {
    find(l, b"clang: ", 0) == 0 || find(l, b"cc: ", 0) == 0 || find(l, b"gcc: ", 0) == 0
        || find(l, b"collect2: ", 0) == 0 || find(l, b"ld: ", 0) == 0
        || find(l, b"/usr/bin/ld", 0) == 0 || find(l, b" generated.", 0) > 0
}

// `  = LABEL: LINE` for each line of text (at most MAX_LINES).
fn put_lines(t: i64, label: *mut u8, lines: IntVec) {
    let n = if lines.count < MAX_LINES { lines.count } else { MAX_LINES };
    for i in 0..n {
        buf_fmt(t,
            format_args("  = {}: {}\n", str::from_utf8(cstr(label)).unwrap(),
                str::from_utf8(name_at(lines, i)).unwrap()));
    }
    if lines.count > n {
        buf_fmt(t,
            format_args("  = {}: ... {} more lines (--verbose)\n",
                str::from_utf8(cstr(label)).unwrap(), lines.count - n));
    }
}

// Before the link: each input of the command line is there.
pub fn check_link_inputs(pcx: &mut Ctx<Comp>) {
    for k in 0..link_input_count(pcx) {
        let p = cstr(link_input(k, pcx));
        if !std::fs::exists(str::from_utf8(p).unwrap()).unwrap_or(false) {
            let m = buf_new();
            buf_fmt(m,
                { let p = str::from_utf8(p).unwrap();
                    format_args("cannot read '{p}', an input of the link") });
            fail(-1, head(c"link.no-input", buf_slice(m), -1,
                b"the objects (.o), archives (.a), shared libraries (.so, .dylib) and C files (.c) of the command line go to the link: check the path", pcx), pcx);
        }
    }
}

// The names the linker's text gives, line by line.
#[derive(Clone, Copy)] struct Found<'a> {
    undefined: IntVec,
    libs: IntVec,
    frameworks: IntVec,
    dups: IntVec,
    c_lines: IntVec,
    all: IntVec,
    c_file: &'a [u8],
}

fn empty() -> IntVec {
    IntVec { data: 0 as *mut i64, count: 0, cap: 0 }
}

// What the linker's text `log` names.
fn read_log(log: &[u8]) -> Found<'_> {
    let mut x = Found {
        undefined: empty(), libs: empty(), frameworks: empty(), dups: empty(), c_lines: empty(),
        all: empty(), c_file: b"",
    };
    let mut in_undefined = false;
    let mut i: i64 = 0;
    while i < log.len() as i64 {
        let e = line_end(log, i);
        let l = &log[i as usize..e as usize];
        i = e + 1;
        if l.len() == 0 {
            continue;
        }
        let b = buf_new();
        buf_bytes(b, l);
        x.all.push(b);
        if c_error_line(l) {
            if x.c_file.len() == 0 {
                x.c_file = &l[0..(find(l, b".c:", 0) + 2) as usize];
            }
            x.c_lines.push(b);
            continue;
        }
        if x.c_file.len() > 0 && !tool_line(l) {
            x.c_lines.push(b);
            continue;
        }
        if find(l, b"Undefined symbols for architecture", 0) == 0 {
            in_undefined = true;
            continue;
        }
        if in_undefined {
            if l.len() > 3 && l[0] == b' ' && l[1] == b' ' && l[2] == b'"' {
                add_name(&mut x.undefined, c_name(after(l, b"\"", b'"')));
                continue;
            }
            if l[0] == b' ' {
                continue;
            }
            in_undefined = false;
        }
        add_name(&mut x.undefined, after(l, b"undefined reference to `", b'\''));
        add_name(&mut x.undefined, after(l, b"undefined symbol: ", 0));
        if find(l, b"' not found", 0) > 0 {
            add_name(&mut x.libs, after(l, b"library '", b'\''));
            add_name(&mut x.frameworks, after(l, b"framework '", b'\''));
        }
        add_name(&mut x.libs, after(l, b"library not found for -l", 0));
        add_name(&mut x.libs, after(l, b"cannot find -l", b':'));
        add_name(&mut x.libs, after(l, b"unable to find library -l", 0));
        add_name(&mut x.frameworks, after(l, b"framework not found ", 0));
        add_name(&mut x.dups, c_name(after(l, b"duplicate symbol '", b'\'')));
        add_name(&mut x.dups, after(l, b"multiple definition of `", b'\''));
        add_name(&mut x.dups, after(l, b"duplicate symbol: ", 0));
    }
    sort_names(&mut x.undefined);
    x
}

// A library or framework not found.
fn no_library(x: Found<'_>, pcx: &mut Ctx<Comp>) -> ! {
    let framework = x.libs.count == 0;
    let name = if framework { name_at(x.frameworks, 0) } else { name_at(x.libs, 0) };
    let d = link_decl_of(if framework { b'F' } else { b'l' }, name, pcx);
    let first = if d >= 0 { link_decl_first(d, pcx) } else { 0 as *mut u8 };
    let pos: i64 = if first != 0 as *mut u8 { declared_at(cstr(first), pcx) } else { -1 };
    let m = buf_new();
    buf_fmt(m,
        { let name = str::from_utf8(name).unwrap();
            format_args("{} '{name}' not found",
                if framework { "framework" } else { "library" }) });
    let h = buf_new();
    if !framework && lib_given(name, pcx) {
        buf_fmt(h,
            { let name = str::from_utf8(name).unwrap();
                format_args("-l {name} on the command line names it") });
    } else if d >= 0 {
        buf_str(h, c"the #[link] of the extern block names it");
    } else {
        buf_fmt(h,
            { let name = str::from_utf8(name).unwrap();
                format_args("-framework {name} on the command line names it") });
    }
    if framework {
        buf_str(h, c"; the linker looked in the SDK's frameworks and found none: check the name");
    } else {
        buf_str(h, c"; the linker looked in its directories and the -L ones and found none: install it, or give the directory that has it with -L DIR");
    }
    fail(pos, head(if framework { c"link.no-framework" } else { c"link.no-library" },
        buf_slice(m), pos, buf_slice(h), pcx), pcx)
}

// Symbols nothing of the link defines (`main` among them: main.missing).
fn undefined(x: Found<'_>, path: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    for k in 0..x.undefined.count {
        if name_at(x.undefined, k) == b"main" {
            let f = root_file(pcx);
            let root = if f >= 0 { root_path(file_info(f, pcx).path) } else { cstr(path) };
            let m = buf_new();
            buf_fmt(m,
                { let root = str::from_utf8(root).unwrap();
                    format_args("'{root}' has no fn main") });
            let t = head(c"main.missing", buf_slice(m), -1, b"", pcx);
            main_tail(t, root, pcx);
            fail(-1, t, pcx);
        }
    }
    let first = name_at(x.undefined, 0);
    let pos = declared_at(first, pcx);
    let m = buf_new();
    buf_fmt(m,
        { let first = str::from_utf8(first).unwrap(); format_args("undefined symbol '{first}'") });
    let more = x.undefined.count - 1;
    if more > 0 {
        buf_fmt(m, format_args(", and {more} more:"));
        for k in 1..x.undefined.count {
            if k > 3 {
                buf_str(m, c" ...");
                break;
            }
            buf_fmt(m, format_args(" '{}'", str::from_utf8(name_at(x.undefined, k)).unwrap()));
        }
    }
    let h = buf_new();
    let d = link_decl_of(0, first, pcx);
    if d >= 0 {
        let what = if link_decl_framework(d, pcx) { "framework" } else { "library" };
        buf_fmt(h,
            { let first = str::from_utf8(first).unwrap(); format_args("'{first}' is declared in an extern block whose #[link] names the {what} '{}', which does not define it: check the name and the {what}'s version", str::from_utf8(cstr(link_decl_name(d, pcx))).unwrap()) });
    } else if pos >= 0 {
        buf_fmt(h, { let first = str::from_utf8(first).unwrap(); format_args("'{first}' is declared in an extern block, and nothing the link is given defines it: name its library, #[link(lib = \"NAME\")] on the block or -l NAME on the command line") });
    } else {
        buf_fmt(h,
            { let first = str::from_utf8(first).unwrap(); format_args("a C file, an object or a library of the command line uses '{first}', and nothing the link is given defines it") });
    }
    buf_str(h, c" (--verbose: the linker's text)");
    fail(pos, head(c"link.undefined", buf_slice(m), pos, buf_slice(h), pcx), pcx)
}

// The link of `path` failed with status: its error (exit 1).
pub fn link_failed(status: i64, path: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    let x = read_log(if pcx.link_log >= 0 { buf_slice(pcx.link_log) } else { b"" });
    let cc = driver(pcx);
    if x.c_file.len() > 0 {
        let m = buf_new();
        buf_fmt(m,
            format_args("the C file '{}' does not compile", str::from_utf8(x.c_file).unwrap()));
        let t = head(c"link.c-file", buf_slice(m), -1,
            b"the C files of the command line are compiled for the link; the C compiler's errors follow", pcx);
        put_lines(t, c"cc", x.c_lines);
        fail(-1, t, pcx);
    }
    if status == 127 {
        let m = buf_new();
        buf_fmt(m,
            { let cc = str::from_utf8(cc).unwrap();
                format_args("cannot run '{cc}', the C compiler that links the program") });
        let named = cc != b"cc";
        let t = head(c"link.no-linker", buf_slice(m), -1,
            if named { b"$VOLE_CC names it: set it to a C compiler, or unset it" } else {
                b"the link runs the system's C compiler: install one (the command line tools on macOS, gcc or clang on Linux)"
            }, pcx);
        if !named && !get_elf() {
            put_try_lines(t, b"xcode-select --install");
        }
        fail(-1, t, pcx);
    }
    if x.libs.count > 0 || x.frameworks.count > 0 {
        no_library(x, pcx);
    }
    if x.undefined.count > 0 {
        undefined(x, path, pcx);
    }
    if x.dups.count > 0 {
        let name = name_at(x.dups, 0);
        let m = buf_new();
        buf_fmt(m,
            { let name = str::from_utf8(name).unwrap();
                format_args("symbol '{name}' is defined more than once") });
        fail(-1, head(c"link.duplicate", buf_slice(m), -1,
            if name == b"main" {
                b"the program's fn main and a C file, an object or a library of the command line both define main: keep one (--verbose: the linker's text)"
            } else {
                b"two inputs of the link define it (the program's object, a C file, an object or a library of the command line): rename one, or leave one out (--verbose: the linker's text)"
            }, pcx), pcx);
    }
    let m = buf_new();
    buf_fmt(m,
        { let cc = str::from_utf8(cc).unwrap();
            format_args("the link failed ({cc} exited with status {status})") });
    let t = head(c"link.failed", buf_slice(m), -1,
        b"the linker's text follows (--verbose: its command too)", pcx);
    put_lines(t, c"linker", x.all);
    fail(-1, t, pcx)
}
