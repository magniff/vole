// x86-64 instruction encoding for the object writer (objfile.vl): the
// AT&T-syntax instructions the code generator writes (x86_64.vl,
// mc_x86_64.vl, emit.vl), to bytes. Where the syntax leaves a choice,
// the choice is the one the system assemblers make (LLVM on macOS, GNU as
// on Linux; they agree on these): the shortest immediate, the accumulator
// forms of `op $imm32, %eax`, the MR form for register moves, D1 for
// shifts by one; branches to labels are relaxed by objfile.vl.

use crate::arch::table::{insn_hex, insn_named, insn_text};
use crate::back::objfile::{
    Asm, FX_X86_BRANCH, FX_X86_GOT, FX_X86_RIP, TAIL_JCC, TAIL_JMP, asym_text, emit_relaxable,
    fixup, here, names_get, names_put, out16, out32, out64, out8,
};
use crate::back::objfile::assemble::{
    asm_error, is_digit_start, mnemonic_copy, parse_number, text_is,
};
use crate::base::comp::Comp;

const K_REG: i64 = 1;
const K_IMM: i64 = 2;
const K_MEM: i64 = 3;
const K_SYM: i64 = 4;
const K_IND: i64 = 5;

const MOD_NONE: i64 = 0;
const MOD_PLT: i64 = 1;
const MOD_GOTPCREL: i64 = 2;

// An operand. Registers: `reg` 0-15, `size` 1, 2, 4, 8 bytes, `xmm`,
// `rex8` (spl, bpl, sil, dil: need a REX prefix). Memory: `disp` + `sym`
// (with `modifier`) + base `reg` (-1 none, 16 %rip) + `index` * `scale`.
// K_IND: `*%reg`, in `reg`.
#[derive(Clone, Copy)] pub struct XOp {
    kind: i64, reg: i64, size: i64, xmm: bool, rex8: bool, imm: i64, index: i64, scale: i64,
    sym: i64, modifier: i64,
}

// No operand.
pub fn xop_none() -> XOp {
    XOp {
        kind: 0, reg: 0, size: 0, xmm: false, rex8: false, imm: 0, index: 0, scale: 0, sym: 0,
        modifier: 0,
    }
}

const X_ALU: i64 = 1;
const X_TEST: i64 = 2;
const X_MOV: i64 = 3;
const X_MOVABS: i64 = 4;
const X_MOVX: i64 = 5;
const X_LEA: i64 = 6;
const X_SHIFT: i64 = 7;
const X_IMUL: i64 = 8;
const X_F7: i64 = 9;
const X_CQTO: i64 = 10;
const X_BT: i64 = 11;
const X_SETCC: i64 = 12;
const X_CMOVCC: i64 = 13;
const X_JCC: i64 = 14;
const X_JMP: i64 = 15;
const X_CALL: i64 = 16;
const X_PUSH: i64 = 17;
const X_POP: i64 = 18;
const X_RET: i64 = 19;
const X_UD2: i64 = 20;
const X_SSE: i64 = 21;
const X_SSEMOV: i64 = 22;
const X_CVTSI2: i64 = 23;
const X_CVTT2SI: i64 = 24;
const X_MOVD: i64 = 25;
// (0.10) SSE with an 8-bit immediate ($imm, src, dst); shifts of an xmm
// register by an immediate (arg: the opcode's /digit << 16 | opcode).
const X_SSEI: i64 = 26;
const X_SSESHIFT: i64 = 27;

// (0.19) AVX's moves (vmovdqu, vmovdqa: arg the mandatory prefix), which
// the back end writes for 256-bit values, and vzeroupper.
const X_VMOV: i64 = 28;
const X_VZEROUPPER: i64 = 29;

fn reg_def(name: &[u8], num: i64, size: i64, rex8: bool, xmm: bool, asm: &mut Asm<Comp>) {
    names_put(&mut asm.xregs, name,
        1 + (num | (size & 31) << 5 | (if rex8 { 1 << 10 } else { 0 })
            | (if xmm { 1 << 11 } else { 0 }) | (if size == 32 { 1 << 12 } else { 0 })));
}

fn mn(name: &[u8], class: i64, size: i64, arg: i64, asm: &mut Asm<Comp>) {
    names_put(&mut asm.xmn, name, 1 + (class | size << 8 | arg << 16));
}

// SSE: arg = mandatory prefix << 8 | opcode (after 0F).
fn sse(name: &[u8], class: i64, prefix: i64, opcode: i64, asm: &mut Asm<Comp>) {
    mn(name, class, 16, prefix << 8 | opcode, asm);
}

// The two names, one after the other, in `room`.
fn joined<'r>(a: &[u8], b: &[u8], room: &'r mut [u8; 32]) -> &'r [u8] {
    let n = a.len() + b.len();
    room[..a.len()].copy_from_slice(a);
    room[a.len()..n].copy_from_slice(b);
    &room[..n]
}

pub fn init_x86(asm: &mut Asm<Comp>) {
    let mut room = [0u8; 32];
    let r64: [&[u8]; 16] = [b"rax", b"rcx", b"rdx", b"rbx", b"rsp", b"rbp", b"rsi", b"rdi",
        b"r8", b"r9", b"r10", b"r11", b"r12", b"r13", b"r14", b"r15"];
    let r32: [&[u8]; 16] = [b"eax", b"ecx", b"edx", b"ebx", b"esp", b"ebp", b"esi", b"edi",
        b"r8d", b"r9d", b"r10d", b"r11d", b"r12d", b"r13d", b"r14d", b"r15d"];
    let r16: [&[u8]; 16] = [b"ax", b"cx", b"dx", b"bx", b"sp", b"bp", b"si", b"di", b"r8w",
        b"r9w", b"r10w", b"r11w", b"r12w", b"r13w", b"r14w", b"r15w"];
    let r8: [&[u8]; 16] = [b"al", b"cl", b"dl", b"bl", b"spl", b"bpl", b"sil", b"dil", b"r8b",
        b"r9b", b"r10b", b"r11b", b"r12b", b"r13b", b"r14b", b"r15b"];
    let xmm: [&[u8]; 16] = [b"xmm0", b"xmm1", b"xmm2", b"xmm3", b"xmm4", b"xmm5", b"xmm6",
        b"xmm7", b"xmm8", b"xmm9", b"xmm10", b"xmm11", b"xmm12", b"xmm13", b"xmm14", b"xmm15"];
    for i in 0..16 {
        reg_def(r64[i as usize], i, 8, rex8: false, xmm: false, asm: asm);
        reg_def(r32[i as usize], i, 4, rex8: false, xmm: false, asm: asm);
        reg_def(r16[i as usize], i, 2, rex8: false, xmm: false, asm: asm);
        reg_def(r8[i as usize], i, 1, i >= 4 && i < 8, xmm: false, asm: asm);
        reg_def(xmm[i as usize], i, 16, rex8: false, xmm: true, asm: asm);
        // (0.19: AVX's 256-bit registers)
        reg_def(joined(b"y", &xmm[i as usize][1..], &mut room), i, 32, rex8: false, xmm: true,
            asm: asm);
    }
    names_put(&mut asm.xregs, b"rip", 1 + (16 | 8 << 5));
    let alu: [&[u8]; 6] = [b"add", b"or", b"and", b"sub", b"xor", b"cmp"];
    let digit: [i64; 6] = [0i64, 1, 4, 5, 6, 7];
    let sfx: [&[u8]; 4] = [b"b", b"w", b"l", b"q"];
    let sizes: [i64; 4] = [1i64, 2, 4, 8];
    for i in 0..6 {
        for k in 0..4 {
            mn(joined(alu[i as usize], sfx[k as usize], &mut room), X_ALU, sizes[k as usize],
                digit[i as usize], asm);
        }
    }
    for k in 0..4 {
        mn(joined(b"test", sfx[k as usize], &mut room), X_TEST, sizes[k as usize], 0, asm);
        mn(joined(b"mov", sfx[k as usize], &mut room), X_MOV, sizes[k as usize], 0, asm);
        mn(joined(b"lea", sfx[k as usize], &mut room), X_LEA, sizes[k as usize], 0, asm);
        mn(joined(b"shl", sfx[k as usize], &mut room), X_SHIFT, sizes[k as usize], 4, asm);
        mn(joined(b"shr", sfx[k as usize], &mut room), X_SHIFT, sizes[k as usize], 5, asm);
        mn(joined(b"sar", sfx[k as usize], &mut room), X_SHIFT, sizes[k as usize], 7, asm);
        mn(joined(b"imul", sfx[k as usize], &mut room), X_IMUL, sizes[k as usize], 0, asm);
        mn(joined(b"neg", sfx[k as usize], &mut room), X_F7, sizes[k as usize], 3, asm);
        mn(joined(b"not", sfx[k as usize], &mut room), X_F7, sizes[k as usize], 2, asm);
        mn(joined(b"mul", sfx[k as usize], &mut room), X_F7, sizes[k as usize], 4, asm);
        mn(joined(b"div", sfx[k as usize], &mut room), X_F7, sizes[k as usize], 6, asm);
        mn(joined(b"idiv", sfx[k as usize], &mut room), X_F7, sizes[k as usize], 7, asm);
        mn(joined(b"push", sfx[k as usize], &mut room), X_PUSH, sizes[k as usize], 0, asm);
        mn(joined(b"pop", sfx[k as usize], &mut room), X_POP, sizes[k as usize], 0, asm);
    }
    mn(b"movabsq", X_MOVABS, 8, 0, asm);
    // movzbl/movzbq/movzwl/movzwq: 0F B6/B7; movsbq/movswq: 0F BE/BF;
    // movslq: 63.
    mn(b"movzbl", X_MOVX, 4, 0x0fb6, asm);
    mn(b"movzbq", X_MOVX, 8, 0x0fb6, asm);
    mn(b"movzwl", X_MOVX, 4, 0x0fb7, asm);
    mn(b"movzwq", X_MOVX, 8, 0x0fb7, asm);
    mn(b"movsbl", X_MOVX, 4, 0x0fbe, asm);
    mn(b"movsbq", X_MOVX, 8, 0x0fbe, asm);
    mn(b"movswl", X_MOVX, 4, 0x0fbf, asm);
    mn(b"movswq", X_MOVX, 8, 0x0fbf, asm);
    mn(b"movslq", X_MOVX, 8, 0x63, asm);
    mn(b"cqto", X_CQTO, 8, 0, asm);
    mn(b"btcq", X_BT, 8, 7, asm);
    mn(b"btsq", X_BT, 8, 5, asm);
    mn(b"btrq", X_BT, 8, 6, asm);
    mn(b"btq", X_BT, 8, 4, asm);
    let conds: [&[u8]; 16] = [b"o", b"no", b"b", b"ae", b"e", b"ne", b"be", b"a", b"s", b"ns",
        b"p", b"np", b"l", b"ge", b"le", b"g"];
    for cc in 0..16 {
        mn(joined(b"set", conds[cc as usize], &mut room), X_SETCC, 1, cc, asm);
        mn(joined(b"j", conds[cc as usize], &mut room), X_JCC, 0, cc, asm);
        let mut cmov_room = [0u8; 32];
        let cmov = joined(b"cmov", conds[cc as usize], &mut cmov_room);
        mn(joined(cmov, b"q", &mut room), X_CMOVCC, 8, cc, asm);
        mn(joined(cmov, b"l", &mut room), X_CMOVCC, 4, cc, asm);
    }
    mn(b"jmp", X_JMP, 0, 0, asm);
    mn(b"call", X_CALL, 0, 0, asm);
    mn(b"ret", X_RET, 0, 0, asm);
    mn(b"retq", X_RET, 0, 0, asm);
    mn(b"ud2", X_UD2, 0, 0, asm);
    sse(b"addsd", X_SSE, 0xf2, 0x58, asm);
    sse(b"mulsd", X_SSE, 0xf2, 0x59, asm);
    sse(b"subsd", X_SSE, 0xf2, 0x5c, asm);
    sse(b"divsd", X_SSE, 0xf2, 0x5e, asm);
    sse(b"sqrtsd", X_SSE, 0xf2, 0x51, asm);
    sse(b"addss", X_SSE, 0xf3, 0x58, asm);
    sse(b"mulss", X_SSE, 0xf3, 0x59, asm);
    sse(b"subss", X_SSE, 0xf3, 0x5c, asm);
    sse(b"divss", X_SSE, 0xf3, 0x5e, asm);
    sse(b"sqrtss", X_SSE, 0xf3, 0x51, asm);
    sse(b"movapd", X_SSE, 0x66, 0x28, asm);
    sse(b"movaps", X_SSE, 0, 0x28, asm);
    sse(b"xorpd", X_SSE, 0x66, 0x57, asm);
    sse(b"xorps", X_SSE, 0, 0x57, asm);
    sse(b"ucomisd", X_SSE, 0x66, 0x2e, asm);
    sse(b"ucomiss", X_SSE, 0, 0x2e, asm);
    sse(b"cvtss2sd", X_SSE, 0xf3, 0x5a, asm);
    sse(b"cvtsd2ss", X_SSE, 0xf2, 0x5a, asm);
    sse(b"movsd", X_SSEMOV, 0xf2, 0x10, asm);
    sse(b"movss", X_SSEMOV, 0xf3, 0x10, asm);
    sse(b"cvtsi2sdq", X_CVTSI2, 0xf2, 0x2a, asm);
    sse(b"cvtsi2ssq", X_CVTSI2, 0xf3, 0x2a, asm);
    sse(b"cvtsi2sdl", X_CVTSI2, 0xf2, 0x2a, asm);
    sse(b"cvtsi2ssl", X_CVTSI2, 0xf3, 0x2a, asm);
    sse(b"cvttsd2si", X_CVTT2SI, 0xf2, 0x2c, asm);
    sse(b"cvttss2si", X_CVTT2SI, 0xf3, 0x2c, asm);
    sse(b"cvttsd2siq", X_CVTT2SI, 0xf2, 0x2c, asm);
    sse(b"cvttss2siq", X_CVTT2SI, 0xf3, 0x2c, asm);
    mn(b"movd", X_MOVD, 0, 0, asm);
    // Vectors (0.10): SSE2.
    let packed: [&[u8]; 33] = [b"addpd", b"addps", b"subpd", b"subps", b"mulpd", b"mulps",
        b"divpd", b"divps", b"paddb", b"paddw", b"paddd", b"paddq", b"psubb", b"psubw",
        b"psubd", b"psubq", b"pmullw", b"pand", b"pandn", b"por", b"pxor", b"pcmpeqb",
        b"pcmpeqw", b"pcmpeqd", b"pcmpgtb", b"pcmpgtw", b"pcmpgtd", b"punpcklbw",
        b"punpcklwd", b"punpckldq", b"punpcklqdq", b"unpcklpd", b"movdqa"];
    let pfx: [i64; 33] = [0x66i64, 0, 0x66, 0, 0x66, 0, 0x66, 0, 0x66, 0x66, 0x66, 0x66, 0x66,
        0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66,
        0x66, 0x66, 0x66, 0x66, 0x66, 0x66];
    let ops: [i64; 33] = [0x58i64, 0x58, 0x5c, 0x5c, 0x59, 0x59, 0x5e, 0x5e, 0xfc, 0xfd, 0xfe,
        0xd4, 0xf8, 0xf9, 0xfa, 0xfb, 0xd5, 0xdb, 0xdf, 0xeb, 0xef, 0x74, 0x75, 0x76, 0x64,
        0x65, 0x66, 0x60, 0x61, 0x62, 0x6c, 0x14, 0x6f];
    for i in 0..33 {
        sse(packed[i as usize], X_SSE, pfx[i as usize], ops[i as usize], asm);
    }
    sse(b"movups", X_SSEMOV, 0, 0x10, asm);
    sse(b"pshufd", X_SSEI, 0x66, 0x70, asm);
    sse(b"shufps", X_SSEI, 0, 0xc6, asm);
    sse(b"cmppd", X_SSEI, 0x66, 0xc2, asm);
    sse(b"cmpps", X_SSEI, 0, 0xc2, asm);
    // (0.19: by an xmm count too, opcode arg >> 24: F3, F2)
    mn(b"psllq", X_SSESHIFT, 16, 0xf3 << 24 | 6 << 16 | 0x73, asm);
    mn(b"pslld", X_SSESHIFT, 16, 0xf2 << 24 | 6 << 16 | 0x72, asm);
    mn(b"vmovdqu", X_VMOV, 32, 0xf3, asm);
    mn(b"vmovdqa", X_VMOV, 32, 0x66, asm);
    mn(b"vzeroupper", X_VZEROUPPER, 0, 0, asm);
}

// ---- Operands ----

fn ch(i: i64, asm: &mut Asm<Comp>) -> u8 {
    asm.text[i as usize]
}

// The register `%name` at [a, b) into op; false if unknown.
fn parse_xreg(a: i64, b: i64, op: &mut XOp, asm: &mut Asm<Comp>) -> bool {
    if ch(a, asm) != b'%' {
        return false;
    }
    let v = names_get(&asm.xregs,
        &asm.text[(a + 1) as usize..b as usize]);
    if v == 0 {
        return false;
    }
    let e = v - 1;
    op.reg = e & 31;
    op.size = if ((e >> 12) & 1) != 0 { 32 } else { (e >> 5) & 31 };
    op.rex8 = ((e >> 10) & 1) != 0;
    op.xmm = ((e >> 11) & 1) != 0;
    true
}

fn parse_xsym(a: i64, b: i64, op: &mut XOp, asm: &mut Asm<Comp>) {
    let mut at = a;
    while at < b && ch(at, asm) != b'@' {
        at += 1;
    }
    op.sym = asym_text(a, at, asm);
    op.modifier = MOD_NONE;
    if at < b {
        if text_is(at + 1, b, b"PLT", asm) {
            op.modifier = MOD_PLT;
        } else if text_is(at + 1, b, b"GOTPCREL", asm) {
            op.modifier = MOD_GOTPCREL;
        } else {
            asm_error("unknown symbol modifier", asm);
        }
    }
}

fn parse_xop(k: i64, asm: &mut Asm<Comp>) {
    let a = asm.op_start[k as usize];
    let b = asm.op_end[k as usize];
    let mut op = XOp {
        kind: 0, reg: -1, size: 0, xmm: false, rex8: false, imm: 0, index: -1, scale: 1,
        sym: -1, modifier: 0,
    };
    let c = ch(a, asm);
    if c == b'%' {
        if !parse_xreg(a, b, &mut op, asm) {
            asm_error("unknown register", asm);
        }
        op.kind = K_REG;
    } else if c == b'$' {
        op.kind = K_IMM;
        op.imm = parse_number(a + 1, b, asm);
    } else if c == b'*' {
        op.kind = K_IND;
        if !parse_xreg(a + 1, b, &mut op, asm) {
            asm_error("unknown register", asm);
        }
    } else {
        let mut paren = a;
        while paren < b && ch(paren, asm) != b'(' {
            paren += 1;
        }
        if paren == b {
            op.kind = K_SYM;
            parse_xsym(a, b, &mut op, asm);
        } else {
            op.kind = K_MEM;
            if paren > a {
                if is_digit_start(ch(a, asm)) {
                    op.imm = parse_number(a, paren, asm);
                } else {
                    parse_xsym(a, paren, &mut op, asm);
                }
            }
            // (base[,index[,scale]])
            let close = b - 1;
            if ch(close, asm) != b')' {
                asm_error("bad memory operand", asm);
            }
            let mut i = paren + 1;
            let mut j = i;
            while j < close && ch(j, asm) != b',' {
                j += 1;
            }
            let mut tmp = XOp {
                kind: 0, reg: -1, size: 0, xmm: false, rex8: false, imm: 0, index: -1, scale: 1,
                sym: -1, modifier: 0,
            };
            if j > i {
                if !parse_xreg(i, j, &mut tmp, asm) {
                    asm_error("bad base register", asm);
                }
                op.reg = tmp.reg;
            }
            if j < close {
                i = j + 1;
                j = i;
                while j < close && ch(j, asm) != b',' {
                    j += 1;
                }
                if !parse_xreg(i, j, &mut tmp, asm) {
                    asm_error("bad index register", asm);
                }
                op.index = tmp.reg;
                if j < close {
                    op.scale = parse_number(j + 1, close, asm);
                }
            }
        }
    }
    asm.x86[k as usize] = op;
}

// ---- Encoding ----

fn fits8(v: i64) -> bool {
    v >= -128 && v <= 127
}

fn emit_imm(v: i64, size: i64, asm: &mut Asm<Comp>) {
    if size == 1 { out8(v, asm); } else if size == 2 { out16(v, asm); }
    else if size == 4 { out32(v, asm); } else if size == 8 { out64(v, asm); }
}

// One instruction with a ModRM byte: legacy prefix `pfx` (0, 0x66, 0xf2,
// 0xf3; 0x66 also for 16-bit operands via `op16`), REX (W from `w`, R
// from `reg`, X and B from the r/m operand `rm`, or forced), `opcode`
// (1 to 3 bytes, big-endian in `oplen`), ModRM with `reg` (a register or
// an opcode digit) and operand rm, then an immediate of `imm_size` bytes.
fn enc(pfx: i64, op16: bool, w: bool, opcode: i64, oplen: i64, reg: i64, rm: XOp,
    force_rex: bool, imm: i64, imm_size: i64, asm: &mut Asm<Comp>) {
    if op16 {
        out8(0x66, asm);
    }
    if pfx != 0 {
        out8(pfx, asm);
    }
    let mut rex: i64 = 0;
    if w {
        rex = rex | 8;
    }
    if reg >= 8 {
        rex = rex | 4;
    }
    if rm.kind == K_MEM {
        if rm.index >= 8 {
            rex = rex | 2;
        }
        if rm.reg >= 8 && rm.reg != 16 {
            rex = rex | 1;
        }
    } else if rm.reg >= 8 {
        rex = rex | 1;
    }
    if rex != 0 || force_rex || (rm.kind == K_REG && rm.rex8) {
        out8(0x40 | rex, asm);
    }
    if oplen == 3 {
        out8(opcode >> 16, asm);
    }
    if oplen >= 2 {
        out8(opcode >> 8, asm);
    }
    out8(opcode, asm);
    modrm(reg, rm, imm, imm_size, rex != 0, asm);
}

// The ModRM byte with `reg` and operand rm (and its SIB, displacement or
// %rip fixup), then an immediate of `imm_size` bytes; `rex`: whether the
// instruction has a REX prefix (a GOT load's relocation says so).
fn modrm(reg: i64, rm: XOp, imm: i64, imm_size: i64, rex: bool, asm: &mut Asm<Comp>) {
    let r = (reg & 7) << 3;
    if rm.kind != K_MEM {
        out8(0xc0 | r | (rm.reg & 7), asm);
        emit_imm(imm, imm_size, asm);
        return;
    }
    if rm.reg == 16 {
        // %rip: disp32 after ModRM (the end of the instruction is pc).
        out8(r | 5, asm);
        let pos = here(asm);
        if rm.sym >= 0 {
            let kind = if rm.modifier == MOD_GOTPCREL { FX_X86_GOT } else { FX_X86_RIP };
            fixup(kind, pos, rm.sym, rm.imm, pos + 4 + imm_size, rex, asm);
            out32(0, asm);
        } else {
            out32(rm.imm, asm);
        }
        emit_imm(imm, imm_size, asm);
        return;
    }
    if rm.sym >= 0 {
        asm_error("a symbol needs %rip", asm);
    }
    let base = rm.reg;
    let disp = rm.imm;
    let need_sib = rm.index >= 0 || (base & 7) == 4;
    let md: i64 = if disp == 0 && (base & 7) != 5 { 0 } else if fits8(disp) { 1 } else { 2 };
    if need_sib {
        out8(md << 6 | r | 4, asm);
        let ss: i64 = if rm.scale == 8 { 3 } else if rm.scale == 4 { 2 } else if rm.scale == 2 { 1 }
            else { 0 };
        let idx: i64 = if rm.index >= 0 { rm.index & 7 } else { 4 };
        out8(ss << 6 | idx << 3 | (base & 7), asm);
    } else {
        out8(md << 6 | r | (base & 7), asm);
    }
    if md == 1 {
        out8(disp, asm);
    } else if md == 2 {
        out32(disp, asm);
    }
    emit_imm(imm, imm_size, asm);
}

// (0.19) One VEX-encoded instruction (AVX, AVX2, FMA, BMI): the prefix
// from the mandatory prefix `pfx` (0, 0x66, 0xf3, 0xf2), the opcode map
// `map` (0x0f, 0x0f38, 0x0f3a), W, L (256 bits), the ModRM `reg`, the
// second source `vvvv` (0 when the instruction has none: 1111 encoded),
// operand rm; then `opcode`, ModRM and the immediate. The two-byte form
// (C5) when the map is 0F, W is 0 and rm needs neither X nor B, as the
// assemblers choose.
fn vex(pfx: i64, map: i64, w: bool, l: bool, opcode: i64, reg: i64, vvvv: i64, rm: XOp,
    imm: i64, imm_size: i64, asm: &mut Asm<Comp>) {
    let pp: i64 = if pfx == 0x66 { 1 } else if pfx == 0xf3 { 2 } else if pfx == 0xf2 { 3 }
        else { 0 };
    let mm: i64 = if map == 0x0f38 { 2 } else if map == 0x0f3a { 3 } else { 1 };
    let mut x = false;
    let mut b = false;
    if rm.kind == K_MEM {
        x = rm.index >= 8;
        b = rm.reg >= 8 && rm.reg != 16;
    } else {
        b = rm.reg >= 8;
    }
    let r = reg >= 8;
    let tail = ((15 - (vvvv & 15)) << 3) | (if l { 4 } else { 0 }) | pp;
    if mm == 1 && !w && !x && !b {
        out8(0xc5, asm);
        out8((if r { 0 } else { 0x80 }) | tail, asm);
    } else {
        out8(0xc4, asm);
        out8((if r { 0 } else { 0x80 }) | (if x { 0 } else { 0x40 }) | (if b { 0 } else { 0x20 })
            | mm,
            asm);
        out8((if w { 0x80 } else { 0 }) | tail, asm);
    }
    out8(opcode, asm);
    modrm(reg, rm, imm, imm_size, false, asm);
}

fn need_ops(n: i64, asm: &mut Asm<Comp>) {
    if asm.op_count != n {
        asm_error("wrong number of operands", asm);
    }
}

// Whether a byte register operand forces a REX prefix.
fn rex8(k: i64, asm: &mut Asm<Comp>) -> bool {
    k < asm.op_count && asm.x86[k as usize].kind == K_REG
        && asm.x86[k as usize].rex8
}

// size-dependent opcode: the byte form is one less (00/01, 88/89, 84/85...).
fn sized(op: i64, size: i64) -> i64 {
    if size == 1 { op - 1 } else { op }
}

fn alu(digit: i64, size: i64, asm: &mut Asm<Comp>) {
    need_ops(2, asm);
    let src = asm.x86[0];
    let dst = asm.x86[1];
    let w = size == 8;
    let op16 = size == 2;
    let base = digit << 3;
    if src.kind == K_IMM {
        let v = src.imm;
        if size == 1 {
            if dst.kind == K_REG && dst.reg == 0 {
                out8(base + 4, asm);
                out8(v, asm);
            } else {
                enc(0, false, false, 0x80, 1, digit, dst, rex8(1, asm), v, 1, asm);
            }
        } else if fits8(v) {
            enc(0, op16, w, 0x83, 1, digit, dst, false, v, 1, asm);
        } else if dst.kind == K_REG && dst.reg == 0 {
            if op16 {
                out8(0x66, asm);
            }
            if w {
                out8(0x48, asm);
            }
            out8(base + 5, asm);
            emit_imm(v, if size == 2 { 2 } else { 4 }, asm);
        } else {
            enc(0, op16, w, 0x81, 1, digit, dst, false, v, if size == 2 { 2 } else { 4 }, asm);
        }
        return;
    }
    if dst.kind == K_MEM {
        enc(0, op16, w, sized(base + 1, size), 1, src.reg, dst, rex8(0, asm), 0, 0, asm);
    } else if src.kind == K_MEM {
        enc(0, op16, w, sized(base + 3, size), 1, dst.reg, src, rex8(1, asm), 0, 0, asm);
    } else {
        enc(0, op16, w, sized(base + 1, size), 1, src.reg, dst, rex8(0, asm) || rex8(1, asm),
            0, 0, asm);
    }
}

fn mov(size: i64, asm: &mut Asm<Comp>) {
    need_ops(2, asm);
    let src = asm.x86[0];
    let dst = asm.x86[1];
    if src.xmm || dst.xmm {
        movd(asm);
        return;
    }
    let w = size == 8;
    let op16 = size == 2;
    if src.kind == K_IMM {
        if dst.kind == K_REG && size != 8 {
            // B8+r (B0+r for bytes) with an immediate of the operand size.
            if op16 {
                out8(0x66, asm);
            }
            if dst.reg >= 8 || dst.rex8 {
                out8(0x40 | (if dst.reg >= 8 { 1 } else { 0 }), asm);
            }
            out8((if size == 1 { 0xb0 } else { 0xb8 }) + (dst.reg & 7), asm);
            emit_imm(src.imm, size, asm);
            return;
        }
        enc(0, op16, w, sized(0xc7, size), 1, 0, dst, rex8(1, asm), src.imm,
            if size == 8 { 4 } else { size }, asm);
        return;
    }
    if src.kind == K_MEM {
        enc(0, op16, w, sized(0x8b, size), 1, dst.reg, src, rex8(1, asm), 0, 0, asm);
    } else {
        enc(0, op16, w, sized(0x89, size), 1, src.reg, dst, rex8(0, asm) || rex8(1, asm), 0,
            0, asm);
    }
}

// movd/movq between general and xmm registers.
fn movd(asm: &mut Asm<Comp>) {
    let src = asm.x86[0];
    let dst = asm.x86[1];
    if src.xmm && dst.xmm {
        // movq %xmm, %xmm: F3 0F 7E
        enc(0xf3, false, false, 0x0f7e, 2, dst.reg, src, false, 0, 0, asm);
    } else if dst.xmm {
        enc(0x66, false, src.size == 8, 0x0f6e, 2, dst.reg, src, false, 0, 0, asm);
    } else {
        enc(0x66, false, dst.size == 8, 0x0f7e, 2, src.reg, dst, false, 0, 0, asm);
    }
}

fn shift(digit: i64, size: i64, asm: &mut Asm<Comp>) {
    let w = size == 8;
    if asm.op_count == 1 {
        enc(0, size == 2, w, sized(0xd1, size), 1, digit, asm.x86[0], rex8(0, asm),
            0, 0, asm);
        return;
    }
    let src = asm.x86[0];
    let dst = asm.x86[1];
    if src.kind == K_IMM {
        if src.imm == 1 {
            enc(0, size == 2, w, sized(0xd1, size), 1, digit, dst, rex8(1, asm), 0, 0, asm);
        } else {
            enc(0, size == 2, w, sized(0xc1, size), 1, digit, dst, rex8(1, asm), src.imm, 1,
                asm);
        }
    } else {
        // by %cl
        enc(0, size == 2, w, sized(0xd3, size), 1, digit, dst, rex8(1, asm), 0, 0, asm);
    }
}

fn branch_target(k: i64, asm: &mut Asm<Comp>) -> i64 {
    if asm.x86[k as usize].kind != K_SYM {
        asm_error("expected a label", asm);
    }
    asm.x86[k as usize].sym
}

// (0.19) The intrinsics' instructions the table above lacks
// (compiler/arch/insn_x86.def, arch/table.vl): the class gives the
// operands' order (AT&T: sources first), the line the mandatory prefix,
// the opcode map (0f, 0f38, 0f3a), the opcode and the flags (`w`: REX.W or
// VEX.W1; `o16`: the 0x66 operand-size prefix; `/N`: ModRM.reg is the
// digit N; `i=XX`: a shift's immediate form, opcode XX with the digit; `c`:
// commutative, `cmp`: commutative for the symmetric predicates; both swap
// the sources when that saves VEX's third byte, as the assemblers do).
// Legacy SSE classes: `sse` (src, dst), `ssei` ($imm, src, dst), `sser`
// (reg, r/m: a register written to r/m), `sseir` ($imm, reg, r/m),
// `shift` ($imm or %xmm, dst), `sse0` (%xmm0, src, dst: xmm0 implicit).
// VEX classes: `vex` (src2, src1, dst: r/m, vvvv, reg), `vexv` (vvvv, r/m,
// reg), `vex2` (src, dst; no vvvv), `vex2r` (reg, r/m), `vexi` ($imm, r/m,
// vvvv, reg), `vex2i` ($imm, r/m, reg), `vex2ir` ($imm, reg, r/m),
// `vexshift` ($imm, src, dst: vvvv = dst, r/m = src; or %xmm count, src,
// dst), `vex4` (mask, r/m, vvvv, reg: the mask in the immediate's top
// nibble), `vexd` (src, dst: vvvv = dst, r/m = src, reg = the digit). L is
// 1 when an operand is a ymm register. False when the table has no such
// mnemonic.
fn x86_table_instruction(name: &[u8], asm: &mut Asm<Comp>) -> bool {
    let k = insn_named(name);
    if k < 0 {
        return false;
    }
    let class = insn_text(k, 1);
    let pfx = insn_hex(k, 2);
    let map = insn_hex(k, 3);
    let opcode = insn_hex(k, 4);
    let flags = insn_text(k, 5);
    let w = has_word(flags, b"w");
    let op16 = has_word(flags, b"o16");
    let digit = word_value(flags, b'/');
    let oplen: i64 = if map == 0x0f { 2 } else { 3 };
    let full = map << 8 | opcode;
    let mut l = false;
    for i in 0..asm.op_count {
        if asm.x86[i as usize].kind == K_REG
            && asm.x86[i as usize].size == 32 {
            l = true;
        }
    }
    let any_rex8 = rex8(0, asm) || rex8(1, asm) || rex8(2, asm);
    if class == b"sse" {
        need_ops(2, asm);
        enc(pfx, op16, w, full, oplen, asm.x86[1].reg, asm.x86[0], any_rex8,
            0, 0, asm);
    } else if class == b"ssei" {
        need_ops(3, asm);
        enc(pfx, op16, w, full, oplen, asm.x86[2].reg, asm.x86[1], any_rex8,
            asm.x86[0].imm, 1, asm);
    } else if class == b"sser" {
        need_ops(2, asm);
        enc(pfx, op16, w, full, oplen, asm.x86[0].reg, asm.x86[1], any_rex8,
            0, 0, asm);
    } else if class == b"sseir" {
        need_ops(3, asm);
        enc(pfx, op16, w, full, oplen, asm.x86[1].reg, asm.x86[2], any_rex8,
            asm.x86[0].imm, 1, asm);
    } else if class == b"shift" {
        need_ops(2, asm);
        if asm.x86[0].kind == K_IMM {
            enc(pfx, false, w, 0x0f00 | word_value(flags, b'='), 2, digit, asm.x86[1],
                false, asm.x86[0].imm, 1, asm);
        } else {
            enc(pfx, false, w, full, oplen, asm.x86[1].reg, asm.x86[0],
                false, 0, 0, asm);
        }
    } else if class == b"sse0" {
        need_ops(3, asm);
        if asm.x86[0].kind != K_REG || asm.x86[0].reg != 0
            || !asm.x86[0].xmm {
            asm_error("this instruction's first operand is %xmm0", asm);
        }
        enc(pfx, false, w, full, oplen, asm.x86[2].reg, asm.x86[1], false,
            0, 0, asm);
    } else if class == b"vex" || class == b"vexi" {
        let imm = class == b"vexi";
        let at: i64 = if imm { 1 } else { 0 };
        need_ops(at + 3, asm);
        let mut src2 = asm.x86[at as usize];
        let mut src1 = asm.x86[(at + 1) as usize];
        // (LLVM's assembler swaps the sources of a commutative operation
        // when only the second is r8-r15: VEX.R is in the short prefix,
        // VEX.B is not)
        let commutes = has_word(flags, b"c")
            || (has_word(flags, b"cmp") && (asm.x86[0].imm & 7) % 4 == 0
                || has_word(flags, b"cmp") && (asm.x86[0].imm & 7) % 4 == 3);
        if commutes && map == 0x0f && !w && src2.kind == K_REG && src2.reg >= 8
            && src1.reg < 8 {
            let t = src2;
            src2 = src1;
            src1 = t;
        }
        vex(pfx, map, w, l, opcode, asm.x86[(at + 2) as usize].reg, src1.reg, src2,
            if imm { asm.x86[0].imm } else { 0 }, if imm { 1 } else { 0 }, asm);
    } else if class == b"vexv" {
        need_ops(3, asm);
        vex(pfx, map, w, l, opcode, asm.x86[2].reg, asm.x86[0].reg,
            asm.x86[1], 0, 0, asm);
    } else if class == b"vex2" {
        need_ops(2, asm);
        vex(pfx, map, w, l, opcode, asm.x86[1].reg, 0, asm.x86[0], 0, 0,
            asm);
    } else if class == b"vex2r" {
        need_ops(2, asm);
        vex(pfx, map, w, l, opcode, asm.x86[0].reg, 0, asm.x86[1], 0, 0,
            asm);
    } else if class == b"vex2i" {
        need_ops(3, asm);
        vex(pfx, map, w, l, opcode, asm.x86[2].reg, 0, asm.x86[1],
            asm.x86[0].imm, 1, asm);
    } else if class == b"vex2ir" {
        need_ops(3, asm);
        vex(pfx, map, w, l, opcode, asm.x86[1].reg, 0, asm.x86[2],
            asm.x86[0].imm, 1, asm);
    } else if class == b"vexshift" {
        need_ops(3, asm);
        if asm.x86[0].kind == K_IMM {
            vex(pfx, map, w, l, word_value(flags, b'='), digit, asm.x86[2].reg,
                asm.x86[1], asm.x86[0].imm, 1, asm);
        } else {
            vex(pfx, map, w, l, opcode, asm.x86[2].reg, asm.x86[1].reg,
                asm.x86[0], 0, 0, asm);
        }
    } else if class == b"vex4" {
        need_ops(4, asm);
        vex(pfx, map, w, l, opcode, asm.x86[3].reg, asm.x86[2].reg,
            asm.x86[1], asm.x86[0].reg << 4, 1, asm);
    } else if class == b"vexd" {
        need_ops(2, asm);
        vex(pfx, map, w, l, opcode, digit, asm.x86[1].reg, asm.x86[0], 0,
            0, asm);
    } else {
        asm_error("internal error: an instruction class the encoder does not know", asm);
    }
    true
}

// Whether the space-separated `flags` hold `word`.
fn has_word(flags: &[u8], word: &[u8]) -> bool {
    let mut i: i64 = 0;
    let n = flags.len() as i64;
    while i < n {
        let mut j = i;
        while j < n && flags[j as usize] != b' ' {
            j += 1;
        }
        if &flags[i as usize..j as usize] == word {
            return true;
        }
        i = j + 1;
    }
    false
}

// The hexadecimal number after `mark` in `flags` (`/2`: 2, `i=71`: 0x71),
// 0 when there is none.
fn word_value(flags: &[u8], mark: u8) -> i64 {
    let n = flags.len() as i64;
    for i in 0..n {
        if flags[i as usize] == mark {
            let mut v: i64 = 0;
            let mut j = i + 1;
            while j < n && flags[j as usize] != b' ' {
                let c = flags[j as usize];
                v = v * 16 + (if c >= b'a' { (c - b'a') as i64 + 10 } else { (c - b'0') as i64 });
                j += 1;
            }
            return v;
        }
    }
    0
}

// (0.21) The atomic instructions (mc_x86_64/atomic.vl writes them): the
// `lock` prefix on a line of its own, xadd, cmpxchg and xchg of a register
// into memory (b w l q), mfence, pause. Whether `name` was one.
fn x86_atomic(name: &[u8], asm: &mut Asm<Comp>) -> bool {
    if name == b"lock" {
        out8(0xf0, asm);
        return true;
    }
    if name == b"mfence" {
        out8(0x0f, asm);
        out8(0xae, asm);
        out8(0xf0, asm);
        return true;
    }
    if name == b"pause" {
        out8(0xf3, asm);
        out8(0x90, asm);
        return true;
    }
    if name.len() < 5 {
        return false;
    }
    let base = &name[0..(name.len() as i64 - 1) as usize];
    let s = name[(name.len() as i64 - 1) as usize];
    let size: i64 = if s == b'b' { 1 } else if s == b'w' { 2 } else if s == b'l' { 4 }
        else if s == b'q' { 8 } else { 0 };
    if size == 0 {
        return false;
    }
    let opcode: i64 = if base == b"xadd" { 0x0fc1 } else if base == b"cmpxchg" { 0x0fb1 }
        else if base == b"xchg" { 0x87 } else { 0 };
    if opcode == 0 {
        return false;
    }
    need_ops(2, asm);
    let oplen: i64 = if opcode > 0xff { 2 } else { 1 };
    enc(0, size == 2, size == 8, sized(opcode, size), oplen, asm.x86[0].reg,
        asm.x86[1], rex8(0, asm), 0, 0, asm);
    true
}

pub fn x86_instruction(a: i64, b: i64, asm: &mut Asm<Comp>) {
    let mut room = [0u8; 32];
    let name_len = mnemonic_copy(a, b, &mut room, asm);
    let name = &room[..name_len];
    for k in 0..asm.op_count {
        parse_xop(k, asm);
    }
    let v = names_get(&asm.xmn,
        name);
    if v == 0
        && x86_table_instruction(name,
            asm) {
        return;
    }
    if v == 0
        && x86_atomic(name,
            asm) {
        return;
    }
    if v == 0 {
        asm_error("unknown instruction", asm);
    }
    let e = v - 1;
    let class = e & 255;
    let size = (e >> 8) & 255;
    let arg = e >> 16;
    let w = size == 8;
    if class == X_ALU {
        alu(arg, size, asm);
    } else if class == X_TEST {
        need_ops(2, asm);
        let src = asm.x86[0];
        let dst = asm.x86[1];
        if src.kind == K_IMM {
            if dst.kind == K_REG && dst.reg == 0 {
                if size == 2 {
                    out8(0x66, asm);
                }
                if w {
                    out8(0x48, asm);
                }
                out8(if size == 1 { 0xa8 } else { 0xa9 }, asm);
                emit_imm(src.imm, if size == 8 { 4 } else { size }, asm);
            } else {
                enc(0, size == 2, w, sized(0xf7, size), 1, 0, dst, rex8(1, asm), src.imm,
                    if size == 8 { 4 } else { size }, asm);
            }
        } else {
            enc(0, size == 2, w, sized(0x85, size), 1, src.reg, dst,
                rex8(0, asm) || rex8(1, asm), 0, 0, asm);
        }
    } else if class == X_MOV {
        mov(size, asm);
    } else if class == X_MOVABS {
        need_ops(2, asm);
        let dst = asm.x86[1];
        out8(0x48 | (if dst.reg >= 8 { 1 } else { 0 }), asm);
        out8(0xb8 + (dst.reg & 7), asm);
        out64(asm.x86[0].imm, asm);
    } else if class == X_MOVX {
        need_ops(2, asm);
        let oplen: i64 = if arg > 0xff { 2 } else { 1 };
        enc(0, false, w, arg, oplen, asm.x86[1].reg, asm.x86[0],
            rex8(0, asm), 0, 0, asm);
    } else if class == X_LEA {
        need_ops(2, asm);
        enc(0, size == 2, w, 0x8d, 1, asm.x86[1].reg, asm.x86[0], false, 0,
            0, asm);
    } else if class == X_SHIFT {
        shift(arg, size, asm);
    } else if class == X_IMUL {
        if asm.op_count == 3 {
            let imm = asm.x86[0].imm;
            if fits8(imm) {
                enc(0, size == 2, w, 0x6b, 1, asm.x86[2].reg, asm.x86[1],
                    false, imm, 1, asm);
            } else {
                enc(0, size == 2, w, 0x69, 1, asm.x86[2].reg, asm.x86[1],
                    false, imm, if size == 2 { 2 } else { 4 }, asm);
            }
        } else if asm.op_count == 2 {
            enc(0, size == 2, w, 0x0faf, 2, asm.x86[1].reg, asm.x86[0],
                false, 0, 0, asm);
        } else {
            enc(0, size == 2, w, sized(0xf7, size), 1, 5, asm.x86[0], rex8(0, asm),
                0, 0, asm);
        }
    } else if class == X_F7 {
        need_ops(1, asm);
        enc(0, size == 2, w, sized(0xf7, size), 1, arg, asm.x86[0], rex8(0, asm), 0,
            0, asm);
    } else if class == X_CQTO {
        out8(0x48, asm);
        out8(0x99, asm);
    } else if class == X_BT {
        need_ops(2, asm);
        enc(0, false, w, 0x0fba, 2, arg, asm.x86[1], false, asm.x86[0].imm,
            1, asm);
    } else if class == X_SETCC {
        need_ops(1, asm);
        enc(0, false, false, 0x0f90 + arg, 2, 0, asm.x86[0], rex8(0, asm), 0, 0, asm);
    } else if class == X_CMOVCC {
        need_ops(2, asm);
        enc(0, false, w, 0x0f40 + arg, 2, asm.x86[1].reg, asm.x86[0], false,
            0, 0, asm);
    } else if class == X_JCC {
        need_ops(1, asm);
        emit_relaxable(TAIL_JCC, arg, branch_target(0, asm), asm);
    } else if class == X_JMP {
        need_ops(1, asm);
        if asm.x86[0].kind == K_IND {
            enc(0, false, false, 0xff, 1, 4, reg_operand(0, asm), false, 0, 0, asm);
        } else {
            emit_relaxable(TAIL_JMP, 0, branch_target(0, asm), asm);
        }
    } else if class == X_CALL {
        need_ops(1, asm);
        if asm.x86[0].kind == K_IND {
            enc(0, false, false, 0xff, 1, 2, reg_operand(0, asm), false, 0, 0, asm);
        } else {
            out8(0xe8, asm);
            let pos = here(asm);
            fixup(FX_X86_BRANCH, pos, branch_target(0, asm), 0, pos + 4, false, asm);
            out32(0, asm);
        }
    } else if class == X_PUSH || class == X_POP {
        need_ops(1, asm);
        let reg = asm.x86[0].reg;
        if reg >= 8 {
            out8(0x41, asm);
        }
        out8((if class == X_PUSH { 0x50 } else { 0x58 }) + (reg & 7), asm);
    } else if class == X_RET {
        out8(0xc3, asm);
    } else if class == X_UD2 {
        out8(0x0f, asm);
        out8(0x0b, asm);
    } else if class == X_SSE {
        need_ops(2, asm);
        let pfx = arg >> 8;
        enc(pfx, false, false, 0x0f00 | (arg & 255), 2, asm.x86[1].reg,
            asm.x86[0], false, 0, 0, asm);
    } else if class == X_SSEMOV {
        need_ops(2, asm);
        let pfx = arg >> 8;
        if asm.x86[1].kind == K_MEM {
            enc(pfx, false, false, 0x0f11, 2, asm.x86[0].reg, asm.x86[1],
                false, 0, 0, asm);
        } else {
            enc(pfx, false, false, 0x0f10, 2, asm.x86[1].reg, asm.x86[0],
                false, 0, 0, asm);
        }
    } else if class == X_CVTSI2 {
        need_ops(2, asm);
        let pfx = arg >> 8;
        let wide = asm.x86[0].kind == K_REG && asm.x86[0].size == 8
            || text_is(b - 1, b, b"q", asm);
        enc(pfx, false, wide, 0x0f2a, 2, asm.x86[1].reg, asm.x86[0], false,
            0, 0, asm);
    } else if class == X_CVTT2SI {
        need_ops(2, asm);
        let pfx = arg >> 8;
        enc(pfx, false, asm.x86[1].size == 8, 0x0f2c, 2, asm.x86[1].reg,
            asm.x86[0], false, 0, 0, asm);
    } else if class == X_MOVD {
        need_ops(2, asm);
        movd(asm);
    } else if class == X_SSEI {
        need_ops(3, asm);
        let pfx = arg >> 8;
        enc(pfx, false, false, 0x0f00 | (arg & 255), 2, asm.x86[2].reg,
            asm.x86[1], false, asm.x86[0].imm, 1, asm);
    } else if class == X_VMOV {
        // (load 6F, store 7F; between registers the store form when only
        // the source is r8-r15, which keeps the short prefix, as LLVM does)
        need_ops(2, asm);
        let l = asm.x86[0].size == 32 || asm.x86[1].size == 32;
        if asm.x86[1].kind == K_MEM
            || (asm.x86[0].kind == K_REG && asm.x86[0].reg >= 8
                && asm.x86[1].reg < 8) {
            vex(arg, 0x0f, false, l, 0x7f, asm.x86[0].reg, 0, asm.x86[1],
                0, 0, asm);
        } else {
            vex(arg, 0x0f, false, l, 0x6f, asm.x86[1].reg, 0, asm.x86[0],
                0, 0, asm);
        }
    } else if class == X_VZEROUPPER {
        out8(0xc5, asm);
        out8(0xf8, asm);
        out8(0x77, asm);
    } else if class == X_SSESHIFT && asm.x86[0].kind != K_IMM {
        need_ops(2, asm);
        enc(0x66, false, false, 0x0f00 | (arg >> 24), 2, asm.x86[1].reg,
            asm.x86[0], false, 0, 0, asm);
    } else if class == X_SSESHIFT {
        need_ops(2, asm);
        enc(0x66, false, false, 0x0f00 | (arg & 255), 2, (arg >> 16) & 255,
            asm.x86[1], false, asm.x86[0].imm, 1, asm);
    } else {
        asm_error("unknown instruction", asm);
    }
}

// `*%reg` as a register r/m operand.
fn reg_operand(k: i64, asm: &mut Asm<Comp>) -> XOp {
    let mut op = asm.x86[k as usize];
    op.kind = K_REG;
    op
}
