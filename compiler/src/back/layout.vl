// Block layout: the order the blocks of a function are emitted in, apart
// from the order register allocation numbered them (ORDER). Any order is
// correct: every move belongs to a block or to an edge (emit.vl), and
// a block's code depends on its allocation only, not on where it goes.
//
// Chains by fall-through (Pettis and Hansen, "Profile Guided Code
// Positioning", PLDI 1990, with static estimates instead of a profile):
// the edges, heaviest first, join the chain ending at their source to the
// chain starting at their target. A block's frequency is 8^(its loop
// depth); a branch sends 63/64 of it away from a cold successor (one that
// only leads to a panic or `unreachable`), 7/8 along a loop's back edge or
// within its loop rather than out of it, else half each way. The chain of
// the entry comes first, then the others by their first block's
// allocation order; cold chains go last.

// The emission order (block ids, skipped blocks left out).
use crate::back::emit::blocks::{is_skipped, jump_target};
use crate::back::regalloc::intervals::min_i64;
use crate::base::IntVec;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::fn_attr_cold;
use crate::gen0::target::rt_panic_sym;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, Term};
use crate::middle::ir::cfg::{succ, succ_count};

fn int_vec_fill(vec: &mut IntVec, n: i64, value: i64) {
    vec.count = 0;
    for _ in 0..n {
        vec.push(value);
    }
}

// Whether block b only leads to a panic (or `unreachable`): it ends in
// one, or calls the panic or a `#[cold]` function, or jumps to such a
// block.
fn ends_cold(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut x = b;
        for _ in 0..8 {
            if (*cx.blocks.add(x as usize)).term == Term::Unreach {
                return true;
            }
            let mut v = (*cx.blocks.add(x as usize)).first;
            while v != 0 {
                if (*cx.insts.add(v as usize)).op == Op::CallC
                    && (*cx.insts.add(v as usize)).imm == rt_panic_sym(pcx) {
                    return true;
                }
                if (*cx.insts.add(v as usize)).op == Op::Call
                    && fn_attr_cold((*cx.insts.add(v as usize)).imm, pcx) {
                    return true;
                }
                v = (*cx.insts.add(v as usize)).next;
            }
            if (*cx.blocks.add(x as usize)).term != Term::Jump {
                return false;
            }
            x = (*cx.blocks.add(x as usize)).s0;
        }
        false
    }
}

fn block_freq(cx: &mut FnCtx<Comp>, k: i64) -> i64 {
    unsafe {
        if cx.profiled {
            let c = (*cx.count.data.add(k as usize));
            if c >= 0 {
                return c;
            }
        }
        1 << (3 * min_i64((*cx.ldepth.data.add(k as usize)), 6)) as u64
    }
}

fn estimate_counts(cx: &mut FnCtx<Comp>, n: i64) {
    unsafe {
        cx.count.count = 0;
        for k in 0..n {
            cx.count.push((*cx.blocks.add((*cx.order.data.add(k as usize)) as usize)).count);
        }
        cx.profiled = n > 0 && (*cx.count.data.add(0)) > 0;
        if !cx.profiled {
            return;
        }
        for k in 0..n {
            if (*cx.count.data.add(k as usize)) >= 0 {
                continue;
            }
            let b = (*cx.order.data.add(k as usize));
            let mut sum: i64 = 0;
            let mut known = false;
            for i in 0..(*cx.blocks.add(b as usize)).preds.count {
                let p = (
                    *cx.blocks.add(
                        (*(*cx.blocks.add(b as usize)).preds.data.add(i as usize)) as usize)).order;
                if p >= 0 && (*cx.count.data.add(p as usize)) >= 0 {
                    let share = (*cx.count.data.add(p as usize)) / (if succ_count(cx,
                        (*cx.order.data.add(p as usize)))
                        > 1 { succ_count(cx, (*cx.order.data.add(p as usize))) } else { 1 });
                    sum += share;
                    known = true;
                }
            }
            if (*cx.blocks.add(b as usize)).preds.count == 1 && succ_count(cx, b) == 1 {
                let s = { let at_ix = succ(cx, b, 0) as usize; (*cx.blocks.add(at_ix)) }.order;
                let p = (*cx.blocks.add((*(*cx.blocks.add(b as usize)).preds.data.add(0)) as usize)).order;
                if s >= 0 && p >= 0 && (*cx.count.data.add(s as usize)) >= 0
                    && (*cx.count.data.add(p as usize)) >= 0 {
                    sum = min_i64((*cx.count.data.add(s as usize)),
                        (*cx.count.data.add(p as usize)));
                    known = true;
                }
            }
            if known {
                (*cx.count.data.add(k as usize)) = sum;
            }
        }
    }
}

// The share (of 64) of block k's frequency going to its successor s
// (by index), on a branch to s and other.
fn branch_share(cx: &mut FnCtx<Comp>, k: i64, s: i64, other: i64) -> i64 {
    unsafe {
        if cx.profiled && (*cx.count.data.add(s as usize)) >= 0
            && (*cx.count.data.add(other as usize)) >= 0
            && (*cx.count.data.add(s as usize)) + (*cx.count.data.add(other as usize)) > 0 {
            let share = 64 * (*cx.count.data.add(s as usize)) / (
                (*cx.count.data.add(s as usize)) + (*cx.count.data.add(other as usize)));
            return if share < 1 { 1 } else if share > 63 { 63 } else { share };
        }
        let cold_s = (*cx.cold.data.add(s as usize)) != 0;
        let cold_other = (*cx.cold.data.add(other as usize)) != 0;
        if cold_s != cold_other {
            return if cold_s { 1 } else { 63 };
        }
        // A back edge (to a block not later in the allocation order: a loop
        // header) is likely; so is staying within the loop.
        let back_s = s <= k;
        let back_other = other <= k;
        if back_s != back_other {
            return if back_s { 56 } else { 8 };
        }
        let depth = (*cx.ldepth.data.add(k as usize));
        let in_s = (*cx.ldepth.data.add(s as usize)) >= depth;
        let in_other = (*cx.ldepth.data.add(other as usize)) >= depth;
        if in_s != in_other {
            return if in_s { 56 } else { 8 };
        }
        32
    }
}

fn add_edge(cx: &mut FnCtx<Comp>, weight: i64, from: i64, to: i64) {
    if to == from || to < 0 {
        return;
    }
    cx.edges.push(weight);
    cx.edges.push(from);
    cx.edges.push(to);
}

// Whether edge i comes before edge j: heavier first, then in order.
fn edge_before(cx: &mut FnCtx<Comp>, i: i64, j: i64) -> bool {
    unsafe {
        let wi = (*cx.edges.data.add((3 * i) as usize));
        let wj = (*cx.edges.data.add((3 * j) as usize));
        if wi != wj {
            return wi > wj;
        }
        i < j
    }
}

// Sorts EDGE_ORDER (indices of edges) by edge_before: bottom-up merge sort.
fn sort_edges(cx: &mut FnCtx<Comp>) {
    unsafe {
        let n = cx.edge_order.count;
        int_vec_fill(&mut cx.edge_temp, n, 0);
        let mut width: i64 = 1;
        while width < n {
            let mut lo: i64 = 0;
            while lo < n {
                let mid = min_i64(lo + width, n);
                let hi = min_i64(lo + 2 * width, n);
                let mut i = lo;
                let mut j = mid;
                let mut k = lo;
                while k < hi {
                    if i < mid
                        && (j >= hi
                            || !edge_before(cx, (*cx.edge_order.data.add(j as usize)),
                                (*cx.edge_order.data.add(i as usize)))) {
                        (*cx.edge_temp.data.add(k as usize)) = (
                            *cx.edge_order.data.add(i as usize));
                        i += 1;
                    } else {
                        (*cx.edge_temp.data.add(k as usize)) = (
                            *cx.edge_order.data.add(j as usize));
                        j += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            for k in 0..n {
                (*cx.edge_order.data.add(k as usize)) = (*cx.edge_temp.data.add(k as usize));
            }
            width *= 2;
        }
    }
}

// The layout index of the block a jump to b really reaches.
fn edge_target(cx: &mut FnCtx<Comp>, b: i64) -> i64 {
    let t = jump_target(cx, b);
    if is_skipped(cx, t) {
        return -1;
    }
    unsafe { (*cx.blocks.add(t as usize)).order }
}

pub fn layout_emission(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let n = cx.order.count;
        int_vec_fill(&mut cx.chain_next, n, -1);
        cx.chain_head.count = 0;
        cx.chain_tail.count = 0;
        cx.cold.count = 0;
        estimate_counts(cx, n);
        for k in 0..n {
            cx.chain_head.push(k);
            cx.chain_tail.push(k);
            let never = cx.profiled && (*cx.count.data.add(k as usize)) == 0;
            let arg_v: i64 = if ends_cold(cx, (*cx.order.data.add(k as usize)), pcx) || never { 1 }
                else { 0 };
            cx.cold.push(arg_v);
        }
        cx.edges.count = 0;
        for k in 0..n {
            let b = (*cx.order.data.add(k as usize));
            if is_skipped(cx, b) {
                continue;
            }
            let freq = block_freq(cx, k);
            let term = (*cx.blocks.add(b as usize)).term;
            if term == Term::Jump {
                let edge_target_v = edge_target(cx, (*cx.blocks.add(b as usize)).s0);
                add_edge(cx, 64 * freq, k, edge_target_v);
            } else if term == Term::Branch {
                let s0 = edge_target(cx, (*cx.blocks.add(b as usize)).s0);
                let s1 = edge_target(cx, (*cx.blocks.add(b as usize)).s1);
                if s0 >= 0 && s1 >= 0 {
                    let arg_v1 = branch_share(cx, k, s0, s1) * freq;
                    add_edge(cx, arg_v1, k, s0);
                    let arg_v2 = branch_share(cx, k, s1, s0) * freq;
                    add_edge(cx, arg_v2, k, s1);
                }
            }
        }
        cx.edge_order.count = 0;
        for i in 0..cx.edges.count / 3 {
            cx.edge_order.push(i);
        }
        sort_edges(cx);
        for e in cx.edge_order.items() {
            let from = (*cx.edges.data.add((3 * e + 1) as usize));
            let to = (*cx.edges.data.add((3 * e + 2) as usize));
            let head_from = (*cx.chain_head.data.add(from as usize));
            let head_to = (*cx.chain_head.data.add(to as usize));
            // From the end of a chain to the start of another (never to the
            // entry, which stays first).
            if (*cx.chain_tail.data.add(head_from as usize)) != from || head_to != to
                || head_from == head_to
                || to == 0 {
                continue;
            }
            (*cx.chain_next.data.add(from as usize)) = to;
            (*cx.chain_tail.data.add(head_from as usize)) = (*cx.chain_tail.data.add(to as usize));
            let mut x = to;
            while x >= 0 {
                (*cx.chain_head.data.add(x as usize)) = head_from;
                x = (*cx.chain_next.data.add(x as usize));
            }
        }
        // The chains: the entry's, the hot ones, the cold ones (a chain is cold
        // when its first block is).
        cx.emit.count = 0;
        for pass in 0..2 {
            for k in 0..n {
                if (*cx.chain_head.data.add(k as usize)) != k {
                    continue;
                }
                let cold = (*cx.cold.data.add(k as usize)) != 0 && k != 0;
                if (pass == 0) == cold {
                    continue;
                }
                let mut x = k;
                while x >= 0 {
                    let b = (*cx.order.data.add(x as usize));
                    if !is_skipped(cx, b) {
                        cx.emit.push(b);
                    }
                    x = (*cx.chain_next.data.add(x as usize));
                }
            }
        }
    }
}
