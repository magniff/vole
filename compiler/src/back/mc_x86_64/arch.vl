// x86-64 intrinsics (0.19, docs/design/arch.md §5.4): an INTR is its
// table's instruction template (arch/template.vl, AT&T syntax) with its
// registers; -O0 writes the same with fixed ones (gen0/gen/arch.vl).
// (Compile-tested: objcheck and the CROSS cases; not run in 0.19.)

use crate::arch::{F_INSN, intr_ret_text, intr_text, intr_tied};
use crate::arch::template::{
    SLOT_D, SLOT_T, TP_END, TP_NEXT, TP_SLOT, TP_TEXT, TPiece, template_piece, template_slot,
};
use crate::back::mc_x86_64::{mx_mov, mx_rs};
use crate::base::buf_bytes;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::TY_I64;
use crate::gen0::target::{o, oi, on};
use crate::middle::ctx::FnCtx;

// The instruction temporaries: xmm15, and r11 for a general register.
const XTEMP: i64 = 47;
const RTEMP: i64 = 11;

// Register r with modifier m: a vector register's %xmm<n> (32 + n; `y`:
// %ymm<n>, the 256-bit view), a general register's 64-bit name (`w`:
// 32-bit, `h`: 16-bit, `b`: 8-bit).
fn mx_reg(cx: &mut FnCtx<Comp>, r: i64, m: u8) {
    let size: i64 = if m == b'y' { 32 } else if m == b'w' { 4 } else if m == b'h' { 2 }
        else if m == b'b' {
            1
        } else { 8 };
    mx_rs(cx, r, size);
}

// d = s, a whole register: a vector one's 256 bits when `wide`.
fn mx_move(cx: &mut FnCtx<Comp>, d: i64, s: i64, wide: bool, pcx: &Ctx<Comp>) {
    if d >= 32 && wide {
        o(cx, c"    vmovdqa ");
        mx_rs(cx, s, 32);
        o(cx, c", ");
        mx_rs(cx, d, 32);
        on(cx);
        return;
    }
    mx_mov(cx, d, s, if d >= 32 { pcx.ty_v16i8 } else { TY_I64 }, pcx);
}

// Intrinsic id into register d (-1: no result) from the registers ops[k]
// of its parameters (-1 for an immediate, whose value is imms[k]). SSE's
// two-operand forms are tied: the result starts as a copy of the tied
// parameter, in xmm15 (r11) when d is another operand's (all 256 bits of
// it when the result is a 256-bit vector: FMA's accumulator).
pub fn mx_intr(cx: &mut FnCtx<Comp>, id: i64, d: i64, ops: &[i64], imms: &[i64], pcx: &Ctx<Comp>) {
    unsafe {
        let text = intr_text(id, F_INSN, pcx);
        let fixed = xmm0_param(id, text, pcx);
        if fixed >= 0 {
            mx_intr_xmm0(cx, id, d, ops, imms, fixed, pcx);
            return;
        }
        let tied = intr_tied(id, pcx);
        let wide = intr_ret_text(id, pcx).len() >= 6 && intr_ret_text(id, pcx)[0..6] == b"__m256";
        let mut dd = d;
        if tied >= 0 && ops[tied as usize] != d {
            for k in 0..(*pcx.intrs.add(id as usize)).nparams {
                if k != tied && ops[k as usize] == d {
                    dd = if d >= 32 { XTEMP } else { RTEMP };
                }
            }
            mx_move(cx, dd, ops[tied as usize], wide, pcx);
        }
        mx_template(cx, id, text, dd, ops, imms, pcx);
        if dd != d {
            mx_move(cx, d, dd, wide, pcx);
        }
    }
}

// The template of intrinsic id with result register dd and the operands'
// registers ops (immediates imms); `<NAME:0>` is %xmm0.
fn mx_template(cx: &mut FnCtx<Comp>, id: i64, text: &[u8], dd: i64, ops: &[i64], imms: &[i64],
    pcx: &Ctx<Comp>) {
    let mut p = TPiece { kind: 0, start: 0, end: 0, name: 0, modifier: 0 };
    let mut at: i64 = 0;
    o(cx, c"    ");
    loop {
        at = template_piece(text, at, &mut p, pcx);
        if p.kind == TP_END {
            break;
        }
        if p.kind == TP_TEXT {
            buf_bytes(cx.code, &text[p.start as usize..p.end as usize]);
        } else if p.kind == TP_NEXT {
            on(cx);
            o(cx, c"    ");
        } else if p.kind == TP_SLOT {
            let s = template_slot(id, p.name, pcx);
            if p.modifier == b'0' {
                o(cx, c"%xmm0");
            } else if s == SLOT_D {
                mx_reg(cx, dd, p.modifier);
            } else if s == SLOT_T {
                mx_reg(cx, XTEMP, p.modifier);
            } else if ops[s as usize] < 0 {
                oi(cx, imms[s as usize]);
            } else {
                mx_reg(cx, ops[s as usize], p.modifier);
            }
        }
    }
    on(cx);
}

// (0.19 T5) The parameter the instruction reads in xmm0, `<NAME:0>` in
// its template (SSE4.1's blendv, sha256rnds2), or -1.
fn xmm0_param(id: i64, text: &[u8], pcx: &Ctx<Comp>) -> i64 {
    let mut p = TPiece { kind: 0, start: 0, end: 0, name: 0, modifier: 0 };
    let mut at: i64 = 0;
    loop {
        at = template_piece(text, at, &mut p, pcx);
        if p.kind == TP_END {
            return -1;
        }
        if p.kind == TP_SLOT && p.modifier == b'0' {
            return template_slot(id, p.name, pcx);
        }
    }
}

// An intrinsic whose instruction reads parameter `fixed` in xmm0: xmm0 is
// saved in xmm14 (never allocated) around it and restored, the operands
// that were in xmm0 read from the copy, the result made in xmm15 (tied: a
// copy of the tied parameter first) and moved to d last, so d may be
// xmm0. Five moves; AVX's forms (vpblendvb ...) take the mask anywhere.
fn mx_intr_xmm0(cx: &mut FnCtx<Comp>, id: i64, d: i64, ops: &[i64], imms: &[i64], fixed: i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        let saved = XTEMP - 1;
        let mut regs: [i64; 8] = [-1; 8];
        for k in 0..(*pcx.intrs.add(id as usize)).nparams {
            regs[k as usize] = if ops[k as usize] == 32 { saved } else { ops[k as usize] };
        }
        mx_move(cx, saved, 32, false, pcx);
        let tied = intr_tied(id, pcx);
        if tied >= 0 {
            mx_move(cx, XTEMP, regs[tied as usize], false, pcx);
        }
        mx_move(cx, 32, regs[fixed as usize], false, pcx);
        mx_template(cx, id, intr_text(id, F_INSN, pcx), XTEMP, &regs[..], imms, pcx);
        mx_move(cx, 32, saved, false, pcx);
        if d >= 0 {
            mx_move(cx, d, XTEMP, false, pcx);
        }
    }
}
