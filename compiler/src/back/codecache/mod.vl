// (0.18.1) Incremental rebuilds: the code cache (T8 of
// docs/design/contracts-verification.md; docs/optimizer.md, "0.18.1:
// incremental rebuilds"). A task of middle::parallel whose inputs are the
// same as in an earlier build takes that build's outputs instead of
// running: -O2's cleanup and scalar pipeline of a function (its IR), -O2's
// components (their functions' optimized IR and facts) and every
// function's emission (its text), at -O1 and -O2.
//
// An entry is found by its key: the compiler, the options and the
// program's types (env), the task's functions by symbol, their IR as the
// task receives it (hash::ir_hash) and what the program knows of them
// (own_fp). It holds what the task read of other functions while it ran
// (a verifying trace): each read is recorded when it is made (cc_note,
// from the accessors: the callee of a call, its readiness, size,
// attributes, call flags, deciders and IR) with the value read, and the
// entry is used only when every one reads the same now. Two reads of the
// program record the answer, not the value: the inlining budget (whether
// the program's size plus a growth is within it) and a callee's calls
// left (whether one). The outputs name strings, symbols, functions and
// constant data by what they are (snapshot::Rel), mapped to this build's
// ids when used.
//
// A task that reads something the trace cannot hold (IR whose hash is not
// known) is poisoned: it runs and nothing is stored. The output with the
// cache is the same as without, byte for byte (tests/incremental.sh).

pub mod hash;
pub mod snapshot;
pub mod pack;

use crate::host_target;
use crate::back::codecache::hash::{
    H2, fn_of_name, h2_new, h2_put, h2_puti, hash_bytes, ir_hash, ir_nameh, ir_of_name, mix,
    names_begin, strings_begin, types_hash,
};
use crate::back::codecache::pack::{
    VERSION, pack_body, pack_body_at, pack_changed, pack_find, pack_load, pack_new, pack_save,
    pack_touch, pack_used,
};
use crate::back::codecache::snapshot::{
    ByteBuf, IRCopy, Ids, Reader, Rel, bb_new, decode_ir, encode_ir, free_copy, get_bytes,
    get_count, get_s, get_u, ids_free, put_bytes, put_s, put_u, rel_add_source, rel_clear, rel_fn,
    rel_new, rel_rtid, rel_saddr, rel_str_source,
};
use crate::base::{
    IntVec, alloc_array, alloc_zeroed, find_sym, free, getenv, memcpy, streq, stress_grow, strlen,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::cli::line::Line;
use crate::front::stdalloc::get_check_alloc_mode;
use crate::middle::copies::move_copies;
use crate::middle::ctx::FnCtx;
use crate::middle::inline::{get_fn_deciders, get_fn_deciders_start, get_fn_rt, get_fn_size};
use crate::middle::ipo::{get_fn_attrs, get_fn_attrs_done, get_fn_nocapture};
use crate::middle::ir::{IRTables, get_irfuncs, ir_enter, ir_release};
use crate::middle::opt::get_deferred;
use crate::middle::parallel::{
    K_COMPONENT, OWNER_SHIFT, P_CLEANUP, P_COMPONENT, P_EMIT, P_SIMPLIFY, comp_of, const_data,
    const_data_count, const_data_entry, fn_facts_ready, get_comp_growth, get_comp_inlined,
    get_fn_text,
};
use crate::tools::proc::{fork_worker, make_dirs, worker_exit};
use crate::tools::query::cache::{cache_dir, ident};

extern "C" {
    fn getcwd(buf: *mut u8, size: u64) -> *mut u8;
    fn setsid() -> i32;
    fn open(path: *mut u8, flags: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
    fn fopen(path: *mut u8, mode: *mut u8) -> *mut u8;
    fn fwrite(buf: *mut u8, size: u64, count: u64, file: *mut u8) -> u64;
    fn fclose(file: *mut u8) -> i32;
}

// ---- Options ----

// The size of the program's code below which the cache is off without
// --cache=on: its live functions' instructions as lowered. A 7-line
// program with std has 1405 (a build at -O1 6 ms, the cache's start 4 ms
// more: the compiler's hash, the pack); examples/calc 3321 (-O1 7.3 ms,
// 8.0 with the cache), examples/closures-iterators 8230 (-O1 10.6 ms,
// 10.5; -O2 36 ms, 13); the compiler 716164.
const MIN_INSTS: i64 = 8000;

// Whether `arg` is one of the cache's options (taken).
pub fn cc_option(arg: *mut u8, pcx: &mut Ctx<Comp>) -> bool {
    if streq(arg, c"--no-cache") || streq(arg, c"--cache=off") {
        pcx.cc_flag = -1;
        return true;
    }
    if streq(arg, c"--cache=on") {
        pcx.cc_flag = 1;
        return true;
    }
    false
}

// The options that change no code (left out of the hash), and those
// known not to need the cache off; any other option turns it off.
fn arg_kind(a: &str) -> i64 {
    // (0: hashed; 1: left out; 2: left out with the next; 3: hashed with
    // the next; 4: hashed with the next two; -1: unknown)
    let b = a.as_bytes();
    if b.len() == 0 || b[0] != b'-' {
        return 0;
    }
    if a == "-o" || a == "-framework" {
        return 2;
    }
    if b.len() > 1 && b[1] == b'j' {
        return if b.len() == 2 { 2 } else { 1 };
    }
    if a == "--no-cache" || a.starts_with("--cache=") || a.starts_with("--diagnostics=")
        || a == "--deny-warnings" || a.starts_with("--linker=") || a.starts_with("--allow=") {
        return 1;
    }
    if a == "-O0" || a == "-O1" || a == "-O2" || a == "-c" || a == "-S" || a == "--emit-asm"
        || a == "--no-ifconv" || a == "--no-vectorize" || a == "--no-unroll-runtime"
        || a == "--no-slp" || a == "--no-noalias" || a == "--no-egraph"
        || a == "--debug-contracts" || a == "--no-positions" || a == "--test-build"
        || a.starts_with("--syntax=") || a.starts_with("--edition=")
        || a.starts_with("--atomics=") {
        return 0;
    }
    // (0.26.3) the overflow checks change the code: hashed
    if a.starts_with("--overflow-checks=") {
        return 0;
    }
    if b.len() > 2 && (b[1] == b'I' || b[1] == b'l' || b[1] == b'L') {
        return 0;
    }
    if a == "--target" || a == "-I" || a == "-l" || a == "-L" || a == "-C" {
        return 3;
    }
    if a == "--overlay" {
        return 4;
    }
    -1
}

// The hash of word w.
fn hash_word(w: &str) -> u64 {
    hash_bytes(w.as_bytes().ptr, w.len() as i64)
}

// The command line's options, hashed (main, before they are read).
pub fn cc_args(line: Line<'_>, pcx: &mut Ctx<Comp>) {
    // (the compiler, whose executable's hash keys the cache:
    // tools::query::cache::ident)
    if pcx.prog == 0 as *mut u8 {
        pcx.prog = line.c(0);
    }
    let mut h: u64 = 0x61726773;
    let mut i: i64 = 1;
    let n = line.len();
    while i < n {
        let a = line.word(i);
        let kind = arg_kind(a);
        if kind < 0 {
            pcx.args_unknown = true;
        }
        if kind != 1 && kind != 2 {
            h = mix(h, hash_word(a));
        }
        let take: i64 = if kind == 2 || kind == 3 { 1 } else if kind == 4 { 2 } else { 0 };
        for k in 1..take + 1 {
            if i + k < n && kind != 2 {
                h = mix(h, hash_word(line.word(i + k)));
            }
        }
        i += 1 + take;
    }
    unsafe {
        // (the environment the code generator reads)
        let names = [c"VOLE_STRESS_GROW", c"VOLE_PLANT_MISCOMPILE", c"VOLE_FRESH_CONTEXTS",
            c"VOLE_ROOT", c"VOLE_QUERY_STD", c"VOLE_OVF_CENSUS"];
        for k in 0..6 {
            let v = getenv(names[k as usize]);
            h = mix(h, if v == 0 as *mut u8 { 1 } else { hash_bytes(v, strlen(v) as i64) });
        }
        pcx.args_h = h;
    }
}

// Whether this compilation may use the cache: -O1 or -O2, none of the
// modes that print as they go, keep the program's state in statics or
// change the IR outside the tasks' view, and a directory for it.
fn cc_wanted(pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let env = getenv(c"VOLE_CODE_CACHE");
        // ($VOLE_CODE_CACHE=off: the code cache off, the tools' cache as
        // it is; tests/run.sh's default)
        let off = env != 0 as *mut u8 && streq(env, c"off");
        pcx.cc_flag >= 0 && !off && !pcx.args_unknown && pcx.opt_level >= 1 && !pcx.debug_info
            && !pcx.time_passes && pcx.stats == 0 && !pcx.verify_ir && !pcx.print_after_all
            && !pcx.print_regalloc && !pcx.verify_regalloc && pcx.print_checks == 0 as *mut u8
            && !pcx.emit_ir && !pcx.emit_mir && !pcx.print_attrs && !pcx.trace
            && pcx.profile_use == 0 as *mut u8 && pcx.profile_generate == 0 as *mut u8
            && !get_check_alloc_mode() && !pcx.check_unsafe && !pcx.coverage && !pcx.verify_effects
            && cache_dir(pcx) != 0 as *mut u8 && ident(pcx) != 0
    }
}

// ---- A thread's state ----

// What a task records (one per context, made when first needed).
#[derive(Clone, Copy)] pub struct CcCtx {
    // Recording: the task's reads, triples (kind, a, b).
    rec: bool,
    reads: IntVec,
    poison: bool,
    // Per IR function: the stamp of the task that noted it, and the kinds
    // noted then (bits).
    seen: *mut i64,
    seen_bits: *mut i64,
    seen_cap: i64,
    stamp: i64,
    // The task: its component (-1: one function, fi), the SCC of its
    // functions (-1: none).
    comp: i64,
    fi: i64,
    own_scc: i64,
    // Its functions (IR).
    members: IntVec,
    // Its functions' strings as the task received them, one list after the
    // other (own_start: where each begins), and their constant data then.
    own_strs: IntVec,
    own_start: IntVec,
    consts_before: IntVec,
    // The key.
    key: H2,
    // The text's string and constant ids (emission), by index; their map.
    text: bool,
    relocs: IntVec,
    reloc_map: crate::middle::lower::ssa::HMap,
    // Scratch for hash::ir_hash's strings.
    str_seen: *mut i64,
    str_k: *mut i64,
    str_cap: i64,
    str_stamp: i64,
    // Scratch for an entry.
    rel: Rel,
    out: ByteBuf,
    body: ByteBuf,
}

// cx's cache state (made the first time).
pub fn cc_of(cx: &mut FnCtx<Comp>) -> *mut CcCtx {
    unsafe {
        if cx.cc != 0 as *mut CcCtx {
            return cx.cc;
        }
        let cc = alloc_zeroed(size_of(CcCtx)) as *mut CcCtx;
        (*cc).comp = -1;
        (*cc).fi = -1;
        (*cc).own_scc = -1;
        (*cc).rel = rel_new();
        (*cc).out = bb_new();
        (*cc).body = bb_new();
        cx.cc = cc;
        cc
    }
}

// ---- The program's state for the cache ----

// Per IR function: the hash of its IR as last made (by its task, or read
// back), whether that is its IR now, and its strings then.
static mut FN_IRH: *mut H2 = 0 as *mut H2;
static mut FN_IRH_OK: *mut bool = 0 as *mut bool;
static mut FN_STRS: *mut IntVec = 0 as *mut IntVec;
// Per IR function: what its component's task (at its first function) and
// its emission did (OUT_*), for the counts.
static mut OUT_COMP: *mut i64 = 0 as *mut i64;
static mut OUT_EMIT: *mut i64 = 0 as *mut i64;
static mut OUT_SCALAR: *mut i64 = 0 as *mut i64;
const OUT_HIT: i64 = 1;
const OUT_NONE: i64 = 2;
const OUT_READ: i64 = 3;
const OUT_BAD: i64 = 4;
const OUT_POISON: i64 = 5;

// The kinds of entries (and of the slots of pack's new entries).
const E_COMPONENT: i64 = 1;
const E_EMIT: i64 = 2;
const SLOTS_PER_FN: i64 = 3;

// The compilation's cache: off, or on with the pack read (main thread,
// at the start of the optimizer, the program lowered).
pub fn cc_begin(pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.cc_on = false;
        // A program whose code is small compiles in less than the cache takes
        // to start (the compiler's hash, the pack): without it, unless
        // --cache=on.
        pcx.program_insts = 0;
        for fi in 0..pcx.irfunc_count {
            if (pcx.fn_live[fi as usize]) != 0 {
                pcx.program_insts += (*get_irfuncs().add(fi as usize)).t.inst_count;
            }
        }
        if (pcx.program_insts < MIN_INSTS && pcx.cc_flag <= 0) || !cc_wanted(pcx)
            || pcx.irfunc_count == 0 {
            return;
        }
        let dir = cache_dir(pcx);
        if !make_dirs(dir) {
            return;
        }
        let moves = move_copies(pcx);
        names_begin(*moves, pcx);
        set_fn_irh(alloc_zeroed((pcx.irfunc_count + 1) * size_of(H2)) as *mut H2);
        set_fn_irh_ok(alloc_array::<bool>(pcx.irfunc_count + 1));
        set_fn_strs(alloc_zeroed((pcx.irfunc_count + 1) * size_of(IntVec)) as *mut IntVec);
        set_out_comp(alloc_array::<i64>(pcx.irfunc_count + 1));
        set_out_emit(alloc_array::<i64>(pcx.irfunc_count + 1));
        set_out_scalar(alloc_array::<i64>(pcx.irfunc_count + 1));
        set_scalar_rec(alloc_zeroed((pcx.irfunc_count + 1) * size_of(ScalarRec)) as *mut ScalarRec);
        pcx.check = getenv(c"VOLE_CACHE_CHECK") != 0 as *mut u8;
        pcx.why = getenv(c"VOLE_CACHE_WHY") != 0 as *mut u8;
        let options = options_hash(pcx);
        pack_load(pack_path(dir, options, pcx), ident(pcx), options as i64,
            SLOTS_PER_FN * (pcx.irfunc_count + 1), pcx);
        pcx.cc_on = true;
    }
}

// The options and the compiler, hashed.
fn options_hash(pcx: &mut Ctx<Comp>) -> u64 {
    let mut h: u64 = mix(pcx.args_h, ident(pcx) as u64);
    h = mix(h, VERSION as u64);
    h = mix(h, pcx.opt_level as u64);
    h = mix(h, (if pcx.per_function { 1 } else { 0 }) | (if get_x86() { 2 } else { 0 })
        | (if get_elf() { 4 } else { 0 }) | (if pcx.apple_a64 { 8 } else { 0 })
        | (if pcx.ifconv { 16 } else { 0 }) | (if pcx.vectorize { 32 } else { 0 })
        | (if pcx.unroll_runtime { 64 } else { 0 }) | (if pcx.slp { 128 } else { 0 })
        | (if pcx.noalias_off { 256 } else { 0 }) | (if pcx.egraph { 512 } else { 0 })
        | (if pcx.x86_alloc_acd { 1024 } else { 0 }) | (if pcx.any_distinct { 2048 } else { 0 })
        | (if stress_grow() { 4096 } else { 0 }));
    h = mix(h, pcx.profile_max as u64);
    h = mix(h, pcx.output_mode as u64);
    h = mix(h, host_target() as u64);
    // (0.19: the build's target features, which has() and detect() fold)
    if pcx.arch_used {
        h = mix(h, crate::arch::features::build_features(pcx) as u64);
    }
    h
}

// target/volec-cache/g-KEY.pack: KEY the root as given, the current
// directory and the options.
fn pack_path(dir: *mut u8, options: u64, pcx: &Ctx<Comp>) -> *mut u8 {
    unsafe {
        let root = pcx.files[0].path;
        let mut h: u64 = mix(options, hash_bytes(root, strlen(root) as i64));
        let cwd = alloc_zeroed(4096);
        if getcwd(cwd, 4096) != 0 as *mut u8 {
            h = mix(h, hash_bytes(cwd, strlen(cwd) as i64));
        }
        free(cwd);
        let n = strlen(dir) as i64;
        let p = alloc_zeroed(n + 32);
        memcpy(p, dir, n as u64);
        let mut k = n;
        (*p.add(k as usize)) = b'/';
        (*p.add((k + 1) as usize)) = b'g';
        (*p.add((k + 2) as usize)) = b'-';
        k += 3;
        for i in 0..16 {
            let d = ((h >> ((15 - i) * 4) as u64) & 15) as u8;
            (*p.add(k as usize)) = if d < 10 { b'0' + d } else { b'a' + d - 10 };
            k += 1;
        }
        let tail = c".pack";
        for i in 0..5 {
            (*p.add((k + i) as usize)) = (*tail.add(i as usize));
        }
        p
    }
}

// Before a phase's tasks (main thread): the program's hash as they see it,
// the strings hashed.
pub fn cc_phase(kind: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if !pcx.cc_on {
            return;
        }
        // (-O2's components hash their IR as interprocedural constants left
        // it: the scalar phases' hashes are not it)
        if kind == K_COMPONENT {
            for fi in 0..pcx.irfunc_count {
                (*get_fn_irh_ok().add(fi as usize)) = false;
            }
        }
        strings_begin(pcx);
        let mut h = h2_new(0x656e76);
        h2_put(&mut h, pcx.args_h);
        h2_put(&mut h, types_hash(pcx));
        h2_puti(&mut h, if pcx.attrs_ready { 1 } else { 0 });
        h2_puti(&mut h, pcx.ty_string);
        h2_puti(&mut h, pcx.ty_u8_ptr);
        pcx.codecache_env = h;
        // (-O1: the small leaves' IR, which the emission tasks inline, hashed
        // first)
        if pcx.per_function && pcx.leaf_small != 0 as *mut i64 {
            let cx = crate::middle::ctx::main_cx(pcx);
            for g in 0..pcx.irfunc_count {
                if (*pcx.leaf_small.add(g as usize)) != 0 && (pcx.fn_live[g as usize]) != 0 {
                    ir_enter(&mut *cx, g, pcx);
                    (*get_fn_strs().add(g as usize)).clear();
                    let mut h2 = H2 { a: 0, b: 0 };
                    (*get_fn_irh_ok().add(g as usize)) = ir_hash(&mut *cx, g, 0,
                        get_fn_strs().add(g as usize), &mut h2, pcx);
                    (*get_fn_irh().add(g as usize)) = h2;
                }
            }
            ir_release(&mut *cx);
        }
    }
}

// The end of the compilation (its output written): the pack written when
// anything changed, by a copy of the process (this one ends), or here
// with $VOLE_CACHE_SYNC or $VOLE_CACHE_TRACE.
pub fn cc_end(pcx: &Ctx<Comp>) {
    unsafe {
        if !pcx.cc_on {
            return;
        }
        report(pcx);
        if !pack_changed(pcx) {
            pack_touch(pcx);
            return;
        }
        if getenv(c"VOLE_CACHE_SYNC") == 0 as *mut u8
            && getenv(c"VOLE_CACHE_TRACE") == 0 as *mut u8 {
            let pid = fork_worker();
            if pid > 0 {
                return;
            }
            if pid == 0 {
                setsid();
                let null = open(c"/dev/null", 1);
                if null >= 0 {
                    dup2(null, 1);
                    dup2(null, 2);
                }
                pack_save(pcx);
                worker_exit(0);
            }
        }
        pack_save(pcx);
    }
}

// The counts ($VOLE_CACHE_STATS: on stderr; $VOLE_CACHE_TRACE: a
// line `code H M` in that file), and with $VOLE_CACHE_WHY each miss.
fn report(pcx: &Ctx<Comp>) {
    unsafe {
        let mut counts: [i64; 18] = [0i64; 18];
        for fi in 0..pcx.irfunc_count {
            let a = (*get_out_scalar().add(fi as usize));
            if a > 0 && a < 6 {
                counts[a as usize] += 1;
            }
            let c = (*get_out_comp().add(fi as usize));
            if c > 0 && c < 6 {
                counts[(6 + c) as usize] += 1;
            }
            let e = (*get_out_emit().add(fi as usize));
            if e > 0 && e < 6 {
                counts[(12 + e) as usize] += 1;
            }
        }
        let hits = counts[OUT_HIT as usize] + counts[(6 + OUT_HIT) as usize] + counts[
            (12 + OUT_HIT) as usize];
        let mut misses: i64 = 0;
        for o in 2..6 {
            misses += counts[o as usize] + counts[(6 + o) as usize] + counts[(12 + o) as usize];
        }
        if getenv(c"VOLE_CACHE_STATS") != 0 as *mut u8 {
            let b = crate::base::buf_new();
            let kinds = [c"scalar", c"components", c"emission"];
            crate::base::buf_fmt(b,
                format_args("code cache ({program_insts} instructions):",
                    program_insts = pcx.program_insts));
            for k in 0..3 {
                let o = 6 * k;
                crate::base::buf_fmt(b,
                    format_args(
                        " {} {} hit, {} new, {} read changed, {} unreadable, {} not cacheable;",
                        str::from_utf8(crate::base::cstr(kinds[k as usize])).unwrap(),
                        counts[(o + 1) as usize], counts[(o + 2) as usize],
                        counts[(o + 3) as usize], counts[(o + 4) as usize],
                        counts[(o + 5) as usize]));
            }
            crate::base::buf_str(b, c"\n");
            crate::base::buf_write_fd(b, crate::base::STDERR);
        }
        if pcx.why {
            for fi in 0..pcx.irfunc_count {
                why(fi, c"scalar", (*get_out_scalar().add(fi as usize)), pcx);
                why(fi, c"component", (*get_out_comp().add(fi as usize)), pcx);
                why(fi, c"emission", (*get_out_emit().add(fi as usize)), pcx);
            }
        }
        let path = getenv(c"VOLE_CACHE_TRACE");
        if path != 0 as *mut u8 {
            let f = fopen(path, c"a");
            if f != 0 as *mut u8 {
                let b = crate::base::buf_new();
                crate::base::buf_fmt(b, format_args("code {hits} {misses}\n"));
                fwrite((*crate::base::get_bufs().add(b as usize)).data, 1,
                    (*crate::base::get_bufs().add(b as usize)).len as u64, f);
                fclose(f);
            }
        }
    }
}

fn why(fi: i64, what: *mut u8, o: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if o <= OUT_HIT {
            return;
        }
        let reason = if o == OUT_NONE { c"new" } else if o == OUT_READ { c"read changed" }
            else if o == OUT_BAD { c"unreadable" } else { c"not cacheable" };
        let name = crate::base::sym_name(pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].name,
            pcx);
        eprintln(
            "code cache: {} {}: {}", str::from_utf8(crate::base::cstr(what)).unwrap(),
            str::from_utf8(crate::base::cstr(name)).unwrap(),
            str::from_utf8(crate::base::cstr(reason)).unwrap());
    }
}

// ---- Recording what a task reads ----

pub const R_STATIC: i64 = 1;
pub const R_SIZE: i64 = 2;
pub const R_ATTRS: i64 = 3;
pub const R_RT: i64 = 4;
pub const R_DEC: i64 = 5;
pub const R_IR: i64 = 6;
const R_CALLS: i64 = 7;
const R_BUDGET: i64 = 8;

// Whether IR function g is one of the task's own (what it reads of them
// is its own doing).
fn is_own(cc: CcCtx, g: i64, pcx: &Ctx<Comp>) -> bool {
    if cc.comp >= 0 {
        return comp_of(g, pcx) == cc.comp;
    }
    g == cc.fi
}

// The task running in cx read fact `kind` (R_STATIC .. R_IR) of IR
// function g.
pub fn cc_note(cx: &mut FnCtx<Comp>, kind: i64, g: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let cc = cx.cc;
        if cc == 0 as *mut CcCtx || !(*cc).rec || g < 0 || is_own(*cc, g, pcx) {
            return;
        }
        if (*(*cc).seen.add(g as usize)) != (*cc).stamp {
            (*(*cc).seen.add(g as usize)) = (*cc).stamp;
            (*(*cc).seen_bits.add(g as usize)) = 0;
        }
        let bit = 1 << kind;
        if ((*(*cc).seen_bits.add(g as usize)) & bit) != 0 {
            return;
        }
        (*(*cc).seen_bits.add(g as usize)) = (*(*cc).seen_bits.add(g as usize)) | bit;
        // (a fact of a function not ready is not read: its task may be
        // writing it; its IR, if read, cannot be recorded)
        if kind != R_STATIC && !ready_or_done(cx, g, pcx) {
            (*(*cc).seen_bits.add(g as usize)) = (*(*cc).seen_bits.add(g as usize)) & !bit;
            if kind == R_IR {
                (*cc).poison = true;
            }
            return;
        }
        if kind == R_IR && !(*get_fn_irh_ok().add(g as usize)) {
            (*cc).poison = true;
            return;
        }
        (*cc).reads.push(kind);
        (*cc).reads.push(ir_nameh(g, pcx));
        (*cc).reads.push(fact(cx, kind, g, pcx));
    }
}

// The task read whether callee g has one call left, own_dec of them
// inlined by the task already: `one`.
pub fn cc_note_calls(cx: &mut FnCtx<Comp>, g: i64, own_dec: i64, one: bool, pcx: &Ctx<Comp>) {
    unsafe {
        let cc = cx.cc;
        if cc == 0 as *mut CcCtx || !(*cc).rec || g < 0 || is_own(*cc, g, pcx) {
            return;
        }
        (*cc).reads.push(R_CALLS);
        (*cc).reads.push(ir_nameh(g, pcx));
        (*cc).reads.push((own_dec << 1) | (if one { 1 } else { 0 }));
    }
}

// The task read whether the program's size, grown by `growth`, is within
// the inlining budget: `within`.
pub fn cc_note_budget(cx: &mut FnCtx<Comp>, growth: i64, within: bool) {
    unsafe {
        let cc = cx.cc;
        if cc == 0 as *mut CcCtx || !(*cc).rec {
            return;
        }
        (*cc).reads.push(R_BUDGET);
        (*cc).reads.push(growth);
        (*cc).reads.push(if within { 1 } else { 0 });
    }
}

// Whether IR function g's facts may be read by the task (its readiness,
// as middle::parallel::fn_facts_ready answers it).
fn ready(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if cx.cur_comp >= 0 {
            return fn_facts_ready(cx, g, true, pcx);
        }
        get_fn_attrs_done() != 0 as *mut i64 && (*get_fn_attrs_done().add(g as usize)) != 0
    }
}

// The value of fact `kind` of IR function g now.
fn fact(cx: &mut FnCtx<Comp>, kind: i64, g: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if kind == R_STATIC {
            return static_fp(cx, g, pcx) as i64;
        }
        if kind == R_SIZE {
            return (*get_fn_size().add(g as usize));
        }
        if kind == R_ATTRS {
            // (0.27.1: the borrow checker's verdict decides the parameter
            // alias facts of a rust body, gvn noalias_active)
            let f = (*get_irfuncs().add(g as usize)).f;
            let verdict: i64 = if f >= 0 && f < pcx.borrowck_verdict.len() as i64 {
                pcx.borrowck_verdict[f as usize]
            } else {
                0
            };
            return mix(mix(mix((*get_fn_attrs().add(g as usize)) as u64,
                (*get_fn_nocapture().add(g as usize)) as u64),
                (*get_fn_attrs_done().add(g as usize)) as u64), verdict as u64) as i64;
        }
        if kind == R_RT {
            return (*get_fn_rt().add(g as usize));
        }
        if kind == R_DEC {
            return deciders_hash(g) as i64;
        }
        (*get_fn_irh().add(g as usize)).a as i64
    }
}

fn deciders_hash(g: i64) -> u64 {
    unsafe {
        let mut h: u64 = mix(0x646563, (*get_fn_deciders_start().add(g as usize)) as u64);
        for i in 0..(*get_fn_deciders().add(g as usize)).len() as i64 {
            h = mix(h, ((*get_fn_deciders().add(g as usize))[i as usize]) as u64);
        }
        h
    }
}

// What a task reads of another function that its own task does not
// change: its declaration, whether it is live, its address taken, -O1's
// leaf marks, whether it is in the task's SCC, and whether it is ready.
fn static_fp(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        let cc = cx.cc;
        let mut h = facts_fixed(g, pcx);
        if pcx.fn_scc.len() > 0 && (*cc).own_scc >= 0 {
            h = mix(h, if (pcx.fn_scc[g as usize]) == (*cc).own_scc { 1 } else { 2 });
        }
        mix(h, if ready(cx, g, pcx) { 3 } else { 4 })
    }
}

fn facts_fixed(g: i64, pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        let mut h: u64 = mix(
            (*pcx.fn_canon.add((*get_irfuncs().add(g as usize)).f as usize)) as u64,
            (pcx.fn_live[g as usize]) as u64);
        if pcx.fn_address.len() > 0 {
            h = mix(h, (pcx.fn_address[g as usize]) as u64);
        }
        if pcx.leaf_small != 0 as *mut i64 {
            h = mix(h,
                ((*pcx.leaf_small.add(g as usize)) | ((*pcx.leaf_keep.add(g as usize)) << 1)
                    | ((*pcx.leaf_done.add(g as usize)) << 2)) as u64);
        }
        h
    }
}

// What the program knows of the task's own function fi as it begins:
// facts_fixed and, at -O2, its size, call flags, deciders, attributes
// and whether its loop passes wait.
fn own_fp(fi: i64, pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        let mut h = facts_fixed(fi, pcx);
        if get_fn_size() != 0 as *mut i64 {
            h = mix(h, (*get_fn_size().add(fi as usize)) as u64);
            h = mix(h, (*get_fn_rt().add(fi as usize)) as u64);
            h = mix(h, deciders_hash(fi));
        }
        if get_fn_attrs() != 0 as *mut i64 {
            h = mix(h, (*get_fn_attrs().add(fi as usize)) as u64);
            h = mix(h, (*get_fn_nocapture().add(fi as usize)) as u64);
            h = mix(h, (*get_fn_attrs_done().add(fi as usize)) as u64);
        }
        if get_deferred() != 0 as *mut i64 {
            h = mix(h, (*get_deferred().add(fi as usize)) as u64);
        }
        h
    }
}

// Starts a task's recording in cx (its own: component comp, or function
// fi).
fn task_begin(cx: &mut FnCtx<Comp>, comp: i64, fi: i64, pcx: &Ctx<Comp>) -> *mut CcCtx {
    unsafe {
        let cc = cc_of(cx);
        if (*cc).seen_cap < pcx.irfunc_count + 1 {
            free((*cc).seen as *mut u8);
            free((*cc).seen_bits as *mut u8);
            (*cc).seen_cap = pcx.irfunc_count + 1;
            (*cc).seen = alloc_array::<i64>((*cc).seen_cap);
            (*cc).seen_bits = alloc_array::<i64>((*cc).seen_cap);
        }
        (*cc).stamp += 1;
        (*cc).reads.clear();
        (*cc).poison = false;
        (*cc).rec = false;
        (*cc).comp = comp;
        (*cc).fi = fi;
        (*cc).members.clear();
        (*cc).own_strs.clear();
        (*cc).own_start.clear();
        (*cc).consts_before.clear();
        (*cc).text = false;
        (*cc).relocs.clear();
        (*cc).reloc_map.clear();
        cc
    }
}

// The key of a task: its kind, the phase's hash, and per function its
// symbol, what is known of it and its IR's hash.
fn key_put_fn(k: &mut H2, fi: i64, irh: *mut H2, pcx: &Ctx<Comp>) {
    unsafe {
        h2_puti(k, (pcx.fn_nameh[(*get_irfuncs().add(fi as usize)).f as usize]));
        h2_put(k, own_fp(fi, pcx));
        h2_put(k, (*irh).a);
        h2_put(k, (*irh).b);
    }
}

// Hashes function fi's IR as the task receives it into the key, its
// strings appended to the task's; false when it cannot be.
fn hash_input(cx: &mut FnCtx<Comp>, cc: &mut CcCtx, fi: i64, key: &mut H2, pcx: &Ctx<Comp>) -> bool {
    cc.members.push(fi);
    cc.own_start.push(cc.own_strs.len() as i64);
    cc.consts_before.push(const_data_count(fi));
    let mut h = H2 { a: 0, b: 0 };
    ir_enter(cx, fi, pcx);
    let ok = ir_hash(cx, fi, 0, &mut cc.own_strs, &mut h, pcx);
    key_put_fn(key, fi, &mut h, pcx);
    ok
}

// ---- Checking an entry's reads ----

// Whether every read entry r records reads the same now (r is left after
// them, and the alias hash).
fn reads_hold(cx: &mut FnCtx<Comp>, cc: &mut CcCtx, r: &mut Reader, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let n = get_count(r);
        cc.reads.clear();
        for i in 0..n {
            let kind = get_u(r) as i64;
            let a = get_s(r);
            let b = get_s(r);
            if r.bad {
                return false;
            }
            if kind == R_BUDGET {
                let within = pcx.program_size + a <= pcx.program_budget;
                if within != (b != 0) {
                    if pcx.why {
                        eprintln("code cache: read budget {a} changed");
                    }
                    return false;
                }
                continue;
            }
            let g = ir_of_name(a, pcx);
            if g < 0 || is_own(*cc, g, pcx) {
                return false;
            }
            if kind == R_CALLS {
                let one = (pcx.fn_calls[g as usize]) - (b >> 1) == 1;
                if one != ((b & 1) != 0) {
                    if pcx.why {
                        eprintln(
                            "code cache: read calls of {} changed",
                            str::from_utf8(
                                crate::base::cstr(
                                    crate::base::sym_name(
                                        pcx.fns[(*get_irfuncs().add(g as usize)).f as usize].name,
                                        pcx))).unwrap());
                    }
                    return false;
                }
                continue;
            }
            if kind < R_STATIC || kind > R_IR {
                return false;
            }
            // (a function's other facts only once it is ready: its own task
            // may be writing them)
            if kind != R_STATIC && !ready_or_done(cx, g, pcx) {
                return false;
            }
            if kind == R_IR && !(*get_fn_irh_ok().add(g as usize)) {
                return false;
            }
            if fact(cx, kind, g, pcx) != b {
                if pcx.why {
                    let name = crate::base::sym_name(
                        pcx.fns[(*get_irfuncs().add(g as usize)).f as usize].name, pcx);
                    eprintln("code cache: read {kind} of {} changed",
                        str::from_utf8(crate::base::cstr(name)).unwrap());
                }
                return false;
            }
            if kind == R_IR {
                cc.reads.push(g);
            }
        }
        let alias = get_u(r);
        !r.bad && alias == alias_hash(*cc)
    }
}

// Whether g's facts are final for the task: ready in -O2's bottom-up
// phase, else always (the phases after it read only what is done).
fn ready_or_done(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> bool {
    if cx.cur_comp >= 0 {
        return fn_facts_ready(cx, g, true, pcx);
    }
    true
}

// Which strings of the task's lists (its own, then those of the
// functions whose IR it read, (*cc).reads after reads_hold) are the same
// id: for each, how far back the first of its id is, hashed.
fn alias_hash(cc: CcCtx) -> u64 {
    unsafe {
        let mut map = crate::middle::lower::ssa::HMap {
            keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0,
            count: 0,
        };
        let mut h: u64 = 0x616c6961;
        let mut pos: i64 = 0;
        for i in 0..cc.own_strs.len() as i64 {
            h = alias_put(&mut map, h, (cc.own_strs[i as usize]), pos);
            pos += 1;
        }
        for k in 0..cc.reads.len() as i64 {
            let g = (cc.reads[k as usize]);
            for i in 0..(*get_fn_strs().add(g as usize)).len() as i64 {
                h = alias_put(&mut map, h, ((*get_fn_strs().add(g as usize))[i as usize]),
                    pos);
                pos += 1;
            }
        }
        free(map.keys as *mut u8);
        free(map.vals as *mut u8);
        h
    }
}

fn alias_put(map: &mut crate::middle::lower::ssa::HMap, h: u64, id: i64, pos: i64) -> u64 {
    let key = (id << 1) | 1;
    let first = map.get(key);
    if first == 0 {
        map.put(key, pos + 1);
        return mix(h, 0);
    }
    mix(h, (pos + 1 - first) as u64)
}

// The recorded reads into an entry's body: the reads, then the alias hash
// over the strings of the functions whose IR was read (in their order).
fn put_reads(cc: &mut CcCtx, b: &mut ByteBuf, pcx: &Ctx<Comp>) {
    unsafe {
        let n = cc.reads.len() as i64 / 3;
        put_u(b, n as u64);
        let mut irs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for i in 0..n {
            let kind = (cc.reads[(3 * i) as usize]);
            put_u(b, kind as u64);
            put_s(b, (cc.reads[(3 * i + 1) as usize]));
            put_s(b, (cc.reads[(3 * i + 2) as usize]));
            if kind == R_IR {
                irs.push(ir_of_name((cc.reads[(3 * i + 1) as usize]), pcx));
            }
        }
        // (alias_hash reads the functions from cc.reads)
        let saved = cc.reads;
        cc.reads = irs;
        put_u(b, alias_hash(*cc));
        cc.reads = saved;
        free(irs.data as *mut u8);
    }
}

// ---- The entry's tables ----

// The strings an entry's outputs may name: the task's own lists, then
// those of the functions whose IR it read (src: their place).
fn rel_sources(cc: &mut CcCtx, irs: IntVec) {
    unsafe {
        let rel: *mut Rel = &mut cc.rel;
        rel_clear(&mut *rel);
        let m = cc.own_start.len() as i64;
        for i in 0..m {
            let from = (cc.own_start[i as usize]);
            let to = if i + 1 < m { (cc.own_start[(i + 1) as usize]) }
                else { cc.own_strs.len() as i64 };
            rel_add_source(&mut *rel, i, &cc.own_strs.as_slice()[from as usize..to as usize]);
        }
        for j in 0..irs.len() as i64 {
            let g = (irs[j as usize]);
            rel_add_source(&mut *rel, m + j, (*get_fn_strs().add(g as usize)).as_slice());
        }
    }
}

// The IR functions whose IR the task read, in the order of its reads.
fn read_irs(cc: CcCtx, pcx: &Ctx<Comp>) -> IntVec {
    let mut irs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    let n = cc.reads.len() as i64 / 3;
    for i in 0..n {
        if (cc.reads[(3 * i) as usize]) == R_IR {
            irs.push(ir_of_name((cc.reads[(3 * i + 1) as usize]), pcx));
        }
    }
    irs
}

// Writes the tables of rel into b: strings by source, constant data by
// owner (a function of the task: 1 + its place among them, with k past
// what it had when the task began; else 0 and the owner's symbol),
// symbols by text, functions by symbol.
fn put_tables(cc: &mut CcCtx, b: &mut ByteBuf, pcx: &Ctx<Comp>) {
    unsafe {
        let rel: *mut Rel = &mut cc.rel;
        put_u(b, (*rel).strs.len() as i64 as u64);
        for i in 0..(*rel).strs.len() as i64 {
            let s = rel_str_source(*rel, i);
            put_u(b, (s >> 32) as u64);
            put_u(b, (s & 0xffffffff) as u64);
        }
        put_u(b, (*rel).consts.len() as i64 as u64);
        for i in 0..(*rel).consts.len() as i64 {
            let m = -((*rel).consts[i as usize]) - 1;
            let owner = m >> OWNER_SHIFT;
            let k = m & ((1 << OWNER_SHIFT) - 1);
            let mut member: i64 = -1;
            for j in 0..cc.own_start.len() as i64 {
                if member_fn(*cc, j) == owner && k >= (cc.consts_before[j as usize]) {
                    member = j;
                }
            }
            if member >= 0 {
                put_u(b, (member + 1) as u64);
                put_u(b, (k - (cc.consts_before[member as usize])) as u64);
            } else {
                put_u(b, 0);
                put_s(b, ir_nameh(owner, pcx));
                put_u(b, k as u64);
            }
        }
        put_u(b, (*rel).syms.len() as i64 as u64);
        for i in 0..(*rel).syms.len() as i64 {
            let t = sym_text(((*rel).syms[i as usize]), pcx);
            put_bytes(b, t.ptr, t.len() as i64);
        }
        // (a function whose symbol another has, a C function declared in
        // several modules: by its index too, which the IR's hashes hold)
        put_u(b, (*rel).fns.len() as i64 as u64);
        for i in 0..(*rel).fns.len() as i64 {
            let f = ((*rel).fns[i as usize]);
            put_s(b, (pcx.fn_nameh[f as usize]));
            put_s(b, if (*pcx.fn_ambig.add(f as usize)) { f } else { -1 });
        }
        // (RTID values: a function of the task by its place, another by its
        // symbol; the place among its values)
        put_u(b, (*rel).rtids.len() as i64 as u64);
        for i in 0..(*rel).rtids.len() as i64 {
            let v = ((*rel).rtids[i as usize]);
            let owner = v >> 20;
            let mut member: i64 = -1;
            for j in 0..cc.members.len() as i64 {
                if (cc.members[j as usize]) == owner {
                    member = j;
                }
            }
            put_s(b, member);
            if member < 0 {
                put_s(b, ir_nameh(owner, pcx));
            }
            put_u(b, (v & 1048575) as u64);
        }
    }
}

// The task's j-th function.
fn member_fn(cc: CcCtx, j: i64) -> i64 {
    (cc.members[j as usize])
}

// Reads an entry's tables, mapped to this build's ids (members: the
// task's functions, start in SCC_ORDER or the one; irs: the functions
// whose IR it read): false when one names what is not here.
fn get_tables(cc: &mut CcCtx, r: &mut Reader, irs: IntVec, ids: &mut Ids, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let m = cc.own_start.len() as i64;
        let ns = get_count(r);
        ids.strs = alloc_array::<i64>(ns + 1);
        ids.nstrs = ns;
        for i in 0..ns {
            let src = get_u(r) as i64;
            let k = get_u(r) as i64;
            let mut list: &[i64] = &[];
            if src < m {
                let from = (cc.own_start[src as usize]);
                let to = if src + 1 < m { (cc.own_start[(src + 1) as usize]) }
                    else { cc.own_strs.len() as i64 };
                list = &cc.own_strs.as_slice()[from as usize..to as usize];
            } else if src - m < irs.len() as i64 {
                let g = (irs[(src - m) as usize]);
                list = (*get_fn_strs().add(g as usize)).as_slice();
            }
            let count = list.len() as i64;
            if k < 0 || k >= count {
                if pcx.check {
                    eprintln("code cache check: string {src} {k} not in {count}");
                }
                return false;
            }
            (*ids.strs.add(i as usize)) = list[k as usize];
        }
        let nc = get_count(r);
        ids.consts = alloc_array::<i64>(nc + 1);
        ids.nconsts = nc;
        for i in 0..nc {
            let member = get_u(r) as i64;
            let mut owner: i64 = -1;
            let mut k: i64 = 0;
            if member > 0 {
                if member > m {
                    return false;
                }
                owner = member_fn(*cc, member - 1);
                k = (cc.consts_before[(member - 1) as usize]) + get_u(r) as i64;
            } else {
                // (a placeholder some IR the task read holds: made in an
                // earlier phase)
                owner = ir_of_name(get_s(r), pcx);
                k = get_u(r) as i64;
                if owner < 0 {
                    return false;
                }
            }
            if k < 0 || k >= (1 << OWNER_SHIFT) {
                return false;
            }
            (*ids.consts.add(i as usize)) = -(1 + (owner << OWNER_SHIFT) + k);
        }
        let ny = get_count(r);
        ids.syms = alloc_array::<i64>(ny + 1);
        ids.nsyms = ny;
        for i in 0..ny {
            let mut len: i64 = 0;
            let p = get_bytes(r, &mut len);
            if r.bad {
                return false;
            }
            let sym = find_sym(std::slice::from_raw_parts(p.add((0) as usize),
                (len - (0)) as usize), pcx);
            if sym < 0 {
                if pcx.check {
                    eprintln("code cache check: a symbol not found");
                }
                return false;
            }
            (*ids.syms.add(i as usize)) = sym;
        }
        let nf = get_count(r);
        ids.fns = alloc_array::<i64>(nf + 1);
        ids.nfns = nf;
        for i in 0..nf {
            let h = get_s(r);
            let raw = get_s(r);
            let f: i64 = if raw < 0 { fn_of_name(h, pcx) }
                else if raw < pcx.fns.len() as i64 && (pcx.fn_nameh[raw as usize]) == h { raw }
                else { -1 };
            if f < 0 {
                if pcx.check {
                    eprintln("code cache check: a function not found (or several)");
                }
                return false;
            }
            (*ids.fns.add(i as usize)) = f;
        }
        let nt = get_count(r);
        ids.rtids = alloc_array::<i64>(nt + 1);
        ids.nrtids = nt;
        for i in 0..nt {
            let member = get_s(r);
            let owner: i64 = if member >= 0 && member < m { member_fn(*cc, member) }
                else if member < 0 { ir_of_name(get_s(r), pcx) } else { -1 };
            let k = get_u(r) as i64;
            if owner < 0 || k < 0 || k > 1048575 {
                return false;
            }
            (*ids.rtids.add(i as usize)) = (owner << 20) | k;
        }
        !r.bad
    }
}

// ---- -O2's components ----

// (0.27.8) Entry e, hit by the task of the component of scc_order's
// start..end, is marked used (pack_used), unless one of its functions
// shares its symbol with another (fn_ambig, names_begin): two such tasks
// may have the same key and run in one phase, and their marks would race.
// The mark only keeps the entry from aging out; theirs may age.
fn mark_used(e: i64, start: i64, end: i64, pcx: &Ctx<Comp>) {
    // UNSAFE: IRFUNCS and FN_AMBIG are raw tables (scc_order's entries index
    // the first, its f the second).
    // SAFETY: start..end is the task's component in scc_order, each an IR
    // function below IRFUNC_COUNT; f is a function of FNS, and fn_ambig has
    // one entry for each (names_begin, before the tasks, read-only after).
    unsafe {
        for i in start..end {
            if (
                *pcx.fn_ambig.add(
                    (*get_irfuncs().add((pcx.scc_order[i as usize]) as usize)).f as usize)) {
                return;
            }
        }
    }
    pack_used(e);
}

// (0.27.8) mark_used of a scalar or an emission task, of function fi.
fn mark_used_fn(e: i64, fi: i64, pcx: &Ctx<Comp>) {
    // UNSAFE: the same raw tables.
    // SAFETY: fi is the task's own IR function, below IRFUNC_COUNT; its f
    // has an entry in fn_ambig (names_begin), read-only while tasks run.
    unsafe {
        if (*pcx.fn_ambig.add((*get_irfuncs().add(fi as usize)).f as usize)) {
            return;
        }
    }
    pack_used(e);
}

// Component c's task (middle::parallel::run_component, cx.cur_comp set):
// true when its outputs were read from the cache; else its recording
// begins (cc_component_end ends it).
pub fn cc_component_begin(cx: &mut FnCtx<Comp>, c: i64, start: i64, end: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let cc = task_begin(cx, c, (pcx.scc_order[start as usize]), pcx);
        (*cc).own_scc = (pcx.fn_scc[(pcx.scc_order[start as usize]) as usize]);
        let mut key = h2_new(E_COMPONENT as u64);
        h2_put(&mut key, pcx.codecache_env.a);
        h2_put(&mut key, pcx.codecache_env.b);
        h2_puti(&mut key, end - start);
        let mut ok = true;
        for i in start..end {
            let fi = (pcx.scc_order[i as usize]);
            (*get_fn_irh_ok().add(fi as usize)) = false;
            if !hash_input(cx, &mut *cc, fi, &mut key, pcx) {
                ok = false;
            }
        }
        ir_release(cx);
        (*cc).key = key;
        let first = (pcx.scc_order[start as usize]);
        if !ok {
            (*cc).poison = true;
            (*cc).rec = true;
            (*get_out_comp().add(first as usize)) = OUT_POISON;
            return false;
        }
        let e = pack_find(key.a, key.b, pcx);
        if e >= 0 {
            let got = component_hit(cx, &mut *cc, e, c, start, end, pcx);
            if got == OUT_HIT {
                mark_used(e, start, end, pcx);
                (*get_out_comp().add(first as usize)) = OUT_HIT;
                return true;
            }
            (*get_out_comp().add(first as usize)) = got;
        } else {
            (*get_out_comp().add(first as usize)) = OUT_NONE;
        }
        (*cc).reads.clear();
        (*cc).rec = true;
        false
    }
}

// The members' facts a component's task leaves (in its entry).
fn put_facts(b: &mut ByteBuf, fi: i64) {
    unsafe {
        put_s(b, (*get_fn_size().add(fi as usize)));
        put_s(b, (*get_fn_rt().add(fi as usize)));
        put_s(b, (*get_fn_deciders_start().add(fi as usize)));
        put_u(b, (*get_fn_deciders().add(fi as usize)).len() as i64 as u64);
        for i in 0..(*get_fn_deciders().add(fi as usize)).len() as i64 {
            put_s(b, ((*get_fn_deciders().add(fi as usize))[i as usize]));
        }
        put_s(b, (*get_deferred().add(fi as usize)));
        put_s(b, (*get_fn_attrs().add(fi as usize)));
        put_s(b, (*get_fn_nocapture().add(fi as usize)));
        put_s(b, (*get_fn_attrs_done().add(fi as usize)));
    }
}

// The constant data function fi's task made (from its count at the start,
// `before`): their phase, rank (less `rank0`), alignment and bytes.
fn put_consts(b: &mut ByteBuf, fi: i64, before: i64, rank0: i64) {
    let n = const_data_count(fi);
    put_u(b, (n - before) as u64);
    for k in before..n {
        let mut phase: i64 = 0;
        let mut rank: i64 = 0;
        let mut align: i64 = 0;
        let bytes = const_data_entry(fi, k, &mut phase, &mut rank, &mut align);
        put_u(b, phase as u64);
        put_s(b, rank - rank0);
        put_s(b, align);
        put_bytes(b, bytes.ptr, bytes.len() as i64);
    }
}

// Component c's task is done (cx): its functions' IR hashed (what their
// callers and emission read), and its entry made unless poisoned.
pub fn cc_component_end(cx: &mut FnCtx<Comp>, c: i64, start: i64, end: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let cc = cx.cc;
        (*cc).rec = false;
        for i in start..end {
            out_hash(cx, (pcx.scc_order[i as usize]), pcx);
        }
        ir_release(cx);
        if (*cc).poison {
            (*get_out_comp().add((pcx.scc_order[start as usize]) as usize)) = OUT_POISON;
            return;
        }
        let mut irs = read_irs(*cc, pcx);
        rel_sources(&mut *cc, irs);
        let out: *mut ByteBuf = &mut (*cc).out;
        (*out).len = 0;
        put_s(&mut *out, (*get_comp_growth().add(c as usize)));
        put_u(&mut *out, (*get_comp_inlined().add(c as usize)).len() as i64 as u64);
        for m in 0..(*get_comp_inlined().add(c as usize)).len() as i64 {
            put_u(&mut *out,
                rel_fn(&mut (*cc).rel,
                    (*get_irfuncs().add(
                        ((*get_comp_inlined().add(c as usize))[m as usize]) as usize)).f) as u64);
        }
        for i in start..end {
            let fi = (pcx.scc_order[i as usize]);
            ir_enter(cx, fi, pcx);
            encode_ir(cx, fi, &mut *out, &mut (*cc).rel);
            put_facts(&mut *out, fi);
            put_u(&mut *out, (*get_fn_irh().add(fi as usize)).a);
            put_u(&mut *out, (*get_fn_irh().add(fi as usize)).b);
            put_consts(&mut *out, fi, ((*cc).consts_before[(i - start) as usize]), start);
        }
        ir_release(cx);
        free(irs.data as *mut u8);
        if !store(&mut *cc, E_COMPONENT, (pcx.scc_order[start as usize]), pcx) {
            (*get_out_comp().add((pcx.scc_order[start as usize]) as usize)) = OUT_POISON;
            return;
        }
        if pcx.check {
            check_component(cx, &mut *cc, start, end, pcx);
        }
    }
}

// (testing, $VOLE_CACHE_CHECK) The entry just made, read back: its IR
// must be the tables it was made from.
fn check_component(cx: &mut FnCtx<Comp>, cc: &mut CcCtx, start: i64, end: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let body: *mut ByteBuf = &mut cc.body;
        let mut r = Reader { p: (*body).data, at: 0, end: (*body).len, bad: false };
        get_u(&mut r);
        let n = get_count(&mut r);
        for i in 0..n {
            get_u(&mut r);
            get_s(&mut r);
            get_s(&mut r);
        }
        get_u(&mut r);
        let mut irs = read_irs(*cc, pcx);
        let mut ids = Ids { strs: 0 as *mut i64, nstrs: 0, consts: 0 as *mut i64, nconsts: 0,
            syms: 0 as *mut i64, nsyms: 0, fns: 0 as *mut i64, nfns: 0, rtids: 0 as *mut i64,
            nrtids: 0 };
        let name = crate::base::sym_name(
            pcx.fns[
                (*get_irfuncs().add((pcx.scc_order[start as usize]) as usize)).f as usize].name,
            pcx);
        if !get_tables(cc, &mut r, irs, &mut ids, pcx) {
            eprintln("code cache check: {}: tables do not read back",
                str::from_utf8(crate::base::cstr(name)).unwrap());
            return;
        }
        get_s(&mut r);
        let ni = get_count(&mut r);
        for m in 0..ni {
            get_u(&mut r);
        }
        for i in start..end {
            let fi = (pcx.scc_order[i as usize]);
            let mut copy = IRCopy { entry: 0, result_ptr: 0,
                blocks: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
                slots: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
                t: IRTables { insts: 0 as *mut crate::middle::ir::Inst, inst_count: 0, inst_cap: 0,
                    blocks: 0 as *mut crate::middle::ir::Block, block_count: 0, block_cap: 0,
                    slots: 0 as *mut crate::middle::ir::Slot, slot_count: 0, slot_cap: 0,
                    args: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
                    argty: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
                    swcases: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
                    inst_loc: IntVec { data: 0 as *mut i64, count: 0, cap: 0 } } };
            let fname = crate::base::sym_name(
                pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].name, pcx);
            if !decode_ir(&mut r, fi, &mut ids, &mut copy) {
                eprintln(
                    "code cache check: {}: IR does not read back (at {} of {})",
                    str::from_utf8(crate::base::cstr(fname)).unwrap(), r.at, r.end);
                return;
            }
            ir_enter(cx, fi, pcx);
            let d = crate::back::codecache::snapshot::copy_differs(cx, fi, &mut copy);
            if d != 0 {
                eprintln(
                    "code cache check: {}: IR differs read back ({d})",
                    str::from_utf8(crate::base::cstr(fname)).unwrap());
            }
            free_copy(&mut copy);
            skip_facts(&mut r);
        }
        ir_release(cx);
        ids_free(ids);
        free(irs.data as *mut u8);
    }
}

// Function fi's IR as its task leaves it, hashed (FN_IRH, FN_STRS).
fn out_hash(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        (*get_fn_strs().add(fi as usize)).clear();
        let mut h = H2 { a: 0, b: 0 };
        let ok = ir_hash(cx, fi, 0, get_fn_strs().add(fi as usize), &mut h, pcx);
        (*get_fn_irh().add(fi as usize)) = h;
        (*get_fn_irh_ok().add(fi as usize)) = ok;
        if !ok {
            (*cx.cc).poison = true;
        }
    }
}

// The entry of the task in cc: its reads, tables and outputs (cc.out),
// stored in the slot of function fi.
fn store(cc: &mut CcCtx, kind: i64, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if cc.rel.bad {
            return false;
        }
        let body: *mut ByteBuf = &mut cc.body;
        (*body).len = 0;
        put_u(&mut *body, kind as u64);
        put_reads(cc, &mut *body, pcx);
        put_tables(cc, &mut *body, pcx);
        let out: *mut ByteBuf = &mut cc.out;
        bb_append(&mut *body, (*out).data, (*out).len);
        let copy = alloc_zeroed((*body).len + 1);
        memcpy(copy, (*body).data, (*body).len as u64);
        pack_new(SLOTS_PER_FN * fi + kind - 1, cc.key.a, cc.key.b, copy, (*body).len, pcx);
        true
    }
}

fn bb_append(b: &mut ByteBuf, p: *mut u8, n: i64) {
    unsafe {
        crate::back::codecache::snapshot::bb_reserve(b, n);
        if n > 0 {
            memcpy(b.data.add(b.len as usize), p, n as u64);
        }
        b.len += n;
    }
}

// Reads entry e for component c: its reads checked, then its outputs
// installed. OUT_HIT, or why not (nothing installed then).
fn component_hit(cx: &mut FnCtx<Comp>, cc: &mut CcCtx, e: i64, c: i64, start: i64, end: i64,
    pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut r = Reader { p: 0 as *mut u8, at: 0, end: 0, bad: false };
        if !pack_body(e, &mut r, pcx) || get_u(&mut r) as i64 != E_COMPONENT {
            return OUT_BAD;
        }
        if !reads_hold(cx, cc, &mut r, pcx) {
            return OUT_READ;
        }
        let mut irs = cc.reads;
        cc.reads = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut ids = Ids { strs: 0 as *mut i64, nstrs: 0, consts: 0 as *mut i64, nconsts: 0,
            syms: 0 as *mut i64, nsyms: 0, fns: 0 as *mut i64, nfns: 0, rtids: 0 as *mut i64,
            nrtids: 0 };
        let mut result = OUT_BAD;
        if get_tables(cc, &mut r, irs, &mut ids, pcx) {
            result = component_install(cx, *cc, &mut r, &mut ids, c, start, end, pcx);
        }
        ids_free(ids);
        free(irs.data as *mut u8);
        result
    }
}

// The outputs of a component's entry (r at them), installed when all of
// them read.
fn component_install(cx: &mut FnCtx<Comp>, cc: CcCtx, r: &mut Reader, ids: &mut Ids, c: i64,
    start: i64, end: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let n = end - start;
        let growth = get_s(r);
        let ni = get_count(r);
        let mut inlined = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for m in 0..ni {
            let x = get_u(r) as i64;
            if x >= ids.nfns {
                free(inlined.data as *mut u8);
                return OUT_BAD;
            }
            let f = (*ids.fns.add(x as usize));
            let g: i64 = if (pcx.fn_ir[f as usize]) > 0 { (pcx.fn_ir[f as usize]) - 1 }
                else { -1 };
            if g < 0 {
                free(inlined.data as *mut u8);
                return OUT_BAD;
            }
            inlined.push(g);
        }
        let copies = alloc_zeroed((n + 1) * size_of(IRCopy)) as *mut IRCopy;
        // (per member: where its facts and constant data are in r)
        let facts_at = alloc_array::<i64>(n + 1);
        let mut ok = true;
        for i in 0..n {
            let fi = (pcx.scc_order[(start + i) as usize]);
            if !decode_ir(r, fi, ids, copies.add(i as usize)) {
                ok = false;
                n_free(copies, i + 1);
                break;
            }
            (*facts_at.add(i as usize)) = r.at;
            skip_facts(r);
            if r.bad {
                ok = false;
                n_free(copies, i + 1);
                break;
            }
        }
        if !ok || r.bad {
            free(copies as *mut u8);
            free(facts_at as *mut u8);
            free(inlined.data as *mut u8);
            return OUT_BAD;
        }
        // Installed: each function's IR, facts and constant data.
        for i in 0..n {
            let fi = (pcx.scc_order[(start + i) as usize]);
            install_ir(cx, fi, copies.add(i as usize), pcx);
            r.at = (*facts_at.add(i as usize));
            get_facts(r, fi);
            (*get_fn_irh().add(fi as usize)).a = get_u(r);
            (*get_fn_irh().add(fi as usize)).b = get_u(r);
            (*get_fn_irh_ok().add(fi as usize)) = true;
            replay_consts(cx, r, fi, P_COMPONENT, start);
            // (its strings, as hash::ir_hash lists them)
            list_strings(cx, fi);
        }
        ir_release(cx);
        (*get_comp_growth().add(c as usize)) = growth;
        for m in 0..inlined.len() as i64 {
            (*get_comp_inlined().add(c as usize)).push((inlined[m as usize]));
        }
        free(copies as *mut u8);
        free(facts_at as *mut u8);
        free(inlined.data as *mut u8);
        OUT_HIT
    }
}

fn n_free(copies: *mut IRCopy, n: i64) {
    unsafe {
        for i in 0..n {
            free_copy(copies.add(i as usize));
        }
    }
}

fn skip_facts(r: &mut Reader) {
    for i in 0..3 {
        get_s(r);
    }
    let nd = get_count(r);
    for i in 0..nd {
        get_s(r);
    }
    for i in 0..4 {
        get_s(r);
    }
    get_u(r);
    get_u(r);
    let nc = get_count(r);
    for k in 0..nc {
        get_u(r);
        get_s(r);
        get_s(r);
        let mut len: i64 = 0;
        get_bytes(r, &mut len);
    }
}

fn get_facts(r: &mut Reader, fi: i64) {
    unsafe {
        (*get_fn_size().add(fi as usize)) = get_s(r);
        (*get_fn_rt().add(fi as usize)) = get_s(r);
        (*get_fn_deciders_start().add(fi as usize)) = get_s(r);
        let nd = get_count(r);
        (*get_fn_deciders().add(fi as usize)).clear();
        for i in 0..nd {
            (*get_fn_deciders().add(fi as usize)).push(get_s(r));
        }
        (*get_deferred().add(fi as usize)) = get_s(r);
        (*get_fn_attrs().add(fi as usize)) = get_s(r);
        (*get_fn_nocapture().add(fi as usize)) = get_s(r);
        (*get_fn_attrs_done().add(fi as usize)) = get_s(r);
    }
}

// The constant data an entry's task made for function fi, made again (in
// its order: the same placeholders), in phase `phase`'s order with rank
// rank0 + the recorded one.
fn replay_consts(cx: &mut FnCtx<Comp>, r: &mut Reader, fi: i64, phase: i64, rank0: i64) {
    unsafe {
        let nc = get_count(r);
        let saved_phase = cx.task_phase;
        let saved_rank = cx.task_rank;
        for k in 0..nc {
            let ph = get_u(r) as i64;
            let rank = get_s(r);
            let align = get_s(r);
            let mut len: i64 = 0;
            let p = get_bytes(r, &mut len);
            cx.task_phase = ph;
            cx.task_rank = rank + rank0;
            const_data(cx, fi,
                std::slice::from_raw_parts(p.add((0) as usize), (len - (0)) as usize), align);
        }
        cx.task_phase = saved_phase;
        cx.task_rank = saved_rank;
    }
}

// Function fi's tables replaced by a read copy.
fn install_ir(cx: &mut FnCtx<Comp>, fi: i64, c: *mut IRCopy, pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        for b in 0..cx.block_count {
            free((*cx.blocks.add(b as usize)).preds.data as *mut u8);
        }
        free(cx.insts as *mut u8);
        free(cx.blocks as *mut u8);
        free(cx.slots as *mut u8);
        free(cx.args.data as *mut u8);
        free(cx.argty.data as *mut u8);
        free(cx.swcases.data as *mut u8);
        free(cx.inst_loc.data as *mut u8);
        free((*get_irfuncs().add(fi as usize)).blocks.data as *mut u8);
        free((*get_irfuncs().add(fi as usize)).slots.data as *mut u8);
        (*get_irfuncs().add(fi as usize)).entry = (*c).entry;
        (*get_irfuncs().add(fi as usize)).result_ptr = (*c).result_ptr;
        (*get_irfuncs().add(fi as usize)).blocks = (*c).blocks;
        (*get_irfuncs().add(fi as usize)).slots = (*c).slots;
        let t = (*c).t;
        cx.insts = t.insts;
        cx.inst_count = t.inst_count;
        cx.inst_cap = t.inst_cap;
        cx.blocks = t.blocks;
        cx.block_count = t.block_count;
        cx.block_cap = t.block_cap;
        cx.slots = t.slots;
        cx.slot_count = t.slot_count;
        cx.slot_cap = t.slot_cap;
        cx.args = t.args;
        cx.argty = t.argty;
        cx.swcases = t.swcases;
        cx.inst_loc = t.inst_loc;
    }
}

// FN_STRS[fi]: the distinct string ids of fi's SADDRs (current in cx), in
// instruction order (as ir_hash lists them).
fn list_strings(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        (*get_fn_strs().add(fi as usize)).clear();
        let mut map = crate::middle::lower::ssa::HMap {
            keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0,
            count: 0,
        };
        for i in 0..cx.inst_count {
            if (*cx.insts.add(i as usize)).op == crate::middle::ir::Op::SAddr
                && (*cx.insts.add(i as usize)).imm >= 0 {
                let key = ((*cx.insts.add(i as usize)).imm << 1) | 1;
                if map.get(key) == 0 {
                    map.put(key, 1);
                    (*get_fn_strs().add(fi as usize)).push((*cx.insts.add(i as usize)).imm);
                }
            }
        }
        free(map.keys as *mut u8);
        free(map.vals as *mut u8);
    }
}

// ---- Emission ----

// Function fi's emission task (task: its rank): true when its text came
// from the cache (FN_TEXT[fi] set, its IR freed); else its recording
// begins, and the text names strings by index (cc_text_string).
pub fn cc_emit_begin(cx: &mut FnCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let cc = task_begin(cx, -1, fi, pcx);
        if pcx.fn_scc.len() > 0 {
            (*cc).own_scc = (pcx.fn_scc[fi as usize]);
        }
        let mut key = h2_new(E_EMIT as u64);
        h2_put(&mut key, pcx.codecache_env.a);
        h2_put(&mut key, pcx.codecache_env.b);
        let mut ok = true;
        if (*get_fn_irh_ok().add(fi as usize)) {
            (*cc).members.push(fi);
            (*cc).own_start.push(0);
            (*cc).consts_before.push(const_data_count(fi));
            for i in 0..(*get_fn_strs().add(fi as usize)).len() as i64 {
                (*cc).own_strs.push(((*get_fn_strs().add(fi as usize))[i as usize]));
            }
            key_put_fn(&mut key, fi, get_fn_irh().add(fi as usize), pcx);
        } else {
            ok = hash_input(cx, &mut *cc, fi, &mut key, pcx);
            ir_release(cx);
        }
        (*get_fn_irh_ok().add(fi as usize)) = false;
        (*cc).key = key;
        (*cc).text = true;
        if !ok {
            (*cc).poison = true;
            (*cc).rec = true;
            (*get_out_emit().add(fi as usize)) = OUT_POISON;
            return false;
        }
        let e = pack_find(key.a, key.b, pcx);
        if e >= 0 {
            let got = emit_hit(cx, &mut *cc, e, fi, task, pcx);
            if got == OUT_HIT {
                mark_used_fn(e, fi, pcx);
                (*get_out_emit().add(fi as usize)) = OUT_HIT;
                (*cc).text = false;
                return true;
            }
            (*get_out_emit().add(fi as usize)) = got;
        } else {
            (*get_out_emit().add(fi as usize)) = OUT_NONE;
        }
        (*cc).reads.clear();
        (*cc).relocs.clear();
        (*cc).reloc_map.clear();
        (*cc).rec = true;
        false
    }
}

// The text's name for string or constant data `id` (a task's, with the
// cache): its index among the text's (written L\x03<index>, the join puts
// the id), or -1 without.
pub fn cc_text_string(cx: &mut FnCtx<Comp>, id: i64) -> i64 {
    unsafe {
        let cc = cx.cc;
        if cc == 0 as *mut CcCtx || !(*cc).text {
            return -1;
        }
        let key = (id << 1) | 1;
        let i = (*cc).reloc_map.get(key);
        if i > 0 {
            return i - 1;
        }
        (*cc).relocs.push(id);
        (*cc).reloc_map.put(key, (*cc).relocs.len() as i64);
        (*cc).relocs.len() as i64 - 1
    }
}

// Function fi's emission is done (its text in FN_TEXT[fi]): the text's
// string ids for the join, and its entry made unless poisoned.
pub fn cc_emit_end(cx: &mut FnCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let cc = cx.cc;
        (*cc).rec = false;
        (*cc).text = false;
        let t: *mut crate::middle::parallel::FnText = get_fn_text().add(fi as usize);
        let nr = (*cc).relocs.len() as i64;
        (*t).relocs = alloc_array::<i64>(nr + 1);
        for i in 0..nr {
            (*(*t).relocs.add(i as usize)) = ((*cc).relocs[i as usize]);
        }
        (*t).nrelocs = nr;
        if (*cc).poison {
            (*get_out_emit().add(fi as usize)) = OUT_POISON;
            return;
        }
        let mut irs = read_irs(*cc, pcx);
        rel_sources(&mut *cc, irs);
        let out: *mut ByteBuf = &mut (*cc).out;
        (*out).len = 0;
        put_bytes(&mut *out, (*t).data, (*t).len);
        put_s(&mut *out, (*t).labels);
        put_u(&mut *out, nr as u64);
        for i in 0..nr {
            put_u(&mut *out,
                rel_saddr(&mut (*cc).rel, ((*cc).relocs[i as usize])) as u64);
        }
        put_consts(&mut *out, fi, ((*cc).consts_before[0]), 0);
        put_u(&mut *out, (*t).nrtids as u64);
        for i in 0..(*t).nrtids {
            put_u(&mut *out, rel_rtid(&mut (*cc).rel, (*(*t).rtids.add(i as usize))) as u64);
        }
        free(irs.data as *mut u8);
        if !store(&mut *cc, E_EMIT, fi, pcx) {
            (*get_out_emit().add(fi as usize)) = OUT_POISON;
        }
    }
}

// Reads entry e for function fi's emission: its reads checked, then its
// text and constant data installed. OUT_HIT, or why not.
fn emit_hit(cx: &mut FnCtx<Comp>, cc: &mut CcCtx, e: i64, fi: i64, task: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut r = Reader { p: 0 as *mut u8, at: 0, end: 0, bad: false };
        if !pack_body(e, &mut r, pcx) || get_u(&mut r) as i64 != E_EMIT {
            return OUT_BAD;
        }
        if !reads_hold(cx, cc, &mut r, pcx) {
            return OUT_READ;
        }
        let mut irs = cc.reads;
        cc.reads = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut ids = Ids { strs: 0 as *mut i64, nstrs: 0, consts: 0 as *mut i64, nconsts: 0,
            syms: 0 as *mut i64, nsyms: 0, fns: 0 as *mut i64, nfns: 0, rtids: 0 as *mut i64,
            nrtids: 0 };
        let mut result = OUT_BAD;
        if get_tables(cc, &mut r, irs, &mut ids, pcx) {
            result = emit_install(cx, &mut r, &mut ids, fi, task, pcx);
        }
        ids_free(ids);
        free(irs.data as *mut u8);
        result
    }
}

fn emit_install(cx: &mut FnCtx<Comp>, r: &mut Reader, ids: &mut Ids, fi: i64, task: i64,
    pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut len: i64 = 0;
        let text = get_bytes(r, &mut len);
        let labels = get_s(r);
        let nr = get_count(r);
        let relocs = alloc_array::<i64>(nr + 1);
        let mut bad = false;
        for i in 0..nr {
            (*relocs.add(i as usize)) = crate::back::codecache::snapshot::ids_saddr(*ids,
                get_u(r) as i64, &mut bad);
        }
        if bad || r.bad {
            free(relocs as *mut u8);
            return OUT_BAD;
        }
        // (the constant data: P_EMIT's rank is the task's, the others' the
        // function's)
        let nc_at = r.at;
        let nc = get_count(r);
        for k in 0..nc {
            get_u(r);
            get_s(r);
            get_s(r);
            let mut n: i64 = 0;
            get_bytes(r, &mut n);
        }
        // (its RTID values, after: the text's loads of them)
        let nt = get_count(r);
        let rtids = alloc_array::<i64>(nt + 1);
        for k in 0..nt {
            (*rtids.add(k as usize)) = crate::back::codecache::snapshot::ids_at(ids.rtids,
                ids.nrtids, get_u(r) as i64, &mut bad);
        }
        if r.bad || bad {
            free(relocs as *mut u8);
            free(rtids as *mut u8);
            return OUT_BAD;
        }
        r.at = nc_at;
        let saved_phase = cx.task_phase;
        let saved_rank = cx.task_rank;
        for k in 0..get_count(r) {
            let ph = get_u(r) as i64;
            get_s(r);
            let align = get_s(r);
            let mut n: i64 = 0;
            let p = get_bytes(r, &mut n);
            cx.task_phase = ph;
            cx.task_rank = if ph == P_EMIT { task } else { fi };
            const_data(cx, fi, std::slice::from_raw_parts(p.add((0) as usize), (n - (0)) as usize),
                align);
        }
        cx.task_phase = saved_phase;
        cx.task_rank = saved_rank;
        let t: *mut crate::middle::parallel::FnText = get_fn_text().add(fi as usize);
        (*t).len = len;
        (*t).data = alloc_zeroed(len + 1);
        memcpy((*t).data, text, len as u64);
        (*t).labels = labels;
        (*t).relocs = relocs;
        (*t).nrelocs = nr;
        (*t).rtids = rtids;
        (*t).nrtids = nt;
        crate::middle::ir::ir_free_func(cx, fi, pcx);
        OUT_HIT
    }
}

// ---- The scalar phases ----

// -O2's cleanup and scalar pipeline of a function (two tasks, two phases)
// are one entry: its IR as lowered in, as the scalar pipeline leaves it
// out. (-O1's cleanup alone costs less than hashing and reading its
// entry: not cached.) A hit in the cleanup task installs the IR the
// scalar pipeline leaves (no other task reads it between) and makes the
// cleanup's constant data; the scalar pipeline's task then makes its
// constant data (in its phase's order) and nothing else. A miss records
// across both tasks (SCALAR_REC, the function's own).
#[derive(Clone, Copy)] struct ScalarRec {
    reads: IntVec, own_strs: IntVec, before: i64, key: H2, poison: bool, hit: i64,
    at: i64,
}

static mut SCALAR_REC: *mut ScalarRec = 0 as *mut ScalarRec;
const E_SCALAR: i64 = 3;

fn scalar_rec(fi: i64) -> *mut ScalarRec {
    unsafe {
        get_scalar_rec().add(fi as usize)
    }
}

// Function fi's cleanup task (task: its rank): true when the entry was
// used (its IR installed).
pub fn cc_scalar_begin(cx: &mut FnCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let cc = task_begin(cx, -1, fi, pcx);
        let sr = scalar_rec(fi);
        (*sr).hit = -1;
        (*get_fn_irh_ok().add(fi as usize)) = false;
        let mut key = h2_new(E_SCALAR as u64);
        h2_put(&mut key, pcx.codecache_env.a);
        h2_put(&mut key, pcx.codecache_env.b);
        let ok = hash_input(cx, &mut *cc, fi, &mut key, pcx);
        ir_release(cx);
        (*cc).key = key;
        if !ok {
            (*cc).poison = true;
            (*cc).rec = true;
            (*get_out_scalar().add(fi as usize)) = OUT_POISON;
            return false;
        }
        let e = pack_find(key.a, key.b, pcx);
        if e >= 0 {
            let got = scalar_hit(cx, &mut *cc, e, fi, task, pcx);
            if got == OUT_HIT {
                mark_used_fn(e, fi, pcx);
                (*get_out_scalar().add(fi as usize)) = OUT_HIT;
                return true;
            }
            (*get_out_scalar().add(fi as usize)) = got;
        } else {
            (*get_out_scalar().add(fi as usize)) = OUT_NONE;
        }
        (*cc).reads.clear();
        (*cc).rec = true;
        false
    }
}

// Function fi's cleanup is done (a miss): the recording kept for its
// scalar pipeline's task.
pub fn cc_scalar_cleanup_end(cx: &mut FnCtx<Comp>, fi: i64) {
    unsafe {
        let cc = cx.cc;
        (*cc).rec = false;
        let sr = scalar_rec(fi);
        copy_ints(&mut (*sr).reads, &mut (*cc).reads);
        copy_ints(&mut (*sr).own_strs, &mut (*cc).own_strs);
        (*sr).before = ((*cc).consts_before[0]);
        (*sr).key = (*cc).key;
        (*sr).poison = (*cc).poison;
    }
}

fn copy_ints(dst: *mut IntVec, src: *mut IntVec) {
    unsafe {
        (*dst).clear();
        for i in 0..(*src).len() as i64 {
            (*dst).push(((*src)[i as usize]));
        }
    }
}

// Function fi's scalar pipeline task (-O2): true when its cleanup's task
// used the entry (its constant data made here); else the recording goes
// on.
pub fn cc_scalar_simplify_begin(cx: &mut FnCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let sr = scalar_rec(fi);
        if (*sr).hit >= 0 {
            let mut r = Reader { p: 0 as *mut u8, at: 0, end: 0, bad: false };
            pack_body_at((*sr).hit, &mut r, pcx);
            r.at = (*sr).at;
            replay_phase(cx, &mut r, fi, P_SIMPLIFY, task);
            return true;
        }
        let cc = task_begin(cx, -1, fi, pcx);
        (*cc).members.push(fi);
        (*cc).own_start.push(0);
        (*cc).consts_before.push((*sr).before);
        copy_ints(&mut (*cc).own_strs, &mut (*sr).own_strs);
        copy_ints(&mut (*cc).reads, &mut (*sr).reads);
        (*cc).key = (*sr).key;
        (*cc).poison = (*sr).poison;
        (*cc).rec = true;
        false
    }
}

// Function fi's scalar phases are done (a miss): its IR hashed, its entry
// made unless poisoned.
pub fn cc_scalar_end(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let cc = cx.cc;
        (*cc).rec = false;
        out_hash(cx, fi, pcx);
        if (*cc).poison {
            (*get_out_scalar().add(fi as usize)) = OUT_POISON;
            ir_release(cx);
            return;
        }
        let mut irs = read_irs(*cc, pcx);
        rel_sources(&mut *cc, irs);
        let out: *mut ByteBuf = &mut (*cc).out;
        (*out).len = 0;
        ir_enter(cx, fi, pcx);
        encode_ir(cx, fi, &mut *out, &mut (*cc).rel);
        ir_release(cx);
        put_u(&mut *out, (*get_fn_irh().add(fi as usize)).a);
        put_u(&mut *out, (*get_fn_irh().add(fi as usize)).b);
        put_consts(&mut *out, fi, ((*cc).consts_before[0]), 0);
        free(irs.data as *mut u8);
        if !store(&mut *cc, E_SCALAR, fi, pcx) {
            (*get_out_scalar().add(fi as usize)) = OUT_POISON;
        }
    }
}

// Reads entry e for function fi's scalar phases: its reads checked, then
// its IR installed and the cleanup's constant data made (the rest waits
// for the scalar pipeline's task: SCALAR_REC). OUT_HIT, or why not.
fn scalar_hit(cx: &mut FnCtx<Comp>, cc: &mut CcCtx, e: i64, fi: i64, task: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut r = Reader { p: 0 as *mut u8, at: 0, end: 0, bad: false };
        if !pack_body(e, &mut r, pcx) || get_u(&mut r) as i64 != E_SCALAR {
            return OUT_BAD;
        }
        if !reads_hold(cx, cc, &mut r, pcx) {
            return OUT_READ;
        }
        let mut irs = cc.reads;
        cc.reads = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut ids = Ids { strs: 0 as *mut i64, nstrs: 0, consts: 0 as *mut i64, nconsts: 0,
            syms: 0 as *mut i64, nsyms: 0, fns: 0 as *mut i64, nfns: 0, rtids: 0 as *mut i64,
            nrtids: 0 };
        let mut result = OUT_BAD;
        if get_tables(cc, &mut r, irs, &mut ids, pcx) {
            let copy = alloc_zeroed(size_of(IRCopy)) as *mut IRCopy;
            if decode_ir(&mut r, fi, &mut ids, copy) {
                let h_a = get_u(&mut r);
                let h_b = get_u(&mut r);
                let at = r.at;
                if consts_read(&mut r) {
                    install_ir(cx, fi, copy, pcx);
                    list_strings(cx, fi);
                    ir_release(cx);
                    (*get_fn_irh().add(fi as usize)) = H2 { a: h_a, b: h_b };
                    (*get_fn_irh_ok().add(fi as usize)) = true;
                    r.at = at;
                    replay_phase(cx, &mut r, fi, P_CLEANUP, task);
                    let sr = scalar_rec(fi);
                    (*sr).hit = e;
                    (*sr).at = at;
                    result = OUT_HIT;
                } else {
                    free_copy(copy);
                }
            } else {
                free_copy(copy);
            }
            free(copy as *mut u8);
        }
        ids_free(ids);
        free(irs.data as *mut u8);
        result
    }
}

// Whether an entry's constant data reads whole (r is left after it).
fn consts_read(r: &mut Reader) -> bool {
    let nc = get_count(r);
    for k in 0..nc {
        get_u(r);
        get_s(r);
        get_s(r);
        let mut n: i64 = 0;
        get_bytes(r, &mut n);
    }
    !r.bad
}

// The constant data of an entry (r at its list) made in phase `phase`
// made again for function fi, in their order, with rank `rank`.
fn replay_phase(cx: &mut FnCtx<Comp>, r: &mut Reader, fi: i64, phase: i64, rank: i64) {
    unsafe {
        let nc = get_count(r);
        let saved_phase = cx.task_phase;
        let saved_rank = cx.task_rank;
        for k in 0..nc {
            let ph = get_u(r) as i64;
            get_s(r);
            let align = get_s(r);
            let mut n: i64 = 0;
            let p = get_bytes(r, &mut n);
            if ph == phase {
                cx.task_phase = ph;
                cx.task_rank = rank;
                const_data(cx, fi,
                    std::slice::from_raw_parts(p.add((0) as usize), (n - (0)) as usize), align);
            }
        }
        cx.task_phase = saved_phase;
        cx.task_rank = saved_rank;
    }
}

// (0.28.0) FN_IRH's accessors: every use of it is one of them.
pub fn get_fn_irh() -> *mut H2 {
    // UNSAFE: the code cache's per-function IR hashes, a process-wide
    // static mut every task reads and writes; Rust has no safe access to a
    // static mut
    // SAFETY: allocated by cc_begin and refilled for every function by
    // cc_phase on the main thread between phases; a task writes only its
    // own functions' entries (out_hash, component_install, scalar_hit);
    // another g's entry is read only through fact(R_IR) in cc_note and
    // reads_hold, after ready_or_done(g) and FN_IRH_OK[g], and an R_IR read
    // of another function is recorded only by inline_call (ir_enter of
    // another runs only on the inliner's unset branches): in the component
    // phase ready_or_done requires g's lower, finished level; outside it
    // the only R_IR reads are -O1 emission's of small leaves, emitted (and
    // so written) only in the next range, after pool_run_joined returned;
    // cleanup and simplify tasks inline nothing, so their entries hold no
    // R_IR of another function
    unsafe { FN_IRH }
}

pub fn set_fn_irh(v: *mut H2) {
    // UNSAFE: the code cache's per-function IR hashes, a process-wide
    // static mut every task reads and writes; Rust has no safe access to a
    // static mut
    // SAFETY: allocated by cc_begin and refilled for every function by
    // cc_phase on the main thread between phases; a task writes only its
    // own functions' entries (out_hash, component_install, scalar_hit);
    // another g's entry is read only through fact(R_IR) in cc_note and
    // reads_hold, after ready_or_done(g) and FN_IRH_OK[g], and an R_IR read
    // of another function is recorded only by inline_call (ir_enter of
    // another runs only on the inliner's unset branches): in the component
    // phase ready_or_done requires g's lower, finished level; outside it
    // the only R_IR reads are -O1 emission's of small leaves, emitted (and
    // so written) only in the next range, after pool_run_joined returned;
    // cleanup and simplify tasks inline nothing, so their entries hold no
    // R_IR of another function
    unsafe {
        FN_IRH = v;
    }
}

// (0.28.0) FN_IRH_OK's accessors: every use of it is one of them.
pub fn get_fn_irh_ok() -> *mut bool {
    // UNSAFE: the code cache's per-function IR-hash validity, a
    // process-wide static mut every task reads and writes; Rust has no safe
    // access to a static mut
    // SAFETY: as FN_IRH: cc_phase (main, between phases) sets every entry;
    // a task writes only its own (cc_component_begin, cc_emit_begin,
    // cc_scalar_begin, out_hash, component_install, scalar_hit); another
    // g's entry is read only in cc_note and reads_hold for an R_IR read,
    // after ready_or_done(g), and such reads exist only for a lower-level g
    // in the component phase or for an -O1 small leaf whose own emission
    // task runs only in the later range
    unsafe { FN_IRH_OK }
}

pub fn set_fn_irh_ok(v: *mut bool) {
    // UNSAFE: the code cache's per-function IR-hash validity, a
    // process-wide static mut every task reads and writes; Rust has no safe
    // access to a static mut
    // SAFETY: as FN_IRH: cc_phase (main, between phases) sets every entry;
    // a task writes only its own (cc_component_begin, cc_emit_begin,
    // cc_scalar_begin, out_hash, component_install, scalar_hit); another
    // g's entry is read only in cc_note and reads_hold for an R_IR read,
    // after ready_or_done(g), and such reads exist only for a lower-level g
    // in the component phase or for an -O1 small leaf whose own emission
    // task runs only in the later range
    unsafe {
        FN_IRH_OK = v;
    }
}

// (0.28.0) FN_STRS's accessors: every use of it is one of them.
pub fn get_fn_strs() -> *mut IntVec {
    // UNSAFE: the code cache's per-function string lists, a process-wide
    // static mut every task reads and writes; Rust has no safe access to a
    // static mut
    // SAFETY: cc_phase (main, between phases) refills every entry; a task
    // writes only its own (list_strings(fi) from component_install,
    // out_hash(fi)); another g's list is read (alias_hash, rel_sources,
    // get_tables) only for g in the task's R_IR reads (cc.reads, read_irs),
    // which passed ready_or_done and FN_IRH_OK: a lower, finished level in
    // the component phase, or an -O1 small leaf in emission, whose list no
    // task writes during emission
    unsafe { FN_STRS }
}

pub fn set_fn_strs(v: *mut IntVec) {
    // UNSAFE: the code cache's per-function string lists, a process-wide
    // static mut every task reads and writes; Rust has no safe access to a
    // static mut
    // SAFETY: cc_phase (main, between phases) refills every entry; a task
    // writes only its own (list_strings(fi) from component_install,
    // out_hash(fi)); another g's list is read (alias_hash, rel_sources,
    // get_tables) only for g in the task's R_IR reads (cc.reads, read_irs),
    // which passed ready_or_done and FN_IRH_OK: a lower, finished level in
    // the component phase, or an -O1 small leaf in emission, whose list no
    // task writes during emission
    unsafe {
        FN_STRS = v;
    }
}

// (0.28.0) OUT_COMP's accessors: every use of it is one of them.
fn get_out_comp() -> *mut i64 {
    // UNSAFE: the code cache's per-component outcome, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: allocated by cc_begin on the main thread before the phases;
    // written only at the component's first function's index by that
    // component's task (cc_component_begin, cc_component_end:
    // scc_order[start]); read only by report on the main thread at cc_end,
    // after the phases and parallel_end
    unsafe { OUT_COMP }
}

fn set_out_comp(v: *mut i64) {
    // UNSAFE: the code cache's per-component outcome, a process-wide static
    // mut; Rust has no safe access to a static mut
    // SAFETY: allocated by cc_begin on the main thread before the phases;
    // written only at the component's first function's index by that
    // component's task (cc_component_begin, cc_component_end:
    // scc_order[start]); read only by report on the main thread at cc_end,
    // after the phases and parallel_end
    unsafe {
        OUT_COMP = v;
    }
}

// (0.28.0) OUT_EMIT's accessors: every use of it is one of them.
fn get_out_emit() -> *mut i64 {
    // UNSAFE: the code cache's per-function emission outcome, a
    // process-wide static mut; Rust has no safe access to a static mut
    // SAFETY: allocated by cc_begin on the main thread; OUT_EMIT[fi]
    // written only by fi's emission task (cc_emit_begin/cc_emit_end, one
    // task per function); read only by report at cc_end, after every phase
    unsafe { OUT_EMIT }
}

fn set_out_emit(v: *mut i64) {
    // UNSAFE: the code cache's per-function emission outcome, a
    // process-wide static mut; Rust has no safe access to a static mut
    // SAFETY: allocated by cc_begin on the main thread; OUT_EMIT[fi]
    // written only by fi's emission task (cc_emit_begin/cc_emit_end, one
    // task per function); read only by report at cc_end, after every phase
    unsafe {
        OUT_EMIT = v;
    }
}

// (0.28.0) OUT_SCALAR's accessors: every use of it is one of them.
fn get_out_scalar() -> *mut i64 {
    // UNSAFE: the code cache's per-function scalar outcome, a process-wide
    // static mut; Rust has no safe access to a static mut
    // SAFETY: allocated by cc_begin on the main thread; OUT_SCALAR[fi]
    // written only by fi's cleanup/simplify task (cc_scalar_begin,
    // cc_scalar_end); read only by report at cc_end
    unsafe { OUT_SCALAR }
}

fn set_out_scalar(v: *mut i64) {
    // UNSAFE: the code cache's per-function scalar outcome, a process-wide
    // static mut; Rust has no safe access to a static mut
    // SAFETY: allocated by cc_begin on the main thread; OUT_SCALAR[fi]
    // written only by fi's cleanup/simplify task (cc_scalar_begin,
    // cc_scalar_end); read only by report at cc_end
    unsafe {
        OUT_SCALAR = v;
    }
}

// (0.28.0) SCALAR_REC's accessors: every use of it is one of them.
fn get_scalar_rec() -> *mut ScalarRec {
    // UNSAFE: the code cache's per-function scalar recordings, a
    // process-wide static mut; Rust has no safe access to a static mut
    // SAFETY: allocated by cc_begin on the main thread; entry fi reached
    // only through scalar_rec(fi) by fi's own task: cc_scalar_begin and
    // cc_scalar_cleanup_end in its cleanup task, cc_scalar_simplify_begin
    // and scalar_hit in its simplify task a phase later (phases ordered by
    // MUTEX); one task per function per phase
    unsafe { SCALAR_REC }
}

fn set_scalar_rec(v: *mut ScalarRec) {
    // UNSAFE: the code cache's per-function scalar recordings, a
    // process-wide static mut; Rust has no safe access to a static mut
    // SAFETY: allocated by cc_begin on the main thread; entry fi reached
    // only through scalar_rec(fi) by fi's own task: cc_scalar_begin and
    // cc_scalar_cleanup_end in its cleanup task, cc_scalar_simplify_begin
    // and scalar_hit in its simplify task a phase later (phases ordered by
    // MUTEX); one task per function per phase
    unsafe {
        SCALAR_REC = v;
    }
}
