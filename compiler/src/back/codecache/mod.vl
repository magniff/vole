// (0.18.1) Incremental rebuilds: the code cache (T8 of
// docs/design/contracts-verification.md; docs/optimizer.md, "0.18.1:
// incremental rebuilds"). A task of middle::parallel whose inputs are the
// same as in an earlier build takes that build's outputs instead of
// running: -O2's cleanup and scalar pipeline of a function (its IR), -O2's
// components (their functions' optimized IR and facts) and every
// function's emission (its text), at -O1 and -O2.
//
// An entry is found by its key: the compiler, the options and the
// program's types (env), the task's functions by symbol, their IR as the
// task receives it (hash::ir_hash) and what the program knows of them
// (own_fp). It holds what the task read of other functions while it ran
// (a verifying trace): each read is recorded when it is made (cc_note,
// from the accessors: the callee of a call, its readiness, size,
// attributes, call flags, deciders and IR) with the value read, and the
// entry is used only when every one reads the same now. Two reads of the
// program record the answer, not the value: the inlining budget (whether
// the program's size plus a growth is within it) and a callee's calls
// left (whether one). The outputs name strings, symbols, functions and
// constant data by what they are (snapshot::Rel), mapped to this build's
// ids when used.
//
// A task that reads something the trace cannot hold (IR whose hash is not
// known) is poisoned: it runs and nothing is stored. The output with the
// cache is the same as without, byte for byte (tests/incremental.sh).

pub mod hash;
pub mod snapshot;
pub mod pack;

use std::alloc::Allocator;
use std::sync::Mutex;

use crate::host_target;
use crate::back::codecache::hash::{
    H2, StrMarks, fn_of_name, h2_new, h2_put, h2_puti, hash_bytes, ir_hash, ir_nameh, ir_of_name,
    mix, names_begin, str_marks, strings_begin, types_hash,
};
use crate::back::codecache::pack::{
    VERSION, pack_body, pack_body_at, pack_changed, pack_find, pack_load, pack_new, pack_save,
    pack_touch, pack_used,
};
use crate::back::codecache::snapshot::{
    IRCopy, Ids, Reader, Rel, copy_differs, decode_ir, encode_ir, get_bytes, get_count, get_s,
    get_u, ids_at, ids_new, ids_saddr, no_map, put_bytes, put_s, put_u, reader, rel_add_source,
    rel_clear, rel_fn, rel_new, rel_rtid, rel_saddr, rel_str_source,
};
use crate::base::{alloc_array, alloc_zeroed, find_sym, memcpy, streq, stress_grow, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::cli::line::Line;
use crate::front::stdalloc::get_check_alloc_mode;
use crate::middle::copies::move_copies;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{ir_enter, ir_release, ir_stored};
use crate::middle::lower::ssa::HMap;
use crate::middle::parallel::{
    K_COMPONENT, OWNER_SHIFT, P_CLEANUP, P_COMPONENT, P_EMIT, P_SIMPLIFY, comp_of, const_data,
    const_data_count, const_data_entry, fn_facts_ready, get_fn_text,
};
use crate::tools::proc::{fork_worker, make_dirs, worker_exit};
use crate::tools::query::cache::{cache_dir, ident};

// UNSAFE: the C library's calls for a new session and for replacing a
// descriptor, which std does not have.
// SAFETY: declared as <unistd.h> and <fcntl.h> do (open without its
// optional mode: it is called without O_CREAT); detach is their only
// caller.
extern "C" {
    fn setsid() -> i32;
    fn open(path: *mut u8, flags: i32) -> i32;
    fn dup2(from: i32, to: i32) -> i32;
}

// ---- Options ----

// The size of the program's code below which the cache is off without
// --cache=on: its live functions' instructions as lowered. A 7-line
// program with std has 1405 (a build at -O1 6 ms, the cache's start 4 ms
// more: the compiler's hash, the pack); examples/calc 3321 (-O1 7.3 ms,
// 8.0 with the cache), examples/closures-iterators 8230 (-O1 10.6 ms,
// 10.5; -O2 36 ms, 13); the compiler 716164.
const MIN_INSTS: i64 = 8000;

// Whether `arg` is one of the cache's options (taken).
pub fn cc_option(arg: *mut u8, pcx: &mut Ctx<Comp>) -> bool {
    if streq(arg, c"--no-cache") || streq(arg, c"--cache=off") {
        pcx.cc_flag = -1;
        return true;
    }
    if streq(arg, c"--cache=on") {
        pcx.cc_flag = 1;
        return true;
    }
    false
}

// The options that change no code (left out of the hash), and those
// known not to need the cache off; any other option turns it off.
fn arg_kind(a: &str) -> i64 {
    // (0: hashed; 1: left out; 2: left out with the next; 3: hashed with
    // the next; 4: hashed with the next two; -1: unknown)
    let b = a.as_bytes();
    if b.len() == 0 || b[0] != b'-' {
        return 0;
    }
    if a == "-o" || a == "-framework" {
        return 2;
    }
    if b.len() > 1 && b[1] == b'j' {
        return if b.len() == 2 { 2 } else { 1 };
    }
    if a == "--no-cache" || a.starts_with("--cache=") || a.starts_with("--diagnostics=")
        || a == "--deny-warnings" || a.starts_with("--linker=") || a.starts_with("--allow=") {
        return 1;
    }
    if a == "-O0" || a == "-O1" || a == "-O2" || a == "-c" || a == "-S" || a == "--emit-asm"
        || a == "--no-ifconv" || a == "--no-vectorize" || a == "--no-unroll-runtime"
        || a == "--no-slp" || a == "--no-noalias" || a == "--no-egraph"
        || a == "--debug-contracts" || a == "--no-positions" || a == "--test-build"
        || a.starts_with("--syntax=") || a.starts_with("--edition=")
        || a.starts_with("--atomics=") {
        return 0;
    }
    // (0.26.3) the overflow checks change the code: hashed
    if a.starts_with("--overflow-checks=") {
        return 0;
    }
    if b.len() > 2 && (b[1] == b'I' || b[1] == b'l' || b[1] == b'L') {
        return 0;
    }
    if a == "--target" || a == "-I" || a == "-l" || a == "-L" || a == "-C" {
        return 3;
    }
    if a == "--overlay" {
        return 4;
    }
    -1
}

// The hash of word w.
fn hash_word(w: &str) -> u64 {
    hash_bytes(w.as_bytes())
}

// The command line's options, hashed (main, before they are read).
pub fn cc_args(line: Line<'_>, pcx: &mut Ctx<Comp>) {
    // (the compiler, whose executable's hash keys the cache:
    // tools::query::cache::ident)
    if pcx.prog == 0 as *mut u8 {
        pcx.prog = line.c(0);
    }
    let mut h: u64 = 0x61726773;
    let mut i: i64 = 1;
    let n = line.len();
    while i < n {
        let a = line.word(i);
        let kind = arg_kind(a);
        if kind < 0 {
            pcx.args_unknown = true;
        }
        if kind != 1 && kind != 2 {
            h = mix(h, hash_word(a));
        }
        let take: i64 = if kind == 2 || kind == 3 { 1 } else if kind == 4 { 2 } else { 0 };
        for k in 1..take + 1 {
            if i + k < n && kind != 2 {
                h = mix(h, hash_word(line.word(i + k)));
            }
        }
        i += 1 + take;
    }
    // (the environment the code generator reads)
    let names = ["VOLE_STRESS_GROW", "VOLE_PLANT_MISCOMPILE", "VOLE_FRESH_CONTEXTS", "VOLE_ROOT",
        "VOLE_QUERY_STD", "VOLE_OVF_CENSUS"];
    for name in names {
        h = mix(h, match std::env::var_in(name, Comp {}) {
            Ok(v) => hash_bytes(v.as_bytes()),
            Err(_) => 1,
        });
    }
    pcx.args_h = h;
}

// Whether the environment has variable `name` (set to anything).
fn env_set(name: &str) -> bool {
    std::env::var_in(name, Comp {}).is_ok()
}

// Whether this compilation may use the cache: -O1 or -O2, none of the
// modes that print as they go, keep the program's state in statics or
// change the IR outside the tasks' view, and a directory for it.
fn cc_wanted(pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        // ($VOLE_CODE_CACHE=off: the code cache off, the tools' cache as
        // it is; tests/run.sh's default)
        let off = match std::env::var_in("VOLE_CODE_CACHE", Comp {}) {
            Ok(v) => v.as_str() == "off",
            Err(_) => false,
        };
        pcx.cc_flag >= 0 && !off && !pcx.args_unknown && pcx.opt_level >= 1 && !pcx.debug_info
            && !pcx.time_passes && pcx.stats == 0 && !pcx.verify_ir && !pcx.print_after_all
            && !pcx.print_regalloc && !pcx.verify_regalloc && pcx.print_checks == 0 as *mut u8
            && !pcx.emit_ir && !pcx.emit_mir && !pcx.print_attrs && !pcx.trace
            && pcx.profile_use == 0 as *mut u8 && pcx.profile_generate == 0 as *mut u8
            && !get_check_alloc_mode() && !pcx.check_unsafe && !pcx.coverage && !pcx.verify_effects
            && cache_dir(pcx) != 0 as *mut u8 && ident(pcx) != 0
    }
}

// ---- A thread's state ----

// What a task records (one per context, made when first needed).
pub struct CcCtx<A: Allocator> {
    // Recording: the task's reads, triples (kind, a, b).
    rec: bool,
    reads: Vec<i64, A>,
    poison: bool,
    // Per IR function: the stamp of the task that noted it, and the kinds
    // noted then (bits).
    seen: Vec<i64, A>,
    seen_bits: Vec<i64, A>,
    stamp: i64,
    // The task: its component (-1: one function, fi), the SCC of its
    // functions (-1: none).
    comp: i64,
    fi: i64,
    own_scc: i64,
    // Its functions (IR).
    members: Vec<i64, A>,
    // Its functions' strings as the task received them, one list after the
    // other (own_start: where each begins), and their constant data then.
    own_strs: Vec<i64, A>,
    own_start: Vec<i64, A>,
    consts_before: Vec<i64, A>,
    // The key.
    key: H2,
    // The text's string and constant ids (emission), by index; their map.
    text: bool,
    relocs: Vec<i64, A>,
    reloc_map: HMap,
    // Scratch for hash::ir_hash's strings.
    marks: StrMarks<A>,
    // Scratch for an entry: its tables, its outputs and its whole body;
    // the functions whose IR the task read, in the order of its reads
    // (reads_hold, read_irs); a function's strings; a map of string ids.
    rel: Rel<A>,
    out: Vec<u8, A>,
    body: Vec<u8, A>,
    irs: Vec<i64, A>,
    list: Vec<i64, A>,
    ids: HMap,
}

fn cc_new() -> CcCtx<Comp> {
    CcCtx {
        rec: false,
        reads: Vec::new_in(Comp {}),
        poison: false,
        seen: Vec::new_in(Comp {}),
        seen_bits: Vec::new_in(Comp {}),
        stamp: 0,
        comp: -1,
        fi: -1,
        own_scc: -1,
        members: Vec::new_in(Comp {}),
        own_strs: Vec::new_in(Comp {}),
        own_start: Vec::new_in(Comp {}),
        consts_before: Vec::new_in(Comp {}),
        key: H2 { a: 0, b: 0 },
        text: false,
        relocs: Vec::new_in(Comp {}),
        reloc_map: no_map(),
        marks: str_marks(),
        rel: rel_new(),
        out: Vec::new_in(Comp {}),
        body: Vec::new_in(Comp {}),
        irs: Vec::new_in(Comp {}),
        list: Vec::new_in(Comp {}),
        ids: no_map(),
    }
}

// cx's cache state, taken out of it (made the first time): a function of
// the cache works on it beside the context and puts it back (cc_put).
// While it is out the context has none, and what a pass would note
// (cc_note, cc_text_string) is not: the cache's own reads of the IR are
// not the task's.
fn cc_take(cx: &mut FnCtx<Comp>) -> Box<CcCtx<Comp>, Comp> {
    match cx.cc.take() {
        Some(cc) => cc,
        None => Box::new_in(cc_new(), Comp {}),
    }
}

fn cc_put(cx: &mut FnCtx<Comp>, cc: Box<CcCtx<Comp>, Comp>) {
    cx.cc = Some(cc);
}

// ---- The program's state for the cache ----

// Per IR function, in Ctx, shared by the tasks by element (atomics, and
// lists and recordings each behind its lock): cc_irh_a and cc_irh_b, the
// hash of its IR as last made (by its task, or read back); cc_irh_ok,
// whether that is its IR now; cc_strs, its strings then; cc_out_comp,
// cc_out_emit and cc_out_scalar, what its component's task (at its first
// function), its emission and its scalar phases did (OUT_*), for the
// counts; cc_scalar, its scalar phases' recording (ScalarRec).
const OUT_HIT: i64 = 1;
const OUT_NONE: i64 = 2;
const OUT_READ: i64 = 3;
const OUT_BAD: i64 = 4;
const OUT_POISON: i64 = 5;

// The kinds of entries (and of the slots of pack's new entries).
const E_COMPONENT: i64 = 1;
const E_EMIT: i64 = 2;
const SLOTS_PER_FN: i64 = 3;

// The hash of IR function g's IR as last made.
fn irh(g: i64, pcx: &Ctx<Comp>) -> H2 {
    H2 { a: pcx.cc_irh_a.get(g) as u64, b: pcx.cc_irh_b.get(g) as u64 }
}

fn set_irh(g: i64, h: H2, pcx: &Ctx<Comp>) {
    pcx.cc_irh_a.set(g, h.a as i64);
    pcx.cc_irh_b.set(g, h.b as i64);
}

fn irh_ok(g: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.cc_irh_ok.get(g) != 0
}

fn set_irh_ok(g: i64, ok: bool, pcx: &Ctx<Comp>) {
    pcx.cc_irh_ok.set(g, if ok { 1 } else { 0 });
}

// IR function g's strings become `list`.
fn set_strs(g: i64, list: &[i64], pcx: &Ctx<Comp>) {
    pcx.cc_strs.clear(g);
    for &id in list.iter() {
        pcx.cc_strs.push(g, id);
    }
}

// IR function g's strings, appended to `list`.
fn add_strs(g: i64, list: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    for k in 0..pcx.cc_strs.count(g) {
        list.push(pcx.cc_strs.at(g, k));
    }
}

// The compilation's cache: off, or on with the pack read (main thread,
// at the start of the optimizer, the program lowered).
pub fn cc_begin(pcx: &mut Ctx<Comp>) {
    pcx.cc_on = false;
    // A program whose code is small compiles in less than the cache takes
    // to start (the compiler's hash, the pack): without it, unless
    // --cache=on.
    pcx.program_insts = 0;
    for fi in 0..pcx.irfunc_count {
        if pcx.fn_live[fi as usize] != 0 {
            let insts = ir_stored(fi, pcx).t.insts.len() as i64;
            pcx.program_insts += insts;
        }
    }
    if (pcx.program_insts < MIN_INSTS && pcx.cc_flag <= 0) || !cc_wanted(pcx)
        || pcx.irfunc_count == 0 {
        return;
    }
    let dir = cache_dir(pcx);
    if !make_dirs(dir) {
        return;
    }
    let moves = pcx.move_copies;
    names_begin(moves, pcx);
    let n = pcx.irfunc_count + 1;
    pcx.cc_irh_a.reset(n, 0);
    pcx.cc_irh_b.reset(n, 0);
    pcx.cc_irh_ok.reset(n, 0);
    pcx.cc_strs.reset(n);
    pcx.cc_out_comp.reset(n, 0);
    pcx.cc_out_emit.reset(n, 0);
    pcx.cc_out_scalar.reset(n, 0);
    pcx.cc_scalar.clear();
    for _ in 0..n {
        pcx.cc_scalar.push(Mutex::new(scalar_rec()));
    }
    pcx.check = env_set("VOLE_CACHE_CHECK");
    pcx.why = env_set("VOLE_CACHE_WHY");
    let options = options_hash(pcx);
    let path = match str::from_utf8(&crate::base::cstr(dir)) {
        Ok(d) => pack_path(d, options, pcx),
        Err(_) => return,
    };
    pack_load(path, ident(pcx), options as i64, SLOTS_PER_FN * n, pcx);
    pcx.cc_on = true;
}

// The options and the compiler, hashed.
fn options_hash(pcx: &mut Ctx<Comp>) -> u64 {
    let mut h: u64 = mix(pcx.args_h, ident(pcx) as u64);
    h = mix(h, VERSION as u64);
    h = mix(h, pcx.opt_level as u64);
    h = mix(h, (if pcx.per_function { 1 } else { 0 }) | (if get_x86() { 2 } else { 0 })
        | (if get_elf() { 4 } else { 0 }) | (if pcx.apple_a64 { 8 } else { 0 })
        | (if pcx.ifconv { 16 } else { 0 }) | (if pcx.vectorize { 32 } else { 0 })
        | (if pcx.unroll_runtime { 64 } else { 0 }) | (if pcx.slp { 128 } else { 0 })
        | (if pcx.noalias_off { 256 } else { 0 }) | (if pcx.egraph { 512 } else { 0 })
        | (if pcx.x86_alloc_acd { 1024 } else { 0 }) | (if pcx.any_distinct { 2048 } else { 0 })
        | (if stress_grow() { 4096 } else { 0 }));
    h = mix(h, pcx.profile_max as u64);
    h = mix(h, pcx.output_mode as u64);
    h = mix(h, host_target() as u64);
    // (0.19: the build's target features, which has() and detect() fold)
    if pcx.arch_used {
        h = mix(h, crate::arch::features::build_features(pcx) as u64);
    }
    h
}

// target/volec-cache/g-KEY.pack: KEY the root as given, the current
// directory and the options.
fn pack_path(dir: &str, options: u64, pcx: &Ctx<Comp>) -> String<Comp> {
    let mut h: u64 = mix(options, hash_bytes(&crate::base::cstr(pcx.files[0].path)));
    if let Ok(cwd) = std::env::current_dir_in(Comp {}) {
        h = mix(h, hash_bytes(cwd.as_bytes()));
    }
    format_in("{dir}/g-{h:016x}.pack", Comp {})
}

// Before a phase's tasks (main thread): the program's hash as they see it,
// the strings hashed.
pub fn cc_phase(kind: i64, pcx: &mut Ctx<Comp>) {
    if !pcx.cc_on {
        return;
    }
    // (-O2's components hash their IR as interprocedural constants left
    // it: the scalar phases' hashes are not it)
    if kind == K_COMPONENT {
        for fi in 0..pcx.irfunc_count {
            set_irh_ok(fi, false, pcx);
        }
    }
    strings_begin(pcx);
    let mut h = h2_new(0x656e76);
    h2_put(&mut h, pcx.args_h);
    h2_put(&mut h, types_hash(pcx));
    h2_puti(&mut h, if pcx.attrs_ready { 1 } else { 0 });
    h2_puti(&mut h, pcx.ty_string);
    h2_puti(&mut h, pcx.ty_u8_ptr);
    pcx.codecache_env = h;
    // (-O1: the small leaves' IR, which the emission tasks inline, hashed
    // first)
    if pcx.per_function && pcx.leaf_small != 0 as *mut i64 {
        let main = crate::middle::ctx::main_cx(pcx);
        // UNSAFE: the main thread's context is handed out as a raw pointer
        // (middle::ctx::main_cx).
        // SAFETY: it is made once (fnctx_new) and never freed; this is the
        // main thread between two phases, when no task runs and nothing
        // else holds a reference to that context.
        let cx = unsafe { &mut *main };
        hash_leaves(cx, pcx);
    }
}

// -O1's small leaves' IR, hashed (cc_phase).
fn hash_leaves(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    let mut cc = cc_take(cx);
    for g in 0..pcx.irfunc_count {
        // UNSAFE: leaf_small is a raw table of the context.
        // SAFETY: it is not null (cc_phase), and -O1's leaf marks have an
        // entry for every IR function, of which g is one.
        let small = unsafe { *pcx.leaf_small.add(g as usize) };
        if small != 0 && pcx.fn_live[g as usize] != 0 {
            hash_now(cx, &mut *cc, g, pcx);
        }
    }
    ir_release(cx, pcx);
    cc_put(cx, cc);
}

// The end of the compilation (its output written): the pack written when
// anything changed, by a copy of the process (this one ends), or here
// with $VOLE_CACHE_SYNC or $VOLE_CACHE_TRACE.
pub fn cc_end(pcx: &Ctx<Comp>) {
    if !pcx.cc_on {
        return;
    }
    report(pcx);
    if !pack_changed(pcx) {
        pack_touch(pcx);
        return;
    }
    if !env_set("VOLE_CACHE_SYNC") && !env_set("VOLE_CACHE_TRACE") {
        let pid = fork_worker();
        if pid > 0 {
            return;
        }
        if pid == 0 {
            detach();
            pack_save(pcx);
            worker_exit(0);
        }
    }
    pack_save(pcx);
}

// The process that writes the pack (fork_worker's child) leaves the
// build's session, and its output goes nowhere: what started the build
// does not wait for it.
fn detach() {
    // UNSAFE: setsid, open and dup2 are the C library's; std has no call
    // for a new session or for replacing a descriptor.
    // SAFETY: they take integers and a NUL-ended literal and touch no
    // memory of ours; `null` is used only when open gave a descriptor; the
    // process is the child of a fork, so descriptors 1 and 2 are its own
    // copies and no other thread of it uses them.
    unsafe {
        setsid();
        let null = open(c"/dev/null", 1);
        if null >= 0 {
            dup2(null, 1);
            dup2(null, 2);
        }
    }
}

// The counts ($VOLE_CACHE_STATS: on stderr; $VOLE_CACHE_TRACE: a
// line `code H M` in that file), and with $VOLE_CACHE_WHY each miss.
fn report(pcx: &Ctx<Comp>) {
    let mut counts: [i64; 18] = [0i64; 18];
    for fi in 0..pcx.irfunc_count {
        let a = pcx.cc_out_scalar.get(fi);
        if a > 0 && a < 6 {
            counts[a as usize] += 1;
        }
        let c = pcx.cc_out_comp.get(fi);
        if c > 0 && c < 6 {
            counts[(6 + c) as usize] += 1;
        }
        let e = pcx.cc_out_emit.get(fi);
        if e > 0 && e < 6 {
            counts[(12 + e) as usize] += 1;
        }
    }
    let hits = counts[OUT_HIT as usize] + counts[(6 + OUT_HIT) as usize] + counts[
        (12 + OUT_HIT) as usize];
    let mut misses: i64 = 0;
    for o in 2..6 {
        misses += counts[o as usize] + counts[(6 + o) as usize] + counts[(12 + o) as usize];
    }
    if env_set("VOLE_CACHE_STATS") {
        let kinds = ["scalar", "components", "emission"];
        let mut text = format_in("code cache ({} instructions):", pcx.program_insts, Comp {});
        for k in 0..3 {
            let o = 6 * k;
            let _ = write(&mut text,
                " {} {} hit, {} new, {} read changed, {} unreadable, {} not cacheable;",
                kinds[k], counts[o + 1], counts[o + 2], counts[o + 3], counts[o + 4],
                counts[o + 5]);
        }
        eprintln("{text}");
    }
    if pcx.why {
        for fi in 0..pcx.irfunc_count {
            why(fi, "scalar", pcx.cc_out_scalar.get(fi), pcx);
            why(fi, "component", pcx.cc_out_comp.get(fi), pcx);
            why(fi, "emission", pcx.cc_out_emit.get(fi), pcx);
        }
    }
    if let Ok(path) = std::env::var_in("VOLE_CACHE_TRACE", Comp {}) {
        if let Ok(mut f) = std::fs::OpenOptions::new().append(true).create(true)
            .open(path.as_str()) {
            let line = format_in("code {hits} {misses}\n", Comp {});
            let _ = f.write_all(line.as_bytes());
        }
    }
}

fn why(fi: i64, what: &str, o: i64, pcx: &Ctx<Comp>) {
    if o <= OUT_HIT {
        return;
    }
    let reason = if o == OUT_NONE { "new" } else if o == OUT_READ { "read changed" }
        else if o == OUT_BAD { "unreadable" } else { "not cacheable" };
    let name = crate::base::sym_name(pcx.fns[pcx.ir_fn[fi as usize] as usize].name, pcx);
    eprintln("code cache: {what} {}: {reason}",
        str::from_utf8(&crate::base::cstr(name)).unwrap());
}

// ---- Recording what a task reads ----

pub const R_STATIC: i64 = 1;
pub const R_SIZE: i64 = 2;
pub const R_ATTRS: i64 = 3;
pub const R_RT: i64 = 4;
pub const R_DEC: i64 = 5;
pub const R_IR: i64 = 6;
const R_CALLS: i64 = 7;
const R_BUDGET: i64 = 8;

// Whether IR function g is one of the task's own (what it reads of them
// is its own doing).
fn is_own(cc: &CcCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> bool {
    if cc.comp >= 0 {
        return comp_of(g, pcx) == cc.comp;
    }
    g == cc.fi
}

// The task running in cx read fact `kind` (R_STATIC .. R_IR) of IR
// function g.
pub fn cc_note(cx: &mut FnCtx<Comp>, kind: i64, g: i64, pcx: &Ctx<Comp>) {
    let bit = 1 << kind;
    {
        let cc = match &mut cx.cc {
            Some(cc) => &mut **cc,
            None => return,
        };
        if !cc.rec || g < 0 || is_own(cc, g, pcx) {
            return;
        }
        if cc.seen[g as usize] != cc.stamp {
            cc.seen[g as usize] = cc.stamp;
            cc.seen_bits[g as usize] = 0;
        }
        if (cc.seen_bits[g as usize] & bit) != 0 {
            return;
        }
        cc.seen_bits[g as usize] = cc.seen_bits[g as usize] | bit;
    }
    // (the first note of this fact by the task: the fact is read beside
    // the context)
    let mut cc = cc_take(cx);
    note(cx, &mut *cc, kind, g, pcx);
    cc_put(cx, cc);
}

fn note(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, kind: i64, g: i64, pcx: &Ctx<Comp>) {
    // (a fact of a function not ready is not read: its task may be
    // writing it; its IR, if read, cannot be recorded)
    if kind != R_STATIC && !ready_or_done(cx, g, pcx) {
        cc.seen_bits[g as usize] = cc.seen_bits[g as usize] & !(1 << kind);
        if kind == R_IR {
            cc.poison = true;
        }
        return;
    }
    if kind == R_IR && !irh_ok(g, pcx) {
        cc.poison = true;
        return;
    }
    cc.reads.push(kind);
    cc.reads.push(ir_nameh(g, pcx));
    cc.reads.push(fact(cx, cc.own_scc, kind, g, pcx));
}

// The task read whether callee g has one call left, own_dec of them
// inlined by the task already: `one`.
pub fn cc_note_calls(cx: &mut FnCtx<Comp>, g: i64, own_dec: i64, one: bool, pcx: &Ctx<Comp>) {
    let cc = match &mut cx.cc {
        Some(cc) => &mut **cc,
        None => return,
    };
    if !cc.rec || g < 0 || is_own(cc, g, pcx) {
        return;
    }
    cc.reads.push(R_CALLS);
    cc.reads.push(ir_nameh(g, pcx));
    cc.reads.push((own_dec << 1) | (if one { 1 } else { 0 }));
}

// The task read whether the program's size, grown by `growth`, is within
// the inlining budget: `within`.
pub fn cc_note_budget(cx: &mut FnCtx<Comp>, growth: i64, within: bool) {
    let cc = match &mut cx.cc {
        Some(cc) => &mut **cc,
        None => return,
    };
    if !cc.rec {
        return;
    }
    cc.reads.push(R_BUDGET);
    cc.reads.push(growth);
    cc.reads.push(if within { 1 } else { 0 });
}

// Whether IR function g's facts may be read by the task (its readiness,
// as middle::parallel::fn_facts_ready answers it).
fn ready(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> bool {
    if cx.cur_comp >= 0 {
        return fn_facts_ready(cx, g, true, pcx);
    }
    pcx.fn_attrs_done.len() > 0 && pcx.fn_attrs_done.get(g) != 0
}

// The value of fact `kind` of IR function g now, for a task whose
// functions' SCC is own_scc.
fn fact(cx: &mut FnCtx<Comp>, own_scc: i64, kind: i64, g: i64, pcx: &Ctx<Comp>) -> i64 {
    if kind == R_STATIC {
        return static_fp(cx, own_scc, g, pcx) as i64;
    }
    if kind == R_SIZE {
        return pcx.fn_size.get(g);
    }
    if kind == R_ATTRS {
        // (0.27.1: the borrow checker's verdict decides the parameter
        // alias facts of a rust body, gvn noalias_active)
        let f = pcx.ir_fn[g as usize];
        let verdict: i64 = if f >= 0 && f < pcx.borrowck_verdict.len() as i64 {
            pcx.borrowck_verdict[f as usize]
        } else {
            0
        };
        return mix(mix(mix(pcx.fn_attrs.get(g) as u64, pcx.fn_nocapture.get(g) as u64),
            pcx.fn_attrs_done.get(g) as u64), verdict as u64) as i64;
    }
    if kind == R_RT {
        return pcx.fn_rt.get(g);
    }
    if kind == R_DEC {
        return deciders_hash(g, pcx) as i64;
    }
    irh(g, pcx).a as i64
}

fn deciders_hash(g: i64, pcx: &Ctx<Comp>) -> u64 {
    let mut h: u64 = mix(0x646563, pcx.fn_deciders_start.get(g) as u64);
    for i in 0..pcx.fn_deciders.count(g) {
        h = mix(h, pcx.fn_deciders.at(g, i) as u64);
    }
    h
}

// What a task reads of another function that its own task does not
// change: its declaration, whether it is live, its address taken, -O1's
// leaf marks, whether it is in the task's SCC, and whether it is ready.
fn static_fp(cx: &mut FnCtx<Comp>, own_scc: i64, g: i64, pcx: &Ctx<Comp>) -> u64 {
    let mut h = facts_fixed(g, pcx);
    if pcx.fn_scc.len() > 0 && own_scc >= 0 {
        h = mix(h, if pcx.fn_scc[g as usize] == own_scc { 1 } else { 2 });
    }
    mix(h, if ready(cx, g, pcx) { 3 } else { 4 })
}

fn facts_fixed(g: i64, pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        let mut h: u64 = mix(
            (pcx.fn_canon[pcx.ir_fn[g as usize] as usize]) as u64,
            (pcx.fn_live[g as usize]) as u64);
        if pcx.fn_address.len() > 0 {
            h = mix(h, (pcx.fn_address[g as usize]) as u64);
        }
        if pcx.leaf_small != 0 as *mut i64 {
            h = mix(h,
                ((*pcx.leaf_small.add(g as usize)) | ((*pcx.leaf_keep.add(g as usize)) << 1)
                    | ((*pcx.leaf_done.add(g as usize)) << 2)) as u64);
        }
        h
    }
}

// What the program knows of the task's own function fi as it begins:
// facts_fixed and, at -O2, its size, call flags, deciders, attributes
// and whether its loop passes wait.
fn own_fp(fi: i64, pcx: &Ctx<Comp>) -> u64 {
    let mut h = facts_fixed(fi, pcx);
    if pcx.fn_size.len() > 0 {
        h = mix(h, pcx.fn_size.get(fi) as u64);
        h = mix(h, pcx.fn_rt.get(fi) as u64);
        h = mix(h, deciders_hash(fi, pcx));
    }
    if pcx.fn_attrs.len() > 0 {
        h = mix(h, pcx.fn_attrs.get(fi) as u64);
        h = mix(h, pcx.fn_nocapture.get(fi) as u64);
        h = mix(h, pcx.fn_attrs_done.get(fi) as u64);
    }
    if pcx.opt_deferred.len() > 0 {
        h = mix(h, pcx.opt_deferred.get(fi) as u64);
    }
    h
}

// Starts a task's recording (its own: component comp, or function fi):
// cx's cache state, taken out of it; the caller puts it back (cc_put).
fn task_begin(cx: &mut FnCtx<Comp>, comp: i64, fi: i64, pcx: &Ctx<Comp>) -> Box<CcCtx<Comp>, Comp> {
    let mut cc = cc_take(cx);
    let n = (pcx.irfunc_count + 1) as usize;
    if cc.seen.len() < n {
        cc.seen.resize(n, 0);
        cc.seen_bits.resize(n, 0);
    }
    cc.stamp += 1;
    cc.reads.clear();
    cc.poison = false;
    cc.rec = false;
    cc.comp = comp;
    cc.fi = fi;
    cc.members.clear();
    cc.own_strs.clear();
    cc.own_start.clear();
    cc.consts_before.clear();
    cc.text = false;
    cc.relocs.clear();
    cc.reloc_map.clear();
    cc
}

// The key of a task: its kind, the phase's hash, and per function its
// symbol, what is known of it and its IR's hash.
fn key_put_fn(k: &mut H2, fi: i64, irh: H2, pcx: &Ctx<Comp>) {
    h2_puti(k, pcx.fn_nameh[pcx.ir_fn[fi as usize] as usize]);
    h2_put(k, own_fp(fi, pcx));
    h2_put(k, irh.a);
    h2_put(k, irh.b);
}

// Hashes function fi's IR as the task receives it into the key, its
// strings appended to the task's; false when it cannot be.
fn hash_input(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, fi: i64, key: &mut H2, pcx: &Ctx<Comp>) -> bool {
    cc.members.push(fi);
    cc.own_start.push(cc.own_strs.len() as i64);
    cc.consts_before.push(const_data_count(fi));
    let mut h = H2 { a: 0, b: 0 };
    ir_enter(cx, fi, pcx);
    let ok = ir_hash(cx, fi, 0, &mut cc.marks, &mut cc.own_strs, &mut h, pcx);
    key_put_fn(key, fi, h, pcx);
    ok
}

// IR function fi's name, for a message.
fn fn_name(fi: i64, pcx: &Ctx<Comp>) -> &'static str {
    str::from_utf8(sym_text(pcx.fns[pcx.ir_fn[fi as usize] as usize].name, pcx)).unwrap_or("?")
}

// ---- Checking an entry's reads ----

// Whether every read entry r records reads the same now (r is left after
// them, and the alias hash); cc.irs: the functions whose IR was read.
fn reads_hold(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, r: &mut Reader<'_>, pcx: &Ctx<Comp>) -> bool {
    let n = get_count(r);
    cc.irs.clear();
    for i in 0..n {
        let kind = get_u(r) as i64;
        let a = get_s(r);
        let b = get_s(r);
        if r.bad {
            return false;
        }
        if kind == R_BUDGET {
            let within = pcx.program_size + a <= pcx.program_budget;
            if within != (b != 0) {
                if pcx.why {
                    eprintln("code cache: read budget {a} changed");
                }
                return false;
            }
            continue;
        }
        let g = ir_of_name(a, pcx);
        if g < 0 || is_own(cc, g, pcx) {
            return false;
        }
        if kind == R_CALLS {
            let one = pcx.fn_calls[g as usize] - (b >> 1) == 1;
            if one != ((b & 1) != 0) {
                if pcx.why {
                    eprintln("code cache: read calls of {} changed", fn_name(g, pcx));
                }
                return false;
            }
            continue;
        }
        if kind < R_STATIC || kind > R_IR {
            return false;
        }
        // (a function's other facts only once it is ready: its own task
        // may be writing them)
        if kind != R_STATIC && !ready_or_done(cx, g, pcx) {
            return false;
        }
        if kind == R_IR && !irh_ok(g, pcx) {
            return false;
        }
        if fact(cx, cc.own_scc, kind, g, pcx) != b {
            if pcx.why {
                eprintln("code cache: read {kind} of {} changed", fn_name(g, pcx));
            }
            return false;
        }
        if kind == R_IR {
            cc.irs.push(g);
        }
    }
    let alias = get_u(r);
    !r.bad && alias == alias_hash(cc, pcx)
}

// Whether g's facts are final for the task: ready in -O2's bottom-up
// phase, else always (the phases after it read only what is done).
fn ready_or_done(cx: &mut FnCtx<Comp>, g: i64, pcx: &Ctx<Comp>) -> bool {
    if cx.cur_comp >= 0 {
        return fn_facts_ready(cx, g, true, pcx);
    }
    true
}

// Which strings of the task's lists (its own, then those of the
// functions whose IR it read, cc.irs) are the same id: for each, how far
// back the first of its id is, hashed.
fn alias_hash(cc: &mut CcCtx<Comp>, pcx: &Ctx<Comp>) -> u64 {
    cc.ids.clear();
    let mut h: u64 = 0x616c6961;
    let mut pos: i64 = 0;
    for i in 0..cc.own_strs.len() {
        h = alias_put(&mut cc.ids, h, cc.own_strs[i], pos);
        pos += 1;
    }
    for k in 0..cc.irs.len() {
        let g = cc.irs[k];
        for i in 0..pcx.cc_strs.count(g) {
            h = alias_put(&mut cc.ids, h, pcx.cc_strs.at(g, i), pos);
            pos += 1;
        }
    }
    h
}

fn alias_put(map: &mut HMap, h: u64, id: i64, pos: i64) -> u64 {
    let key = (id << 1) | 1;
    let first = map.get(key);
    if first == 0 {
        map.put(key, pos + 1);
        return mix(h, 0);
    }
    mix(h, (pos + 1 - first) as u64)
}

// The recorded reads into an entry's body: the reads, then the alias hash
// over the strings of the functions whose IR was read (in their order).
fn put_reads(cc: &CcCtx<Comp>, alias: u64, b: &mut Vec<u8, Comp>) {
    let n = cc.reads.len() / 3;
    put_u(b, n as u64);
    for i in 0..n {
        put_u(b, cc.reads[3 * i] as u64);
        put_s(b, cc.reads[3 * i + 1]);
        put_s(b, cc.reads[3 * i + 2]);
    }
    put_u(b, alias);
}

// ---- The entry's tables ----

// The strings an entry's outputs may name: the task's own lists, then
// those of the functions whose IR it read (src: their place).
fn rel_sources(cc: &mut CcCtx<Comp>, pcx: &Ctx<Comp>) {
    rel_clear(&mut cc.rel);
    let m = cc.own_start.len();
    for i in 0..m {
        let from = cc.own_start[i] as usize;
        let to = if i + 1 < m { cc.own_start[i + 1] as usize } else { cc.own_strs.len() };
        rel_add_source(&mut cc.rel, i as i64, &cc.own_strs[from..to]);
    }
    for j in 0..cc.irs.len() {
        cc.list.clear();
        add_strs(cc.irs[j], &mut cc.list, pcx);
        rel_add_source(&mut cc.rel, (m + j) as i64, &cc.list);
    }
}

// cc.irs: the IR functions whose IR the task read, in the order of its
// reads.
fn read_irs(cc: &mut CcCtx<Comp>, pcx: &Ctx<Comp>) {
    cc.irs.clear();
    let n = cc.reads.len() / 3;
    for i in 0..n {
        if cc.reads[3 * i] == R_IR {
            cc.irs.push(ir_of_name(cc.reads[3 * i + 1], pcx));
        }
    }
}

// Writes the tables of cc.rel into b: strings by source, constant data by
// owner (a function of the task: 1 + its place among them, with k past
// what it had when the task began; else 0 and the owner's symbol),
// symbols by text, functions by symbol.
fn put_tables(cc: &CcCtx<Comp>, b: &mut Vec<u8, Comp>, pcx: &Ctx<Comp>) {
    let rel = &cc.rel;
    put_u(b, rel.strs.len() as u64);
    for i in 0..rel.strs.len() as i64 {
        let s = rel_str_source(rel, i);
        put_u(b, (s >> 32) as u64);
        put_u(b, (s & 0xffffffff) as u64);
    }
    put_u(b, rel.consts.len() as u64);
    for i in 0..rel.consts.len() {
        let m = -rel.consts[i] - 1;
        let owner = m >> OWNER_SHIFT;
        let k = m & ((1 << OWNER_SHIFT) - 1);
        let mut member: i64 = -1;
        for j in 0..cc.own_start.len() {
            if cc.members[j] == owner && k >= cc.consts_before[j] {
                member = j as i64;
            }
        }
        if member >= 0 {
            put_u(b, (member + 1) as u64);
            put_u(b, (k - cc.consts_before[member as usize]) as u64);
        } else {
            put_u(b, 0);
            put_s(b, ir_nameh(owner, pcx));
            put_u(b, k as u64);
        }
    }
    put_u(b, rel.syms.len() as u64);
    for i in 0..rel.syms.len() {
        put_bytes(b, sym_text(rel.syms[i], pcx));
    }
    // (a function whose symbol another has, a C function declared in
    // several modules: by its index too, which the IR's hashes hold)
    put_u(b, rel.fns.len() as u64);
    for i in 0..rel.fns.len() {
        let f = rel.fns[i];
        put_s(b, pcx.fn_nameh[f as usize]);
        put_s(b, if pcx.fn_ambig[f as usize] { f } else { -1 });
    }
    // (RTID values: a function of the task by its place, another by its
    // symbol; the place among its values)
    put_u(b, rel.rtids.len() as u64);
    for i in 0..rel.rtids.len() {
        let v = rel.rtids[i];
        let owner = v >> 20;
        let mut member: i64 = -1;
        for j in 0..cc.members.len() {
            if cc.members[j] == owner {
                member = j as i64;
            }
        }
        put_s(b, member);
        if member < 0 {
            put_s(b, ir_nameh(owner, pcx));
        }
        put_u(b, (v & 1048575) as u64);
    }
}

// Reads an entry's tables, mapped to this build's ids (the task's
// functions, cc.members; cc.irs: the functions whose IR it read): false
// when one names what is not here.
fn get_tables(cc: &CcCtx<Comp>, r: &mut Reader<'_>, ids: &mut Ids<Comp>, pcx: &Ctx<Comp>) -> bool {
    let m = cc.own_start.len() as i64;
    let ns = get_count(r);
    for i in 0..ns {
        let src = get_u(r) as i64;
        let k = get_u(r) as i64;
        let mut count: i64 = 0;
        let mut id: i64 = 0;
        if src >= 0 && src < m {
            let from = cc.own_start[src as usize];
            let to = if src + 1 < m { cc.own_start[(src + 1) as usize] }
                else { cc.own_strs.len() as i64 };
            count = to - from;
            if k >= 0 && k < count {
                id = cc.own_strs[(from + k) as usize];
            }
        } else if src >= m && src - m < cc.irs.len() as i64 {
            let g = cc.irs[(src - m) as usize];
            count = pcx.cc_strs.count(g);
            if k >= 0 && k < count {
                id = pcx.cc_strs.at(g, k);
            }
        }
        if k < 0 || k >= count {
            if pcx.check {
                eprintln("code cache check: string {src} {k} not in {count}");
            }
            return false;
        }
        ids.strs.push(id);
    }
    let nc = get_count(r);
    for i in 0..nc {
        let member = get_u(r) as i64;
        let mut owner: i64 = -1;
        let mut k: i64 = 0;
        if member > 0 {
            if member > m {
                return false;
            }
            owner = cc.members[(member - 1) as usize];
            k = cc.consts_before[(member - 1) as usize] + get_u(r) as i64;
        } else {
            // (a placeholder some IR the task read holds: made in an
            // earlier phase)
            owner = ir_of_name(get_s(r), pcx);
            k = get_u(r) as i64;
            if owner < 0 {
                return false;
            }
        }
        if member < 0 || k < 0 || k >= (1 << OWNER_SHIFT) {
            return false;
        }
        ids.consts.push(-(1 + (owner << OWNER_SHIFT) + k));
    }
    let ny = get_count(r);
    for i in 0..ny {
        let name = get_bytes(r);
        if r.bad {
            return false;
        }
        let sym = find_sym(name, pcx);
        if sym < 0 {
            if pcx.check {
                eprintln("code cache check: a symbol not found");
            }
            return false;
        }
        ids.syms.push(sym);
    }
    let nf = get_count(r);
    for i in 0..nf {
        let h = get_s(r);
        let raw = get_s(r);
        let f: i64 = if raw < 0 { fn_of_name(h, pcx) }
            else if raw < pcx.fns.len() as i64 && pcx.fn_nameh[raw as usize] == h { raw }
            else { -1 };
        if f < 0 {
            if pcx.check {
                eprintln("code cache check: a function not found (or several)");
            }
            return false;
        }
        ids.fns.push(f);
    }
    let nt = get_count(r);
    for i in 0..nt {
        let member = get_s(r);
        let owner: i64 = if member >= 0 && member < m { cc.members[member as usize] }
            else if member < 0 { ir_of_name(get_s(r), pcx) } else { -1 };
        let k = get_u(r) as i64;
        if owner < 0 || k < 0 || k > 1048575 {
            return false;
        }
        ids.rtids.push((owner << 20) | k);
    }
    !r.bad
}

// ---- -O2's components ----

// (0.27.8) Entry e, hit by the task of the component of scc_order's
// start..end, is marked used (pack_used), unless one of its functions
// shares its symbol with another (fn_ambig, names_begin): two such tasks
// may have the same key and run in one phase, and their marks would race.
// The mark only keeps the entry from aging out; theirs may age.
fn mark_used(e: i64, start: i64, end: i64, pcx: &Ctx<Comp>) {
    for i in start..end {
        if pcx.fn_ambig[pcx.ir_fn[pcx.scc_order[i as usize] as usize] as usize] {
            return;
        }
    }
    pack_used(e, pcx);
}

// (0.27.8) mark_used of a scalar or an emission task, of function fi.
fn mark_used_fn(e: i64, fi: i64, pcx: &Ctx<Comp>) {
    if pcx.fn_ambig[pcx.ir_fn[fi as usize] as usize] {
        return;
    }
    pack_used(e, pcx);
}

// Component c's task (middle::parallel::run_component, cx.cur_comp set):
// true when its outputs were read from the cache; else its recording
// begins (cc_component_end ends it).
pub fn cc_component_begin(cx: &mut FnCtx<Comp>, c: i64, start: i64, end: i64, pcx: &Ctx<Comp>) -> bool {
    let first = pcx.scc_order[start as usize];
    let mut cc = task_begin(cx, c, first, pcx);
    let hit = component_begin(cx, &mut *cc, c, start, end, pcx);
    cc_put(cx, cc);
    hit
}

fn component_begin(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, c: i64, start: i64, end: i64,
    pcx: &Ctx<Comp>) -> bool {
    let first = pcx.scc_order[start as usize];
    cc.own_scc = pcx.fn_scc[first as usize];
    let mut key = h2_new(E_COMPONENT as u64);
    h2_put(&mut key, pcx.codecache_env.a);
    h2_put(&mut key, pcx.codecache_env.b);
    h2_puti(&mut key, end - start);
    let mut ok = true;
    for i in start..end {
        let fi = pcx.scc_order[i as usize];
        set_irh_ok(fi, false, pcx);
        if !hash_input(cx, cc, fi, &mut key, pcx) {
            ok = false;
        }
    }
    ir_release(cx, pcx);
    cc.key = key;
    if !ok {
        cc.poison = true;
        cc.rec = true;
        pcx.cc_out_comp.set(first, OUT_POISON);
        return false;
    }
    let e = pack_find(key.a, key.b, pcx);
    if e >= 0 {
        let got = component_hit(cx, cc, e, c, start, end, pcx);
        if got == OUT_HIT {
            mark_used(e, start, end, pcx);
            pcx.cc_out_comp.set(first, OUT_HIT);
            return true;
        }
        pcx.cc_out_comp.set(first, got);
    } else {
        pcx.cc_out_comp.set(first, OUT_NONE);
    }
    cc.rec = true;
    false
}

// The members' facts a component's task leaves (in its entry).
fn put_facts(b: &mut Vec<u8, Comp>, fi: i64, pcx: &Ctx<Comp>) {
    put_s(b, pcx.fn_size.get(fi));
    put_s(b, pcx.fn_rt.get(fi));
    put_s(b, pcx.fn_deciders_start.get(fi));
    put_u(b, pcx.fn_deciders.count(fi) as u64);
    for i in 0..pcx.fn_deciders.count(fi) {
        put_s(b, pcx.fn_deciders.at(fi, i));
    }
    put_s(b, pcx.opt_deferred.get(fi));
    put_s(b, pcx.fn_attrs.get(fi));
    put_s(b, pcx.fn_nocapture.get(fi));
    put_s(b, pcx.fn_attrs_done.get(fi));
}

// The constant data function fi's task made (from its count at the start,
// `before`): their phase, rank (less `rank0`), alignment and bytes.
fn put_consts(b: &mut Vec<u8, Comp>, fi: i64, before: i64, rank0: i64) {
    let n = const_data_count(fi);
    put_u(b, (n - before) as u64);
    for k in before..n {
        let mut phase: i64 = 0;
        let mut rank: i64 = 0;
        let mut align: i64 = 0;
        let bytes = const_data_entry(fi, k, &mut phase, &mut rank, &mut align);
        put_u(b, phase as u64);
        put_s(b, rank - rank0);
        put_s(b, align);
        put_bytes(b, bytes);
    }
}

// Component c's task is done (cx): its functions' IR hashed (what their
// callers and emission read), and its entry made unless poisoned.
pub fn cc_component_end(cx: &mut FnCtx<Comp>, c: i64, start: i64, end: i64, pcx: &Ctx<Comp>) {
    let mut cc = cc_take(cx);
    component_end(cx, &mut *cc, c, start, end, pcx);
    cc_put(cx, cc);
}

fn component_end(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, c: i64, start: i64, end: i64,
    pcx: &Ctx<Comp>) {
    let first = pcx.scc_order[start as usize];
    cc.rec = false;
    for i in start..end {
        out_hash(cx, cc, pcx.scc_order[i as usize], pcx);
    }
    ir_release(cx, pcx);
    if cc.poison {
        pcx.cc_out_comp.set(first, OUT_POISON);
        return;
    }
    read_irs(cc, pcx);
    rel_sources(cc, pcx);
    cc.out.clear();
    put_s(&mut cc.out, pcx.comp_growth.get(c));
    put_u(&mut cc.out, pcx.comp_inlined.count(c) as u64);
    for m in 0..pcx.comp_inlined.count(c) {
        let f = rel_fn(&mut cc.rel, pcx.ir_fn[pcx.comp_inlined.at(c, m) as usize]);
        put_u(&mut cc.out, f as u64);
    }
    for i in start..end {
        let fi = pcx.scc_order[i as usize];
        ir_enter(cx, fi, pcx);
        encode_ir(cx, fi, &mut cc.out, &mut cc.rel);
        put_facts(&mut cc.out, fi, pcx);
        let h = irh(fi, pcx);
        put_u(&mut cc.out, h.a);
        put_u(&mut cc.out, h.b);
        let before = cc.consts_before[(i - start) as usize];
        put_consts(&mut cc.out, fi, before, start);
    }
    ir_release(cx, pcx);
    if !store(cc, E_COMPONENT, first, pcx) {
        pcx.cc_out_comp.set(first, OUT_POISON);
        return;
    }
    if pcx.check {
        // (the entry's body, beside the task's state while it is read)
        let body = std::mem::replace(&mut cc.body, Vec::new_in(Comp {}));
        check_component(cx, cc, &body, start, end, pcx);
        cc.body = body;
    }
}

// (testing, $VOLE_CACHE_CHECK) The entry just made (its body), read back:
// its IR must be the tables it was made from.
fn check_component(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, body: &[u8], start: i64, end: i64,
    pcx: &Ctx<Comp>) {
    let mut r = reader(body);
    get_u(&mut r);
    let n = get_count(&mut r);
    for i in 0..n {
        get_u(&mut r);
        get_s(&mut r);
        get_s(&mut r);
    }
    get_u(&mut r);
    read_irs(cc, pcx);
    let mut ids = ids_new();
    if !get_tables(cc, &mut r, &mut ids, pcx) {
        eprintln("code cache check: {}: tables do not read back",
            fn_name(pcx.scc_order[start as usize], pcx));
        return;
    }
    get_s(&mut r);
    let ni = get_count(&mut r);
    for m in 0..ni {
        get_u(&mut r);
    }
    for i in start..end {
        let fi = pcx.scc_order[i as usize];
        let copy = match decode_ir(&mut r, fi, &ids) {
            Some(copy) => copy,
            None => {
                eprintln("code cache check: {}: IR does not read back (at {} of {})",
                    fn_name(fi, pcx), r.at, r.b.len());
                return;
            }
        };
        ir_enter(cx, fi, pcx);
        let d = copy_differs(cx, fi, &copy);
        if d != 0 {
            eprintln("code cache check: {}: IR differs read back ({d})", fn_name(fi, pcx));
        }
        skip_facts(&mut r);
    }
    ir_release(cx, pcx);
}

// Function fi's IR as its task leaves it, hashed (cc_irh_a and cc_irh_b,
// cc_irh_ok, cc_strs).
fn out_hash(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    if !hash_now(cx, cc, fi, pcx) {
        cc.poison = true;
    }
}

// The same; false when the IR names what the cache cannot (ir_hash).
fn hash_now(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    ir_enter(cx, fi, pcx);
    cc.list.clear();
    let mut h = H2 { a: 0, b: 0 };
    let ok = ir_hash(cx, fi, 0, &mut cc.marks, &mut cc.list, &mut h, pcx);
    set_strs(fi, &cc.list, pcx);
    set_irh(fi, h, pcx);
    set_irh_ok(fi, ok, pcx);
    ok
}

// The entry of the task in cc: its reads, tables and outputs (cc.out),
// stored in the slot of function fi.
fn store(cc: &mut CcCtx<Comp>, kind: i64, fi: i64, pcx: &Ctx<Comp>) -> bool {
    if cc.rel.bad {
        return false;
    }
    let alias = alias_hash(cc, pcx);
    let mut body = std::mem::replace(&mut cc.body, Vec::new_in(Comp {}));
    body.clear();
    put_u(&mut body, kind as u64);
    put_reads(cc, alias, &mut body);
    put_tables(cc, &mut body, pcx);
    body.extend_from_slice(&cc.out);
    pack_new(SLOTS_PER_FN * fi + kind - 1, cc.key.a, cc.key.b, &body, pcx);
    cc.body = body;
    true
}

// Reads entry e for component c: its reads checked, then its outputs
// installed. OUT_HIT, or why not (nothing installed then).
fn component_hit(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, e: i64, c: i64, start: i64, end: i64,
    pcx: &Ctx<Comp>) -> i64 {
    let mut r = match pack_body(e, pcx) {
        Some(body) => reader(body),
        None => return OUT_BAD,
    };
    if get_u(&mut r) as i64 != E_COMPONENT {
        return OUT_BAD;
    }
    if !reads_hold(cx, cc, &mut r, pcx) {
        return OUT_READ;
    }
    let mut ids = ids_new();
    if !get_tables(cc, &mut r, &mut ids, pcx) {
        return OUT_BAD;
    }
    component_install(cx, cc, &mut r, &ids, c, start, end, pcx)
}

// The outputs of a component's entry (r at them), installed when all of
// them read.
fn component_install(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, r: &mut Reader<'_>,
    ids: &Ids<Comp>, c: i64, start: i64, end: i64, pcx: &Ctx<Comp>) -> i64 {
    let n = end - start;
    let growth = get_s(r);
    let ni = get_count(r);
    let mut inlined: Vec<i64, Comp> = Vec::new_in(Comp {});
    for m in 0..ni {
        let mut bad = false;
        let f = ids_at(&ids.fns, get_u(r) as i64, &mut bad);
        if bad || pcx.fn_ir[f as usize] <= 0 {
            return OUT_BAD;
        }
        inlined.push(pcx.fn_ir[f as usize] - 1);
    }
    let mut copies: Vec<IRCopy<Comp>, Comp> = Vec::new_in(Comp {});
    // (per member: where its facts and constant data are in r)
    let mut facts_at: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..n {
        let fi = pcx.scc_order[(start + i) as usize];
        match decode_ir(r, fi, ids) {
            Some(copy) => copies.push(copy),
            None => return OUT_BAD,
        }
        facts_at.push(r.at);
        skip_facts(r);
        if r.bad {
            return OUT_BAD;
        }
    }
    // Installed: each function's IR, facts and constant data.
    for (i, copy) in copies.into_iter().enumerate() {
        let fi = pcx.scc_order[start as usize + i];
        install_ir(cx, fi, copy, pcx);
        r.at = facts_at[i];
        get_facts(r, fi, pcx);
        let a = get_u(r);
        let b = get_u(r);
        set_irh(fi, H2 { a, b }, pcx);
        set_irh_ok(fi, true, pcx);
        replay_consts(cx, r, fi, P_COMPONENT, start);
        // (its strings, as hash::ir_hash lists them)
        list_strings(cx, &mut cc.ids, fi, pcx);
    }
    ir_release(cx, pcx);
    pcx.comp_growth.set(c, growth);
    for &g in inlined.iter() {
        pcx.comp_inlined.push(c, g);
    }
    OUT_HIT
}

fn skip_facts(r: &mut Reader<'_>) {
    for i in 0..3 {
        get_s(r);
    }
    let nd = get_count(r);
    for i in 0..nd {
        get_s(r);
    }
    for i in 0..4 {
        get_s(r);
    }
    get_u(r);
    get_u(r);
    consts_read(r);
}

fn get_facts(r: &mut Reader<'_>, fi: i64, pcx: &Ctx<Comp>) {
    pcx.fn_size.set(fi, get_s(r));
    pcx.fn_rt.set(fi, get_s(r));
    pcx.fn_deciders_start.set(fi, get_s(r));
    let nd = get_count(r);
    pcx.fn_deciders.clear(fi);
    for i in 0..nd {
        pcx.fn_deciders.push(fi, get_s(r));
    }
    pcx.opt_deferred.set(fi, get_s(r));
    pcx.fn_attrs.set(fi, get_s(r));
    pcx.fn_nocapture.set(fi, get_s(r));
    pcx.fn_attrs_done.set(fi, get_s(r));
}

// The constant data an entry's task made for function fi, made again (in
// its order: the same placeholders), in phase `phase`'s order with rank
// rank0 + the recorded one.
fn replay_consts(cx: &mut FnCtx<Comp>, r: &mut Reader<'_>, fi: i64, phase: i64, rank0: i64) {
    let nc = get_count(r);
    let saved_phase = cx.task_phase;
    let saved_rank = cx.task_rank;
    for k in 0..nc {
        let ph = get_u(r) as i64;
        let rank = get_s(r);
        let align = get_s(r);
        let bytes = get_bytes(r);
        cx.task_phase = ph;
        cx.task_rank = rank + rank0;
        const_data(cx, fi, bytes, align);
    }
    cx.task_phase = saved_phase;
    cx.task_rank = saved_rank;
}

// Function fi's tables replaced by a read copy.
fn install_ir(cx: &mut FnCtx<Comp>, fi: i64, c: IRCopy<Comp>, pcx: &Ctx<Comp>) {
    ir_enter(cx, fi, pcx);
    cx.fn_entry = c.entry;
    cx.fn_result_ptr = c.result_ptr;
    cx.fn_blocks = c.fn_blocks;
    cx.fn_slots = c.fn_slots;
    cx.insts = c.insts;
    cx.blocks = c.blocks;
    cx.slots = c.slots;
    cx.args = c.args;
    cx.argty = c.argty;
    cx.swcases = c.swcases;
    cx.inst_loc = c.inst_loc;
}

// cc_strs[fi]: the distinct string ids of fi's SADDRs (current in cx), in
// instruction order (as ir_hash lists them); `seen` is scratch.
fn list_strings(cx: &mut FnCtx<Comp>, seen: &mut HMap, fi: i64, pcx: &Ctx<Comp>) {
    pcx.cc_strs.clear(fi);
    seen.clear();
    for i in 0..cx.insts.len() {
        let v = cx.insts[i];
        if v.op == crate::middle::ir::Op::SAddr && v.imm >= 0 {
            let key = (v.imm << 1) | 1;
            if seen.get(key) == 0 {
                seen.put(key, 1);
                pcx.cc_strs.push(fi, v.imm);
            }
        }
    }
}

// ---- Emission ----

// Function fi's emission task (task: its rank): true when its text came
// from the cache (FN_TEXT[fi] set, its IR freed); else its recording
// begins, and the text names strings by index (cc_text_string).
pub fn cc_emit_begin(cx: &mut FnCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) -> bool {
    let mut cc = task_begin(cx, -1, fi, pcx);
    let hit = emit_begin(cx, &mut *cc, fi, task, pcx);
    cc_put(cx, cc);
    hit
}

fn emit_begin(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.fn_scc.len() > 0 {
        cc.own_scc = pcx.fn_scc[fi as usize];
    }
    let mut key = h2_new(E_EMIT as u64);
    h2_put(&mut key, pcx.codecache_env.a);
    h2_put(&mut key, pcx.codecache_env.b);
    let mut ok = true;
    if irh_ok(fi, pcx) {
        cc.members.push(fi);
        cc.own_start.push(0);
        cc.consts_before.push(const_data_count(fi));
        add_strs(fi, &mut cc.own_strs, pcx);
        key_put_fn(&mut key, fi, irh(fi, pcx), pcx);
    } else {
        ok = hash_input(cx, cc, fi, &mut key, pcx);
        ir_release(cx, pcx);
    }
    set_irh_ok(fi, false, pcx);
    cc.key = key;
    cc.text = true;
    if !ok {
        cc.poison = true;
        cc.rec = true;
        pcx.cc_out_emit.set(fi, OUT_POISON);
        return false;
    }
    let e = pack_find(key.a, key.b, pcx);
    if e >= 0 {
        let got = emit_hit(cx, cc, e, fi, task, pcx);
        if got == OUT_HIT {
            mark_used_fn(e, fi, pcx);
            pcx.cc_out_emit.set(fi, OUT_HIT);
            cc.text = false;
            return true;
        }
        pcx.cc_out_emit.set(fi, got);
    } else {
        pcx.cc_out_emit.set(fi, OUT_NONE);
    }
    cc.relocs.clear();
    cc.reloc_map.clear();
    cc.rec = true;
    false
}

// The text's name for string or constant data `id` (a task's, with the
// cache): its index among the text's (written L\x03<index>, the join puts
// the id), or -1 without.
pub fn cc_text_string(cx: &mut FnCtx<Comp>, id: i64) -> i64 {
    let cc = match &mut cx.cc {
        Some(cc) => &mut **cc,
        None => return -1,
    };
    if !cc.text {
        return -1;
    }
    let key = (id << 1) | 1;
    let i = cc.reloc_map.get(key);
    if i > 0 {
        return i - 1;
    }
    cc.relocs.push(id);
    cc.reloc_map.put(key, cc.relocs.len() as i64);
    cc.relocs.len() as i64 - 1
}

// Function fi's emission is done (its text in FN_TEXT[fi]): the text's
// string ids for the join, and its entry made unless poisoned.
pub fn cc_emit_end(cx: &mut FnCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) {
    let mut cc = cc_take(cx);
    emit_end(&mut *cc, fi, pcx);
    cc_put(cx, cc);
}

fn emit_end(cc: &mut CcCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    cc.rec = false;
    cc.text = false;
    text_set_relocs(fi, &cc.relocs);
    if cc.poison {
        pcx.cc_out_emit.set(fi, OUT_POISON);
        return;
    }
    read_irs(cc, pcx);
    rel_sources(cc, pcx);
    cc.out.clear();
    put_text(&mut cc.out, fi);
    put_u(&mut cc.out, cc.relocs.len() as u64);
    for i in 0..cc.relocs.len() {
        let x = rel_saddr(&mut cc.rel, cc.relocs[i]);
        put_u(&mut cc.out, x as u64);
    }
    let before = cc.consts_before[0];
    put_consts(&mut cc.out, fi, before, 0);
    put_text_rtids(&mut cc.out, &mut cc.rel, fi);
    if !store(cc, E_EMIT, fi, pcx) {
        pcx.cc_out_emit.set(fi, OUT_POISON);
    }
}

// The text's string ids, by index, for the join (FN_TEXT[fi].relocs).
fn text_set_relocs(fi: i64, relocs: &[i64]) {
    // UNSAFE: FN_TEXT is middle::parallel's raw table (get_fn_text), and
    // an entry's parts are raw blocks the join frees.
    // SAFETY: fi is the emission task's own function, so the entry is this
    // task's alone until the join (get_fn_text's rule); the block has room
    // for relocs.len() + 1 words, and relocs.len() of them are written.
    unsafe {
        let t = get_fn_text().add(fi as usize);
        let p = alloc_array::<i64>(relocs.len() as i64 + 1);
        for i in 0..relocs.len() {
            *p.add(i) = relocs[i];
        }
        (*t).relocs = p;
        (*t).nrelocs = relocs.len() as i64;
    }
}

// Function fi's text and its labels, into an entry.
fn put_text(out: &mut Vec<u8, Comp>, fi: i64) {
    // UNSAFE: FN_TEXT is middle::parallel's raw table; the text is a raw
    // block and a length.
    // SAFETY: fi is the emission task's own function, whose text run_task
    // just made: data holds len bytes (len + 1 allocated), and nothing
    // frees it before the join, after this task; the slice is not kept.
    unsafe {
        let t = get_fn_text().add(fi as usize);
        put_bytes(out, std::slice::from_raw_parts((*t).data, (*t).len as usize));
        put_s(out, (*t).labels);
    }
}

// Function fi's text's RTID values, into an entry (by rel's index).
fn put_text_rtids(out: &mut Vec<u8, Comp>, rel: &mut Rel<Comp>, fi: i64) {
    // UNSAFE: FN_TEXT is middle::parallel's raw table; the values are a
    // raw block and a count.
    // SAFETY: fi is the emission task's own function; run_task wrote
    // nrtids values into a block of nrtids + 1; the slice is not kept.
    unsafe {
        let t = get_fn_text().add(fi as usize);
        let rtids = std::slice::from_raw_parts((*t).rtids, (*t).nrtids as usize);
        put_u(out, rtids.len() as u64);
        for &v in rtids.iter() {
            put_u(out, rel_rtid(rel, v) as u64);
        }
    }
}

// Function fi's text read from an entry: FN_TEXT[fi] as run_task and
// cc_emit_end leave it.
fn text_install(fi: i64, text: &[u8], labels: i64, relocs: &[i64], rtids: &[i64]) {
    // UNSAFE: FN_TEXT is middle::parallel's raw table, and an entry's
    // parts are raw blocks the join frees.
    // SAFETY: fi is the emission task's own function, so the entry is this
    // task's alone until the join; each block is allocated one item longer
    // than what is copied into it, from a slice of that length.
    unsafe {
        let t = get_fn_text().add(fi as usize);
        (*t).len = text.len() as i64;
        (*t).data = alloc_zeroed(text.len() as i64 + 1);
        memcpy((*t).data, text.ptr, text.len() as u64);
        (*t).labels = labels;
        let r = alloc_array::<i64>(relocs.len() as i64 + 1);
        for i in 0..relocs.len() {
            *r.add(i) = relocs[i];
        }
        (*t).relocs = r;
        (*t).nrelocs = relocs.len() as i64;
        let p = alloc_array::<i64>(rtids.len() as i64 + 1);
        for i in 0..rtids.len() {
            *p.add(i) = rtids[i];
        }
        (*t).rtids = p;
        (*t).nrtids = rtids.len() as i64;
    }
}

// Reads entry e for function fi's emission: its reads checked, then its
// text and constant data installed. OUT_HIT, or why not.
fn emit_hit(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, e: i64, fi: i64, task: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut r = match pack_body(e, pcx) {
        Some(body) => reader(body),
        None => return OUT_BAD,
    };
    if get_u(&mut r) as i64 != E_EMIT {
        return OUT_BAD;
    }
    if !reads_hold(cx, cc, &mut r, pcx) {
        return OUT_READ;
    }
    let mut ids = ids_new();
    if !get_tables(cc, &mut r, &mut ids, pcx) {
        return OUT_BAD;
    }
    emit_install(cx, &mut r, &ids, fi, task, pcx)
}

fn emit_install(cx: &mut FnCtx<Comp>, r: &mut Reader<'_>, ids: &Ids<Comp>, fi: i64, task: i64,
    pcx: &Ctx<Comp>) -> i64 {
    let text = get_bytes(r);
    let labels = get_s(r);
    let nr = get_count(r);
    let mut relocs: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut bad = false;
    for i in 0..nr {
        relocs.push(ids_saddr(ids, get_u(r) as i64, &mut bad));
    }
    if bad || r.bad {
        return OUT_BAD;
    }
    // (the constant data: P_EMIT's rank is the task's, the others' the
    // function's)
    let nc_at = r.at;
    consts_read(r);
    // (its RTID values, after: the text's loads of them)
    let nt = get_count(r);
    let mut rtids: Vec<i64, Comp> = Vec::new_in(Comp {});
    for k in 0..nt {
        rtids.push(ids_at(&ids.rtids, get_u(r) as i64, &mut bad));
    }
    if r.bad || bad {
        return OUT_BAD;
    }
    r.at = nc_at;
    let saved_phase = cx.task_phase;
    let saved_rank = cx.task_rank;
    let nc = get_count(r);
    for k in 0..nc {
        let ph = get_u(r) as i64;
        get_s(r);
        let align = get_s(r);
        let bytes = get_bytes(r);
        cx.task_phase = ph;
        cx.task_rank = if ph == P_EMIT { task } else { fi };
        const_data(cx, fi, bytes, align);
    }
    cx.task_phase = saved_phase;
    cx.task_rank = saved_rank;
    text_install(fi, text, labels, &relocs, &rtids);
    crate::middle::ir::ir_free_func(cx, fi, pcx);
    OUT_HIT
}

// ---- The scalar phases ----

// -O2's cleanup and scalar pipeline of a function (two tasks, two phases)
// are one entry: its IR as lowered in, as the scalar pipeline leaves it
// out. (-O1's cleanup alone costs less than hashing and reading its
// entry: not cached.) A hit in the cleanup task installs the IR the
// scalar pipeline leaves (no other task reads it between) and makes the
// cleanup's constant data; the scalar pipeline's task then makes its
// constant data (in its phase's order) and nothing else. A miss records
// across both tasks (Ctx.cc_scalar, the function's own, behind its lock).
pub struct ScalarRec<A: Allocator> {
    reads: Vec<i64, A>, own_strs: Vec<i64, A>, before: i64, key: H2, poison: bool,
    // (a hit: the entry, and where its constant data is in its body)
    hit: i64, at: i64,
}

fn scalar_rec() -> ScalarRec<Comp> {
    ScalarRec {
        reads: Vec::new_in(Comp {}), own_strs: Vec::new_in(Comp {}), before: 0,
        key: H2 { a: 0, b: 0 }, poison: false, hit: -1, at: 0,
    }
}

const E_SCALAR: i64 = 3;

// Function fi's cleanup task (task: its rank): true when the entry was
// used (its IR installed).
pub fn cc_scalar_begin(cx: &mut FnCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) -> bool {
    let mut cc = task_begin(cx, -1, fi, pcx);
    let hit = scalar_begin(cx, &mut *cc, fi, task, pcx);
    cc_put(cx, cc);
    hit
}

fn scalar_begin(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) -> bool {
    pcx.cc_scalar[fi as usize].lock().unwrap().hit = -1;
    set_irh_ok(fi, false, pcx);
    let mut key = h2_new(E_SCALAR as u64);
    h2_put(&mut key, pcx.codecache_env.a);
    h2_put(&mut key, pcx.codecache_env.b);
    let ok = hash_input(cx, cc, fi, &mut key, pcx);
    ir_release(cx, pcx);
    cc.key = key;
    if !ok {
        cc.poison = true;
        cc.rec = true;
        pcx.cc_out_scalar.set(fi, OUT_POISON);
        return false;
    }
    let e = pack_find(key.a, key.b, pcx);
    if e >= 0 {
        let got = scalar_hit(cx, cc, e, fi, task, pcx);
        if got == OUT_HIT {
            mark_used_fn(e, fi, pcx);
            pcx.cc_out_scalar.set(fi, OUT_HIT);
            return true;
        }
        pcx.cc_out_scalar.set(fi, got);
    } else {
        pcx.cc_out_scalar.set(fi, OUT_NONE);
    }
    cc.rec = true;
    false
}

// Function fi's cleanup is done (a miss): the recording kept for its
// scalar pipeline's task.
pub fn cc_scalar_cleanup_end(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    let cc = match &mut cx.cc {
        Some(cc) => &mut **cc,
        None => return,
    };
    cc.rec = false;
    let mut sr = pcx.cc_scalar[fi as usize].lock().unwrap();
    sr.reads.clear();
    sr.reads.extend_from_slice(&cc.reads);
    sr.own_strs.clear();
    sr.own_strs.extend_from_slice(&cc.own_strs);
    sr.before = cc.consts_before[0];
    sr.key = cc.key;
    sr.poison = cc.poison;
}

// Function fi's scalar pipeline task (-O2): true when its cleanup's task
// used the entry (its constant data made here); else the recording goes
// on.
pub fn cc_scalar_simplify_begin(cx: &mut FnCtx<Comp>, fi: i64, task: i64, pcx: &Ctx<Comp>) -> bool {
    let (hit, at) = {
        let sr = pcx.cc_scalar[fi as usize].lock().unwrap();
        (sr.hit, sr.at)
    };
    if hit >= 0 {
        let mut r = reader(pack_body_at(hit, pcx));
        r.at = at;
        replay_phase(cx, &mut r, fi, P_SIMPLIFY, task);
        return true;
    }
    let mut cc = task_begin(cx, -1, fi, pcx);
    {
        let sr = pcx.cc_scalar[fi as usize].lock().unwrap();
        cc.members.push(fi);
        cc.own_start.push(0);
        cc.consts_before.push(sr.before);
        cc.own_strs.extend_from_slice(&sr.own_strs);
        cc.reads.extend_from_slice(&sr.reads);
        cc.key = sr.key;
        cc.poison = sr.poison;
    }
    cc.rec = true;
    cc_put(cx, cc);
    false
}

// Function fi's scalar phases are done (a miss): its IR hashed, its entry
// made unless poisoned.
pub fn cc_scalar_end(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    let mut cc = cc_take(cx);
    scalar_end(cx, &mut *cc, fi, pcx);
    cc_put(cx, cc);
}

fn scalar_end(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    cc.rec = false;
    out_hash(cx, cc, fi, pcx);
    if cc.poison {
        pcx.cc_out_scalar.set(fi, OUT_POISON);
        ir_release(cx, pcx);
        return;
    }
    read_irs(cc, pcx);
    rel_sources(cc, pcx);
    cc.out.clear();
    ir_enter(cx, fi, pcx);
    encode_ir(cx, fi, &mut cc.out, &mut cc.rel);
    ir_release(cx, pcx);
    let h = irh(fi, pcx);
    put_u(&mut cc.out, h.a);
    put_u(&mut cc.out, h.b);
    let before = cc.consts_before[0];
    put_consts(&mut cc.out, fi, before, 0);
    if !store(cc, E_SCALAR, fi, pcx) {
        pcx.cc_out_scalar.set(fi, OUT_POISON);
    }
}

// Reads entry e for function fi's scalar phases: its reads checked, then
// its IR installed and the cleanup's constant data made (the rest waits
// for the scalar pipeline's task: Ctx.cc_scalar). OUT_HIT, or why not.
fn scalar_hit(cx: &mut FnCtx<Comp>, cc: &mut CcCtx<Comp>, e: i64, fi: i64, task: i64,
    pcx: &Ctx<Comp>) -> i64 {
    let mut r = match pack_body(e, pcx) {
        Some(body) => reader(body),
        None => return OUT_BAD,
    };
    if get_u(&mut r) as i64 != E_SCALAR {
        return OUT_BAD;
    }
    if !reads_hold(cx, cc, &mut r, pcx) {
        return OUT_READ;
    }
    let mut ids = ids_new();
    if !get_tables(cc, &mut r, &mut ids, pcx) {
        return OUT_BAD;
    }
    let copy = match decode_ir(&mut r, fi, &ids) {
        Some(copy) => copy,
        None => return OUT_BAD,
    };
    let a = get_u(&mut r);
    let b = get_u(&mut r);
    let at = r.at;
    if !consts_read(&mut r) {
        return OUT_BAD;
    }
    install_ir(cx, fi, copy, pcx);
    list_strings(cx, &mut cc.ids, fi, pcx);
    ir_release(cx, pcx);
    set_irh(fi, H2 { a, b }, pcx);
    set_irh_ok(fi, true, pcx);
    r.at = at;
    replay_phase(cx, &mut r, fi, P_CLEANUP, task);
    let mut sr = pcx.cc_scalar[fi as usize].lock().unwrap();
    sr.hit = e;
    sr.at = at;
    OUT_HIT
}

// Whether an entry's constant data reads whole (r is left after it).
fn consts_read(r: &mut Reader<'_>) -> bool {
    let nc = get_count(r);
    for k in 0..nc {
        get_u(r);
        get_s(r);
        get_s(r);
        get_bytes(r);
    }
    !r.bad
}

// The constant data of an entry (r at its list) made in phase `phase`
// made again for function fi, in their order, with rank `rank`.
fn replay_phase(cx: &mut FnCtx<Comp>, r: &mut Reader<'_>, fi: i64, phase: i64, rank: i64) {
    let nc = get_count(r);
    let saved_phase = cx.task_phase;
    let saved_rank = cx.task_rank;
    for k in 0..nc {
        let ph = get_u(r) as i64;
        get_s(r);
        let align = get_s(r);
        let bytes = get_bytes(r);
        if ph == phase {
            cx.task_phase = ph;
            cx.task_rank = rank;
            const_data(cx, fi, bytes, align);
        }
    }
    cx.task_phase = saved_phase;
    cx.task_rank = saved_rank;
}
