// (0.18.1) The code cache's file (back/codecache): one pack per program,
// target and options, target/volec-cache/g-KEY.pack (where the tools'
// cache is), KEY a hash of the root as given, the current directory, the
// target, the options and the compiler's executable.
//
// A pack is 8-byte words: a header (MAGIC, VERSION, the compiler's hash,
// the options' hash, the file's length, the entries, when it was last
// used, 0), then the entries, each a word of its body's length, its key
// (two words), its age (builds since one used it), its body's hash, and
// the body (padded to a word). It is read whole (mapped), checked, and
// indexed by key; a body is checked against its hash when its entry is
// used, and a damaged one is a miss.
//
// A build that made entries writes a new pack, renamed over the old one
// (a reader has the old one or the new one, whole): the entries it used,
// the ones it made, and the others for MAX_AGE builds, while the pack
// stays under twice what the build used. Then, when the directory's packs
// pass LIMIT, the least recently used are deleted.

use crate::host_target;
use crate::back::codecache::hash::hash_bytes;
use crate::back::codecache::snapshot::Reader;
use crate::base::{alloc_array, alloc_zeroed, free, getenv, memcpy, strlen};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{T_AARCH64_MACOS, T_X86_64_MACOS};

extern "C" {
    fn open(path: *u8, flags: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn lseek(fd: i32, offset: i64, whence: i32) -> i64;
    fn pwrite(fd: i32, buf: *u8, n: u64, offset: i64) -> i64;
    fn read(fd: i32, buf: *u8, n: u64) -> i64;
    fn mmap(addr: *u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *u8;
    fn time(t: *i64) -> i64;
    fn opendir(path: *u8) -> *u8;
    fn readdir(dir: *u8) -> *u8;
    fn closedir(dir: *u8) -> i32;
    fn unlink(path: *u8) -> i32;
    fn rename(from: *u8, to: *u8) -> i32;
    fn fopen(path: *u8, mode: *u8) -> *u8;
    fn fwrite(buf: *u8, size: u64, count: u64, file: *u8) -> u64;
    fn fclose(file: *u8) -> i32;
    fn getpid() -> i32;
}

// "tachyong", and the version of the format (and of what the keys hold).
const MAGIC: i64 = 8174034211981648231;
pub const VERSION: i64 = 1;
const HEADER_WORDS: i64 = 8;
const ENTRY_WORDS: i64 = 5;
// Builds an entry no build used is kept for.
const MAX_AGE: i64 = 3;
// The directory's packs, at most (bytes; VOLE_CACHE_LIMIT in MB).
const LIMIT: i64 = 1024 * 1024 * 1024;

// Per entry read: whether this build used it (its own task writes it).
static var USED: *bool = 0 as *bool;

// The entries this build made: per slot (middle::parallel's tasks own
// theirs), its body and key.
pub struct NewEntry { body: *u8, len: i64, a: u64, b: u64 }
static var NEW: *NewEntry = 0 as *NewEntry;

// ---- Reading ----

// Reads the pack at `path` (made by compiler `ident` for options
// `options`), if there is a whole one; `slots` entries may be made.
pub fn pack_load(path: *u8, ident: i64, options: i64, slots: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.pack_path = path;
        pcx.pack_ident = ident;
        pcx.options = options;
        pcx.new_slots = slots;
        NEW = alloc_zeroed((slots + 1) * size_of(NewEntry)) as *NewEntry;
        let fd = open(path, 0);
        if fd < 0 {
            return;
        }
        let size = lseek(fd, 0, 2);
        if size < HEADER_WORDS * 8 || size % 8 != 0 {
            close(fd);
            return;
        }
        // (PROT_READ, MAP_PRIVATE)
        let p = mmap(0 as *u8, size as u64, 1, 2, fd, 0);
        close(fd);
        if p == 0 as *u8 || p as i64 == -1 {
            return;
        }
        let w = p as *i64;
        if w[0] != MAGIC || w[1] != VERSION || w[2] != ident || w[3] != options || w[4] != size {
            return;
        }
        let n = w[5];
        if n < 0 || n > size / (ENTRY_WORDS * 8) {
            return;
        }
        let at = alloc_array::<i64>(n + 1);
        let words = size / 8;
        var k = HEADER_WORDS;
        for e in 0..n {
            if k + ENTRY_WORDS > words {
                free(at as *u8);
                return;
            }
            let len = w[k];
            if len < 0 || k + ENTRY_WORDS + (len + 7) / 8 > words {
                free(at as *u8);
                return;
            }
            at[e] = k;
            k += ENTRY_WORDS + (len + 7) / 8;
        }
        pcx.pack = w;
        pcx.pack_words = words;
        pcx.entry_at = at;
        pcx.entry_count = n;
        USED = alloc_array::<bool>(n + 1);
        pcx.index_size = 64;
        while pcx.index_size < 2 * n + 2 {
            pcx.index_size *= 2;
        }
        pcx.index = alloc_array::<i64>(pcx.index_size);
        for e in 0..n {
            var s = (w[at[e] + 1] as u64 >> 7) as i64 & (pcx.index_size - 1);
            while pcx.index[s] != 0 {
                s = (s + 1) & (pcx.index_size - 1);
            }
            pcx.index[s] = e + 1;
        }
    }
}

// The entry with key (a, b), or -1.
pub fn pack_find(a: u64, b: u64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.index_size == 0 {
            return -1;
        }
        var s = (a >> 7) as i64 & (pcx.index_size - 1);
        while pcx.index[s] != 0 {
            let e = pcx.index[s] - 1;
            let k = pcx.entry_at[e];
            if pcx.pack[k + 1] as u64 == a && pcx.pack[k + 2] as u64 == b {
                return e;
            }
            s = (s + 1) & (pcx.index_size - 1);
        }
        -1
    }
}

// Entry e's body to read, if it is whole (its hash).
pub fn pack_body(e: i64, r: inout Reader, pcx: Ctx<Comp>) -> bool {
    unsafe {
        let k = pcx.entry_at[e];
        let len = pcx.pack[k];
        let p = (&pcx.pack[k + ENTRY_WORDS]) as *u8;
        if hash_bytes(p, len) as i64 != pcx.pack[k + 4] {
            return false;
        }
        r.p = p;
        r.at = 0;
        r.end = len;
        r.bad = false;
        true
    }
}

// Entry e's body to read, checked already (pack_body).
pub fn pack_body_at(e: i64, r: inout Reader, pcx: Ctx<Comp>) {
    unsafe {
        let k = pcx.entry_at[e];
        r.p = (&pcx.pack[k + ENTRY_WORDS]) as *u8;
        r.at = 0;
        r.end = pcx.pack[k];
        r.bad = false;
    }
}

// Entry e was used (by the task that owns its key).
pub fn pack_used(e: i64) {
    unsafe { USED[e] = true; }
}

// A new entry for slot s (its task's own).
pub fn pack_new(s: i64, a: u64, b: u64, body: *u8, len: i64, pcx: Ctx<Comp>) {
    unsafe {
        if s < 0 || s >= pcx.new_slots {
            free(body);
            return;
        }
        free(NEW[s].body);
        NEW[s] = NewEntry { body, len, a, b };
    }
}

// ---- Writing ----

// What the build would write: whether anything changed (new entries, or
// read ones not used).
pub fn pack_changed(pcx: Ctx<Comp>) -> bool {
    unsafe {
        for s in 0..pcx.new_slots {
            if NEW[s].body != 0 as *u8 {
                return true;
            }
        }
        for e in 0..pcx.entry_count {
            if !USED[e] {
                return true;
            }
        }
        false
    }
}

fn put_word(f: *u8, v: i64) {
    unsafe {
        var w: [i64; 1] = [v];
        fwrite((&w[0]) as *u8, 8, 1, f);
    }
}

fn put_entry(f: *u8, body: *u8, len: i64, a: u64, b: u64, age: i64, hash: i64) {
    unsafe {
        put_word(f, len);
        put_word(f, a as i64);
        put_word(f, b as i64);
        put_word(f, age);
        put_word(f, hash);
        if len > 0 {
            fwrite(body, 1, len as u64, f);
        }
        let pad = (8 - len % 8) % 8;
        let zero: [i64; 1] = [0];
        if pad > 0 {
            fwrite((&zero[0]) as *u8, 1, pad as u64, f);
        }
    }
}

fn entry_bytes(len: i64) -> i64 {
    ENTRY_WORDS * 8 + (len + 7) / 8 * 8
}

// Writes the new pack (main thread, or the copy of the process that
// writes it): the entries used and made, then the others young enough
// while the pack stays under twice the used ones.
pub fn pack_save(pcx: Ctx<Comp>) {
    unsafe {
        var used_bytes = 0;
        var count = 0;
        for s in 0..pcx.new_slots {
            if NEW[s].body != 0 as *u8 {
                used_bytes += entry_bytes(NEW[s].len);
                count += 1;
            }
        }
        for e in 0..pcx.entry_count {
            if USED[e] {
                used_bytes += entry_bytes(pcx.pack[pcx.entry_at[e]]);
                count += 1;
            }
        }
        // The others, youngest first, while they fit.
        let room = if used_bytes < 16 * 1024 * 1024 { 32 * 1024 * 1024 } else { 2 * used_bytes };
        let keep = alloc_array::<bool>(pcx.entry_count + 1);
        var total = used_bytes;
        for age in 0..MAX_AGE {
            for e in 0..pcx.entry_count {
                let k = pcx.entry_at[e];
                if !USED[e] && pcx.pack[k + 3] == age && total + entry_bytes(pcx.pack[k]) <= room {
                    keep[e] = true;
                    total += entry_bytes(pcx.pack[k]);
                    count += 1;
                }
            }
        }
        let tmp = tmp_path(pcx.pack_path);
        let f = fopen(tmp, c"wb");
        if f == 0 as *u8 {
            return;
        }
        put_word(f, MAGIC);
        put_word(f, VERSION);
        put_word(f, pcx.pack_ident);
        put_word(f, pcx.options);
        put_word(f, HEADER_WORDS * 8 + total);
        put_word(f, count);
        put_word(f, time(0 as *i64));
        put_word(f, 0);
        for s in 0..pcx.new_slots {
            let n = NEW[s];
            if n.body != 0 as *u8 {
                put_entry(f, n.body, n.len, n.a, n.b, 0, hash_bytes(n.body, n.len) as i64);
            }
        }
        for e in 0..pcx.entry_count {
            let k = pcx.entry_at[e];
            if USED[e] || keep[e] {
                put_entry(f, (&pcx.pack[k + ENTRY_WORDS]) as *u8, pcx.pack[k],
                    pcx.pack[k + 1] as u64, pcx.pack[k + 2] as u64,
                    if USED[e] { 0 } else { pcx.pack[k + 3] + 1 }, pcx.pack[k + 4]);
            }
        }
        if fclose(f) != 0 || rename(tmp, pcx.pack_path) != 0 {
            unlink(tmp);
            return;
        }
        evict(pcx);
    }
}

// The pack was all used and nothing was made: its time of last use.
pub fn pack_touch(pcx: Ctx<Comp>) {
    unsafe {
        if pcx.pack == 0 as *i64 {
            return;
        }
        let fd = open(pcx.pack_path, 1);
        if fd >= 0 {
            var now: [i64; 1] = [time(0 as *i64)];
            pwrite(fd, (&now[0]) as *u8, 8, 48);
            close(fd);
        }
    }
}

fn tmp_path(path: *u8) -> *u8 {
    unsafe {
        let n = strlen(path) as i64;
        let p = alloc_zeroed(n + 32);
        memcpy(p, path, n as u64);
        var k = n;
        let tail = c".tmp";
        for i in 0..4 {
            p[k] = tail[i];
            k += 1;
        }
        var pid = getpid() as i64;
        var digits: [u8; 20] = [0; 20];
        var d = 0;
        while pid > 0 || d == 0 {
            digits[d] = ('0' + (pid % 10) as u8) as u8;
            pid = pid / 10;
            d += 1;
        }
        while d > 0 {
            d -= 1;
            p[k] = digits[d];
            k += 1;
        }
        p
    }
}

// ---- Eviction ----

// The directory's packs (g-*.pack): when they pass the limit, the least
// recently used go.
fn evict(pcx: Ctx<Comp>) {
    unsafe {
        let dir = dir_of(pcx.pack_path);
        var limit = LIMIT;
        let env = getenv(c"VOLE_CACHE_LIMIT");
        if env != 0 as *u8 {
            var mb = 0;
            var i = 0;
            while env[i] >= '0' && env[i] <= '9' {
                mb = mb * 10 + (env[i] - '0') as i64;
                i += 1;
            }
            limit = mb * 1024 * 1024;
        }
        let d = opendir(dir);
        if d == 0 as *u8 {
            return;
        }
        let at = name_offset();
        var names = 0 as **u8;
        var sizes = 0 as *i64;
        var times = 0 as *i64;
        var n = 0;
        var cap = 0;
        var total = 0;
        while true {
            let ent = readdir(d);
            if ent == 0 as *u8 {
                break;
            }
            let name = &ent[at];
            if !is_pack_name(name) {
                continue;
            }
            let path = join_path(dir, name);
            let fd = open(path, 0);
            if fd < 0 {
                free(path);
                continue;
            }
            let size = lseek(fd, 0, 2);
            var head: [i64; 8] = [0; 8];
            lseek(fd, 0, 0);
            let got = read(fd, (&head[0]) as *u8, 64);
            close(fd);
            if n == cap {
                cap = cap * 2 + 16;
                let nn = alloc_array::<*u8>(cap);
                let ns = alloc_array::<i64>(cap);
                let nt = alloc_array::<i64>(cap);
                for i in 0..n {
                    nn[i] = names[i];
                    ns[i] = sizes[i];
                    nt[i] = times[i];
                }
                free(names as *u8);
                free(sizes as *u8);
                free(times as *u8);
                names = nn;
                sizes = ns;
                times = nt;
            }
            names[n] = path;
            sizes[n] = size;
            times[n] = if got == 64 && head[0] == MAGIC { head[6] } else { 0 };
            total += size;
            n += 1;
        }
        closedir(d);
        while total > limit && n > 0 {
            var old = 0;
            for i in 1..n {
                if times[i] < times[old] {
                    old = i;
                }
            }
            if !same_path(names[old], pcx.pack_path) {
                unlink(names[old]);
            }
            total -= sizes[old];
            names[old] = names[n - 1];
            sizes[old] = sizes[n - 1];
            times[old] = times[n - 1];
            n -= 1;
        }
    }
}

// Where a directory entry's name is in struct dirent: after d_ino,
// d_seekoff, d_reclen, d_namlen and d_type on macOS (64-bit inodes,
// AArch64; x86_64's readdir has the old layout), after d_ino, d_off,
// d_reclen and d_type on Linux (glibc).
fn name_offset() -> i64 {
    let host = host_target();
    if host == T_AARCH64_MACOS { 21 } else if host == T_X86_64_MACOS { 8 } else { 19 }
}

fn is_pack_name(name: *u8) -> bool {
    unsafe {
        let n = strlen(name) as i64;
        n == 2 + 16 + 5 && name[0] == 'g' && name[1] == '-' && name[n - 5] == '.'
            && name[n - 4] == 'p' && name[n - 3] == 'a' && name[n - 2] == 'c' && name[n - 1] == 'k'
    }
}

fn dir_of(path: *u8) -> *u8 {
    unsafe {
        let n = strlen(path) as i64;
        var k = n;
        while k > 0 && path[k - 1] != '/' {
            k -= 1;
        }
        let p = alloc_zeroed(n + 2);
        if k == 0 {
            p[0] = '.';
            return p;
        }
        memcpy(p, path, (k - 1) as u64);
        if k == 1 {
            p[0] = '/';
        }
        p
    }
}

fn join_path(dir: *u8, name: *u8) -> *u8 {
    unsafe {
        let a = strlen(dir) as i64;
        let b = strlen(name) as i64;
        let p = alloc_zeroed(a + b + 2);
        memcpy(p, dir, a as u64);
        p[a] = '/';
        memcpy(&p[a + 1], name, b as u64);
        p
    }
}

// Whether two paths of the same directory name the same file (by name).
fn same_path(a: *u8, b: *u8) -> bool {
    unsafe {
        let na = strlen(a) as i64;
        let nb = strlen(b) as i64;
        if na < 23 || nb < 23 {
            return false;
        }
        for i in 0..23 {
            if a[na - 1 - i] != b[nb - 1 - i] {
                return false;
            }
        }
        true
    }
}
