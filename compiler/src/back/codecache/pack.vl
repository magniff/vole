// (0.18.1) The code cache's file (back/codecache): one pack per program,
// target and options, target/volec-cache/g-KEY.pack (where the tools'
// cache is), KEY a hash of the root as given, the current directory, the
// target, the options and the compiler's executable.
//
// A pack is 8-byte words (little-endian): a header (MAGIC, VERSION, the
// compiler's hash, the options' hash, the file's length, the entries, when
// it was last used, 0), then the entries, each a word of its body's
// length, its key (two words), its age (builds since one used it), its
// body's hash, and the body (padded to a word). Its header is read, the
// rest mapped; the entries are checked and indexed by key; a body is
// checked against its hash when its entry is used, and a damaged one is a
// miss.
//
// A build that made entries writes a new pack, renamed over the old one
// (a reader has the old one or the new one, whole): the entries it used,
// the ones it made, and the others for MAX_AGE builds, while the pack
// stays under twice what the build used. Then, when the directory's packs
// pass LIMIT, the least recently used are deleted.

use std::alloc::Allocator;
use std::fs::File;
use std::io::{BufWriter, Read, Seek, SeekFrom, Write};
use std::sync::Mutex;

use crate::host_target;
use crate::back::codecache::hash::hash_bytes;
use crate::back::codecache::snapshot::Reader;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{T_AARCH64_MACOS, T_X86_64_MACOS};

// UNSAFE: mmap is the C library's; std has no file mapping.
// SAFETY: declared as <sys/mman.h> does (a pointer, a size_t, three ints
// and an off_t: 64 bits on every target the compiler runs on); map_body
// is its only caller.
extern "C" {
    fn mmap(addr: *mut u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *mut u8;
}

// "tachyong", and the version of the format (and of what the keys hold).
const MAGIC: i64 = 8174034211981648231;
pub const VERSION: i64 = 1;
const HEADER_WORDS: i64 = 8;
const ENTRY_WORDS: i64 = 5;
// Builds an entry no build used is kept for.
const MAX_AGE: i64 = 3;
// The directory's packs, at most (bytes; VOLE_CACHE_LIMIT in MB).
const LIMIT: i64 = 1024 * 1024 * 1024;

// An entry of the pack read: where its body is in the mapped bytes
// (Ctx.pack), its length, key, age and its body's hash.
#[derive(Clone, Copy)] pub struct PackEntry {
    at: i64, len: i64, a: u64, b: u64, age: i64, hash: i64,
}

// An entry this build made (Ctx.pack_new: per slot, behind its lock;
// middle::parallel's tasks own theirs): its body and key.
pub struct NewEntry<A: Allocator> { body: Vec<u8, A>, made: bool, a: u64, b: u64 }

// ---- Words ----

// Word k of b.
fn word(b: &[u8], k: i64) -> i64 {
    let w = &b[(8 * k) as usize..(8 * k + 8) as usize];
    let mut x: u64 = 0;
    for i in 0..8 {
        x = x | ((w[i] as u64) << (8 * i) as u64);
    }
    x as i64
}

fn word_bytes(v: i64) -> [u8; 8] {
    let mut w = [0u8; 8];
    let x = v as u64;
    for i in 0..8 {
        w[i] = (x >> (8 * i) as u64) as u8;
    }
    w
}

// A body's length in the file: padded to a word.
fn padded(len: i64) -> i64 {
    (len + 7) / 8 * 8
}

// ---- Reading ----

// The file's bytes after its header, mapped (the file is `size` bytes).
fn map_body(f: &File, size: i64) -> Option<&'static [u8]> {
    let head = HEADER_WORDS * 8;
    if size <= head {
        return None;
    }
    // UNSAFE: mmap is C's, and what it returns is a raw pointer: the one
    // view of a cache file's bytes (every read of a pack goes through this
    // slice).
    // SAFETY: f is open for reading and size is its length (the caller's,
    // from its metadata, more than the header), so a result that is not
    // MAP_FAILED (-1) or null is `size` readable bytes (PROT_READ,
    // MAP_PRIVATE), and the slice is the `size - head` of them from `head`.
    // Nothing unmaps it: it lives as long as the process ('static). The
    // bytes do not change under it: a pack is written whole under another
    // name and renamed over the old one (pack_save; the mapping keeps the
    // old file, as it does when evict unlinks it), and the one write in
    // place is pack_touch's, of header word 6, which is before `head` and
    // so not in the slice. u8 has no alignment and every byte is a value.
    unsafe {
        let p = mmap(0 as *mut u8, size as u64, 1, 2, f.as_raw_fd(), 0);
        if p == 0 as *mut u8 || p as i64 == -1 {
            return None;
        }
        Some(std::slice::from_raw_parts(p.add(head as usize), (size - head) as usize))
    }
}

// Reads the pack at `path` (made by compiler `ident` for options
// `options`), if there is a whole one; `slots` entries may be made.
pub fn pack_load(path: String<Comp>, ident: i64, options: i64, slots: i64, pcx: &mut Ctx<Comp>) {
    pcx.pack_ident = ident;
    pcx.options = options;
    pcx.pack_new.clear();
    for _ in 0..slots {
        pcx.pack_new.push(
            Mutex::new(NewEntry { body: Vec::new_in(Comp {}), made: false, a: 0, b: 0 }));
    }
    pcx.pack = "".as_bytes();
    pcx.pack_entries.clear();
    pcx.pack_index.clear();
    pcx.pack_used.reset(0, 0);
    let opened = File::open(path.as_str());
    pcx.pack_path = path;
    let mut f = match opened {
        Ok(f) => f,
        Err(_) => return,
    };
    let size = match f.metadata() {
        Ok(m) => m.len() as i64,
        Err(_) => return,
    };
    let mut head = [0u8; 64];
    if size < HEADER_WORDS * 8 || size % 8 != 0 || f.read_exact(&mut head).is_err() {
        return;
    }
    if word(&head, 0) != MAGIC || word(&head, 1) != VERSION || word(&head, 2) != ident
        || word(&head, 3) != options || word(&head, 4) != size {
        return;
    }
    let n = word(&head, 5);
    if n < 0 || n > size / (ENTRY_WORDS * 8) {
        return;
    }
    let bytes: &'static [u8] = match map_body(&f, size) {
        Some(b) => b,
        None => "".as_bytes(),
    };
    // (the entries' places, in words of the mapped bytes)
    let words = bytes.len() as i64 / 8;
    let mut k: i64 = 0;
    for e in 0..n {
        if k + ENTRY_WORDS > words {
            pcx.pack_entries.clear();
            return;
        }
        let len = word(bytes, k);
        if len < 0 || len > 8 * words || k + ENTRY_WORDS + padded(len) / 8 > words {
            pcx.pack_entries.clear();
            return;
        }
        pcx.pack_entries.push(PackEntry {
            at: 8 * (k + ENTRY_WORDS), len, a: word(bytes, k + 1) as u64,
            b: word(bytes, k + 2) as u64, age: word(bytes, k + 3), hash: word(bytes, k + 4),
        });
        k += ENTRY_WORDS + padded(len) / 8;
    }
    pcx.pack = bytes;
    pcx.pack_used.reset(n, 0);
    let mut size: i64 = 64;
    while size < 2 * n + 2 {
        size *= 2;
    }
    pcx.pack_index.resize(size as usize, 0);
    for e in 0..n {
        let mut s = (pcx.pack_entries[e as usize].a >> 7) as i64 & (size - 1);
        while pcx.pack_index[s as usize] != 0 {
            s = (s + 1) & (size - 1);
        }
        pcx.pack_index[s as usize] = e + 1;
    }
}

// The entry with key (a, b), or -1.
pub fn pack_find(a: u64, b: u64, pcx: &Ctx<Comp>) -> i64 {
    let size = pcx.pack_index.len() as i64;
    if size == 0 {
        return -1;
    }
    let mut s = (a >> 7) as i64 & (size - 1);
    while pcx.pack_index[s as usize] != 0 {
        let e = pcx.pack_index[s as usize] - 1;
        let en = pcx.pack_entries[e as usize];
        if en.a == a && en.b == b {
            return e;
        }
        s = (s + 1) & (size - 1);
    }
    -1
}

// Entry e's body.
fn body_of(en: PackEntry, pcx: &Ctx<Comp>) -> &[u8] {
    &pcx.pack[en.at as usize..(en.at + en.len) as usize]
}

// Entry e's body to read, if it is whole (its hash).
pub fn pack_body(e: i64, r: &mut Reader, pcx: &Ctx<Comp>) -> bool {
    let en = pcx.pack_entries[e as usize];
    let body = body_of(en, pcx);
    if hash_bytes(body) as i64 != en.hash {
        return false;
    }
    r.p = body.ptr;
    r.at = 0;
    r.end = en.len;
    r.bad = false;
    true
}

// Entry e's body to read, checked already (pack_body).
pub fn pack_body_at(e: i64, r: &mut Reader, pcx: &Ctx<Comp>) {
    let en = pcx.pack_entries[e as usize];
    r.p = body_of(en, pcx).ptr;
    r.at = 0;
    r.end = en.len;
    r.bad = false;
}

// Entry e was used (by the task that owns its key).
pub fn pack_used(e: i64, pcx: &Ctx<Comp>) {
    pcx.pack_used.set(e, 1);
}

// A new entry for slot s (its task's own).
pub fn pack_new(s: i64, a: u64, b: u64, body: &[u8], pcx: &Ctx<Comp>) {
    if s < 0 || s >= pcx.pack_new.len() as i64 {
        return;
    }
    let mut slot = pcx.pack_new[s as usize].lock().unwrap();
    slot.body.clear();
    slot.body.extend_from_slice(body);
    slot.made = true;
    slot.a = a;
    slot.b = b;
}

// ---- Writing ----

// What the build would write: whether anything changed (new entries, or
// read ones not used).
pub fn pack_changed(pcx: &Ctx<Comp>) -> bool {
    for s in 0..pcx.pack_new.len() {
        if pcx.pack_new[s].lock().unwrap().made {
            return true;
        }
    }
    for e in 0..pcx.pack_used.len() {
        if pcx.pack_used.get(e) == 0 {
            return true;
        }
    }
    false
}

fn put_word(w: &mut BufWriter<File>, v: i64) -> std::io::Result<()> {
    w.write_all(&word_bytes(v))
}

fn put_entry(w: &mut BufWriter<File>, body: &[u8], a: u64, b: u64, age: i64, hash: i64) -> std::io::Result<()> {
    let len = body.len() as i64;
    put_word(w, len)?;
    put_word(w, a as i64)?;
    put_word(w, b as i64)?;
    put_word(w, age)?;
    put_word(w, hash)?;
    w.write_all(body)?;
    let zero = [0u8; 8];
    w.write_all(&zero[0..(padded(len) - len) as usize])
}

fn entry_bytes(len: i64) -> i64 {
    ENTRY_WORDS * 8 + padded(len)
}

// Seconds since 1970.
fn now() -> i64 {
    match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {
        Ok(d) => d.as_secs() as i64,
        Err(_) => 0,
    }
}

// Writes the new pack (main thread, or the copy of the process that
// writes it): the entries used and made, then the others young enough
// while the pack stays under twice the used ones.
pub fn pack_save(pcx: &Ctx<Comp>) {
    let tmp = tmp_path(pcx.pack_path.as_str());
    if write_pack(tmp.as_str(), pcx).is_err()
        || std::fs::rename(tmp.as_str(), pcx.pack_path.as_str()).is_err() {
        let _ = std::fs::remove_file(tmp.as_str());
        return;
    }
    evict(pcx);
}

fn write_pack(tmp: &str, pcx: &Ctx<Comp>) -> std::io::Result<()> {
    let n = pcx.pack_entries.len();
    let mut used_bytes: i64 = 0;
    let mut count: i64 = 0;
    for s in 0..pcx.pack_new.len() {
        let slot = pcx.pack_new[s].lock().unwrap();
        if slot.made {
            used_bytes += entry_bytes(slot.body.len() as i64);
            count += 1;
        }
    }
    for e in 0..n {
        if pcx.pack_used.get(e as i64) != 0 {
            used_bytes += entry_bytes(pcx.pack_entries[e].len);
            count += 1;
        }
    }
    // The others, youngest first, while they fit.
    let room: i64 = if used_bytes < 16 * 1024 * 1024 { 32 * 1024 * 1024 }
        else { 2 * used_bytes };
    let mut keep: Vec<bool, Comp> = Vec::new_in(Comp {});
    keep.resize(n, false);
    let mut total = used_bytes;
    for age in 0..MAX_AGE {
        for e in 0..n {
            let en = pcx.pack_entries[e];
            if pcx.pack_used.get(e as i64) == 0 && en.age == age
                && total + entry_bytes(en.len) <= room {
                keep[e] = true;
                total += entry_bytes(en.len);
                count += 1;
            }
        }
    }
    let mut w = BufWriter::new(File::create(tmp)?);
    put_word(&mut w, MAGIC)?;
    put_word(&mut w, VERSION)?;
    put_word(&mut w, pcx.pack_ident)?;
    put_word(&mut w, pcx.options)?;
    put_word(&mut w, HEADER_WORDS * 8 + total)?;
    put_word(&mut w, count)?;
    put_word(&mut w, now())?;
    put_word(&mut w, 0)?;
    for s in 0..pcx.pack_new.len() {
        let slot = pcx.pack_new[s].lock().unwrap();
        if slot.made {
            put_entry(&mut w, &slot.body, slot.a, slot.b, 0, hash_bytes(&slot.body) as i64)?;
        }
    }
    for e in 0..n {
        let en = pcx.pack_entries[e];
        let used = pcx.pack_used.get(e as i64) != 0;
        if used || keep[e] {
            put_entry(&mut w, body_of(en, pcx), en.a, en.b, if used { 0 } else { en.age + 1 },
                en.hash)?;
        }
    }
    w.flush()
}

// The pack was all used and nothing was made: its time of last use.
pub fn pack_touch(pcx: &Ctx<Comp>) {
    // (no pack was read: no index)
    if pcx.pack_index.len() == 0 {
        return;
    }
    if let Ok(mut f) = std::fs::OpenOptions::new().write(true).open(pcx.pack_path.as_str()) {
        if f.seek(SeekFrom::Start(48)).is_ok() {
            let _ = f.write_all(&word_bytes(now()));
        }
    }
}

fn tmp_path(path: &str) -> String<Comp> {
    format_in("{path}.tmp{}", std::process::id(), Comp {})
}

// ---- Eviction ----

// The directory's packs (g-*.pack): when they pass the limit, the least
// recently used go.
fn evict(pcx: &Ctx<Comp>) {
    let dir = dir_of(pcx.pack_path.as_str());
    let mut limit = LIMIT;
    if let Ok(env) = std::env::var_in("VOLE_CACHE_LIMIT", Comp {}) {
        let mut mb: i64 = 0;
        for &c in env.as_bytes().iter() {
            if c < b'0' || c > b'9' {
                break;
            }
            mb = mb * 10 + (c - b'0') as i64;
        }
        limit = mb * 1024 * 1024;
    }
    let entries = match std::fs::read_dir(dir) {
        Ok(d) => d,
        Err(_) => return,
    };
    let mut names: Vec<String<Comp>, Comp> = Vec::new_in(Comp {});
    let mut sizes: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut times: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut total: i64 = 0;
    for ent in entries {
        let ent = match ent {
            Ok(e) => e,
            Err(_) => break,
        };
        if !is_pack_name(ent.file_name()) {
            continue;
        }
        let mut f = match File::open(ent.path()) {
            Ok(f) => f,
            Err(_) => continue,
        };
        let size = match f.metadata() {
            Ok(m) => m.len() as i64,
            Err(_) => 0,
        };
        let mut head = [0u8; 64];
        let whole = f.read_exact(&mut head).is_ok();
        names.push(String::from_in(ent.path(), Comp {}));
        sizes.push(size);
        times.push(if whole && word(&head, 0) == MAGIC { word(&head, 6) } else { 0 });
        total += size;
    }
    while total > limit && names.len() > 0 {
        let mut old: usize = 0;
        for i in 1..names.len() {
            if times[i] < times[old] {
                old = i;
            }
        }
        if !same_path(names[old].as_str(), pcx.pack_path.as_str()) {
            let _ = std::fs::remove_file(names[old].as_str());
        }
        total -= sizes[old];
        names.swap_remove(old);
        sizes.swap_remove(old);
        times.swap_remove(old);
    }
}

// Where a directory entry's name is in struct dirent: after d_ino,
// d_seekoff, d_reclen, d_namlen and d_type on macOS (64-bit inodes,
// AArch64; x86_64's readdir has the old layout), after d_ino, d_off,
// d_reclen and d_type on Linux (glibc).
pub fn name_offset() -> i64 {
    let host = host_target();
    if host == T_AARCH64_MACOS { 21 } else if host == T_X86_64_MACOS { 8 } else { 19 }
}

// g-, 16 digits, .pack
fn is_pack_name(name: &str) -> bool {
    name.len() == 2 + 16 + 5 && name.starts_with("g-") && name.ends_with(".pack")
}

// The directory of a path: what is before its last '/' ("." without one,
// "/" for a file of the root).
fn dir_of(path: &str) -> &str {
    match path.rfind('/') {
        None => ".",
        Some(0) => "/",
        Some(k) => &path[..k],
    }
}

// Whether two paths of the same directory name the same file (by name:
// a pack's name is 23 bytes).
fn same_path(a: &str, b: &str) -> bool {
    let x = a.as_bytes();
    let y = b.as_bytes();
    x.len() >= 23 && y.len() >= 23 && x[x.len() - 23..] == y[y.len() - 23..]
}
