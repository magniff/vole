// (0.18.1) The code cache's file (back/codecache): one pack per program,
// target and options, target/volec-cache/g-KEY.pack (where the tools'
// cache is), KEY a hash of the root as given, the current directory, the
// target, the options and the compiler's executable.
//
// A pack is 8-byte words: a header (MAGIC, VERSION, the compiler's hash,
// the options' hash, the file's length, the entries, when it was last
// used, 0), then the entries, each a word of its body's length, its key
// (two words), its age (builds since one used it), its body's hash, and
// the body (padded to a word). It is read whole (mapped), checked, and
// indexed by key; a body is checked against its hash when its entry is
// used, and a damaged one is a miss.
//
// A build that made entries writes a new pack, renamed over the old one
// (a reader has the old one or the new one, whole): the entries it used,
// the ones it made, and the others for MAX_AGE builds, while the pack
// stays under twice what the build used. Then, when the directory's packs
// pass LIMIT, the least recently used are deleted.

use crate::host_target;
use crate::back::codecache::hash::hash_bytes;
use crate::back::codecache::snapshot::Reader;
use crate::base::{alloc_array, alloc_zeroed, free, getenv, memcpy, strlen};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{T_AARCH64_MACOS, T_X86_64_MACOS};

extern "C" {
    fn open(path: *mut u8, flags: i32) -> i32;
    fn close(fd: i32) -> i32;
    fn lseek(fd: i32, offset: i64, whence: i32) -> i64;
    fn pwrite(fd: i32, buf: *mut u8, n: u64, offset: i64) -> i64;
    fn read(fd: i32, buf: *mut u8, n: u64) -> i64;
    fn mmap(addr: *mut u8, len: u64, prot: i32, flags: i32, fd: i32, offset: i64) -> *mut u8;
    fn time(t: *mut i64) -> i64;
    fn opendir(path: *mut u8) -> *mut u8;
    fn readdir(dir: *mut u8) -> *mut u8;
    fn closedir(dir: *mut u8) -> i32;
    fn unlink(path: *mut u8) -> i32;
    fn rename(from: *mut u8, to: *mut u8) -> i32;
    fn fopen(path: *mut u8, mode: *mut u8) -> *mut u8;
    fn fwrite(buf: *mut u8, size: u64, count: u64, file: *mut u8) -> u64;
    fn fclose(file: *mut u8) -> i32;
    fn getpid() -> i32;
}

// "tachyong", and the version of the format (and of what the keys hold).
const MAGIC: i64 = 8174034211981648231;
pub const VERSION: i64 = 1;
const HEADER_WORDS: i64 = 8;
const ENTRY_WORDS: i64 = 5;
// Builds an entry no build used is kept for.
const MAX_AGE: i64 = 3;
// The directory's packs, at most (bytes; VOLE_CACHE_LIMIT in MB).
const LIMIT: i64 = 1024 * 1024 * 1024;

// Per entry read: whether this build used it (its own task writes it).
static mut USED: *mut bool = 0 as *mut bool;

// The entries this build made: per slot (middle::parallel's tasks own
// theirs), its body and key.
#[derive(Clone, Copy)] pub struct NewEntry { body: *mut u8, len: i64, a: u64, b: u64 }
static mut NEW: *mut NewEntry = 0 as *mut NewEntry;

// ---- Reading ----

// Reads the pack at `path` (made by compiler `ident` for options
// `options`), if there is a whole one; `slots` entries may be made.
pub fn pack_load(path: *mut u8, ident: i64, options: i64, slots: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.pack_path = path;
        pcx.pack_ident = ident;
        pcx.options = options;
        pcx.new_slots = slots;
        set_new(alloc_zeroed((slots + 1) * size_of(NewEntry)) as *mut NewEntry);
        let fd = open(path, 0);
        if fd < 0 {
            return;
        }
        let size = lseek(fd, 0, 2);
        if size < HEADER_WORDS * 8 || size % 8 != 0 {
            close(fd);
            return;
        }
        // (PROT_READ, MAP_PRIVATE)
        let p = mmap(0 as *mut u8, size as u64, 1, 2, fd, 0);
        close(fd);
        if p == 0 as *mut u8 || p as i64 == -1 {
            return;
        }
        let w = p as *mut i64;
        if (*w.add(0)) != MAGIC || (*w.add(1)) != VERSION || (*w.add(2)) != ident || (*w.add(3)) != options || (*w.add(4)) != size {
            return;
        }
        let n = (*w.add(5));
        if n < 0 || n > size / (ENTRY_WORDS * 8) {
            return;
        }
        let at = alloc_array::<i64>(n + 1);
        let words = size / 8;
        let mut k = HEADER_WORDS;
        for e in 0..n {
            if k + ENTRY_WORDS > words {
                free(at as *mut u8);
                return;
            }
            let len = (*w.add(k as usize));
            if len < 0 || k + ENTRY_WORDS + (len + 7) / 8 > words {
                free(at as *mut u8);
                return;
            }
            (*at.add(e as usize)) = k;
            k += ENTRY_WORDS + (len + 7) / 8;
        }
        pcx.pack = w;
        pcx.pack_words = words;
        pcx.entry_at = at;
        pcx.entry_count = n;
        set_used(alloc_array::<bool>(n + 1));
        pcx.index_size = 64;
        while pcx.index_size < 2 * n + 2 {
            pcx.index_size *= 2;
        }
        pcx.index = alloc_array::<i64>(pcx.index_size);
        for e in 0..n {
            let mut s = ((*w.add(((*at.add(e as usize)) + 1) as usize)) as u64 >> 7) as i64 & (pcx.index_size - 1);
            while (*pcx.index.add(s as usize)) != 0 {
                s = (s + 1) & (pcx.index_size - 1);
            }
            (*pcx.index.add(s as usize)) = e + 1;
        }
    }
}

// The entry with key (a, b), or -1.
pub fn pack_find(a: u64, b: u64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.index_size == 0 {
            return -1;
        }
        let mut s = (a >> 7) as i64 & (pcx.index_size - 1);
        while (*pcx.index.add(s as usize)) != 0 {
            let e = (*pcx.index.add(s as usize)) - 1;
            let k = (*pcx.entry_at.add(e as usize));
            if (*pcx.pack.add((k + 1) as usize)) as u64 == a && (*pcx.pack.add((k + 2) as usize)) as u64 == b {
                return e;
            }
            s = (s + 1) & (pcx.index_size - 1);
        }
        -1
    }
}

// Entry e's body to read, if it is whole (its hash).
pub fn pack_body(e: i64, r: &mut Reader, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let k = (*pcx.entry_at.add(e as usize));
        let len = (*pcx.pack.add(k as usize));
        let p = (pcx.pack.add((k + ENTRY_WORDS) as usize)) as *mut u8;
        if hash_bytes(p, len) as i64 != (*pcx.pack.add((k + 4) as usize)) {
            return false;
        }
        r.p = p;
        r.at = 0;
        r.end = len;
        r.bad = false;
        true
    }
}

// Entry e's body to read, checked already (pack_body).
pub fn pack_body_at(e: i64, r: &mut Reader, pcx: &Ctx<Comp>) {
    unsafe {
        let k = (*pcx.entry_at.add(e as usize));
        r.p = (pcx.pack.add((k + ENTRY_WORDS) as usize)) as *mut u8;
        r.at = 0;
        r.end = (*pcx.pack.add(k as usize));
        r.bad = false;
    }
}

// Entry e was used (by the task that owns its key).
pub fn pack_used(e: i64) {
    unsafe { (*get_used().add(e as usize)) = true; }
}

// A new entry for slot s (its task's own).
pub fn pack_new(s: i64, a: u64, b: u64, body: *mut u8, len: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if s < 0 || s >= pcx.new_slots {
            free(body);
            return;
        }
        free((*get_new().add(s as usize)).body);
        (*get_new().add(s as usize)) = NewEntry { body, len, a, b };
    }
}

// ---- Writing ----

// What the build would write: whether anything changed (new entries, or
// read ones not used).
pub fn pack_changed(pcx: &Ctx<Comp>) -> bool {
    unsafe {
        for s in 0..pcx.new_slots {
            if (*get_new().add(s as usize)).body != 0 as *mut u8 {
                return true;
            }
        }
        for e in 0..pcx.entry_count {
            if !(*get_used().add(e as usize)) {
                return true;
            }
        }
        false
    }
}

fn put_word(f: *mut u8, v: i64) {
    unsafe {
        let mut w: [i64; 1] = [v];
        fwrite((&raw mut w[0]) as *mut u8, 8, 1, f);
    }
}

fn put_entry(f: *mut u8, body: *mut u8, len: i64, a: u64, b: u64, age: i64, hash: i64) {
    unsafe {
        put_word(f, len);
        put_word(f, a as i64);
        put_word(f, b as i64);
        put_word(f, age);
        put_word(f, hash);
        if len > 0 {
            fwrite(body, 1, len as u64, f);
        }
        let pad = (8 - len % 8) % 8;
        let zero: [i64; 1] = [0i64];
        if pad > 0 {
            fwrite((&raw const zero[0]) as *mut u8, 1, pad as u64, f);
        }
    }
}

fn entry_bytes(len: i64) -> i64 {
    ENTRY_WORDS * 8 + (len + 7) / 8 * 8
}

// Writes the new pack (main thread, or the copy of the process that
// writes it): the entries used and made, then the others young enough
// while the pack stays under twice the used ones.
pub fn pack_save(pcx: &Ctx<Comp>) {
    unsafe {
        let mut used_bytes: i64 = 0;
        let mut count: i64 = 0;
        for s in 0..pcx.new_slots {
            if (*get_new().add(s as usize)).body != 0 as *mut u8 {
                used_bytes += entry_bytes((*get_new().add(s as usize)).len);
                count += 1;
            }
        }
        for e in 0..pcx.entry_count {
            if (*get_used().add(e as usize)) {
                used_bytes += entry_bytes((*pcx.pack.add((*pcx.entry_at.add(e as usize)) as usize)));
                count += 1;
            }
        }
        // The others, youngest first, while they fit.
        let room: i64 = if used_bytes < 16 * 1024 * 1024 { 32 * 1024 * 1024 } else { 2 * used_bytes };
        let keep = alloc_array::<bool>(pcx.entry_count + 1);
        let mut total = used_bytes;
        for age in 0..MAX_AGE {
            for e in 0..pcx.entry_count {
                let k = (*pcx.entry_at.add(e as usize));
                if !(*get_used().add(e as usize)) && (*pcx.pack.add((k + 3) as usize)) == age && total + entry_bytes((*pcx.pack.add(k as usize))) <= room {
                    (*keep.add(e as usize)) = true;
                    total += entry_bytes((*pcx.pack.add(k as usize)));
                    count += 1;
                }
            }
        }
        let tmp = tmp_path(pcx.pack_path);
        let f = fopen(tmp, c"wb");
        if f == 0 as *mut u8 {
            return;
        }
        put_word(f, MAGIC);
        put_word(f, VERSION);
        put_word(f, pcx.pack_ident);
        put_word(f, pcx.options);
        put_word(f, HEADER_WORDS * 8 + total);
        put_word(f, count);
        put_word(f, time(0 as *mut i64));
        put_word(f, 0);
        for s in 0..pcx.new_slots {
            let n = (*get_new().add(s as usize));
            if n.body != 0 as *mut u8 {
                put_entry(f, n.body, n.len, n.a, n.b, 0, hash_bytes(n.body, n.len) as i64);
            }
        }
        for e in 0..pcx.entry_count {
            let k = (*pcx.entry_at.add(e as usize));
            if (*get_used().add(e as usize)) || (*keep.add(e as usize)) {
                put_entry(f, (pcx.pack.add((k + ENTRY_WORDS) as usize)) as *mut u8, (*pcx.pack.add(k as usize)),
                    (*pcx.pack.add((k + 1) as usize)) as u64, (*pcx.pack.add((k + 2) as usize)) as u64,
                    if (*get_used().add(e as usize)) { 0 } else { (*pcx.pack.add((k + 3) as usize)) + 1 }, (*pcx.pack.add((k + 4) as usize)));
            }
        }
        if fclose(f) != 0 || rename(tmp, pcx.pack_path) != 0 {
            unlink(tmp);
            return;
        }
        evict(pcx);
    }
}

// The pack was all used and nothing was made: its time of last use.
pub fn pack_touch(pcx: &Ctx<Comp>) {
    unsafe {
        if pcx.pack == 0 as *mut i64 {
            return;
        }
        let fd = open(pcx.pack_path, 1);
        if fd >= 0 {
            let mut now: [i64; 1] = [time(0 as *mut i64)];
            pwrite(fd, (&raw mut now[0]) as *mut u8, 8, 48);
            close(fd);
        }
    }
}

fn tmp_path(path: *mut u8) -> *mut u8 {
    unsafe {
        let n = strlen(path) as i64;
        let p = alloc_zeroed(n + 32);
        memcpy(p, path, n as u64);
        let mut k = n;
        let tail = c".tmp";
        for i in 0..4 {
            (*p.add(k as usize)) = (*tail.add(i as usize));
            k += 1;
        }
        let mut pid = getpid() as i64;
        let mut digits: [u8; 20] = [0; 20];
        let mut d: i64 = 0;
        while pid > 0 || d == 0 {
            digits[d as usize] = (b'0' + (pid % 10) as u8) as u8;
            pid = pid / 10;
            d += 1;
        }
        while d > 0 {
            d -= 1;
            (*p.add(k as usize)) = digits[d as usize];
            k += 1;
        }
        p
    }
}

// ---- Eviction ----

// The directory's packs (g-*.pack): when they pass the limit, the least
// recently used go.
fn evict(pcx: &Ctx<Comp>) {
    unsafe {
        let dir = dir_of(pcx.pack_path);
        let mut limit = LIMIT;
        let env = getenv(c"VOLE_CACHE_LIMIT");
        if env != 0 as *mut u8 {
            let mut mb: i64 = 0;
            let mut i: i64 = 0;
            while (*env.add(i as usize)) >= b'0' && (*env.add(i as usize)) <= b'9' {
                mb = mb * 10 + ((*env.add(i as usize)) - b'0') as i64;
                i += 1;
            }
            limit = mb * 1024 * 1024;
        }
        let d = opendir(dir);
        if d == 0 as *mut u8 {
            return;
        }
        let at = name_offset();
        let mut names = 0 as *mut *mut u8;
        let mut sizes = 0 as *mut i64;
        let mut times = 0 as *mut i64;
        let mut n: i64 = 0;
        let mut cap: i64 = 0;
        let mut total: i64 = 0;
        while true {
            let ent = readdir(d);
            if ent == 0 as *mut u8 {
                break;
            }
            let name = ent.add(at as usize);
            if !is_pack_name(name) {
                continue;
            }
            let path = join_path(dir, name);
            let fd = open(path, 0);
            if fd < 0 {
                free(path);
                continue;
            }
            let size = lseek(fd, 0, 2);
            let mut head: [i64; 8] = [0i64; 8];
            lseek(fd, 0, 0);
            let got = read(fd, (&raw mut head[0]) as *mut u8, 64);
            close(fd);
            if n == cap {
                cap = cap * 2 + 16;
                let nn = alloc_array::<*mut u8>(cap);
                let ns = alloc_array::<i64>(cap);
                let nt = alloc_array::<i64>(cap);
                for i in 0..n {
                    (*nn.add(i as usize)) = (*names.add(i as usize));
                    (*ns.add(i as usize)) = (*sizes.add(i as usize));
                    (*nt.add(i as usize)) = (*times.add(i as usize));
                }
                free(names as *mut u8);
                free(sizes as *mut u8);
                free(times as *mut u8);
                names = nn;
                sizes = ns;
                times = nt;
            }
            (*names.add(n as usize)) = path;
            (*sizes.add(n as usize)) = size;
            (*times.add(n as usize)) = if got == 64 && head[0] == MAGIC { head[6] } else { 0 };
            total += size;
            n += 1;
        }
        closedir(d);
        while total > limit && n > 0 {
            let mut old: i64 = 0;
            for i in 1..n {
                if (*times.add(i as usize)) < (*times.add(old as usize)) {
                    old = i;
                }
            }
            if !same_path((*names.add(old as usize)), pcx.pack_path) {
                unlink((*names.add(old as usize)));
            }
            total -= (*sizes.add(old as usize));
            (*names.add(old as usize)) = (*names.add((n - 1) as usize));
            (*sizes.add(old as usize)) = (*sizes.add((n - 1) as usize));
            (*times.add(old as usize)) = (*times.add((n - 1) as usize));
            n -= 1;
        }
    }
}

// Where a directory entry's name is in struct dirent: after d_ino,
// d_seekoff, d_reclen, d_namlen and d_type on macOS (64-bit inodes,
// AArch64; x86_64's readdir has the old layout), after d_ino, d_off,
// d_reclen and d_type on Linux (glibc).
fn name_offset() -> i64 {
    let host = host_target();
    if host == T_AARCH64_MACOS { 21 } else if host == T_X86_64_MACOS { 8 } else { 19 }
}

fn is_pack_name(name: *mut u8) -> bool {
    unsafe {
        let n = strlen(name) as i64;
        n == 2 + 16 + 5 && (*name.add(0)) == b'g' && (*name.add(1)) == b'-' && (*name.add((n - 5) as usize)) == b'.'
            && (*name.add((n - 4) as usize)) == b'p' && (*name.add((n - 3) as usize)) == b'a' && (*name.add((n - 2) as usize)) == b'c' && (*name.add((n - 1) as usize)) == b'k'
    }
}

fn dir_of(path: *mut u8) -> *mut u8 {
    unsafe {
        let n = strlen(path) as i64;
        let mut k = n;
        while k > 0 && (*path.add((k - 1) as usize)) != b'/' {
            k -= 1;
        }
        let p = alloc_zeroed(n + 2);
        if k == 0 {
            (*p.add(0)) = b'.';
            return p;
        }
        memcpy(p, path, (k - 1) as u64);
        if k == 1 {
            (*p.add(0)) = b'/';
        }
        p
    }
}

fn join_path(dir: *mut u8, name: *mut u8) -> *mut u8 {
    unsafe {
        let a = strlen(dir) as i64;
        let b = strlen(name) as i64;
        let p = alloc_zeroed(a + b + 2);
        memcpy(p, dir, a as u64);
        (*p.add(a as usize)) = b'/';
        memcpy(p.add((a + 1) as usize), name, b as u64);
        p
    }
}

// Whether two paths of the same directory name the same file (by name).
fn same_path(a: *mut u8, b: *mut u8) -> bool {
    unsafe {
        let na = strlen(a) as i64;
        let nb = strlen(b) as i64;
        if na < 23 || nb < 23 {
            return false;
        }
        for i in 0..23 {
            if (*a.add((na - 1 - i) as usize)) != (*b.add((nb - 1 - i) as usize)) {
                return false;
            }
        }
        true
    }
}

// (0.28.0) USED's accessors: every use of it is one of them.
fn get_used() -> *mut bool {
    // UNSAFE: the code cache pack's used marks, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: allocated by pack_load on the main thread; since 0.27.8 a
    // task marks USED[e] (mark_used, mark_used_fn) only when none of its
    // functions is fn_ambig; e is the entry whose 128-bit key (a, b) equals
    // the task's exactly (pack_find); a key mixes each member's fn_nameh,
    // and names_begin marks fn_ambig every function whose name key another
    // shares, so two marking tasks of one phase have distinct key inputs
    // (one IR function per front function: ir_new_func's only caller is
    // lower_body), and the same e only if two distinct inputs hash to the
    // same 128-bit key, which the cache already assumes never happens (such
    // a hit would also install the wrong code); phases are ordered by
    // MUTEX; pack_changed and pack_save read it on the main thread after
    // the phases
    unsafe { USED }
}

fn set_used(v: *mut bool) {
    // UNSAFE: the code cache pack's used marks, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: allocated by pack_load on the main thread; since 0.27.8 a
    // task marks USED[e] (mark_used, mark_used_fn) only when none of its
    // functions is fn_ambig; e is the entry whose 128-bit key (a, b) equals
    // the task's exactly (pack_find); a key mixes each member's fn_nameh,
    // and names_begin marks fn_ambig every function whose name key another
    // shares, so two marking tasks of one phase have distinct key inputs
    // (one IR function per front function: ir_new_func's only caller is
    // lower_body), and the same e only if two distinct inputs hash to the
    // same 128-bit key, which the cache already assumes never happens (such
    // a hit would also install the wrong code); phases are ordered by
    // MUTEX; pack_changed and pack_save read it on the main thread after
    // the phases
    unsafe {
        USED = v;
    }
}

// (0.28.0) NEW's accessors: every use of it is one of them.
fn get_new() -> *mut NewEntry {
    // UNSAFE: the code cache pack's new entries, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: allocated by pack_load on the main thread before the phases;
    // slot s = SLOTS_PER_FN * fi + kind - 1 written only by pack_new from
    // store, called by the task for fi and that kind (cc_component_end for
    // scc_order[start], cc_emit_end, cc_scalar_end), so each slot has one
    // writer; pack_changed/pack_save read it on the main thread after the
    // phases
    unsafe { NEW }
}

fn set_new(v: *mut NewEntry) {
    // UNSAFE: the code cache pack's new entries, a process-wide static mut;
    // Rust has no safe access to a static mut
    // SAFETY: allocated by pack_load on the main thread before the phases;
    // slot s = SLOTS_PER_FN * fi + kind - 1 written only by pack_new from
    // store, called by the task for fi and that kind (cc_component_end for
    // scc_order[start], cc_emit_end, cc_scalar_end), so each slot has one
    // writer; pack_changed/pack_save read it on the main thread after the
    // phases
    unsafe {
        NEW = v;
    }
}
