// (0.18.1) The code cache's hashes (back/codecache): a function's IR in
// canonical form, what its task reads of the program, the program's types
// and the options.
//
// An id that an edit elsewhere renumbers enters by what it names: a string
// by its bytes (and its place among the function's strings), a symbol by
// its text, a function by its symbol and what the tasks read of its
// declaration (fn_canon), constant data a task made by its owner's symbol,
// its place and its bytes. Types enter as their ids, and every type's
// description is in the program's hash (types_hash): an edit that adds a
// type misses every entry. The scratch fields of the IR (mark, aux) are
// left out: they hold what a pass left (stamps), which no later pass
// reads before writing.

use crate::base::{IntVec, alloc_array, free, getenv};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::FN_CLOSURE;
use crate::front::distinct::enum_niche;
use crate::front::effects::fn_effects;
use crate::front::lexer::{get_str_count, str_at};
use crate::front::modules::module_count;
use crate::front::types::{TyKind, get_enums, get_fields};
use crate::gen0::target::str_align;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, get_irfuncs, rtid_class};
use crate::middle::parallel::{OWNER_SHIFT, const_data_align, const_data_bytes};

// ---- Words ----

pub fn mix(h: u64, x: u64) -> u64 {
    let v = (h ^ x).wrapping_mul(0x9E3779B97F4A7C15u64);
    v ^ (v >> 29)
}

pub fn mix2(h: u64, x: u64) -> u64 {
    let v = (h ^ x).wrapping_mul(0xC2B2AE3D27D4EB4Fu64);
    v ^ (v >> 31)
}

// The hash of n bytes at p.
pub fn hash_bytes(p: *mut u8, n: i64) -> u64 {
    unsafe {
        let mut h: u64 = mix(0x6279746573, n as u64);
        let mut i: i64 = 0;
        while i + 8 <= n {
            let mut w: u64 = 0;
            for k in 0..8 {
                w = w | (((*p.add((i + k) as usize)) as u64) << (8 * k) as u64);
            }
            h = mix(h, w);
            i += 8;
        }
        let mut t: u64 = 0;
        while i < n {
            t = (t << 8) | (*p.add(i as usize)) as u64;
            i += 1;
        }
        mix(h, t)
    }
}

// A 128-bit hash, two lanes of 64.
#[derive(Clone, Copy)] pub struct H2 { pub a: u64, pub b: u64 }

pub fn h2_new(seed: u64) -> H2 {
    H2 { a: mix(0x68617368, seed), b: mix2(0x48415348, seed) }
}

pub fn h2_put(h: &mut H2, x: u64) {
    h.a = mix(h.a, x);
    h.b = mix2(h.b, x);
}

pub fn h2_puti(h: &mut H2, x: i64) {
    h2_put(h, x as u64);
}

// The hash of symbol s's text (s itself when it is none: -1).
pub fn sym_h(s: i64, pcx: &Ctx<Comp>) -> u64 {
    if s >= 0 && s < pcx.syms.len() as i64 { pcx.syms[s as usize].hash } else { s as u64 }
}

// ---- The program's names, hashed once ----

// A map key from a symbol hash (never 0).
fn name_key(h: i64) -> i64 {
    if h == 0 { 1 } else { h }
}

// What names function f (FNS) across builds: its symbol's hash, and its
// module's path (a C function declared in several modules has a
// declaration in each; the root module has none, -1).
pub fn fn_nameh(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let m = pcx.fns[f as usize].module;
    let mut h = sym_h(pcx.fns[f as usize].name, pcx);
    if m >= 0 && m < module_count(pcx) && pcx.modules[m as usize].key >= 0 {
        h = mix(h, sym_h(pcx.modules[m as usize].key, pcx));
    }
    h as i64
}

// The symbol hash of IR function g.
pub fn ir_nameh(g: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.fn_nameh.add((*get_irfuncs().add(g as usize)).f as usize)) }
}

// The FNS index of the function with symbol hash h, or -1 (none, or
// several).
pub fn fn_of_name(h: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = pcx.name_fn.get(name_key(h));
    if v > 0 { v - 1 } else { -1 }
}

// The IR function with symbol hash h, or -1 (none, or several).
pub fn ir_of_name(h: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = pcx.name_ir.get(name_key(h));
    if v > 0 { v - 1 } else { -1 }
}

// The tables above, for the program as lowered (main thread, once).
pub fn names_begin(moves: IntVec, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.canon_count = pcx.fns.len() as i64;
        pcx.fn_nameh = alloc_array::<i64>(pcx.fns.len() as i64 + 1);
        pcx.fn_canon = alloc_array::<i64>(pcx.fns.len() as i64 + 1);
        pcx.fn_ambig = alloc_array::<bool>(pcx.fns.len() as i64 + 1);
        for f in 0..pcx.fns.len() as i64 {
            (*pcx.fn_nameh.add(f as usize)) = fn_nameh(f, pcx);
            let k = name_key((*pcx.fn_nameh.add(f as usize)));
            let was = pcx.name_fn.get(k);
            if was == 0 {
                pcx.name_fn.put(k, f + 1);
            } else {
                pcx.name_fn.put(k, -1);
                if was > 0 {
                    (*pcx.fn_ambig.add((was - 1) as usize)) = true;
                }
                (*pcx.fn_ambig.add(f as usize)) = true;
            }
        }
        for f in 0..pcx.fns.len() as i64 {
            (*pcx.fn_canon.add(f as usize)) = fn_canon(f, pcx) as i64;
            if (*pcx.fn_ambig.add(f as usize)) && getenv(c"VOLE_CACHE_CHECK") != 0 as *mut u8 {
                eprintln(
                    "code cache check: two functions are {} ({f})",
                    str::from_utf8(crate::base::cstr(crate::base::sym_name(pcx.fns[f as usize].name,
                        pcx))).unwrap());
            }
        }
        for g in 0..pcx.irfunc_count {
            let k = name_key((*pcx.fn_nameh.add((*get_irfuncs().add(g as usize)).f as usize)));
            let v: i64 = if pcx.name_ir.get(k) == 0 { g + 1 } else { -1 };
            pcx.name_ir.put(k, v);
        }
        pcx.fn_moves = alloc_array::<i64>(pcx.irfunc_count + 1);
        let mut i: i64 = 0;
        while i + 1 < moves.len() as i64 {
            let fi = (moves[i as usize]);
            if fi >= 0 && fi < pcx.irfunc_count {
                (*pcx.fn_moves.add(fi as usize)) = mix(mix((*pcx.fn_moves.add(fi as usize)) as u64,
                    0x6d6f7665),
                    (moves[(i + 1) as usize]) as u64)
                    as i64;
            }
            i += 2;
        }
        strings_begin(pcx);
    }
}

// STR_H for every string made so far (main thread, between phases: the
// strings grow only then).
pub fn strings_begin(pcx: &mut Ctx<Comp>) {
    unsafe {
        if get_str_count() > pcx.str_h_cap {
            let cap = get_str_count() + get_str_count() / 2 + 64;
            let n = alloc_array::<i64>(cap);
            for i in 0..pcx.str_h_count {
                (*n.add(i as usize)) = (*pcx.str_h.add(i as usize));
            }
            free(pcx.str_h as *mut u8);
            pcx.str_h = n;
            pcx.str_h_cap = cap;
        }
        while pcx.str_h_count < get_str_count() {
            let s = str_at(pcx.str_h_count);
            (*pcx.str_h.add(pcx.str_h_count as usize)) = mix(hash_bytes(s.ptr, s.len() as i64),
                str_align(pcx.str_h_count) as u64)
                as i64;
            pcx.str_h_count += 1;
        }
    }
}

// What the tasks read of function f's declaration (FNS index), hashed: its
// symbol, linkage, signature, attributes, effects, whether it is a
// closure's, a C library name the program links, and whether it has IR.
pub fn fn_canon(f: i64, pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        let fnf = pcx.fns[f as usize];
        let mut h: u64 = mix(0x666e, fn_nameh(f, pcx) as u64);
        let flags = (if fnf.is_extern { 1 } else { 0 }) | (if fnf.export { 2 } else { 0 })
            | (if fnf.variadic { 4 } else { 0 }) | (if fnf.effect_decl != 0 { 8 } else { 0 })
            | (if fnf.views_decl != 0 { 16 } else { 0 })
            | (if fnf.node != 0 && (pcx.nodes[fnf.node as usize].p & FN_CLOSURE) != 0 { 32 }
                else { 0 })
            | (if pcx.link_names.get(fnf.name + 1) > 0 { 64 } else { 0 })
            | (if pcx.fn_ir != 0 as *mut i64 && (*pcx.fn_ir.add(f as usize)) != 0 { 128 }
                else { 0 });
        h = mix(h, flags as u64);
        h = mix(h, fnf.ret as u64);
        h = mix(h, fnf.self_ty as u64);
        h = mix(h, fnf.attrs as u64);
        h = mix(h, fnf.param_count as u64);
        for i in 0..fnf.param_count {
            h = mix(h, (pcx.tlists[(fnf.params + i) as usize]) as u64);
        }
        let e = fn_effects(f, pcx);
        h = mix(h, e.bits as u64);
        mix(h, e.allocs as u64)
    }
}

// ---- The program's types ----

// Every type's description (its ids as they are, a struct or enum by its
// fields and variants, not its name; a distinct type by its name) and
// layout, and whether it is Freeze.
pub fn types_hash(pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        let mut h: u64 = mix(0x7479706573, pcx.types.len() as u64);
        for t in 0..pcx.types.len() as i64 {
            let ty = pcx.types[t as usize];
            let kind = ty.kind;
            h = mix(h, kind as i64 as u64);
            if kind == TyKind::Struct {
                h = mix(h, struct_hash(ty.a, pcx));
                h = mix(h, ty.b as u64);
            } else if kind == TyKind::Enum {
                h = mix(h, enum_hash(ty.a, pcx));
                h = mix(h, ty.b as u64);
            } else if kind == TyKind::Distinct {
                h = mix(h, ty.a as u64);
                h = mix(h, if ty.b > 0 { sym_h(pcx.nodes[ty.b as usize].a, pcx) } else { 0 });
            } else {
                h = mix(h, ty.a as u64);
                h = mix(h, ty.b as u64);
            }
            h = mix(h, ty.count as u64);
            if kind == TyKind::Tuple || kind == TyKind::Fn {
                for i in 0..ty.count {
                    h = mix(h, (pcx.tlists[(ty.list + i) as usize]) as u64);
                }
            }
            h = mix(h, ty.size as u64);
            h = mix(h, ty.align as u64);
            // (0.26.1) GVN keeps facts through a reference only to a Freeze
            // type, and a struct is hashed by its fields, not by whether it
            // is std's UnsafeCell.
            h = mix(h, if crate::front::cells::is_freeze(t, pcx) { 1 } else { 0 });
        }
        for i in 0..pcx.niche_aliases.len() as i64 {
            h = mix(h, (pcx.niche_aliases[i as usize]) as u64);
        }
        h
    }
}

fn struct_hash(s: i64, pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        // (not its name nor its symbol prefix: a closure's struct, and an
        // instance whose type arguments name a closure, are named by where
        // the closure is, which a line added above changes; the methods'
        // symbols are the functions')
        let st = pcx.structs[s as usize];
        let mut h: u64 = 0x737472;
        h = mix(h, st.field_count as u64);
        for i in 0..st.field_count {
            let fd = (*get_fields().add((st.fields + i) as usize));
            h = mix(h, sym_h(fd.name, pcx));
            h = mix(h, fd.ty as u64);
            h = mix(h, fd.offset as u64);
        }
        h = mix(h, st.layout_state as u64);
        h = mix(h, st.repr as u64);
        h = mix(h, st.align as u64);
        h = mix(h, st.generic as u64);
        h = mix(h, st.tmpl as u64);
        h = mix(h, st.targ_count as u64);
        for i in 0..st.targ_count {
            h = mix(h, (pcx.tlists[(st.targs + i) as usize]) as u64);
        }
        mix(h, if st.closure != 0 { 1 } else { 0 })
    }
}

fn enum_hash(e: i64, pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        let en = (*get_enums().add(e as usize));
        let mut h: u64 = 0x656e756d;
        h = mix(h, en.variant_count as u64);
        for i in 0..en.variant_count {
            let v = pcx.variants[(en.variants + i) as usize];
            h = mix(h, sym_h(v.name, pcx));
            h = mix(h, v.discr as u64);
            h = mix(h, v.field_count as u64);
            for k in 0..v.field_count {
                h = mix(h, (pcx.tlists[(v.fields + k) as usize]) as u64);
            }
            h = mix(h, v.shape as u64);
        }
        h = mix(h, en.tag as u64);
        h = mix(h, if en.has_fields { 1 } else { 0 });
        h = mix(h, en.layout_state as u64);
        h = mix(h, en.repr as u64);
        h = mix(h, en.payload as u64);
        h = mix(h, en.generic as u64);
        h = mix(h, en.tmpl as u64);
        h = mix(h, en.targ_count as u64);
        for i in 0..en.targ_count {
            h = mix(h, (pcx.tlists[(en.targs + i) as usize]) as u64);
        }
        mix(h, if e < pcx.enum_count && enum_niche(e, pcx) { 2 } else { 1 })
    }
}

// ---- A function's IR ----

// What a static's symbol names, for GADDR: its text, and the static's
// type and linkage.
pub fn static_canon(sym: i64, pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        let mut h: u64 = mix(0x737461, sym_h(sym, pcx));
        let st = (*pcx.sym_static.add(sym as usize)) - 1;
        if st >= 0 {
            h = mix(h, pcx.statics[st as usize].ty as u64);
            h = mix(h, pcx.statics[st as usize].linkage as u64);
            h = mix(h, if pcx.statics[st as usize].mutable { 1 } else { 0 });
        }
        h
    }
}

// Constant data a task made (a placeholder id < 0): its owner's symbol,
// its place, its bytes and alignment.
pub fn const_canon(id: i64, pcx: &Ctx<Comp>) -> u64 {
    let m = -id - 1;
    let owner = m >> OWNER_SHIFT;
    let k = m & ((1 << OWNER_SHIFT) - 1);
    let bytes = const_data_bytes(id);
    let mut h: u64 = mix(0x636f6e, ir_nameh(owner, pcx) as u64);
    h = mix(h, k as u64);
    h = mix(h, hash_bytes(bytes.ptr, bytes.len() as i64));
    mix(h, const_data_align(id) as u64)
}

// What function f (FNS) is, for a CALL or FADDR: its canonical hash, and
// its index when another function has its symbol.
fn fn_ref(h: &mut H2, f: i64, pcx: &Ctx<Comp>) {
    unsafe {
        h2_puti(h, (*pcx.fn_canon.add(f as usize)));
        if (*pcx.fn_ambig.add(f as usize)) {
            h2_puti(h, f);
        }
    }
}

// The hash of IR function fi's tables (current in cx) in canonical form,
// with `extra` mixed in first. Its strings (the distinct ids of its
// SADDRs of strings, in instruction order) are appended to `strs`; a
// string made after the last strings_begin poisons (false).
pub fn ir_hash(cx: &mut FnCtx<Comp>, fi: i64, extra: u64, strs: *mut IntVec, out: &mut H2,
    pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut ok = true;
        let mut h = h2_new(extra);
        let stamp = str_stamp(cx, pcx);
        let first = (*strs).len() as i64;
        let irf = (*get_irfuncs().add(fi as usize));
        h2_puti(&mut h, irf.entry);
        h2_puti(&mut h, irf.result_ptr);
        h2_puti(&mut h, irf.blocks.len() as i64);
        for i in 0..irf.blocks.len() as i64 {
            h2_puti(&mut h, (irf.blocks[i as usize]));
        }
        h2_puti(&mut h, irf.slots.len() as i64);
        for i in 0..irf.slots.len() as i64 {
            h2_puti(&mut h, (irf.slots[i as usize]));
        }
        h2_puti(&mut h, cx.inst_count);
        for i in 0..cx.inst_count {
            let v = (*cx.insts.add(i as usize));
            let op = v.op;
            h2_puti(&mut h, (op as i64) | ((v.cond as i64) << 8));
            h2_puti(&mut h, v.ty);
            h2_puti(&mut h, v.a);
            h2_puti(&mut h, v.b);
            h2_puti(&mut h, v.c);
            if op == Op::SAddr {
                if v.imm >= 0 {
                    if v.imm >= pcx.str_h_count {
                        ok = false;
                    } else {
                        let cc = cx.cc;
                        if (*(*cc).str_seen.add(v.imm as usize)) != stamp {
                            (*(*cc).str_seen.add(v.imm as usize)) = stamp;
                            (*(*cc).str_k.add(v.imm as usize)) = (*strs).len() as i64 - first;
                            (*strs).push(v.imm);
                        }
                        h2_puti(&mut h, (*(*cc).str_k.add(v.imm as usize)));
                        h2_puti(&mut h, (*pcx.str_h.add(v.imm as usize)));
                    }
                } else {
                    h2_put(&mut h, const_canon(v.imm, pcx));
                }
            } else if op == Op::GAddr {
                h2_put(&mut h, static_canon(v.imm, pcx));
            } else if op == Op::CallC {
                h2_put(&mut h, sym_h(v.imm, pcx));
            } else if op == Op::Call || op == Op::FAddr {
                fn_ref(&mut h, v.imm, pcx);
            } else if op == Op::RtId {
                // (a check's site or kind: its function and place, not the
                // front end's number, which the join replaces)
                h2_puti(&mut h, ir_nameh(v.imm >> 20, pcx));
                h2_puti(&mut h, v.imm & 1048575);
                h2_puti(&mut h, rtid_class(v.imm, pcx));
            } else {
                h2_puti(&mut h, v.imm);
            }
            h2_puti(&mut h, v.imm2);
            h2_puti(&mut h, v.args);
            h2_puti(&mut h, v.nargs);
            h2_puti(&mut h, v.block);
            h2_puti(&mut h, v.prev);
            h2_puti(&mut h, v.next);
            h2_puti(&mut h, v.repl);
            h2_puti(&mut h, v.scale);
        }
        h2_puti(&mut h, cx.block_count);
        for i in 0..cx.block_count {
            let b = (*cx.blocks.add(i as usize));
            h2_puti(&mut h, b.first);
            h2_puti(&mut h, b.last);
            h2_puti(&mut h, b.preds.len() as i64);
            for k in 0..b.preds.len() as i64 {
                h2_puti(&mut h, (b.preds[k as usize]));
            }
            h2_puti(&mut h,
                (b.term as i64) | (b.removed << 8) | (b.sealed << 16) | (b.novec << 24));
            h2_puti(&mut h, b.cond);
            h2_puti(&mut h, b.s0);
            h2_puti(&mut h, b.s1);
            h2_puti(&mut h, b.incomplete);
            h2_puti(&mut h, b.order);
            h2_puti(&mut h, b.idom);
            h2_puti(&mut h, b.loop_depth);
            h2_puti(&mut h, b.count);
            h2_puti(&mut h, b.cases);
            h2_puti(&mut h, b.ncases);
            h2_puti(&mut h, b.succs);
            h2_puti(&mut h, b.nsucc);
        }
        h2_puti(&mut h, cx.slot_count);
        for i in 0..cx.slot_count {
            let s = (*cx.slots.add(i as usize));
            h2_puti(&mut h, s.size);
            h2_puti(&mut h, s.align);
            h2_puti(&mut h, s.offset);
            h2_puti(&mut h, s.escapes);
            h2_puti(&mut h, s.ty);
        }
        hash_ints(&mut h, &mut cx.args);
        hash_ints(&mut h, &mut cx.argty);
        hash_ints(&mut h, &mut cx.swcases);
        hash_ints(&mut h, &mut cx.inst_loc);
        h2_puti(&mut h, (*pcx.fn_moves.add(fi as usize)));
        out.a = h.a;
        out.b = h.b;
        ok
    }
}

fn hash_ints(h: &mut H2, v: &mut IntVec) {
    unsafe {
        h2_puti(h, v.len() as i64);
        for i in 0..v.len() as i64 {
            h2_puti(h, (v[i as usize]));
        }
    }
}

// A new stamp for cx's string marks (sized to the strings).
fn str_stamp(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let cc = crate::back::codecache::cc_of(cx);
        if (*cc).str_cap < pcx.str_h_count {
            free((*cc).str_seen as *mut u8);
            free((*cc).str_k as *mut u8);
            (*cc).str_cap = pcx.str_h_count + pcx.str_h_count / 2 + 64;
            (*cc).str_seen = alloc_array::<i64>((*cc).str_cap);
            (*cc).str_k = alloc_array::<i64>((*cc).str_cap);
        }
        (*cc).str_stamp += 1;
        (*cc).str_stamp
    }
}
