// (0.18.1) The code cache's encoding (back/codecache): bytes of
// variable-length numbers, and a function's IR tables in them, every
// field as it is but the ids an edit elsewhere renumbers (a SADDR's
// string or constant, a GADDR's or CALLC's symbol, a CALL's or FADDR's
// function), which are indices into the entry's tables (Rel), mapped back
// to this compilation's ids when the entry is used.

use crate::base::{IntVec, alloc_array, alloc_zeroed, free, memcpy};
use crate::base::comp::Comp;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Block, Cond, IRTables, Inst, Op, Slot, Term, blocks_of, get_irfuncs};
use crate::middle::lower::ssa::HMap;

// ---- Bytes ----

#[derive(Clone, Copy)] pub struct ByteBuf { pub data: *mut u8, pub len: i64, cap: i64 }

pub fn bb_new() -> ByteBuf {
    ByteBuf { data: 0 as *mut u8, len: 0, cap: 0 }
}

pub fn bb_reserve(b: &mut ByteBuf, extra: i64) {
    unsafe {
        if b.len + extra <= b.cap {
            return;
        }
        let mut cap = b.cap * 2;
        if cap < b.len + extra {
            cap = b.len + extra;
        }
        if cap < 256 {
            cap = 256;
        }
        let n = alloc_zeroed(cap);
        if b.len > 0 {
            memcpy(n, b.data, b.len as u64);
        }
        free(b.data);
        b.data = n;
        b.cap = cap;
    }
}

pub fn put_u(b: &mut ByteBuf, x: u64) {
    unsafe {
        bb_reserve(b, 10);
        let mut v = x;
        let p = b.data;
        let mut n = b.len;
        while v >= 128 {
            (*p.add(n as usize)) = ((v & 127) | 128) as u8;
            v = v >> 7;
            n += 1;
        }
        (*p.add(n as usize)) = v as u8;
        b.len = n + 1;
    }
}

// A signed number (zigzag).
pub fn put_s(b: &mut ByteBuf, x: i64) {
    put_u(b, ((x << 1) ^ (x >> 63)) as u64);
}

pub fn put_bytes(b: &mut ByteBuf, p: *mut u8, n: i64) {
    unsafe {
        put_u(b, n as u64);
        bb_reserve(b, n);
        if n > 0 {
            memcpy(b.data.add(b.len as usize), p, n as u64);
        }
        b.len += n;
    }
}

// Bytes being read: `bad` once a read went past the end (every read
// after gives 0).
#[derive(Clone, Copy)] pub struct Reader {
    pub p: *mut u8, pub at: i64, pub end: i64, pub bad: bool,
}

pub fn get_u(r: &mut Reader) -> u64 {
    unsafe {
        let mut x: u64 = 0;
        let mut shift: u64 = 0;
        while r.at < r.end && shift < 64 {
            let c = (*r.p.add(r.at as usize)) as u64;
            r.at += 1;
            x = x | ((c & 127) << shift);
            if c < 128 {
                return x;
            }
            shift += 7;
        }
        r.bad = true;
        0
    }
}

pub fn get_s(r: &mut Reader) -> i64 {
    let u = get_u(r);
    ((u >> 1) as i64) ^ -((u & 1) as i64)
}

// A count of at most what is left (each item at least a byte).
pub fn get_count(r: &mut Reader) -> i64 {
    let n = get_u(r);
    if n > (r.end - r.at) as u64 {
        r.bad = true;
        return 0;
    }
    n as i64
}

// Bytes in place: their start (and *n their length).
pub fn get_bytes(r: &mut Reader, n: &mut i64) -> *mut u8 {
    unsafe {
        let len = get_count(r);
        let p = r.p.add(r.at as usize);
        r.at += len;
        *n = len;
        p
    }
}

// ---- The entry's tables ----

// The ids of an entry's outputs that are renumbered, each kind in a table
// of its own (the index + 1 of an id in its map): strings, by where they
// come from (`src` a function whose strings the task read, `k` the place
// among its strings); constant data, by placeholder; symbols; functions
// (FNS).
#[derive(Clone, Copy)] pub struct Rel {
    str_map: HMap, pub strs: IntVec,
    const_map: HMap, pub consts: IntVec,
    sym_map: HMap, pub syms: IntVec,
    fn_map: HMap, pub fns: IntVec,
    // (0.18.1) RTID values (middle::ir::ir_rtid's imm).
    rtid_map: HMap, pub rtids: IntVec,
    // A string id: (src << 32 | k) + 1, from the lists the task read.
    src_map: HMap,
    // Whether an output had an id none of the lists has.
    pub bad: bool,
}

pub fn rel_new() -> Rel {
    Rel {
        str_map: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        strs: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        const_map: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        consts: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        sym_map: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        syms: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        fn_map: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        fns: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        rtid_map: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        rtids: IntVec { data: 0 as *mut i64, count: 0, cap: 0 },
        src_map: HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 },
        bad: false,
    }
}

pub fn rel_clear(r: &mut Rel) {
    r.str_map.clear();
    r.strs.clear();
    r.const_map.clear();
    r.consts.clear();
    r.sym_map.clear();
    r.syms.clear();
    r.fn_map.clear();
    r.fns.clear();
    r.rtid_map.clear();
    r.rtids.clear();
    r.src_map.clear();
    r.bad = false;
}

// A map key from an id (never 0).
fn id_key(id: i64) -> i64 {
    (id << 1) | 1
}

// The strings of function `src` (as the task read them): string list[k]
// is (src, k), unless an earlier list has it.
pub fn rel_add_source(r: &mut Rel, src: i64, list: &[i64]) {
    for k in 0..list.len() as i64 {
        let key = id_key(list[k as usize]);
        if r.src_map.get(key) == 0 {
            r.src_map.put(key, ((src << 32) | k) + 1);
        }
    }
}

fn table_index(map: *mut HMap, list: *mut IntVec, id: i64) -> i64 {
    unsafe {
        let key = id_key(id);
        let i = (*map).get(key);
        if i > 0 {
            return i - 1;
        }
        (*list).push(id);
        (*map).put(key, (*list).len() as i64);
        (*list).len() as i64 - 1
    }
}

// A SADDR's id: (index << 1) | 1 for constant data a task made, index
// << 1 for a string.
pub fn rel_saddr(r: *mut Rel, id: i64) -> i64 {
    unsafe {
        if id < 0 {
            return (table_index(&mut (*r).const_map, &mut (*r).consts, id) << 1) | 1;
        }
        if (*r).src_map.get(id_key(id)) == 0 {
            (*r).bad = true;
        }
        table_index(&mut (*r).str_map, &mut (*r).strs, id) << 1
    }
}

pub fn rel_sym(r: &mut Rel, sym: i64) -> i64 {
    table_index(&mut r.sym_map, &mut r.syms, sym)
}

pub fn rel_fn(r: *mut Rel, f: i64) -> i64 {
    unsafe { table_index(&mut (*r).fn_map, &mut (*r).fns, f) }
}

pub fn rel_rtid(r: *mut Rel, imm: i64) -> i64 {
    unsafe { table_index(&mut (*r).rtid_map, &mut (*r).rtids, imm) }
}

// The string at table index i: (src << 32 | k).
pub fn rel_str_source(r: Rel, i: i64) -> i64 {
    r.src_map.get(id_key((r.strs[i as usize]))) - 1
}

// The tables mapped to this compilation's ids (the entry's, read).
#[derive(Clone, Copy)] pub struct Ids {
    pub strs: *mut i64, pub nstrs: i64, pub consts: *mut i64, pub nconsts: i64, pub syms: *mut i64,
    pub nsyms: i64,
    pub fns: *mut i64, pub nfns: i64, pub rtids: *mut i64, pub nrtids: i64,
}

pub fn ids_free(t: Ids) {
    unsafe {
        free(t.strs as *mut u8);
        free(t.consts as *mut u8);
        free(t.syms as *mut u8);
        free(t.fns as *mut u8);
        free(t.rtids as *mut u8);
    }
}

// SADDR's id from its index, or 0 with *bad set.
pub fn ids_saddr(t: Ids, x: i64, bad: &mut bool) -> i64 {
    unsafe {
        let i = x >> 1;
        if (x & 1) != 0 {
            if i < 0 || i >= t.nconsts {
                *bad = true;
                return 0;
            }
            return (*t.consts.add(i as usize));
        }
        if i < 0 || i >= t.nstrs {
            *bad = true;
            return 0;
        }
        (*t.strs.add(i as usize))
    }
}

pub fn ids_at(p: *mut i64, n: i64, i: i64, bad: &mut bool) -> i64 {
    unsafe {
        if i < 0 || i >= n {
            *bad = true;
            return 0;
        }
        (*p.add(i as usize))
    }
}

// ---- A function's IR ----

fn put_ref(b: &mut ByteBuf, at: i64, x: i64) {
    // (an instruction: 0 for none, else 1 + how far from `at`, zigzag)
    if x == 0 {
        put_u(b, 0);
    } else {
        let d = x - at;
        put_u(b, (((d << 1) ^ (d >> 63)) as u64) + 1);
    }
}

fn get_ref(r: &mut Reader, at: i64) -> i64 {
    let u = get_u(r);
    if u == 0 {
        return 0;
    }
    let z = u - 1;
    at + (((z >> 1) as i64) ^ -((z & 1) as i64))
}

fn put_ints(b: &mut ByteBuf, v: *mut IntVec) {
    unsafe {
        put_u(b, (*v).len() as i64 as u64);
        put_u(b, (*v).cap as u64);
        for i in 0..(*v).len() as i64 {
            put_s(b, ((*v)[i as usize]));
        }
    }
}

fn get_ints(r: &mut Reader) -> IntVec {
    let n = get_count(r);
    let cap = get_u(r) as i64;
    if cap < n || cap > n + n + 64 {
        r.bad = true;
        return IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    }
    let mut v = IntVec { data: 0 as *mut i64, count: n, cap: cap };
    if cap > 0 {
        v.data = alloc_array::<i64>(cap);
    }
    for i in 0..n {
        (v[i as usize]) = get_s(r);
    }
    v
}

// A block's predecessor list, in put_ints's form (count, capacity, items).
fn put_list(b: &mut ByteBuf, v: &Vec<i64, Comp>) {
    put_u(b, v.len() as u64);
    put_u(b, v.capacity() as u64);
    for i in 0..v.len() {
        put_s(b, v[i]);
    }
}

fn get_list(r: &mut Reader) -> Vec<i64, Comp> {
    let n = get_count(r);
    let cap = get_u(r) as i64;
    if cap < n || cap > n + n + 64 {
        r.bad = true;
        return Vec::new_in(Comp {});
    }
    let mut v = Vec::with_capacity_in(cap as usize, Comp {});
    for _ in 0..n {
        v.push(get_s(r));
    }
    v
}

// Writes IR function fi's tables (current in cx) and its IRFUNCS entry.
pub fn encode_ir(cx: &mut FnCtx<Comp>, fi: i64, b: &mut ByteBuf, rel: *mut Rel) {
    unsafe {
        let irf = (*get_irfuncs().add(fi as usize));
        put_s(b, irf.entry);
        put_s(b, irf.result_ptr);
        put_ints(b, &mut (*get_irfuncs().add(fi as usize)).blocks);
        put_ints(b, &mut (*get_irfuncs().add(fi as usize)).slots);
        put_u(b, cx.insts.len() as i64 as u64);
        put_u(b, cx.insts.capacity() as u64);
        for i in 0..cx.insts.len() as i64 {
            let v = (cx.insts[i as usize]);
            let op = v.op;
            put_u(b, ((op as i64) | ((v.cond as i64) << 8)) as u64);
            put_s(b, v.ty);
            put_ref(b, i, v.a);
            put_ref(b, i, v.b);
            put_ref(b, i, v.c);
            if op == Op::SAddr {
                put_s(b, rel_saddr(rel, v.imm));
            } else if op == Op::GAddr || op == Op::CallC {
                put_s(b, rel_sym(&mut *rel, v.imm));
            } else if op == Op::Call || op == Op::FAddr {
                put_s(b, rel_fn(rel, v.imm));
            } else if op == Op::RtId {
                put_s(b, rel_rtid(rel, v.imm));
            } else {
                put_s(b, v.imm);
            }
            put_s(b, v.imm2);
            put_s(b, v.args);
            put_s(b, v.nargs);
            put_s(b, v.block);
            put_ref(b, i, v.prev);
            put_ref(b, i, v.next);
            put_ref(b, i, v.repl);
            put_s(b, v.mark);
            put_s(b, v.aux);
            put_s(b, v.scale);
        }
        put_u(b, cx.blocks.len() as i64 as u64);
        put_u(b, cx.blocks.capacity() as u64);
        for i in 0..cx.blocks.len() as i64 {
            let k = &cx.blocks[i as usize];
            put_s(b, k.first);
            put_s(b, k.last);
            put_list(b, &cx.blocks[i as usize].preds);
            put_u(b, k.term as i64 as u64);
            put_s(b, k.cond);
            put_s(b, k.s0);
            put_s(b, k.s1);
            put_s(b, k.sealed);
            put_s(b, k.incomplete);
            // (its function: this one, or 0 for block 0)
            if k.func != fi && k.func != 0 {
                (*rel).bad = true;
            }
            put_s(b, if k.func == fi { -1 } else { k.func });
            put_s(b, k.removed);
            put_s(b, k.order);
            put_s(b, k.idom);
            put_s(b, k.mark);
            put_s(b, k.aux);
            put_s(b, k.loop_depth);
            put_s(b, k.novec);
            put_s(b, k.count);
            put_s(b, k.cases);
            put_s(b, k.ncases);
            put_s(b, k.succs);
            put_s(b, k.nsucc);
        }
        put_u(b, cx.slot_count as u64);
        put_u(b, cx.slot_cap as u64);
        for i in 0..cx.slot_count {
            let s = (*cx.slots.add(i as usize));
            put_s(b, s.size);
            put_s(b, s.align);
            put_s(b, s.offset);
            put_s(b, s.escapes);
            put_s(b, s.ty);
        }
        put_ints(b, &mut cx.args);
        put_ints(b, &mut cx.argty);
        put_ints(b, &mut cx.swcases);
        put_ints(b, &mut cx.inst_loc);
    }
}

// A function's IR read back (not yet installed).
#[derive(Clone, Copy)] pub struct IRCopy {
    pub entry: i64, pub result_ptr: i64, pub blocks: IntVec, pub slots: IntVec, pub t: IRTables,
}

fn sized(cap: i64, n: i64, r: &mut Reader) -> bool {
    if cap < n || cap > n + n + 64 {
        r.bad = true;
        return false;
    }
    true
}

// Reads a function's IR, for IR function fi, with the entry's ids mapped
// by `ids`; *bad when it does not read whole.
pub fn decode_ir(r: &mut Reader, fi: i64, ids: &mut Ids, out: *mut IRCopy) -> bool {
    unsafe {
        let mut bad = false;
        (*out).entry = get_s(r);
        (*out).result_ptr = get_s(r);
        (*out).blocks = get_ints(r);
        (*out).slots = get_ints(r);
        let n = get_count(r);
        let cap = get_u(r) as i64;
        if !sized(cap, n, r) || r.bad {
            return false;
        }
        let insts = alloc_array::<Inst>(if cap > 0 { cap } else { 1 });
        (*out).t.insts = insts;
        (*out).t.inst_count = n;
        // The block's size: insts_of makes a Vec of these parts.
        (*out).t.inst_cap = if cap > 0 { cap } else { 1 };
        for i in 0..n {
            let opc = get_u(r) as i64;
            let op = (opc & 255) as Op;
            (*insts.add(i as usize)).op = op;
            (*insts.add(i as usize)).cond = ((opc >> 8) & 255) as Cond;
            (*insts.add(i as usize)).ty = get_s(r);
            (*insts.add(i as usize)).a = get_ref(r, i);
            (*insts.add(i as usize)).b = get_ref(r, i);
            (*insts.add(i as usize)).c = get_ref(r, i);
            let imm = get_s(r);
            if op == Op::SAddr {
                (*insts.add(i as usize)).imm = ids_saddr(*ids, imm, &mut bad);
            } else if op == Op::GAddr || op == Op::CallC {
                (*insts.add(i as usize)).imm = ids_at(ids.syms, ids.nsyms, imm, &mut bad);
            } else if op == Op::Call || op == Op::FAddr {
                (*insts.add(i as usize)).imm = ids_at(ids.fns, ids.nfns, imm, &mut bad);
            } else if op == Op::RtId {
                (*insts.add(i as usize)).imm = ids_at(ids.rtids, ids.nrtids, imm, &mut bad);
            } else {
                (*insts.add(i as usize)).imm = imm;
            }
            (*insts.add(i as usize)).imm2 = get_s(r);
            (*insts.add(i as usize)).args = get_s(r);
            (*insts.add(i as usize)).nargs = get_s(r);
            (*insts.add(i as usize)).block = get_s(r);
            (*insts.add(i as usize)).prev = get_ref(r, i);
            (*insts.add(i as usize)).next = get_ref(r, i);
            (*insts.add(i as usize)).repl = get_ref(r, i);
            (*insts.add(i as usize)).mark = get_s(r);
            (*insts.add(i as usize)).aux = get_s(r);
            (*insts.add(i as usize)).scale = get_s(r);
        }
        let nb = get_count(r);
        let bcap = get_u(r) as i64;
        if !sized(bcap, nb, r) || r.bad {
            return false;
        }
        let blocks = alloc_array::<Block<Comp>>(if bcap > 0 { bcap } else { 1 });
        (*out).t.blocks = blocks as *mut u8;
        (*out).t.block_count = nb;
        (*out).t.block_cap = if bcap > 0 { bcap } else { 1 };
        for i in 0..nb {
            (*blocks.add(i as usize)).first = get_s(r);
            (*blocks.add(i as usize)).last = get_s(r);
            // The entry is fresh memory: the list is written, not assigned
            // (an assignment would drop what was there as a Vec).
            std::ptr::write(&mut (*blocks.add(i as usize)).preds, get_list(r));
            (*blocks.add(i as usize)).term = (get_u(r) as i64) as Term;
            (*blocks.add(i as usize)).cond = get_s(r);
            (*blocks.add(i as usize)).s0 = get_s(r);
            (*blocks.add(i as usize)).s1 = get_s(r);
            (*blocks.add(i as usize)).sealed = get_s(r);
            (*blocks.add(i as usize)).incomplete = get_s(r);
            let func = get_s(r);
            (*blocks.add(i as usize)).func = if func == -1 { fi } else { func };
            (*blocks.add(i as usize)).removed = get_s(r);
            (*blocks.add(i as usize)).order = get_s(r);
            (*blocks.add(i as usize)).idom = get_s(r);
            (*blocks.add(i as usize)).mark = get_s(r);
            (*blocks.add(i as usize)).aux = get_s(r);
            (*blocks.add(i as usize)).loop_depth = get_s(r);
            (*blocks.add(i as usize)).novec = get_s(r);
            (*blocks.add(i as usize)).count = get_s(r);
            (*blocks.add(i as usize)).cases = get_s(r);
            (*blocks.add(i as usize)).ncases = get_s(r);
            (*blocks.add(i as usize)).succs = get_s(r);
            (*blocks.add(i as usize)).nsucc = get_s(r);
        }
        let ns = get_count(r);
        let scap = get_u(r) as i64;
        if !sized(scap, ns, r) || r.bad {
            return false;
        }
        let slots = alloc_array::<Slot>(if scap > 0 { scap } else { 1 });
        (*out).t.slots = slots;
        (*out).t.slot_count = ns;
        (*out).t.slot_cap = scap;
        for i in 0..ns {
            (*slots.add(i as usize)).size = get_s(r);
            (*slots.add(i as usize)).align = get_s(r);
            (*slots.add(i as usize)).offset = get_s(r);
            (*slots.add(i as usize)).escapes = get_s(r);
            (*slots.add(i as usize)).ty = get_s(r);
        }
        (*out).t.args = get_ints(r);
        (*out).t.argty = get_ints(r);
        (*out).t.swcases = get_ints(r);
        (*out).t.inst_loc = get_ints(r);
        !bad && !r.bad && valid_copy(*out)
    }
}

// Whether the ids a read copy holds are within its tables (a damaged
// entry is a miss, not a crash later).
fn valid_copy(c: IRCopy) -> bool {
    unsafe {
        let n = c.t.inst_count;
        let nb = c.t.block_count;
        if n < 1 || nb < 1 || c.entry < 0 || c.entry >= nb || c.result_ptr < 0
            || c.result_ptr >= n {
            return false;
        }
        for i in 0..c.blocks.len() as i64 {
            let b = (c.blocks[i as usize]);
            if b < 0 || b >= nb {
                return false;
            }
        }
        for i in 0..n {
            let v = (*c.t.insts.add(i as usize));
            if v.a < 0 || v.a >= n || v.b < 0 || v.b >= n || v.c < 0 || v.c >= n || v.prev < 0
                || v.prev >= n || v.next < 0 || v.next >= n || v.repl < 0 || v.repl >= n
                || v.block < 0 || v.block >= nb {
                return false;
            }
        }
        for i in 0..nb {
            let b = &*(c.t.blocks as *mut Block<Comp>).add(i as usize);
            if b.first < 0 || b.first >= n || b.last < 0 || b.last >= n {
                return false;
            }
            for k in 0..b.preds.len() as i64 {
                if (b.preds[k as usize]) < 0 || (b.preds[k as usize]) >= nb {
                    return false;
                }
            }
        }
        true
    }
}

pub fn free_copy(c: *mut IRCopy) {
    unsafe {
        free((*c).blocks.data as *mut u8);
        free((*c).slots.data as *mut u8);
        // The blocks' lists go with the table.
        drop(blocks_of((*c).t.blocks as *mut Block<Comp>, (*c).t.block_count, (*c).t.block_cap));
        free((*c).t.insts as *mut u8);
        free((*c).t.slots as *mut u8);
        free((*c).t.args.data as *mut u8);
        free((*c).t.argty.data as *mut u8);
        free((*c).t.swcases.data as *mut u8);
        free((*c).t.inst_loc.data as *mut u8);
    }
}

// (testing, $VOLE_CACHE_CHECK) Where a read copy differs from IR
// function fi's tables (current in cx): 0 nowhere, else a code of the
// field (instruction fields 1.., block fields 100.., the rest 200..).
pub fn copy_differs(cx: &mut FnCtx<Comp>, fi: i64, c: &mut IRCopy) -> i64 {
    unsafe {
        let irf = (*get_irfuncs().add(fi as usize));
        if c.entry != irf.entry || c.result_ptr != irf.result_ptr {
            return 200;
        }
        if !same_ints(&mut c.blocks, &mut (*get_irfuncs().add(fi as usize)).blocks)
            || !same_ints(&mut c.slots, &mut (*get_irfuncs().add(fi as usize)).slots) {
            return 201;
        }
        let mut t = c.t;
        if t.inst_count != cx.insts.len() as i64 || t.block_count != cx.blocks.len() as i64
            || t.slot_count != cx.slot_count {
            return 202;
        }
        for i in 0..t.inst_count {
            let a = (*t.insts.add(i as usize));
            let b = (cx.insts[i as usize]);
            if a.op != b.op { return 1; }
            if a.cond != b.cond { return 2; }
            if a.ty != b.ty { return 3; }
            if a.a != b.a || a.b != b.b || a.c != b.c { return 4; }
            if a.imm != b.imm { return 5; }
            if a.imm2 != b.imm2 { return 6; }
            if a.args != b.args || a.nargs != b.nargs { return 7; }
            if a.block != b.block { return 8; }
            if a.prev != b.prev || a.next != b.next { return 9; }
            if a.repl != b.repl { return 10; }
            if a.mark != b.mark || a.aux != b.aux { return 11; }
            if a.scale != b.scale { return 12; }
        }
        for i in 0..t.block_count {
            let a = &*(t.blocks as *mut Block<Comp>).add(i as usize);
            let b = &cx.blocks[i as usize];
            if a.first != b.first || a.last != b.last { return 101; }
            if a.preds != b.preds { return 102; }
            if a.term != b.term || a.cond != b.cond || a.s0 != b.s0 || a.s1 != b.s1 { return 103; }
            if a.sealed != b.sealed || a.incomplete != b.incomplete || a.removed != b.removed {
                return 104;
            }
            if a.func != b.func { return 107 + 1000 * i + 1000000 * b.func; }
            if a.order != b.order || a.idom != b.idom || a.mark != b.mark || a.aux != b.aux
                || a.loop_depth != b.loop_depth { return 105; }
            if a.novec != b.novec || a.count != b.count || a.cases != b.cases
                || a.ncases != b.ncases || a.succs != b.succs || a.nsucc != b.nsucc { return 106; }
        }
        for i in 0..t.slot_count {
            let a = (*t.slots.add(i as usize));
            let b = (*cx.slots.add(i as usize));
            if a.size != b.size || a.align != b.align || a.offset != b.offset
                || a.escapes != b.escapes || a.ty != b.ty { return 203; }
        }
        if !same_ints(&mut t.args, &mut cx.args) { return 204; }
        if !same_ints(&mut t.argty, &mut cx.argty) { return 205; }
        if !same_ints(&mut t.swcases, &mut cx.swcases) { return 206; }
        if !same_ints(&mut t.inst_loc, &mut cx.inst_loc) { return 207; }
        0
    }
}

fn same_ints(a: *mut IntVec, b: *mut IntVec) -> bool {
    unsafe {
        if (*a).len() as i64 != (*b).len() as i64 {
            return false;
        }
        for i in 0..(*a).len() as i64 {
            if ((*a)[i as usize]) != ((*b)[i as usize]) {
                return false;
            }
        }
        true
    }
}
