// (0.18.1) The code cache's encoding (back/codecache): bytes of
// variable-length numbers, and a function's IR tables in them, every
// field as it is but the ids an edit elsewhere renumbers (a SADDR's
// string or constant, a GADDR's or CALLC's symbol, a CALL's or FADDR's
// function), which are indices into the entry's tables (Rel), mapped back
// to this compilation's ids when the entry is used.

use std::alloc::Allocator;

use crate::base::comp::Comp;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Block, Cond, Inst, Op, Slot, Term, fn_entry, fn_result_ptr};
use crate::middle::lower::ssa::HMap;

// ---- Bytes ----

// An entry's bytes being written are a `Vec<u8, Comp>`.

pub fn put_u(b: &mut Vec<u8, Comp>, x: u64) {
    let mut v = x;
    while v >= 128 {
        b.push(((v & 127) | 128) as u8);
        v = v >> 7;
    }
    b.push(v as u8);
}

// A signed number (zigzag).
pub fn put_s(b: &mut Vec<u8, Comp>, x: i64) {
    put_u(b, ((x << 1) ^ (x >> 63)) as u64);
}

pub fn put_bytes(b: &mut Vec<u8, Comp>, bytes: &[u8]) {
    put_u(b, bytes.len() as u64);
    b.extend_from_slice(bytes);
}

// Bytes being read: `bad` once a read went past the end (every read
// after gives 0).
pub struct Reader<'a> {
    pub b: &'a [u8], pub at: i64, pub bad: bool,
}

pub fn reader(b: &[u8]) -> Reader<'_> {
    Reader { b, at: 0, bad: false }
}

pub fn get_u(r: &mut Reader<'_>) -> u64 {
    let b = r.b;
    let mut at = r.at as usize;
    let mut x: u64 = 0;
    let mut shift: u64 = 0;
    while at < b.len() && shift < 64 {
        let c = b[at] as u64;
        at += 1;
        x = x | ((c & 127) << shift);
        if c < 128 {
            r.at = at as i64;
            return x;
        }
        shift += 7;
    }
    r.at = at as i64;
    r.bad = true;
    0
}

pub fn get_s(r: &mut Reader<'_>) -> i64 {
    let u = get_u(r);
    ((u >> 1) as i64) ^ -((u & 1) as i64)
}

// A count of at most what is left (each item at least a byte).
pub fn get_count(r: &mut Reader<'_>) -> i64 {
    let n = get_u(r);
    let left = r.b.len() as i64 - r.at;
    if left < 0 || n > left as u64 {
        r.bad = true;
        return 0;
    }
    n as i64
}

// Bytes in place (none once the reader is bad).
pub fn get_bytes<'a>(r: &mut Reader<'a>) -> &'a [u8] {
    let len = get_count(r);
    let b: &'a [u8] = r.b;
    if r.bad {
        return &b[0..0];
    }
    let from = r.at as usize;
    r.at += len;
    &b[from..from + len as usize]
}

// ---- The entry's tables ----

// The ids of an entry's outputs that are renumbered, each kind in a table
// of its own (the index + 1 of an id in its map): strings, by where they
// come from (`src` a function whose strings the task read, `k` the place
// among its strings); constant data, by placeholder; symbols; functions
// (FNS).
pub struct Rel<A: Allocator> {
    str_map: HMap, pub strs: Vec<i64, A>,
    const_map: HMap, pub consts: Vec<i64, A>,
    sym_map: HMap, pub syms: Vec<i64, A>,
    fn_map: HMap, pub fns: Vec<i64, A>,
    // (0.18.1) RTID values (middle::ir::ir_rtid's imm).
    rtid_map: HMap, pub rtids: Vec<i64, A>,
    // A string id: (src << 32 | k) + 1, from the lists the task read.
    src_map: HMap,
    // Whether an output had an id none of the lists has.
    pub bad: bool,
}

pub fn no_map() -> HMap {
    HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 }
}

pub fn rel_new() -> Rel<Comp> {
    Rel {
        str_map: no_map(),
        strs: Vec::new_in(Comp {}),
        const_map: no_map(),
        consts: Vec::new_in(Comp {}),
        sym_map: no_map(),
        syms: Vec::new_in(Comp {}),
        fn_map: no_map(),
        fns: Vec::new_in(Comp {}),
        rtid_map: no_map(),
        rtids: Vec::new_in(Comp {}),
        src_map: no_map(),
        bad: false,
    }
}

pub fn rel_clear(r: &mut Rel<Comp>) {
    r.str_map.clear();
    r.strs.clear();
    r.const_map.clear();
    r.consts.clear();
    r.sym_map.clear();
    r.syms.clear();
    r.fn_map.clear();
    r.fns.clear();
    r.rtid_map.clear();
    r.rtids.clear();
    r.src_map.clear();
    r.bad = false;
}

// A map key from an id (never 0).
fn id_key(id: i64) -> i64 {
    (id << 1) | 1
}

// The strings of function `src` (as the task read them): string list[k]
// is (src, k), unless an earlier list has it.
pub fn rel_add_source(r: &mut Rel<Comp>, src: i64, list: &[i64]) {
    for k in 0..list.len() as i64 {
        let key = id_key(list[k as usize]);
        if r.src_map.get(key) == 0 {
            r.src_map.put(key, ((src << 32) | k) + 1);
        }
    }
}

fn table_index(map: &mut HMap, list: &mut Vec<i64, Comp>, id: i64) -> i64 {
    let key = id_key(id);
    let i = map.get(key);
    if i > 0 {
        return i - 1;
    }
    list.push(id);
    map.put(key, list.len() as i64);
    list.len() as i64 - 1
}

// A SADDR's id: (index << 1) | 1 for constant data a task made, index
// << 1 for a string.
pub fn rel_saddr(r: &mut Rel<Comp>, id: i64) -> i64 {
    if id < 0 {
        return (table_index(&mut r.const_map, &mut r.consts, id) << 1) | 1;
    }
    if r.src_map.get(id_key(id)) == 0 {
        r.bad = true;
    }
    table_index(&mut r.str_map, &mut r.strs, id) << 1
}

pub fn rel_sym(r: &mut Rel<Comp>, sym: i64) -> i64 {
    table_index(&mut r.sym_map, &mut r.syms, sym)
}

pub fn rel_fn(r: &mut Rel<Comp>, f: i64) -> i64 {
    table_index(&mut r.fn_map, &mut r.fns, f)
}

pub fn rel_rtid(r: &mut Rel<Comp>, imm: i64) -> i64 {
    table_index(&mut r.rtid_map, &mut r.rtids, imm)
}

// The string at table index i: (src << 32 | k).
pub fn rel_str_source(r: &Rel<Comp>, i: i64) -> i64 {
    r.src_map.get(id_key(r.strs[i as usize])) - 1
}

// The tables mapped to this compilation's ids (the entry's, read).
pub struct Ids<A: Allocator> {
    pub strs: Vec<i64, A>, pub consts: Vec<i64, A>, pub syms: Vec<i64, A>, pub fns: Vec<i64, A>,
    pub rtids: Vec<i64, A>,
}

pub fn ids_new() -> Ids<Comp> {
    Ids {
        strs: Vec::new_in(Comp {}), consts: Vec::new_in(Comp {}), syms: Vec::new_in(Comp {}),
        fns: Vec::new_in(Comp {}), rtids: Vec::new_in(Comp {}),
    }
}

// SADDR's id from its index, or 0 with *bad set.
pub fn ids_saddr(t: &Ids<Comp>, x: i64, bad: &mut bool) -> i64 {
    let i = x >> 1;
    if (x & 1) != 0 {
        return ids_at(&t.consts, i, bad);
    }
    ids_at(&t.strs, i, bad)
}

pub fn ids_at(p: &[i64], i: i64, bad: &mut bool) -> i64 {
    if i < 0 || i >= p.len() as i64 {
        *bad = true;
        return 0;
    }
    p[i as usize]
}

// ---- A function's IR ----

fn put_ref(b: &mut Vec<u8, Comp>, at: i64, x: i64) {
    // (an instruction: 0 for none, else 1 + how far from `at`, zigzag)
    if x == 0 {
        put_u(b, 0);
    } else {
        let d = x - at;
        put_u(b, (((d << 1) ^ (d >> 63)) as u64) + 1);
    }
}

fn get_ref(r: &mut Reader<'_>, at: i64) -> i64 {
    let u = get_u(r);
    if u == 0 {
        return 0;
    }
    let z = u - 1;
    at + (((z >> 1) as i64) ^ -((z & 1) as i64))
}

fn put_ints(b: &mut Vec<u8, Comp>, v: &[i64], cap: usize) {
    put_u(b, v.len() as u64);
    put_u(b, cap as u64);
    for x in v.iter() {
        put_s(b, *x);
    }
}

// A list read back: its count, its capacity as written, its items.
fn get_list(r: &mut Reader<'_>) -> Vec<i64, Comp> {
    let n = get_count(r);
    let cap = get_u(r) as i64;
    if !sized(cap, n, r) {
        return Vec::new_in(Comp {});
    }
    let mut v = Vec::with_capacity_in(cap as usize, Comp {});
    for _ in 0..n {
        v.push(get_s(r));
    }
    v
}

// Writes IR function fi's tables (current in cx) and its IRFUNCS entry.
pub fn encode_ir(cx: &mut FnCtx<Comp>, fi: i64, b: &mut Vec<u8, Comp>, rel: &mut Rel<Comp>) {
    {
        put_s(b, fn_entry(cx, fi));
        put_s(b, fn_result_ptr(cx, fi));
        put_ints(b, cx.fn_blocks.as_slice(), cx.fn_blocks.capacity());
        put_ints(b, cx.fn_slots.as_slice(), cx.fn_slots.capacity());
        put_u(b, cx.insts.len() as i64 as u64);
        put_u(b, cx.insts.capacity() as u64);
        for i in 0..cx.insts.len() as i64 {
            let v = (cx.insts[i as usize]);
            let op = v.op;
            put_u(b, ((op as i64) | ((v.cond as i64) << 8)) as u64);
            put_s(b, v.ty);
            put_ref(b, i, v.a);
            put_ref(b, i, v.b);
            put_ref(b, i, v.c);
            if op == Op::SAddr {
                put_s(b, rel_saddr(rel, v.imm));
            } else if op == Op::GAddr || op == Op::CallC {
                put_s(b, rel_sym(rel, v.imm));
            } else if op == Op::Call || op == Op::FAddr {
                put_s(b, rel_fn(rel, v.imm));
            } else if op == Op::RtId {
                put_s(b, rel_rtid(rel, v.imm));
            } else {
                put_s(b, v.imm);
            }
            put_s(b, v.imm2);
            put_s(b, v.args);
            put_s(b, v.nargs);
            put_s(b, v.block);
            put_ref(b, i, v.prev);
            put_ref(b, i, v.next);
            put_ref(b, i, v.repl);
            put_s(b, v.mark);
            put_s(b, v.aux);
            put_s(b, v.scale);
        }
        put_u(b, cx.blocks.len() as i64 as u64);
        put_u(b, cx.blocks.capacity() as u64);
        for i in 0..cx.blocks.len() as i64 {
            let k = &cx.blocks[i as usize];
            put_s(b, k.first);
            put_s(b, k.last);
            put_ints(b, &cx.blocks[i as usize].preds, cx.blocks[i as usize].preds.capacity());
            put_u(b, k.term as i64 as u64);
            put_s(b, k.cond);
            put_s(b, k.s0);
            put_s(b, k.s1);
            put_s(b, k.sealed);
            put_s(b, k.incomplete);
            // (its function: this one, or 0 for block 0)
            if k.func != fi && k.func != 0 {
                rel.bad = true;
            }
            put_s(b, if k.func == fi { -1 } else { k.func });
            put_s(b, k.removed);
            put_s(b, k.order);
            put_s(b, k.idom);
            put_s(b, k.mark);
            put_s(b, k.aux);
            put_s(b, k.loop_depth);
            put_s(b, k.novec);
            put_s(b, k.count);
            put_s(b, k.cases);
            put_s(b, k.ncases);
            put_s(b, k.succs);
            put_s(b, k.nsucc);
        }
        put_u(b, cx.slots.len() as i64 as u64);
        put_u(b, cx.slots.capacity() as u64);
        for i in 0..cx.slots.len() as i64 {
            let s = (cx.slots[i as usize]);
            put_s(b, s.size);
            put_s(b, s.align);
            put_s(b, s.offset);
            put_s(b, s.escapes);
            put_s(b, s.ty);
        }
        put_ints(b, &cx.args, cx.args.capacity());
        put_ints(b, &cx.argty, cx.argty.capacity());
        put_ints(b, &cx.swcases, cx.swcases.capacity());
        put_ints(b, &cx.inst_loc, cx.inst_loc.capacity());
    }
}

// A function's IR read back (not yet installed): the tables a context
// holds for it, each with the capacity it had when the entry was made.
pub struct IRCopy<A: Allocator> {
    pub entry: i64, pub result_ptr: i64, pub fn_blocks: Vec<i64, A>, pub fn_slots: Vec<i64, A>,
    pub insts: Vec<Inst, A>, pub blocks: Vec<Block<A>, A>, pub slots: Vec<Slot, A>,
    pub args: Vec<i64, A>, pub argty: Vec<i64, A>, pub swcases: Vec<i64, A>,
    pub inst_loc: Vec<i64, A>,
}

fn sized(cap: i64, n: i64, r: &mut Reader<'_>) -> bool {
    if cap < n || cap > n + n + 64 {
        r.bad = true;
        return false;
    }
    true
}

// Reads a function's IR, for IR function fi, with the entry's ids mapped
// by `ids`; None when it does not read whole.
pub fn decode_ir(r: &mut Reader<'_>, fi: i64, ids: &Ids<Comp>) -> Option<IRCopy<Comp>> {
    let mut bad = false;
    let entry = get_s(r);
    let result_ptr = get_s(r);
    let fn_blocks = get_list(r);
    let fn_slots = get_list(r);
    let n = get_count(r);
    let cap = get_u(r) as i64;
    if !sized(cap, n, r) || r.bad {
        return None;
    }
    let mut insts: Vec<Inst, Comp> = Vec::with_capacity_in(cap as usize, Comp {});
    for i in 0..n {
        let opc = get_u(r) as i64;
        let op = (opc & 255) as Op;
        let cond = ((opc >> 8) & 255) as Cond;
        let ty = get_s(r);
        let a = get_ref(r, i);
        let b = get_ref(r, i);
        let c = get_ref(r, i);
        let raw = get_s(r);
        let imm = if op == Op::SAddr {
            ids_saddr(ids, raw, &mut bad)
        } else if op == Op::GAddr || op == Op::CallC {
            ids_at(&ids.syms, raw, &mut bad)
        } else if op == Op::Call || op == Op::FAddr {
            ids_at(&ids.fns, raw, &mut bad)
        } else if op == Op::RtId {
            ids_at(&ids.rtids, raw, &mut bad)
        } else {
            raw
        };
        let imm2 = get_s(r);
        let args = get_s(r);
        let nargs = get_s(r);
        let block = get_s(r);
        let prev = get_ref(r, i);
        let next = get_ref(r, i);
        let repl = get_ref(r, i);
        let mark = get_s(r);
        let aux = get_s(r);
        let scale = get_s(r);
        insts.push(Inst {
            op, cond, ty, a, b, c, imm, imm2, args, nargs, block, prev, next, repl, mark, aux,
            scale,
        });
    }
    let nb = get_count(r);
    let bcap = get_u(r) as i64;
    if !sized(bcap, nb, r) || r.bad {
        return None;
    }
    let mut blocks: Vec<Block<Comp>, Comp> = Vec::with_capacity_in(bcap as usize, Comp {});
    for i in 0..nb {
        let first = get_s(r);
        let last = get_s(r);
        let preds = get_list(r);
        let term = (get_u(r) as i64) as Term;
        let cond = get_s(r);
        let s0 = get_s(r);
        let s1 = get_s(r);
        let sealed = get_s(r);
        let incomplete = get_s(r);
        let func = get_s(r);
        let removed = get_s(r);
        let order = get_s(r);
        let idom = get_s(r);
        let mark = get_s(r);
        let aux = get_s(r);
        let loop_depth = get_s(r);
        let novec = get_s(r);
        let count = get_s(r);
        let cases = get_s(r);
        let ncases = get_s(r);
        let succs = get_s(r);
        let nsucc = get_s(r);
        blocks.push(Block {
            first, last, preds, term, cond, s0, s1, sealed, incomplete,
            func: if func == -1 { fi } else { func },
            removed, order, idom, mark, aux, loop_depth, novec, count, cases, ncases, succs,
            nsucc,
        });
    }
    let ns = get_count(r);
    let scap = get_u(r) as i64;
    if !sized(scap, ns, r) || r.bad {
        return None;
    }
    let mut slots: Vec<Slot, Comp> = Vec::with_capacity_in(scap as usize, Comp {});
    for i in 0..ns {
        let size = get_s(r);
        let align = get_s(r);
        let offset = get_s(r);
        let escapes = get_s(r);
        let ty = get_s(r);
        slots.push(Slot { size, align, offset, escapes, ty });
    }
    let args = get_list(r);
    let argty = get_list(r);
    let swcases = get_list(r);
    let inst_loc = get_list(r);
    let copy = IRCopy {
        entry, result_ptr, fn_blocks, fn_slots, insts, blocks, slots, args, argty, swcases,
        inst_loc,
    };
    if bad || r.bad || !valid_copy(&copy) {
        return None;
    }
    Some(copy)
}

// Whether the ids a read copy holds are within its tables (a damaged
// entry is a miss, not a crash later).
fn valid_copy(c: &IRCopy<Comp>) -> bool {
    let n = c.insts.len() as i64;
    let nb = c.blocks.len() as i64;
    if n < 1 || nb < 1 || c.entry < 0 || c.entry >= nb || c.result_ptr < 0 || c.result_ptr >= n {
        return false;
    }
    for &b in c.fn_blocks.iter() {
        if b < 0 || b >= nb {
            return false;
        }
    }
    for v in c.insts.iter() {
        if v.a < 0 || v.a >= n || v.b < 0 || v.b >= n || v.c < 0 || v.c >= n || v.prev < 0
            || v.prev >= n || v.next < 0 || v.next >= n || v.repl < 0 || v.repl >= n
            || v.block < 0 || v.block >= nb {
            return false;
        }
    }
    for b in c.blocks.iter() {
        if b.first < 0 || b.first >= n || b.last < 0 || b.last >= n {
            return false;
        }
        for &p in b.preds.iter() {
            if p < 0 || p >= nb {
                return false;
            }
        }
    }
    true
}

// (testing, $VOLE_CACHE_CHECK) Where a read copy differs from IR
// function fi's tables (current in cx): 0 nowhere, else a code of the
// field (instruction fields 1.., block fields 100.., the rest 200..).
pub fn copy_differs(cx: &mut FnCtx<Comp>, fi: i64, c: &IRCopy<Comp>) -> i64 {
    {
        if c.entry != fn_entry(cx, fi) || c.result_ptr != fn_result_ptr(cx, fi) {
            return 200;
        }
        if !same_ints(&c.fn_blocks, &cx.fn_blocks)
            || !same_ints(&c.fn_slots, &cx.fn_slots) {
            return 201;
        }
        if c.insts.len() != cx.insts.len() || c.blocks.len() != cx.blocks.len()
            || c.slots.len() != cx.slots.len() {
            return 202;
        }
        for i in 0..c.insts.len() as i64 {
            let a = c.insts[i as usize];
            let b = (cx.insts[i as usize]);
            if a.op != b.op { return 1; }
            if a.cond != b.cond { return 2; }
            if a.ty != b.ty { return 3; }
            if a.a != b.a || a.b != b.b || a.c != b.c { return 4; }
            if a.imm != b.imm { return 5; }
            if a.imm2 != b.imm2 { return 6; }
            if a.args != b.args || a.nargs != b.nargs { return 7; }
            if a.block != b.block { return 8; }
            if a.prev != b.prev || a.next != b.next { return 9; }
            if a.repl != b.repl { return 10; }
            if a.mark != b.mark || a.aux != b.aux { return 11; }
            if a.scale != b.scale { return 12; }
        }
        for i in 0..c.blocks.len() as i64 {
            let a = &c.blocks[i as usize];
            let b = &cx.blocks[i as usize];
            if a.first != b.first || a.last != b.last { return 101; }
            if a.preds != b.preds { return 102; }
            if a.term != b.term || a.cond != b.cond || a.s0 != b.s0 || a.s1 != b.s1 { return 103; }
            if a.sealed != b.sealed || a.incomplete != b.incomplete || a.removed != b.removed {
                return 104;
            }
            if a.func != b.func { return 107 + 1000 * i + 1000000 * b.func; }
            if a.order != b.order || a.idom != b.idom || a.mark != b.mark || a.aux != b.aux
                || a.loop_depth != b.loop_depth { return 105; }
            if a.novec != b.novec || a.count != b.count || a.cases != b.cases
                || a.ncases != b.ncases || a.succs != b.succs || a.nsucc != b.nsucc { return 106; }
        }
        for i in 0..c.slots.len() as i64 {
            let a = c.slots[i as usize];
            let b = (cx.slots[i as usize]);
            if a.size != b.size || a.align != b.align || a.offset != b.offset
                || a.escapes != b.escapes || a.ty != b.ty { return 203; }
        }
        if !same_ints(&c.args, &cx.args) { return 204; }
        if !same_ints(&c.argty, &cx.argty) { return 205; }
        if !same_ints(&c.swcases, &cx.swcases) { return 206; }
        if !same_ints(&c.inst_loc, &cx.inst_loc) { return 207; }
        0
    }
}

fn same_ints(a: &[i64], b: &[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}
