// Instructions (emit/mod.vl): the machine code of each IR instruction
// but calls: arithmetic, selects, vectors, loads and stores.

use crate::back::emit::arch::emit_intr;
use crate::back::emit::blocks::is_cmp_imm_operand;
use crate::back::emit::calls::emit_call_inst;
use crate::back::emit::machine::{
    m_cmp, m_conv, m_copy, m_div, m_float_op, m_int_op, m_int_op_imm, m_lea, m_load, m_store,
    m_unary, reg_move_temp, reg_sp,
};
use crate::back::emit::operands::{
    const_of, float_operand, int_operand, materialize, operand_reg, result_done, result_reg,
    use_any,
};
use crate::back::mc_arm64::atomic::{ma_atomic, ma_fence};
use crate::back::mc_arm64::ops::{
    ma_bits, ma_cmp_imm, ma_fmath, ma_madd, ma_mulh, ma_ovf, ma_ovf_op, ma_ovf_op_imm, ma_select,
    ma_shop, ma_ubfx, ovf_fusable,
};
use crate::back::mc_arm64::vector::{
    ma_vbin, ma_vcmp, ma_vext, ma_vins, ma_vmacw, ma_vneg, ma_vsel, ma_vsplat, ma_vsum,
};
use crate::back::mc_x86_64::atomic::{mx_atomic, mx_fence};
use crate::back::mc_x86_64::ops::{mx_cmp_imm, mx_mulh, mx_ovf, mx_select, mx_sqrt};
use crate::back::mc_x86_64::vector::{
    mx_vbin, mx_vcmp, mx_vext, mx_vins, mx_vneg, mx_vsel, mx_vsplat, mx_vsum,
};
use crate::back::regalloc::USE_NONE;
use crate::back::regalloc::locations::vloc;
use crate::back::regalloc::prepare::{is_fused_compare, is_zero_operand, use_kind};
use crate::base::{buf_len, die};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::is_float;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Op, ir_arg};
use crate::middle::ir::Op::{
    BNot, Cmp, Conv, Copy, Div, FMath, Lea, Load, LoadX, MAdd, MSub, MulH, Neg, Not, Rem, Select,
    ShOp, Slot, Store, StoreX, Ubfx, VBin, VCmp, VExt, VIns, VNeg, VSplat, VSum,
};

// ---- Instructions ----

pub fn emit_inst(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let op = (cx.insts[v as usize]).op;
    if op.is_remat() {
        let result_reg_v = result_reg(cx, v);
        materialize(cx, v, result_reg_v, pcx);
    } else if op.is_binary() {
        emit_binary(cx, v, pcx);
    } else if op == Neg || op == Not || op == BNot {
        let a = operand_reg(cx, (cx.insts[v as usize]).a);
        let r = result_reg(cx, v);
        m_unary(cx, op, (cx.insts[v as usize]).ty, r, a, pcx);
        result_done(cx, v, r, pcx);
    } else if op == Cmp && is_cmp_imm_operand(cx, v) {
        let ty = (cx.insts[v as usize]).imm2;
        let a = operand_reg(cx, (cx.insts[v as usize]).a);
        let r = result_reg(cx, v);
        if get_x86() {
            mx_cmp_imm(cx, (cx.insts[v as usize]).cond, ty, r, a,
                (cx.insts[(cx.insts[v as usize]).b as usize]).imm);
        } else {
            ma_cmp_imm(cx, (cx.insts[v as usize]).cond, ty, r, a,
                (cx.insts[(cx.insts[v as usize]).b as usize]).imm);
        }
        result_done(cx, v, r, pcx);
    } else if op == Cmp {
        let ty = (cx.insts[v as usize]).imm2;
        let a = operand_reg(cx, (cx.insts[v as usize]).a);
        let b = operand_reg(cx, (cx.insts[v as usize]).b);
        let r = result_reg(cx, v);
        m_cmp(cx, (cx.insts[v as usize]).cond, ty, r, a, b, pcx);
        result_done(cx, v, r, pcx);
    } else if op == Conv {
        let a = operand_reg(cx, (cx.insts[v as usize]).a);
        let r = result_reg(cx, v);
        m_conv(cx, (cx.insts[v as usize]).imm2, (cx.insts[v as usize]).ty, r, a, pcx);
        result_done(cx, v, r, pcx);
    } else if op == Op::Bits {
        // (0.16; made on AArch64 only: lower/calls.vl)
        let a = operand_reg(cx, (cx.insts[v as usize]).a);
        let r = result_reg(cx, v);
        ma_bits(cx, (cx.insts[v as usize]).imm, r, a);
        result_done(cx, v, r, pcx);
    } else if op == Op::Ovf {
        // (0.26.2; 0.26.3: x86-64 too, never fused there)
        let a = operand_reg(cx, (cx.insts[v as usize]).a);
        let b: i64 = if (cx.insts[v as usize]).b
            != 0 { operand_reg(cx, (cx.insts[v as usize]).b) } else { -1 };
        let r = result_reg(cx, v);
        if get_x86() {
            mx_ovf(cx, (cx.insts[v as usize]).imm, r, a, b);
        } else {
            ma_ovf(cx, (cx.insts[v as usize]).imm, r, a, b);
        }
        result_done(cx, v, r, pcx);
    } else if op == Op::Atomic {
        emit_atomic(cx, v, pcx);
    } else if op == Op::Fence {
        if !get_x86() {
            ma_fence(cx, (cx.insts[v as usize]).imm);
        } else {
            mx_fence(cx, (cx.insts[v as usize]).imm);
        }
    } else if op == Load {
        emit_load_inst(cx, v, pcx);
    } else if op == Store {
        emit_store_inst(cx, v, pcx);
    } else if op == Copy {
        let dst = int_operand(cx, (cx.insts[v as usize]).a);
        let src = int_operand(cx, (cx.insts[v as usize]).b);
        m_copy(cx, dst, src, (cx.insts[v as usize]).imm);
    } else if op.is_call() {
        emit_call_inst(cx, v, pcx);
    } else if op == LoadX || op == StoreX || op == Lea {
        emit_indexed(cx, v, pcx);
    } else if op == Select {
        emit_select(cx, v, pcx);
    } else if op == FMath {
        let a = operand_reg(cx, (cx.insts[v as usize]).a);
        let r = result_reg(cx, v);
        if get_x86() {
            mx_sqrt(cx, (cx.insts[v as usize]).ty, r, a);
        } else {
            ma_fmath(cx, (cx.insts[v as usize]).imm, (cx.insts[v as usize]).ty, r, a,
                pcx);
        }
        result_done(cx, v, r, pcx);
    } else if op.is_vector() {
        emit_vector(cx, v, pcx);
    } else if op == MulH {
        let a = operand_reg(cx, (cx.insts[v as usize]).a);
        let b = operand_reg(cx, (cx.insts[v as usize]).b);
        let r = result_reg(cx, v);
        if get_x86() {
            mx_mulh(cx, (cx.insts[v as usize]).imm == 1, r, a, b);
        } else {
            ma_mulh(cx, (cx.insts[v as usize]).imm == 1, r, a, b);
        }
        result_done(cx, v, r, pcx);
    } else if op == MAdd || op == MSub || op == ShOp || op == Ubfx {
        // AArch64 only (see isel.vl).
        let a = operand_reg(cx, (cx.insts[v as usize]).a);
        let b: i64 = if (cx.insts[v as usize]).b
            != 0 { operand_reg(cx, (cx.insts[v as usize]).b) } else { -1 };
        let r = result_reg(cx, v);
        if op == Ubfx {
            ma_ubfx(cx, r, a, (cx.insts[v as usize]).imm,
                (cx.insts[v as usize]).imm2);
        } else if op == ShOp {
            ma_shop(cx, (cx.insts[v as usize]).imm2, (cx.insts[v as usize]).ty, r, a,
                b, (cx.insts[v as usize]).imm);
        } else {
            let arg_v = (cx.insts[v as usize]).ty;
            let operand_reg_v = operand_reg(cx, (cx.insts[v as usize]).c);
            ma_madd(cx, op == MSub, arg_v, r, a, b, operand_reg_v);
        }
        result_done(cx, v, r, pcx);
    } else {
        die(c"internal error: unexpected instruction in emission");
    }
}

// (0.21) An ATOMIC (mc_arm64/atomic.vl, mc_x86_64/atomic.vl): its
// operands only read, its result (when used) written last.
fn emit_atomic(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let a = operand_reg(cx, (cx.insts[v as usize]).a);
    let b: i64 = if (cx.insts[v as usize]).b
        != 0 { operand_reg(cx, (cx.insts[v as usize]).b) } else { -1 };
    let c: i64 = if (cx.insts[v as usize]).c
        != 0 { operand_reg(cx, (cx.insts[v as usize]).c) } else { -1 };
    let mut d: i64 = -1;
    if (cx.insts[v as usize]).ty != 0 {
        let loc = vloc(cx, v, cx.cur_pos + 2);
        if loc >= 0 && loc < 64 {
            d = loc;
        }
    }
    let kind = (cx.insts[v as usize]).imm & 255;
    let order = ((cx.insts[v as usize]).imm >> 8) & 15;
    if get_x86() {
        mx_atomic(cx, kind, order, (cx.insts[v as usize]).imm2, d, a, b, c, pcx);
    } else {
        ma_atomic(cx, kind, order, (cx.insts[v as usize]).imm2, d, a, b, c, pcx);
    }
    if d >= 0 {
        result_done(cx, v, d, pcx);
    }
}

// LOADX, STOREX and LEA: base + (index << scale) + offset (the base a frame
// slot from sp on x86-64).
fn emit_indexed(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let op = (cx.insts[v as usize]).op;
    let mut offset = (cx.insts[v as usize]).imm;
    let base_value = (cx.insts[v as usize]).a;
    let mut base: i64 = 0;
    if (cx.insts[base_value as usize]).op == Slot {
        offset += (cx.slots[(cx.insts[base_value as usize]).imm as usize]).offset;
        base = reg_sp();
    } else {
        base = int_operand(cx, base_value);
    }
    cx.mem_index = if (cx.insts[v as usize]).b
        != 0 { int_operand(cx, (cx.insts[v as usize]).b) } else { -1 };
    cx.mem_scale = (cx.insts[v as usize]).scale;
    if op == StoreX {
        let r = operand_reg(cx, (cx.insts[v as usize]).c);
        m_store(cx, (cx.insts[v as usize]).imm2, r, base, offset, pcx);
        cx.mem_index = -1;
        return;
    }
    let r = result_reg(cx, v);
    if op == LoadX {
        m_load(cx, (cx.insts[v as usize]).ty, r, base, offset, pcx);
    } else {
        m_lea(cx, r, base, offset);
    }
    cx.mem_index = -1;
    result_done(cx, v, r, pcx);
}

// A vector operation (0.10).
fn emit_vector(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let op = (cx.insts[v as usize]).op;
    if op == Op::Intr || op == Op::VConst || op == Op::CpuFeat {
        // (0.19: the intrinsics)
        emit_intr(cx, v, pcx);
        return;
    }
    let ty = (cx.insts[v as usize]).ty;
    let a = operand_reg(cx, (cx.insts[v as usize]).a);
    let b: i64 = if (cx.insts[v as usize]).b
        != 0 { operand_reg(cx, (cx.insts[v as usize]).b) } else { -1 };
    let r = result_reg(cx, v);
    let vt = if op == VCmp { (cx.insts[v as usize]).imm2 }
        else if op == VExt
        || op == VSum { (cx.insts[(cx.insts[v as usize]).a as usize]).ty }
        else { ty };
    if op == VBin {
        let raw = (cx.insts[v as usize]).imm;
        let bop = raw as Op;
        if get_x86() { mx_vbin(cx, bop, vt, r, a, b, pcx); }
        else { ma_vbin(cx, bop, vt, r, a, b, pcx); }
    } else if op == VCmp {
        if get_x86() { mx_vcmp(cx, (cx.insts[v as usize]).cond, vt, r, a, b, pcx); }
        else { ma_vcmp(cx, (cx.insts[v as usize]).cond, vt, r, a, b, pcx); }
    } else if op == VNeg {
        if get_x86() { mx_vneg(cx, vt, r, a, pcx); } else { ma_vneg(cx, vt, r, a, pcx); }
    } else if op == VSplat {
        if get_x86() { mx_vsplat(cx, vt, r, a, pcx); } else { ma_vsplat(cx, vt, r, a, pcx); }
    } else if op == VExt {
        if get_x86() { mx_vext(cx, vt, r, a, (cx.insts[v as usize]).imm, pcx); }
        else { ma_vext(cx, vt, r, a, (cx.insts[v as usize]).imm, pcx); }
    } else if op == VIns {
        if get_x86() { mx_vins(cx, vt, r, a, b, (cx.insts[v as usize]).imm, pcx); }
        else { ma_vins(cx, vt, r, a, b, (cx.insts[v as usize]).imm, pcx); }
    } else if op == VSum {
        if get_x86() { mx_vsum(cx, vt, r, a, pcx); } else { ma_vsum(cx, vt, r, a, pcx); }
    } else if op == Op::VMacW {
        let operand_reg_v = operand_reg(cx, (cx.insts[v as usize]).c);
        // (0.16; made on AArch64 only: vectorize/legality.vl)
        ma_vmacw(cx, r, a, b, operand_reg_v);
    } else {
        let c = operand_reg(cx, (cx.insts[v as usize]).c);
        if get_x86() { mx_vsel(cx, r, a, b, c); } else { ma_vsel(cx, r, a, b, c); }
    }
    result_done(cx, v, r, pcx);
}

// SELECT: the comparison (or test) of its last operands, then a conditional
// select of its first two.
fn emit_select(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let ir_arg_v = ir_arg(cx, v, 0);
    let lhs = operand_reg(cx, ir_arg_v);
    let rhs: i64 = if ir_arg(cx, v, 1)
        != 0 { let ir_arg_v1 = ir_arg(cx, v, 1); operand_reg(cx, ir_arg_v1) } else { -1 };
    // (-1: xzr, see use_kind.)
    let then: i64 = if !get_x86() && is_zero_operand(cx, (cx.insts[v as usize]).a) { -1 }
        else { operand_reg(cx, (cx.insts[v as usize]).a) };
    let other: i64 = if !get_x86() && is_zero_operand(cx, (cx.insts[v as usize]).b) { -1 }
        else { operand_reg(cx, (cx.insts[v as usize]).b) };
    let r = result_reg(cx, v);
    let test = ((cx.insts[v as usize]).scale & 1) == 1;
    if get_x86() {
        // The flags of the select just before, when it compared the same and
        // nothing was emitted since (a rematerialized 0 is an xorl).
        let p = (cx.insts[v as usize]).prev;
        let same = p != 0 && p == cx.last_select
            && buf_len(cx.code) == cx.last_select_end
            && ir_arg(cx, p, 0) == ir_arg(cx, v, 0) && ir_arg(cx, p, 1) == ir_arg(cx, v, 1)
            && (cx.insts[p as usize]).imm == (cx.insts[v as usize]).imm
            && (cx.insts[p as usize]).imm2 == (cx.insts[v as usize]).imm2
            && (cx.insts[p as usize]).scale == (cx.insts[v as usize]).scale;
        mx_select(cx, (cx.insts[v as usize]).cond, test, !same,
            (cx.insts[v as usize]).imm2, lhs, rhs, (cx.insts[v as usize]).imm, r,
            then, other);
        cx.last_select = v;
        cx.last_select_end = buf_len(cx.code);
    } else {
        // The flags of the select just before, when it compared the same
        // (nothing between them on AArch64 touches the flags: moves,
        // loads, stores and rematerializations do not).
        let p = (cx.insts[v as usize]).prev;
        let same = p != 0 && (cx.insts[p as usize]).op == Select
            && ir_arg(cx, p, 0) == ir_arg(cx, v, 0) && ir_arg(cx, p, 1) == ir_arg(cx, v, 1)
            && (cx.insts[p as usize]).imm == (cx.insts[v as usize]).imm
            && (cx.insts[p as usize]).imm2 == (cx.insts[v as usize]).imm2
            && ((cx.insts[p as usize]).scale & 1)
            == ((cx.insts[v as usize]).scale & 1);
        ma_select(cx, (cx.insts[v as usize]).cond, test, !same,
            (cx.insts[v as usize]).imm2, lhs, rhs, (cx.insts[v as usize]).imm,
            (cx.insts[v as usize]).ty, r, then, other,
            ((cx.insts[v as usize]).scale & 2) != 0, pcx);
    }
    result_done(cx, v, r, pcx);
}

fn emit_binary(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let op = (cx.insts[v as usize]).op;
    let ty = (cx.insts[v as usize]).ty;
    if is_float(ty) {
        let a = float_operand(cx, (cx.insts[v as usize]).a);
        let b = float_operand(cx, (cx.insts[v as usize]).b);
        let r = result_reg(cx, v);
        m_float_op(cx, op, ty, r, a, b, pcx);
        result_done(cx, v, r, pcx);
        return;
    }
    let a = int_operand(cx, (cx.insts[v as usize]).a);
    let r = result_reg(cx, v);
    let mut imm: i64 = 0;
    let ovf = ovf_partner(cx, v);
    if use_kind(cx, v, 1, pcx) == USE_NONE
        && const_of(cx, (cx.insts[v as usize]).b, &mut imm) {
        if ovf != 0 && ma_ovf_op_imm(cx, (cx.insts[ovf as usize]).imm, r, a, imm) {
            cx.ovf_flags = ovf;
        } else if !m_int_op_imm(cx, op, ty, r, a, imm, pcx) {
            die(c"internal error: an immediate operand that does not fit");
        }
        result_done(cx, v, r, pcx);
        return;
    }
    let b = int_operand(cx, (cx.insts[v as usize]).b);
    if ovf != 0 {
        ma_ovf_op(cx, (cx.insts[ovf as usize]).imm, r, a, b);
        cx.ovf_flags = ovf;
    } else if op == Div || op == Rem {
        let is_const = const_of(cx, (cx.insts[v as usize]).b, &mut imm);
        m_div(cx, op, ty, r, a, b, imm, is_const, pcx);
    } else {
        m_int_op(cx, op, ty, r, a, b, pcx);
    }
    result_done(cx, v, r, pcx);
}

// (0.26.2, a prototype) The overflow check (OVF) of binary v's own
// operation, right after it and fused into the branch that ends the block,
// when v can set the flags for it (ma_ovf_op); 0 otherwise.
fn ovf_partner(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let c = (cx.insts[v as usize]).next;
    if get_x86() || c == 0 || (cx.insts[c as usize]).op != Op::Ovf
        || !is_fused_compare(cx, c) {
        return 0;
    }
    let imm = (cx.insts[c as usize]).imm;
    let op = (cx.insts[v as usize]).op;
    if (imm & 255) != op as i64 || (imm >> 8) != (cx.insts[v as usize]).ty
        || !ovf_fusable(imm) {
        return 0;
    }
    let a = (cx.insts[v as usize]).a;
    let b = (cx.insts[v as usize]).b;
    if (cx.insts[c as usize]).a == a && (cx.insts[c as usize]).b == b
        || op != Op::Sub && (cx.insts[c as usize]).a == b
        && (cx.insts[c as usize]).b == a {
        c
    } else {
        0
    }
}

// The base register and offset of a memory access to `addr` + `offset`
// (an operand needed in a register): frame slots are addressed from sp
// directly.
fn mem_base(cx: &mut FnCtx<Comp>, addr: i64, offset: i64, out_offset: &mut i64) -> i64 {
    if (cx.insts[addr as usize]).op == Slot {
        *out_offset = (cx.slots[(cx.insts[addr as usize]).imm as usize]).offset + offset;
        return reg_sp();
    }
    *out_offset = offset;
    int_operand(cx, addr)
}

// The same for an address used at `pos` where it may be anywhere (loaded
// into the parallel moves' temporary then).
pub fn mem_base_any(cx: &mut FnCtx<Comp>, addr: i64, offset: i64, pos: i64, out_offset: &mut i64,
    pcx: &Ctx<Comp>) -> i64 {
    if (cx.insts[addr as usize]).op == Slot {
        *out_offset = (cx.slots[(cx.insts[addr as usize]).imm as usize]).offset + offset;
        return reg_sp();
    }
    *out_offset = offset;
    use_any(cx, addr, pos, reg_move_temp(float: false), pcx)
}

fn emit_load_inst(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let mut offset: i64 = 0;
    let base = mem_base(cx, (cx.insts[v as usize]).a, (cx.insts[v as usize]).imm,
        &mut offset);
    let r = result_reg(cx, v);
    m_load(cx, (cx.insts[v as usize]).ty, r, base, offset, pcx);
    result_done(cx, v, r, pcx);
}

fn emit_store_inst(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let mut offset: i64 = 0;
    let base = mem_base(cx, (cx.insts[v as usize]).a, (cx.insts[v as usize]).imm,
        &mut offset);
    let value = (cx.insts[v as usize]).b;
    let r = operand_reg(cx, value);
    m_store(cx, (cx.insts[v as usize]).imm2, r, base, offset, pcx);
}
