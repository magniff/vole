// The machine layer of the emitter (emit/mod.vl): the target's
// registers and argument locations, and the m_* operations, which
// dispatch to mc_arm64.vl or mc_x86_64.vl.

use crate::back::abi::{conv_returns_through_pointer, fn_type_uses_c, fn_uses_c};
use crate::back::emit::calls::callee_result;
use crate::back::emit::stats::{ST_MOVES, st_spill};
use crate::back::mc_arm64::{
    ma_copy, ma_extern_addr, ma_lea, ma_load, ma_load_fimm, ma_load_imm, ma_mov, ma_normalize,
    ma_store, ma_string_addr, ma_symbol_addr,
};
use crate::back::mc_arm64::ops::{
    ma_branch_bool, ma_cmp, ma_cmp_branch, ma_conv, ma_float_op, ma_int_imm_ok, ma_int_op,
    ma_int_op_imm, ma_unary,
};
use crate::back::mc_x86_64::{
    mx_copy, mx_extern_addr, mx_lea, mx_load, mx_load_fimm, mx_load_imm, mx_mov, mx_normalize,
    mx_store, mx_string_addr, mx_symbol_addr,
};
use crate::back::mc_x86_64::ops::{
    mx_branch_bool, mx_cmp, mx_cmp_branch, mx_conv, mx_div, mx_float_op, mx_int_imm_ok, mx_int_op,
    mx_int_op_imm, mx_unary,
};
use crate::base::get_bufs;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{TY_U64, align_to, in_fregs, is_float, is_vector, type_size};
use crate::gen0::target::{emit_jump, ins};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, Op};
use crate::middle::ir::Op::{And, Call, CallI, Div, Or, Rem, Shr, Xor};

// ---- Registers of the machine layer ----

pub fn reg_sp() -> i64 { if get_x86() { 4 } else { 31 } }

pub fn reg_fp() -> i64 { if get_x86() { 5 } else { 29 } }

// Never allocated: the register that breaks cycles of parallel moves, and
// the temporary for memory-to-memory moves (and for operands loaded or
// rematerialized where they are needed).
pub fn reg_cycle(float: bool) -> i64 {
    if float { if get_x86() { 47 } else { 63 } } else if get_x86() { 10 } else { 17 }
}

pub fn reg_move_temp(float: bool) -> i64 {
    if float { if get_x86() { 46 } else { 62 } } else if get_x86() { 11 } else { 16 }
}

pub fn reg_ret(float: bool) -> i64 { if float { 32 } else { 0 } }

fn reg_result_ptr() -> i64 { if get_x86() { 7 } else { 8 } }

pub fn reg_callee() -> i64 { if get_x86() { 11 } else { 16 } }

// Argument locations in the back end, for both conventions (see
// abi.vl): 0-31 the index of an int argument register, 32-63 of a
// float one, XL_STACK + offset a slot of the stack argument area (outgoing:
// from sp; incoming: from the frame pointer, 16 bytes up).
const XL_FLOAT: i64 = 32;

const XL_STACK: i64 = 64;

pub fn xl_is_stack(location: i64) -> bool {
    location >= XL_STACK
}

pub fn xl_offset(location: i64) -> i64 {
    location - XL_STACK
}

// A location of the C convention (see arg_location) as a back-end one.
pub fn xl_from_c(location: i64) -> i64 {
    if location < 8 {
        return location;
    }
    if location < 16 {
        return XL_FLOAT + location - 8;
    }
    XL_STACK + location - 16
}

// The register of argument location `location`: C's argument registers
// first, then the vole convention's further ones.
pub fn arg_reg(location: i64) -> i64 {
    if location >= XL_FLOAT {
        let index = location - XL_FLOAT;
        if get_x86() || index < 8 {
            return 32 + index;
        }
        // d16-d23.
        return 32 + 8 + index;
    }
    if !get_x86() {
        return location;
    }
    if location == 0 { return 7; }
    if location == 1 { return 6; }
    if location == 2 { return 2; }
    if location == 3 { return 1; }
    if location == 4 { return 8; }
    if location == 5 { return 9; }
    0
}

// The vole convention's argument registers.
fn t_int_args() -> i64 { if get_x86() { 7 } else { 16 } }

fn t_float_args() -> i64 { if get_x86() { 14 } else { 16 } }

// The location of the next scalar argument of type ty under the vole
// convention: the next register of its class, else the next stack slot (8
// bytes; (0.19) a vector's: its size, at a multiple of it). A vector is one
// argument in a vector register (docs/design/arch.md §2.2). `state` as for
// arg_location.
pub fn t_arg_location(ty: i64, state: *mut i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let vector = is_vector(ty, pcx);
        if is_float(ty) || vector {
            if (*state.add(1)) < t_float_args() {
                (*state.add(1)) += 1;
                return XL_FLOAT + (*state.add(1)) - 1;
            }
        } else if (*state.add(0)) < t_int_args() {
            (*state.add(0)) += 1;
            return (*state.add(0)) - 1;
        }
        let size: i64 = if vector && type_size(ty, pcx) > 8 { type_size(ty, pcx) } else { 8 };
        let offset = align_to((*state.add(2)), size);
        (*state.add(2)) = offset + size;
        XL_STACK + offset
    }
}

// Whether call v follows C's convention.
pub fn call_uses_c(cx: &mut FnCtx, v: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        if op == Call { return fn_uses_c((*cx.insts.add(v as usize)).imm, pcx); }
        if op == CallI { return fn_type_uses_c((*cx.insts.add(v as usize)).imm, pcx); }
        true
    }
}

pub fn call_returns_through_pointer(cx: &mut FnCtx, v: i64, pcx: &Ctx<Comp>) -> bool {
    let call_uses_c_v = call_uses_c(cx, v, pcx);
    let callee_result_v = callee_result(cx, v, pcx);
    conv_returns_through_pointer(cx, call_uses_c_v, callee_result_v, pcx)
}

// The register of the result pointer: x8 / rdi in C's convention, the first
// argument register in vole's.
pub fn conv_result_ptr_reg(c: bool) -> i64 {
    if c { reg_result_ptr() } else { arg_reg(0) }
}

// The type a spill slot is accessed with.
pub fn spill_type(ty: i64, pcx: &Ctx<Comp>) -> i64 {
    if in_fregs(ty, pcx) { ty } else { TY_U64 }
}

pub fn spill_offset(cx: &mut FnCtx, loc: i64) -> i64 {
    cx.spill_base + 8 * (0 - loc - 1)
}

pub fn block_label(cx: &mut FnCtx, b: i64) -> i64 {
    unsafe { cx.label_base + (*cx.blocks.add(b as usize)).order }
}

// ---- Dispatch to the machine layer ----

pub fn m_mov(cx: &mut FnCtx, dst: i64, src: i64, ty: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if dst == src { return; }
        if (*get_bufs().add(cx.code as usize)).len == cx.last_mov_end && dst == cx.last_mov_src
            && src == cx.last_mov_dst {
            return;
        }
        if get_x86() { mx_mov(cx, dst, src, ty, pcx); } else { ma_mov(cx, dst, src, ty, pcx); }
        cx.st_fn[ST_MOVES as usize] += 1;
        cx.last_mov_dst = dst;
        cx.last_mov_src = src;
        cx.last_mov_end = (*get_bufs().add(cx.code as usize)).len;
    }
}

pub fn m_load_imm(cx: &mut FnCtx, dst: i64, value: u64) {
    if get_x86() { mx_load_imm(cx, dst, value); } else { ma_load_imm(cx, dst, value); }
}

pub fn m_load_fimm(cx: &mut FnCtx, dst: i64, bits: i64, ty: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_load_fimm(cx, dst, bits, ty); } else { ma_load_fimm(cx, dst, bits, ty, pcx); }
}

pub fn m_load(cx: &mut FnCtx, ty: i64, dst: i64, base: i64, offset: i64, pcx: &Ctx<Comp>) {
    if unsafe {
        cx.mem_index < 0 && base == reg_sp()
            && (*get_bufs().add(cx.code as usize)).len == cx.last_store_end
            && offset == cx.last_store_offset && ty == cx.last_store_type && type_size(ty, pcx) == 8
            && (dst >= 32) == (cx.last_store_reg >= 32)
    } {
        // UNSAFE: cx is the raw context pointer this function takes; m_mov takes the context inout.
        // SAFETY: cx points to the live FnCtx its caller holds for the whole call.
        unsafe { m_mov(cx, dst, cx.last_store_reg, ty, pcx); }
        return;
    }
    st_spill(cx, true, base, offset);
    if get_x86() {
        mx_load(cx, ty, dst, base, offset, pcx);
    } else {
        ma_load(cx, ty, dst, base, offset, pcx);
    }
}

pub fn m_store(cx: &mut FnCtx, ty: i64, src: i64, base: i64, offset: i64, pcx: &Ctx<Comp>) {
    st_spill(cx, false, base, offset);
    if get_x86() { mx_store(cx, ty, src, base, offset, pcx); }
    else { ma_store(cx, ty, src, base, offset, pcx); }
    if cx.mem_index < 0 && base == reg_sp() {
        cx.last_store_reg = src;
        cx.last_store_offset = offset;
        cx.last_store_type = ty;
        unsafe { cx.last_store_end = (*get_bufs().add(cx.code as usize)).len; }
    }
}

pub fn m_lea(cx: &mut FnCtx, dst: i64, base: i64, offset: i64) {
    if get_x86() { mx_lea(cx, dst, base, offset); } else { ma_lea(cx, dst, base, offset); }
}

pub fn m_symbol_addr(cx: &mut FnCtx, dst: i64, prefix: *mut u8, name: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_symbol_addr(cx, dst, prefix, name, pcx); }
    else { ma_symbol_addr(cx, dst, prefix, name, pcx); }
}

pub fn m_extern_addr(cx: &mut FnCtx, dst: i64, name: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_extern_addr(cx, dst, name, pcx); }
    else { ma_extern_addr(cx, dst, name, pcx); }
}

pub fn m_string_addr(cx: &mut FnCtx, dst: i64, id: i64) {
    if get_x86() { mx_string_addr(cx, dst, id); } else { ma_string_addr(cx, dst, id); }
}

pub fn m_normalize(cx: &mut FnCtx, r: i64, ty: i64) {
    if get_x86() { mx_normalize(cx, r, ty); } else { ma_normalize(cx, r, ty); }
}

pub fn m_int_op(cx: &mut FnCtx, op: Op, ty: i64, dst: i64, a: i64, b: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_int_op(cx, op, ty, dst, a, b, pcx); }
    else { ma_int_op(cx, op, ty, dst, a, b); }
}

// dst = a <op> imm when the target encodes it; false otherwise.
pub fn m_int_op_imm(cx: &mut FnCtx, op: Op, ty: i64, dst: i64, a: i64, imm: i64, pcx: &Ctx<Comp>) -> bool {
    if get_x86() { mx_int_op_imm(cx, op, ty, dst, a, imm, pcx) }
    else { ma_int_op_imm(cx, op, ty, dst, a, imm) }
}

pub fn m_float_op(cx: &mut FnCtx, op: Op, ty: i64, dst: i64, a: i64, b: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_float_op(cx, op, ty, dst, a, b, pcx); }
    else { ma_float_op(cx, op, ty, dst, a, b, pcx); }
}

pub fn m_unary(cx: &mut FnCtx, op: Op, ty: i64, dst: i64, a: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_unary(cx, op, ty, dst, a, pcx); } else { ma_unary(cx, op, ty, dst, a, pcx); }
}

pub fn m_cmp(cx: &mut FnCtx, op: Cond, ty: i64, dst: i64, a: i64, b: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_cmp(cx, op, ty, dst, a, b); } else { ma_cmp(cx, op, ty, dst, a, b, pcx); }
}

// Compares integers a and b (b an immediate when b_imm) and jumps to
// `label` when a <op> b.
pub fn m_cmp_branch(cx: &mut FnCtx, op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool, imm: i64,
    label: i64) {
    if get_x86() { mx_cmp_branch(cx, op, ty, a, b, b_is_imm, imm, label); }
    else { ma_cmp_branch(cx, op, ty, a, b, b_is_imm, imm, label); }
}

pub fn m_branch_bool(cx: &mut FnCtx, r: i64, if_nonzero: bool, label: i64) {
    if get_x86() { mx_branch_bool(cx, r, if_nonzero, label); }
    else { ma_branch_bool(cx, r, if_nonzero, label); }
}

pub fn m_jump(cx: &mut FnCtx, label: i64) {
    emit_jump(cx, label);
}

pub fn m_conv(cx: &mut FnCtx, from: i64, to: i64, dst: i64, src: i64, pcx: &Ctx<Comp>) {
    // (0.19: between vector types of a size, `T::from_bits` and the
    // intrinsics' casts: the same bits, a move when the registers differ)
    if is_vector(from, pcx) && is_vector(to, pcx) {
        if dst != src {
            m_mov(cx, dst, src, to, pcx);
        }
        return;
    }
    if get_x86() { mx_conv(cx, from, to, dst, src, pcx); }
    else { ma_conv(cx, from, to, dst, src, pcx); }
}

pub fn m_copy(cx: &mut FnCtx, dst: i64, src: i64, size: i64) {
    if get_x86() { mx_copy(cx, dst, src, size); } else { ma_copy(cx, dst, src, size); }
}

pub fn m_div(cx: &mut FnCtx, op: Op, ty: i64, dst: i64, a: i64, b: i64, b_const: i64,
    b_is_const: bool, pcx: &Ctx<Comp>) {
    if get_x86() { mx_div(cx, op, ty, dst, a, b, b_const, b_is_const, pcx); }
    else { ma_int_op(cx, op, ty, dst, a, b); }
}

// Whether `dst = a <op> imm` is one instruction (m_int_op_imm emits it).
pub fn m_int_imm_ok(op: Op, ty: i64, imm: i64) -> bool {
    if get_x86() { mx_int_imm_ok(op, imm) } else { ma_int_imm_ok(op, imm) }
}

pub fn m_trap(cx: &mut FnCtx) {
    if get_x86() { ins(cx, c"ud2"); } else { ins(cx, c"brk #1"); }
}

// Whether op of canonical operands of a type (signed or not) gives a
// canonical result: and, or, xor, right shifts (by at most the width less
// one), unsigned divisions and remainders.
pub fn stays_canonical(op: Op, signed: bool) -> bool {
    op == And || op == Or || op == Xor || op == Shr || (!signed && (op == Div || op == Rem))
}
