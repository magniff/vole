// The machine layer of the emitter (emit/mod.vl): the target's
// registers and argument locations, and the m_* operations, which
// dispatch to mc_arm64.vl or mc_x86_64.vl.

use crate::back::abi::{conv_returns_through_pointer, fn_type_uses_c, fn_uses_c};
use crate::back::emit::calls::callee_result;
use crate::back::emit::stats::{ST_MOVES, st_spill};
use crate::back::mc_arm64::{
    ma_copy, ma_extern_addr, ma_lea, ma_load, ma_load_fimm, ma_load_imm, ma_mov, ma_normalize,
    ma_store, ma_string_addr, ma_symbol_addr,
};
use crate::back::mc_arm64::ops::{
    ma_branch_bool, ma_cmp, ma_cmp_branch, ma_conv, ma_float_op, ma_int_imm_ok, ma_int_op,
    ma_int_op_imm, ma_unary,
};
use crate::back::mc_x86_64::{
    mx_copy, mx_extern_addr, mx_lea, mx_load, mx_load_fimm, mx_load_imm, mx_mov, mx_normalize,
    mx_store, mx_string_addr, mx_symbol_addr,
};
use crate::back::mc_x86_64::ops::{
    mx_branch_bool, mx_cmp, mx_cmp_branch, mx_conv, mx_div, mx_float_op, mx_int_imm_ok, mx_int_op,
    mx_int_op_imm, mx_unary,
};
use crate::base::{buf_len, exit_now};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{
    TY_F32, TY_F64, TY_U64, align_to, in_fregs, is_float, is_vector, type_size,
};
use crate::gen0::target::{emit_jump, ins};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, Op};
use crate::middle::ir::Op::{And, Call, CallI, Div, Or, Rem, Shr, Xor};

// ---- Registers of the machine layer ----

pub fn reg_sp() -> i64 { if get_x86() { 4 } else { 31 } }

pub fn reg_fp() -> i64 { if get_x86() { 5 } else { 29 } }

// Never allocated: the register that breaks cycles of parallel moves, and
// the temporary for memory-to-memory moves (and for operands loaded or
// rematerialized where they are needed).
pub fn reg_cycle(float: bool) -> i64 {
    if float { if get_x86() { 47 } else { 63 } } else if get_x86() { 10 } else { 17 }
}

pub fn reg_move_temp(float: bool) -> i64 {
    if float { if get_x86() { 46 } else { 62 } } else if get_x86() { 11 } else { 16 }
}

pub fn reg_ret(float: bool) -> i64 { if float { 32 } else { 0 } }

fn reg_result_ptr() -> i64 { if get_x86() { 7 } else { 8 } }

pub fn reg_callee() -> i64 { if get_x86() { 11 } else { 16 } }

// Argument locations in the back end, for both conventions (see
// abi.vl): 0-31 the index of an int argument register, 32-63 of a
// float one, XL_STACK + offset a slot of the stack argument area (outgoing:
// from sp; incoming: from the frame pointer, 16 bytes up).
const XL_FLOAT: i64 = 32;

const XL_STACK: i64 = 64;

pub fn xl_is_stack(location: i64) -> bool {
    location >= XL_STACK
}

pub fn xl_offset(location: i64) -> i64 {
    location - XL_STACK
}

// A location of the C convention (see arg_location) as a back-end one.
pub fn xl_from_c(location: i64) -> i64 {
    if location < 8 {
        return location;
    }
    if location < 16 {
        return XL_FLOAT + location - 8;
    }
    XL_STACK + location - 16
}

// The register of argument location `location`: C's argument registers
// first, then the vole convention's further ones.
pub fn arg_reg(location: i64) -> i64 {
    if location >= XL_FLOAT {
        let index = location - XL_FLOAT;
        if get_x86() || index < 8 {
            return 32 + index;
        }
        // d16-d23.
        return 32 + 8 + index;
    }
    if !get_x86() {
        return location;
    }
    if location == 0 { return 7; }
    if location == 1 { return 6; }
    if location == 2 { return 2; }
    if location == 3 { return 1; }
    if location == 4 { return 8; }
    if location == 5 { return 9; }
    0
}

// The vole convention's argument registers.
fn t_int_args() -> i64 { if get_x86() { 7 } else { 16 } }

fn t_float_args() -> i64 { if get_x86() { 14 } else { 16 } }

// The location of the next scalar argument of type ty under the vole
// convention: the next register of its class, else the next stack slot (8
// bytes; (0.19) a vector's: its size, at a multiple of it). A vector is one
// argument in a vector register (docs/design/arch.md §2.2). `state` as for
// arg_location.
pub fn t_arg_location(ty: i64, state: &mut [i64], pcx: &Ctx<Comp>) -> i64 {
    let vector = is_vector(ty, pcx);
    if is_float(ty) || vector {
        if state[1] < t_float_args() {
            state[1] += 1;
            return XL_FLOAT + state[1] - 1;
        }
    } else if state[0] < t_int_args() {
        state[0] += 1;
        return state[0] - 1;
    }
    let size: i64 = if vector && type_size(ty, pcx) > 8 { type_size(ty, pcx) } else { 8 };
    let offset = align_to(state[2], size);
    state[2] = offset + size;
    XL_STACK + offset
}

// Whether call v follows C's convention.
pub fn call_uses_c(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    let op = (cx.insts[v as usize]).op;
    if op == Call { return fn_uses_c((cx.insts[v as usize]).imm, pcx); }
    if op == CallI { return fn_type_uses_c((cx.insts[v as usize]).imm, pcx); }
    true
}

pub fn call_returns_through_pointer(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    let call_uses_c_v = call_uses_c(cx, v, pcx);
    let callee_result_v = callee_result(cx, v, pcx);
    conv_returns_through_pointer(cx, call_uses_c_v, callee_result_v, pcx)
}

// The register of the result pointer: x8 / rdi in C's convention, the first
// argument register in vole's.
pub fn conv_result_ptr_reg(c: bool) -> i64 {
    if c { reg_result_ptr() } else { arg_reg(0) }
}

// The type a spill slot is accessed with.
pub fn spill_type(ty: i64, pcx: &Ctx<Comp>) -> i64 {
    if in_fregs(ty, pcx) { ty } else { TY_U64 }
}

pub fn spill_offset(cx: &mut FnCtx<Comp>, loc: i64) -> i64 {
    cx.spill_base + 8 * (0 - loc - 1)
}

// (0.30.1, RT-CG-7) The type the spill slot at sp + offset is read and
// written with: spill_type's, except that on AArch64 an f32 slot from 16
// KB on is accessed as its 8 bytes (an f64's ldr and str: its d register,
// whose low half is the s register; the slot is 8 bytes). So no spill
// access needs a scratch register for its address: layout_frame keeps
// every spill slot (and the moves' save cells after them) below 32760, at
// a multiple of 8 (16 for a 16-byte value, whose slots are aligned), and
// AArch64's unsigned scaled offset reaches 4095 units: x (integers, which
// spill as u64), d (f64, f32 here, 8-byte vectors) at 8 bytes up to 32760,
// q (16-byte vectors) at 16 up to 65520, s (f32) at 4 only below 16384.
// No value spills as b or h (a byte or a half: integers are u64). x17, the
// scratch, is the integer cycle register of the parallel moves, whose
// steps access spill slots only (ma_scratch refuses it there).
pub fn spill_access_type(ty: i64, offset: i64, pcx: &Ctx<Comp>) -> i64 {
    let st = spill_type(ty, pcx);
    if st == TY_F32 && !get_x86() && offset >= 16384 && pcx.plant_rt_cg_7 != 1
        && pcx.plant_rt_cg_7 != 5 { TY_F64 }
    else { st }
}

// (0.30.1, RT-CG-7) Spill slot `loc` (a location below 0) loaded into
// register r, and register r stored into it: every access of a spill slot
// comes here (spill_access_type).
pub fn m_spill_load(cx: &mut FnCtx<Comp>, ty: i64, r: i64, loc: i64, pcx: &Ctx<Comp>) {
    let offset = spill_offset(cx, loc);
    m_load(cx, spill_access_type(ty, offset, pcx), r, reg_sp(), offset, pcx);
}

pub fn m_spill_store(cx: &mut FnCtx<Comp>, ty: i64, r: i64, loc: i64, pcx: &Ctx<Comp>) {
    let offset = spill_offset(cx, loc);
    m_store(cx, spill_access_type(ty, offset, pcx), r, reg_sp(), offset, pcx);
}

pub fn block_label(cx: &mut FnCtx<Comp>, b: i64) -> i64 {
    cx.label_base + (cx.blocks[b as usize]).order
}

// ---- Dispatch to the machine layer ----

// (0.30.1, RT-CG-5) Register r as the data operand of a load, store or
// move of a value of type ty. Every load, store and move of a register
// comes through m_load, m_store and m_mov, and the machine layer spells a
// register by the type it is given (`ldr dN`, `str xN`, `fmov`, `mov`)
// while its number says its class: 0-31 the general registers, 32-63 the
// float and vector ones (x86-64: 0-15 and 32-47); AArch64's integers 0-30. So the two must agree:
// a float register given an integer type was written `str x63`, which
// the assembler took as xzr and stored 0. A register of the other class,
// or a number the target has no register for, is an internal error.
pub fn m_check_reg(r: i64, ty: i64, what: &str, pcx: &Ctx<Comp>) {
    let float = in_fregs(ty, pcx);
    // (0.30.1, F4) AArch64's register 31 is sp or xzr, never a value's:
    // an integer is in x0-x30
    let count: i64 = if get_x86() { 16 } else if float { 32 } else { 31 };
    let first: i64 = if float { 32 } else { 0 };
    if r < first || r >= first + count {
        let class = if float { "a float or vector" } else { "an integer" };
        eprint("{}", format_args(
            "error: internal error: the {what} of {class} value names the register {r}, not one of its class ({first} to {})\n",
            first + count - 1));
        exit_now(1);
    }
}

pub fn m_mov(cx: &mut FnCtx<Comp>, dst: i64, src: i64, ty: i64, pcx: &Ctx<Comp>) {
    m_check_reg(dst, ty, "move", pcx);
    m_check_reg(src, ty, "move", pcx);
    if dst == src { return; }
    if buf_len(cx.code) == cx.last_mov_end && dst == cx.last_mov_src
        && src == cx.last_mov_dst {
        return;
    }
    if get_x86() { mx_mov(cx, dst, src, ty, pcx); } else { ma_mov(cx, dst, src, ty, pcx); }
    cx.st_fn[ST_MOVES as usize] += 1;
    cx.last_mov_dst = dst;
    cx.last_mov_src = src;
    cx.last_mov_end = buf_len(cx.code);
}

pub fn m_load_imm(cx: &mut FnCtx<Comp>, dst: i64, value: u64) {
    if get_x86() { mx_load_imm(cx, dst, value); } else { ma_load_imm(cx, dst, value); }
}

pub fn m_load_fimm(cx: &mut FnCtx<Comp>, dst: i64, bits: i64, ty: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_load_fimm(cx, dst, bits, ty); } else { ma_load_fimm(cx, dst, bits, ty, pcx); }
}

pub fn m_load(cx: &mut FnCtx<Comp>, ty: i64, dst: i64, base: i64, offset: i64, pcx: &Ctx<Comp>) {
    m_check_reg(dst, ty, "load", pcx);
    if cx.mem_index < 0 && base == reg_sp()
        && buf_len(cx.code) == cx.last_store_end
        && offset == cx.last_store_offset && ty == cx.last_store_type && type_size(ty, pcx) == 8
        && (dst >= 32) == (cx.last_store_reg >= 32) {
        m_mov(cx, dst, cx.last_store_reg, ty, pcx);
        return;
    }
    st_spill(cx, true, base, offset);
    if get_x86() {
        mx_load(cx, ty, dst, base, offset, pcx);
    } else {
        ma_load(cx, ty, dst, base, offset, pcx);
    }
}

pub fn m_store(cx: &mut FnCtx<Comp>, ty: i64, src: i64, base: i64, offset: i64, pcx: &Ctx<Comp>) {
    m_check_reg(src, ty, "store", pcx);
    st_spill(cx, false, base, offset);
    if get_x86() { mx_store(cx, ty, src, base, offset, pcx); }
    else { ma_store(cx, ty, src, base, offset, pcx); }
    if cx.mem_index < 0 && base == reg_sp() {
        cx.last_store_reg = src;
        cx.last_store_offset = offset;
        cx.last_store_type = ty;
        cx.last_store_end = buf_len(cx.code);
    }
}

// (0.30.1, RT-CG-2) Forgets what the peepholes remember of the code just
// emitted: m_mov's last move, m_load's last stack store, emit_select's
// last select, AArch64's pair_with_last. Each is a position in CODE, and
// the code of the function before, cleared, may have reached the same
// position the new one's does. Called at the start of every function
// either generator emits (gen_ir_function; gen0's gen_body and
// gen_atomic_function) and of the runtime's helpers (emit_runtime).
// Before, -O0 only cleared the buffer: on x86-64 a load of a pushed
// temporary became a move from the register an earlier function stored.
pub fn forget_emitted(cx: &mut FnCtx<Comp>) {
    cx.last_mov_end = -1;
    cx.last_store_end = -1;
    cx.pair_end = -1;
    cx.last_select = 0;
    cx.last_select_end = -1;
}

pub fn m_lea(cx: &mut FnCtx<Comp>, dst: i64, base: i64, offset: i64) {
    if get_x86() { mx_lea(cx, dst, base, offset); } else { ma_lea(cx, dst, base, offset); }
}

pub fn m_symbol_addr(cx: &mut FnCtx<Comp>, dst: i64, prefix: *const u8, name: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_symbol_addr(cx, dst, prefix, name, pcx); }
    else { ma_symbol_addr(cx, dst, prefix, name, pcx); }
}

pub fn m_extern_addr(cx: &mut FnCtx<Comp>, dst: i64, name: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_extern_addr(cx, dst, name, pcx); }
    else { ma_extern_addr(cx, dst, name, pcx); }
}

pub fn m_string_addr(cx: &mut FnCtx<Comp>, dst: i64, id: i64) {
    if get_x86() { mx_string_addr(cx, dst, id); } else { ma_string_addr(cx, dst, id); }
}

pub fn m_normalize(cx: &mut FnCtx<Comp>, r: i64, ty: i64) {
    if get_x86() { mx_normalize(cx, r, ty); } else { ma_normalize(cx, r, ty); }
}

pub fn m_int_op(cx: &mut FnCtx<Comp>, op: Op, ty: i64, dst: i64, a: i64, b: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_int_op(cx, op, ty, dst, a, b, pcx); }
    else { ma_int_op(cx, op, ty, dst, a, b); }
}

// dst = a <op> imm when the target encodes it; false otherwise.
pub fn m_int_op_imm(cx: &mut FnCtx<Comp>, op: Op, ty: i64, dst: i64, a: i64, imm: i64,
    pcx: &Ctx<Comp>) -> bool {
    if get_x86() { mx_int_op_imm(cx, op, ty, dst, a, imm, pcx) }
    else { ma_int_op_imm(cx, op, ty, dst, a, imm) }
}

pub fn m_float_op(cx: &mut FnCtx<Comp>, op: Op, ty: i64, dst: i64, a: i64, b: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_float_op(cx, op, ty, dst, a, b, pcx); }
    else { ma_float_op(cx, op, ty, dst, a, b, pcx); }
}

pub fn m_unary(cx: &mut FnCtx<Comp>, op: Op, ty: i64, dst: i64, a: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_unary(cx, op, ty, dst, a, pcx); } else { ma_unary(cx, op, ty, dst, a, pcx); }
}

pub fn m_cmp(cx: &mut FnCtx<Comp>, op: Cond, ty: i64, dst: i64, a: i64, b: i64, pcx: &Ctx<Comp>) {
    if get_x86() { mx_cmp(cx, op, ty, dst, a, b); } else { ma_cmp(cx, op, ty, dst, a, b, pcx); }
}

// Compares integers a and b (b an immediate when b_imm) and jumps to
// `label` when a <op> b.
pub fn m_cmp_branch(cx: &mut FnCtx<Comp>, op: Cond, ty: i64, a: i64, b: i64, b_is_imm: bool,
    imm: i64, label: i64) {
    if get_x86() { mx_cmp_branch(cx, op, ty, a, b, b_is_imm, imm, label); }
    else { ma_cmp_branch(cx, op, ty, a, b, b_is_imm, imm, label); }
}

pub fn m_branch_bool(cx: &mut FnCtx<Comp>, r: i64, if_nonzero: bool, label: i64) {
    if get_x86() { mx_branch_bool(cx, r, if_nonzero, label); }
    else { ma_branch_bool(cx, r, if_nonzero, label); }
}

pub fn m_jump(cx: &mut FnCtx<Comp>, label: i64) {
    emit_jump(cx, label);
}

pub fn m_conv(cx: &mut FnCtx<Comp>, from: i64, to: i64, dst: i64, src: i64, pcx: &Ctx<Comp>) {
    // (0.19: between vector types of a size, `T::from_bits` and the
    // intrinsics' casts: the same bits, a move when the registers differ)
    if is_vector(from, pcx) && is_vector(to, pcx) {
        if dst != src {
            m_mov(cx, dst, src, to, pcx);
        }
        return;
    }
    if get_x86() { mx_conv(cx, from, to, dst, src, pcx); }
    else { ma_conv(cx, from, to, dst, src, pcx); }
}

pub fn m_copy(cx: &mut FnCtx<Comp>, dst: i64, src: i64, size: i64) {
    if get_x86() { mx_copy(cx, dst, src, size); } else { ma_copy(cx, dst, src, size); }
}

pub fn m_div(cx: &mut FnCtx<Comp>, op: Op, ty: i64, dst: i64, a: i64, b: i64, b_const: i64,
    b_is_const: bool, pcx: &Ctx<Comp>) {
    if get_x86() { mx_div(cx, op, ty, dst, a, b, b_const, b_is_const, pcx); }
    else { ma_int_op(cx, op, ty, dst, a, b); }
}

// Whether `dst = a <op> imm` is one instruction (m_int_op_imm emits it).
pub fn m_int_imm_ok(op: Op, ty: i64, imm: i64) -> bool {
    if get_x86() { mx_int_imm_ok(op, imm) } else { ma_int_imm_ok(op, imm) }
}

pub fn m_trap(cx: &mut FnCtx<Comp>) {
    if get_x86() { ins(cx, c"ud2"); } else { ins(cx, c"brk #1"); }
}

// Whether op of canonical operands of a type (signed or not) gives a
// canonical result: and, or, xor, right shifts (by at most the width less
// one), unsigned divisions and remainders.
pub fn stays_canonical(op: Op, signed: bool) -> bool {
    op == And || op == Or || op == Xor || op == Shr || (!signed && (op == Div || op == Rem))
}
