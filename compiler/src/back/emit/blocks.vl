// Blocks (emit/mod.vl): blocks that are only a jump skipped, the
// blocks emitted in layout order with their bodies and branches, and
// switches.

use crate::back::abi::{
    conv_classify, conv_return_piece_reg, conv_returns_through_pointer, fn_uses_c,
};
use crate::back::emit::function::{
    emit_frame_link, emit_frame_setup, emit_frame_teardown, emit_loc, emit_return,
    is_noreturn_call_block,
};
use crate::back::emit::insts::{emit_inst, mem_base_any};
use crate::back::emit::machine::{
    block_label, m_branch_bool, m_cmp_branch, m_jump, m_load, m_load_imm, m_mov, m_trap,
    reg_move_temp, reg_ret,
};
use crate::back::emit::operands::{
    PM_FIELDS, PM_LOC, const_of, int_operand, pm_add_value, pm_dst, pm_kind, pm_resolve, pm_src,
    result_done, use_into,
};
use crate::back::emit::stats::{ST_BACK, ST_MOVES, ST_RELOADS, ST_SPILLS};
use crate::back::mc_arm64::ops::{ma_jump_table, ma_ovf_branch, ma_ovf_flag_branch, ma_test_branch};
use crate::back::mc_x86_64::ops::{mx_jump_table, mx_test_branch};
use crate::back::regalloc::locations::{
    gap_index, plan_end_moves, plan_gap_moves, plan_start_moves, stored_at_def, tloc,
};
use crate::back::regalloc::prepare::{is_emitted, is_fused_compare, tracked};
use crate::base::{alloc_array, die, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::patterns::usefulness::int_key;
use crate::front::types::{TY_U64, is_compound, is_float};
use crate::gen0::target::{emit_label, new_label};
use crate::gen0::x86_64::fits_i32;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, Op, Term, get_irfuncs, ir_arg};
use crate::middle::ir::Op::{Const, Pack, Param, Phi, Piece, Select, Test};
use crate::middle::ir::cfg::{case_target, case_value};

pub fn find_trivial_jumps(cx: &mut FnCtx<Comp>) {
    cx.trivial.clear();
    for k in 0..cx.order.len() as i64 {
        let arg_v: i64 = if is_trivial_jump_now(cx, (cx.order[k as usize])) {
            1
        }
            else { 0 };
        cx.trivial.push(arg_v);
    }
}

// Whether block b emits nothing but a jump: no instruction, no move.
fn is_trivial_jump_now(cx: &mut FnCtx<Comp>, b: i64) -> bool {
    unsafe {
        if (cx.blocks[b as usize]).term != Term::Jump
            || b == (*get_irfuncs().add(cx.irf as usize)).entry
            || (cx.blocks[b as usize]).order == cx.save {
            return false;
        }
        // A jump out of the frame's region tears the frame down.
        let sk = (cx.blocks[(cx.blocks[b as usize]).s0 as usize]).order;
        if (cx.in_frame[(cx.blocks[b as usize]).order as usize]) != 0
            && (sk < 0 || (cx.in_frame[sk as usize]) == 0) {
            return false;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let t = tracked(&mut *cx, v);
            if is_emitted(&mut *cx, v) || (cx.insts[v as usize]).op == Param
                || ((cx.insts[v as usize]).op == Phi && t >= 0 && stored_at_def(&mut *cx, t)) {
                return false;
            }
            v = (cx.insts[v as usize]).next;
        }
        let k = (cx.blocks[b as usize]).order;
        let start = cx.bstart[k as usize];
        let i = gap_index(cx, start);
        if i < cx.split_moves.len() as i64 / 2
            && (cx.split_moves[(2 * i) as usize]) <= (cx.bend[k as usize]) {
            return false;
        }
        plan_start_moves(&mut *cx, b);
        plan_end_moves(&mut *cx, b);
        // UNSAFE: a raw pointer given to an inout parameter (fix --only rawptr).
        // SAFETY: it points to one live value for the whole call, as the raw parameter took it.
        let empty = (0i64..cx.pm.len() as i64 / PM_FIELDS).all(|j| pm_kind(unsafe { &mut *cx }, j)
            == PM_LOC
            // UNSAFE: a raw pointer given to an inout parameter (fix --only rawptr).
            // SAFETY: it points to one live value for the whole call, as the raw parameter took it.
            && pm_dst(unsafe { &mut *cx }, j) == pm_src(unsafe { &mut *cx }, j));
        cx.pm.clear();
        empty
    }
}

fn is_trivial_jump(cx: &mut FnCtx<Comp>, b: i64) -> bool {
    unsafe {
        (cx.blocks[b as usize]).order >= 0
            && (cx.trivial[(cx.blocks[b as usize]).order as usize]) != 0
    }
}

// Where a jump to b really goes: past blocks that only jump on (b itself
// when the chain does not end, in an empty endless loop).
pub fn jump_target(cx: &mut FnCtx<Comp>, b: i64) -> i64 {
    unsafe {
        let mut target = b;
        for _ in 0..16 {
            if target == (*get_irfuncs().add(cx.irf as usize)).entry
                || !is_trivial_jump(cx, target) {
                return target;
            }
            target = (cx.blocks[target as usize]).s0;
        }
        b
    }
}

// Blocks every jump passes by are not emitted at all.
pub fn is_skipped(cx: &mut FnCtx<Comp>, b: i64) -> bool {
    unsafe {
        b != (*get_irfuncs().add(cx.irf as usize)).entry && is_trivial_jump(cx, b)
            && jump_target(cx, b) != b
    }
}

// The block emitted after the one at index j of the emission order, or 0.
fn next_block(cx: &mut FnCtx<Comp>, j: i64) -> i64 {
    if j + 1 < cx.emit.len() as i64 { (cx.emit[(j + 1) as usize]) } else { 0 }
}

pub fn emit_ir_block(cx: &mut FnCtx<Comp>, b: i64, j: i64, pcx: &Ctx<Comp>) {
    let block_label_v = block_label(cx, b);
    emit_label(cx, block_label_v);
    let next_block_v = next_block(cx, j);
    emit_block_code(cx, b, next_block_v, pcx);
}

fn is_duplicable(cx: &mut FnCtx<Comp>, b: i64) -> bool {
    unsafe {
        let term = (cx.blocks[b as usize]).term;
        if b == (*get_irfuncs().add(cx.irf as usize)).entry
            || (cx.blocks[b as usize]).order == cx.save
            || (term != Term::Jump && term != Term::Branch && term != Term::Ret) {
            return false;
        }
        let mut n: i64 = 0;
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            if (cx.insts[v as usize]).op.is_call() || (cx.insts[v as usize]).op == Piece
                || (cx.insts[v as usize]).op == Select && get_x86() {
                return false;
            }
            if is_emitted(cx, v) && !is_fused_compare(cx, v) {
                n += 1;
            }
            v = (cx.insts[v as usize]).next;
        }
        n <= 3
    }
}

// The code of block b (without its label); `next` is the block emitted
// after it (0: none, -1: a copy, which nothing follows).
fn emit_block_code(cx: &mut FnCtx<Comp>, b: i64, next: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let k = (cx.blocks[b as usize]).order;
        let outer = cx.cur_in_frame;
        cx.cur_in_frame = (cx.in_frame[k as usize]) != 0;
        if cx.save > 0 && k == cx.save {
            emit_frame_link(cx);
            emit_frame_setup(cx, pcx);
        } else if !cx.cur_in_frame && is_noreturn_call_block(cx, b, pcx) {
            emit_frame_link(cx);
        }
        emit_block_body(cx, b, next, pcx);
        cx.cur_in_frame = outer;
    }
}

fn emit_block_body(cx: &mut FnCtx<Comp>, b: i64, next: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let k = (cx.blocks[b as usize]).order;
        let start = (cx.bstart[k as usize]);
        cx.ovf_flags = 0;
        plan_start_moves(cx, b);
        pm_resolve(cx, pcx);
        // Phis that go to the stack are stored there.
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let t = tracked(cx, v);
            if (cx.insts[v as usize]).op == Phi && t >= 0 && stored_at_def(cx, t) {
                let loc = tloc(cx, t, start);
                if loc >= 0 {
                    result_done(cx, v, loc, pcx);
                }
            }
            v = (cx.insts[v as usize]).next;
        }
        v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let op = (cx.insts[v as usize]).op;
            if op != Phi && op != Param {
                cx.cur_pos = (cx.insts[v as usize]).mark;
                plan_gap_moves(cx, cx.cur_pos - 1);
                pm_resolve(cx, pcx);
                if is_emitted(cx, v) && !is_fused_compare(cx, v) {
                    if pcx.debug_info {
                        emit_loc(cx, v, pcx);
                    }
                    emit_inst(cx, v, pcx);
                }
            }
            v = (cx.insts[v as usize]).next;
        }
        if cx.tail_called {
            // The callee returns for this block.
            cx.tail_called = false;
            return;
        }
        let end = (cx.bend[k as usize]);
        cx.cur_pos = end;
        plan_gap_moves(cx, end - 1);
        pm_resolve(cx, pcx);
        let term = (cx.blocks[b as usize]).term;
        if term == Term::Jump {
            let s = (cx.blocks[b as usize]).s0;
            let before = cx.st_fn[ST_MOVES as usize] + cx.st_fn[ST_SPILLS as usize] + cx.st_fn[
                ST_RELOADS as usize];
            plan_end_moves(cx, b);
            pm_resolve(cx, pcx);
            if (cx.blocks[s as usize]).order <= k {
                cx.st_fn[ST_BACK as usize] += cx.st_fn[ST_MOVES as usize] + cx.st_fn[
                    ST_SPILLS as usize] + cx.st_fn[ST_RELOADS as usize] - before;
            }
            let target = jump_target(cx, s);
            if cx.cur_in_frame
                && (cx.in_frame[(cx.blocks[target as usize]).order as usize]) == 0 {
                emit_frame_teardown(cx, pcx);
            }
            if target != next {
                if cx.dup_depth < 2 && is_duplicable(cx, target) {
                    cx.dup_depth += 1;
                    // The copy ends where this block does: its next block follows.
                    emit_block_code(cx, target, next, pcx);
                    cx.dup_depth -= 1;
                } else {
                    let block_label_v = block_label(cx, target);
                    m_jump(cx, block_label_v);
                }
            }
        } else if term == Term::Branch {
            emit_branch(cx, b, next);
        } else if term == Term::Switch {
            emit_switch(cx, b, pcx);
        } else if term == Term::Ret {
            let value = (cx.blocks[b as usize]).cond;
            let ret = pcx.fns[(*get_irfuncs().add(cx.irf as usize)).f as usize].ret;
            let c = fn_uses_c((*get_irfuncs().add(cx.irf as usize)).f, pcx);
            if value != 0 && (cx.insts[value as usize]).op == Pack {
                // The pieces of an aggregate result, into the result registers.
                conv_classify(cx, c, ret, pcx);
                for i in 0..(cx.insts[value as usize]).nargs {
                    let conv_return_piece_reg_v = conv_return_piece_reg(cx, c, i, pcx);
                    let ir_arg_v = ir_arg(cx, value, i);
                    pm_add_value(cx, conv_return_piece_reg_v, ir_arg_v,
                        end);
                }
                pm_resolve(cx, pcx);
            }
            else if value != 0 && is_compound(ret, pcx)
                && !conv_returns_through_pointer(cx, c, ret, pcx) {
                // An aggregate returned in registers: its pieces, from its
                // address (out of the way of the result registers).
                conv_classify(cx, c, ret, pcx);
                let mut offset: i64 = 0;
                let mut base = mem_base_any(cx, value, 0, end, &mut offset, pcx);
                for i in 0..cx.abi_piece_count {
                    if base == conv_return_piece_reg(cx, c, i, pcx) {
                        m_mov(cx, reg_move_temp(float: false), base, TY_U64, pcx);
                        base = reg_move_temp(float: false);
                    }
                }
                for i in 0..cx.abi_piece_count {
                    let arg_v = cx.abi_piece_ty[i as usize];
                    let conv_return_piece_reg_v1 = conv_return_piece_reg(cx, c, i, pcx);
                    m_load(cx, arg_v, conv_return_piece_reg_v1, base,
                        offset + cx.abi_piece_offset[i as usize], pcx);
                }
            } else if value != 0 {
                use_into(cx, value, end, reg_ret(is_float((cx.insts[value as usize]).ty)),
                    pcx);
            }
            if next != 0 || !cx.cur_in_frame {
                emit_return(cx, pcx);
            } else {
                cx.fell_into_epilogue = true;
            }
        } else {
            m_trap(cx);
        }
    }
}

fn emit_branch(cx: &mut FnCtx<Comp>, b: i64, next: i64) {
    unsafe {
        let cond = (cx.blocks[b as usize]).cond;
        // Branches have no phi moves (edges into phis are split), so they can
        // skip blocks that only jump on.
        let s0 = jump_target(cx, (cx.blocks[b as usize]).s0);
        let s1 = jump_target(cx, (cx.blocks[b as usize]).s1);
        // Jump to `target` when the condition is `sense`, fall through or jump
        // to `other` otherwise.
        let mut target = s0;
        let mut other = s1;
        let mut sense = true;
        if s0 == next {
            target = s1;
            other = s0;
            sense = false;
        }
        if is_fused_compare(cx, cond) && (cx.insts[cond as usize]).op == Op::Ovf {
            // (0.26.2, a prototype: AArch64 only)
            if get_x86() {
                die(c"internal error: an overflow check on x86-64");
            }
            if cx.ovf_flags == cond {
                let arg_v = (cx.insts[cond as usize]).imm;
                let block_label_v = block_label(cx, target);
                // The flags the operation set (ovf_partner).
                ma_ovf_flag_branch(cx, arg_v, sense, block_label_v);
            } else {
                let a = int_operand(cx, (cx.insts[cond as usize]).a);
                let b: i64 = if (cx.insts[cond as usize]).b
                    != 0 { int_operand(cx, (cx.insts[cond as usize]).b) } else { -1 };
                let arg_v1 = (cx.insts[cond as usize]).imm;
                let block_label_v1 = block_label(cx, target);
                ma_ovf_branch(cx, arg_v1, a, b, sense, block_label_v1);
            }
            cx.ovf_flags = 0;
        } else if is_fused_compare(cx, cond) && (cx.insts[cond as usize]).op == Test {
            let mut op = (cx.insts[cond as usize]).cond;
            if !sense {
                op = op.negate();
            }
            let a = int_operand(cx, (cx.insts[cond as usize]).a);
            let b: i64 = if (cx.insts[cond as usize]).b
                != 0 { int_operand(cx, (cx.insts[cond as usize]).b) } else { -1 };
            if get_x86() {
                let arg_v2 = (cx.insts[cond as usize]).imm;
                let block_label_v2 = block_label(cx, target);
                mx_test_branch(cx, a, b, arg_v2, op == Cond::Ne,
                    block_label_v2);
            } else {
                let arg_v3 = (cx.insts[cond as usize]).imm;
                let block_label_v3 = block_label(cx, target);
                ma_test_branch(cx, a, b, arg_v3, op == Cond::Ne,
                    block_label_v3);
            }
        } else if is_fused_compare(cx, cond) {
            let mut op = (cx.insts[cond as usize]).cond;
            if !sense {
                op = op.negate();
            }
            let ty = (cx.insts[cond as usize]).imm2;
            let a = int_operand(cx, (cx.insts[cond as usize]).a);
            let mut imm: i64 = 0;
            let rhs = (cx.insts[cond as usize]).b;
            if const_of(cx, rhs, &mut imm) && fits_cmp_imm(imm) {
                let block_label_v4 = block_label(cx, target);
                m_cmp_branch(cx, op, ty, a, 0, true, imm, block_label_v4);
            } else {
                let r = int_operand(cx, rhs);
                let block_label_v5 = block_label(cx, target);
                m_cmp_branch(cx, op, ty, a, r, false, 0, block_label_v5);
            }
        } else {
            let r = int_operand(cx, cond);
            let block_label_v6 = block_label(cx, target);
            m_branch_bool(cx, r, sense, block_label_v6);
        }
        if other != next {
            let block_label_v7 = block_label(cx, other);
            m_jump(cx, block_label_v7);
        }
    }
}

// ---- Switches ----

// A switch: a jump table when its cases are dense (at least 4, filling at
// least a third of their range), else a binary search. Like branches,
// switches have no phi moves (edges into phis are split).
fn emit_switch(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let cond = (cx.blocks[b as usize]).cond;
        let ty = (cx.insts[cond as usize]).ty;
        let n = (cx.blocks[b as usize]).ncases;
        cx.sw_values.clear();
        cx.sw_labels.clear();
        for i in 0..n {
            // Insertion in order of the keys (see int_key).
            let key = int_key(case_value(cx, b, i), ty);
            let mut at = cx.sw_values.len() as i64;
            cx.sw_values.push(0);
            cx.sw_labels.push(0);
            while at > 0 && int_key((cx.sw_values[(at - 1) as usize]), ty) > key {
                (cx.sw_values[at as usize]) = (cx.sw_values[(at - 1) as usize]);
                (cx.sw_labels[at as usize]) = (cx.sw_labels[(at - 1) as usize]);
                at -= 1;
            }
            (cx.sw_values[at as usize]) = case_value(cx, b, i);
            let case_target_v = case_target(cx, b, i);
            let jump_target_v = jump_target(cx, case_target_v);
            (cx.sw_labels[at as usize]) = block_label(cx, jump_target_v);
        }
        let jump_target_v1 = jump_target(cx, (cx.blocks[b as usize]).s0);
        let default = block_label(cx, jump_target_v1);
        let r = int_operand(cx, cond);
        if n == 0 {
            m_jump(cx, default);
            return;
        }
        let low = (cx.sw_values[0]);
        // (wrapped, a range past 2^63 values is at most 0: no table)
        let range = int_key((cx.sw_values[(n - 1) as usize]), ty)
            .wrapping_sub(int_key(low, ty))
            .wrapping_add(1);
        if n >= 4 && range > 0 && range <= 3 * n && range <= 4096 {
            // One entry per value of the range: the case's label or the default.
            let table = alloc_array::<i64>(range);
            for i in 0..range {
                (*table.add(i as usize)) = default;
            }
            for i in 0..n {
                (*table.add(((cx.sw_values[i as usize]) - low) as usize)) = (
                    cx.sw_labels[i as usize]);
            }
            if get_x86() {
                mx_jump_table(cx, r, low, range, default, table, pcx);
            } else {
                ma_jump_table(cx, r, low, range, default, table);
            }
            free(table as *mut u8);
            return;
        }
        emit_switch_search(cx, r, ty, 0, n, default);
    }
}

// Compares and branches for the cases lo..hi (sorted), by halves.
fn emit_switch_search(cx: &mut FnCtx<Comp>, r: i64, ty: i64, lo: i64, hi: i64, default: i64) {
    if hi - lo <= 3 {
        for i in lo..hi {
            switch_compare(cx, Cond::Eq, ty, r, (cx.sw_values[i as usize]),
                (cx.sw_labels[i as usize]));
        }
        m_jump(cx, default);
        return;
    }
    let mid = (lo + hi) / 2;
    switch_compare(cx, Cond::Eq, ty, r, (cx.sw_values[mid as usize]),
        (cx.sw_labels[mid as usize]));
    let right = new_label(cx);
    switch_compare(cx, Cond::Gt, ty, r, (cx.sw_values[mid as usize]), right);
    emit_switch_search(cx, r, ty, lo, mid, default);
    emit_label(cx, right);
    emit_switch_search(cx, r, ty, mid + 1, hi, default);
}

// Jumps to `label` when register r <op> value.
fn switch_compare(cx: &mut FnCtx<Comp>, op: Cond, ty: i64, r: i64, value: i64, label: i64) {
    if fits_cmp_imm(value) {
        m_cmp_branch(cx, op, ty, r, 0, true, value, label);
    } else {
        let scratch = reg_move_temp(float: false);
        m_load_imm(cx, scratch, value as u64);
        m_cmp_branch(cx, op, ty, r, scratch, false, 0, label);
    }
}

pub fn fits_cmp_imm(imm: i64) -> bool {
    // AArch64: cmp #imm, or cmn #-imm for a negative one.
    if get_x86() { fits_i32(imm) } else { imm > -4096 && imm < 4096 }
}

// Whether comparison v (CMP) compares integers with a constant that fits
// an immediate.
pub fn is_cmp_imm_operand(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    unsafe {
        let b = (cx.insts[v as usize]).b;
        !is_float((cx.insts[v as usize]).imm2) && b != 0
            && (cx.insts[b as usize]).op == Const
            && fits_cmp_imm((cx.insts[b as usize]).imm)
    }
}
