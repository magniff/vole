// Emission of the intrinsics' IR operations (0.19, docs/design/arch.md
// §5): INTR through the machine layers' templates (mc_arm64/arch.vl,
// mc_x86_64/arch.vl). CPUFEAT is expanded before instruction selection
// (back/isel/arch.vl), VCONST, INTRMEM and HINT have no producer yet
// (T6, T4/T5).

use crate::arch::{intr_imm, intr_param_is_const};
use crate::back::emit::operands::{operand_reg, result_done, result_reg};
use crate::back::mc_arm64::arch::ma_intr;
use crate::back::mc_x86_64::arch::mx_intr;
use crate::base::die;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Op;

// An INTR: its operands a, b, c are its register parameters in order;
// imm2 holds its immediates.
pub fn emit_intr(cx: &mut FnCtx, v: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if (*cx.insts.add(v as usize)).op != Op::Intr {
            die(c"internal error: VCONST and CPUFEAT have no emission yet (0.19 Phase 0)");
        }
        let id = (*cx.insts.add(v as usize)).imm;
        let mut ops: [i64; 8] = [-1; 8];
        let mut imms: [i64; 8] = [0i64; 8];
        let operands: [i64; 3] = [(*cx.insts.add(v as usize)).a, (*cx.insts.add(v as usize)).b, (*cx.insts.add(v as usize)).c];
        let mut next: i64 = 0;
        let mut ci: i64 = 0;
        for k in 0..(*pcx.intrs.add(id as usize)).nparams {
            if intr_param_is_const(id, k, pcx) {
                imms[k as usize] = intr_imm((*cx.insts.add(v as usize)).imm2, ci);
                ci += 1;
            } else {
                ops[k as usize] = operand_reg(cx, operands[next as usize]);
                next += 1;
            }
        }
        let r: i64 = if (*cx.insts.add(v as usize)).ty != 0 { result_reg(cx, v) } else { -1 };
        if get_x86() {
            mx_intr(cx, id, r, &ops[..], &imms[..], pcx);
        } else {
            ma_intr(cx, id, r, &ops[..], &imms[..], pcx);
        }
        if r >= 0 {
            result_done(cx, v, r, pcx);
        }
    }
}
