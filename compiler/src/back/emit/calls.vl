// Calls (emit/mod.vl): where a call's arguments and result go, tail
// calls, and the call itself.

use crate::back::abi::{
    AbiClass, abi_classify, abi_piece_locations, abi_stack_location, abi_variadic_piece_locations,
    conv_classify, conv_return_piece_reg, conv_returns_through_pointer, returns_through_pointer,
    tabi_classify, variadic_kind,
};
use crate::back::emit::function::{emit_frame_teardown, ymm_proven_at};
use crate::back::emit::insts::mem_base_any;
use crate::back::emit::machine::{
    arg_reg, call_uses_c, conv_result_ptr_reg, m_load, m_mov, m_normalize, m_store, reg_callee,
    reg_cycle, reg_move_temp, reg_ret, reg_sp, t_arg_location, xl_from_c, xl_is_stack, xl_offset,
};
use crate::back::emit::operands::{
    PM_LOC, pm_add, pm_add_value, pm_resolve, result_done, result_reg, use_any,
};
use crate::back::regalloc::locations::vloc;
use crate::back::regalloc::prepare::{is_emitted, tracked};
use crate::base::die;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::front::types::{
    TY_BOOL, TY_U64, TY_U8, align_to, fn_param, in_fregs, int_bits, is_compound, is_float,
    is_integer, is_void, scalar_type, type_elem, type_size,
};
use crate::gen0::arm64::a64_call_indirect;
use crate::gen0::gen::{fn_is_global, fn_symbol_prefix};
use crate::gen0::target::{
    arg_location, emit_call, emit_symbol_ref, first_int_arg, function_prefix, global_prefix, ins, o,
    on, rt_note_sym, rt_panic_sym, variadic_arg_location,
};
use crate::gen0::x86_64::x64_call_indirect;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Term, get_irfuncs, ir_arg, ir_type};
use crate::middle::ir::Op::{Call, CallC, CallI, Phi, Piece};
use crate::middle::ir::cfg::pred_index;

// ---- Calls ----

// The function type called by call v: its parameters and result (0 for
// the C library functions of Op::CallC, whose arguments are scalars).
pub fn callee_param_count(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        if op == Call { return pcx.fns[(cx.insts[v as usize]).imm as usize].param_count; }
        if op == CallI { return pcx.types[(cx.insts[v as usize]).imm as usize].count; }
        0
    }
}

pub fn callee_param(cx: &mut FnCtx<Comp>, v: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (cx.insts[v as usize]).op
            == Call { fn_param((cx.insts[v as usize]).imm, i, pcx) }
        else { type_elem((cx.insts[v as usize]).imm, i, pcx) }
    }
}

pub fn callee_result(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        if op == Call { return pcx.fns[(cx.insts[v as usize]).imm as usize].ret; }
        if op == CallI { return pcx.types[(cx.insts[v as usize]).imm as usize].a; }
        0
    }
}

// The location of each argument (IR operand) of call `v` (in
// `locations`), and for aggregates copied onto the stack their size (in
// `copies`, 0 otherwise); returns the size of its stack area, and the
// float registers used in `float_regs`.
pub fn call_locations(cx: &mut FnCtx<Comp>, v: i64, locations: *mut i64, copies: *mut i64,
    float_regs: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if !call_uses_c(cx, v, pcx) {
            return t_call_locations(cx, v, &mut *locations, &mut *copies, float_regs, pcx);
        }
        let mut state: [i64; 3] = [{
            let at_arg1 = callee_result(cx, v, pcx); first_int_arg(cx, at_arg1, pcx)
        }, 0, 0];
        let mut j: i64 = 0;
        for i in 0..callee_param_count(cx, v, pcx) {
            let ty = callee_param(cx, v, i, pcx);
            if is_void(ty) {
                continue;
            }
            let kind = abi_classify(cx, ty, pcx);
            if kind == AbiClass::Pieces {
                abi_piece_locations(cx, ty, state.as_mut_ptr() as *mut i64,
                    locations.add(j as usize), pcx);
                for k in 0..cx.abi_piece_count {
                    (*copies.add((j + k) as usize)) = 0;
                }
                j += cx.abi_piece_count;
            } else if kind == AbiClass::Stack {
                (*locations.add(j as usize)) = abi_stack_location(ty,
                    state.as_mut_ptr() as *mut i64, pcx);
                (*copies.add(j as usize)) = type_size(ty, pcx);
                j += 1;
            } else {
                (*locations.add(j as usize)) = arg_location(if kind == AbiClass::Ref { TY_U64 }
                    else { scalar_type(ty, pcx) }, state.as_mut_ptr() as *mut i64, pcx);
                (*copies.add(j as usize)) = 0;
                j += 1;
            }
        }
        // The `...` arguments, and the arguments of C library functions.
        while j < (cx.insts[v as usize]).nargs {
            let ty = (cx.argty[((cx.insts[v as usize]).args + j) as usize]);
            (*copies.add(j as usize)) = 0;
            if ty < 0 && is_compound(0 - ty, pcx) {
                let t = 0 - ty;
                let kind = variadic_kind(cx, t, pcx);
                if kind == AbiClass::Pieces {
                    abi_variadic_piece_locations(cx, t, state.as_mut_ptr() as *mut i64,
                        locations.add(j as usize), pcx);
                    for k in 0..cx.abi_piece_count {
                        (*copies.add((j + k) as usize)) = 0;
                    }
                    j += cx.abi_piece_count;
                } else if kind == AbiClass::Stack {
                    (*locations.add(j as usize)) = abi_stack_location(t,
                        state.as_mut_ptr() as *mut i64, pcx);
                    (*copies.add(j as usize)) = type_size(t, pcx);
                    j += 1;
                } else {
                    (*locations.add(j as usize)) = variadic_arg_location(TY_U64,
                        state.as_mut_ptr() as *mut i64, pcx);
                    j += 1;
                }
                continue;
            }
            if ty < 0 {
                (*locations.add(j as usize)) = variadic_arg_location(0 - ty,
                    state.as_mut_ptr() as *mut i64, pcx);
            } else {
                (*locations.add(j as usize)) = arg_location(ty, state.as_mut_ptr() as *mut i64,
                    pcx);
            }
            j += 1;
        }
        for i in 0..j {
            (*locations.add(i as usize)) = xl_from_c((*locations.add(i as usize)));
        }
        *float_regs = state[1];
        align_to(state[2], 16)
    }
}

// call_locations for a call under the vole convention.
fn t_call_locations(cx: &mut FnCtx<Comp>, v: i64, locations: *mut i64, copies: *mut i64,
    float_regs: &mut i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let first: i64 = if {
            let at_arg2 = callee_result(cx, v, pcx);
            conv_returns_through_pointer(cx, false, at_arg2, pcx)
        } {
            1
        }
            else { 0 };
        let mut state: [i64; 3] = [first, 0, 0];
        let mut j: i64 = 0;
        for i in 0..callee_param_count(cx, v, pcx) {
            let ty = callee_param(cx, v, i, pcx);
            if is_void(ty) {
                continue;
            }
            let kind = tabi_classify(cx, ty, pcx);
            if kind == AbiClass::Pieces {
                for k in 0..cx.abi_piece_count {
                    (*locations.add(j as usize)) = t_arg_location(cx.abi_piece_ty[k as usize],
                        state.as_mut_ptr() as *mut i64, pcx);
                    (*copies.add(j as usize)) = 0;
                    j += 1;
                }
            } else {
                (*locations.add(j as usize)) = t_arg_location(if kind == AbiClass::Ref { TY_U64 }
                    else { scalar_type(ty, pcx) }, state.as_mut_ptr() as *mut i64, pcx);
                (*copies.add(j as usize)) = 0;
                j += 1;
            }
        }
        if j != (cx.insts[v as usize]).nargs {
            die(c"internal error: arguments of a vole call");
        }
        *float_regs = state[1];
        align_to(state[2], 16)
    }
}

pub fn call_stack_size(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (cx.insts[v as usize]).nargs > 64 {
            die(c"too many arguments (at most 64 are supported)");
        }
        let mut locations: [i64; 64] = [0i64; 64];
        let mut copies: [i64; 64] = [0i64; 64];
        let mut float_regs: i64 = 0;
        call_locations(cx, v, locations.as_mut_ptr() as *mut i64, copies.as_mut_ptr() as *mut i64,
            &mut float_regs, pcx)
    }
}

// Whether call v is a sibling call (at -O2): the last instruction of a
// block returning its result (or nothing), from a vole function, to a
// non-variadic callee taking no argument on the stack and returning no
// aggregate, with the same result type, in a function whose frame no
// callee can see.
fn is_tail_call(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        let b = (cx.insts[v as usize]).block;
        if pcx.opt_level < 2 || cx.uses_slots || cx.returns_twice || (op != Call && op != CallI)
            || (cx.insts[v as usize]).next != 0
            || (cx.insts[v as usize]).c != 0 {
            return false;
        }
        let f = (*get_irfuncs().add(cx.irf as usize)).f;
        let ret = pcx.fns[f as usize].ret;
        if pcx.fns[f as usize].is_extern || pcx.fns[f as usize].export || fn_is_global(f, pcx)
            || is_compound(ret, pcx)
            || returns_through_pointer(cx, ret, pcx) {
            return false;
        }
        // The returning block: b, or the block b jumps to when it does
        // nothing but return (a phi of the result).
        let mut returning = b;
        let mut result = v;
        if (*cx.blocks.add(b as usize)).term == Term::Jump {
            returning = (*cx.blocks.add(b as usize)).s0;
            let mut w = (*cx.blocks.add(returning as usize)).first;
            while w != 0 {
                if (cx.insts[w as usize]).op != Phi && is_emitted(cx, w) {
                    return false;
                }
                if w == (*cx.blocks.add(returning as usize)).cond {
                    if (cx.insts[w as usize]).op != Phi {
                        return false;
                    }
                    result = w;
                    let pred_index_v = pred_index(cx, returning, b);
                    let ir_arg_v = ir_arg(cx, w, pred_index_v);
                    if ir_arg_v != v {
                        return false;
                    }
                }
                w = (cx.insts[w as usize]).next;
            }
        }
        if (*cx.blocks.add(returning as usize)).term != Term::Ret {
            return false;
        }
        let value = (*cx.blocks.add(returning as usize)).cond;
        if value != 0 && (value != result || (cx.insts[v as usize]).ty != ir_type(ret, pcx)) {
            return false;
        }
        if value == 0 && !is_void(ret) {
            return false;
        }
        if op == Call && pcx.fns[(cx.insts[v as usize]).imm as usize].variadic {
            return false;
        }
        call_stack_size(cx, v, pcx) == 0
    }
}

// The pieces of call v's aggregate result (see add_piece_defs): from the
// result registers to their locations (narrow integers normalized).
fn emit_call_pieces(cx: &mut FnCtx<Comp>, v: i64, c: bool, ret: i64, pcx: &Ctx<Comp>) {
    unsafe {
        // (0.17: only a call returning an aggregate has pieces)
        if !is_compound(ret, pcx) {
            return;
        }
        let mut w = (cx.insts[v as usize]).next;
        let mut any = false;
        while w != 0 {
            if (cx.insts[w as usize]).op == Piece && (cx.insts[w as usize]).a == v
                && tracked(cx, w) >= 0 {
                if !any {
                    conv_classify(cx, c, ret, pcx);
                    any = true;
                }
                let ty = (cx.insts[w as usize]).ty;
                let reg = conv_return_piece_reg(cx, c, (cx.insts[w as usize]).imm, pcx);
                if ty == TY_BOOL || (is_integer(ty) && int_bits(ty) < 64) {
                    m_normalize(cx, reg, if ty == TY_BOOL { TY_U8 } else { ty });
                }
                let vloc_v = vloc(cx, w, cx.cur_pos + 2);
                pm_add(cx, vloc_v, PM_LOC, reg, ty, 0, w);
            }
            w = (cx.insts[w as usize]).next;
        }
        if !any {
            return;
        }
        pm_resolve(cx, pcx);
        w = (cx.insts[v as usize]).next;
        while w != 0 {
            if (cx.insts[w as usize]).op == Piece && (cx.insts[w as usize]).a == v
                && tracked(cx, w) >= 0 {
                let vloc_v1 = vloc(cx, w, cx.cur_pos + 2);
                result_done(cx, w, vloc_v1, pcx);
            }
            w = (cx.insts[w as usize]).next;
        }
    }
}

pub fn emit_call_inst(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let op = (cx.insts[v as usize]).op;
        let mut locations: [i64; 64] = [0i64; 64];
        let mut copies: [i64; 64] = [0i64; 64];
        let mut float_regs: i64 = 0;
        call_locations(cx, v, locations.as_mut_ptr() as *mut i64, copies.as_mut_ptr() as *mut i64,
            &mut float_regs, pcx);
        // Stack arguments first: their sources are still intact.
        let c = call_uses_c(cx, v, pcx);
        for i in 0..(cx.insts[v as usize]).nargs {
            let location = locations[i as usize];
            if !xl_is_stack(location) {
                continue;
            }
            let arg = ir_arg(cx, v, i);
            if copies[i as usize] > 0 {
                // An aggregate copied onto the stack, in 8-byte pieces (its
                // private copy is a multiple of 8 bytes), through registers no
                // value is allocated to.
                let mut offset: i64 = 0;
                let src = mem_base_any(cx, arg, 0, cx.cur_pos, &mut offset, pcx);
                let temp = reg_cycle(false);
                let mut k: i64 = 0;
                while k < copies[i as usize] {
                    m_load(cx, TY_U64, temp, src, offset + k, pcx);
                    m_store(cx, TY_U64, temp, reg_sp(), xl_offset(location) + k, pcx);
                    k += 8;
                }
                continue;
            }
            let declared = (cx.argty[((cx.insts[v as usize]).args + i) as usize]);
            let variadic = declared < 0;
            let ty = if variadic { 0 - declared } else { declared };
            let value_ty = (cx.insts[arg as usize]).ty;
            let r = use_any(cx, arg, cx.cur_pos, reg_move_temp(in_fregs(value_ty, pcx)), pcx);
            let mut store_ty = value_ty;
            if !in_fregs(value_ty, pcx) {
                // Apple's arm64 ABI packs fixed stack arguments at their size;
                // everything else takes 8 bytes.
                store_ty = TY_U64;
                if c && pcx.apple_a64 && !variadic && !is_compound(ty, pcx)
                    && type_size(ty, pcx) < 8 {
                    store_ty = ty;
                }
            }
            m_store(cx, store_ty, r, reg_sp(), xl_offset(location), pcx);
        }
        for i in 0..(cx.insts[v as usize]).nargs {
            let location = locations[i as usize];
            if !xl_is_stack(location) {
                let arg_reg_v = arg_reg(location);
                let ir_arg_v = ir_arg(cx, v, i);
                pm_add_value(cx, arg_reg_v, ir_arg_v, cx.cur_pos);
            }
        }
        let ret = callee_result(cx, v, pcx);
        let through_pointer = (cx.insts[v as usize]).c != 0
            && conv_returns_through_pointer(cx, c, ret, pcx);
        if through_pointer {
            pm_add_value(cx, conv_result_ptr_reg(c), (cx.insts[v as usize]).c, cx.cur_pos);
        }
        if op == CallI {
            pm_add_value(cx, reg_callee(), (cx.insts[v as usize]).a, cx.cur_pos);
        }
        pm_resolve(cx, pcx);
        if ymm_proven_at(cx, v, pcx) {
            // (0.19: AVX code calls with clean upper ymm state; 256-bit
            // values go as two xmm halves, which vzeroupper keeps)
            ins(cx, c"vzeroupper");
        }
        if is_tail_call(cx, v, pcx) {
            // The frame goes, then a jump: the callee returns to our caller.
            emit_frame_teardown(cx, pcx);
            if op == Call {
                let f = (cx.insts[v as usize]).imm;
                o(cx, if get_x86() { c"    jmp " } else { c"    b " });
                emit_symbol_ref(cx, fn_symbol_prefix(f, pcx), pcx.fns[f as usize].name, pcx);
                if get_x86() && get_elf()
                    && (pcx.fns[f as usize].is_extern || pcx.fns[f as usize].export) {
                    o(cx, c"@PLT");
                }
                on(cx);
            } else {
                ins(cx, if get_x86() { c"jmp *%r11" } else { c"br x16" });
            }
            cx.tail_called = true;
            return;
        }
        if op == Call {
            let f = (cx.insts[v as usize]).imm;
            emit_call(cx, fn_symbol_prefix(f, pcx), pcx.fns[f as usize].name,
                pcx.fns[f as usize].is_extern || pcx.fns[f as usize].export,
                pcx.fns[f as usize].variadic, float_regs, pcx);
        }
        else if op == CallC
            && ((cx.insts[v as usize]).imm == rt_panic_sym(pcx)
                || (cx.insts[v as usize]).imm == rt_note_sym(pcx)) {
            emit_call(cx, function_prefix(), (cx.insts[v as usize]).imm, false, false, 0, pcx);
        } else if op == CallC {
            emit_call(cx, global_prefix(), (cx.insts[v as usize]).imm, true, false, 0, pcx);
        } else if get_x86() {
            x64_call_indirect(cx);
        } else {
            a64_call_indirect(cx);
        }
        emit_call_pieces(cx, v, c, ret, pcx);
        if (cx.insts[v as usize]).c != 0 && !through_pointer {
            // An aggregate result in registers: stored in pieces into its slot.
            conv_classify(cx, c, ret, pcx);
            let mut offset: i64 = 0;
            let base = mem_base_any(cx, (cx.insts[v as usize]).c, 0, cx.cur_pos + 2,
                &mut offset, pcx);
            for k in 0..cx.abi_piece_count {
                let arg_v = cx.abi_piece_ty[k as usize];
                let conv_return_piece_reg_v = conv_return_piece_reg(cx, c, k, pcx);
                m_store(cx, arg_v, conv_return_piece_reg_v, base,
                    offset + cx.abi_piece_offset[k as usize], pcx);
            }
            return;
        }
        let ty = (cx.insts[v as usize]).ty;
        if ty == 0 || tracked(cx, v) < 0 {
            return;
        }
        let ret_reg = reg_ret(is_float(ty));
        if ty == TY_BOOL || (is_integer(ty) && int_bits(ty) < 64) {
            m_normalize(cx, ret_reg, if ty == TY_BOOL { TY_U8 } else { ty });
        }
        let r = result_reg(cx, v);
        m_mov(cx, r, ret_reg, ty, pcx);
        result_done(cx, v, r, pcx);
    }
}
