// ---- Functions ----

fn layout_frame(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        cx.frame_out = 0;
        cx.frame_align = 16;
        cx.has_calls = false;
        cx.uses_slots = false;
        // Slots no instruction refers to any more (scalar replacement took
        // them apart) get no room: offset -1.
        for i in 0..(*get_irfuncs().add(fi as usize)).slots.len() as i64 {
            (cx.slots[((*get_irfuncs().add(fi as usize)).slots[i as usize]) as usize]).offset = -1;
        }
        for i in 0..cx.order.len() as i64 {
            let mut v = (cx.blocks[(cx.order[i as usize]) as usize]).first;
            while v != 0 {
                if (cx.insts[v as usize]).op.is_call() && is_emitted(cx, v) {
                    cx.has_calls = true;
                }
                if (cx.insts[v as usize]).op == Slot
                    && (*cx.regalloc_uses.add(v as usize)) > 0 {
                    { let at_ix = (cx.insts[v as usize]).imm as usize;
                        (cx.slots[at_ix]).offset = 0 };
                    cx.uses_slots = true;
                }
                if (cx.insts[v as usize]).op.is_call() {
                    let size = call_stack_size(cx, v, pcx);
                    if size > cx.frame_out {
                        cx.frame_out = size;
                    }
                    if (cx.insts[v as usize]).op != CallC {
                        for k in 0..callee_param_count(cx, v, pcx) {
                            cx.frame_align = max_i64(cx.frame_align,
                                type_align(callee_param(cx, v, k, pcx), pcx));
                        }
                    }
                    // Aggregates passed to `...` (their first piece carries the
                    // type, negated).
                    for k in 0..(cx.insts[v as usize]).nargs {
                        let declared = (cx.argty[((cx.insts[v as usize]).args + k) as usize]);
                        if declared < 0 && declared != VARIADIC_PIECE {
                            cx.frame_align = max_i64(cx.frame_align, type_align(0 - declared, pcx));
                        }
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
        }
        let mut offset = align_to(cx.frame_out, if cx.spill_vectors { 16 } else { 8 });
        cx.spill_base = offset;
        offset += 8 * cx.spill_count;
        cx.save_base = offset;
        offset += 8 * cx.callee_used[0..64]
            .iter()
            .copied()
            .filter(|x| ({ let u = *x; u != 0 }))
            .count() as i64;
        if offset > 32760 {
            die(c"internal error: too many spill slots");
        }
        for s in (*get_irfuncs().add(fi as usize)).slots.items() {
            if (cx.slots[s as usize]).offset < 0 {
                continue;
            }
            offset = align_to(offset, (cx.slots[s as usize]).align);
            (cx.slots[s as usize]).offset = offset;
            offset += (cx.slots[s as usize]).size;
            cx.frame_align = max_i64(cx.frame_align, (cx.slots[s as usize]).align);
        }
        cx.frame_total = align_to(offset, 16);
    }
}

// Saves (or restores) the callee-saved registers used: on AArch64 two at
// a time (stp, ldp) when they are of one kind.
fn save_callee_saved(cx: &mut FnCtx<Comp>, restore: bool, pcx: &Ctx<Comp>) {
    let mut offset = cx.save_base;
    let mut pending: i64 = -1;
    for r in 0..64 {
        if cx.callee_used[r as usize] == 0 {
            continue;
        }
        if !get_x86() && pending >= 0 && (pending >= 32) == (r >= 32) && offset - 8 <= 504 {
            ma_pair(cx, restore, pending, r, offset - 8, pcx);
            pending = -1;
        } else {
            if pending >= 0 {
                save_one(cx, restore, pending, offset - 8, pcx);
            }
            pending = r;
        }
        offset += 8;
    }
    if pending >= 0 {
        save_one(cx, restore, pending, offset - 8, pcx);
    }
}

fn save_one(cx: &mut FnCtx<Comp>, restore: bool, r: i64, offset: i64, pcx: &Ctx<Comp>) {
    let ty = if r >= 32 { TY_F64 } else { TY_U64 };
    if restore {
        m_load(cx, ty, r, reg_sp(), offset, pcx);
    } else {
        m_store(cx, ty, r, reg_sp(), offset, pcx);
    }
}

// The location of each parameter of function `f` (by its convention): of
// parameter i at locations[i], or of its pieces at pieces[4 * i + k] (see
// abi.vl).
pub fn param_locations(cx: &mut FnCtx<Comp>, f: i64, locations: *mut i64, pieces: *mut i64,
    pcx: &Ctx<Comp>) {
    unsafe {
        let c = fn_uses_c(f, pcx);
        let ret = pcx.fns[f as usize].ret;
        let first: i64 = if c { first_int_arg(cx, ret, pcx) }
            else if conv_returns_through_pointer(cx, false, ret, pcx) { 1 } else { 0 };
        let mut state: [i64; 3] = [first, 0, 0];
        for i in 0..pcx.fns[f as usize].param_count {
            let ty = fn_param(f, i, pcx);
            if is_void(ty) {
                continue;
            }
            let kind = conv_classify(cx, c, ty, pcx);
            if !c {
                if kind == AbiClass::Pieces {
                    for k in 0..cx.abi_piece_count {
                        (*pieces.add((4 * i + k) as usize)) = t_arg_location(
                            cx.abi_piece_ty[k as usize], state.as_mut_ptr() as *mut i64, pcx);
                    }
                } else {
                    (*locations.add(i as usize)) = t_arg_location(if kind
                        == AbiClass::Ref { TY_U64 }
                        else { scalar_type(ty, pcx) }, state.as_mut_ptr() as *mut i64, pcx);
                }
                continue;
            }
            if kind == AbiClass::Pieces {
                abi_piece_locations(cx, ty, state.as_mut_ptr() as *mut i64,
                    pieces.add((4 * i) as usize), pcx);
                for k in 0..cx.abi_piece_count {
                    (*pieces.add((4 * i + k) as usize)) = xl_from_c(
                        (*pieces.add((4 * i + k) as usize)));
                }
            } else if kind == AbiClass::Stack {
                (*locations.add(i as usize)) = xl_from_c(abi_stack_location(ty,
                    state.as_mut_ptr() as *mut i64, pcx));
            } else {
                (*locations.add(i as usize)) = xl_from_c(arg_location(if kind
                    == AbiClass::Ref { TY_U64 }
                    else { scalar_type(ty, pcx) }, state.as_mut_ptr() as *mut i64, pcx));
            }
        }
    }
}

// Moves the parameters from where the caller put them to their locations.
fn emit_entry_moves(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let f = (*get_irfuncs().add(fi as usize)).f;
        let mut locations: [i64; 64] = [0i64; 64];
        let mut pieces: [i64; 256] = [0i64; 256];
        if pcx.fns[f as usize].param_count > 64 {
            die(c"too many parameters (at most 64 are supported)");
        }
        param_locations(cx, f, locations.as_mut_ptr() as *mut i64, pieces.as_mut_ptr() as *mut i64,
            pcx);
        let entry = (*get_irfuncs().add(fi as usize)).entry;
        let mut v = (cx.blocks[entry as usize]).first;
        while v != 0 {
            let loc = vloc(cx, v, 0);
            if (cx.insts[v as usize]).op == Param && loc != LOC_NONE {
                let ty = (cx.insts[v as usize]).ty;
                let index = (cx.insts[v as usize]).imm;
                let piece = (cx.insts[v as usize]).imm2;
                if index < 0 {
                    pm_add(cx, loc, PM_LOC, conv_result_ptr_reg(fn_uses_c(f, pcx)), TY_U64, 0, v);
                } else {
                    let location = if piece > 0 { pieces[(4 * index + piece - 1) as usize] }
                        else { locations[index as usize] };
                    // Stack arguments are 16 bytes above the frame pointer.
                    if piece < 0 {
                        pm_add(cx, loc, PM_ADDR, 16 + xl_offset(location), TY_U64, 0, v);
                    } else if xl_is_stack(location) {
                        let param_ty = fn_param(f, index, pcx);
                        let load_ty = if is_compound(param_ty, pcx) && piece == 0 { TY_U64 }
                            else { ty };
                        pm_add(cx, loc, PM_STACK, 16 + xl_offset(location), load_ty, 0, v);
                    } else {
                        pm_add(cx, loc, PM_LOC, arg_reg(location), ty, 0, v);
                    }
                }
            }
            v = (cx.insts[v as usize]).next;
        }
        pm_resolve(cx, pcx);
        // Narrow integers from C callers may carry garbage above their width;
        // parameters that go to the stack are stored there.
        v = (cx.blocks[entry as usize]).first;
        while v != 0 {
            let ty = (cx.insts[v as usize]).ty;
            let t = tracked(cx, v);
            if (cx.insts[v as usize]).op == Param && t >= 0 {
                let narrow = (cx.insts[v as usize]).imm >= 0
                    && (ty == TY_BOOL || (is_integer(ty) && int_bits(ty) < 64));
                let loc = tloc(cx, t, 0);
                if loc >= 0 {
                    if narrow {
                        m_normalize(cx, loc, if ty == TY_BOOL { TY_U8 } else { ty });
                    }
                    result_done(cx, v, loc, pcx);
                } else if narrow {
                    let r = reg_move_temp(float: false);
                    let reg_sp_v = reg_sp();
                    let spill_offset_v = spill_offset(cx, loc);
                    m_load(cx, TY_U64, r, reg_sp_v, spill_offset_v, pcx);
                    m_normalize(cx, r, if ty == TY_BOOL { TY_U8 } else { ty });
                    let reg_sp_v1 = reg_sp();
                    let spill_offset_v1 = spill_offset(cx, loc);
                    m_store(cx, TY_U64, r, reg_sp_v1, spill_offset_v1, pcx);
                }
            }
            v = (cx.insts[v as usize]).next;
        }
    }
}

pub fn gen_ir_function(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        ir_enter(cx, fi, pcx);
        let f = (*get_irfuncs().add(fi as usize)).f;
        allocate_registers(cx, fi, pcx);
        pass_done(P_REGALLOC, pcx);
        if pcx.verify_regalloc {
            check_allocation(cx, fi, pcx);
        }
        layout_frame(cx, fi, pcx);
        cx.ymm_used = get_x86() && holds_ymm(cx, fi, pcx);
        shrink_wrap(cx, fi, pcx);
        cx.short_branches = function_size(cx, fi) <= 800;
        find_trivial_jumps(cx);
        layout_emission(cx, pcx);
        pass_done(P_FRAME_LAYOUT, pcx);
        buf_clear(cx.code);
        // The peepholes' memory of what was just emitted belongs to the code of
        // the function before (whose length the new one's may match).
        cx.last_mov_end = -1;
        cx.last_store_end = -1;
        cx.pair_end = -1;
        cx.last_select = 0;
        cx.last_select_end = -1;
        cx.label_base = cx.label_count + 1;
        cx.label_count += cx.order.len() as i64;
        cx.epilogue_label = new_label(cx);
        cx.epilogue_used = false;
        cx.fell_into_epilogue = false;
        cx.has_frame = cx.save >= 0;
        cx.last_loc = 0;
        let item = (*get_irfuncs().add(fi as usize)).item;
        dbg_function_begin(cx, f, fn_symbol_prefix(f, pcx),
            if item > 0 { pcx.nodes[item as usize].start } else { -1 }, pcx);
        ir_function_start(cx, fn_symbol_prefix(f, pcx), pcx.fns[f as usize].name,
            fn_is_global(f, pcx), cx.save == 0, pcx);
        cx.cur_in_frame = cx.save == 0;
        if cx.save == 0 {
            emit_frame_setup(cx, pcx);
        }
        emit_entry_moves(cx, fi, pcx);
        for j in 0..cx.emit.len() as i64 {
            emit_ir_block(cx, (cx.emit[j as usize]), j, pcx);
        }
        // The epilogue, when a block jumps to it or the last one falls into it
        // (blocks in the frame's region only).
        if cx.epilogue_used || cx.fell_into_epilogue {
            cx.cur_in_frame = true;
            emit_label(cx, cx.epilogue_label);
            emit_ir_epilogue(cx, pcx);
        }
        if pcx.stats > 0 {
            if cx.has_frame {
                cx.st_fn[ST_FRAMES as usize] = 1;
                cx.st_fn[ST_FRAME as usize] = cx.frame_total + 16;
            }
            cx.st_fn[ST_SAVES as usize] += cx.callee_used[0..64]
                .iter()
                .copied()
                .filter(|x| ({ let u = *x; u != 0 }))
                .count() as i64;
            st_function_done(cx, fi, pcx);
        }
        buf_bytes(cx.asm, buf_slice(cx.code));
        dbg_function_end(cx, pcx);
        pass_done(P_EMIT, pcx);
    }
}

// (0.19) Whether function fi computes a 256-bit value (x86-64: in a ymm
// register; only AVX instructions make one). If so, where AVX is proven
// (cx.ymm_in, cx.ymm_ret): vzeroupper is an AVX instruction, so it goes
// only where every path ran one that wrote a ymm register (a must
// analysis over the blocks); elsewhere the upper halves stay as they are,
// which costs a transition at worst, never an instruction the CPU lacks.
fn holds_ymm(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let n = cx.order.len() as i64;
        let mut defs = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut any = false;
        for k in 0..n {
            let d: i64 = if block_writes_ymm(cx, (cx.order[k as usize]), 0, pcx) { 1 }
                else { 0 };
            defs.push(d);
            any = any || d != 0;
        }
        cx.ymm_in.clear();
        if !any {
            free(defs.data as *mut u8);
            return false;
        }
        for k in 0..n {
            cx.ymm_in.push(if k == 0 { 0 } else { 1 });
        }
        let mut changed = true;
        while changed {
            changed = false;
            for k in 1..n {
                let b = (cx.order[k as usize]);
                let mut v: i64 = if (cx.blocks[b as usize]).preds.len() as i64 == 0 { 0 }
                    else { 1 };
                for i in 0..(cx.blocks[b as usize]).preds.len() as i64 {
                    let p = (cx.blocks[((cx.blocks[b as usize]).preds[i as usize]) as usize]).order;
                    if p < 0 || p >= n
                        || ((cx.ymm_in[p as usize]) == 0
                            && (defs[p as usize]) == 0) {
                        v = 0;
                    }
                }
                if v != (cx.ymm_in[k as usize]) {
                    (cx.ymm_in[k as usize]) = v;
                    changed = true;
                }
            }
        }
        cx.ymm_ret = true;
        for k in 0..n {
            let b = (cx.order[k as usize]);
            if (cx.blocks[b as usize]).term == Term::Ret
                && (cx.ymm_in[k as usize]) == 0 && (defs[k as usize]) == 0 {
                cx.ymm_ret = false;
            }
        }
        free(defs.data as *mut u8);
        true
    }
}

// Whether block b writes a ymm register before instruction `before` (0:
// anywhere in it).
fn block_writes_ymm(cx: &mut FnCtx<Comp>, b: i64, before: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 && v != before {
            let ty = (cx.insts[v as usize]).ty;
            if ty != 0 && is_vector(ty, pcx) && type_size(ty, pcx) == 32 {
                return true;
            }
            v = (cx.insts[v as usize]).next;
        }
        false
    }
}

// (0.19) Whether AVX is proven at instruction v (holds_ymm): a vzeroupper
// may go there.
pub fn ymm_proven_at(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if !cx.ymm_used {
            return false;
        }
        let b = (cx.insts[v as usize]).block;
        let k = (cx.blocks[b as usize]).order;
        (k >= 0 && k < cx.ymm_in.len() as i64 && (cx.ymm_in[k as usize]) != 0)
            || block_writes_ymm(cx, b, v, pcx)
    }
}

// (0.17) Every live IR function, in order: at -O1 (PER_FUNCTION) the small
// leaves' calls inlined and the scalar pipeline run here, then
// instruction selection, register allocation and emission, end to end;
// each function's IR is freed once it is emitted (or dropped), so the IR
// in flight is one function's per thread, at -O2 the optimized program's
// at most. -O1's small leaves come last: the functions after one inline
// its IR as the middle end left it, not as instruction selection makes it.
// (0.18.1) Each function is a task (emit_task) with a text of its own,
// joined in this order (middle::parallel).
pub fn emit_ir_functions(cx: &mut FnCtx<Comp>, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut order = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for fi in 0..pcx.irfunc_count {
            if !leaf_kept(fi, pcx) {
                order.push(fi);
            }
        }
        let split = order.len() as i64;
        for fi in 0..pcx.irfunc_count {
            if leaf_kept(fi, pcx) {
                order.push(fi);
            }
        }
        emit_functions(cx, order, split, pcx);
        free(order.data as *mut u8);
        parallel_end(pcx);
    }
}

// One function of emit_ir_functions, in a task's context: -O2's waiting
// loop passes and SLP, -O1's pipeline, then its code into cx's text, its
// labels numbered from 1 (the join renumbers them); then its IR freed.
pub fn emit_task(cx: &mut FnCtx<Comp>, fi: i64, rank: i64, pcx: &Ctx<Comp>) {
    unsafe {
        if pcx.opt_level >= 2 {
            cx.task_phase = P_DEFERRED;
            cx.task_rank = fi;
            deferred_loops(cx, fi, pcx);
            cx.task_phase = P_SLP;
            slp_function(cx, fi, pcx);
        }
        cx.task_phase = P_EMIT;
        cx.task_rank = rank;
        cx.label_count = 0;
        cx.local_labels = true;
        if (*pcx.fn_live.add(fi as usize)) != 0 && !leaf_dropped(fi, pcx) {
            if pcx.per_function {
                let t = timer_now(pcx);
                optimize_function(cx, fi, pcx);
                timer_add(T_SCALAR, t, pcx);
            }
            let t = timer_now(pcx);
            select_function(cx, fi, pcx);
            pass_done(P_ISEL, pcx);
            timer_add(T_ISEL, t, pcx);
            let t2 = timer_now(pcx);
            count_uses(cx, fi, pcx);
            gen_ir_function(cx, fi, pcx);
            timer_add(T_CODEGEN, t2, pcx);
        }
        cx.local_labels = false;
        ir_free_func(cx, fi, pcx);
    }
}

// (-g) The `.loc` of instruction v, when it starts another statement. The
// peepholes that look at what was just emitted see through it.
pub fn emit_loc(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let loc = (cx.inst_loc[v as usize]);
        if loc == 0 || loc == cx.last_loc {
            return;
        }
        cx.last_loc = loc;
        let before = (*get_bufs().add(cx.code as usize)).len;
        dbg_loc(cx.code, loc - 1, pcx);
        let after = (*get_bufs().add(cx.code as usize)).len;
        if cx.last_mov_end == before {
            cx.last_mov_end = after;
        }
        if cx.last_store_end == before {
            cx.last_store_end = after;
        }
        if cx.last_select_end == before {
            cx.last_select_end = after;
        }
    }
}

fn emit_ir_epilogue(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    if cx.ymm_used && cx.ymm_ret {
        // (0.19: no dirty upper ymm state leaves the function)
        ins(cx, c"vzeroupper");
    }
    if !cx.cur_in_frame {
        ins(cx, c"ret");
        return;
    }
    save_callee_saved(cx, restore: true, pcx: pcx);
    if !cx.has_frame {
        ins(cx, c"ret");
    } else if get_x86() {
        x64_epilogue(cx);
    } else {
        a64_epilogue(cx);
    }
}

// A return from a block that is not the last: the epilogue itself when it
// is short (at most 4 registers to restore), else a jump to it.
pub fn emit_return(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    if !cx.cur_in_frame {
        if cx.ymm_used && cx.ymm_ret {
            ins(cx, c"vzeroupper");
        }
        ins(cx, c"ret");
        return;
    }
    let saved = cx.callee_used[0..64].iter().copied().filter(|x| ({ let u = *x; u != 0 })).count();
    if saved <= 4 {
        emit_ir_epilogue(cx, pcx);
    } else {
        cx.epilogue_used = true;
        m_jump(cx, cx.epilogue_label);
    }
}

// The number of instructions of function fi.
fn function_size(cx: &mut FnCtx<Comp>, fi: i64) -> i64 {
    unsafe {
        let mut n: i64 = 0;
        for i in 0..cx.order.len() as i64 {
            let mut v = (cx.blocks[(cx.order[i as usize]) as usize]).first;
            while v != 0 {
                n += 1;
                v = (cx.insts[v as usize]).next;
            }
        }
        n
    }
}

// Whether function fi has parameters on the stack (read from the frame
// pointer: the frame is then set up at its entry).
fn has_stack_params(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let f = (*get_irfuncs().add(fi as usize)).f;
        let mut locations: [i64; 64] = [0i64; 64];
        let mut pieces: [i64; 256] = [0i64; 256];
        if pcx.fns[f as usize].param_count > 64 {
            return true;
        }
        param_locations(cx, f, locations.as_mut_ptr() as *mut i64, pieces.as_mut_ptr() as *mut i64,
            pcx);
        let mut v = (cx.blocks[(*get_irfuncs().add(fi as usize)).entry as usize]).first;
        while v != 0 {
            if (cx.insts[v as usize]).op == Param && (cx.insts[v as usize]).imm >= 0 {
                let index = (cx.insts[v as usize]).imm;
                let piece = (cx.insts[v as usize]).imm2;
                let location = if piece > 0 { pieces[(4 * index + piece - 1) as usize] }
                    else { locations[index as usize] };
                if piece < 0 || xl_is_stack(location) {
                    return true;
                }
            }
            v = (cx.insts[v as usize]).next;
        }
        false
    }
}

// Whether block b ends in a call that does not return, passing nothing
// on the stack (its frame can be its own).
pub fn is_noreturn_call_block(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let v = (cx.blocks[b as usize]).last;
        (cx.blocks[b as usize]).term == Term::Unreach && v != 0
            && (cx.insts[v as usize]).op.is_call() && call_stack_size(cx, v, pcx) == 0
    }
}

fn sw_intersect(cx: &mut FnCtx<Comp>, a: i64, b: i64) -> i64 {
    let mut x = a;
    let mut y = b;
    while x != y {
        while x > y {
            x = (cx.sw_idom[x as usize]);
        }
        while y > x {
            y = (cx.sw_idom[y as usize]);
        }
    }
    x
}

// Whether layout index a dominates layout index x.
fn sw_dominates(cx: &mut FnCtx<Comp>, a: i64, x: i64) -> bool {
    let mut y = x;
    while y > a {
        y = (cx.sw_idom[y as usize]);
    }
    y == a
}

// Dominators over the layout (a reverse post-order): Cooper, Harvey and
// Kennedy's iteration.
fn sw_dominators(cx: &mut FnCtx<Comp>) {
    unsafe {
        let n = cx.order.len() as i64;
        cx.sw_idom.clear();
        for k in 0..n {
            cx.sw_idom.push(if k == 0 { 0 } else { -1 });
        }
        let mut changed = true;
        while changed {
            changed = false;
            for k in 1..n {
                let b = (cx.order[k as usize]);
                let mut idom: i64 = -1;
                for i in 0..(cx.blocks[b as usize]).preds.len() as i64 {
                    let pk = (cx.blocks[((cx.blocks[b as usize]).preds[i as usize]) as usize]).order;
                    if pk < 0 || (cx.sw_idom[pk as usize]) < 0 {
                        continue;
                    }
                    idom = if idom < 0 { pk } else { sw_intersect(cx, pk, idom) };
                }
                if idom != (cx.sw_idom[k as usize]) {
                    (cx.sw_idom[k as usize]) = idom;
                    changed = true;
                }
            }
        }
    }
}

// Whether the frame can be set up at layout index s: s is in no loop, no
// block of its region leads back to it, and only jumps leave the region.
fn sw_valid(cx: &mut FnCtx<Comp>, s: i64) -> bool {
    unsafe {
        if s == 0 {
            return true;
        }
        if (cx.ldepth[s as usize]) != 0 {
            return false;
        }
        for k in s..cx.order.len() as i64 {
            if !sw_dominates(cx, s, k) {
                continue;
            }
            let b = (cx.order[k as usize]);
            for i in 0..succ_count(cx, b) {
                let sk = { let at_ix = succ(cx, b, i) as usize; cx.blocks[at_ix].order };
                if sk == s || sk < 0
                    || (!sw_dominates(cx, s, sk) && (cx.blocks[b as usize]).term != Term::Jump) {
                    return false;
                }
            }
        }
        true
    }
}

// Tears the frame down (on a jump out of its region): restores the
// callee-saved registers, sp, the frame pointer and the return address.
pub fn emit_frame_teardown(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    save_callee_saved(cx, restore: true, pcx: pcx);
    if get_x86() { mx_frame_unlink(cx); } else { ma_frame_unlink(cx); }
}

fn shrink_wrap(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let n = cx.order.len() as i64;
        let mut need = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        for _ in 0..n {
            need.push(0);
        }
        for k in 0..n {
            let b = (cx.order[k as usize]);
            let mut v = (cx.blocks[b as usize]).first;
            while v != 0 {
                let op = (cx.insts[v as usize]).op;
                if op.is_call() && is_emitted(cx, v)
                    && !(v == (cx.blocks[b as usize]).last
                        && is_noreturn_call_block(cx, b, pcx)) {
                    (need[k as usize]) = 1;
                }
                if op == Slot && is_emitted(cx, v) {
                    (need[k as usize]) = 1;
                }
                for i in 0..ir_operand_count(cx, v) {
                    let u = ir_operand(cx, v, i);
                    if u != 0 && (cx.insts[u as usize]).op == Slot {
                        (need[k as usize]) = 1;
                        if op == Phi {
                            for j in 0..(cx.blocks[b as usize]).preds.len() as i64 {
                                let pk = (
                                    cx.blocks[
                                        ((cx.blocks[b as usize]).preds[j as usize]) as usize]).order;
                                if pk >= 0 {
                                    (need[pk as usize]) = 1;
                                }
                            }
                        }
                    }
                }
                v = (cx.insts[v as usize]).next;
            }
            let cond = (cx.blocks[b as usize]).cond;
            if cond != 0 && (cx.insts[cond as usize]).op == Slot {
                (need[k as usize]) = 1;
            }
        }
        mark_frame_blocks(cx, &mut *need.data);
        let mut any = (0i64..n).any(|k| (need[k as usize]) != 0);
        if cx.returns_twice || cx.frame_align > 16 || has_stack_params(cx, fi, pcx)
            || (cx.frame_total > 0 && !any) {
            (need[0]) = 1;
            any = true;
        }
        cx.in_frame.clear();
        for _ in 0..n {
            cx.in_frame.push(0);
        }
        cx.save = -1;
        if any {
            sw_dominators(cx);
            let mut s: i64 = -1;
            for k in 0..n {
                if (need[k as usize]) != 0 {
                    s = if s < 0 { k } else { sw_intersect(cx, s, k) };
                }
            }
            while !sw_valid(cx, s) {
                s = (cx.sw_idom[s as usize]);
            }
            cx.save = s;
            for k in 0..n {
                if sw_dominates(cx, s, k) {
                    (cx.in_frame[k as usize]) = 1;
                }
            }
        }
        free(need.data as *mut u8);
    }
}

// Links a frame: saves the frame pointer and the return address.
pub fn emit_frame_link(cx: &mut FnCtx<Comp>) {
    if get_x86() { mx_frame_link(cx); } else { ma_frame_link(cx); }
}

// Reserves the frame's area, realigns it, saves the callee-saved
// registers.
pub fn emit_frame_setup(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    if cx.frame_total > 0 {
        if get_x86() { x64_frame_reserve(cx, cx.frame_total); }
        else { a64_frame_reserve(cx, cx.frame_total); }
        if cx.frame_align > 16 {
            // The frame is addressed from sp: aligned, its slots are (the
            // epilogue restores sp from the frame pointer).
            if get_x86() {
                x64_imm(cx, c"andq", 0 - cx.frame_align, c"%rsp");
            } else {
                ins(cx, c"mov x16, sp");
                a64_align_down(cx, 16, cx.frame_align);
                ins(cx, c"mov sp, x16");
            }
        }
    }
    save_callee_saved(cx, restore: false, pcx: pcx);
}

// The function's label (as the shared emit_function_start writes it), and
// the saving of the frame pointer and return address when it has a frame.
fn ir_function_start(cx: &mut FnCtx<Comp>, prefix: *mut u8, name: i64, global: bool, frame: bool,
    pcx: &Ctx<Comp>) {
    unsafe {
        emit_function_start(cx, prefix, name, global, pcx);
        if frame {
            return;
        }
        let prologue = if get_x86() { c"    pushq %rbp\n    movq %rsp, %rbp\n" }
            else { c"    stp x29, x30, [sp, #-16]!\n    mov x29, sp\n" };
        let n = strlen(prologue) as i64;
        let len = (*get_bufs().add(cx.asm as usize)).len;
        if len < n
            || memcmp((*get_bufs().add(cx.asm as usize)).data.add((len - n) as usize), prologue,
                n as u64) != 0 {
            die(c"internal error: unexpected function prologue");
        }
        buf_truncate(cx.asm, len - n);
    }
}
