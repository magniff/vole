// Operands and results (emit/mod.vl): values put in registers where an
// instruction reads them, results put where the allocation wants them,
// and the parallel moves that put values in place.

use crate::back::emit::machine::{
    m_extern_addr, m_lea, m_load, m_load_fimm, m_load_imm, m_mov, m_store, m_string_addr,
    m_symbol_addr, reg_cycle, reg_fp, reg_move_temp, reg_sp, spill_offset, spill_type,
};
use crate::back::regalloc::{LOC_NONE, LOC_REMAT};
use crate::back::regalloc::locations::{stored_at_def, vloc};
use crate::back::regalloc::prepare::tracked;
use crate::base::{buf_byte, die};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_F64, in_fregs, is_float, is_vector};
use crate::gen0::gen::{fn_symbol_prefix, static_symbol_prefix};
use crate::gen0::target::{oi, on};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Op;
use crate::middle::ir::Op::{Const, GAddr, SAddr, Slot};

// ---- Operands and results ----

// Rematerializes value `v` (is_remat_op) into register `r`.
pub fn materialize(cx: &mut FnCtx<Comp>, v: i64, r: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        let imm = (*cx.insts.add(v as usize)).imm;
        if op == Const {
            if is_float((*cx.insts.add(v as usize)).ty) {
                m_load_fimm(cx, r, imm, (*cx.insts.add(v as usize)).ty, pcx);
            } else if is_vector((*cx.insts.add(v as usize)).ty, pcx) {
                // (0.19) a 64-bit vector of constant lanes, its bits in imm
                // (a load of a constant 8-byte array): a vector register's
                // low half, as an f64's bits
                m_load_fimm(cx, r, imm, TY_F64, pcx);
            } else {
                m_load_imm(cx, r, imm as u64);
            }
        } else if op == Slot {
            m_lea(cx, r, reg_sp(), (*cx.slots.add(imm as usize)).offset);
        } else if op == GAddr {
            let st = (*pcx.sym_static.add(imm as usize)) - 1;
            // (0.25.5) gen_data writes only the statics the lowered IR named
            if pcx.statics[st as usize].linkage == 0
                && !crate::gen0::gen::is_static_named(st, pcx) {
                crate::base::die(c"internal error: code names a static the IR as lowered did not (gen0::gen::statics_named_by_ir)");
            }
            if pcx.statics[st as usize].linkage == 1 {
                m_extern_addr(cx, r, imm, pcx);
            } else {
                m_symbol_addr(cx, r, static_symbol_prefix(st, pcx), imm, pcx);
            }
        } else if op == SAddr {
            m_string_addr(cx, r, imm);
        } else if op == Op::RtId {
            // (0.18.1) A line the join makes `mov r, #N` (m_load_imm) of the
            // program's number for it: \x04r,i, i its index in the text's.
            let mut i: i64 = 0;
            while i < cx.text_rtids.count && (*cx.text_rtids.data.add(i as usize)) != imm {
                i += 1;
            }
            if i == cx.text_rtids.count {
                cx.text_rtids.push(imm);
            }
            buf_byte(cx.code, 4);
            oi(cx, r);
            buf_byte(cx.code, b',');
            oi(cx, i);
            on(cx);
        } else if pcx.fns[imm as usize].is_extern {
            m_extern_addr(cx, r, pcx.fns[imm as usize].name, pcx);
        } else {
            m_symbol_addr(cx, r, fn_symbol_prefix(imm, pcx), pcx.fns[imm as usize].name, pcx);
        }
    }
}

// The register holding value `v`, an operand of the instruction being
// emitted that needs one.
fn use_reg(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let loc = vloc(cx, v, cx.cur_pos);
    if loc < 0 || loc >= 64 {
        die(c"internal error: an operand not in a register");
    }
    loc
}

// Value `v`, used at `pos` where it may be anywhere, in a register: its
// own, or `scratch` after loading or rematerializing it there.
pub fn use_any(cx: &mut FnCtx<Comp>, v: i64, pos: i64, scratch: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if (*cx.insts.add(v as usize)).op.is_remat() {
            materialize(cx, v, scratch, pcx);
            return scratch;
        }
        let loc = vloc(cx, v, pos);
        if loc == LOC_NONE || loc == LOC_REMAT {
            die(c"internal error: operand without a location");
        }
        if loc >= 0 {
            return loc;
        }
        let spill_type_v = spill_type((*cx.insts.add(v as usize)).ty, pcx);
        let reg_sp_v = reg_sp();
        let spill_offset_v = spill_offset(cx, loc);
        m_load(cx, spill_type_v, scratch, reg_sp_v, spill_offset_v,
            pcx);
        scratch
    }
}

// Value `v` (used at `pos`) in register `r` exactly.
pub fn use_into(cx: &mut FnCtx<Comp>, v: i64, pos: i64, r: i64, pcx: &Ctx<Comp>) {
    let got = use_any(cx, v, pos, r, pcx);
    unsafe { m_mov(cx, r, got, (*cx.insts.add(v as usize)).ty, pcx); }
}

pub fn int_operand(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    use_reg(cx, v)
}

pub fn float_operand(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    use_reg(cx, v)
}

pub fn operand_reg(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    use_reg(cx, v)
}

// Where the result of `v` is computed.
pub fn result_reg(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let loc = vloc(cx, v, cx.cur_pos + 2);
    if loc < 0 || loc >= 64 {
        die(c"internal error: a result not in a register");
    }
    loc
}

// Stores the result into its spill slot when it goes to the stack.
pub fn result_done(cx: &mut FnCtx<Comp>, v: i64, r: i64, pcx: &Ctx<Comp>) {
    let t = tracked(cx, v);
    if t >= 0 && stored_at_def(cx, t) {
        unsafe {
            let spill_type_v = spill_type((*cx.insts.add(v as usize)).ty, pcx);
            let reg_sp_v = reg_sp();
            let spill_offset_v = spill_offset(cx, 0 - (1 + cx.rv_slot[t as usize]));
            m_store(cx, spill_type_v, r, reg_sp_v,
                spill_offset_v, pcx);
        }
    }
}

// Whether `v` is a constant (and its value in *value).
pub fn const_of(cx: &mut FnCtx<Comp>, v: i64, value: &mut i64) -> bool {
    unsafe {
        if (*cx.insts.add(v as usize)).op == Const {
            *value = (*cx.insts.add(v as usize)).imm;
            return true;
        }
        false
    }
}

// ---- Parallel moves ----

// Pending moves: destination location, kind, source, type, done, the value
// read and the value written (for the checker). Kinds: a location, a
// rematerialized value, a stack argument of the caller (the source is an
// offset from the frame pointer), the address of one.
pub const PM_LOC: i64 = 0;

pub const PM_REMAT: i64 = 1;

pub const PM_STACK: i64 = 2;

pub const PM_ADDR: i64 = 3;

pub const PM_FIELDS: i64 = 7;

// (A move to its own location is kept: for the checker, the location then
// holds the value written, as a phi takes its operand's register.)
pub fn pm_add(cx: &mut FnCtx<Comp>, dst: i64, kind: i64, src: i64, ty: i64, value: i64, result: i64) {
    cx.pm.push(dst);
    cx.pm.push(kind);
    cx.pm.push(src);
    cx.pm.push(ty);
    // Not done.
    cx.pm.push(0);
    cx.pm.push(value);
    cx.pm.push(result);
}

pub fn pm_dst(cx: &mut FnCtx<Comp>, i: i64) -> i64 { unsafe { (
    *cx.pm.data.add((i * PM_FIELDS) as usize)) } }

pub fn pm_kind(cx: &mut FnCtx<Comp>, i: i64) -> i64 { unsafe { (
    *cx.pm.data.add((i * PM_FIELDS + 1) as usize)) } }

pub fn pm_src(cx: &mut FnCtx<Comp>, i: i64) -> i64 { unsafe { (
    *cx.pm.data.add((i * PM_FIELDS + 2) as usize)) } }

fn pm_ty(cx: &mut FnCtx<Comp>, i: i64) -> i64 { unsafe { (
    *cx.pm.data.add((i * PM_FIELDS + 3) as usize)) } }

fn pm_done(cx: &mut FnCtx<Comp>, i: i64) -> bool { unsafe { (
    *cx.pm.data.add((i * PM_FIELDS + 4) as usize)) != 0 } }

pub fn pm_value(cx: &mut FnCtx<Comp>, i: i64) -> i64 { unsafe { (
    *cx.pm.data.add((i * PM_FIELDS + 5) as usize)) } }

pub fn pm_result(cx: &mut FnCtx<Comp>, i: i64) -> i64 { unsafe { (
    *cx.pm.data.add((i * PM_FIELDS + 6) as usize)) } }

// Moves location `src` to location `dst` (a value of type `ty`).
fn move_loc(cx: &mut FnCtx<Comp>, dst: i64, src: i64, ty: i64, pcx: &Ctx<Comp>) {
    if dst == src {
        return;
    }
    let st = spill_type(ty, pcx);
    if dst >= 0 && src >= 0 {
        m_mov(cx, dst, src, ty, pcx);
    } else if dst >= 0 {
        let reg_sp_v = reg_sp();
        let spill_offset_v = spill_offset(cx, src);
        m_load(cx, st, dst, reg_sp_v, spill_offset_v, pcx);
    } else if src >= 0 {
        let reg_sp_v1 = reg_sp();
        let spill_offset_v1 = spill_offset(cx, dst);
        m_store(cx, st, src, reg_sp_v1, spill_offset_v1, pcx);
    } else {
        let temp = reg_move_temp(in_fregs(ty, pcx));
        let reg_sp_v2 = reg_sp();
        let spill_offset_v2 = spill_offset(cx, src);
        m_load(cx, st, temp, reg_sp_v2, spill_offset_v2, pcx);
        let reg_sp_v3 = reg_sp();
        let spill_offset_v3 = spill_offset(cx, dst);
        m_store(cx, st, temp, reg_sp_v3, spill_offset_v3, pcx);
    }
}

// Whether location `loc` is the source of a pending location move other
// than move `except`.
fn pm_is_source(cx: &mut FnCtx<Comp>, loc: i64, except: i64) -> bool {
    let n = cx.pm.count / PM_FIELDS;
    for j in 0..n {
        if j != except && !pm_done(cx, j) && pm_kind(cx, j) == PM_LOC && pm_src(cx, j) == loc {
            return true;
        }
    }
    false
}

// Emits every pending move, then clears them.
pub fn pm_resolve(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    unsafe {
        let n = cx.pm.count / PM_FIELDS;
        for i in 0..n {
            if pm_kind(cx, i) == PM_LOC && pm_dst(cx, i) == pm_src(cx, i) {
                (*cx.pm.data.add((i * PM_FIELDS + 4) as usize)) = 1;
            }
        }
        loop {
            let mut pending = false;
            let mut progress = false;
            for i in 0..n {
                if pm_done(cx, i) || pm_kind(cx, i) != PM_LOC {
                    continue;
                }
                pending = true;
                let pm_dst_v1 = pm_dst(cx, i);
                let pm_is_source_v = pm_is_source(cx, pm_dst_v1, i);
                if !pm_is_source_v {
                    let pm_dst_v = pm_dst(cx, i);
                    let pm_src_v = pm_src(cx, i);
                    let pm_ty_v = pm_ty(cx, i);
                    move_loc(cx, pm_dst_v, pm_src_v, pm_ty_v, pcx);
                    (*cx.pm.data.add((i * PM_FIELDS + 4) as usize)) = 1;
                    progress = true;
                }
            }
            if !pending {
                break;
            }
            if progress {
                continue;
            }
            // Only cycles are left: save one destination's current value in
            // the cycle register, and read it from there instead.
            let mut i: i64 = 0;
            while pm_done(cx, i) || pm_kind(cx, i) != PM_LOC {
                i += 1;
            }
            let d = pm_dst(cx, i);
            let temp = reg_cycle(in_fregs(pm_ty(cx, i), pcx));
            if pm_is_source(cx, temp, -1) {
                die(c"internal error: parallel move cycle register in use");
            }
            let pm_ty_v1 = pm_ty(cx, i);
            move_loc(cx, temp, d, pm_ty_v1, pcx);
            for j in 0..n {
                if !pm_done(cx, j) && pm_kind(cx, j) == PM_LOC && pm_src(cx, j) == d {
                    (*cx.pm.data.add((j * PM_FIELDS + 2) as usize)) = temp;
                }
            }
        }
        for i in 0..n {
            if pm_done(cx, i) || pm_kind(cx, i) == PM_LOC {
                continue;
            }
            let dst = pm_dst(cx, i);
            let ty = pm_ty(cx, i);
            let r = if dst >= 0 { dst } else { reg_move_temp(in_fregs(ty, pcx)) };
            if pm_kind(cx, i) == PM_REMAT {
                let pm_src_v1 = pm_src(cx, i);
                materialize(cx, pm_src_v1, r, pcx);
            } else if pm_kind(cx, i) == PM_ADDR {
                let reg_fp_v = reg_fp();
                let pm_src_v2 = pm_src(cx, i);
                m_lea(cx, r, reg_fp_v, pm_src_v2);
            } else {
                let reg_fp_v1 = reg_fp();
                let pm_src_v3 = pm_src(cx, i);
                m_load(cx, ty, r, reg_fp_v1, pm_src_v3, pcx);
            }
            if dst < 0 {
                let spill_type_v = spill_type(ty, pcx);
                let reg_sp_v = reg_sp();
                let spill_offset_v = spill_offset(cx, dst);
                m_store(cx, spill_type_v, r, reg_sp_v, spill_offset_v, pcx);
            }
        }
        cx.pm.count = 0;
    }
}

// Adds the move of value `v` (where it is at `pos`) into location `dst`.
pub fn pm_add_value(cx: &mut FnCtx<Comp>, dst: i64, v: i64, pos: i64) {
    unsafe {
        if (*cx.insts.add(v as usize)).op.is_remat() {
            pm_add(cx, dst, PM_REMAT, v, (*cx.insts.add(v as usize)).ty, v, v);
        } else {
            let vloc_v = vloc(cx, v, pos);
            pm_add(cx, dst, PM_LOC, vloc_v, (*cx.insts.add(v as usize)).ty, v, v);
        }
    }
}
