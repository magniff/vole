// Operands and results (emit/mod.vl): values put in registers where an
// instruction reads them, results put where the allocation wants them,
// and the parallel moves that put values in place.

use crate::back::emit::machine::{
    m_extern_addr, m_lea, m_load, m_load_fimm, m_load_imm, m_mov, m_spill_load, m_spill_store,
    m_store, m_string_addr, m_symbol_addr, reg_cycle, reg_fp, reg_move_temp, reg_sp, spill_type,
};
use crate::back::regalloc::{LOC_NONE, LOC_REMAT};
use crate::back::regalloc::locations::{
    plan_end_moves, plan_gap_moves, plan_start_moves, stored_at_def, vloc,
};
use crate::back::regalloc::movecode::{check_moves_code, moves_code_begin};
use crate::back::regalloc::prepare::tracked;
use crate::base::{buf_byte, die};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{TY_F64, TY_U64, in_fregs, is_float, is_vector, type_size};
use crate::gen0::gen::{fn_symbol_prefix, static_symbol_prefix};
use crate::gen0::target::{ins, oi, on};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::Op;
use crate::middle::ir::Op::{Const, GAddr, Param, Phi, SAddr, Slot};

// ---- Operands and results ----

// Rematerializes value `v` (is_remat_op) into register `r`.
pub fn materialize(cx: &mut FnCtx<Comp>, v: i64, r: i64, pcx: &Ctx<Comp>) {
    let op = (cx.insts[v as usize]).op;
    let imm = (cx.insts[v as usize]).imm;
    if op == Const {
        if is_float((cx.insts[v as usize]).ty) {
            m_load_fimm(cx, r, imm, (cx.insts[v as usize]).ty, pcx);
        } else if is_vector((cx.insts[v as usize]).ty, pcx) {
            // (0.19) a 64-bit vector of constant lanes, its bits in imm
            // (a load of a constant 8-byte array): a vector register's
            // low half, as an f64's bits
            m_load_fimm(cx, r, imm, TY_F64, pcx);
        } else {
            m_load_imm(cx, r, imm as u64);
        }
    } else if op == Slot {
        m_lea(cx, r, reg_sp(), (cx.slots[imm as usize]).offset);
    } else if op == GAddr {
        let st = (pcx.sym_static[imm as usize]) - 1;
        // (0.25.5) gen_data writes only the statics the lowered IR named
        if pcx.statics[st as usize].linkage == 0
            && !crate::gen0::gen::is_static_named(st, pcx) {
            crate::base::die(c"internal error: code names a static the IR as lowered did not (gen0::gen::statics_named_by_ir)");
        }
        if pcx.statics[st as usize].linkage == 1 {
            m_extern_addr(cx, r, imm, pcx);
        } else {
            m_symbol_addr(cx, r, static_symbol_prefix(st, pcx), imm, pcx);
        }
    } else if op == SAddr {
        m_string_addr(cx, r, imm);
    } else if op == Op::RtId {
        // (0.18.1) A line the join makes `mov r, #N` (m_load_imm) of the
        // program's number for it: \x04r,i, i its index in the text's.
        let mut i: i64 = 0;
        while i < cx.text_rtids.len() as i64 && (cx.text_rtids[i as usize]) != imm {
            i += 1;
        }
        if i == cx.text_rtids.len() as i64 {
            cx.text_rtids.push(imm);
        }
        buf_byte(cx.code, 4);
        oi(cx, r);
        buf_byte(cx.code, b',');
        oi(cx, i);
        on(cx);
    } else if pcx.fns[imm as usize].is_extern {
        m_extern_addr(cx, r, pcx.fns[imm as usize].name, pcx);
    } else {
        m_symbol_addr(cx, r, fn_symbol_prefix(imm, pcx), pcx.fns[imm as usize].name, pcx);
    }
}

// The register holding value `v`, an operand of the instruction being
// emitted that needs one.
fn use_reg(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let loc = vloc(cx, v, cx.cur_pos);
    if loc < 0 || loc >= 64 {
        die(c"internal error: an operand not in a register");
    }
    loc
}

// Value `v`, used at `pos` where it may be anywhere, in a register: its
// own, or `scratch` after loading or rematerializing it there.
pub fn use_any(cx: &mut FnCtx<Comp>, v: i64, pos: i64, scratch: i64, pcx: &Ctx<Comp>) -> i64 {
    if (cx.insts[v as usize]).op.is_remat() {
        materialize(cx, v, scratch, pcx);
        return scratch;
    }
    let loc = vloc(cx, v, pos);
    if loc == LOC_NONE || loc == LOC_REMAT {
        die(c"internal error: operand without a location");
    }
    if loc >= 0 {
        return loc;
    }
    m_spill_load(cx, (cx.insts[v as usize]).ty, scratch, loc, pcx);
    scratch
}

// Value `v` (used at `pos`) in register `r` exactly.
pub fn use_into(cx: &mut FnCtx<Comp>, v: i64, pos: i64, r: i64, pcx: &Ctx<Comp>) {
    let got = use_any(cx, v, pos, r, pcx);
    m_mov(cx, r, got, (cx.insts[v as usize]).ty, pcx);
}

pub fn int_operand(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    use_reg(cx, v)
}

pub fn float_operand(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    use_reg(cx, v)
}

pub fn operand_reg(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    use_reg(cx, v)
}

// Where the result of `v` is computed.
pub fn result_reg(cx: &mut FnCtx<Comp>, v: i64) -> i64 {
    let loc = vloc(cx, v, cx.cur_pos + 2);
    if loc < 0 || loc >= 64 {
        die(c"internal error: a result not in a register");
    }
    loc
}

// Stores the result into its spill slot when it goes to the stack.
pub fn result_done(cx: &mut FnCtx<Comp>, v: i64, r: i64, pcx: &Ctx<Comp>) {
    let t = tracked(cx, v);
    if t >= 0 && stored_at_def(cx, t) {
        m_spill_store(cx, (cx.insts[v as usize]).ty, r, 0 - (1 + cx.rv_slot[t as usize]), pcx);
    }
}

// Whether `v` is a constant (and its value in *value).
pub fn const_of(cx: &mut FnCtx<Comp>, v: i64, value: &mut i64) -> bool {
    if (cx.insts[v as usize]).op == Const {
        *value = (cx.insts[v as usize]).imm;
        return true;
    }
    false
}

// ---- Parallel moves ----

// Pending moves: destination location, kind, source, type, done, the value
// read and the value written (for the checker). Kinds: a location, a
// rematerialized value, a stack argument of the caller (the source is an
// offset from the frame pointer), the address of one.
pub const PM_LOC: i64 = 0;

pub const PM_REMAT: i64 = 1;

pub const PM_STACK: i64 = 2;

pub const PM_ADDR: i64 = 3;

pub const PM_FIELDS: i64 = 7;

// (A move to its own location is kept: for the checker, the location then
// holds the value written, as a phi takes its operand's register.)
pub fn pm_add(cx: &mut FnCtx<Comp>, dst: i64, kind: i64, src: i64, ty: i64, value: i64, result: i64) {
    cx.pm.push(dst);
    cx.pm.push(kind);
    cx.pm.push(src);
    cx.pm.push(ty);
    // Not done.
    cx.pm.push(0);
    cx.pm.push(value);
    cx.pm.push(result);
}

pub fn pm_dst(cx: &mut FnCtx<Comp>, i: i64) -> i64 { (cx.pm[(i * PM_FIELDS) as usize]) }

pub fn pm_kind(cx: &mut FnCtx<Comp>, i: i64) -> i64 { (
    cx.pm[(i * PM_FIELDS + 1) as usize]) }

pub fn pm_src(cx: &mut FnCtx<Comp>, i: i64) -> i64 { (
    cx.pm[(i * PM_FIELDS + 2) as usize]) }

pub fn pm_ty(cx: &mut FnCtx<Comp>, i: i64) -> i64 { (cx.pm[(i * PM_FIELDS + 3) as usize]) }

fn pm_done(cx: &mut FnCtx<Comp>, i: i64) -> bool {
    (cx.pm[(i * PM_FIELDS + 4) as usize]) != 0
}

pub fn pm_value(cx: &mut FnCtx<Comp>, i: i64) -> i64 { (
    cx.pm[(i * PM_FIELDS + 5) as usize]) }

pub fn pm_result(cx: &mut FnCtx<Comp>, i: i64) -> i64 { (
    cx.pm[(i * PM_FIELDS + 6) as usize]) }

// Moves location `src` to location `dst` (a value of type `ty`).
fn move_loc(cx: &mut FnCtx<Comp>, dst: i64, src: i64, ty: i64, pcx: &Ctx<Comp>) {
    if dst == src {
        return;
    }
    if dst >= 0 && src >= 0 {
        m_mov(cx, dst, src, ty, pcx);
    } else if dst >= 0 {
        m_spill_load(cx, ty, dst, src, pcx);
    } else if src >= 0 {
        m_spill_store(cx, ty, src, dst, pcx);
        if pcx.plant_rt_cg_7 == 4 {
            // (tests only) a store to a byte of the frame no move writes
            let at = cx.save_base;
            m_store(cx, if in_fregs(ty, pcx) { TY_F64 } else { TY_U64 }, src, reg_sp(), at, pcx);
        }
    } else {
        // (0.30.1, RT-CG-7) through the moves' temporary of the class,
        // which only a call's moves write as a destination (x16, r11: the
        // callee of an indirect call), and those all go to registers
        let mut temp = reg_move_temp(in_fregs(ty, pcx));
        let n = cx.pm.len() as i64 / PM_FIELDS;
        for i in 0..n {
            if pm_dst(cx, i) == temp {
                die(c"internal error: a parallel move between spill slots while the moves' temporary is a destination");
            }
        }
        if pcx.plant_rt_cg_7 == 2 {
            // (tests only) through an allocated register instead
            temp = if in_fregs(ty, pcx) { 32 + 7 } else if get_x86() { 1 } else { 28 };
        }
        m_spill_load(cx, ty, temp, src, pcx);
        m_spill_store(cx, ty, temp, dst, pcx);
    }
}

// (0.30.1, RT-CG-6) A location as storage: a register is one cell; a
// spill slot is 8 bytes, and a value wider than 8 bytes (a 128-bit vector,
// x86-64's 256-bit one) stored at slot k takes the slots k to k + cells -
// 1 (assign_spill_slots gives it that many, aligned). Moves, their order
// and the allocation's check reason about these cells, never about the
// slot number alone: a move writing slot k + 1 must wait for a 16-byte
// read of slot k.
pub fn loc_cells(loc: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    if loc >= 0 {
        return 1;
    }
    let size = type_size(spill_type(ty, pcx), pcx);
    if size > 8 { (size + 7) / 8 } else { 1 }
}

// Whether location a (a value of type ta) and location b (of type tb)
// share storage.
pub fn locs_overlap(a: i64, ta: i64, b: i64, tb: i64, pcx: &Ctx<Comp>) -> bool {
    if a >= 0 || b >= 0 {
        return a == b;
    }
    // Only the lower slot's cells can reach the other (the sizes are
    // looked up only then: this runs for every pair of an edge's moves).
    let sa = 0 - a - 1;
    let sb = 0 - b - 1;
    if sa < sb {
        sb < sa + loc_cells(a, ta, pcx)
    } else if sb < sa {
        sa < sb + loc_cells(b, tb, pcx)
    } else {
        true
    }
}

// The pending location move other than `except` (of the first n) whose
// source shares storage with location loc of type ty, or -1.
fn plan_reader(cx: &mut FnCtx<Comp>, src: &[i64], done: &[bool], loc: i64, ty: i64, except: i64,
    n: i64, pcx: &Ctx<Comp>) -> i64 {
    for j in 0..n {
        if j != except && !done[j as usize]
            && locs_overlap(src[j as usize], pm_ty(cx, j), loc, ty, pcx) {
            return j;
        }
    }
    -1
}

// (0.30.1) A pending move's width as storage: the bytes of its spill type.
fn plan_width(cx: &mut FnCtx<Comp>, i: i64, pcx: &Ctx<Comp>) -> i64 {
    type_size(spill_type(pm_ty(cx, i), pcx), pcx)
}

// (0.30.1) Whether saving the source of pending move c (its readers then
// read the save, which no destination overlaps) lets every move reading
// that source be made before the moves stall again: the save's storage is
// then free for the next stall.
fn plan_save_frees(cx: &mut FnCtx<Comp>, src: &[i64], done: &[bool], c: i64, n: i64,
    pcx: &Ctx<Comp>) -> bool {
    let s = src[c as usize];
    // a register number no move writes: the save
    let saved: i64 = 1 << 40;
    let mut src2: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut done2: Vec<bool, Comp> = Vec::new_in(Comp {});
    for j in 0..n {
        src2.push(if !done[j as usize] && src[j as usize] == s { saved } else { src[j as usize] });
        done2.push(done[j as usize]);
    }
    let mut progress = true;
    while progress {
        progress = false;
        for i in 0..n {
            if done2[i as usize] {
                continue;
            }
            let d = pm_dst(cx, i);
            let ty = pm_ty(cx, i);
            if plan_reader(cx, src2.as_slice(), done2.as_slice(), d, ty, i, n, pcx) < 0 {
                done2[i as usize] = true;
                progress = true;
            }
        }
    }
    for j in 0..n {
        if !done[j as usize] && src[j as usize] == s && !done2[j as usize] {
            return false;
        }
    }
    true
}

// (0.30.1) Whether saving the source of pending move c makes a pending
// move ready at once (its readers then read the save, which no destination
// overlaps).
fn plan_save_progresses(cx: &mut FnCtx<Comp>, src: &[i64], done: &[bool], c: i64, n: i64,
    pcx: &Ctx<Comp>) -> bool {
    let s = src[c as usize];
    let saved: i64 = 1 << 40;
    let mut src2: Vec<i64, Comp> = Vec::new_in(Comp {});
    for j in 0..n {
        src2.push(if !done[j as usize] && src[j as usize] == s { saved } else { src[j as usize] });
    }
    for i in 0..n {
        if !done[i as usize] {
            let d = pm_dst(cx, i);
            let ty = pm_ty(cx, i);
            if plan_reader(cx, src2.as_slice(), done, d, ty, i, n, pcx) < 0 {
                return true;
            }
        }
    }
    false
}

// (0.30.1, RT-CG-6) When every pending move waits for another, the move
// whose source is saved: in the cycle register of its class, or in the
// cells reserve_save_cells keeps when that register holds an earlier save
// a pending move still reads (plan_save_cell). Every save has storage, so
// this choice is about the moves alone: a save is one more move, and the
// choice tries to make few. Moves write disjoint locations, and a slot's
// value takes 1, 2 or 4 cells, aligned, so two slot locations that overlap
// are one inside the other. Without values wider than a cell, a move
// waits for the one value its destination holds and a value is
// overwritten by one move, the stalled moves are simple cycles, and one
// save on a cycle frees it all; with wider values a move can wait for
// several narrower ones, and several saves may be pending at once (the
// reviews found edges that need two, and three, whatever is chosen). In
// this order: the widest value whose save lets all its readers be made
// before the next stall (plan_save_frees: its storage is then free
// again); else the widest value whose save makes a move ready
// (plan_save_progresses); else the value the destination of a narrowest
// pending move overlaps, which always makes progress (that destination is
// inside it: a value narrower than the move would have pending readers
// narrower still), so the plan ends: a value saved is read by no pending
// move again. tests/fuzz/pm_model.py is these functions line for line.
fn plan_break(cx: &mut FnCtx<Comp>, src: &[i64], done: &[bool], n: i64, pcx: &Ctx<Comp>) -> i64 {
    for rule in 0..2 {
        let mut c: i64 = -1;
        let mut c_width: i64 = -1;
        for j in 0..n {
            if done[j as usize] {
                continue;
            }
            let s = src[j as usize];
            let ty = pm_ty(cx, j);
            // each value once: its first pending reader
            let mut first = true;
            for k in 0..j {
                if !done[k as usize] && src[k as usize] == s {
                    first = false;
                }
            }
            // a value some pending move waits for
            let mut waited = false;
            for i in 0..n {
                if !done[i as usize] && locs_overlap(pm_dst(cx, i), pm_ty(cx, i), s, ty, pcx) {
                    waited = true;
                }
            }
            let w = plan_width(cx, j, pcx);
            if first && waited && w > c_width
                && (if rule == 0 {
                    plan_save_frees(cx, src, done, j, n, pcx)
                } else {
                    plan_save_progresses(cx, src, done, j, n, pcx)
                }) {
                    c = j;
                    c_width = w;
                }
        }
        if c >= 0 {
            return c;
        }
    }
    let mut m: i64 = -1;
    for i in 0..n {
        if !done[i as usize] && (m < 0 || plan_width(cx, i, pcx) < plan_width(cx, m, pcx)) {
            m = i;
        }
    }
    let d = pm_dst(cx, m);
    let ty = pm_ty(cx, m);
    let c = plan_reader(cx, src, done, d, ty, m, n, pcx);
    if c < 0 {
        die(c"internal error: a parallel move waits for no move");
    }
    c
}

// (0.30.1, RT-CG-6) Where a save of a value of type ty goes when the
// cycle register of its class holds an earlier save that a pending move
// still reads: the first run of cells of the reserve after the spill
// slots (pm_save_base, a multiple of 4; the run aligned to its size) that
// no pending move reads. While reserve_save_cells plans every edge
// (pm_save_cells < 0) the reserve has no end, and pm_save_need records
// how far it was used; the frame then has that many cells. Every plan is
// made again the same way when the code is emitted (plan_break and this
// choice depend only on the moves), so a save always finds its cells:
// running out is an internal error, moves the dry run did not plan.
fn plan_save_cell(cx: &mut FnCtx<Comp>, src: &[i64], done: &[bool], ty: i64, n: i64,
    pcx: &Ctx<Comp>) -> i64 {
    let k = loc_cells(-1, ty, pcx);
    let mut off: i64 = 0;
    loop {
        if cx.pm_save_cells >= 0 && off + k > cx.pm_save_cells {
            die(c"internal error: a parallel move's save has no cells (moves reserve_save_cells did not plan)");
        }
        let loc = 0 - (1 + cx.pm_save_base + off);
        if plan_reader(cx, src, done, loc, ty, -1, n, pcx) < 0 {
            if off + k > cx.pm_save_need {
                cx.pm_save_need = off + k;
            }
            return loc;
        }
        off += k;
    }
}

// (0.30.1, RT-CG-6) Plans, before the frame is laid out, every set of
// moves emit_block_body resolves from the allocation (each block's start,
// every gap, its end; the end even of a block that does not jump, more
// than is emitted), with saves in cells after the spill slots without an
// end, and keeps as many cells as they used: no edge then lacks storage
// for a save, however many it needs at once (most need none, the cycle
// registers being enough; some need cells for one or two). Only a function
// with a vector on the stack can need cells, and only it is planned. The other moves
// pm_resolve emits (the entry's parameters, a call's arguments, results and
// pieces, the return value's) have a register as the destination or every
// source a register, so a move waits only for a register's readers: one
// value a destination, one move a register, the stalled moves simple
// cycles, and one save in the cycle register at a time is enough.
pub fn reserve_save_cells(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    let mut base = cx.spill_count;
    while base % 4 != 0 {
        base += 1;
    }
    cx.pm_save_base = base;
    cx.pm_save_cells = -1;
    cx.pm_save_need = 0;
    // Without a vector on the stack every slot's value is one cell and
    // every location one unit: the stalled moves are simple cycles, one
    // save at a time (plan_break), in the cycle register. No cells, and no
    // need to plan (planning every gap twice would cost the self-build 1%).
    if !cx.spill_vectors {
        cx.pm_save_cells = 0;
        return;
    }
    for j in 0..cx.order.len() as i64 {
        let b = cx.order[j as usize];
        let k = cx.blocks[b as usize].order;
        plan_start_moves(cx, b);
        reserve_plan(cx, pcx);
        let mut v = cx.blocks[b as usize].first;
        while v != 0 {
            let op = cx.insts[v as usize].op;
            if op != Phi && op != Param {
                plan_gap_moves(cx, cx.insts[v as usize].mark - 1);
                reserve_plan(cx, pcx);
            }
            v = cx.insts[v as usize].next;
        }
        plan_gap_moves(cx, cx.bend[k as usize] - 1);
        reserve_plan(cx, pcx);
        plan_end_moves(cx, b);
        reserve_plan(cx, pcx);
    }
    cx.pm_save_cells = cx.pm_save_need;
    if cx.pm_save_need > 0 {
        cx.spill_count = base + cx.pm_save_need;
        // a 16- or 32-byte save's cells, aligned as the vectors' slots are
        cx.spill_vectors = true;
    }
}

// One set of pending moves planned and dropped: what reserve_save_cells
// learns from it is the cells its saves took.
fn reserve_plan(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    let _ = pm_plan(cx, pcx);
    cx.pm.clear();
}

// (0.30.1, RT-CG-5, RT-CG-6) The order of the pending location moves,
// as steps of three (destination, source, type), each made by move_loc:
// what pm_resolve emits and what the allocation's check simulates. A move
// is made once no other pending move reads any cell of its destination.
// When only cycles are left, the source of one move (plan_break chooses
// it) is saved in the cycle register of its type's class, or in cells
// of the reserve after the spill slots (plan_save_cell), and the moves
// reading that source read the save instead; that frees the moves
// waiting for it. A source that other pending moves read only in part,
// or as another kind of value, is an internal error (two values never
// share a cell while both are live).
pub fn pm_plan(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) -> Vec<i64, Comp> {
    let n = cx.pm.len() as i64 / PM_FIELDS;
    // Most gaps have no location move or one: its step, as the loop
    // below would make it, without the loop's vectors.
    let mut only: i64 = -1;
    let mut count: i64 = 0;
    for i in 0..n {
        if pm_kind(cx, i) == PM_LOC && pm_dst(cx, i) != pm_src(cx, i) {
            only = i;
            count += 1;
        }
    }
    if count <= 1 {
        let mut steps: Vec<i64, Comp> = Vec::new_in(Comp {});
        if count == 1 {
            steps.push(pm_dst(cx, only));
            steps.push(pm_src(cx, only));
            steps.push(pm_ty(cx, only));
        }
        return steps;
    }
    let mut src: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut done: Vec<bool, Comp> = Vec::new_in(Comp {});
    for i in 0..n {
        src.push(pm_src(cx, i));
        done.push(pm_kind(cx, i) != PM_LOC || pm_dst(cx, i) == pm_src(cx, i));
    }
    let mut steps: Vec<i64, Comp> = Vec::new_in(Comp {});
    loop {
        let mut pending = false;
        let mut progress = false;
        for i in 0..n {
            if done[i as usize] {
                continue;
            }
            pending = true;
            let d = pm_dst(cx, i);
            let ty = pm_ty(cx, i);
            if plan_reader(cx, src.as_slice(), done.as_slice(), d, ty, i, n, pcx) < 0 {
                steps.push(d);
                steps.push(src[i as usize]);
                steps.push(ty);
                done[i as usize] = true;
                progress = true;
            }
        }
        if !pending {
            break;
        }
        if progress {
            continue;
        }
        // Every pending move waits for another: c is the move whose source
        // is saved (plan_break).
        let c = plan_break(cx, src.as_slice(), done.as_slice(), n, pcx);
        let s = src[c as usize];
        let ty = pm_ty(cx, c);
        for j in 0..n {
            if done[j as usize]
                || !locs_overlap(src[j as usize], pm_ty(cx, j), s, ty, pcx) {
                continue;
            }
            let tj = pm_ty(cx, j);
            if src[j as usize] != s || in_fregs(tj, pcx) != in_fregs(ty, pcx)
                || loc_cells(s, tj, pcx) != loc_cells(s, ty, pcx)
                || type_size(spill_type(tj, pcx), pcx) != type_size(spill_type(ty, pcx), pcx) {
                die(c"internal error: a parallel move cycle reads one location as two values");
            }
        }
        let mut temp = reg_cycle(in_fregs(ty, pcx));
        if plan_reader(cx, src.as_slice(), done.as_slice(), temp, ty, -1, n, pcx) >= 0 {
            // the cycle register holds an earlier save a pending move reads
            temp = plan_save_cell(cx, src.as_slice(), done.as_slice(), ty, n, pcx);
        }
        steps.push(temp);
        steps.push(s);
        steps.push(ty);
        for j in 0..n {
            if !done[j as usize] && src[j as usize] == s {
                src[j as usize] = temp;
            }
        }
    }
    steps
}

// Emits every pending move, then clears them.
pub fn pm_resolve(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    let n = cx.pm.len() as i64 / PM_FIELDS;
    let steps = pm_plan(cx, pcx);
    // (0.30.1, RT-CG-7) While the steps run, x17 (AArch64's integer cycle
    // register) may hold a save: no step may take it as a scratch
    // (ma_scratch); their spill accesses need none (spill_access_type).
    // --verify-regalloc then follows the code they emitted.
    let pre = moves_code_begin(cx);
    cx.pm_code_start = pre[0];
    cx.pm_code_paired = false;
    cx.pm_running = true;
    cx.scratch_held = pcx.plant_rt_cg_7 != 1;
    let mut k: usize = 0;
    while k < steps.len() {
        move_loc(cx, steps[k], steps[k + 1], steps[k + 2], pcx);
        if pcx.plant_rt_cg_7 == 3 {
            ins(cx, c"nop");
        }
        k += 3;
    }
    cx.pm_running = false;
    cx.scratch_held = false;
    if pcx.verify_regalloc && steps.len() > 0 {
        check_moves_code(cx, &pre, pcx);
    }
    for i in 0..n {
        if pm_done(cx, i) || pm_kind(cx, i) == PM_LOC {
            continue;
        }
        let dst = pm_dst(cx, i);
        let ty = pm_ty(cx, i);
        let r = if dst >= 0 { dst } else { reg_move_temp(in_fregs(ty, pcx)) };
        if pm_kind(cx, i) == PM_REMAT {
            let pm_src_v1 = pm_src(cx, i);
            materialize(cx, pm_src_v1, r, pcx);
        } else if pm_kind(cx, i) == PM_ADDR {
            let reg_fp_v = reg_fp();
            let pm_src_v2 = pm_src(cx, i);
            m_lea(cx, r, reg_fp_v, pm_src_v2);
        } else {
            let reg_fp_v1 = reg_fp();
            let pm_src_v3 = pm_src(cx, i);
            m_load(cx, ty, r, reg_fp_v1, pm_src_v3, pcx);
        }
        if dst < 0 {
            m_spill_store(cx, ty, r, dst, pcx);
        }
    }
    cx.pm.clear();
}

// Adds the move of value `v` (where it is at `pos`) into location `dst`.
pub fn pm_add_value(cx: &mut FnCtx<Comp>, dst: i64, v: i64, pos: i64) {
    if (cx.insts[v as usize]).op.is_remat() {
        pm_add(cx, dst, PM_REMAT, v, (cx.insts[v as usize]).ty, v, v);
    } else {
        let vloc_v = vloc(cx, v, pos);
        pm_add(cx, dst, PM_LOC, vloc_v, (cx.insts[v as usize]).ty, v, v);
    }
}
