// AArch64 instructions for the IR back end (emit/), on physical
// registers: 0-30 are x0-x30, 31 is sp (as a base or an addition source),
// 32 + n is d<n> (s<n> for f32).
//
// Use of the registers: x0-x15 (caller-saved; x0-x7 also carry arguments,
// x8 the result pointer) and x19-x28 (callee-saved) are allocated; x16
// holds the callee of indirect calls and is the parallel moves' temporary;
// x17 breaks parallel move cycles and is the temporary for addresses and
// constants here; x18 is reserved by the platform. d0-d29 are allocated
// (d8-d15 callee-saved); d30 and d31 are the parallel moves' registers.
//
// Here: registers and memory operands, moves, constants, loads, stores,
// addresses, the frame link and block copies. The operations are in
// ops.vl, the vector instructions in vector.vl.

pub mod ops;
pub mod vector;
pub mod arch;
pub mod atomic;

use crate::back::mc_arm64::vector::ma_v;
use crate::base::{buf_len, buf_truncate};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::consteval::{f32_bits, f64_of_bits};
use crate::front::types::{
    TY_F32, TY_F64, TY_I16, TY_I32, TY_I8, TY_U16, TY_U32, TY_U8, is_float, is_vector, type_size,
};
use crate::gen0::arm64::{
    A64_GOTPAGE, A64_GOTPAGEOFF, A64_PAGE, A64_PAGEOFF, a64_load_imm, a64_str_sym, a64_sym,
};
use crate::gen0::target::{end_i, global_prefix, ins, o, oi, on};
use crate::middle::ctx::FnCtx;

fn ma_r(cx: &mut FnCtx<Comp>, r: i64) {
    if r == 31 {
        o(cx, c"sp");
    } else {
        o(cx, if cx.ma_w32 { c"w" } else { c"x" });
        oi(cx, r);
    }
}

fn ma_w(cx: &mut FnCtx<Comp>, r: i64) {
    o(cx, c"w");
    oi(cx, r);
}

// The float register r (32 + n) for a value of type ty (q<n> for a
// vector).
fn ma_f(cx: &mut FnCtx<Comp>, r: i64, ty: i64, pcx: &Ctx<Comp>) {
    // (0.19: a 64-bit vector is its d register)
    o(cx, if is_vector(ty, pcx) && type_size(ty, pcx) == 16 { c"q" } else if ty == TY_F32 { c"s" }
        else { c"d" });
    oi(cx, r - 32);
}

// "    <mnemonic> x<d>, x<a>, x<b>\n"
fn ma_rrr(cx: &mut FnCtx<Comp>, mnemonic: *const u8, d: i64, a: i64, b: i64) {
    o(cx, c"    ");
    o(cx, mnemonic);
    o(cx, c" ");
    ma_r(cx, d);
    o(cx, c", ");
    ma_r(cx, a);
    o(cx, c", ");
    ma_r(cx, b);
    on(cx);
}

fn ma_rr(cx: &mut FnCtx<Comp>, mnemonic: *const u8, d: i64, a: i64) {
    o(cx, c"    ");
    o(cx, mnemonic);
    o(cx, c" ");
    ma_r(cx, d);
    o(cx, c", ");
    ma_r(cx, a);
    on(cx);
}

pub fn ma_mov(cx: &mut FnCtx<Comp>, dst: i64, src: i64, ty: i64, pcx: &Ctx<Comp>) {
    if dst >= 32 && is_vector(ty, pcx) {
        o(cx, c"    mov ");
        ma_v(cx, dst, c"16b");
        o(cx, c", ");
        ma_v(cx, src, c"16b");
        on(cx);
    } else if dst >= 32 {
        o(cx, c"    fmov ");
        ma_f(cx, dst, TY_F64, pcx);
        o(cx, c", ");
        ma_f(cx, src, TY_F64, pcx);
        on(cx);
    } else {
        ma_rr(cx, c"mov", dst, src);
    }
}

pub fn ma_load_imm(cx: &mut FnCtx<Comp>, dst: i64, value: u64) {
    let signed = value as i64;
    // One instruction: movz, or movn for small negative values.
    if (signed >= 0 && signed < 65536) || (signed < 0 && signed >= -65536) {
        o(cx, c"    mov ");
        ma_r(cx, dst);
        o(cx, c", #");
        oi(cx, signed);
        on(cx);
        return;
    }
    a64_load_imm(cx, dst, value);
}

pub fn ma_load_fimm(cx: &mut FnCtx<Comp>, dst: i64, bits: i64, ty: i64, pcx: &Ctx<Comp>) {
    if bits == 0 {
        o(cx, c"    fmov ");
        ma_f(cx, dst, ty, pcx);
        o(cx, if ty == TY_F32 { c", wzr\n" } else { c", xzr\n" });
        return;
    }
    if ty == TY_F32 {
        a64_load_imm(cx, 17, f32_bits(f64_of_bits(bits)) as u64);
        o(cx, c"    fmov ");
        ma_f(cx, dst, ty, pcx);
        o(cx, c", w17\n");
    } else {
        a64_load_imm(cx, 17, bits as u64);
        o(cx, c"    fmov ");
        ma_f(cx, dst, ty, pcx);
        o(cx, c", x17\n");
    }
}

// dst = base + offset.
pub fn ma_lea(cx: &mut FnCtx<Comp>, dst: i64, base: i64, offset: i64) {
    if offset == 0 {
        if dst != base {
            ma_rr(cx, c"mov", dst, base);
        }
        return;
    }
    if offset > 0 && offset < 4096 {
        ma_rr(cx, c"add", dst, base);
        o_back_imm(cx, offset);
        return;
    }
    if offset < 0 && offset > -4096 {
        ma_rr(cx, c"sub", dst, base);
        o_back_imm(cx, 0 - offset);
        return;
    }
    a64_load_imm(cx, 17, offset as u64);
    ma_rrr(cx, c"add", dst, base, 17);
}

// Replaces the newline just written with ", #<value>\n".
fn o_back_imm(cx: &mut FnCtx<Comp>, value: i64) {
    buf_truncate(cx.code, buf_len(cx.code) - 1);
    o(cx, c", #");
    oi(cx, value);
    on(cx);
}

// "[x<base>, #offset]" when encodable as an unsigned scaled offset;
// otherwise the address is computed into x17 first (call before starting
// the instruction's line).
fn ma_address(cx: &mut FnCtx<Comp>, base: i64, offset: i64, size: i64) -> i64 {
    if offset >= 0 && offset % size == 0 && offset / size < 4096 {
        return offset;
    }
    ma_lea(cx, 17, base, offset);
    -1
}

fn ma_mem_operand(cx: &mut FnCtx<Comp>, base: i64, offset: i64) {
    o(cx, c"[");
    if cx.mem_index >= 0 {
        // [base, index, lsl #s] (no offset: see isel.vl).
        ma_r(cx, base);
        o(cx, c", ");
        ma_r(cx, cx.mem_index);
        if cx.mem_scale != 0 {
            o(cx, c", lsl #");
            oi(cx, cx.mem_scale);
        }
        o(cx, c"]");
        return;
    }
    if offset < 0 {
        o(cx, c"x17]");
        return;
    }
    ma_r(cx, base);
    if offset != 0 {
        o(cx, c", #");
        oi(cx, offset);
    }
    o(cx, c"]");
}

// The kind of an access of type ty a pair can make (0: none).
fn pair_kind(ty: i64, pcx: &Ctx<Comp>) -> i64 {
    if is_vector(ty, pcx) && type_size(ty, pcx) == 16 {
        3
    } else if ty == TY_F64 || (is_vector(ty, pcx) && type_size(ty, pcx) == 8) {
        2
    } else if !is_float(ty) && type_size(ty, pcx) == 8 {
        1
    } else {
        0
    }
}

// (0.15) A load (or store) of register r at [base, #offset] right after
// one of the same kind, base and the offset before: the two become one
// ldp (stp) in place of the line just written. A load whose result is the
// base (the next one's address changes) or the other's register is no
// pair. Returns whether it was made; else remembers this access when it
// may start one (call it with the line about to be written).
fn pair_with_last(cx: &mut FnCtx<Comp>, load: bool, ty: i64, r: i64, base: i64, offset: i64,
    pcx: &Ctx<Comp>) -> bool {
    let kind = if load { pair_kind(ty, pcx) } else { 0 - pair_kind(ty, pcx) };
    let size: i64 = if kind == 3 || kind == -3 { 16 } else { 8 };
    if kind == 0 || cx.mem_index >= 0 {
        cx.pair_end = -1;
        return false;
    }
    if buf_len(cx.code) == cx.pair_end && kind == cx.pair_kind
        && base == cx.pair_base && offset == cx.pair_offset + size
        && !(load && (cx.pair_reg == base || cx.pair_reg == r)) {
        buf_truncate(cx.code, cx.pair_start);
        o(cx, if load { c"    ldp " } else { c"    stp " });
        if kind == 1 || kind == -1 {
            ma_r(cx, cx.pair_reg);
            o(cx, c", ");
            ma_r(cx, r);
        } else {
            ma_f(cx, cx.pair_reg, ty, pcx);
            o(cx, c", ");
            ma_f(cx, r, ty, pcx);
        }
        o(cx, c", [");
        ma_r(cx, base);
        if cx.pair_offset != 0 {
            o(cx, c", #");
            oi(cx, cx.pair_offset);
        }
        o(cx, c"]");
        on(cx);
        cx.pair_end = -1;
        return true;
    }
    // (ldp's offset: 7 signed bits, scaled)
    if offset >= 0 && offset % size == 0 && offset / size < 63 {
        cx.pair_start = buf_len(cx.code);
        cx.pair_kind = kind;
        cx.pair_reg = r;
        cx.pair_base = base;
        cx.pair_offset = offset;
        cx.pair_end = -2;
    } else {
        cx.pair_end = -1;
    }
    false
}

pub fn ma_load(cx: &mut FnCtx<Comp>, ty: i64, dst: i64, base: i64, offset: i64, pcx: &Ctx<Comp>) {
    if pair_with_last(cx, true, ty, dst, base, offset, pcx) {
        return;
    }
    let size = type_size(ty, pcx);
    let at: i64 = if cx.mem_index >= 0 { 0 } else { ma_address(cx, base, offset, size) };
    o(cx, c"    ");
    if is_float(ty) || is_vector(ty, pcx) {
        o(cx, c"ldr ");
        ma_f(cx, dst, ty, pcx);
    } else if ty == TY_I8 {
        o(cx, c"ldrsb ");
        ma_r(cx, dst);
    } else if size == 1 {
        o(cx, c"ldrb ");
        ma_w(cx, dst);
    } else if ty == TY_I16 {
        o(cx, c"ldrsh ");
        ma_r(cx, dst);
    } else if size == 2 {
        o(cx, c"ldrh ");
        ma_w(cx, dst);
    } else if ty == TY_I32 {
        o(cx, c"ldrsw ");
        ma_r(cx, dst);
    } else if size == 4 {
        o(cx, c"ldr ");
        ma_w(cx, dst);
    } else {
        o(cx, c"ldr ");
        ma_r(cx, dst);
    }
    o(cx, c", ");
    ma_mem_operand(cx, base, at);
    on(cx);
    if cx.pair_end == -2 {
        cx.pair_end = buf_len(cx.code);
    }
}

pub fn ma_store(cx: &mut FnCtx<Comp>, ty: i64, src: i64, base: i64, offset: i64, pcx: &Ctx<Comp>) {
    if pair_with_last(cx, false, ty, src, base, offset, pcx) {
        return;
    }
    let size = type_size(ty, pcx);
    let at: i64 = if cx.mem_index >= 0 { 0 } else { ma_address(cx, base, offset, size) };
    o(cx, c"    ");
    if is_float(ty) || is_vector(ty, pcx) {
        o(cx, c"str ");
        ma_f(cx, src, ty, pcx);
    } else if size == 1 {
        o(cx, c"strb ");
        ma_w(cx, src);
    } else if size == 2 {
        o(cx, c"strh ");
        ma_w(cx, src);
    } else if size == 4 {
        o(cx, c"str ");
        ma_w(cx, src);
    } else {
        o(cx, c"str ");
        ma_r(cx, src);
    }
    o(cx, c", ");
    ma_mem_operand(cx, base, at);
    on(cx);
    if cx.pair_end == -2 {
        cx.pair_end = buf_len(cx.code);
    }
}

pub fn ma_symbol_addr(cx: &mut FnCtx<Comp>, dst: i64, prefix: *const u8, name: i64, pcx: &Ctx<Comp>) {
    o(cx, c"    adrp ");
    ma_r(cx, dst);
    o(cx, c", ");
    a64_sym(cx, prefix, name, A64_PAGE, pcx);
    o(cx, c"\n    add ");
    ma_r(cx, dst);
    o(cx, c", ");
    ma_r(cx, dst);
    o(cx, c", ");
    a64_sym(cx, prefix, name, A64_PAGEOFF, pcx);
    on(cx);
}

pub fn ma_extern_addr(cx: &mut FnCtx<Comp>, dst: i64, name: i64, pcx: &Ctx<Comp>) {
    o(cx, c"    adrp ");
    ma_r(cx, dst);
    o(cx, c", ");
    a64_sym(cx, global_prefix(), name, A64_GOTPAGE, pcx);
    o(cx, c"\n    ldr ");
    ma_r(cx, dst);
    o(cx, c", [");
    ma_r(cx, dst);
    o(cx, c", ");
    a64_sym(cx, global_prefix(), name, A64_GOTPAGEOFF, pcx);
    o(cx, c"]\n");
}

pub fn ma_string_addr(cx: &mut FnCtx<Comp>, dst: i64, id: i64) {
    o(cx, c"    adrp ");
    ma_r(cx, dst);
    o(cx, c", ");
    a64_str_sym(cx, id, A64_PAGE);
    o(cx, c"\n    add ");
    ma_r(cx, dst);
    o(cx, c", ");
    ma_r(cx, dst);
    o(cx, c", ");
    a64_str_sym(cx, id, A64_PAGEOFF);
    on(cx);
}

pub fn ma_normalize(cx: &mut FnCtx<Comp>, r: i64, ty: i64) {
    if ty == TY_I8 {
        o(cx, c"    sxtb ");
        ma_r(cx, r);
        o(cx, c", ");
        ma_w(cx, r);
        on(cx);
    } else if ty == TY_U8 {
        ma_rr(cx, c"and", r, r);
        o_back_imm(cx, 0xff);
    } else if ty == TY_I16 {
        o(cx, c"    sxth ");
        ma_r(cx, r);
        o(cx, c", ");
        ma_w(cx, r);
        on(cx);
    } else if ty == TY_U16 {
        ma_rr(cx, c"and", r, r);
        o_back_imm(cx, 0xffff);
    } else if ty == TY_I32 {
        o(cx, c"    sxtw ");
        ma_r(cx, r);
        o(cx, c", ");
        ma_w(cx, r);
        on(cx);
    } else if ty == TY_U32 {
        o(cx, c"    mov ");
        ma_w(cx, r);
        o(cx, c", ");
        ma_w(cx, r);
        on(cx);
    }
}

// Links a frame: saves the frame pointer and the return address, points
// the frame pointer at them.
pub fn ma_frame_link(cx: &mut FnCtx<Comp>) {
    ins(cx, c"stp x29, x30, [sp, #-16]!");
    ins(cx, c"mov x29, sp");
}

// Unlinks it: sp from the frame pointer, which and the return address are
// restored.
pub fn ma_frame_unlink(cx: &mut FnCtx<Comp>) {
    ins(cx, c"mov sp, x29");
    ins(cx, c"ldp x29, x30, [sp], #16");
}

pub fn ma_copy(cx: &mut FnCtx<Comp>, dst: i64, src: i64, size: i64) {
    let mut offset: i64 = 0;
    while offset + 8 <= size {
        ma_copy_chunk(cx, c"ldr x17", c"str x17", dst, src, offset);
        offset += 8;
    }
    if offset + 4 <= size {
        ma_copy_chunk(cx, c"ldr w17", c"str w17", dst, src, offset);
        offset += 4;
    }
    if offset + 2 <= size {
        ma_copy_chunk(cx, c"ldrh w17", c"strh w17", dst, src, offset);
        offset += 2;
    }
    if offset < size {
        ma_copy_chunk(cx, c"ldrb w17", c"strb w17", dst, src, offset);
    }
}

fn ma_copy_chunk(cx: &mut FnCtx<Comp>, load: *const u8, store: *const u8, dst: i64, src: i64,
    offset: i64) {
    o(cx, c"    ");
    o(cx, load);
    o(cx, c", [");
    ma_r(cx, src);
    end_i(cx, c", #", offset, c"]");
    o(cx, c"    ");
    o(cx, store);
    o(cx, c", [");
    ma_r(cx, dst);
    end_i(cx, c", #", offset, c"]");
}
