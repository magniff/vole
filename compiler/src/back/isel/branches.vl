// The branches instruction selection (isel/mod.vl) reshapes before
// tiling: diamonds and triangles that do little become selects (step 1),
// and branches on phis are threaded into their predecessors (step 0).

use crate::back::emit::blocks::fits_cmp_imm;
use crate::back::isel::{isel_const, isel_count_uses};
use crate::base::die;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{TY_U64, is_float, is_vector};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Cond, Op, Term, get_irfuncs, ir_append, ir_arg, ir_insert_before, ir_make, ir_replace,
    ir_set_arg, ir_unlink, ir_val,
};
use crate::middle::ir::Op::{Cmp, Conv, Div, Phi, Rem, Select};
use crate::middle::ir::cfg::pred_index;
use crate::middle::opt::{
    add_pred_like, remove_block, remove_pred, remove_pred_at, remove_trivial_phis,
    remove_unreachable, resolve_all, simplify_cfg,
};

// ---- Selects ----

// The instructions an arm of a select may hold: pure, cheap ones (no
// division: its checks and, on x86-64, its fixed registers cost more than
// a branch).
fn is_speculable(cx: &mut FnCtx, v: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let op = (*cx.insts.add(v as usize)).op;
        if op.is_remat() {
            return true;
        }
        // (0.19: not one that needs a feature known only under a guard,
        // middle::licm::op_guarded)
        op.is_pure() && op != Div && op != Rem && !crate::middle::licm::op_guarded(cx, v, pcx)
            && !(op == Conv
                && (is_float((*cx.insts.add(v as usize)).ty)
                    || is_float((*cx.insts.add(v as usize)).imm2)))
    }
}

// The number of instructions of arm block `b` that cost something, or -1
// when it holds one it may not.
fn arm_cost(cx: &mut FnCtx, b: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let mut cost: i64 = 0;
        let mut v = (*cx.blocks.add(b as usize)).first;
        while v != 0 {
            if !is_speculable(cx, v, pcx) {
                return -1;
            }
            if !(*cx.insts.add(v as usize)).op.is_remat() {
                cost += 1;
            }
            v = (*cx.insts.add(v as usize)).next;
        }
        cost
    }
}

fn selectable_type(ty: i64, pcx: &Ctx<Comp>) -> bool {
    if is_vector(ty, pcx) {
        return false;
    }
    if is_float(ty) {
        return !get_x86();
    }
    ty != 0
}

// Whether block b is an arm: only reached from h, only jumping on.
fn is_arm(cx: &mut FnCtx, b: i64, h: i64) -> bool {
    unsafe {
        (*cx.blocks.add(b as usize)).preds.count == 1
            && (*(*cx.blocks.add(b as usize)).preds.data.add(0)) == h
            && (*cx.blocks.add(b as usize)).term == Term::Jump
    }
}

// (0.15) The middle end's selects (SEL k, x, y: made by if-conversion in
// loops) become SELECTs: on the comparison k when it is one (an integer
// one on x86-64), else on k != 0.
pub fn lower_sels(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    let mut changed = false;
    unsafe {
        for i in 0..(*get_irfuncs().add(fi as usize)).blocks.count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let next = (*cx.insts.add(v as usize)).next;
                if (*cx.insts.add(v as usize)).op == Op::Sel {
                    let cond = ir_val(cx, (*cx.insts.add(v as usize)).a);
                    let mut lhs = cond;
                    let mut rhs: i64 = 0;
                    let mut imm: i64 = 0;
                    let mut cmp_ty = TY_U64;
                    let mut op = Cond::Ne;
                    if (*cx.insts.add(cond as usize)).op == Cmp
                        && !(is_float((*cx.insts.add(cond as usize)).imm2) && get_x86()) {
                        cmp_ty = (*cx.insts.add(cond as usize)).imm2;
                        lhs = ir_val(cx, (*cx.insts.add(cond as usize)).a);
                        rhs = ir_val(cx, (*cx.insts.add(cond as usize)).b);
                        op = (*cx.insts.add(cond as usize)).cond;
                        let mut value: i64 = 0;
                        if isel_const(cx, rhs, &mut value) && fits_cmp_imm(value) {
                            rhs = 0;
                            imm = value;
                        }
                    }
                    let arg_v = (*cx.insts.add(v as usize)).ty;
                    let ir_val_v = ir_val(cx, (*cx.insts.add(v as usize)).b);
                    let ir_val_v1 = ir_val(cx, (*cx.insts.add(v as usize)).c);
                    let sel = ir_make(cx, Select, arg_v, ir_val_v,
                        ir_val_v1, imm, pcx);
                    (*cx.insts.add(sel as usize)).cond = op;
                    (*cx.insts.add(sel as usize)).imm2 = cmp_ty;
                    (*cx.insts.add(sel as usize)).args = cx.args.count;
                    cx.args.push(lhs);
                    cx.argty.push(0);
                    cx.args.push(rhs);
                    cx.argty.push(0);
                    (*cx.insts.add(sel as usize)).nargs = 2;
                    ir_insert_before(cx, v, sel);
                    ir_replace(cx, v, sel);
                    changed = true;
                }
                v = next;
            }
        }
    }
    changed
}

// Turns small diamonds and triangles into selects; returns whether any was.
pub fn form_selects(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut changed = false;
        for _ in 0..2 {
            let mut round = false;
            let count = (*get_irfuncs().add(fi as usize)).blocks.count;
            for i in 0..count {
                let h = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
                if (*cx.blocks.add(h as usize)).removed == 0
                    && (*cx.blocks.add(h as usize)).term == Term::Branch
                    && try_select(cx, h, pcx) {
                    round = true;
                }
            }
            if !round {
                break;
            }
            changed = true;
            resolve_all(cx, fi);
            remove_trivial_phis(cx, fi, pcx);
            resolve_all(cx, fi);
            simplify_cfg(cx, fi, pcx);
            resolve_all(cx, fi);
        }
        changed
    }
}

fn try_select(cx: &mut FnCtx, h: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let t = (*cx.blocks.add(h as usize)).s0;
        let e = (*cx.blocks.add(h as usize)).s1;
        if t == e || t == h || e == h {
            return false;
        }
        // The meeting block and the arms (0: the arm is the edge itself).
        let mut join: i64 = 0;
        let mut arm_t: i64 = 0;
        let mut arm_e: i64 = 0;
        if is_arm(cx, t, h) && is_arm(cx, e, h)
            && (*cx.blocks.add(t as usize)).s0 == (*cx.blocks.add(e as usize)).s0 {
            join = (*cx.blocks.add(t as usize)).s0;
            arm_t = t;
            arm_e = e;
        } else if is_arm(cx, t, h) && (*cx.blocks.add(t as usize)).s0 == e {
            join = e;
            arm_t = t;
        } else if is_arm(cx, e, h) && (*cx.blocks.add(e as usize)).s0 == t {
            join = t;
            arm_e = e;
        } else {
            return false;
        }
        if join == h || join == t && arm_t != 0 || join == e && arm_e != 0 {
            return false;
        }
        let cost_t: i64 = if arm_t != 0 { arm_cost(cx, arm_t, pcx) } else { 0 };
        let cost_e: i64 = if arm_e != 0 { arm_cost(cx, arm_e, pcx) } else { 0 };
        if cost_t < 0 || cost_e < 0 || cost_t > 2 || cost_e > 2 {
            return false;
        }
        // The comparison.
        let cond = (*cx.blocks.add(h as usize)).cond;
        let mut lhs = cond;
        let mut rhs: i64 = 0;
        let mut imm: i64 = 0;
        let mut cmp_ty = TY_U64;
        let mut op = Cond::Ne;
        if (*cx.insts.add(cond as usize)).op == Cmp {
            cmp_ty = (*cx.insts.add(cond as usize)).imm2;
            if is_float(cmp_ty) && get_x86() {
                return false;
            }
            lhs = (*cx.insts.add(cond as usize)).a;
            rhs = (*cx.insts.add(cond as usize)).b;
            op = (*cx.insts.add(cond as usize)).cond;
            let mut value: i64 = 0;
            if isel_const(cx, rhs, &mut value) && fits_cmp_imm(value) {
                rhs = 0;
                imm = value;
            }
        }
        // The phis of the meeting block, and their values from each way.
        let index_t = pred_index(cx, join, if arm_t != 0 { arm_t } else { h });
        let index_e = pred_index(cx, join, if arm_e != 0 { arm_e } else { h });
        if index_t < 0 || index_e < 0 {
            return false;
        }
        let mut selects: i64 = 0;
        let mut phi = (*cx.blocks.add(join as usize)).first;
        while phi != 0 && (*cx.insts.add(phi as usize)).op == Phi {
            let ir_arg_v2 = ir_arg(cx, phi, index_t);
            let ir_val_v = ir_val(cx, ir_arg_v2);
            let ir_arg_v3 = ir_arg(cx, phi, index_e);
            let ir_val_v1 = ir_val(cx, ir_arg_v3);
            if ir_val_v != ir_val_v1 {
                if !selectable_type((*cx.insts.add(phi as usize)).ty, pcx) {
                    return false;
                }
                selects += 1;
            }
            phi = (*cx.insts.add(phi as usize)).next;
        }
        if selects == 0 || selects > 2 || cost_t + cost_e + selects > 4 {
            return false;
        }
        // The arms' instructions move up into h.
        if arm_t != 0 {
            move_instructions(cx, arm_t, h);
        }
        if arm_e != 0 {
            move_instructions(cx, arm_e, h);
        }
        // One select per phi that picks; the phi then gets it from h.
        phi = (*cx.blocks.add(join as usize)).first;
        while phi != 0 && (*cx.insts.add(phi as usize)).op == Phi {
            let ir_arg_v = ir_arg(cx, phi, index_t);
            let value_t = ir_val(cx, ir_arg_v);
            let ir_arg_v1 = ir_arg(cx, phi, index_e);
            let value_e = ir_val(cx, ir_arg_v1);
            let mut picked = value_t;
            if value_t != value_e {
                let sel = ir_make(cx, Select, (*cx.insts.add(phi as usize)).ty, value_t, value_e,
                    imm, pcx);
                (*cx.insts.add(sel as usize)).cond = op;
                (*cx.insts.add(sel as usize)).imm2 = cmp_ty;
                (*cx.insts.add(sel as usize)).args = cx.args.count;
                cx.args.push(lhs);
                cx.argty.push(0);
                cx.args.push(rhs);
                cx.argty.push(0);
                (*cx.insts.add(sel as usize)).nargs = 2;
                ir_append(cx, h, sel);
                picked = sel;
            }
            ir_set_arg(cx, phi, index_t, picked);
            ir_set_arg(cx, phi, index_e, picked);
            phi = (*cx.insts.add(phi as usize)).next;
        }
        // h now jumps to the meeting block, once.
        let removed_index = if arm_e != 0 { index_e } else { index_t };
        let kept = if arm_e != 0 { arm_t } else { arm_e };
        (*cx.blocks.add(h as usize)).term = Term::Jump;
        (*cx.blocks.add(h as usize)).cond = 0;
        (*cx.blocks.add(h as usize)).s0 = join;
        (*cx.blocks.add(h as usize)).s1 = 0;
        remove_pred_at(cx, join, removed_index);
        if kept != 0 {
            // The other way's predecessor entry becomes h.
            (*(*cx.blocks.add(join as usize)).preds.data.add(pred_index(cx, join, kept) as usize)) = h;
        } else if arm_e == 0 && arm_t == 0 {
            die(c"internal error: select without arms");
        }
        if arm_t != 0 {
            drop_arm(cx, arm_t);
        }
        if arm_e != 0 {
            drop_arm(cx, arm_e);
        }
        true
    }
}

// Moves the instructions of block `from` to the end of block `to`.
fn move_instructions(cx: &mut FnCtx, from: i64, to: i64) {
    unsafe {
        let mut v = (*cx.blocks.add(from as usize)).first;
        while v != 0 {
            let next = (*cx.insts.add(v as usize)).next;
            ir_unlink(cx, v);
            ir_append(cx, to, v);
            v = next;
        }
    }
}

// Removes an emptied arm (its edges are already redirected).
fn drop_arm(cx: &mut FnCtx, b: i64) {
    unsafe {
        (*cx.blocks.add(b as usize)).removed = 1;
        (*cx.blocks.add(b as usize)).term = Term::None;
        (*cx.blocks.add(b as usize)).preds.count = 0;
        (*cx.blocks.add(b as usize)).first = 0;
        (*cx.blocks.add(b as usize)).last = 0;
    }
}

// ---- Branches on phis ----

pub fn thread_phi_branches(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let mut changed = decide_repeated_branches(cx, fi);
        isel_count_uses(cx, fi);
        let count = (*get_irfuncs().add(fi as usize)).blocks.count;
        for i in 0..count {
            let b = (*(*get_irfuncs().add(fi as usize)).blocks.data.add(i as usize));
            if (*cx.blocks.add(b as usize)).removed != 0
                || (*cx.blocks.add(b as usize)).term != Term::Branch {
                continue;
            }
            let p = (*cx.blocks.add(b as usize)).first;
            let s0 = (*cx.blocks.add(b as usize)).s0;
            let s1 = (*cx.blocks.add(b as usize)).s1;
            // Only the phi, used by the branch alone.
            if p == 0 || p != (*cx.blocks.add(b as usize)).cond
                || (*cx.insts.add(p as usize)).op != Phi || (*cx.insts.add(p as usize)).next != 0
                || (*cx.isel_uses.add(p as usize)) != 1
                || s0 == s1 || s0 == b || s1 == b {
                continue;
            }
            let mut k: i64 = 0;
            while k < (*cx.blocks.add(b as usize)).preds.count {
                let pred = (*(*cx.blocks.add(b as usize)).preds.data.add(k as usize));
                let ir_arg_v = ir_arg(cx, p, k);
                let value = ir_val(cx, ir_arg_v);
                // (0.11) A predecessor branching on the phi's value for it
                // (`a && b` when a is false): the edge decides it.
                if (*cx.blocks.add(pred as usize)).term == Term::Branch
                    && ir_val(cx, (*cx.blocks.add(pred as usize)).cond) == value
                    && pred != b
                    && ((*cx.blocks.add(pred as usize)).s0 == b)
                    != ((*cx.blocks.add(pred as usize)).s1 == b) {
                    let target = if (*cx.blocks.add(pred as usize)).s0 == b { s0 } else { s1 };
                    let other = if (*cx.blocks.add(pred as usize)).s0
                        == b { (*cx.blocks.add(pred as usize)).s1 }
                        else { (*cx.blocks.add(pred as usize)).s0 };
                    if target != other && target != pred {
                        if (*cx.blocks.add(pred as usize)).s0 == b {
                            (*cx.blocks.add(pred as usize)).s0 = target;
                        } else {
                            (*cx.blocks.add(pred as usize)).s1 = target;
                        }
                        add_pred_like(cx, target, pred, b);
                        remove_pred_at(cx, b, k);
                        changed = true;
                        continue;
                    }
                }
                if (*cx.blocks.add(pred as usize)).term != Term::Jump || pred == b || pred == s0
                    || pred == s1 {
                    k += 1;
                    continue;
                }
                let mut known: i64 = 0;
                if isel_const(cx, value, &mut known) {
                    let target = if known != 0 { s0 } else { s1 };
                    (*cx.blocks.add(pred as usize)).s0 = target;
                    add_pred_like(cx, target, pred, b);
                } else {
                    (*cx.blocks.add(pred as usize)).term = Term::Branch;
                    (*cx.blocks.add(pred as usize)).cond = value;
                    (*cx.blocks.add(pred as usize)).s0 = s0;
                    (*cx.blocks.add(pred as usize)).s1 = s1;
                    add_pred_like(cx, s0, pred, b);
                    add_pred_like(cx, s1, pred, b);
                }
                remove_pred_at(cx, b, k);
                changed = true;
            }
            if (*cx.blocks.add(b as usize)).preds.count == 0 {
                remove_block(cx, b);
            }
        }
        if changed {
            resolve_all(cx, fi);
            remove_unreachable(cx, fi);
            remove_trivial_phis(cx, fi, pcx);
            resolve_all(cx, fi);
        }
        changed
    }
}

// A branch on the condition its block's only predecessor branched on is
// decided by the edge that leads there: it becomes a jump. Returns whether
// any did.
fn decide_repeated_branches(cx: &mut FnCtx, fi: i64) -> bool {
    let mut changed = false;
    unsafe {
        for b in (*get_irfuncs().add(fi as usize)).blocks.items() {
            // (A branch both ways to one block is two predecessor entries there:
            // left alone.)
            if (*cx.blocks.add(b as usize)).removed != 0
                || (*cx.blocks.add(b as usize)).term != Term::Branch
                || (*cx.blocks.add(b as usize)).preds.count != 1
                || (*cx.blocks.add(b as usize)).s0 == (*cx.blocks.add(b as usize)).s1 {
                continue;
            }
            let p = (*(*cx.blocks.add(b as usize)).preds.data.add(0));
            let cond = ir_val(cx, (*cx.blocks.add(b as usize)).cond);
            if p == b || (*cx.blocks.add(p as usize)).term != Term::Branch
                || ir_val(cx, (*cx.blocks.add(p as usize)).cond) != cond
                || (*cx.blocks.add(p as usize)).s0 == (*cx.blocks.add(p as usize)).s1 {
                continue;
            }
            let taken = (*cx.blocks.add(p as usize)).s0 == b;
            let keep = if taken { (*cx.blocks.add(b as usize)).s0 }
                else { (*cx.blocks.add(b as usize)).s1 };
            let drop = if taken { (*cx.blocks.add(b as usize)).s1 }
                else { (*cx.blocks.add(b as usize)).s0 };
            if keep != drop {
                remove_pred(cx, drop, b);
            }
            (*cx.blocks.add(b as usize)).term = Term::Jump;
            (*cx.blocks.add(b as usize)).cond = 0;
            (*cx.blocks.add(b as usize)).s0 = keep;
            (*cx.blocks.add(b as usize)).s1 = 0;
            changed = true;
        }
    }
    changed
}
