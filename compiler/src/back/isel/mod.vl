// Instruction selection: from the optimized IR to machine operations, just
// before register allocation (after --emit-ir, so the optimizer's IR is what
// that shows).
//
// Three steps per function:
//
// 0. Branches on phis. A block holding nothing but a phi and a branch on
//    it (what `&&`, `||` and a `bool` result of `if` leave) is threaded:
//    each predecessor that jumps there branches itself, on its own value
//    for the phi (a comparison it made, fused with the branch then), or
//    jumps where a constant goes.
//
// 1. Selects. A branch whose two ways (a diamond, or a triangle with one
//    way empty) do at most a few pure, cheap instructions and meet again in
//    a block whose phis pick between their values becomes those
//    instructions, moved up, and a SELECT per phi (csel / fcsel on AArch64,
//    cmov on x86-64, integers only there). A select owns its comparison: it
//    compares its two extra operands itself (ARGS: the left side, and the
//    right side or 0 for an immediate in imm), so nothing can come between
//    the comparison and its use of the flags.
//
// 1b. Divisions by constants (0.11): x / d and x % d for a constant d are
//    a multiplication by a magic number (divisions.vl), then tiled as the rest.
//
// 2. Tiling, by maximal munch: the instructions of each block from the last
//    to the first, so that a user is matched before what it uses. A rule
//    matches an instruction (the root) and the definitions of some of its
//    operands, each in the same block and used by the root alone, and
//    rewrites the root in place into a machine operation whose operands are
//    the leaves; what the rule covered dies, and dead code elimination
//    removes it. The machine operations (ir.vl):
//
//    loadx  ty a, b [off, -, s]      load ty from a + (b << s) + off
//    storex a, b, c [off, ty, s]     store c (of type ty) there
//    lea    a, b [off, -, s]         a + (b << s) + off (b may be 0), 64-bit
//    madd   a, b, c                  c + a * b (AArch64)
//    msub   a, b, c                  c - a * b (AArch64)
//    shop   a, b [k, 4 * op + kind]  a op (b sh k); sh: 0 lsl, 1 lsr, 2 asr
//                                    (AArch64)
//    ubfx   a [k, n]                 (a >> k) & (2^n - 1), k + n within the
//                                    type (AArch64)
//    test.c a, b [m]                 (a & b) c 0, b 0 for the mask m: only
//                                    as the condition of the branch ending
//                                    its block
//    fmath  a [kind]                 sqrt, fabs, floor, ceil, trunc, round
//                                    (kind 0 to 5) of a float
//    mulh   a, b [signed]            the high 64 bits of the 128-bit a * b
//                                    (umulh, smulh; mulq, imulq: rdx)
//    select.c a, b; lhs, rhs [imm, ty, kind]
//                                    a if lhs c rhs (kind & 1 == 0) or if
//                                    (lhs & rhs) c 0 (kind & 1 == 1), else
//                                    b, or b + 1 when kind & 2 (csinc);
//                                    rhs 0: the immediate imm; ty the
//                                    comparison's operand type
//
// Then two scheduling rules (before register allocation): a branch's
// comparison moves to the end of its block, where the branch fuses with
// it; constants defined in loops move to the entry block (up to 16 per
// function), so that a constant needed in a register is made once (the
// allocator still brings it back by rematerialization, before the loop,
// when it runs short of registers).
//
// The rules, per target:
//
//   both     load/store of (a + (b << s)), (a + b)  -> loadx/storex
//            branch on (x & m) == 0, != 0           -> test
//            selects (above); a select on (x & m) == 0 or != 0 tests
//            the C library's sqrt (and sqrtf) on macOS, whose libm never
//            sets errno                             -> fmath (fsqrt, sqrtsd)
//   AArch64  s is the access size (or 0) and there is no offset;
//            c + a * b, c - a * b                   -> madd, msub
//            x op (y sh k), op in + - & | ^         -> shop
//            (x >> k) & (2^n - 1)                   -> ubfx
//            c ? a : b + 1, c ? a + 1 : b (integers) -> csinc
//            fabs, floor, ceil, trunc, round (and their f32 forms: exact
//            instructions, no errno)               -> fmath (fabs, frint*)
//   x86-64   s up to 3, any offset, a frame slot as the base (from %rsp);
//            a + (b << s), a + b, a + k, a - k (64-bit) -> lea
//
// Integer arithmetic wraps, and every machine operation normalizes its
// result to its type once, so fusing integer operations is exact. Floats
// are never fused (no fmadd): vole's float arithmetic is IEEE, one
// rounding per operation.

mod branches;
mod divisions;
mod tiling;
pub mod arch;

use crate::back::isel::arch::expand_cpu_features;
use crate::back::isel::branches::{form_selects, lower_sels, thread_phi_branches};
use crate::back::isel::divisions::lower_divisions;
use crate::back::isel::tiling::isel_function;
use crate::back::regalloc::prepare::layout_blocks;
use crate::base::table_reset;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::get_x86;
use crate::front::types::{TY_F64, is_float, is_vector, type_size};
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Op, Term, fn_block, fn_block_count, fn_entry, ir_append, ir_enter, ir_insert_before, ir_operand,
    ir_operand_count, ir_unlink,
};
use crate::middle::ir::Op::{Cmp, Const, Copy, Load, LoadX, Param, Store, StoreX, Test};
use crate::middle::ir::verify::verify_func;
use crate::middle::opt::{eliminate_dead_code, resolve_all};

pub fn select_instructions(cx: &mut FnCtx<Comp>, pcx: &Ctx<Comp>) {
    for fi in 0..pcx.irfunc_count {
        if (pcx.fn_live[fi as usize]) != 0 {
            select_function(cx, fi, pcx);
        }
    }
}

// Instruction selection for function fi.
pub fn select_function(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    ir_enter(cx, fi, pcx);
    if lower_sels(cx, fi, pcx) {
        resolve_all(cx, fi);
        eliminate_dead_code(cx, fi, pcx);
    }
    let threaded = thread_phi_branches(cx, fi, pcx);
    if form_selects(cx, fi, pcx) || threaded {
        eliminate_dead_code(cx, fi, pcx);
    }
    // (0.19: std::arch's run-time feature tests)
    if pcx.arch_used {
        expand_cpu_features(cx, fi, pcx);
    }
    lower_divisions(cx, fi, pcx);
    isel_function(cx, fi, pcx);
    eliminate_dead_code(cx, fi, pcx);
    schedule_function(cx, fi, pcx);
    verify_func(cx, fi, c"instruction selection", pcx);
}

// ---- Use counts ----

fn isel_count_uses(cx: &mut FnCtx<Comp>, fi: i64) {
    if cx.isel_uses.len() < cx.insts.len() + 1 {
        let cap = 2 * cx.insts.len() + 1024;
        table_reset(&mut cx.isel_uses, cap, 0);
    }
    for bix in 0..fn_block_count(cx, fi) {
        let b = fn_block(cx, fi, bix);
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            (cx.isel_uses[v as usize]) = 0;
            v = (cx.insts[v as usize]).next;
        }
    }
    for bix in 0..fn_block_count(cx, fi) {
        let b = fn_block(cx, fi, bix);
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            for k in 0..ir_operand_count(cx, v) {
                let operand = ir_operand(cx, v, k);
                if operand != 0 {
                    (cx.isel_uses[operand as usize]) += 1;
                }
            }
            v = (cx.insts[v as usize]).next;
        }
        if (cx.blocks[b as usize]).cond != 0 {
            (cx.isel_uses[(cx.blocks[b as usize]).cond as usize]) += 1;
        }
    }
}

// One use of `v` less; when it was the last, `v` is dead and so are its
// own uses.
fn isel_release(cx: &mut FnCtx<Comp>, v: i64) {
    if v == 0 {
        return;
    }
    (cx.isel_uses[v as usize]) -= 1;
    if (cx.isel_uses[v as usize]) == 0
        && !(cx.insts[v as usize]).op.has_side_effect() {
        for k in 0..ir_operand_count(cx, v) {
            let ir_operand_v = ir_operand(cx, v, k);
            isel_release(cx, ir_operand_v);
        }
    }
}

fn isel_retain(cx: &mut FnCtx<Comp>, v: i64) {
    if v != 0 {
        (cx.isel_uses[v as usize]) += 1;
    }
}

// Whether `v` (an operand of `user`) can be covered by a rule rooted at
// `user`: an integer instruction `op` of the same block used by `user`
// alone.
fn coverable(cx: &mut FnCtx<Comp>, v: i64, op: Op, user: i64) -> bool {
    v != 0 && (cx.insts[v as usize]).op == op
        && (cx.insts[v as usize]).block == (cx.insts[user as usize]).block
        && (cx.isel_uses[v as usize]) == 1 && !is_float((cx.insts[v as usize]).ty)
}

fn isel_const(cx: &mut FnCtx<Comp>, v: i64, out: &mut i64) -> bool {
    if v != 0 && (cx.insts[v as usize]).op == Const
        && !is_float((cx.insts[v as usize]).ty) {
        *out = (cx.insts[v as usize]).imm;
        return true;
    }
    false
}

// Rewrites root `v`'s operands to a, b, c (counting the new uses before
// releasing the old ones, so that shared leaves stay alive).
fn isel_set_operands(cx: &mut FnCtx<Comp>, v: i64, a: i64, b: i64, c: i64) {
    let old_a = (cx.insts[v as usize]).a;
    let old_b = (cx.insts[v as usize]).b;
    let old_c = (cx.insts[v as usize]).c;
    (cx.insts[v as usize]).a = a;
    (cx.insts[v as usize]).b = b;
    (cx.insts[v as usize]).c = c;
    isel_retain(cx, a);
    isel_retain(cx, b);
    isel_retain(cx, c);
    isel_release(cx, old_a);
    isel_release(cx, old_b);
    isel_release(cx, old_c);
}

// ---- Scheduling ----

fn schedule_function(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    isel_count_uses(cx, fi);
    let entry = fn_entry(cx, fi);
    // Loop depths (by layout index), from the allocator's layout.
    layout_blocks(cx, fi);
    // Constants go after the entry's parameters (and before its branch's
    // comparison, which stays last).
    let mut at = (cx.blocks[entry as usize]).first;
    while at != 0 && (cx.insts[at as usize]).op == Param {
        at = (cx.insts[at as usize]).next;
    }
    let mut hoisted: i64 = 0;
    for bix in 0..fn_block_count(cx, fi) {
        let b = fn_block(cx, fi, bix);
        if (cx.blocks[b as usize]).removed != 0 || (cx.blocks[b as usize]).order < 0 {
            continue;
        }
        // The branch's comparison (or test), used by it alone, last.
        let c = (cx.blocks[b as usize]).cond;
        if (cx.blocks[b as usize]).term == Term::Branch && c != 0
            && (cx.insts[c as usize]).block == b && (cx.insts[c as usize]).next != 0
            && ((cx.insts[c as usize]).op == Cmp || (cx.insts[c as usize]).op == Test)
            && (cx.isel_uses[c as usize]) == 1 {
            ir_unlink(cx, c);
            ir_append(cx, b, c);
        }
        if !get_x86() {
            pair_accesses(cx, b, pcx);
        }
        if b == entry
            || (cx.ldepth[(cx.blocks[b as usize]).order as usize]) == 0 {
            continue;
        }
        let mut v = (cx.blocks[b as usize]).first;
        while v != 0 {
            let next = (cx.insts[v as usize]).next;
            if (cx.insts[v as usize]).op == Const && (cx.isel_uses[v as usize]) > 0
                && hoisted < 16 {
                ir_unlink(cx, v);
                if at == 0 {
                    ir_append(cx, entry, v);
                } else {
                    ir_insert_before(cx, at, v);
                }
                hoisted += 1;
            }
            v = next;
        }
    }
}

// (0.15) The size of an access ldp or stp can pair (a 64-bit integer or
// float, a vector), or 0.
fn pair_size(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) -> i64 {
    let ty = if (cx.insts[v as usize]).op == Load { (cx.insts[v as usize]).ty }
        else { (cx.insts[v as usize]).imm2 };
    if is_vector(ty, pcx) {
        16
    } else if type_size(ty, pcx) == 8 && (!is_float(ty) || ty == TY_F64) {
        8
    } else {
        0
    }
}

// (0.25.5) Whether loads of types a and b can pair: the same type, or two
// 64-bit integers whatever their signedness (a Vec's ptr, a u64, and its
// len, an i64, read side by side for each `v[i]`).
fn pair_types(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    a == b
        || (!is_float(a) && !is_vector(a, pcx) && !is_float(b) && !is_vector(b, pcx)
            && type_size(a, pcx) == 8 && type_size(b, pcx) == 8)
}

// (0.15, AArch64) Loads (stores) of one base at offsets one access apart
// are put side by side, the lower offset first, for emission to make them
// one ldp (stp): a load moves up to the other, past no store or call; a
// store moves down to the other, past no memory access or call. Unrolled
// copies of a loop body load a[k], b[k], then a[k + 1], b[k + 1].
fn pair_accesses(cx: &mut FnCtx<Comp>, b: i64, pcx: &Ctx<Comp>) {
    let mut w = (cx.blocks[b as usize]).first;
    while w != 0 {
        let next = (cx.insts[w as usize]).next;
        let op = (cx.insts[w as usize]).op;
        let size: i64 = if op == Load || op == Store { pair_size(cx, w, pcx) } else { 0 };
        if size != 0 && (op == Store || (cx.isel_uses[w as usize]) > 0) {
            let mut v = (cx.insts[w as usize]).prev;
            let mut steps: i64 = 0;
            while v != 0 && steps < 16 {
                let vop = (cx.insts[v as usize]).op;
                if vop == op && (cx.insts[v as usize]).a == (cx.insts[w as usize]).a
                    && pair_size(cx, v, pcx) == size
                    && ((cx.insts[v as usize]).imm + size
                        == (cx.insts[w as usize]).imm
                        || (cx.insts[w as usize]).imm + size
                        == (cx.insts[v as usize]).imm)
                    && (op == Store
                        || ((cx.isel_uses[v as usize]) > 0
                            && pair_types((cx.insts[v as usize]).ty,
                                (cx.insts[w as usize]).ty, pcx)))
                    && (op == Load
                        || (cx.insts[v as usize]).imm2
                        == (cx.insts[w as usize]).imm2) {
                    if op == Load {
                        ir_unlink(cx, w);
                        if (cx.insts[v as usize]).imm < (cx.insts[w as usize]).imm {
                            insert_after(cx, v, w);
                        } else {
                            ir_insert_before(cx, v, w);
                        }
                    } else {
                        ir_unlink(cx, v);
                        if (cx.insts[v as usize]).imm < (cx.insts[w as usize]).imm {
                            ir_insert_before(cx, w, v);
                        } else {
                            insert_after(cx, w, v);
                        }
                    }
                    break;
                }
                // What the move may not pass.
                if vop.is_call() || vop == Store || vop == StoreX || vop == Copy
                    || vop == Op::Phi || (op == Store && (vop == Load || vop == LoadX))
                    || vop == Op::Atomic || vop == Op::Fence
                    || (cx.insts[v as usize]).block != b {
                    break;
                }
                v = (cx.insts[v as usize]).prev;
                steps += 1;
            }
        }
        w = next;
    }
}

// Puts unlinked instruction y right after x.
fn insert_after(cx: &mut FnCtx<Comp>, x: i64, y: i64) {
    if (cx.insts[x as usize]).next != 0 {
        ir_insert_before(cx, (cx.insts[x as usize]).next, y);
    } else {
        ir_append(cx, (cx.insts[x as usize]).block, y);
    }
}
