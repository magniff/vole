// Tiling by maximal munch (isel/mod.vl, step 2): the rules that rewrite
// an instruction and the operands it covers into a machine operation, per
// target: addresses, lea, madd, shop, ubfx, test branches, selects and
// library calls.

use crate::back::emit::blocks::fits_cmp_imm;
use crate::back::isel::{
    coverable, isel_const, isel_count_uses, isel_release, isel_retain, isel_set_operands,
};
use crate::back::mc_arm64::ops::{is_logical_imm, ma_int_imm_ok};
use crate::base::{streq, sym_name};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::front::types::{
    TY_F32, TY_F64, TY_U32, TY_U64, fn_param, int_bits, is_float, is_integer, is_signed, type_size,
};
use crate::gen0::target::log2;
use crate::gen0::x86_64::fits_i32;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{Cond, Op, Term, fn_block, fn_block_count, ir_arg, ir_set_arg};
use crate::middle::ir::Op::{
    Add, And, Call, Cmp, Const, FMath, Lea, Load, LoadX, MAdd, MSub, Mul, Or, Select, ShOp, Shl,
    Shr, Slot, Store, StoreX, Sub, Test, Ubfx, Xor,
};
use crate::middle::opt::resolve_all;

// ---- Tiling ----

pub fn isel_function(cx: &mut FnCtx<Comp>, fi: i64, pcx: &Ctx<Comp>) {
    resolve_all(cx, fi);
    isel_count_uses(cx, fi);
    for bix in 0..fn_block_count(cx, fi) {
        let b = fn_block(cx, fi, bix);
        if (cx.blocks[b as usize]).removed != 0 {
            continue;
        }
        isel_branch(cx, b);
        let mut v = (cx.blocks[b as usize]).last;
        while v != 0 {
            let prev = (cx.insts[v as usize]).prev;
            if (cx.isel_uses[v as usize]) > 0
                || (cx.insts[v as usize]).op.has_side_effect() {
                isel_inst(cx, v, pcx);
            }
            v = prev;
        }
    }
}

fn isel_inst(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let op = (cx.insts[v as usize]).op;
    if op == Call {
        isel_libcall(cx, v, pcx);
    } else if op == Load || op == Store {
        isel_address(cx, v, pcx);
    } else if op == Select {
        isel_select_test(cx, v);
        isel_select_increment(cx, v);
    } else if is_float((cx.insts[v as usize]).ty) {
        return;
    } else if get_x86() {
        if op == Add || op == Sub {
            isel_lea(cx, v);
        }
    } else if op == Add || op == Sub {
        if !isel_madd(cx, v) && !isel_cinc(cx, v) {
            isel_shop(cx, v);
        }
    } else if op == And {
        if !isel_ubfx(cx, v) {
            isel_shop(cx, v);
        }
    } else if op == Or || op == Xor {
        if !isel_rotate(cx, v) {
            isel_shop(cx, v);
        }
    }
}

// A 64-bit integer type (no normalization).
fn is_wide_int(ty: i64) -> bool {
    is_integer(ty) && int_bits(ty) == 64
}

// load/store of base + (index << s) (or base + index).
fn isel_address(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let addr = (cx.insts[v as usize]).a;
    let store = (cx.insts[v as usize]).op == Store;
    let ty = if store { (cx.insts[v as usize]).imm2 }
        else { (cx.insts[v as usize]).ty };
    let offset = (cx.insts[v as usize]).imm;
    if !coverable(cx, addr, Add, v) || !is_wide_int((cx.insts[addr as usize]).ty) {
        return;
    }
    if !get_x86() && offset != 0 {
        return;
    }
    if get_x86() && !fits_i32(offset) {
        return;
    }
    let size = type_size(ty, pcx);
    let mut chosen_base: i64 = 0;
    let mut chosen_index: i64 = 0;
    let mut chosen_scale: i64 = -1;
    // A shifted index first, then a plain one.
    for side in 0..2 {
        let base = if side == 0 { (cx.insts[addr as usize]).a }
            else { (cx.insts[addr as usize]).b };
        let index = if side == 0 { (cx.insts[addr as usize]).b }
            else { (cx.insts[addr as usize]).a };
        let mut k: i64 = 0;
        if chosen_scale < 0 && coverable(cx, index, Shl, addr)
            && is_wide_int((cx.insts[index as usize]).ty)
            && isel_const(cx, (cx.insts[index as usize]).b, &mut k) && base_ok(cx, base) {
            let s = k & 63;
            if (get_x86() && s <= 3) || (!get_x86() && (s == 0 || (1 << s as u64) == size)) {
                chosen_base = base;
                chosen_index = (cx.insts[index as usize]).a;
                chosen_scale = s;
            }
        }
    }
    if chosen_scale < 0 {
        let base = (cx.insts[addr as usize]).a;
        let index = (cx.insts[addr as usize]).b;
        if (cx.insts[index as usize]).op.is_remat()
            && !(cx.insts[base as usize]).op.is_remat() {
            // A constant or an address is the base (a slot from %rsp).
            if !base_ok(cx, index) {
                return;
            }
            chosen_base = index;
            chosen_index = base;
        } else {
            if !base_ok(cx, base) {
                return;
            }
            chosen_base = base;
            chosen_index = index;
        }
        if (cx.insts[chosen_index as usize]).op == Const {
            // base + constant: instcombine folds those into the offset.
            return;
        }
        chosen_scale = 0;
    }
    if store {
        let value = (cx.insts[v as usize]).b;
        (cx.insts[v as usize]).op = StoreX;
        isel_set_operands(cx, v, chosen_base, chosen_index, value);
    } else {
        (cx.insts[v as usize]).op = LoadX;
        isel_set_operands(cx, v, chosen_base, chosen_index, 0);
    }
    (cx.insts[v as usize]).scale = chosen_scale;
}

// Whether `base` may be the base of an indexed access: a frame slot only
// on x86-64 (from %rsp, the slot's offset in the displacement).
fn base_ok(cx: &mut FnCtx<Comp>, base: i64) -> bool {
    base != 0 && (get_x86() || (cx.insts[base as usize]).op != Slot)
}

// x86-64: a + (b << s), a + b, a + k, a - k into any register.
fn isel_lea(cx: &mut FnCtx<Comp>, v: i64) {
    let ty = (cx.insts[v as usize]).ty;
    if !is_wide_int(ty) {
        return;
    }
    let a = (cx.insts[v as usize]).a;
    let b = (cx.insts[v as usize]).b;
    let mut k: i64 = 0;
    if isel_const(cx, b, &mut k) {
        let disp = if (cx.insts[v as usize]).op == Sub { 0 - k } else { k };
        if !fits_i32(k) || !fits_i32(disp) || (cx.insts[a as usize]).op.is_remat() {
            return;
        }
        (cx.insts[v as usize]).op = Lea;
        (cx.insts[v as usize]).imm = disp;
        (cx.insts[v as usize]).scale = 0;
        // (x * 3) + k = k(x, x, 2), and (x + y) + k = k(x, y).
        let mut m: i64 = 0;
        if coverable(cx, a, Mul, v) && (cx.insts[a as usize]).ty == ty
            && isel_const(cx, (cx.insts[a as usize]).b, &mut m)
            && (m == 3 || m == 5 || m == 9) {
            (cx.insts[v as usize]).scale = log2(m - 1);
            isel_set_operands(cx, v, (cx.insts[a as usize]).a,
                (cx.insts[a as usize]).a, 0);
            return;
        }
        if coverable(cx, a, Add, v) && (cx.insts[a as usize]).ty == ty
            && !(cx.insts[(cx.insts[a as usize]).a as usize]).op.is_remat()
            && !(cx.insts[(cx.insts[a as usize]).b as usize]).op.is_remat() {
            isel_set_operands(cx, v, (cx.insts[a as usize]).a,
                (cx.insts[a as usize]).b, 0);
            return;
        }
        isel_set_operands(cx, v, a, 0, 0);
        return;
    }
    if (cx.insts[v as usize]).op != Add || (cx.insts[a as usize]).op == Const
        || (cx.insts[b as usize]).op == Const {
        return;
    }
    for side in 0..2 {
        let base = if side == 0 { a } else { b };
        let index = if side == 0 { b } else { a };
        let mut s: i64 = 0;
        if coverable(cx, index, Shl, v) && (cx.insts[index as usize]).ty == ty
            && isel_const(cx, (cx.insts[index as usize]).b, &mut s)
            && (s & 63) <= 3 && (cx.insts[base as usize]).op != Slot {
            (cx.insts[v as usize]).op = Lea;
            (cx.insts[v as usize]).imm = 0;
            (cx.insts[v as usize]).scale = s & 63;
            isel_set_operands(cx, v, base, (cx.insts[index as usize]).a, 0);
            return;
        }
    }
    if (cx.insts[a as usize]).op == Slot || (cx.insts[b as usize]).op == Slot {
        return;
    }
    (cx.insts[v as usize]).op = Lea;
    (cx.insts[v as usize]).imm = 0;
    (cx.insts[v as usize]).scale = 0;
    isel_set_operands(cx, v, a, b, 0);
}

// AArch64: c + a * b, c - a * b.
fn isel_madd(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    let ty = (cx.insts[v as usize]).ty;
    let sub = (cx.insts[v as usize]).op == Sub;
    for side in 0..2 {
        if sub && side == 1 {
            break;
        }
        let m = if side == 0 { (cx.insts[v as usize]).b }
            else { (cx.insts[v as usize]).a };
        let other = if side == 0 { (cx.insts[v as usize]).a }
            else { (cx.insts[v as usize]).b };
        let mut k: i64 = 0;
        if coverable(cx, m, Mul, v) && (cx.insts[m as usize]).ty == ty
            && (cx.insts[other as usize]).op != Const
            && !(isel_const(cx, (cx.insts[m as usize]).b, &mut k) && ma_int_imm_ok(Mul, k)) {
            (cx.insts[v as usize]).op = if sub { MSub } else { MAdd };
            isel_set_operands(cx, v, (cx.insts[m as usize]).a,
                (cx.insts[m as usize]).b, other);
            return true;
        }
    }
    false
}

// AArch64: x + (a cmp b), an integer comparison's 0 or 1 added: cinc (a
// csinc on the opposite condition, !c ? x : x + 1), so the comparison's
// flags feed the add instead of a cset first (0.20: the branchless
// partitions and merges of std's sorts count with it). 64-bit only, as
// isel_select_increment.
fn isel_cinc(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    if (cx.insts[v as usize]).op != Add || !is_wide_int((cx.insts[v as usize]).ty) {
        return false;
    }
    for side in 0..2 {
        let c = if side == 0 { (cx.insts[v as usize]).b }
            else { (cx.insts[v as usize]).a };
        let other = if side == 0 { (cx.insts[v as usize]).a }
            else { (cx.insts[v as usize]).b };
        if !coverable(cx, c, Cmp, v) || is_float((cx.insts[c as usize]).imm2) || other == 0
            || (cx.insts[other as usize]).op == Const {
            continue;
        }
        let lhs = (cx.insts[c as usize]).a;
        let mut rhs = (cx.insts[c as usize]).b;
        let mut imm: i64 = 0;
        let mut value: i64 = 0;
        if isel_const(cx, rhs, &mut value) && fits_cmp_imm(value) {
            rhs = 0;
            imm = value;
        }
        (cx.insts[v as usize]).op = Select;
        (cx.insts[v as usize]).cond = (cx.insts[c as usize]).cond.negate();
        (cx.insts[v as usize]).imm2 = (cx.insts[c as usize]).imm2;
        (cx.insts[v as usize]).imm = imm;
        (cx.insts[v as usize]).scale = 2;
        (cx.insts[v as usize]).args = cx.args.len() as i64;
        cx.args.push(lhs);
        cx.argty.push(0);
        cx.args.push(rhs);
        cx.argty.push(0);
        (cx.insts[v as usize]).nargs = 2;
        isel_retain(cx, lhs);
        isel_retain(cx, rhs);
        isel_set_operands(cx, v, other, other, 0);
        return true;
    }
    false
}

// AArch64 (0.20): (x << a) | (x >> b) with a + b the width, a rotation:
// ror (also with ^, the two sides having no bit in common). u64 and u32
// only: an unsigned >> is a logical shift.
fn isel_rotate(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    let ty = (cx.insts[v as usize]).ty;
    let bits: i64 = if ty == TY_U64 { 64 } else if ty == TY_U32 { 32 } else { 0 };
    if bits == 0 {
        return false;
    }
    for side in 0..2 {
        let l = if side == 0 { (cx.insts[v as usize]).a }
            else { (cx.insts[v as usize]).b };
        let r = if side == 0 { (cx.insts[v as usize]).b }
            else { (cx.insts[v as usize]).a };
        if !coverable(cx, l, Shl, v) || !coverable(cx, r, Shr, v)
            || (cx.insts[l as usize]).ty != ty
            || (cx.insts[r as usize]).ty != ty
            || (cx.insts[l as usize]).a != (cx.insts[r as usize]).a {
            continue;
        }
        let mut ka: i64 = 0;
        let mut kb: i64 = 0;
        if !isel_const(cx, (cx.insts[l as usize]).b, &mut ka)
            || !isel_const(cx, (cx.insts[r as usize]).b, &mut kb)
            || ka <= 0 || kb <= 0 || ka + kb != bits {
            continue;
        }
        (cx.insts[v as usize]).op = ShOp;
        (cx.insts[v as usize]).imm = kb;
        (cx.insts[v as usize]).imm2 = 4 * (Or as i64) + 3;
        isel_set_operands(cx, v, (cx.insts[r as usize]).a, 0, 0);
        return true;
    }
    false
}

// AArch64: x op (y sh k).
fn isel_shop(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    let ty = (cx.insts[v as usize]).ty;
    let op = (cx.insts[v as usize]).op;
    let commutative = op != Sub;
    for side in 0..2 {
        if !commutative && side == 1 {
            break;
        }
        let s = if side == 0 { (cx.insts[v as usize]).b }
            else { (cx.insts[v as usize]).a };
        let other = if side == 0 { (cx.insts[v as usize]).a }
            else { (cx.insts[v as usize]).b };
        if other == 0 || (cx.insts[other as usize]).op == Const || s == 0 {
            continue;
        }
        let mut k: i64 = 0;
        let sop = (cx.insts[s as usize]).op;
        if (sop == Shl || sop == Shr) && coverable(cx, s, sop, v)
            && (cx.insts[s as usize]).ty == ty
            && isel_const(cx, (cx.insts[s as usize]).b, &mut k) {
            let amount = k & (if int_bits(ty) == 64 { 63 } else { 31 });
            let kind: i64 = if sop == Shl { 0 } else if is_signed(ty) { 2 } else { 1 };
            (cx.insts[v as usize]).op = ShOp;
            (cx.insts[v as usize]).imm = amount;
            (cx.insts[v as usize]).imm2 = 4 * (op as i64) + kind;
            isel_set_operands(cx, v, other, (cx.insts[s as usize]).a, 0);
            return true;
        }
    }
    false
}

// AArch64: (x >> k) & (2^n - 1), the field within the type.
fn isel_ubfx(cx: &mut FnCtx<Comp>, v: i64) -> bool {
    let ty = (cx.insts[v as usize]).ty;
    let s = (cx.insts[v as usize]).a;
    let mut mask: i64 = 0;
    let mut k: i64 = 0;
    if !isel_const(cx, (cx.insts[v as usize]).b, &mut mask) || mask <= 0
        || !coverable(cx, s, Shr, v) || (cx.insts[s as usize]).ty != ty
        || !isel_const(cx, (cx.insts[s as usize]).b, &mut k) {
        return false;
    }
    // (mask + 1 wraps for 63 ones, to 1 << 63, whose log2 is 0: refused)
    if (mask & mask.wrapping_add(1)) != 0 {
        return false;
    }
    let n = log2(mask.wrapping_add(1));
    let amount = k & (if int_bits(ty) == 64 { 63 } else { 31 });
    if n < 1 || amount + n > int_bits(ty) {
        return false;
    }
    (cx.insts[v as usize]).op = Ubfx;
    (cx.insts[v as usize]).imm = amount;
    (cx.insts[v as usize]).imm2 = n;
    isel_set_operands(cx, v, (cx.insts[s as usize]).a, 0, 0);
    true
}

// The mask of a test as an immediate, when the target encodes it.
fn test_imm_ok(mask: i64) -> bool {
    if get_x86() { fits_i32(mask) } else { is_logical_imm(mask as u64) }
}

// The branch ending block b on (x & y) == 0 or != 0: a test.
fn isel_branch(cx: &mut FnCtx<Comp>, b: i64) {
    let c = (cx.blocks[b as usize]).cond;
    if (cx.blocks[b as usize]).term != Term::Branch
        || (cx.blocks[b as usize]).s0 == (cx.blocks[b as usize]).s1 || c == 0
        || (cx.insts[c as usize]).op != Cmp || (cx.isel_uses[c as usize]) != 1
        || (cx.insts[c as usize]).block != b || (cx.insts[c as usize]).next != 0
        || is_float((cx.insts[c as usize]).imm2) {
        return;
    }
    let op = (cx.insts[c as usize]).cond;
    let mut zero: i64 = 1;
    if (op != Cond::Eq && op != Cond::Ne)
        || !isel_const(cx, (cx.insts[c as usize]).b, &mut zero)
        || zero != 0 {
        return;
    }
    let and = (cx.insts[c as usize]).a;
    if !coverable(cx, and, And, c) {
        return;
    }
    let mut mask: i64 = 0;
    (cx.insts[c as usize]).op = Test;
    if isel_const(cx, (cx.insts[and as usize]).b, &mut mask) && test_imm_ok(mask) {
        (cx.insts[c as usize]).imm = mask;
        isel_set_operands(cx, c, (cx.insts[and as usize]).a, 0, 0);
    } else {
        isel_set_operands(cx, c, (cx.insts[and as usize]).a,
            (cx.insts[and as usize]).b, 0);
    }
}

// A select on (x & y) == 0 or != 0 tests instead of comparing.
fn isel_select_test(cx: &mut FnCtx<Comp>, v: i64) {
    let lhs = ir_arg(cx, v, 0);
    let op = (cx.insts[v as usize]).cond;
    if (cx.insts[v as usize]).scale != 0 || ir_arg(cx, v, 1) != 0
        || (cx.insts[v as usize]).imm != 0 || (op != Cond::Eq && op != Cond::Ne)
        || !coverable(cx, lhs, And, v) {
        return;
    }
    let mut mask: i64 = 0;
    (cx.insts[v as usize]).scale = 1;
    isel_retain(cx, (cx.insts[lhs as usize]).a);
    ir_set_arg(cx, v, 0, (cx.insts[lhs as usize]).a);
    if isel_const(cx, (cx.insts[lhs as usize]).b, &mut mask) && test_imm_ok(mask) {
        (cx.insts[v as usize]).imm = mask;
    } else {
        isel_retain(cx, (cx.insts[lhs as usize]).b);
        ir_set_arg(cx, v, 1, (cx.insts[lhs as usize]).b);
    }
    isel_release(cx, lhs);
}

// AArch64: a select of an increment adds it itself (csinc): c ? a : b + 1;
// for c ? a + 1 : b, the condition is inverted (integer comparisons and
// tests only: a negated float comparison is not the opposite one).
fn isel_select_increment(cx: &mut FnCtx<Comp>, v: i64) {
    // 64-bit integers only: csinc adds without wrapping at a narrower width.
    if get_x86() || !is_wide_int((cx.insts[v as usize]).ty)
        || ((cx.insts[v as usize]).scale & 2) != 0 {
        return;
    }
    let mut one: i64 = 0;
    let other = (cx.insts[v as usize]).b;
    if coverable(cx, other, Add, v)
        && (cx.insts[other as usize]).ty == (cx.insts[v as usize]).ty
        && isel_const(cx, (cx.insts[other as usize]).b, &mut one)
        && one == 1 {
        (cx.insts[v as usize]).scale = (cx.insts[v as usize]).scale | 2;
        isel_set_operands(cx, v, (cx.insts[v as usize]).a,
            (cx.insts[other as usize]).a, 0);
        return;
    }
    let then = (cx.insts[v as usize]).a;
    let invertible = ((cx.insts[v as usize]).scale & 1) == 1
        || !is_float((cx.insts[v as usize]).imm2);
    if invertible && coverable(cx, then, Add, v)
        && (cx.insts[then as usize]).ty == (cx.insts[v as usize]).ty
        && isel_const(cx, (cx.insts[then as usize]).b, &mut one) && one == 1 {
        (cx.insts[v as usize]).scale = (cx.insts[v as usize]).scale | 2;
        (cx.insts[v as usize]).cond = (cx.insts[v as usize]).cond.negate();
        isel_set_operands(cx, v, (cx.insts[v as usize]).b,
            (cx.insts[then as usize]).a, 0);
    }
}

// A call of one of the C library's math functions that is one instruction
// (of a function declared with its C signature, under its own name).
fn isel_libcall(cx: &mut FnCtx<Comp>, v: i64, pcx: &Ctx<Comp>) {
    let f = (cx.insts[v as usize]).imm;
    if !pcx.fns[f as usize].is_extern || pcx.fns[f as usize].variadic
        || pcx.fns[f as usize].param_count != 1 || (cx.insts[v as usize]).nargs != 1
        || (cx.insts[v as usize]).c != 0 {
        return;
    }
    let ty = pcx.fns[f as usize].ret;
    if (ty != TY_F64 && ty != TY_F32) || fn_param(f, 0, pcx) != ty
        || pcx.link_names.get(pcx.fns[f as usize].name + 1) > 0 {
        return;
    }
    let single = ty == TY_F32;
    let name = sym_name(pcx.fns[f as usize].name, pcx);
    let mut kind: i64 = -1;
    if streq(name, if single { c"sqrtf" } else { c"sqrt" }) {
        kind = 0;
    } else if streq(name, if single { c"fabsf" } else { c"fabs" }) {
        kind = 1;
    } else if streq(name, if single { c"floorf" } else { c"floor" }) {
        kind = 2;
    } else if streq(name, if single { c"ceilf" } else { c"ceil" }) {
        kind = 3;
    } else if streq(name, if single { c"truncf" } else { c"trunc" }) {
        kind = 4;
    } else if streq(name, if single { c"roundf" } else { c"round" }) {
        kind = 5;
    }
    // glibc's sqrt sets errno for negative arguments; x86-64 has the others
    // only from SSE4.1 on.
    if kind < 0 || (kind == 0 && get_elf()) || (kind > 0 && get_x86()) {
        return;
    }
    let arg = ir_arg(cx, v, 0);
    (cx.insts[v as usize]).op = FMath;
    (cx.insts[v as usize]).a = arg;
    (cx.insts[v as usize]).b = 0;
    (cx.insts[v as usize]).c = 0;
    (cx.insts[v as usize]).imm = kind;
    (cx.insts[v as usize]).args = 0;
    (cx.insts[v as usize]).nargs = 0;
}
