// The run-time feature word of std::arch::detect (0.19, docs/design/arch.md
// §2.5): who fills it, and the late expansion of CPUFEAT.
//
// - A program with `main`: right after lowering (arch_after_lowering), main
//   starts with a call of std's arch_init_macos / arch_init_linux
//   (compiler/std/arch.vl), which fills the word before anything else
//   runs; gen0 does the same at -O0 (gen0/gen/arch.vl). Each CPUFEAT the
//   optimizer kept of a detect (pure: numbered by GVN, hoisted by LICM,
//   unswitched) becomes, just before instruction selection
//   (expand_cpu_features), a load of the word and a bit test: no call and
//   no branch, nothing clobbered.
// - Code with no `main` (a library entered from C): nothing runs before
//   it, so each CPUFEAT becomes, right after lowering, a call of std's
//   arch_word_macos / arch_word_linux (the word, filled at the first call)
//   and the bit test. Not hoisted (a call), but taken only by libraries.
// The word's soundness without atomics: compiler/std/arch.vl.

use crate::arch::features::build_features;
use crate::base::{buf_fmt, buf_str, cstr, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::target::{get_elf, get_x86};
use crate::front::types::{TY_BOOL, TY_U64};
use crate::gen0::target::global_prefix;
use crate::middle::ctx::FnCtx;
use crate::middle::ir::{
    Cond, Op, get_irfuncs, ir_append, ir_enter, ir_insert_before, ir_make, ir_unlink,
};

// std's function of this target's system: arch_init_* or arch_word_*
// (-1 when std's detection section is not loaded).
pub fn arch_std_fn(init: bool, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let name = if init {
            if get_x86() { c"std::arch_init_x86" } else if get_elf() { c"std::arch_init_linux" }
            else { c"std::arch_init_macos" }
        } else {
            if get_x86() { c"std::arch_word_x86" } else if get_elf() { c"std::arch_word_linux" }
            else { c"std::arch_word_macos" }
        };
        (*pcx.sym_fn.add(intern_c(name, pcx) as usize)) - 1
    }
}

// After lowering (-O1, -O2): main fills the word first, or, with no main,
// every CPUFEAT calls std for it.
pub fn arch_after_lowering(cx: &mut FnCtx, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.arch_word_sym = 0;
        if !pcx.arch_used {
            return;
        }
        let init = arch_std_fn(true, pcx);
        let word = arch_std_fn(false, pcx);
        let s = (*pcx.sym_static.add(intern_c(c"std::ARCH_FEATURES", pcx) as usize));
        if init < 0 || word < 0 || s == 0 {
            return;
        }
        let mut main: i64 = -1;
        let mut any = false;
        for fi in 0..pcx.irfunc_count {
            if pcx.fns[(*get_irfuncs().add(fi as usize)).f as usize].name == pcx.main_sym {
                main = fi;
            }
            if !any && has_cpu_feature(cx, fi, pcx) {
                any = true;
            }
        }
        if !any {
            return;
        }
        if main >= 0 {
            pcx.arch_word_sym = pcx.nodes[pcx.statics[(s - 1) as usize].node as usize].a;
            ir_enter(cx, main, pcx);
            let entry = (*get_irfuncs().add(main as usize)).entry;
            // (its argument: the build's features, which it need not ask for)
            let known = ir_make(cx, Op::Const, TY_U64, 0, 0, build_features(pcx), pcx);
            let call = call_of(cx, init, known, pcx);
            let at = body_start(cx, entry);
            if at == 0 {
                ir_append(cx, entry, known);
                ir_append(cx, entry, call);
            } else {
                ir_insert_before(cx, at, known);
                ir_insert_before(cx, at, call);
            }
            return;
        }
        for fi in 0..pcx.irfunc_count {
            if !has_cpu_feature(cx, fi, pcx) {
                continue;
            }
            for b in (*get_irfuncs().add(fi as usize)).blocks.items() {
                if (*cx.blocks.add(b as usize)).removed != 0 {
                    continue;
                }
                let mut v = (*cx.blocks.add(b as usize)).first;
                while v != 0 {
                    let next = (*cx.insts.add(v as usize)).next;
                    if (*cx.insts.add(v as usize)).op == Op::CpuFeat {
                        // (not before a parameter: the call would clobber
                        // its register before it is taken)
                        if b == (*get_irfuncs().add(fi as usize)).entry && param_after(cx, v) {
                            let at = body_start(cx, b);
                            ir_unlink(cx, v);
                            if at == 0 {
                                ir_append(cx, b, v);
                            } else {
                                ir_insert_before(cx, at, v);
                            }
                        }
                        let w = call_of(cx, word, 0, pcx);
                        ir_insert_before(cx, v, w);
                        bit_test(cx, v, w, pcx);
                    }
                    v = next;
                }
            }
        }
    }
}

// Whether function fi has a CPUFEAT (and is entered).
fn has_cpu_feature(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        ir_enter(cx, fi, pcx);
        for b in (*get_irfuncs().add(fi as usize)).blocks.items() {
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                if (*cx.insts.add(v as usize)).op == Op::CpuFeat {
                    return true;
                }
                v = (*cx.insts.add(v as usize)).next;
            }
        }
        false
    }
}

// A call of std's function f (a u64; its argument `arg`, a u64, or none
// when 0), not yet in a block.
fn call_of(cx: &mut FnCtx, f: i64, arg: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        let call = ir_make(cx, Op::Call, TY_U64, 0, 0, f, pcx);
        (*cx.insts.add(call as usize)).args = cx.args.count;
        (*cx.insts.add(call as usize)).nargs = 0;
        if arg != 0 {
            cx.args.push(arg);
            cx.argty.push(TY_U64);
            (*cx.insts.add(call as usize)).nargs = 1;
        }
        call
    }
}

// The instruction after block b's last phi or parameter (0: none). Not the
// first other one: lowering may put an instruction before the parameters
// (main's Gpa), and a call there would clobber their registers before
// they are taken.
fn body_start(cx: &mut FnCtx, b: i64) -> i64 {
    unsafe {
        let mut after = (*cx.blocks.add(b as usize)).first;
        let mut v = (*cx.blocks.add(b as usize)).first;
        while v != 0 {
            if (*cx.insts.add(v as usize)).op == Op::Phi
                || (*cx.insts.add(v as usize)).op == Op::Param {
                after = (*cx.insts.add(v as usize)).next;
            }
            v = (*cx.insts.add(v as usize)).next;
        }
        after
    }
}

// Whether a parameter comes after instruction v in its block.
fn param_after(cx: &mut FnCtx, v: i64) -> bool {
    unsafe {
        let mut u = (*cx.insts.add(v as usize)).next;
        while u != 0 {
            if (*cx.insts.add(u as usize)).op == Op::Param {
                return true;
            }
            u = (*cx.insts.add(u as usize)).next;
        }
        false
    }
}

// CPUFEAT v becomes `(w & 1 << bit) != 0` (instructions before it).
fn bit_test(cx: &mut FnCtx, v: i64, w: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let mask = ir_make(cx, Op::Const, TY_U64, 0, 0, 1 << (*cx.insts.add(v as usize)).imm, pcx);
        ir_insert_before(cx, v, mask);
        let and = ir_make(cx, Op::And, TY_U64, w, mask, 0, pcx);
        ir_insert_before(cx, v, and);
        let zero = ir_make(cx, Op::Const, TY_U64, 0, 0, 0, pcx);
        ir_insert_before(cx, v, zero);
        (*cx.insts.add(v as usize)).op = Op::Cmp;
        (*cx.insts.add(v as usize)).ty = TY_BOOL;
        (*cx.insts.add(v as usize)).a = and;
        (*cx.insts.add(v as usize)).b = zero;
        (*cx.insts.add(v as usize)).imm = 0;
        (*cx.insts.add(v as usize)).cond = Cond::Ne;
        (*cx.insts.add(v as usize)).imm2 = TY_U64;
    }
}

// The CPUFEATs of function fi (the current one): a load of the word and a
// bit test each (false when no main fills the word: none is left then).
pub fn expand_cpu_features(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    unsafe {
        for b in (*get_irfuncs().add(fi as usize)).blocks.items() {
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let next = (*cx.insts.add(v as usize)).next;
                if (*cx.insts.add(v as usize)).op == Op::CpuFeat {
                    if pcx.arch_word_sym == 0 {
                        (*cx.insts.add(v as usize)).op = Op::Const;
                        (*cx.insts.add(v as usize)).imm = 0;
                    } else {
                        let g = ir_make(cx, Op::GAddr, TY_U64, 0, 0, pcx.arch_word_sym, pcx);
                        ir_insert_before(cx, v, g);
                        let w = ir_make(cx, Op::Load, TY_U64, g, 0, 0, pcx);
                        ir_insert_before(cx, v, w);
                        bit_test(cx, v, w, pcx);
                    }
                }
                v = next;
            }
        }
    }
}

// x86-64's run-time helpers of std's detection (compiler/std/arch.vl,
// its x86-64 section), when it is loaded: vole_arch_cpuid(leaf, sub,
// out: *u32) writes eax, ebx, ecx, edx; vole_arch_xgetbv(index) returns
// edx:eax. (cpuid and xgetbv as bytes: no other code uses them.)
pub fn emit_arch_runtime(cx: &mut FnCtx, pcx: &mut Ctx<Comp>) {
    if !get_x86() || !pcx.arch_used || arch_std_fn(true, pcx) < 0 {
        return;
    }
    let gp = cstr(global_prefix());
    buf_fmt(cx.asm,
        { let gp = str::from_utf8(gp).unwrap();
            format_args("\n.p2align 4\n.globl {gp}vole_arch_cpuid\n{gp}vole_arch_cpuid:\n") });
    buf_str(cx.asm, c"    pushq %rbx\n    movq %rdx, %r8\n    movl %edi, %eax\n    movl %esi, %ecx\n    .byte 15, 162\n    movl %eax, (%r8)\n    movl %ebx, 4(%r8)\n    movl %ecx, 8(%r8)\n    movl %edx, 12(%r8)\n    popq %rbx\n    ret\n");
    buf_fmt(cx.asm,
        { let gp = str::from_utf8(gp).unwrap();
            format_args("\n.p2align 4\n.globl {gp}vole_arch_xgetbv\n{gp}vole_arch_xgetbv:\n") });
    buf_str(cx.asm, c"    movl %edi, %ecx\n    .byte 15, 1, 208\n    shlq $32, %rdx\n    movl %eax, %eax\n    orq %rdx, %rax\n    ret\n");
}
