// Divisions by constants (isel/mod.vl, step 1b): x / d and x % d as a
// multiplication by a magic number.

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::types::{TY_I64, TY_U64, int_bits, is_integer, is_signed};
use crate::middle::ctx::FnCtx;
use crate::middle::fold::{const_before, op_before};
use crate::middle::ir::{get_irfuncs, ir_replace};
use crate::middle::ir::Op::{Add, Const, Div, Mul, MulH, Neg, Rem, Shr, Sub};
use crate::middle::opt::resolve_all;

// ---- Divisions by constants (0.11) ----
//
// x / d for a constant d is a multiplication by a magic number (T.
// Granlund and P. Montgomery, "Division by Invariant Integers using
// Multiplication", PLDI 1994; H. S. Warren, "Hacker's Delight", chapter
// 10), on the canonical 64-bit x:
//
//   unsigned, up to 32 bits   mulh(x, m), m = 2^64 / d rounded up
//   u64                       mulh(x, m) >> s; or, when the magic number
//                             has 65 bits, t = mulh(x, m) and
//                             (((x - t) >> 1) + t) >> (s - 1)
//   signed, up to 32 bits     t = (x * m) >> (bits + s), a 64-bit product
//                             (the magic number's corrections folded into
//                             m), then t - (t >> 63): one more when negative
//   i64                       t = smulh(x, m), + x or - x when m's sign is
//                             not d's, >> s, then t - (t >> 63)
//   unsigned 2^k              x >> k (instcombine leaves 2^63 for u64)
//   1, -1                     x, -x (wrapping: MIN / -1 is MIN)
//
// x % d is x - q * d (msub on AArch64), and shares q with an x / d of the
// block. Division by 0 stays as it is (x / 0 is 0, x % 0 is x, as the
// division instructions give them), and so do signed divisions by the
// negative powers of two and MIN, which instcombine does not take.

pub fn lower_divisions(cx: &mut FnCtx, fi: i64, pcx: &Ctx<Comp>) {
    resolve_all(cx, fi);
    unsafe {
        for b in (*get_irfuncs().add(fi as usize)).blocks.items() {
            if (*cx.blocks.add(b as usize)).removed != 0 {
                continue;
            }
            cx.div_seen.count = 0;
            let mut v = (*cx.blocks.add(b as usize)).first;
            while v != 0 {
                let next = (*cx.insts.add(v as usize)).next;
                let op = (*cx.insts.add(v as usize)).op;
                if (op == Div || op == Rem) && is_integer((*cx.insts.add(v as usize)).ty)
                    && (*cx.insts.add((*cx.insts.add(v as usize)).b as usize)).op == Const {
                    lower_division(cx, v, pcx);
                }
                v = next;
            }
        }
    }
}

// Division or remainder v by a constant: the quotient by multiplication
// (shared by a quotient and a remainder of the same operands in a block),
// the remainder x - q * d.
fn lower_division(cx: &mut FnCtx, v: i64, pcx: &Ctx<Comp>) {
    unsafe {
        let ty = (*cx.insts.add(v as usize)).ty;
        let x = (*cx.insts.add(v as usize)).a;
        let d = (*cx.insts.add((*cx.insts.add(v as usize)).b as usize)).imm;
        let mut q: i64 = 0;
        let mut k: i64 = 0;
        while k < cx.div_seen.count {
            if (*cx.div_seen.data.add(k as usize)) == x && (*cx.div_seen.data.add((k + 1) as usize)) == d
                && (*cx.div_seen.data.add((k + 2) as usize)) == ty {
                q = (*cx.div_seen.data.add((k + 3) as usize));
                break;
            }
            k += 4;
        }
        if q == 0 {
            q = make_quotient(cx, v, x, d, ty, pcx);
            if q == 0 {
                return;
            }
            cx.div_seen.push(x);
            cx.div_seen.push(d);
            cx.div_seen.push(ty);
            cx.div_seen.push(q);
        }
        if (*cx.insts.add(v as usize)).op == Div {
            ir_replace(cx, v, q);
            return;
        }
        if is_signed(ty) && d == -1 {
            let const_before_v = const_before(cx, v, 0, ty, pcx);
            ir_replace(cx, v, const_before_v);
            return;
        }
        let const_before_v1 = const_before(cx, v, d, ty, pcx);
        let product = op_before(cx, v, Mul, ty, q, const_before_v1, pcx);
        let op_before_v = op_before(cx, v, Sub, ty, x, product, pcx);
        ir_replace(cx, v, op_before_v);
    }
}

// The high half of x * m (inserted before v).
fn mulh_before(cx: &mut FnCtx, v: i64, ty: i64, x: i64, m: i64, signed: bool, pcx: &Ctx<Comp>) -> i64 {
    let const_before_v = const_before(cx, v, m, if signed { TY_I64 } else { TY_U64 }, pcx);
    let h = op_before(cx, v, MulH, ty, x,
        const_before_v, pcx);
    unsafe { (*cx.insts.add(h as usize)).imm = if signed { 1 } else { 0 }; }
    h
}

// k for d = 2^k (d as unsigned), or -1.
fn exact_log2(d: u64) -> i64 {
    if d == 0 || (d & (d - 1)) != 0 {
        return -1;
    }
    let mut k: i64 = 0;
    while (d >> k as u64) != 1 {
        k += 1;
    }
    k
}

// x / d for the constant d (canonical for ty), computed before v from the
// canonical 64-bit x; 0 when the division stays (by 0, which has its
// defined result, and by negative powers of two).
fn make_quotient(cx: &mut FnCtx, v: i64, x: i64, d: i64, ty: i64, pcx: &Ctx<Comp>) -> i64 {
    let bits = int_bits(ty);
    if d == 0 {
        return 0;
    }
    if !is_signed(ty) {
        let ud = d as u64;
        let k = exact_log2(ud);
        if k == 0 {
            return x;
        }
        if k > 0 {
            let const_before_v = const_before(cx, v, k, ty, pcx);
            return op_before(cx, v, Shr, ty, x, const_before_v, pcx);
        }
        if bits <= 32 {
            // m = 2^64 / d rounded up: for x < 2^bits, x * m / 2^64 differs
            // from x / d by less than x / 2^64 <= 1 / d, too little to
            // reach the next integer.
            let m = 0xffffffffffffffffu64 as u64 / ud + 1;
            return mulh_before(cx, v, ty, x, m as i64, signed: false, pcx: pcx);
        }
        let mut m: u64 = 0;
        let mut add = false;
        let mut s: i64 = 0;
        magic_unsigned(ud, &mut m, &mut add, &mut s);
        let t = mulh_before(cx, v, TY_U64, x, m as i64, signed: false, pcx: pcx);
        if !add {
            let const_before_v1 = const_before(cx, v, s, TY_U64, pcx);
            return op_before(cx, v, Shr, TY_U64, t, const_before_v1, pcx);
        }
        let op_before_v = op_before(cx, v, Sub, TY_U64, x, t, pcx);
        let const_before_v2 = const_before(cx, v, 1, TY_U64, pcx);
        // m is 2^64 + the constant: q = (((x - t) >> 1) + t) >> (s - 1).
        let half = op_before(cx, v, Shr, TY_U64, op_before_v,
            const_before_v2, pcx);
        let sum = op_before(cx, v, Add, TY_U64, half, t, pcx);
        let const_before_v3 = const_before(cx, v, s - 1, TY_U64, pcx);
        return op_before(cx, v, Shr, TY_U64, sum, const_before_v3, pcx);
    }
    if d == 1 {
        return x;
    }
    if d == -1 {
        // Wrapping: MIN / -1 is MIN.
        return op_before(cx, v, Neg, ty, x, 0, pcx);
    }
    let ad = if d < 0 { d.wrapping_neg() as u64 } else { d as u64 };
    if exact_log2(ad) >= 0 {
        return 0;
    }
    let mut m: i64 = 0;
    let mut s: i64 = 0;
    magic_signed(d, bits, &mut m, &mut s);
    let mut t: i64 = 0;
    if bits <= 32 {
        // The bits-wide magic with its correction folded in, and a 64-bit
        // product (|x * m| < 2^63).
        let wide = 1 << bits as u64;
        if d > 0 && m < 0 {
            m += wide;
        } else if d < 0 && m > 0 {
            m -= wide;
        }
        let const_before_v4 = const_before(cx, v, m, TY_I64, pcx);
        let product = op_before(cx, v, Mul, TY_I64, x, const_before_v4, pcx);
        let const_before_v5 = const_before(cx, v, bits + s, TY_I64, pcx);
        t = op_before(cx, v, Shr, TY_I64, product, const_before_v5,
            pcx);
    } else {
        t = mulh_before(cx, v, TY_I64, x, m, signed: true, pcx: pcx);
        if d > 0 && m < 0 {
            t = op_before(cx, v, Add, TY_I64, t, x, pcx);
        } else if d < 0 && m > 0 {
            t = op_before(cx, v, Sub, TY_I64, t, x, pcx);
        }
        if s > 0 {
            let const_before_v6 = const_before(cx, v, s, TY_I64, pcx);
            t = op_before(cx, v, Shr, TY_I64, t, const_before_v6, pcx);
        }
    }
    let const_before_v7 = const_before(cx, v, 63, TY_I64, pcx);
    let op_before_v1 = op_before(cx, v, Shr, TY_I64, t, const_before_v7,
        pcx);
    // Rounded toward zero: one more when negative.
    op_before(cx, v, Sub, TY_I64, t,
        op_before_v1, pcx)
}

// The magic number of signed division by d (2 <= |d| < 2^(w-1), w bits;
// Hacker's Delight, figure 10-1): *m (a signed w-bit value) and *s, with
// x / d = hi(m * x) (+ x when d > 0 and m < 0, - x when d < 0 and m > 0)
// >> s, plus 1 when that is negative. The q and r words are modulo 2^64,
// as in the book: wrapping_*.
fn magic_signed(d: i64, w: i64, m: &mut i64, s: &mut i64) {
    let two: u64 = (1 as u64) << (w - 1) as u64;
    let ad: u64 = if d < 0 { (0 - d) as u64 } else { d as u64 };
    let t: u64 = two + (if d < 0 { 1 as u64 } else { 0 as u64 });
    let anc: u64 = t - 1 - t % ad;
    let mut p = w - 1;
    let mut q1: u64 = two / anc;
    let mut r1: u64 = two - q1 * anc;
    let mut q2: u64 = two / ad;
    let mut r2: u64 = two - q2 * ad;
    loop {
        p += 1;
        q1 = q1.wrapping_mul(2u64);
        r1 = 2 * r1;
        if r1 >= anc {
            q1 += 1;
            r1 -= anc;
        }
        q2 = q2.wrapping_mul(2u64);
        r2 = 2 * r2;
        if r2 >= ad {
            q2 += 1;
            r2 -= ad;
        }
        let delta = ad - r2;
        if !(q1 < delta || (q1 == delta && r1 == 0)) {
            break;
        }
    }
    let mut magic = q2.wrapping_add(1u64);
    if d < 0 {
        magic = magic.wrapping_neg();
    }
    // As a signed w-bit value.
    let shift = (64 - w) as u64;
    *m = ((magic << shift) as i64) >> shift;
    *s = p - w;
}

// The magic number of unsigned 64-bit division by d (2 <= d, not a power
// of two; Hacker's Delight, figure 10-2): *m and *s with x / d =
// hi(m * x) >> s, or, when *add (the magic is 2^64 + m), with t = hi(m * x),
// (((x - t) >> 1) + t) >> (s - 1). The q and r words are modulo 2^64, as
// in the book: wrapping_*.
fn magic_unsigned(d: u64, m: &mut u64, add: &mut bool, s: &mut i64) {
    let min: u64 = (1 as u64) << 63;
    let max: u64 = min - 1;
    let nc: u64 = 0xffffffffffffffffu64 as u64 - d.wrapping_neg() % d;
    let mut p: i64 = 63;
    let mut q1: u64 = min / nc;
    let mut r1: u64 = min - q1 * nc;
    let mut q2: u64 = max / d;
    let mut r2: u64 = max - q2 * d;
    let mut a = false;
    loop {
        p += 1;
        if r1 >= nc - r1 {
            q1 = q1.wrapping_mul(2u64) + 1;
            r1 = r1.wrapping_mul(2u64).wrapping_sub(nc);
        } else {
            q1 = q1.wrapping_mul(2u64);
            r1 = 2 * r1;
        }
        if r2 + 1 >= d - r2 {
            if q2 >= max {
                a = true;
            }
            q2 = q2.wrapping_mul(2u64) + 1;
            r2 = (r2.wrapping_mul(2u64) + 1).wrapping_sub(d);
        } else {
            if q2 >= min {
                a = true;
            }
            q2 = q2.wrapping_mul(2u64);
            r2 = 2 * r2 + 1;
        }
        let delta = d - 1 - r2;
        if !(p < 128 && (q1 < delta || (q1 == delta && r1 == 0))) {
            break;
        }
    }
    *m = q2.wrapping_add(1u64);
    *add = a;
    *s = p - 64;
}
