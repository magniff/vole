// EDITION: rust
// Calling a variadic C function: each argument is passed as C's default
// promotions expect it (an i32 for %d, an f64 for %f).
// UNSAFE: a C function, declared by hand.
// SAFETY: the signature is stdio.h's: int printf(const char *, ...).
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

fn main() -> i32 {
    let integer: i32 = 1;
    let float = 2.0;
    // UNSAFE: printf is C's.
    // SAFETY: each format is a NUL-terminated literal, and the arguments
    // are the types its conversions name (%d an i32, %f an f64).
    unsafe {
        printf(c"Just a humble int %d\n", integer);
        printf(c"A fancy float %f\n", float);
        printf(c"These two together, friendship, hey! %d and %f\n", integer, float);
    }
    0
}
