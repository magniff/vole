// pad.vl: one standard controller — the eight buttons, the strobe and
// the 8-bit shift register the $4016 read walks through. Two of them,
// because $4016 and $4017 are separate ports; the window maps the
// keyboard onto both.

pub const BTN_A: u8 = 0x01;
pub const BTN_B: u8 = 0x02;
pub const BTN_SELECT: u8 = 0x04;
pub const BTN_START: u8 = 0x08;
pub const BTN_UP: u8 = 0x10;
pub const BTN_DOWN: u8 = 0x20;
pub const BTN_LEFT: u8 = 0x40;
pub const BTN_RIGHT: u8 = 0x80;

pub struct Pad {
    buttons: u8,
    shift: u8,
    strobe: bool,
}

pub fn pad_new() -> Pad {
    Pad { buttons: 0, shift: 0, strobe: false }
}

impl Pad {
    // The set of buttons held, as BTN_* bits.
    pub fn set_buttons(inout self, mask: u8) {
        self.buttons = mask;
    }

    pub fn buttons(self) -> u8 {
        self.buttons
    }

    // A write to $4016: a 1 starts a fresh serial read, a 0 latches.
    pub fn write_strobe(inout self, v: u8) {
        self.strobe = (v & 1) != 0;
        if self.strobe {
            self.shift = self.buttons;
        }
    }

    // One read: A, B, Select, Start, Up, Down, Left, Right, then 1s.
    pub fn read(inout self) -> u8 {
        if self.strobe {
            return self.buttons & 1;
        }
        let bit = self.shift & 1;
        self.shift = (self.shift >> 1) | 0x80;
        bit
    }
}
