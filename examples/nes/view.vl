// view.vl: the window's picture — the 256×240 frame buffer uploaded as
// a storage buffer, and a fullscreen shader that samples it with
// nearest-neighbour lookups at an integer scale, centred, with black
// bars where the window is not a multiple of the console's picture.
// Integer scaling keeps every NES pixel the same size; the surface is
// Bgra8Unorm (what Metal offers) and the shader returns RGBA.
//
// There is no texture and no sampler: a fragment's uv picks a word of
// the storage buffer, as in the other GPU examples.

use std::gpu;
use std::gpu::{
    BindGroup, Buffer, BufferUsage, Color, Format, PassDesc, RenderPipeline, TextureView,
};

pub const FB_W: i64 = 256;
pub const FB_H: i64 = 240;
pub const FB_PX: i64 = FB_W * FB_H;

pub static CLEAR: Color = Color::rgba(0.0, 0.0, 0.0, 1.0);

pub embed wgsl SCREEN {
    struct V {
        @builtin(position) pos: vec4<f32>,
        @location(0) uv: vec2<f32>,
    }
    struct U {
        w: f32, h: f32, scale: f32, pad: f32,
    }
    @group(0) @binding(0) var<uniform> u: U;
    @group(0) @binding(1) var<storage, read> fb: array<u32>;
    @vertex fn vs(@builtin(vertex_index) vid: u32) -> V {
        var p = vec2<f32>(-1.0, -1.0);
        if (vid == 1u) { p = vec2<f32>(3.0, -1.0); }
        if (vid == 2u) { p = vec2<f32>(-1.0, 3.0); }
        var o: V;
        o.pos = vec4<f32>(p, 0.0, 1.0);
        o.uv = vec2<f32>(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);
        return o;
    }
    @fragment fn fs(i: V) -> @location(0) vec4<f32> {
        let px = i.uv.x * u.w;
        let py = i.uv.y * u.h;
        let dw = 256.0 * u.scale;
        let dh = 240.0 * u.scale;
        let ox = (u.w - dw) * 0.5;
        let oy = (u.h - dh) * 0.5;
        if (px < ox || py < oy || px >= ox + dw || py >= oy + dh) {
            return vec4<f32>(0.0, 0.0, 0.0, 1.0);
        }
        let sx = u32(clamp(floor((px - ox) / u.scale), 0.0, 255.0));
        let sy = u32(clamp(floor((py - oy) / u.scale), 0.0, 239.0));
        let c = fb[sy * 256u + sx];
        let r = f32(c & 255u) / 255.0;
        let g = f32((c >> 8u) & 255u) / 255.0;
        let b = f32((c >> 16u) & 255u) / 255.0;
        return vec4<f32>(r, g, b, 1.0);
    }
}

pub struct Viewer {
    pub pipe: RenderPipeline,
    pub ubuf: Buffer,
    pub buf: Buffer,
    pub group: BindGroup,
}

pub fn viewer_new(dev: gpu::Device) -> Result<Viewer, gpu::Error> {
    let shader = dev.shader_wgsl(SCREEN.src)?;
    let pipe = dev.render_pipeline(gpu::RenderDesc::new(shader, SCREEN.vs, SCREEN.fs,
        Format::Bgra8Unorm))?;
    let ubuf = dev.buffer(dev.align_uniform(16),
        BufferUsage::UNIFORM | BufferUsage::COPY_DST);
    let buf = dev.buffer(FB_PX * 4,
        BufferUsage::STORAGE | BufferUsage::COPY_DST);
    let layout = pipe.bind_layout(0);
    let group = dev.bind_group(layout, [gpu::bind(0, ubuf), gpu::bind(1, buf)][..]);
    Ok(Viewer { pipe: pipe, ubuf: ubuf, buf: buf, group: group })
}

// The largest whole-pixel scale that fits, and never less than one (a
// window smaller than the picture then shows its top-left part).
pub fn fit_scale(w: i64, h: i64) -> i64 {
    let sx = w / FB_W;
    let sy = h / FB_H;
    let s = if sx < sy { sx } else { sy };
    if s < 1 { 1 } else { s }
}

impl Viewer {
    pub fn draw(self, dev: gpu::Device, queue: inout gpu::Queue,
        target: TextureView, px: [u32], w: i64, h: i64, scale: i64) {
        queue.write_buffer(self.buf, 0, gpu::bytes_of_u32(px));
        let u: [f32; 4] = [w as f32, h as f32, scale as f32, 0.0];
        queue.write_buffer(self.ubuf, 0, gpu::bytes_of_f32(u[..]));
        let pipe = self.pipe;
        let group = self.group;
        var enc = dev.encoder();
        enc.render_pass(PassDesc::color(target, clear: CLEAR), |pass| {
            pass.set_pipeline(pipe);
            pass.set_bind_group(0, group);
            pass.draw(0..3, 0..1);
        });
        queue.submit(enc.finish());
    }
}
