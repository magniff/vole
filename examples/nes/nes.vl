// nes.vl: the machine — CPU, bus, PPU and APU wired together. One call
// runs one frame: the PPU's own dot clock decides when the frame ends
// (the pre-render line completing), and the CPU steps in between. Every
// bus access advances the PPU its three dots as it happens, so a $2002
// read lands within a cycle of where it does on the console; the cycles
// an instruction spends without touching the bus are caught up at its
// end. That keeps a game's vblank handler, its sprite-0 poll and a
// mapper's scanline IRQ in the same order the console gives them.

use std::alloc::Allocator;

use bus::{
    Bus, bus_begin_frame, bus_frame_done, bus_new, bus_take_accesses, bus_take_stall, bus_tick_ppu,
};
use cart::Cart;
use cpu::{Cpu, cpu_new, cpu_reset, step};
use ppu::ppu_reset;
use rom::Rom;

pub struct Nes<A: Allocator> {
    pub cpu: Cpu,
    pub bus: Bus<A>,
    pub frames: i64,
    pub cycles: i64,
}

pub fn nes_new(rom: Rom<Gpa>, gpa: Gpa) -> Nes<Gpa> {
    let mut bus = bus_new(Cart::new(rom, gpa), gpa);
    let mut cpu = cpu_new();
    cpu_reset(&mut cpu, &mut bus);
    Nes { cpu: cpu, bus: bus, frames: 0, cycles: 0 }
}

// Reset, as the console's button does: the CPU restarts through its
// vector, the PPU returns to the pre-render line; RAM keeps its bytes.
pub fn nes_reset(nes: &mut Nes<Gpa>) {
    cpu_reset(&mut nes.cpu, &mut nes.bus);
    ppu_reset(&mut nes.bus.ppu);
    nes.bus.apu.reset();
    nes.frames = 0;
}

// Runs until the PPU finishes a frame; returns the CPU cycles spent.
// A jammed CPU (an undocumented JAM opcode) ends the frame early — the
// caller sees `cpu.jammed` and stops with a message instead of hanging.
pub fn run_frame(nes: &mut Nes<Gpa>) -> i64 {
    bus_begin_frame(&mut nes.bus);
    let mut cycles: i64 = 0;
    let mut guard: i64 = 0;
    while !bus_frame_done(&nes.bus) && !nes.cpu.jammed {
        let c = step(&mut nes.cpu, &mut nes.bus);
        let stall = bus_take_stall(&mut nes.bus);
        let accessed = bus_take_accesses(&mut nes.bus);
        let total = c + stall;
        nes.bus.apu.tick(total);
        // The accesses already advanced the PPU; only the cycles spent
        // inside the instruction without one are left.
        let mut extra = total - accessed;
        if extra < 0 {
            extra = 0;
        }
        if extra > 0 {
            bus_tick_ppu(&mut nes.bus, extra * 3);
        }
        cycles += total;
        guard += 1;
        if guard > 400000 {
            break;
        }
    }
    nes.frames += 1;
    nes.cycles += cycles;
    cycles
}
