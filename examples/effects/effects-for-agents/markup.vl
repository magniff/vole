// EDITION: rust
// A small subset of Markdown to HTML: `# ` headings (with an id made from
// their text), paragraphs separated by blank lines, `*emphasis*` and
// `code` inside them, and a table of contents first. Everything it makes
// for a document lives until the document is printed.
use std::alloc::Allocator;

pub struct Heading<'a, A: Allocator> { pub title: &'a str, pub id: String<A> }

// The document's lines (views of src) in a new Vec.
fn lines<'a>(src: &'a str, gpa: Gpa) -> Vec<&'a str, Gpa> {
    src.split('\n').collect_in(gpa)
}

// The id of a heading: its letters and digits in lowercase, words joined
// by '-' ("Why arenas?" is "why-arenas").
fn slug(title: &str, gpa: Gpa) -> String<Gpa> {
    let mut id = String::<Gpa>::new_in(gpa);
    let mut dash = false;
    for ch in title.chars() {
        let c = ch.to_ascii_lowercase();
        if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') {
            if dash && id.len() > 0 {
                id.push('-');
            }
            id.push(c);
            dash = false;
        } else {
            dash = true;
        }
    }
    id
}

// `*x*` as <em>x</em> and `x` (backquotes) as <code>x</code>, the rest as
// it is, appended to out.
fn inline(text: &str, out: &mut String<Gpa>) {
    let mut em = false;
    let mut code = false;
    for c in text.chars() {
        if c == '`' {
            out.push_str(if code { "</code>" } else { "<code>" });
            code = !code;
        } else if c == '*' && !code {
            out.push_str(if em { "</em>" } else { "<em>" });
            em = !em;
        } else if c == '<' {
            out.push_str("&lt;");
        } else {
            out.push(c);
        }
    }
}

// The headings of the document, with their ids.
fn headings<'a>(ls: &[&'a str], gpa: Gpa) -> Vec<Heading<'a, Gpa>, Gpa> {
    let mut hs: Vec<Heading<'a, Gpa>, Gpa> = Vec::new_in(gpa);
    for &l in ls {
        if l.len() > 2 && l.starts_with("# ") {
            hs.push(Heading { title: &l[2..], id: slug(&l[2..], gpa) });
        }
    }
    hs
}

// The document as HTML, in a new String.
pub fn render(src: &str, gpa: Gpa) -> String<Gpa> {
    let mut out = String::<Gpa>::new_in(gpa);
    let ls = lines(src, gpa);
    let hs = headings(ls.as_slice(), gpa);
    out.push_str("<ul>\n");
    for h in hs.iter() {
        out.push_str("<li><a href=\"#");
        out.push_str(h.id.as_str());
        out.push_str("\">");
        inline(h.title, &mut out);
        out.push_str("</a></li>\n");
    }
    out.push_str("</ul>\n");
    let mut k = 0;
    let mut para = false;
    for &l in ls.iter() {
        if l.len() > 2 && l.starts_with("# ") {
            if para {
                out.push_str("</p>\n");
                para = false;
            }
            out.push_str("<h1 id=\"");
            out.push_str(hs[k].id.as_str());
            out.push_str("\">");
            inline(&l[2..], &mut out);
            out.push_str("</h1>\n");
            k += 1;
        } else if l.len() == 0 {
            if para {
                out.push_str("</p>\n");
                para = false;
            }
        } else {
            out.push_str(if para { "\n" } else { "<p>" });
            inline(l, &mut out);
            para = true;
        }
    }
    if para {
        out.push_str("</p>\n");
    }
    out
}
