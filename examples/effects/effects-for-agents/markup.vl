// A small subset of Markdown to HTML: `# ` headings (with an id made from
// their text), paragraphs separated by blank lines, `*emphasis*` and
// `code` inside them, and a table of contents first. Everything it makes
// for a document lives until the document is printed.
use std::split_in;

pub struct Heading<A: Allocator> { pub title: [u8], pub id: Vec<u8, A> }

// The document's lines (views of src) in a new Vec.
fn lines(src: [u8], gpa: Gpa) -> Vec<[u8], Gpa> {
    split_in(src, '\n', gpa)
}

// The id of a heading: its letters and digits in lowercase, words joined
// by '-' ("Why arenas?" is "why-arenas").
fn slug(title: [u8], gpa: Gpa) -> Vec<u8, Gpa> {
    var id = Vec::<u8, Gpa>::new_in(gpa);
    var dash = false;
    for b in title {
        let c = if b >= 'A' && b <= 'Z' { b + 32 } else { b };
        if (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') {
            if dash && id.len() > 0 {
                id.push('-');
            }
            id.push(c);
            dash = false;
        } else {
            dash = true;
        }
    }
    id
}

// `*x*` as <em>x</em> and `x` (backquotes) as <code>x</code>, the rest as
// it is, appended to out.
fn inline(text: [u8], out: inout Vec<u8, Gpa>) {
    var em = false;
    var code = false;
    for b in text {
        if b == '`' {
            out.extend_from_slice(if code { "</code>" } else { "<code>" });
            code = !code;
        } else if b == '*' && !code {
            out.extend_from_slice(if em { "</em>" } else { "<em>" });
            em = !em;
        } else if b == '<' {
            out.extend_from_slice("&lt;");
        } else {
            out.push(b);
        }
    }
}

// The headings of the document, with their ids.
fn headings(ls: [[u8]], gpa: Gpa) -> Vec<Heading<Gpa>, Gpa> {
    var hs: Vec<Heading<Gpa>, Gpa> = Vec::new_in(gpa);
    for l in ls {
        if l.len() > 2 && l[0] == '#' && l[1] == ' ' {
            hs.push(Heading { title: l[2..], id: slug(l[2..], gpa) });
        }
    }
    hs
}

// The document as HTML, in a new Buf.
pub fn render(src: [u8], gpa: Gpa) -> Vec<u8, Gpa> {
    var out = Vec::<u8, Gpa>::new_in(gpa);
    let ls = lines(src, gpa);
    let hs = headings(ls.as_slice(), gpa);
    out.extend_from_slice("<ul>\n");
    for h in hs.iter() {
        out.extend_from_slice("<li><a href=\"#");
        out.extend_from_slice(h.id.as_slice());
        out.extend_from_slice("\">");
        inline(h.title, &out);
        out.extend_from_slice("</a></li>\n");
    }
    out.extend_from_slice("</ul>\n");
    var k = 0;
    var para = false;
    for l in ls.iter() {
        if l.len() > 2 && l[0] == '#' && l[1] == ' ' {
            if para {
                out.extend_from_slice("</p>\n");
                para = false;
            }
            out.extend_from_slice("<h1 id=\"");
            out.extend_from_slice(hs[k].id.as_slice());
            out.extend_from_slice("\">");
            inline(l[2..], &out);
            out.extend_from_slice("</h1>\n");
            k += 1;
        } else if l.len() == 0 {
            if para {
                out.extend_from_slice("</p>\n");
                para = false;
            }
        } else {
            out.extend_from_slice(if para { "\n" } else { "<p>" });
            inline(l, &out);
            para = true;
        }
    }
    if para {
        out.extend_from_slice("</p>\n");
    }
    out
}
