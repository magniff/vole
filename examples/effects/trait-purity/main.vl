// The most frequent words of a text, counted without regard to case
// ("The" and "the" are one word). The keys are a type of this program,
// `Word`, with hand-written Hash and PartialEq, and the counts are sorted
// by a hand-written Ord. std declares these three traits' methods #[pure]
// (no allocation, I/O or statics), and the declaration binds every impl:
// a hash that counts its calls in a static, an eq that prints, or a cmp
// that allocates is an error at the impl.
use std::cmp::Ordering;
use std::collections::HashMap;
use std::hash::{FixedState, Hash, Hasher};

// A word, compared and hashed as if it were in lowercase.
#[derive(Clone, Copy)]
struct Word<'a> { text: &'a str }

fn lower(b: u8) -> u8 {
    if b >= b'A' && b <= b'Z' { b + 32 } else { b }
}

// The lowercase bytes go to the hasher: equal words (by eq, below) must
// hash equal, so both look at the same thing.
impl Hash for Word<'_> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        for &b in self.text.as_bytes() {
            state.write_u8(lower(b));
        }
    }
}

impl PartialEq for Word<'_> {
    fn eq(&self, other: &Self) -> bool {
        let a = self.text.as_bytes();
        let b = other.text.as_bytes();
        if a.len() != b.len() {
            return false;
        }
        for i in 0..a.len() {
            if lower(a[i]) != lower(b[i]) {
                return false;
            }
        }
        true
    }
}

impl Eq for Word<'_> {}

// A word and how often it occurs: the most frequent first, then
// alphabetically (as written, so "The" before "the").
#[derive(PartialEq, Eq)]
struct Count<'a> { word: Word<'a>, n: i64 }

impl Ord for Count<'_> {
    fn cmp(&self, other: &Self) -> Ordering {
        if self.n != other.n {
            return other.n.cmp(&self.n);
        }
        self.word.text.cmp(other.word.text)
    }
}

impl PartialOrd for Count<'_> {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

// The word in w: w without the punctuation around it.
fn trim_word(w: &str) -> &str {
    let bytes = w.as_bytes();
    let mut a = 0;
    let mut b = bytes.len();
    for _ in 0..bytes.len() {
        if a < b && !is_letter(bytes[a]) {
            a += 1;
        }
        if a < b && !is_letter(bytes[b - 1]) {
            b -= 1;
        }
    }
    &w[a..b]
}

fn is_letter(b: u8) -> bool {
    (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z') || b == b'\''
}

fn main(gpa: Gpa) -> i32 {
    let text = "The cat sat on the mat. The mat was flat, and the cat was fat; \
                a cat on a mat is a happy cat. THE END";
    let mut words = 0;
    let mut counts: HashMap<Word<'_>, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    for w in text.split_whitespace() {
        words += 1;
        let t = trim_word(w);
        if t.len() > 0 {
            *counts.entry(Word { text: t }).or_insert(0) += 1;
        }
    }
    let mut ranked: Vec<Count<'_>, Gpa> = counts
        .iter()
        .map(|(w, n)| Count { word: *w, n: *n })
        .collect_in(gpa);
    ranked.sort();
    println("{words} words, {} different", counts.len());
    for c in &ranked[..5] {
        println("{:>3} {}", c.n, c.word.text);
    }
    0
}
