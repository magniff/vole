// EDITION: rust
// c-qsort: sorting vole data with the C library's qsort, and finding
// it again with bsearch. The records are #[repr(C)] structs, so C sees
// the layout vole wrote; the comparisons are vole functions with
// C's calling convention (`extern "C" fn`), which qsort calls back.
import "stdlib.h" as c;
import "string.h" as c;
use std::cmp::Ordering;
use std::mem::size_of;

// One city: C's struct layout (field order, padding), so a pointer to it
// can go to C and come back.
#[repr(C)]
#[derive(Clone, Copy)]
struct City { name: *const u8, country: *const u8, population: i64, area: f64 }

// The text of a C string, as a `&str`.
//
// UNSAFE: it reads memory through a raw pointer.
// SAFETY: the caller's promise: `p` points to a NUL-terminated string
// that lives for the program (here, `c"..."` literals).
unsafe fn text(p: *const u8) -> &'static str {
    let bytes = std::slice::from_raw_parts(p, c::strlen(p) as usize);
    std::str::from_utf8(bytes).unwrap_or("?")
}

// Callbacks: qsort hands them `const void *`, which arrives as *u8; each
// casts back to the type it knows the array holds.

// The City a callback's pointer is.
//
// UNSAFE: it reads a City through a raw pointer.
// SAFETY: the caller's promise: `p` points into an array of City (qsort
// and bsearch pass pointers to the elements they were given).
unsafe fn city(p: *const u8) -> City {
    *(p as *const City)
}

extern "C" fn by_population(a: *const u8, b: *const u8) -> i32 {
    // UNSAFE: city reads through the pointers.
    // SAFETY: qsort passes two elements of the City array it sorts.
    let (x, y) = unsafe { (city(a).population, city(b).population) };
    // not `x - y`: the difference of two i64 does not fit an i32
    sign(x.cmp(&y))
}

extern "C" fn by_name(a: *const u8, b: *const u8) -> i32 {
    // UNSAFE: city reads through the pointers; strcmp is C's.
    // SAFETY: two elements of the City array; their names are C strings.
    unsafe { c::strcmp(city(a).name, city(b).name) }
}

// Population per square kilometre, descending.
extern "C" fn by_density_desc(a: *const u8, b: *const u8) -> i32 {
    // UNSAFE: city reads through the pointers.
    // SAFETY: qsort passes two elements of the City array it sorts.
    let (x, y) = unsafe { (density(&city(a)), density(&city(b))) };
    if x > y { -1 } else if x < y { 1 } else { 0 }
}

// bsearch's comparison: the key against an element. The key need not be
// an element: here it is a `&str`, which C only passes along (as
// `const void *`, a pointer to it) without looking inside.
extern "C" fn name_key(key: *const u8, element: *const u8) -> i32 {
    // UNSAFE: the key and the element are read through raw pointers.
    // SAFETY: `find` passes a pointer to its `&str` as the key, and
    // bsearch an element of the City array.
    let (wanted, name) = unsafe { (*(key as *const &str), text(city(element).name)) };
    sign(wanted.cmp(name))
}

// C's convention for a comparison: negative, zero or positive.
fn sign(o: Ordering) -> i32 {
    match o {
        Ordering::Less => -1,
        Ordering::Equal => 0,
        Ordering::Greater => 1,
    }
}

fn density(city: &City) -> f64 {
    city.population as f64 / city.area
}

// Any slice, any element type, sorted by a C comparison: the slice's
// pointer, length and element size are what qsort needs.
//
// UNSAFE: qsort is C's, and calls `cmp` with untyped pointers.
// SAFETY: the caller's promise: `cmp` reads its two pointers as `T`s,
// which the compiler cannot check (a C callback sees only `void *`).
unsafe fn c_sort<T>(items: &mut [T], cmp: extern "C" fn(*const u8, *const u8) -> i32) {
    // (an unsafe fn's body: no block needed)
    c::qsort(items.as_mut_ptr() as *mut u8, items.len() as u64, size_of::<T>() as u64, cmp);
}

// The city named `name` in `cities` (sorted by name), if there is one.
fn find(cities: &[City], name: &str) -> Option<City> {
    // UNSAFE: bsearch is C's.
    // SAFETY: the key is a pointer to `name`, which name_key reads as a
    // `&str`; the array is `cities`, sorted by name; the result is null
    // or one of its elements.
    unsafe {
        let hit = c::bsearch(&name as *const &str as *const u8, cities.as_ptr() as *const u8,
            cities.len() as u64, size_of::<City>() as u64, name_key);
        if hit.is_null() { None } else { Some(city(hit)) }
    }
}

fn show(title: &str, cities: &[City]) {
    println("{title}:");
    for (i, city) in cities.iter().enumerate() {
        // UNSAFE: text reads C strings.
        // SAFETY: a City's name and country are `c"..."` literals.
        let (name, country) = unsafe { (text(city.name), text(city.country)) };
        let d = density(city);
        println("  {:>2}. {name:<12} {country:<10} {:>9} {d:>8.1}/km2", i + 1, city.population);
    }
}

fn main() -> i32 {
    let mut cities = [
        City { name: c"Lagos", country: c"Nigeria", population: 15388000, area: 1171.3 },
        City { name: c"Tokyo", country: c"Japan", population: 13960000, area: 2194.1 },
        City { name: c"Reykjavik", country: c"Iceland", population: 139875, area: 273.0 },
        City { name: c"Lima", country: c"Peru", population: 10092000, area: 2672.3 },
        City { name: c"Oslo", country: c"Norway", population: 709037, area: 454.0 },
        City { name: c"Montevideo", country: c"Uruguay", population: 1319108, area: 201.0 },
        City { name: c"Dhaka", country: c"Bangladesh", population: 10278882, area: 306.4 },
    ];
    println("{} bytes per City, {} cities", size_of::<City>(), cities.len());
    println("");

    // UNSAFE: c_sort hands the array to C's qsort.
    // SAFETY: each comparison reads its pointers as City, the element type.
    unsafe { c_sort(&mut cities, by_population); }
    show("by population", &cities);
    // UNSAFE: as above, qsort.
    // SAFETY: as above, a comparison over City.
    unsafe { c_sort(&mut cities, by_density_desc); }
    show("by density, densest first", &cities);
    // UNSAFE: as above, qsort.
    // SAFETY: as above, a comparison over City.
    unsafe { c_sort(&mut cities, by_name); }
    show("by name", &cities);

    // bsearch needs the order qsort just made.
    println("");
    for name in ["Oslo", "Lima", "Atlantis"] {
        match find(&cities, name) {
            Some(city) => println("found {name}: {} people", city.population),
            None => println("no {name}"),
        }
    }

    // The same wrapper sorts plain numbers: a C callback over i32s.
    let mut primes: [i32; 8] = [17, 2, 13, 5, 19, 3, 11, 7];
    // UNSAFE: c_sort hands the array to C's qsort.
    // SAFETY: by_i32 reads its pointers as i32, the element type.
    unsafe { c_sort(&mut primes, by_i32); }
    let total: i64 = primes.iter().map(|p| *p as i64).sum();
    println("primes {}..{}, sum {total}", primes[0], primes[7]);
    0
}

extern "C" fn by_i32(a: *const u8, b: *const u8) -> i32 {
    // UNSAFE: two i32s read through raw pointers.
    // SAFETY: qsort passes two elements of the i32 array it sorts.
    let (x, y) = unsafe { (*(a as *const i32), *(b as *const i32)) };
    sign(x.cmp(&y))
}
