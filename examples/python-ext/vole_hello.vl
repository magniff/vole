// A CPython extension module written in Vole.
//
// Python imports `vole_hello` by calling the C symbol `PyInit_vole_hello`;
// it builds the module from a method table and returns it. The module has
// one function, `hello()`, which writes through Python's sys.stdout and
// returns None. There is no C shim: Python.h supplies the declarations, and
// the interpreter resolves the Python symbols when it loads the extension.
import "Python.h" as py;
import "stdlib.h" as c;

// hello(): the C signature of a METH_NOARGS PyCFunction. Python holds the
// GIL while it calls this, and passes the module as self and NULL as args.
extern "C" fn hello(self: *py::PyObject, args: *py::PyObject) -> *py::PyObject {
    // UNSAFE: these are C API calls through raw pointers.
    // SAFETY: both strings are static C literals, the GIL is held, and
    // Py_BuildValue returns a new reference (None for the empty format).
    unsafe {
        py::PySys_WriteStdout(c"hello from vole\n");
        py::Py_BuildValue(c"")
    }
}

// The module entry point: importlib looks up exactly this symbol. CPython
// keeps the method and module definitions for as long as the interpreter
// lives, so this module allocates them once and intentionally does not free
// them. calloc also zeroes the terminator entry and the optional callbacks.
//
// UNSAFE: allocate and fill CPython's C structs through raw pointers.
// SAFETY: both allocations are checked; the method table is null-terminated;
// the strings outlive the module; PyModule_Create2 either returns a new
// module or NULL with a Python exception set.
extern "C" fn PyInit_vole_hello() -> *py::PyObject {
    let methods = unsafe { c::calloc(2, size_of(py::PyMethodDef) as u64) as *py::PyMethodDef };
    let def = unsafe { c::calloc(1, size_of(py::PyModuleDef) as u64) as *py::PyModuleDef };
    if methods == 0 as *py::PyMethodDef || def == 0 as *py::PyModuleDef {
        unsafe { py::PyErr_NoMemory() };
        return 0 as *py::PyObject;
    }
    unsafe {
        (*methods).ml_name = c"hello";
        (*methods).ml_meth = hello;
        (*methods).ml_flags = py::METH_NOARGS;
        (*methods).ml_doc = c"Print hello from Vole.";
        (*def).m_name = c"vole_hello";
        (*def).m_doc = c"A minimal Vole extension module.";
        (*def).m_size = -1;
        (*def).m_methods = methods;
        // PyModule_Create2 initializes m_base, so the zeroed base is fine.
        py::PyModule_Create2(def, py::PYTHON_API_VERSION)
    }
}
