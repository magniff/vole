// A shop's till: products and stock, carts, prices and discounts,
// receipts, and the commands a clerk types. It began as a few functions
// and grew into one file.

use std::alloc::Allocator;

// ---- Products and stock ----

#[derive(Clone, Copy)]
pub struct Product {
    pub sku: i64,
    pub name: &'static str,
    // the price of one, in cents
    pub price: i64,
    pub stock: i64,
}

pub struct Store<A: Allocator> {
    pub products: Vec<Product, A>,
    // sales so far, in cents
    pub takings: i64,
}

pub fn new_store(gpa: Gpa) -> Store<Gpa> {
    Store { products: Vec::new_in(gpa), takings: 0 }
}

pub fn add_product(st: &mut Store<Gpa>, sku: i64, name: &'static str, price: i64, stock: i64) {
    st.products.push(Product { sku, name, price, stock });
}

// The index of product `sku`, or None.
pub fn find_sku(st: &Store<Gpa>, sku: i64) -> Option<usize> {
    st.products.iter().position(|p| p.sku == sku)
}

pub fn product(st: &Store<Gpa>, sku: i64) -> Option<Product> {
    match find_sku(st, sku) {
        Some(i) => Some(st.products[i]),
        None => None,
    }
}

pub fn in_stock(st: &Store<Gpa>, sku: i64) -> i64 {
    match product(st, sku) {
        Some(p) => p.stock,
        None => 0,
    }
}

// n more of `sku` on the shelf; false for an unknown sku.
pub fn restock(st: &mut Store<Gpa>, sku: i64, n: i64) -> bool {
    match find_sku(st, sku) {
        Some(i) => {
            st.products[i].stock += n;
            true
        }
        None => false,
    }
}

// n of `sku` off the shelf, as many as there are.
fn take_stock(st: &mut Store<Gpa>, sku: i64, n: i64) -> i64 {
    match find_sku(st, sku) {
        Some(i) => {
            let have = st.products[i].stock;
            let k = if have < n { have } else { n };
            st.products[i].stock -= k;
            k
        }
        None => 0,
    }
}

// ---- Carts ----

#[derive(Clone, Copy)]
pub struct Line {
    pub sku: i64,
    pub qty: i64,
}

pub struct Cart<A: Allocator> {
    pub lines: Vec<Line, A>,
    pub coupon: Option<Coupon>,
}

pub fn new_cart(gpa: Gpa) -> Cart<Gpa> {
    Cart { lines: Vec::new_in(gpa), coupon: None }
}

fn line_index(cart: &Cart<Gpa>, sku: i64) -> Option<usize> {
    cart.lines.iter().position(|l| l.sku == sku)
}

// n of `sku` into the cart, when the shop has them: how many went in.
pub fn add_to_cart(st: &Store<Gpa>, cart: &mut Cart<Gpa>, sku: i64, n: i64) -> i64 {
    let have = in_stock(st, sku);
    let already = qty_of(cart, sku);
    let room = have - already;
    let k = if room < n { room } else { n };
    if k <= 0 {
        return 0;
    }
    match line_index(cart, sku) {
        Some(i) => cart.lines[i].qty += k,
        None => cart.lines.push(Line { sku, qty: k }),
    }
    k
}

pub fn remove_from_cart(cart: &mut Cart<Gpa>, sku: i64) -> bool {
    match line_index(cart, sku) {
        Some(i) => {
            cart.lines.remove(i);
            true
        }
        None => false,
    }
}

pub fn qty_of(cart: &Cart<Gpa>, sku: i64) -> i64 {
    match line_index(cart, sku) {
        Some(i) => cart.lines[i].qty,
        None => 0,
    }
}

pub fn items_in(cart: &Cart<Gpa>) -> i64 {
    let mut n = 0;
    for l in cart.lines.iter() {
        n += l.qty;
    }
    n
}

pub fn clear_cart(cart: &mut Cart<Gpa>) {
    cart.lines.clear();
    cart.coupon = None;
}

// ---- Prices and discounts ----

// The tax rate, in tenths of a percent.
const TAX_PERMILLE: i64 = 80;

#[derive(Clone, Copy)]
pub enum Coupon {
    // a percentage off the whole cart
    Percent(i64),
    // a fixed amount off, in cents, on carts of at least the second
    Off(i64, i64),
    // buy n of a sku, the next one is free
    Free(i64, i64),
}

#[derive(Clone, Copy)]
pub struct Total {
    pub subtotal: i64,
    pub discount: i64,
    pub tax: i64,
    pub total: i64,
}

pub fn parse_coupon(code: &str) -> Option<Coupon> {
    if code == "TEN" {
        return Some(Coupon::Percent(10));
    }
    if code == "FIVER" {
        return Some(Coupon::Off(500, 2000));
    }
    if code == "TEA3" {
        return Some(Coupon::Free(3, 1));
    }
    None
}

pub fn subtotal(st: &Store<Gpa>, cart: &Cart<Gpa>) -> i64 {
    let mut sum = 0;
    for l in cart.lines.iter() {
        if let Some(p) = product(st, l.sku) {
            sum += p.price * l.qty;
        }
    }
    sum
}

fn discount(st: &Store<Gpa>, cart: &Cart<Gpa>, sub: i64) -> i64 {
    match cart.coupon {
        Some(Coupon::Percent(pct)) => round_div(sub * pct, 100),
        Some(Coupon::Off(off, min)) => if sub >= min { off } else { 0 },
        Some(Coupon::Free(n, sku)) => {
            let q = qty_of(cart, sku);
            let free = q / (n + 1);
            match product(st, sku) {
                Some(p) => free * p.price,
                None => 0,
            }
        }
        None => 0,
    }
}

// a / b, rounded half up (a, b >= 0).
fn round_div(a: i64, b: i64) -> i64 {
    (a + b / 2) / b
}

fn tax_on(amount: i64) -> i64 {
    round_div(amount * TAX_PERMILLE, 1000)
}

pub fn total(st: &Store<Gpa>, cart: &Cart<Gpa>) -> Total {
    let sub = subtotal(st, cart);
    let off = discount(st, cart, sub);
    let taxed = sub - off;
    let tax = tax_on(taxed);
    Total { subtotal: sub, discount: off, tax, total: taxed + tax }
}

// ---- Receipts ----

// cents as dollars: 1234 is "12.34"
pub fn money(b: &mut String<Gpa>, cents: i64) {
    let mut c = cents;
    if c < 0 {
        b.push('-');
        c = -c;
    }
    write(b, "{}.{:02}", c / 100, c % 100).unwrap();
}

fn pad_to(b: &mut String<Gpa>, width: usize) {
    while b.len() < width {
        b.push(' ');
    }
}

// one receipt line: text on the left, an amount on the right
fn receipt_line(left: &str, cents: i64, gpa: Gpa) {
    let mut b = String::new_in(gpa);
    b.push_str(left);
    pad_to(&mut b, 30);
    let mut m = String::new_in(gpa);
    money(&mut m, cents);
    let mut k = m.len();
    while k < 9 {
        b.push(' ');
        k += 1;
    }
    b.push_str(&m);
    println("{b}");
}

pub fn print_receipt(st: &Store<Gpa>, cart: &Cart<Gpa>, gpa: Gpa) {
    println("------------- receipt -------------");
    for l in cart.lines.iter() {
        if let Some(p) = product(st, l.sku) {
            let left = format_in("{} x {}", l.qty, p.name, gpa);
            receipt_line(&left, p.price * l.qty, gpa);
        }
    }
    let t = total(st, cart);
    receipt_line("subtotal", t.subtotal, gpa);
    if t.discount > 0 {
        receipt_line("discount", -t.discount, gpa);
    }
    receipt_line("tax", t.tax, gpa);
    receipt_line("TOTAL", t.total, gpa);
    println("-----------------------------------");
}

pub fn print_stock(st: &Store<Gpa>, gpa: Gpa) {
    println("sku  product          stock    price");
    for p in st.products.iter() {
        let mut m = String::new_in(gpa);
        money(&mut m, p.price);
        println("{:<4} {:<16} {:>5} {:>8}", p.sku, p.name, p.stock, m);
    }
}

// ---- Commands ----

#[derive(Clone, Copy)]
pub enum Command<'a> {
    Add(i64, i64),
    Remove(i64),
    Use(&'a str),
    Restock(i64, i64),
    Checkout,
    Stock,
    Bad(&'static str),
}

fn number(word: &str) -> Option<i64> {
    word.parse().ok()
}

pub fn parse_command(text: &str, gpa: Gpa) -> Command<'_> {
    let w: Vec<&str, Gpa> = text.split_whitespace().collect_in(gpa);
    if w.len() == 0 {
        return Command::Bad("empty line");
    }
    let verb = w[0];
    if verb == "add" && w.len() == 3 {
        if let Some(sku) = number(w[1]) {
            if let Some(n) = number(w[2]) {
                return Command::Add(sku, n);
            }
        }
        return Command::Bad("add SKU COUNT");
    }
    if verb == "remove" && w.len() == 2 {
        if let Some(sku) = number(w[1]) {
            return Command::Remove(sku);
        }
        return Command::Bad("remove SKU");
    }
    if verb == "coupon" && w.len() == 2 {
        return Command::Use(w[1]);
    }
    if verb == "restock" && w.len() == 3 {
        if let Some(sku) = number(w[1]) {
            if let Some(n) = number(w[2]) {
                return Command::Restock(sku, n);
            }
        }
        return Command::Bad("restock SKU COUNT");
    }
    if verb == "checkout" {
        return Command::Checkout;
    }
    if verb == "stock" {
        return Command::Stock;
    }
    Command::Bad("unknown command")
}

// Runs one command; what the clerk sees.
pub fn run(st: &mut Store<Gpa>, cart: &mut Cart<Gpa>, text: &str, gpa: Gpa) {
    println("> {text}");
    match parse_command(text, gpa) {
        Command::Add(sku, n) => {
            let k = add_to_cart(st, cart, sku, n);
            if k < n {
                println("  only {k} added: not enough in stock");
            } else {
                println("  items in the cart: {}", items_in(cart));
            }
        }
        Command::Remove(sku) => {
            if !remove_from_cart(cart, sku) {
                println("  not in the cart");
            }
        }
        Command::Use(code) => match parse_coupon(code) {
            Some(c) => {
                cart.coupon = Some(c);
                println("  coupon accepted");
            }
            None => println("  no such coupon"),
        },
        Command::Restock(sku, n) => {
            if !restock(st, sku, n) {
                println("  unknown sku");
            }
        }
        Command::Checkout => checkout(st, cart, gpa),
        Command::Stock => print_stock(st, gpa),
        Command::Bad(why) => println("  ? {why}"),
    }
}

fn checkout(st: &mut Store<Gpa>, cart: &mut Cart<Gpa>, gpa: Gpa) {
    if items_in(cart) == 0 {
        println("  the cart is empty");
        return;
    }
    print_receipt(st, cart, gpa);
    for l in cart.lines.iter() {
        take_stock(st, l.sku, l.qty);
    }
    st.takings += total(st, cart).total;
    clear_cart(cart);
}
