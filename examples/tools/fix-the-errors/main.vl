// gradebook: a class's test scores, each student's average, grade and
// biggest swing, and the class's best student. It does not compile yet:
// see README.md.

mod grades;
mod roster;

use grades::{average, biggest_swing, letter, remark};
use roster::{add_score, enrol, new_roster, with_scores};

fn main(gpa: Gpa) -> i32 {
    let mut r = new_roster(gpa);
    let ada = [91, 97, 99];
    let brook = [72, 85, 64, 80];
    let cyd = [55, 61];
    enrol(&mut r, "Ada", &ada[..]);
    enrol(&mut r, "Brook", &brook[..]);
    enrol(&mut r, "Cyd", &cyd[..]);
    // a late test
    add_score(&mut r, "Cyd", 78);

    let mut best: HashMap<&str, i64, Gpa> = HashMap::new_in(gpa);
    for s in r.students.iter() {
        let avg = average(s.scores.as_slice());
        let g = letter(avg);
        println(
            "{:<6} {avg:>3} {g}  swing {:>2}{}", s.name, biggest_swing(s.scores.as_slice()),
            remark(avg),
        );
        best.insert(s.name, avg);
    }
    let mut top = "";
    let mut top_avg = i64::MIN;
    for (&name, &avg) in best.iter() {
        if avg > top_avg {
            top = name;
            top_avg = avg;
        }
    }
    println("best: {top} ({top_avg}); {} students have 3 scores or more", with_scores(&r, 3));
    0
}

