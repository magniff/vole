// The class: each student's name and test scores.

use std::alloc::Allocator;

pub struct Student<'a, A: Allocator> {
    pub name: &'a str,
    pub scores: Vec<i64, A>,
}

pub struct Roster<'a, A: Allocator> {
    pub students: Vec<Student<'a, A>, A>,
}

pub fn new_roster<'a>(gpa: Gpa) -> Roster<'a, Gpa> {
    Roster { students: Vec::new_in(gpa) }
}

// A student with no scores yet.
pub fn enrol<'a>(r: &mut Roster<'a, Gpa>, name: &'a str) {
    r.students.push(Student { name, scores: Vec::new_in(*r.students.allocator()) });
}

// How many students have at least `n` scores.
pub fn with_scores(r: &Roster<Gpa>, n: usize) -> usize {
    let count = 0;
    for s in r.students.iter() {
        if s.scores.len() >= n {
            count += 1;
        }
    }
    count
}
