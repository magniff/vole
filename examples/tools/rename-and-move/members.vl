// The library's members, and how many books each may hold.

use std::alloc::Allocator;

pub struct Member {
    pub id: i64,
    pub name: &'static str,
    // the count of books held now
    pub count: i64,
    pub limit: i64,
    // fees owed, in cents
    pub owed: i64,
}

pub struct Members<A: Allocator> {
    pub list: Vec<Member, A>,
}

impl Members<Gpa> {
    pub fn new(gpa: Gpa) -> Members<Gpa> {
        Members { list: Vec::new_in(gpa) }
    }

    pub fn join(&mut self, name: &'static str, limit: i64) -> i64 {
        let id = 100 + self.list.len();
        self.list.push(Member { id: id as i64, name: name, count: 0, limit: limit, owed: 0 });
        id as i64
    }
}

// The index of member `id`, or None.
pub fn find(ms: &Members<Gpa>, id: i64) -> Option<usize> {
    ms.list.iter().position(|m| m.id == id)
}

pub fn can_borrow(m: &Member) -> bool {
    m.count < m.limit && m.owed == 0
}
