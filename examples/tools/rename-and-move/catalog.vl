// The library's books: what it owns, and how many copies of each are on
// the shelf right now.

use std::alloc::Allocator;

pub struct Book {
    pub id: i64,
    pub title: &'static str,
    pub author: &'static str,
    // copies on the shelf (the others are lent)
    pub count: i64,
    pub owned: i64,
}

pub struct Catalog<A: Allocator> {
    pub books: Vec<Book, A>,
}

impl Catalog<Gpa> {
    pub fn new(gpa: Gpa) -> Catalog<Gpa> {
        Catalog { books: Vec::new_in(gpa) }
    }

    // A new title, with `n` copies; its id is its place in the catalog.
    pub fn add(&mut self, title: &'static str, author: &'static str, n: i64) -> i64 {
        let id = self.books.len() + 1;
        self.books.push(Book { id: id as i64, title: title, author: author, count: n, owned: n });
        id as i64
    }
}

// The index of book `id` in the catalog, or None.
pub fn find(cat: &Catalog<Gpa>, id: i64) -> Option<usize> {
    cat.books.iter().position(|b| b.id == id)
}

// One copy off the shelf; false when none is left.
pub fn take(cat: &mut Catalog<Gpa>, id: i64) -> bool {
    match find(cat, id) {
        Some(i) => {
            if cat.books[i].count == 0 {
                return false;
            }
            cat.books[i].count -= 1;
            true
        }
        None => false,
    }
}

// A copy back on the shelf.
pub fn put_back(cat: &mut Catalog<Gpa>, id: i64) {
    if let Some(i) = find(cat, id) {
        cat.books[i].count += 1;
    }
}
