// The end-of-day report.

use crate::catalog::Catalog;
use crate::loans::Loan;
use crate::members::Members;

pub fn shelf(cat: &Catalog<Gpa>) {
    println("shelf:");
    for b in cat.books.iter() {
        println("  {:<28} {:<18} count {}/{}", b.title, b.author, b.count, b.owned);
    }
}

pub fn people(ms: &Members<Gpa>) {
    println("members:");
    for m in ms.list.iter() {
        println("  {:<10} holds {} of {}, owes {} cents", m.name, m.count, m.limit, m.owed);
    }
}

pub fn overdue(loans: &Vec<Loan, Gpa>, today: i64) -> i64 {
    let mut n = 0;
    for l in loans.iter() {
        if l.due < today {
            n += 1;
        }
    }
    n
}
