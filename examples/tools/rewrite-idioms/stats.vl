// Counting: word frequencies, the commonest words, word lengths.

use std::collections::HashMap;

use crate::compat::vec_at;

#[derive(Clone, Copy)]
pub struct Count<'a> {
    pub word: &'a str,
    pub n: i64,
}

pub fn frequencies<'a>(ws: &[&'a str], gpa: Gpa) -> HashMap<&'a str, i64, Gpa, FixedState> {
    let mut m: HashMap<&'a str, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    for i in 0..ws.len() {
        let w = ws[i];
        *m.entry(w).or_insert(0) += 1;
    }
    m
}

// The counts, commonest first; ties in alphabetical order.
pub fn ranked<'a>(m: &HashMap<&'a str, i64, Gpa, FixedState>, gpa: Gpa) -> Vec<Count<'a>, Gpa> {
    let mut v: Vec<Count<'a>, Gpa> = Vec::new_in(gpa);
    for (&w, &n) in m.iter() {
        v.push(Count { word: w, n });
    }
    v.sort_by(|a, b| if a.n != b.n { b.n.cmp(&a.n) } else { a.word.cmp(b.word) });
    v
}

// How many words have each length, 1 to 12 (longer ones count as 12).
pub struct Histogram {
    pub bins: [i64; 13],
}

impl Histogram {
    // One more than the longest length counted.
    pub fn len(&self) -> usize {
        self.bins.len()
    }
}

pub fn length_histogram(ws: &[&str]) -> Histogram {
    let mut h = Histogram { bins: [0; 13] };
    for i in 0..ws.len() {
        let w = ws[i];
        let k = if w.len() > 12 { 12 } else { w.len() };
        h.bins[k] += 1;
    }
    h
}

pub fn total_letters(ws: &[&str]) -> i64 {
    let mut t = 0;
    for i in 0..ws.len() {
        let w = ws[i];
        t += w.len() as i64;
    }
    t
}

// The first k counts, as `word n` pairs.
pub fn top<'a>(v: &Vec<Count<'a>, Gpa>, k: usize, gpa: Gpa) -> Vec<Count<'a>, Gpa> {
    let mut out: Vec<Count<'a>, Gpa> = Vec::new_in(gpa);
    let n = if v.len() < k { v.len() } else { k };
    for i in 0..n {
        out.push(vec_at(v, i));
    }
    out
}

// Words that occur once.
pub fn hapaxes(v: &Vec<Count, Gpa>) -> i64 {
    let mut n = 0;
    for i in 0..v.len() {
        if vec_at(v, i).n == 1 {
            n += 1;
        }
    }
    n
}
