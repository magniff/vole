// Text into lines and words.

// Lowercase ASCII letters and digits; every other byte ends a word.
fn is_word_byte(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'0' && c <= b'9')
}

fn lower(c: u8) -> u8 {
    if c >= b'A' && c <= b'Z' { c + 32 } else { c }
}

// The words of `text`, lowercased into `store`, as slices of it.
pub fn words<'a>(text: &[u8], store: &'a mut String<Gpa>, gpa: Gpa) -> Vec<&'a str, Gpa> {
    store.clear();
    store.reserve(text.len());
    for i in 0..text.len() {
        let c = text[i];
        let l = lower(c);
        store.push(if is_word_byte(l) { l as char } else { ' ' });
    }
    store.split_whitespace().collect_in(gpa)
}

pub fn lines(text: &str, gpa: Gpa) -> Vec<&str, Gpa> {
    let mut v: Vec<&str, Gpa> = text.split('\n').collect_in(gpa);
    if v.len() > 0 && v[v.len() - 1] == "" {
        v.pop();
    }
    v
}

// The length of the longest line, and its index.
pub fn longest_line(ls: &[&str]) -> (usize, usize) {
    let mut best = 0;
    let mut at = 0;
    for i in 0..ls.len() {
        let l = ls[i];
        if l.len() > best {
            best = l.len();
            at = i;
        }
    }
    (best, at)
}
