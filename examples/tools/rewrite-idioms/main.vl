// wordstat: lines, words, the commonest words and word lengths of the
// text on stdin.

mod compat;
mod report;
mod stats;
mod text;

use std::io;

fn main(gpa: Gpa) -> i32 {
    let input = io::read_to_string_in(io::stdin(), gpa).unwrap();
    let t = input.as_str();

    let ls = text::lines(t, gpa);
    let mut store = String::new_in(gpa);
    let ws = text::words(t.as_bytes(), &mut store, gpa);
    if ws.len() == 0 {
        println("no words");
        return 1;
    }

    let freq = stats::frequencies(ws.as_slice(), gpa);
    let ranked = stats::ranked(&freq, gpa);
    let top = stats::top(&ranked, 5, gpa);
    let h = stats::length_histogram(ws.as_slice());
    let (len, at) = text::longest_line(ls.as_slice());

    let mut b = String::new_in(gpa);
    report::summary(
        &mut b, ls.len() as i64, ws.len() as i64, stats::total_letters(ws.as_slice()),
        freq.len() as i64, stats::hapaxes(&ranked),
    );
    report::commonest(&mut b, &top);
    report::histogram(&mut b, &h);
    report::longest(&mut b, len, ls[at], at);
    report::finish(&mut b);
    print("{b}");
    0
}
