// EDITION: rust
// The report, built in a String and printed at once.

use crate::compat::{buf_add, buf_add_int, vec_at};
use crate::stats::{Count, Histogram};

fn bar(b: &mut String<Gpa>, n: i64) {
    for _ in 0..n {
        buf_add(b, "#");
    }
}

pub fn summary(b: &mut String<Gpa>, lines: i64, words: i64, letters: i64, distinct: i64, once: i64) {
    buf_add(b, "lines ");
    buf_add_int(b, lines);
    buf_add(b, ", words ");
    buf_add_int(b, words);
    buf_add(b, " (");
    buf_add_int(b, distinct);
    buf_add(b, " distinct, ");
    buf_add_int(b, once);
    buf_add(b, " used once), mean length ");
    buf_add_int(b, letters / words);
    buf_add(b, ".");
    buf_add_int(b, letters * 10 / words % 10);
    buf_add(b, "\n");
}

pub fn commonest(b: &mut String<Gpa>, top: &Vec<Count, Gpa>) {
    buf_add(b, "commonest:\n");
    for i in 0..top.len() {
        let c = vec_at(top, i);
        buf_add(b, "  ");
        buf_add(b, c.word);
        for _ in c.word.len()..8 {
            buf_add(b, " ");
        }
        buf_add_int(b, c.n);
        buf_add(b, "\n");
    }
}

pub fn histogram(b: &mut String<Gpa>, h: &Histogram) {
    if h.len() == 0 {
        return;
    }
    buf_add(b, "word lengths:\n");
    for k in 1..h.len() {
        if h.bins[k] == 0 {
            continue;
        }
        buf_add(b, if k < 10 { "   " } else { "  " });
        buf_add_int(b, k as i64);
        buf_add(b, " ");
        bar(b, h.bins[k]);
        buf_add(b, "\n");
    }
}

pub fn longest(b: &mut String<Gpa>, len: usize, line: &str, at: usize) {
    buf_add(b, "longest line: ");
    buf_add_int(b, at as i64 + 1);
    buf_add(b, " (");
    buf_add_int(b, len as i64);
    buf_add(b, " bytes): ");
    buf_add(b, line);
    buf_add(b, "\n");
}

// The report's last line; a note when nothing was written before it.
pub fn finish(b: &mut String<Gpa>) {
    if b.len() == 0 {
        buf_add(b, "(nothing to report)\n");
    }
    buf_add(b, "--\n");
}
