// EDITION: rust
// Helpers from before std had them. Deprecated: std's methods do the
// same (`b.push_str(s)`, `write(b, "{}", n)`, `v[i]`), and new code
// should call those.

// Appends s to b. Deprecated: b.push_str(s).
pub fn buf_add(b: &mut String<Gpa>, s: &str) {
    b.push_str(s);
}

// Appends the decimal digits of n to b. Deprecated: write(b, "{}", n).
pub fn buf_add_int(b: &mut String<Gpa>, n: i64) {
    write(b, "{n}").unwrap();
}

// Element i of v. Deprecated: v[i].
pub fn vec_at<T: Copy>(v: &Vec<T, Gpa>, i: usize) -> T {
    v[i]
}
