// EDITION: rust
// The city's network, from its timetable: one ride per line, `LINE FROM
// TO MINUTES`.

use crate::graph::{Graph, connect, new_graph, station};

static TIMETABLE: &str = "\
    A Airport Docks 7\n\
    A Docks Central 5\n\
    A Central Museum 4\n\
    A Museum University 6\n\
    B Harbor Central 9\n\
    B Central Market 3\n\
    B Market Stadium 8\n\
    C Docks Harbor 6\n\
    C Harbor Beach 11\n\
    C University Stadium 7\n";

pub fn load(gpa: Gpa) -> Graph<Gpa> {
    let mut g = new_graph(gpa);
    for row in TIMETABLE.split('\n') {
        let w: Vec<&str, Gpa> = row.split_whitespace().collect_in(gpa);
        if w.len() != 4 {
            continue;
        }
        let a = station(&mut g, w[1], gpa);
        let b = station(&mut g, w[2], gpa);
        let minutes = w[3].parse().unwrap_or(0);
        connect(&mut g, a, b, minutes, w[0].as_bytes()[0]);
    }
    g
}
