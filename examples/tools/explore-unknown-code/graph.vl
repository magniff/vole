// The network as a graph: stations are numbers, each with the edges
// that leave it.

use std::alloc::Allocator;

// A ride from one station to the next on one line.
#[derive(Clone, Copy)]
pub struct Edge {
    pub to: usize,
    pub minutes: i64,
    pub line: u8,
}

pub struct Graph<A: Allocator> {
    pub names: Vec<&'static str, A>,
    // edges[i]: the rides that leave station i
    pub edges: Vec<Vec<Edge, A>, A>,
}

pub fn new_graph(gpa: Gpa) -> Graph<Gpa> {
    Graph { names: Vec::new_in(gpa), edges: Vec::new_in(gpa) }
}

pub fn size(g: &Graph<Gpa>) -> usize {
    g.names.len()
}

// The station called `name`, added when it is new.
pub fn station(g: &mut Graph<Gpa>, name: &'static str, gpa: Gpa) -> usize {
    if let Some(i) = find(g, name) {
        return i;
    }
    g.names.push(name);
    g.edges.push(Vec::new_in(gpa));
    g.names.len() - 1
}

pub fn find(g: &Graph<Gpa>, name: &str) -> Option<usize> {
    g.names.iter().position(|n| *n == name)
}

pub fn name_of(g: &Graph<Gpa>, i: usize) -> &'static str {
    g.names[i]
}

fn add_edge(g: &mut Graph<Gpa>, from: usize, e: Edge) {
    g.edges[from].push(e);
}

// Trains run both ways.
pub fn connect(g: &mut Graph<Gpa>, a: usize, b: usize, minutes: i64, line: u8) {
    add_edge(g, a, Edge { to: b, minutes, line });
    add_edge(g, b, Edge { to: a, minutes, line });
}

pub fn edges_from(g: &Graph<Gpa>, i: usize) -> &[Edge] {
    g.edges[i].as_slice()
}
