// EDITION: rust
// The quickest route between two stations: Dijkstra's search over the
// graph, where changing lines costs a transfer.

use std::alloc::Allocator;

use crate::graph::{Graph, edges_from, size};
use crate::heap::{Entry, is_empty, new_heap, pop, push};

// Minutes lost changing from one line to another at a station.
pub const TRANSFER_MINUTES: i64 = 5;

pub struct Leg {
    pub from: usize,
    pub to: usize,
    pub line: u8,
    pub minutes: i64,
}

pub struct Route<A: Allocator> {
    pub legs: Vec<Leg, A>,
    pub total: i64,
}

// How a station was first reached: from where, on which line.
#[derive(Clone, Copy)]
struct Step {
    from: usize,
    line: u8,
    minutes: i64,
}

// What a ride on `e` costs, arriving at its start on `here_line`.
fn ride_cost(here_line: u8, minutes: i64, line: u8) -> i64 {
    if line != here_line { minutes + TRANSFER_MINUTES } else { minutes }
}

pub fn quickest(g: &Graph<Gpa>, from: usize, to: usize, gpa: Gpa) -> Option<Route<Gpa>> {
    let n = size(g);
    let mut best: Vec<i64, Gpa> = Vec::from_elem_in(i64::MAX, n, gpa);
    let mut how: Vec<Step, Gpa> = Vec::from_elem_in(Step { from, line: 0, minutes: 0 }, n, gpa);
    let mut h = new_heap(gpa);

    best[from] = 0;
    push(&mut h, Entry { cost: 0, node: from, line: 0 });
    while !is_empty(&h) {
        let cur = pop(&mut h).unwrap();
        if cur.cost > best[cur.node] {
            continue;
        }
        if cur.node == to {
            break;
        }
        for e in edges_from(g, cur.node) {
            let cost = cur.cost + ride_cost(cur.line, e.minutes, e.line);
            if cost < best[e.to] {
                best[e.to] = cost;
                how[e.to] = Step { from: cur.node, line: e.line, minutes: e.minutes };
                push(&mut h, Entry { cost, node: e.to, line: e.line });
            }
        }
    }
    if best[to] == i64::MAX {
        return None;
    }
    Some(Route { legs: legs_to(&how, from, to, gpa), total: best[to] })
}

// The legs from `from` to `to`, read backwards from `how`, then turned
// around; consecutive rides on one line are one leg.
fn legs_to(how: &Vec<Step, Gpa>, from: usize, to: usize, gpa: Gpa) -> Vec<Leg, Gpa> {
    let mut back: Vec<Leg, Gpa> = Vec::new_in(gpa);
    let mut at = to;
    while at != from {
        let s = how[at];
        back.push(Leg { from: s.from, to: at, line: s.line, minutes: s.minutes });
        at = s.from;
    }
    let mut legs: Vec<Leg, Gpa> = Vec::new_in(gpa);
    while let Some(l) = back.pop() {
        let k = legs.len();
        if k > 0 && legs[k - 1].line == l.line {
            legs[k - 1].to = l.to;
            legs[k - 1].minutes += l.minutes;
        } else {
            legs.push(l);
        }
    }
    legs
}
