// EDITION: rust
// pack: run-length encodes stdin, checks that it decodes back, and
// reports sizes and Adler-32 checksums.

mod adler;
mod rle;

use std::io::{Read, self};

use adler::{adler32, hex8};

fn percent(part: usize, whole: usize) -> usize {
    if whole == 0 { 0 } else { part * 100 / whole }
}

fn main(gpa: Gpa) -> i32 {
    let mut input: Vec<u8, Gpa> = Vec::new_in(gpa);
    io::stdin().read_to_end(&mut input).unwrap();
    let s = input.as_slice();
    let packed = rle::encode(s, gpa);
    let p = packed.as_slice();

    // check the round trip before reporting anything
    let ok = match rle::decode(p, gpa) {
        Some(back) => back.as_slice() == s,
        None => false,
    };
    if !ok {
        eprintln("pack: the encoding does not decode back");
        return 1;
    }

    let c1 = hex8(adler32(s), gpa);
    let c2 = hex8(adler32(p), gpa);
    println("in   {:>6} bytes  adler32 {}", s.len(), c1);
    println(
        "out  {:>6} bytes  adler32 {}  ({}% of the input)", p.len(), c2,
        percent(p.len(), s.len()),
    );
    println("longest run {}", rle::longest_run(s));
    0
}
