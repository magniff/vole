// view.vl: the window's picture — one storage buffer holding the 368×288
// UI frame, and a fullscreen shader that reads it with nearest-neighbour
// sampling, the same picture the Rust client's upscaler draws.
//
// A fragment's uv (0,0 at the top-left) picks one word; its low byte is
// red. There is no texture and no sampler: the frame is uploaded as it
// is and each fragment indexes it.
//
// The surface is Bgra8Unorm (what Metal offers): the shader writes RGBA
// and the swapchain orders the bytes for the display, so a readback of
// the surface is BGRA.

use std::gpu;
use std::gpu::{
    BindGroup, Buffer, BufferUsage, Color, Format, PassDesc, RenderPipeline, TextureView,
};

pub const FB_W: i64 = 368;
pub const FB_H: i64 = 288;
pub const FB_PX: i64 = FB_W * FB_H;

pub static CLEAR: Color = Color::rgba(0.0, 0.0, 0.0, 1.0);

pub const WGSL: [u8] = r"""
    struct V {
        @builtin(position) pos: vec4<f32>,
        @location(0) uv: vec2<f32>,
    }
    @group(0) @binding(0) var<storage, read> fb: array<u32>;
    @vertex fn vs(@builtin(vertex_index) vid: u32) -> V {
        var p = vec2<f32>(-1.0, -1.0);
        if (vid == 1u) { p = vec2<f32>(3.0, -1.0); }
        if (vid == 2u) { p = vec2<f32>(-1.0, 3.0); }
        var o: V;
        o.pos = vec4<f32>(p, 0.0, 1.0);
        o.uv = vec2<f32>(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);
        return o;
    }
    @fragment fn fs(i: V) -> @location(0) vec4<f32> {
        let x = min(u32(i.uv.x * 368.0), 367u);
        let y = min(u32(i.uv.y * 288.0), 287u);
        let c = fb[y * 368u + x];
        let r = f32(c & 255u) / 255.0;
        let g = f32((c >> 8u) & 255u) / 255.0;
        let b = f32((c >> 16u) & 255u) / 255.0;
        return vec4<f32>(r, g, b, 1.0);
    }
    """;

/// The pipeline, the frame buffer on the GPU and the bind group that
/// joins them.
pub struct Viewer {
    pub pipe: RenderPipeline,
    pub buf: Buffer,
    pub group: BindGroup,
}

pub fn viewer_new(dev: gpu::Device) -> Result<Viewer, gpu::Error> {
    let shader = dev.shader_wgsl(WGSL)?;
    let pipe = dev.render_pipeline(gpu::RenderDesc::new(shader, "vs", "fs",
        Format::Bgra8Unorm))?;
    let buf = dev.buffer(FB_PX * 4,
        BufferUsage::STORAGE | BufferUsage::COPY_DST);
    let layout = pipe.bind_layout(0);
    let group = dev.bind_group(layout, [gpu::bind(0, buf)][..]);
    Ok(Viewer { pipe: pipe, buf: buf, group: group })
}

impl Viewer {
    /// Upload one frame and draw it over the whole target.
    pub fn draw(self, dev: gpu::Device, queue: inout gpu::Queue,
        target: TextureView, px: [u32]) {
        queue.write_buffer(self.buf, 0, gpu::bytes_of_u32(px));
        let pipe = self.pipe;
        let group = self.group;
        var enc = dev.encoder();
        enc.render_pass(PassDesc::color(target, clear: CLEAR), |pass| {
            pass.set_pipeline(pipe);
            pass.set_bind_group(0, group);
            pass.draw(0..3, 0..1);
        });
        queue.submit(enc.finish());
    }
}
