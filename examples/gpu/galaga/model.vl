// model.vl: the cheats agent's network — a small MLP over the 1630-float
// stacked observation. The checkpoint is Burn's CompactRecorder format:
// MessagePack whose tensors are little-endian f16, each shape `[in, out]`
// row-major, so `out[j] = bias[j] + sum_i obs[i] * weight[i*out + j]`.
//
// forward gives the 18 action probabilities and the critic's value;
// saliency replays it and backprops the chosen action's log-probability
// to the observation, which the overlay uses to show what mattered.

use std::alloc::Allocator;

pub const NUM_ACTIONS: i64 = 18;

fn expf(v: f32) -> f32 {
    v.exp()
}

pub struct Linear<A: Allocator> {
    w: Vec<f32, A>,
    b: Vec<f32, A>,
    in_dim: i64,
    out_dim: i64,
}

pub struct Model<A: Allocator> {
    fc1: Linear<A>,
    fc2: Linear<A>,
    fc3: Linear<A>,
    trunk: Linear<A>,
    policy: Linear<A>,
    value: Linear<A>,
}

#[derive(Clone, Copy)]
pub struct Net {
    pub probs: [f32; 18],
    pub value: f32,
}

fn empty_linear(gpa: Gpa) -> Linear<Gpa> {
    Linear {
        w: Vec::new_in(gpa),
        b: Vec::new_in(gpa),
        in_dim: 0,
        out_dim: 0,
    }
}

// --- the MessagePack reader -------------------------------------------

struct Cur<'a> {
    d: &'a [u8],
    i: i64,
}

fn cur_u8(rd: &mut Cur<'_>) -> u8 {
    let v = rd.d[rd.i as usize];
    rd.i += 1;
    v
}

fn cur_take<'a>(rd: &mut Cur<'a>, n: i64) -> &'a [u8] {
    let s = &rd.d[rd.i as usize..(rd.i + n) as usize];
    rd.i += n;
    s
}

fn eqs(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

fn rd_map_len(rd: &mut Cur<'_>) -> i64 {
    let b = cur_u8(rd) as i64;
    if b >= 0x80 && b <= 0x8f {
        b & 0xf
    } else if b == 0xde {
        ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64
    } else {
        ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64
    }
}

fn rd_arr_len(rd: &mut Cur<'_>) -> i64 {
    let b = cur_u8(rd) as i64;
    if b >= 0x90 && b <= 0x9f {
        b & 0xf
    } else if b == 0xdc {
        ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64
    } else {
        ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64
    }
}

fn rd_str<'a>(rd: &mut Cur<'a>) -> &'a [u8] {
    let b = cur_u8(rd) as i64;
    let mut n: i64 = 0;
    if b >= 0xa0 && b <= 0xbf {
        n = b & 0x1f;
    } else if b == 0xd9 {
        n = cur_u8(rd) as i64;
    } else if b == 0xda {
        n = ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    } else {
        n = ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    }
    cur_take(rd, n)
}

fn rd_bin<'a>(rd: &mut Cur<'a>) -> &'a [u8] {
    let b = cur_u8(rd) as i64;
    let mut n: i64 = 0;
    if b == 0xc4 {
        n = cur_u8(rd) as i64;
    } else if b == 0xc5 {
        n = ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    } else {
        n = ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    }
    cur_take(rd, n)
}

fn rd_int(rd: &mut Cur<'_>) -> i64 {
    let b = cur_u8(rd) as i64;
    if b <= 0x7f {
        return b;
    }
    if b >= 0xe0 {
        return b - 256;
    }
    if b == 0xcc {
        return cur_u8(rd) as i64;
    }
    if b == 0xcd {
        return ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    }
    if b == 0xce {
        return ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    }
    if b == 0xcf {
        return ((cur_u8(rd) as i64) << 56) | ((cur_u8(rd) as i64) << 48)
            | ((cur_u8(rd) as i64) << 40) | ((cur_u8(rd) as i64) << 32)
            | ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    }
    if b == 0xd0 {
        return cur_u8(rd) as i8 as i64;
    }
    if b == 0xd1 {
        return ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    }
    if b == 0xd2 {
        return ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    }
    if b == 0xd3 {
        return ((cur_u8(rd) as i64) << 56) | ((cur_u8(rd) as i64) << 48)
            | ((cur_u8(rd) as i64) << 40) | ((cur_u8(rd) as i64) << 32)
            | ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
    }
    rd.i -= 1;
    0
}

fn skip(rd: &mut Cur<'_>) {
    let b = cur_u8(rd) as i64;
    if b <= 0x7f || b >= 0xe0 {
        return;
    }
    if b >= 0x80 && b <= 0x8f {
        for _ in 0..(b & 0xf) {
            skip(rd);
            skip(rd);
        }
        return;
    }
    if b >= 0x90 && b <= 0x9f {
        for _ in 0..(b & 0xf) {
            skip(rd);
        }
        return;
    }
    if b >= 0xa0 && b <= 0xbf {
        rd.i += b & 0x1f;
        return;
    }
    if b == 0xc0 || b == 0xc2 || b == 0xc3 {
        return;
    }
    if b == 0xc4 {
        let n = cur_u8(rd) as i64;
        rd.i += n;
    } else if b == 0xc5 {
        let n = ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
        rd.i += n;
    } else if b == 0xc6 {
        let n = ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
        rd.i += n;
    } else if b == 0xca {
        rd.i += 4;
    } else if b == 0xcb {
        rd.i += 8;
    } else if b == 0xcc || b == 0xd0 {
        rd.i += 1;
    } else if b == 0xcd || b == 0xd1 {
        rd.i += 2;
    } else if b == 0xce || b == 0xd2 {
        rd.i += 4;
    } else if b == 0xcf || b == 0xd3 {
        rd.i += 8;
    } else if b == 0xd9 {
        let n = cur_u8(rd) as i64;
        rd.i += n;
    } else if b == 0xda {
        let n = ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
        rd.i += n;
    } else if b == 0xdb {
        let n = ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
            | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
        rd.i += n;
    } else if b == 0xdc || b == 0xdd {
        let mut n: i64 = 0;
        if b == 0xdc {
            n = ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
        } else {
            n = ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
                | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
        }
        for _ in 0..n {
            skip(rd);
        }
    } else if b == 0xde || b == 0xdf {
        let mut n: i64 = 0;
        if b == 0xde {
            n = ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
        } else {
            n = ((cur_u8(rd) as i64) << 24) | ((cur_u8(rd) as i64) << 16)
                | ((cur_u8(rd) as i64) << 8) | cur_u8(rd) as i64;
        }
        for _ in 0..n {
            skip(rd);
            skip(rd);
        }
    }
}

// --- f16 to f32 (IEEE 754 binary16 to binary32) ------------------------

fn f16_to_f32(h: u32) -> f32 {
    let sign = (h & 0x8000) << 16;
    let mut exp = (h >> 10) & 0x1f;
    let mut mant = h & 0x3ff;
    if exp == 0 {
        if mant == 0 {
            return f32::from_bits(sign);
        }
        // Subnormal: shift the leading one up into the mantissa.
        let mut e: u32 = 127 - 15 + 1;
        while (mant & 0x400) == 0 {
            mant <<= 1;
            e -= 1;
        }
        mant &= 0x3ff;
        return f32::from_bits((sign | (e << 23) | (mant << 13)));
    }
    if exp == 0x1f {
        return f32::from_bits((sign | 0x7f800000 | (mant << 13)));
    }
    exp = exp + (127 - 15);
    f32::from_bits((sign | (exp << 23) | (mant << 13)))
}

// --- tensors ----------------------------------------------------------

struct Tensor<A: Allocator> {
    vals: Vec<f32, A>,
    dim0: i64,
    dim1: i64,
}

fn parse_tensor(rd: &mut Cur<'_>, gpa: Gpa) -> Tensor<Gpa> {
    let mut vals: Vec<f32, Gpa> = Vec::new_in(gpa);
    let mut dim0: i64 = 0;
    let mut dim1: i64 = 0;
    let n = rd_map_len(rd);
    for _ in 0..n {
        let k = rd_str(rd);
        if eqs(k, b"param") {
            let m = rd_map_len(rd);
            let mut bytes: &[u8] = b"";
            for _ in 0..m {
                let pk = rd_str(rd);
                if eqs(pk, b"bytes") {
                    bytes = rd_bin(rd);
                } else if eqs(pk, b"shape") {
                    let ndims = rd_arr_len(rd);
                    if ndims > 0 {
                        dim0 = rd_int(rd);
                    }
                    if ndims > 1 {
                        dim1 = rd_int(rd);
                    }
                    for _ in 2..ndims {
                        skip(rd);
                    }
                } else {
                    skip(rd);
                }
            }
            let count = bytes.len() / 2;
            for k2 in 0..count {
                let lo = bytes[k2 * 2] as u32;
                let hi = bytes[k2 * 2 + 1] as u32;
                vals.push(f16_to_f32(lo | (hi << 8)));
            }
        } else {
            skip(rd);
        }
    }
    Tensor { vals: vals, dim0: dim0, dim1: dim1 }
}

fn parse_linear(rd: &mut Cur<'_>, gpa: Gpa) -> Linear<Gpa> {
    let mut l = empty_linear(gpa);
    let n = rd_map_len(rd);
    for _ in 0..n {
        let k = rd_str(rd);
        if eqs(k, b"weight") {
            let t = parse_tensor(rd, gpa);
            l.w = t.vals;
            l.in_dim = t.dim0;
            l.out_dim = t.dim1;
        } else if eqs(k, b"bias") {
            let t = parse_tensor(rd, gpa);
            l.b = t.vals;
            if l.out_dim == 0 {
                l.out_dim = t.dim0;
            }
        } else {
            skip(rd);
        }
    }
    l
}

/// Reads the checkpoint at `path` (its `.mpk` appended when the file is
/// not there, as Burn's recorder does).
pub fn load(path: &str, gpa: Gpa) -> Model<Gpa> {
    let mut bytes: Vec<u8, Gpa> = Vec::new_in(gpa);
    match std::fs::read_in(path, gpa) {
        Result::Ok(v) => bytes = v,
        Result::Err(_) => {
            let with_ext = format_in("{path}.mpk", gpa);
            match std::fs::read_in(with_ext.as_str(), gpa) {
                Result::Ok(v) => bytes = v,
                Result::Err(_) => {
                    panic("cannot read the model checkpoint");
                }
            }
        }
    }

    let mut rd = Cur { d: bytes.as_slice(), i: 0 };
    let mut fc1 = empty_linear(gpa);
    let mut fc2 = empty_linear(gpa);
    let mut fc3 = empty_linear(gpa);
    let mut trunk = empty_linear(gpa);
    let mut policy = empty_linear(gpa);
    let mut value = empty_linear(gpa);

    let n = rd_map_len(&mut rd);
    for _ in 0..n {
        let k = rd_str(&mut rd);
        if eqs(k, b"item") {
            let m = rd_map_len(&mut rd);
            for _ in 0..m {
                let name = rd_str(&mut rd);
                if eqs(name, b"fc1") {
                    fc1 = parse_linear(&mut rd, gpa);
                } else if eqs(name, b"fc2") {
                    fc2 = parse_linear(&mut rd, gpa);
                } else if eqs(name, b"fc3") {
                    fc3 = parse_linear(&mut rd, gpa);
                } else if eqs(name, b"trunk") {
                    trunk = parse_linear(&mut rd, gpa);
                } else if eqs(name, b"policy_head") {
                    policy = parse_linear(&mut rd, gpa);
                } else if eqs(name, b"value_head") {
                    value = parse_linear(&mut rd, gpa);
                } else {
                    skip(&mut rd);
                }
            }
        } else {
            skip(&mut rd);
        }
    }

    Model {
        fc1: fc1,
        fc2: fc2,
        fc3: fc3,
        trunk: trunk,
        policy: policy,
        value: value,
    }
}

// --- the network ------------------------------------------------------

fn linear_fwd(x: &[f32], l: &Linear<Gpa>, gpa: Gpa) -> Vec<f32, Gpa> {
    let mut out: Vec<f32, Gpa> = Vec::from_elem_in(0.0f32, l.out_dim as usize, gpa);
    for j in 0..l.out_dim {
        out[j as usize] = l.b[j as usize];
    }
    for i in 0..l.in_dim {
        let xi = x[i as usize];
        let base = i * l.out_dim;
        for j in 0..l.out_dim {
            out[j as usize] += xi * l.w[(base + j) as usize];
        }
    }
    out
}

fn relu(v: &mut Vec<f32, Gpa>) {
    for i in 0..v.len() {
        if v[i] < 0.0 {
            v[i] = 0.0;
        }
    }
}

fn softmax(logits: &[f32]) -> [f32; 18] {
    let mut mx = logits[0];
    for i in 1..NUM_ACTIONS {
        if logits[i as usize] > mx {
            mx = logits[i as usize];
        }
    }
    let mut out: [f32; 18] = [0.0; 18];
    let mut sum: f32 = 0.0;
    for i in 0..NUM_ACTIONS {
        let e = expf(logits[i as usize] - mx);
        out[i as usize] = e;
        sum += e;
    }
    let inv = 1.0 / sum;
    for i in 0..NUM_ACTIONS {
        out[i as usize] = out[i as usize] * inv;
    }
    out
}

/// The 18 action probabilities and the value estimate for one frame
/// pair.
pub fn forward(m: &Model<Gpa>, obs: &[f32], gpa: Gpa) -> Net {
    let mut h = linear_fwd(obs, &m.fc1, gpa);
    relu(&mut h);
    let mut h2 = linear_fwd(h.as_slice(), &m.fc2, gpa);
    relu(&mut h2);
    let mut h3 = linear_fwd(h2.as_slice(), &m.fc3, gpa);
    relu(&mut h3);
    let mut t = linear_fwd(h3.as_slice(), &m.trunk, gpa);
    relu(&mut t);
    let logits = linear_fwd(t.as_slice(), &m.policy, gpa);
    let v = linear_fwd(t.as_slice(), &m.value, gpa);
    let mut lg: [f32; 18] = [0.0; 18];
    for i in 0..NUM_ACTIONS {
        lg[i as usize] = logits[i as usize];
    }
    Net { probs: softmax(&lg), value: v[0] }
}

/// d(input) of W^T for `l`, given d(output).
fn mat_t_vec(l: &Linear<Gpa>, d_out: &[f32], gpa: Gpa) -> Vec<f32, Gpa> {
    let mut d: Vec<f32, Gpa> = Vec::from_elem_in(0.0f32, l.in_dim as usize, gpa);
    for i in 0..l.in_dim {
        let mut s: f32 = 0.0;
        let base = i * l.out_dim;
        for j in 0..l.out_dim {
            s += l.w[(base + j) as usize] * d_out[j as usize];
        }
        d[i as usize] = s;
    }
    d
}

fn relu_back(d: &mut Vec<f32, Gpa>, pre: &[f32]) {
    for i in 0..d.len() {
        if pre[i] <= 0.0 {
            d[i] = 0.0;
        }
    }
}

/// The gradient of the chosen action's log-probability with respect to
/// the stacked observation, one float per input.
pub fn saliency(m: &Model<Gpa>, obs: &[f32], action: i64, gpa: Gpa) -> Vec<f32, Gpa> {
    let mut z1 = linear_fwd(obs, &m.fc1, gpa);
    relu(&mut z1);
    let mut z2 = linear_fwd(z1.as_slice(), &m.fc2, gpa);
    relu(&mut z2);
    let mut z3 = linear_fwd(z2.as_slice(), &m.fc3, gpa);
    relu(&mut z3);
    let mut t = linear_fwd(z3.as_slice(), &m.trunk, gpa);
    relu(&mut t);
    let logits = linear_fwd(t.as_slice(), &m.policy, gpa);
    let mut lg: [f32; 18] = [0.0; 18];
    for i in 0..NUM_ACTIONS {
        lg[i as usize] = logits[i as usize];
    }
    let probs = softmax(&lg);

    // d(log softmax)/d(logits) = one-hot(action) - probs.
    let mut dlogits: Vec<f32, Gpa> = Vec::from_elem_in(0.0f32, NUM_ACTIONS as usize, gpa);
    for j in 0..NUM_ACTIONS {
        dlogits[j as usize] = -probs[j as usize];
    }
    dlogits[action as usize] += 1.0;

    let mut dt = mat_t_vec(&m.policy, dlogits.as_slice(), gpa);
    relu_back(&mut dt, t.as_slice());
    let mut dz3 = mat_t_vec(&m.trunk, dt.as_slice(), gpa);
    relu_back(&mut dz3, z3.as_slice());
    let mut dz2 = mat_t_vec(&m.fc3, dz3.as_slice(), gpa);
    relu_back(&mut dz2, z2.as_slice());
    let mut dz1 = mat_t_vec(&m.fc2, dz2.as_slice(), gpa);
    relu_back(&mut dz1, z1.as_slice());
    mat_t_vec(&m.fc1, dz1.as_slice(), gpa)
}

/// The `k` most likely actions by probability, best first.
pub fn top_k(probs: [f32; 18], k: i64) -> [i64; 3] {
    let mut idx: [i64; 3] = [0i64, 0, 0];
    for s in 0..k {
        let mut best: i64 = -1;
        let mut bestp: f32 = -1.0;
        for i in 0..NUM_ACTIONS {
            let mut used = false;
            for u in 0..s {
                if idx[u as usize] == i {
                    used = true;
                }
            }
            if !used && probs[i as usize] > bestp {
                bestp = probs[i as usize];
                best = i;
            }
        }
        idx[s as usize] = best;
    }
    idx
}
