// session.vl: a whole game as the client runs it — the simulation, the
// battle starfield behind it, and one composed 224×288 frame, exactly as
// neural-galaga-core's GameSession composes them (the starfield is drawn
// first, then every game pixel that is not transparent is copied over
// with a solid alpha).
//
// The Rust session also keeps forked snapshots; the client never uses
// them, so they are left out here.

use crate::draw::{Fb, GAME_H, GAME_W, fb_new};
use crate::game::{GameSim, STATUS_LOST, Step, sim_new};
use crate::render::{BattleStarfield, battle_starfield_new};

pub struct GameSession {
    sim: GameSim,
    starfield: BattleStarfield,
    pub fb: Fb,
    step_count: u64,
    last: Option<Step>,
}

pub fn session_new(seed: u64, wave: u32, gpa: Gpa) -> GameSession {
    GameSession {
        sim: sim_new(seed, wave, gpa),
        starfield: battle_starfield_new(gpa),
        fb: fb_new(GAME_W, GAME_H, gpa),
        step_count: 0,
        last: None,
    }
}

impl GameSession {
    /// One tick with the given action mask; returns that tick's result.
    pub fn step(inout self, actions: u32, gpa: Gpa) -> Step {
        let r = self.sim.step(actions, gpa);
        self.step_count += 1;

        self.fb.clear(3, 3, 8, 255);
        self.starfield.update(1.0 / 60.0);
        self.starfield.draw(&self.fb);

        for i in 0..self.fb.px.len() {
            let c = self.sim.fb.px[i];
            if ((c >> 24) & 0xffu32) != 0 {
                self.fb.px[i] = (c & 0x00ffffffu32) | 0xff000000u32;
            }
        }

        self.last = Some(r.clone());
        r
    }

    pub fn framebuffer(self) -> [u32] {
        self.fb.px.as_slice()
    }

    /// The game's own frame, before the starfield goes behind it (the
    /// check compares it with the Rust core's).
    pub fn game_framebuffer(self) -> [u32] {
        self.sim.fb.px.as_slice()
    }

    pub fn last_result(self) -> Option<Step> {
        self.last.clone()
    }

    pub fn last_score(self) -> i32 {
        match self.last {
            Option::Some(r) => r.score,
            Option::None => 0,
        }
    }

    pub fn is_done(self) -> bool {
        match self.last {
            Option::Some(r) => r.status == STATUS_LOST,
            Option::None => false,
        }
    }

    pub fn steps(self) -> u64 {
        self.step_count
    }
}
