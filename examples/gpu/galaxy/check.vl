// galaxy's self-check (check.vl): the same simulation run once on the
// GPU and once on the CPU from the same start, and one frame of the sky
// drawn into a surface with no window (RawSurface::Headless, what CI
// machines have) and read back.
//
// The CPU integrator is the kernel's arithmetic again, star by star in
// f32, double-buffered like the GPU (a sweep that updates in place reads
// half-updated neighbors and drifts line by whole partner terms — a
// reference bug that looks like GPU infidelity); a same-math GPU and CPU
// agree below a ten-thousandth of a star's scale, more means the two
// took different paths.
//
// The frame is checked for light where it must be: the pinned core sits
// at the center of the view (the camera looks at the origin), so the
// center ninth of the frame carries more light than the four corner
// ninths together. With --out the frame is written as a PPM to look at
// directly.

import "math.h" as c;

use std::{Gpa, fs, gpu};
use std::gpu::{BufferUsage, Format, RawSurface};

use physics::{G, SOFT, init_state};
use view::{CAM_DIST, CAM_PITCH, CAM_YAW, CAM_ZOOM, sky_new};

// One CPU step: the physics shader, star by star in f32. Reads the old
// state as a whole, writes the integrated one into its own side (the
// ping-pong the kernel does: no star may see another's new position —
// an in-place sweep reads half-updated neighbors and drifts from the
// GPU line by whole partner terms).
fn cpu_step(state: inout Vec<f32>, n: i64, dt: f32, drag: f32) {
    let g = G as f32;
    let soft = SOFT as f32;
    var next = state.clone();
    for i in 0..n {
        let b = i * 8;
        var ax: f32 = 0.0;
        var ay: f32 = 0.0;
        var az: f32 = 0.0;
        let sx = state[b];
        let sy = state[b + 1];
        let sz = state[b + 2];
        for j in 0..n {
            let q = j * 8;
            let dx = state[q] - sx;
            let dy = state[q + 1] - sy;
            let dz = state[q + 2] - sz;
            let r2 = dx * dx + dy * dy + dz * dz + soft;
            let rs = unsafe { c::sqrt(r2 as f64) as f32 };
            let w = g * state[q + 3] / (r2 * rs);
            ax = ax + dx * w;
            ay = ay + dy * w;
            az = az + dz * w;
        }
        let vx = (state[b + 4] + ax * dt) * drag;
        let vy = (state[b + 5] + ay * dt) * drag;
        let vz = (state[b + 6] + az * dt) * drag;
        var x = sx + vx * dt;
        var y = sy + vy * dt;
        var z = sz + vz * dt;
        if i == 0 {
            x = 0.0;
            y = 0.0;
            z = 0.0;
        }
        next[b] = x;
        next[b + 1] = y;
        next[b + 2] = z;
        next[b + 4] = vx;
        next[b + 5] = vy;
        next[b + 6] = vz;
    }
    for k in 0..n * 8 {
        state[k] = next[k];
    }
}

// A BGRA frame as a PPM (P6): a readback's rows come with their 256-byte
// stride, so the pixels are picked on it.
fn write_ppm(path: [u8], px: [u8], w: i64, h: i64, stride: i64, gpa: Gpa) -> bool {
    var ppm = format_in("P6\n{w} {h}\n255\n", gpa);
    for y in 0..h {
        let row = y * stride;
        for x in 0..w {
            let p = row + x * 4;
            ppm.push(px[p + 2]);
            ppm.push(px[p + 1]);
            ppm.push(px[p]);
        }
    }
    fs::write(path, ppm.as_slice()).is_ok()
}

// The headless run: `stars` stars, `steps` steps of the physics, the CPU
// reference to compare against, then one frame of the sky read back.
// Prints a line per check; 0 when all pass, 1 otherwise.
pub fn run(stars: i64, steps: i64, seed: u64, w: i64, h: i64, out: [u8], gpa: Gpa) -> i32 {
    println("galaxy {stars} stars, {steps} steps");
    let inst = gpu::Instance::new_in(gpa);
    let opened = match inst.adapter() {
        Ok(a) => a.device(),
        Err(e) => Err(e),
    };
    let (dev, var queue) = match opened {
        Ok(pair) => pair,
        Err(e) => {
            eprintln("galaxy: no GPU: {e}");
            return 1;
        }
    };
    var galaxy = match physics::galaxy_new(dev, stars, seed, gpa) {
        Ok(built) => built,
        Err(e) => {
            eprintln("galaxy: the physics: {e}");
            return 1;
        }
    };
    let dt = (1.0 / 60.0) as f32;
    for _ in 0..steps {
        galaxy.step(dev, &queue, dt, 1.0);
    }

    // the same steps, on the CPU, from the same start
    var cpu_state = init_state(stars, seed, gpa);
    for _ in 0..steps {
        cpu_step(&cpu_state, stars, dt, 1.0);
    }
    let state_bytes = stars * 32;
    var stage = dev.buffer(state_bytes, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let current = galaxy.buf[galaxy.cur];
    var copy_enc = dev.encoder();
    copy_enc.copy_buffer(current, 0, stage, 0, state_bytes);
    queue.submit(copy_enc.finish());
    let gpu_state = gpu::f32s(stage.map_read(dev));
    var worst: f64 = 0.0;
    for i in 0..stars {
        let p = i * 8;
        for k in 0..3 {
            let a = gpu_state[p + k] as f64;
            let b = cpu_state[p + k] as f64;
            let e = unsafe { c::fabs(a - b) / (1.0 + c::fabs(b)) };
            if e > worst {
                worst = e;
            }
        }
    }
    if worst < 4.0e-3 {
        println("physics ok");
    } else {
        println("physics FAIL (worst {worst:.6})");
    }

    // one frame of the last state, into a surface with no window
    var sky = match sky_new(dev, galaxy) {
        Ok(renderer) => renderer,
        Err(e) => {
            eprintln("galaxy: the view: {e}");
            return 1;
        }
    };
    var surf = match inst.surface(dev, RawSurface::Headless) {
        Ok(headless) => headless,
        Err(e) => {
            eprintln("galaxy: no surface: {e}");
            return 1;
        }
    };
    surf.configure(dev, w, h, format: Format::Bgra8Unorm, vsync: false);
    let frame = match surf.frame() {
        Ok(shown) => shown,
        Err(e) => {
            eprintln("galaxy: no frame: {e}");
            return 1;
        }
    };
    let texview = frame.texture.view();
    sky.draw(dev, &queue, texview, galaxy.cur, stars, w, h,
        CAM_YAW, CAM_PITCH, CAM_DIST, CAM_ZOOM);
    let stride = (w * 4 + 255) / 256 * 256;
    var readback = dev.buffer(stride * h, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    var frame_enc = dev.encoder();
    frame_enc.copy_texture_to_buffer(frame.texture, readback, stride);
    queue.submit(frame_enc.finish());
    let px = readback.map_read(dev);

    // the frame: how many pixels carry light, and how bright the center
    // is next to the corners: the camera looks at the origin, where the
    // pinned core sits, so the center ninth out-shines every corner
    var lit: i64 = 0;
    var mid: i64 = 0;
    var corners: i64 = 0;
    for y in 0..h {
        for x in 0..w {
            let pixel = y * stride + x * 4;
            let lum = px[pixel] as i64 + px[pixel + 1] as i64 + px[pixel + 2] as i64;
            if lum > 0 {
                lit += 1;
            }
            let mx = x * 3 >= w && x * 3 < 2 * w;
            let my = y * 3 >= h && y * 3 < 2 * h;
            if mx && my {
                mid += lum;
            } else if !mx && !my {
                corners += lum;
            }
        }
    }
    // the center ninth's per-pixel light against the corners' (the
    // corners hold about twice its pixels, so twice the total is level)
    let ok_render = lit > 0 && mid * 2 > corners;
    if out.len() > 0 {
        if write_ppm(out, px, w, h, stride, gpa) {
            println("wrote {out}");
        } else {
            eprintln("galaxy: cannot write {out}");
            return 1;
        }
    }
    if ok_render {
        println("render ok");
    } else {
        println("render FAIL ({lit} lit, center {mid}, corners {corners})");
    }
    if worst < 4.0e-3 && ok_render {
        return 0;
    }
    1
}
