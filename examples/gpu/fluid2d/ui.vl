// The overlay: a small panel of text cells in the top-left corner, drawn
// by the render shader (the glyphs from font.vl, a 5 x 7 bitmap font
// scaled by whole pixels so it stays crisp). Compact, it shows the frame
// rate, the view and whether the simulation is paused; expanded (`?` or
// Tab), the grid, the settings with their [-] and [+] buttons, and the
// keys. The CPU writes the cells (a character and a colour each) a few
// times a second; the buttons are hit-tested here. Nothing here
// allocates: the text is a fixed array.

// The cells' grid (the expanded panel's size); a row is COLS cells.
pub const COLS: i64 = 24;
pub const ROWS: i64 = 13;
const COMPACT_COLS: i64 = 19;
const COMPACT_ROWS: i64 = 2;

// A cell is 6 x 8 font pixels (a glyph and its spacing); the panel has a
// margin of 2 font pixels.
const CELL_W: f64 = 6.0;
const CELL_H: f64 = 8.0;
const MARGIN: f64 = 2.0;

// Colours (the shader's palette).
pub const TEXT: u32 = 0;
pub const DIM: u32 = 1;
pub const ACCENT: u32 = 2;
pub const WARN: u32 = 3;
pub const HEAD: u32 = 4;

// A cell filled with the brush's colour.
pub const SWATCH: u8 = 1;

// The modes.
pub const COMPACT: i64 = 0;
pub const EXPANDED: i64 = 1;
pub const HIDDEN: i64 = 2;

// The settings, a row each from CONTROL_ROW, with their [-] and [+].
pub const JACOBI: i64 = 0;
pub const VORTICITY: i64 = 1;
pub const BRUSH: i64 = 2;
pub const FADE: i64 = 3;
const CONTROL_ROW: i64 = 4;
const MINUS_COL: i64 = 10;
const PLUS_COL: i64 = 19;

// v in decimal at the end of `out`; where it starts.
fn fmt_i64(v: i64, out: &mut [u8; 20]) -> i64 {
    let mut u = if v < 0 { (-(v + 1)) as u64 + 1 } else { v as u64 };
    let mut at: usize = 20;
    loop {
        at -= 1;
        out[at] = b'0' + (u % 10) as u8;
        u /= 10;
        if u == 0 {
            break;
        }
    }
    if v < 0 {
        at -= 1;
        out[at] = b'-';
    }
    at as i64
}

pub const VIEWS: [&[u8]; 4] = [b"dye", b"velocity", b"pressure", b"curl"];
pub const BRUSH_NAMES: [&[u8]; 7] = [b"rainbow", b"red", b"orange", b"yellow", b"green", b"blue",
    b"violet"];

// What the panel shows.
pub struct Status {
    pub fps: f64,
    pub ms: f64,
    pub w: i64,
    pub h: i64,
    pub iters: i64,
    pub view: i64,
    pub brush: i64,
    pub paused: bool,
    pub jets: bool,
    pub vorticity: f64,
    pub size: i64,
    pub fade: f64,
}

pub struct Overlay {
    pub cells: [u32; 312],
    pub mode: i64,
    // the mode `h` shows again
    shown_mode: i64,
}

// Where the panel's text starts, in pixels, and the size of a font pixel
// (whole pixels: one a point, so a glyph is 7 points high).
#[derive(Clone, Copy)]
pub struct Place {
    pub x: f64,
    pub y: f64,
    pub px: f64,
}

#[pure]
pub fn place(scale: f64) -> Place {
    let mut px = (scale + 0.5) as i64 as f64;
    if px < 1.0 {
        px = 1.0;
    }
    Place { x: 6.0 * px, y: 6.0 * px, px: px }
}

// The control and the step (-1 or +1) of a click at (x, y) in pixels,
// (-1, 0) on the panel elsewhere, None off the panel (or with it hidden).
#[pure]
pub fn hit(o: &Overlay, at: Place, x: f64, y: f64) -> Option<(i64, i64)> {
    if o.mode == HIDDEN {
        return None;
    }
    let fx = (x - at.x) / at.px;
    let fy = (y - at.y) / at.px;
    let w = o.cols() as f64 * CELL_W;
    let h = o.rows() as f64 * CELL_H;
    if fx < -MARGIN || fy < -MARGIN || fx > w + MARGIN || fy > h + MARGIN {
        return None;
    }
    if o.mode != EXPANDED || fx < 0.0 || fy < 0.0 {
        return Some((-1i64, 0i64));
    }
    let col = (fx / CELL_W) as i64;
    let k = (fy / CELL_H) as i64 - CONTROL_ROW;
    if k >= 0 && k <= FADE {
        if col >= MINUS_COL && col < MINUS_COL + 3 {
            return Some((k, -1i64));
        }
        if col >= PLUS_COL && col < PLUS_COL + 3 {
            return Some((k, 1i64));
        }
    }
    Some((-1i64, 0i64))
}

impl Overlay {
    pub fn new() -> Overlay {
        Overlay { cells: [32; 312], mode: COMPACT, shown_mode: COMPACT }
    }

    // The panel's size in cells.
    pub fn cols(&self) -> i64 {
        if self.mode == EXPANDED { COLS } else { COMPACT_COLS }
    }

    pub fn rows(&self) -> i64 {
        if self.mode == EXPANDED { ROWS } else { COMPACT_ROWS }
    }

    // `?` or Tab: compact <-> expanded.
    pub fn toggle(&mut self) {
        self.mode = if self.mode == EXPANDED { COMPACT } else { EXPANDED };
        self.shown_mode = self.mode;
    }

    // `h`: hidden <-> shown.
    pub fn hide(&mut self) {
        self.mode = if self.mode == HIDDEN { self.shown_mode } else { HIDDEN };
    }

    // Text at (row, col) in a colour; the column after it.
    pub fn put(&mut self, row: i64, col: i64, s: &[u8], color: u32) -> i64 {
        let mut c = col;
        for &b in s {
            if c >= 0 && c < COLS && row >= 0 && row < ROWS {
                self.cells[(row * COLS + c) as usize] = (b as u32) | (color << 8);
            }
            c += 1;
        }
        c
    }

    // v right-aligned in `width` columns from col.
    pub fn put_int(&mut self, row: i64, col: i64, v: i64, width: i64, color: u32) -> i64 {
        let mut digits: [u8; 20] = [0; 20];
        let start = fmt_i64(v, &mut digits);
        let n = 20 - start;
        let pad: i64 = if width > n { width - n } else { 0 };
        self.put(row, col + pad, &digits[start as usize..20], color)
    }

    // v (>= 0) with `dec` decimals (1 or more), right-aligned in `width`
    // columns from col.
    pub fn put_fixed(&mut self, row: i64, col: i64, v: f64, dec: i64, width: i64, color: u32)
        -> i64 {
        let mut scale: i64 = 1;
        for _ in 0..dec {
            scale *= 10;
        }
        let n = (if v < 0.0 { 0.0 } else { v } * scale as f64 + 0.5) as i64;
        let mut digits: [u8; 20] = [0; 20];
        let start = fmt_i64(n / scale, &mut digits);
        let mut text: [u8; 32] = [32; 32];
        let mut len: i64 = 0;
        for i in start..20 {
            text[len as usize] = digits[i as usize];
            len += 1;
        }
        text[len as usize] = b'.';
        len += 1;
        let mut frac = n % scale;
        let mut div = scale / 10;
        for _ in 0..dec {
            text[len as usize] = b'0' + (frac / div) as u8;
            frac = frac % div;
            div = div / 10;
            len += 1;
        }
        let pad: i64 = if width > len { width - len } else { 0 };
        self.put(row, col + pad, &text[0..len as usize], color)
    }

    // The panel for `st`, in the current mode.
    pub fn compose(&mut self, st: Status) {
        // (A workaround: clearing the cells with a loop of u32 stores runs
        // off the end of the array at -O2, the unrolled vector loop's exit
        // test being an equality against a bound that is not a multiple of
        // its step: the loop-unroll remainder bug, branch loop252, repro
        // tests/run/opt_loop_unroll_remainder_510.vl. A whole-array store
        // has no loop of ours.)
        self.cells = [32; 312];
        let mut c = self.put_int(0, 0, (st.fps + 0.5) as i64, 3, ACCENT);
        c = self.put(0, c, b" fps ", DIM);
        c = self.put_fixed(0, c, st.ms, 2, 5, ACCENT);
        self.put(0, c, b" ms", DIM);
        if self.mode != EXPANDED {
            self.put(0, 18, b"?", DIM);
            c = self.put(1, 0, VIEWS[st.view as usize], TEXT);
            self.cells[(COLS + c + 1) as usize] = SWATCH as u32;
            self.cells[(COLS + c + 2) as usize] = SWATCH as u32;
            if st.paused {
                self.put(1, c + 4, b"paused", WARN);
            }
            return;
        }
        if st.paused {
            self.put(0, 18, b"paused", WARN);
        }
        c = self.put_int(1, 0, st.w, 1, TEXT);
        c = self.put(1, c, b"x", DIM);
        c = self.put_int(1, c, st.h, 1, TEXT);
        self.put(1, c + 1, b"cells", DIM);
        if !st.jets {
            self.put(1, 16, b"jets off", DIM);
        }
        self.put(2, 0, b"view", DIM);
        self.put(2, 7, VIEWS[st.view as usize], ACCENT);
        self.put(3, 0, b"brush", DIM);
        self.cells[(3 * COLS + 7) as usize] = SWATCH as u32;
        self.cells[(3 * COLS + 8) as usize] = SWATCH as u32;
        self.put(3, 10, BRUSH_NAMES[st.brush as usize], TEXT);
        let labels: [&[u8]; 4] = [b"jacobi", b"vorticity", b"size", b"fade"];
        for k in 0..4 {
            let row = CONTROL_ROW + k;
            self.put(row, 0, labels[k as usize], DIM);
            self.put(row, MINUS_COL, b"[-]", ACCENT);
            self.put(row, PLUS_COL, b"[+]", ACCENT);
        }
        self.put_int(CONTROL_ROW, MINUS_COL + 3, st.iters, 5, TEXT);
        self.put_int(CONTROL_ROW + 1, MINUS_COL + 3, (st.vorticity + 0.5) as i64, 5, TEXT);
        self.put_int(CONTROL_ROW + 2, MINUS_COL + 3, st.size, 5, TEXT);
        self.put_fixed(CONTROL_ROW + 3, MINUS_COL + 3, st.fade, 2, 5, TEXT);
        self.keys(8, b"drag", b"stir", b"right", b"push");
        self.keys(9, b"space", b"pause", b"r", b"reset");
        self.keys(10, b"v 1-4", b"view", b"c", b"colour");
        self.keys(11, b"e", b"jets", b"b", b"glow");
        self.keys(12, b"?", b"less", b"h", b"hide");
    }

    // A row of two keys and what they do.
    fn keys(&mut self, row: i64, k1: &[u8], d1: &[u8], k2: &[u8], d2: &[u8]) {
        let mut c = self.put(row, 0, k1, ACCENT);
        self.put(row, c + 1, d1, TEXT);
        c = self.put(row, 13, k2, ACCENT);
        self.put(row, c + 1, d2, TEXT);
    }
}
