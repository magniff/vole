// The WGSL of fluid2d, as `embed wgsl` blocks: `volec check` checks each
// kernel's module. Each kernel is its own shader: its parts (`with`):
// COMMON (the parameters and the grid's indexing) and the helpers it
// uses, then its own bindings and entry point. K.src is the whole module,
// K.main its entry point.
//
// The grid is a MAC grid of W x H cells, y down: the pressure, the
// divergence, the curl and the dye at cell centres; u (the x velocity) on
// the vertical faces, (W + 1) x H of them, v on the horizontal ones,
// W x (H + 1). Face u(i, j) sits at (i, j + 0.5), v(i, j) at (i + 0.5, j),
// cell (i, j)'s centre at (i + 0.5, j + 0.5). Velocities are in cells
// per second. Walls on all four sides: the faces on the border stay 0.

// The parameters (sim.vl's `Params`, written once a frame) and the
// index of a cell or face, clamped to the grid.
pub embed wgsl COMMON {
    struct Splat {
        seg: vec4<f32>,
        force: vec4<f32>,
        color: vec4<f32>,
    }
    struct Params {
        w: u32, h: u32, n_splats: u32, view: u32,
        dt: f32, time: f32, vorticity: f32, dye_keep: f32,
        vel_keep: f32, emit: f32, sw: f32, sh: f32,
        bloom: f32, shade: f32, jet_speed: f32, r1: f32,
        splats: array<Splat, 2>,
        ui: vec4<f32>,
        ui2: vec4<f32>,
        brush: vec4<f32>,
    }
    @group(0) @binding(0) var<uniform> prm: Params;
    const TAU: f32 = 6.2831853;
    fn gw() -> i32 { return i32(prm.w); }
    fn gh() -> i32 { return i32(prm.h); }
    fn cell(i: i32, j: i32) -> u32 {
        return u32(clamp(j, 0, gh() - 1) * gw() + clamp(i, 0, gw() - 1));
    }
    fn uface(i: i32, j: i32) -> u32 {
        return u32(clamp(j, 0, gh() - 1) * (gw() + 1) + clamp(i, 0, gw()));
    }
    fn vface(i: i32, j: i32) -> u32 {
        return u32(clamp(j, 0, gh()) * gw() + clamp(i, 0, gw() - 1));
    }
    fn hue(h: f32) -> vec3<f32> {
        let k = vec3<f32>(0.0, 2.0 / 3.0, 1.0 / 3.0);
        let x = abs(fract(vec3<f32>(h, h, h) + k) * 6.0 - 3.0) - 1.0;
        return clamp(x, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));
    }
}

// Bilinear samples of u and v (globals `uf` and `vf`), the velocity at a
// point, and the semi-Lagrangian backtrace from a point (second-order
// Runge-Kutta), kept inside the walls.
pub embed wgsl SAMPLE_VEL {
    fn sample_u(p: vec2<f32>) -> f32 {
        let q = p - vec2<f32>(0.0, 0.5);
        let b = floor(q);
        let t = q - b;
        let i = i32(b.x);
        let j = i32(b.y);
        let a = mix(uf[uface(i, j)], uf[uface(i + 1, j)], t.x);
        let c = mix(uf[uface(i, j + 1)], uf[uface(i + 1, j + 1)], t.x);
        return mix(a, c, t.y);
    }
    fn sample_v(p: vec2<f32>) -> f32 {
        let q = p - vec2<f32>(0.5, 0.0);
        let b = floor(q);
        let t = q - b;
        let i = i32(b.x);
        let j = i32(b.y);
        let a = mix(vf[vface(i, j)], vf[vface(i + 1, j)], t.x);
        let c = mix(vf[vface(i, j + 1)], vf[vface(i + 1, j + 1)], t.x);
        return mix(a, c, t.y);
    }
    fn vel(p: vec2<f32>) -> vec2<f32> { return vec2<f32>(sample_u(p), sample_v(p)); }
    fn backtrace(p: vec2<f32>) -> vec2<f32> {
        let mid = p - 0.5 * prm.dt * vel(p);
        let q = p - prm.dt * vel(mid);
        return clamp(q, vec2<f32>(0.0, 0.0), vec2<f32>(f32(prm.w), f32(prm.h)));
    }
}

// The sources: the demo's three jets (`prm.emit` from 0 to 1), circling
// the centre and swinging, each with its own slowly turning hue; and up
// to two splats from the mouse, each a stroke from seg.xy to seg.zw with
// a force (cells per second, added once) and a colour (alpha: how much).
pub embed wgsl SOURCES {
    fn jet_angle(k: f32) -> f32 { return prm.time * 0.23 + k * TAU / 3.0; }
    fn jet_pos(k: f32) -> vec2<f32> {
        let a = jet_angle(k);
        let c = vec2<f32>(f32(prm.w), f32(prm.h)) * 0.5;
        let r = 0.33 * f32(min(prm.w, prm.h));
        return c + r * vec2<f32>(cos(a), sin(a));
    }
    fn jet_vel(k: f32) -> vec2<f32> {
        let d = jet_angle(k) + 3.14159 + 0.55 + 0.75 * sin(prm.time * 0.61 + k * 2.3);
        return prm.jet_speed * f32(prm.h) * vec2<f32>(cos(d), sin(d));
    }
    fn jet_radius() -> f32 { return 0.011 * f32(prm.h); }
    fn jet_color(k: f32) -> vec3<f32> {
        let t = k / 3.0 + prm.time * 0.017;
        return 0.85 * (vec3<f32>(0.5, 0.5, 0.5) + 0.5 * cos(TAU * (vec3<f32>(t, t, t) + vec3<f32>(0.0, 0.33, 0.67))));
    }
    fn jet_weight(p: vec2<f32>, k: f32) -> f32 {
        let d = p - jet_pos(k);
        let r = jet_radius();
        return prm.emit * exp(-dot(d, d) / (r * r));
    }
    fn splat_weight(p: vec2<f32>, s: u32) -> f32 {
        let a = prm.splats[s].seg.xy;
        let ab = prm.splats[s].seg.zw - a;
        let l = dot(ab, ab);
        var t = 0.0;
        if l > 0.000001 { t = clamp(dot(p - a, ab) / l, 0.0, 1.0); }
        let d = p - (a + ab * t);
        let r = prm.splats[s].force.z;
        return exp(-dot(d, d) / (r * r));
    }
    fn add_vel(p: vec2<f32>, x0: vec2<f32>) -> vec2<f32> {
        var x = x0;
        if prm.emit > 0.0 {
            for (var k = 0; k < 3; k++) {
                let g = jet_weight(p, f32(k));
                x = mix(x, jet_vel(f32(k)), min(g * 0.5, 1.0));
            }
        }
        for (var s = 0u; s < prm.n_splats; s++) {
            x = x + splat_weight(p, s) * prm.splats[s].force.xy;
        }
        return x;
    }
    fn add_dye(p: vec2<f32>, d0: vec3<f32>) -> vec3<f32> {
        var d = d0;
        if prm.emit > 0.0 {
            for (var k = 0; k < 3; k++) {
                let g = jet_weight(p, f32(k));
                d = mix(d, jet_color(f32(k)), min(g * 0.3, 1.0));
            }
        }
        for (var s = 0u; s < prm.n_splats; s++) {
            let g = splat_weight(p, s) * prm.splats[s].color.w;
            d = mix(d, prm.splats[s].color.xyz, min(g, 1.0));
        }
        return d;
    }
}

// Advection of the velocity, and the forces: each face's value is the
// velocity found where the flow carries from, plus the sources there.
pub embed wgsl ADVECT_VEL with COMMON, SAMPLE_VEL, SOURCES {
    @group(0) @binding(1) var<storage, read> uf: array<f32>;
    @group(0) @binding(2) var<storage, read> vf: array<f32>;
    @group(0) @binding(3) var<storage, read_write> u_out: array<f32>;
    @group(0) @binding(4) var<storage, read_write> v_out: array<f32>;
    @compute @workgroup_size(8, 8)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        let i = i32(id.x);
        let j = i32(id.y);
        if i <= gw() && j < gh() {
            var x = 0.0;
            if i > 0 && i < gw() {
                let p = vec2<f32>(f32(i), f32(j) + 0.5);
                let b = backtrace(p);
                x = add_vel(p, vec2<f32>(sample_u(b), 0.0) * prm.vel_keep).x;
            }
            u_out[uface(i, j)] = x;
        }
        if i < gw() && j <= gh() {
            var y = 0.0;
            if j > 0 && j < gh() {
                let p = vec2<f32>(f32(i) + 0.5, f32(j));
                let b = backtrace(p);
                y = add_vel(p, vec2<f32>(0.0, sample_v(b)) * prm.vel_keep).y;
            }
            v_out[vface(i, j)] = y;
        }
    }
}

// The curl (vorticity) at each cell centre, from the centred velocities.
pub embed wgsl CURL with COMMON {
    @group(0) @binding(1) var<storage, read> uf: array<f32>;
    @group(0) @binding(2) var<storage, read> vf: array<f32>;
    @group(0) @binding(3) var<storage, read_write> curl: array<f32>;
    fn uc(i: i32, j: i32) -> f32 { return 0.5 * (uf[uface(i, j)] + uf[uface(i + 1, j)]); }
    fn vc(i: i32, j: i32) -> f32 { return 0.5 * (vf[vface(i, j)] + vf[vface(i, j + 1)]); }
    @compute @workgroup_size(8, 8)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        let i = i32(id.x);
        let j = i32(id.y);
        if i < gw() && j < gh() {
            curl[cell(i, j)] = 0.5 * ((vc(i + 1, j) - vc(i - 1, j)) - (uc(i, j + 1) - uc(i, j - 1)));
        }
    }
}

// Vorticity confinement (Fedkiw, Stam and Jensen): a force at each cell
// along N x w, N the direction in which |curl| grows, added to the faces
// beside it. It gives back the small swirls the grid smooths away.
pub embed wgsl CONFINE with COMMON {
    @group(0) @binding(1) var<storage, read> curl: array<f32>;
    @group(0) @binding(2) var<storage, read_write> u_io: array<f32>;
    @group(0) @binding(3) var<storage, read_write> v_io: array<f32>;
    fn force(i: i32, j: i32) -> vec2<f32> {
        let w = curl[cell(i, j)];
        let gx = 0.5 * (abs(curl[cell(i + 1, j)]) - abs(curl[cell(i - 1, j)]));
        let gy = 0.5 * (abs(curl[cell(i, j + 1)]) - abs(curl[cell(i, j - 1)]));
        let n = vec2<f32>(gx, gy) / (length(vec2<f32>(gx, gy)) + 0.00001);
        return prm.vorticity * w * vec2<f32>(n.y, -n.x);
    }
    @compute @workgroup_size(8, 8)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        let i = i32(id.x);
        let j = i32(id.y);
        if i > 0 && i < gw() && j < gh() {
            let k = uface(i, j);
            u_io[k] = u_io[k] + prm.dt * 0.5 * (force(i - 1, j).x + force(i, j).x);
        }
        if i < gw() && j > 0 && j < gh() {
            let k = vface(i, j);
            v_io[k] = v_io[k] + prm.dt * 0.5 * (force(i, j - 1).y + force(i, j).y);
        }
    }
}

// The divergence of each cell: what flows out of it through its four
// faces (cells per second, per cell).
pub embed wgsl DIVERGENCE with COMMON {
    @group(0) @binding(1) var<storage, read> uf: array<f32>;
    @group(0) @binding(2) var<storage, read> vf: array<f32>;
    @group(0) @binding(3) var<storage, read_write> div: array<f32>;
    @compute @workgroup_size(8, 8)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        let i = i32(id.x);
        let j = i32(id.y);
        if i < gw() && j < gh() {
            div[cell(i, j)] = uf[uface(i + 1, j)] - uf[uface(i, j)] + vf[vface(i, j + 1)] - vf[vface(i, j)];
        }
    }
}

// One Jacobi iteration of the pressure equation, sum over the neighbours
// n of (p[n] - p) = div: a wall is no neighbour (its face's velocity is
// fixed at 0), which is the Neumann condition.
pub embed wgsl JACOBI with COMMON {
    @group(0) @binding(1) var<storage, read> p_in: array<f32>;
    @group(0) @binding(2) var<storage, read> div: array<f32>;
    @group(0) @binding(3) var<storage, read_write> p_out: array<f32>;
    @compute @workgroup_size(8, 8)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        let i = i32(id.x);
        let j = i32(id.y);
        if i < gw() && j < gh() {
            var s = 0.0;
            var n = 0.0;
            if i > 0 { s += p_in[cell(i - 1, j)]; n += 1.0; }
            if i < gw() - 1 { s += p_in[cell(i + 1, j)]; n += 1.0; }
            if j > 0 { s += p_in[cell(i, j - 1)]; n += 1.0; }
            if j < gh() - 1 { s += p_in[cell(i, j + 1)]; n += 1.0; }
            p_out[cell(i, j)] = (s - div[cell(i, j)]) / max(n, 1.0);
        }
    }
}

// The projection: each inner face's velocity minus the pressure's
// difference across it; what is left has no divergence (as far as the
// pressure has converged).
pub embed wgsl PROJECT with COMMON {
    @group(0) @binding(1) var<storage, read> uf: array<f32>;
    @group(0) @binding(2) var<storage, read> vf: array<f32>;
    @group(0) @binding(3) var<storage, read> pr: array<f32>;
    @group(0) @binding(4) var<storage, read_write> u_out: array<f32>;
    @group(0) @binding(5) var<storage, read_write> v_out: array<f32>;
    @compute @workgroup_size(8, 8)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        let i = i32(id.x);
        let j = i32(id.y);
        if i <= gw() && j < gh() {
            var x = 0.0;
            if i > 0 && i < gw() { x = uf[uface(i, j)] - (pr[cell(i, j)] - pr[cell(i - 1, j)]); }
            u_out[uface(i, j)] = x;
        }
        if i < gw() && j <= gh() {
            var y = 0.0;
            if j > 0 && j < gh() { y = vf[vface(i, j)] - (pr[cell(i, j)] - pr[cell(i, j - 1)]); }
            v_out[vface(i, j)] = y;
        }
    }
}

// A bilinear sample of the dye (global `dye_in`, at cell centres).
pub embed wgsl SAMPLE_DYE {
    fn sample_dye(p: vec2<f32>) -> vec3<f32> {
        let q = p - vec2<f32>(0.5, 0.5);
        let b = floor(q);
        let t = q - b;
        let i = i32(b.x);
        let j = i32(b.y);
        let a = mix(dye_in[cell(i, j)].xyz, dye_in[cell(i + 1, j)].xyz, t.x);
        let c = mix(dye_in[cell(i, j + 1)].xyz, dye_in[cell(i + 1, j + 1)].xyz, t.x);
        return mix(a, c, t.y);
    }
}

// Advection of the dye by the projected velocity, and the sources' dye.
pub embed wgsl ADVECT_DYE with COMMON, SAMPLE_VEL, SOURCES, SAMPLE_DYE {
    @group(0) @binding(1) var<storage, read> uf: array<f32>;
    @group(0) @binding(2) var<storage, read> vf: array<f32>;
    @group(0) @binding(3) var<storage, read> dye_in: array<vec4<f32>>;
    @group(0) @binding(4) var<storage, read_write> dye_out: array<vec4<f32>>;
    @compute @workgroup_size(8, 8)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        let i = i32(id.x);
        let j = i32(id.y);
        if i < gw() && j < gh() {
            let p = vec2<f32>(f32(i) + 0.5, f32(j) + 0.5);
            let d = sample_dye(backtrace(p)) * prm.dye_keep;
            dye_out[cell(i, j)] = vec4<f32>(add_dye(p, d), 0.0);
        }
    }
}

// The glow: the dye's bright parts, a quarter of the grid each way.
pub embed wgsl BLOOM with COMMON {
    @group(0) @binding(1) var<storage, read> dye_in: array<vec4<f32>>;
    @group(0) @binding(2) var<storage, read_write> glow: array<vec4<f32>>;
    @compute @workgroup_size(8, 8)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        let bw = (gw() + 3) / 4;
        let bh = (gh() + 3) / 4;
        let i = i32(id.x);
        let j = i32(id.y);
        if i < bw && j < bh {
            var c = vec3<f32>(0.0, 0.0, 0.0);
            for (var b = 0; b < 4; b++) {
                for (var a = 0; a < 4; a++) {
                    c += dye_in[cell(i * 4 + a, j * 4 + b)].xyz;
                }
            }
            let t = vec3<f32>(1.0, 1.0, 1.0) - exp(-2.0 * c / 16.0);
            let m = max(t.x, max(t.y, t.z));
            glow[u32(j * bw + i)] = vec4<f32>(t * smoothstep(0.25, 0.9, m), 0.0);
        }
    }
}

// A 9-tap Gaussian blur of the glow along DIR, a part: BLUR_X and BLUR_Y
// declare DIR (WGSL's module scope is in no order) and are its kernels.
pub embed wgsl BLUR with COMMON {
    @group(0) @binding(1) var<storage, read> g_in: array<vec4<f32>>;
    @group(0) @binding(2) var<storage, read_write> g_out: array<vec4<f32>>;
    fn at(i: i32, j: i32, bw: i32, bh: i32) -> vec3<f32> {
        return g_in[u32(clamp(j, 0, bh - 1) * bw + clamp(i, 0, bw - 1))].xyz;
    }
    @compute @workgroup_size(8, 8)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        let bw = (gw() + 3) / 4;
        let bh = (gh() + 3) / 4;
        let i = i32(id.x);
        let j = i32(id.y);
        if i < bw && j < bh {
            let wt = array<f32, 5>(0.2270270, 0.1945946, 0.1216216, 0.0540541, 0.0162162);
            var c = at(i, j, bw, bh) * wt[0];
            for (var k = 1; k < 5; k++) {
                let o = DIR * k * 2;
                c += (at(i + o.x, j + o.y, bw, bh) + at(i - o.x, j - o.y, bw, bh)) * wt[k];
            }
            g_out[u32(j * bw + i)] = vec4<f32>(c, 0.0);
        }
    }
}

pub embed wgsl BLUR_X with BLUR {
    const DIR: vec2<i32> = vec2<i32>(1, 0);
}

pub embed wgsl BLUR_Y with BLUR {
    const DIR: vec2<i32> = vec2<i32>(0, 1);
}

// The picture: a triangle over the window; each pixel samples the grid
// (bilinear, so the dye is smooth at any window size). Views: 0 the dye,
// lit as a height field, with its glow; 1 the velocity, hue from its
// direction and brightness from its speed; 2 the pressure, blue below
// and orange above; 3 the curl.
pub embed wgsl RENDER with COMMON, SAMPLE_VEL, SAMPLE_DYE {
    @group(0) @binding(1) var<storage, read> dye_in: array<vec4<f32>>;
    @group(0) @binding(2) var<storage, read> glow: array<vec4<f32>>;
    @group(0) @binding(3) var<storage, read> uf: array<f32>;
    @group(0) @binding(4) var<storage, read> vf: array<f32>;
    @group(0) @binding(5) var<storage, read> pr: array<f32>;
    @group(0) @binding(6) var<storage, read> curl: array<f32>;
    @group(0) @binding(7) var<storage, read> glyphs: array<u32>;
    @group(0) @binding(8) var<storage, read> text: array<u32>;
    @group(0) @binding(9) var<storage, read> pmean: array<f32>;
    struct VOut { @builtin(position) pos: vec4<f32> }
    @vertex fn vs(@builtin(vertex_index) vi: u32) -> VOut {
        var o: VOut;
        let x = f32((vi << 1u) & 2u);
        let y = f32(vi & 2u);
        o.pos = vec4<f32>(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);
        return o;
    }
    fn tone(c: vec3<f32>) -> vec3<f32> { return vec3<f32>(1.0, 1.0, 1.0) - exp(-2.2 * c); }
    fn sample_glow(p: vec2<f32>) -> vec3<f32> {
        let bw = (gw() + 3) / 4;
        let bh = (gh() + 3) / 4;
        let q = p / 4.0 - vec2<f32>(0.5, 0.5);
        let b = floor(q);
        let t = q - b;
        let i = clamp(i32(b.x), 0, bw - 1);
        let j = clamp(i32(b.y), 0, bh - 1);
        let i1 = min(i + 1, bw - 1);
        let j1 = min(j + 1, bh - 1);
        let a = mix(glow[u32(j * bw + i)].xyz, glow[u32(j * bw + i1)].xyz, t.x);
        let c = mix(glow[u32(j1 * bw + i)].xyz, glow[u32(j1 * bw + i1)].xyz, t.x);
        return mix(a, c, t.y);
    }
    fn sample_cell(p: vec2<f32>, which: u32) -> f32 {
        let q = p - vec2<f32>(0.5, 0.5);
        let b = floor(q);
        let t = q - b;
        let i = i32(b.x);
        let j = i32(b.y);
        var x = vec4<f32>(0.0, 0.0, 0.0, 0.0);
        if which == 0u {
            x = vec4<f32>(pr[cell(i, j)], pr[cell(i + 1, j)], pr[cell(i, j + 1)], pr[cell(i + 1, j + 1)]);
        } else {
            x = vec4<f32>(curl[cell(i, j)], curl[cell(i + 1, j)], curl[cell(i, j + 1)], curl[cell(i + 1, j + 1)]);
        }
        return mix(mix(x.x, x.y, t.x), mix(x.z, x.w, t.x), t.y);
    }
    fn ink(k: u32) -> vec3<f32> {
        if k == 1u { return vec3<f32>(0.47, 0.5, 0.56); }
        if k == 2u { return vec3<f32>(0.45, 0.85, 1.0); }
        if k == 3u { return vec3<f32>(1.0, 0.62, 0.25); }
        if k == 4u { return vec3<f32>(1.0, 1.0, 1.0); }
        return vec3<f32>(0.84, 0.86, 0.9);
    }
    fn overlay(px: vec2<f32>, c: vec3<f32>) -> vec3<f32> {
        if prm.ui.w < 0.5 { return c; }
        let fp = prm.ui.z;
        let q = (px - prm.ui.xy) / fp;
        let size = vec2<f32>(prm.ui2.x * 6.0, prm.ui2.y * 8.0);
        let half = size * 0.5 + vec2<f32>(2.0, 2.0);
        let e = abs(q - size * 0.5) - half + vec2<f32>(2.0, 2.0);
        let d = length(max(e, vec2<f32>(0.0, 0.0))) + min(max(e.x, e.y), 0.0) - 2.0;
        if d * fp > 1.0 { return c; }
        let inside = clamp(0.5 - d * fp, 0.0, 1.0);
        var o = mix(c, vec3<f32>(0.02, 0.024, 0.035), 0.62 * inside);
        let rim = clamp(1.0 - abs(d * fp + 1.0), 0.0, 1.0);
        o = mix(o, vec3<f32>(0.3, 0.33, 0.4), 0.35 * rim);
        if q.x < 0.0 || q.y < 0.0 || q.x >= size.x || q.y >= size.y { return o; }
        let col = u32(q.x / 6.0);
        let row = u32(q.y / 8.0);
        let cell = text[row * u32(prm.ui2.z) + col];
        let ch = cell & 255u;
        let gx = i32(floor(q.x)) - i32(col) * 6;
        let gy = i32(floor(q.y)) - i32(row) * 8;
        if ch == 1u {
            if gy >= 0 && gy < 7 { o = prm.brush.xyz; }
            return o;
        }
        if ch < 32u || ch > 126u || gx > 4 || gy < 0 || gy > 6 { return o; }
        let g = (ch - 32u) * 2u;
        var bits = 0u;
        if gx < 4 { bits = glyphs[g] >> (u32(gx) * 8u); } else { bits = glyphs[g + 1u]; }
        if ((bits >> u32(gy)) & 1u) == 1u { o = ink((cell >> 8u) & 255u); }
        return o;
    }
    fn lum(p: vec2<f32>) -> f32 { return dot(tone(sample_dye(p)), vec3<f32>(0.3, 0.55, 0.15)); }
    @fragment fn fs(v: VOut) -> @location(0) vec4<f32> {
        let uv = v.pos.xy / vec2<f32>(prm.sw, prm.sh);
        let p = uv * vec2<f32>(f32(prm.w), f32(prm.h));
        let edge = uv * (vec2<f32>(1.0, 1.0) - uv);
        let vig = pow(clamp(edge.x * edge.y * 18.0, 0.0, 1.0), 0.22);
        let bg = mix(vec3<f32>(0.0008, 0.001, 0.002), vec3<f32>(0.004, 0.005, 0.011), vig);
        var c = vec3<f32>(0.0, 0.0, 0.0);
        if prm.view == 0u {
            let d = tone(sample_dye(p));
            let e = 1.5;
            let gx = lum(p + vec2<f32>(e, 0.0)) - lum(p - vec2<f32>(e, 0.0));
            let gy = lum(p + vec2<f32>(0.0, e)) - lum(p - vec2<f32>(0.0, e));
            let n = normalize(vec3<f32>(-gx * 6.0, -gy * 6.0, 1.0));
            let l = normalize(vec3<f32>(-0.4, -0.6, 0.7));
            let diff = clamp(dot(n, l), 0.0, 1.0);
            let shade = mix(1.0, 0.55 + 0.6 * diff, prm.shade);
            let spec = pow(clamp(dot(reflect(-l, n), vec3<f32>(0.0, 0.0, 1.0)), 0.0, 1.0), 24.0) * prm.shade;
            c = d * shade + vec3<f32>(spec, spec, spec) * 0.25 * length(d) + sample_glow(p) * prm.bloom;
        } else if prm.view == 1u {
            let w = vel(p);
            let s = length(w) / (0.25 * f32(prm.h));
            let h = atan2(w.y, w.x) / TAU + 0.5;
            c = hue(h) * (1.0 - exp(-2.0 * s));
        } else if prm.view == 2u {
            let x = (sample_cell(p, 0u) - pmean[0]) * 0.03;
            let k = x / (abs(x) + 1.0);
            c = select(vec3<f32>(0.2, 0.5, 1.0) * -k, vec3<f32>(1.0, 0.55, 0.15) * k, k > 0.0);
        } else {
            let x = sample_cell(p, 1u) * 0.08;
            let k = x / (abs(x) + 1.0);
            c = select(vec3<f32>(0.1, 0.8, 0.7) * -k, vec3<f32>(0.95, 0.3, 0.6) * k, k > 0.0);
        }
        let o = pow(bg + c, vec3<f32>(0.4545, 0.4545, 0.4545));
        return vec4<f32>(overlay(v.pos.xy, o), 1.0);
    }
}

// The pressure's mean, for the pressure view (a pressure is defined up to
// a constant, which drifts): one workgroup sums the cells.
pub embed wgsl MEAN with COMMON {
    @group(0) @binding(1) var<storage, read> pr: array<f32>;
    @group(0) @binding(2) var<storage, read_write> pmean: array<f32>;
    var<workgroup> part: array<f32, 256>;
    @compute @workgroup_size(256)
    fn main(@builtin(local_invocation_index) li: u32) {
        let n = prm.w * prm.h;
        var s = 0.0;
        for (var k = li; k < n; k += 256u) { s += pr[k]; }
        part[li] = s;
        workgroupBarrier();
        for (var st = 128u; st > 0u; st = st >> 1u) {
            if li < st { part[li] += part[li + st]; }
            workgroupBarrier();
        }
        if li == 0u { pmean[0] = part[0] / f32(n); }
    }
}
