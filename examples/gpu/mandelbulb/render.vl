// GPU setup and submission for the Mandelbulb viewer. The ray marcher runs
// into an offscreen film of governable size, and a second full-screen pass
// samples it into the window. One 112-byte uniform carries camera, fractal
// and quality knobs; there is no vertex buffer or interactive readback.

use std::gpu;
use std::gpu::{
    BindGroup, Buffer, BufferUsage, Color, Format, PassDesc, RenderPipeline, Sampler, SamplerDesc,
    Texture, TextureUsage, TextureView,
};

pub embed wgsl MANDELBULB from b"mandelbulb.wgsl";
pub embed wgsl DISPLAY from b"display.wgsl";

pub const DEFAULT_POWER: i64 = 8;
pub const DEFAULT_STEPS: i64 = 112;
pub const DEFAULT_SHADOW_STEPS: i64 = 20;
pub const DEFAULT_AO_STEPS: i64 = 4;

pub const DEFAULT_YAW: f64 = 0.60;
pub const DEFAULT_PITCH: f64 = 0.45;
pub const DEFAULT_DIST: f64 = 3.0;
pub const DEFAULT_FOV: f64 = 42.0;
pub const DEFAULT_EXPOSURE: f64 = 1.15;

#[derive(Clone, Copy)]
pub struct Camera {
    pub yaw: f64,
    pub pitch: f64,
    pub dist: f64,
    pub fov: f64,
}

#[derive(Clone, Copy)]
pub struct Quality {
    pub steps: i64,
    pub shadow_steps: i64,
    pub ao_steps: i64,
    pub palette: i64,
    pub exposure: f64,
    pub glow: f64,
}

pub struct Renderer {
    pipe: RenderPipeline,
    params: Buffer,
    group: BindGroup,
    display_pipe: RenderPipeline,
    sampler: Sampler,
    film: Texture,
    film_group: BindGroup,
    pub render_width: i64,
    pub render_height: i64,
}

pub fn renderer_new(dev: &gpu::Device<Gpa>) -> Result<Renderer, gpu::Error<Gpa>> {
    let shader = dev.shader_wgsl(MANDELBULB.src)?;
    let pipe = dev.render_pipeline(gpu::RenderDesc::new(&shader, MANDELBULB.vs, MANDELBULB.fs,
        Format::Bgra8Unorm))?;
    let params = dev.buffer(dev.align_uniform(28 * 4),
        BufferUsage::UNIFORM | BufferUsage::COPY_DST);
    let group = dev.bind_group(pipe.bind_layout(0), &[gpu::bind(0, &params)][..]);
    let display_pipe = dev.render_pipeline(gpu::RenderDesc::new(dev.shader_wgsl(DISPLAY.src)?,
        DISPLAY.vs, DISPLAY.fs, Format::Bgra8Unorm))?;
    let sampler = dev.sampler(SamplerDesc::linear());
    let film = dev.texture(8, 8, Format::Bgra8Unorm,
        TextureUsage::RENDER_ATTACHMENT | TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_SRC);
    let film_group = dev.bind_group(display_pipe.bind_layout(0),
        &[gpu::bind_texture(0, &film.view()), gpu::bind_sampler(1, &sampler)][..]);
    Ok(Renderer {
        pipe,
        params,
        group,
        display_pipe,
        sampler,
        film,
        film_group,
        render_width: 8,
        render_height: 8,
    })
}

impl Renderer {
    /// A quality change only replaces the film and its bind group; the two
    /// pipelines and the camera uniform stay alive.
    fn set_render_size(&mut self, dev: &gpu::Device<Gpa>, width: i64, height: i64) {
        if width == self.render_width && height == self.render_height { return; }
        self.render_width = width;
        self.render_height = height;
        self.film = dev.texture(width, height, Format::Bgra8Unorm,
            TextureUsage::RENDER_ATTACHMENT | TextureUsage::TEXTURE_BINDING
                | TextureUsage::COPY_SRC);
        self.film_group = dev.bind_group(self.display_pipe.bind_layout(0),
            &[gpu::bind_texture(0, &self.film.view()), gpu::bind_sampler(1, &self.sampler)][..]);
    }

    pub fn draw(&mut self, dev: &gpu::Device<Gpa>, queue: &mut gpu::Queue, target: &TextureView,
        surface_width: i64, surface_height: i64, render_width: i64, render_height: i64,
        cam: Camera, power: i64, quality: Quality, time: f64) {
        self.set_render_size(dev, render_width, render_height);
        let cp = cam.pitch.cos();
        let sp = cam.pitch.sin();
        let cy = cam.yaw.cos();
        let sy = cam.yaw.sin();
        let eye = [cam.dist * cp * sy, cam.dist * sp, cam.dist * cp * cy];
        let len = (eye[0] * eye[0] + eye[1] * eye[1] + eye[2] * eye[2]).sqrt();
        let forward = [-eye[0] / len, -eye[1] / len, -eye[2] / len];
        // right = forward x world-up, up = right x forward.
        let mut right = [-forward[2], 0.0, forward[0]];
        let right_len = (right[0] * right[0] + right[2] * right[2]).sqrt().max(0.000001);
        right[0] /= right_len;
        right[2] /= right_len;
        let up = [
            right[1] * forward[2] - right[2] * forward[1],
            right[2] * forward[0] - right[0] * forward[2],
            right[0] * forward[1] - right[1] * forward[0],
        ];
        let tan_half = (cam.fov * 0.5 * std::f64::consts::PI / 180.0).tan();
        let u: [f32; 28] = [
            eye[0] as f32, eye[1] as f32, eye[2] as f32, time as f32,
            right[0] as f32, right[1] as f32, right[2] as f32, tan_half as f32,
            up[0] as f32, up[1] as f32, up[2] as f32,
            (surface_width as f64 / surface_height as f64) as f32,
            forward[0] as f32, forward[1] as f32, forward[2] as f32, power as f32,
            render_width as f32, render_height as f32, quality.steps as f32,
            (2.0 * tan_half / render_height as f64) as f32,
            quality.shadow_steps as f32, quality.ao_steps as f32, quality.palette as f32,
            quality.exposure as f32,
            20.0, quality.glow as f32, 0.0, 0.0,
        ];
        queue.write_buffer(&self.params, 0, gpu::bytes_of_f32(&u[..]));
        let pipe = &self.pipe;
        let group = &self.group;
        let film_view = self.film.view();
        let display_pipe = &self.display_pipe;
        let display_group = &self.film_group;
        let mut enc = dev.encoder();
        enc.render_pass(PassDesc::color(&film_view, clear: Color::rgba(0.0, 0.0, 0.0, 1.0),
            load: gpu::Load::Clear), |pass| {
            pass.set_pipeline(pipe);
            pass.set_bind_group(0, group);
            pass.draw(0..3, 0..1);
        });
        enc.render_pass(PassDesc::color(target, clear: Color::rgba(0.0, 0.0, 0.0, 1.0),
            load: gpu::Load::Clear), |pass| {
            pass.set_pipeline(display_pipe);
            pass.set_bind_group(0, display_group);
            pass.draw(0..3, 0..1);
        });
        queue.submit(enc.finish());
    }
}

pub fn default_camera() -> Camera {
    Camera {
        yaw: DEFAULT_YAW,
        pitch: DEFAULT_PITCH,
        dist: DEFAULT_DIST,
        fov: DEFAULT_FOV,
    }
}

pub fn default_quality() -> Quality {
    Quality {
        steps: DEFAULT_STEPS,
        shadow_steps: DEFAULT_SHADOW_STEPS,
        ao_steps: DEFAULT_AO_STEPS,
        palette: 0,
        exposure: DEFAULT_EXPOSURE,
        glow: 0.30,
    }
}
