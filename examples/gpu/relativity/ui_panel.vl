// The panel: one compact card in the top-left corner with the logarithmic
// speed-of-light slider, the readouts that make the experiment legible
// (multiplier, v/c, gamma), the presets and the four effect switches, plus a
// reset. Everything it changes goes through `Lab::set_mult` or the same
// fields the keyboard writes, so the panel and the keyboard cannot disagree.

use std::math::max;

use state::{Lab, ORB_COUNT, PRESET_LABELS, PRESET_MULTS, WALK_SPEED, mult_from_t, t_from_mult};
use ui::{ACCENT, BG, BORDER, DIM, FAINT, GOOD, HEADER, TEXT, Ui, WARN, format_fixed};

pub const WIDTH: f64 = 356.0;
const PAD: f64 = 16.0;
const H: f64 = 372.0;

const EFFECT_NAMES: [[u8]; 4] = ["doppler", "aberration", "beaming", "lorentz"];

pub struct Status {
    pub fps: f64,
    pub ms: f64,
}

pub struct Action {
    pub reset: bool,
    pub reset_view: bool,
}

/// Two decimals near 1x (where 1.10 vs 1.15 matters), one in the tens, none
/// when the multiplier is an integer and the digits are large.
fn mult_decimals(v: f64) -> i64 {
    if v < 10.0 { 2 } else if v < 100.0 { 1 } else { 0 }
}

pub fn panel(ui: inout Ui, lab: inout Lab, st: Status, gpa: Gpa) -> Action {
    var act = Action { reset: false, reset_view: false };
    let u = ui.u;
    let tag_w = 88.0 * u;
    let tag_h = 24.0 * u;
    if ui.hidden {
        // The one live control while the panel is away: the tab that brings
        // it back. The simulation keeps running.
        let bx = ui.inp.w - tag_w - 12.0 * u;
        let by = 12.0 * u;
        if ui.button(9001, bx, by, tag_w, tag_h, "SHOW UI") { ui.hidden = false; }
        ui.panel_w = 0.0;
        ui.panel_h = 0.0;
        return act;
    }

    let pw = WIDTH * u;
    let ph = H * u;
    let x = 18.0 * u;
    let y = 18.0 * u;
    let inner = pw - 2.0 * PAD * u;
    let left = x + PAD * u;
    let right = x + pw - PAD * u;
    ui.panel_x = x;
    ui.panel_y = y;
    ui.panel_w = WIDTH;
    ui.panel_h = ph;
    ui.full_clip();

    // The card: a shadow, the panel, a border, an accent rule on top.
    ui.rect(x + 5.0 * u, y + 5.0 * u, pw, ph, [0.0, 0.0, 0.0, 0.30]);
    ui.rect(x, y, pw, ph, BG);
    ui.outline(x, y, pw, ph, u, BORDER);
    ui.rect(x, y, pw, 2.0 * u, ACCENT);

    // Header.
    ui.text(left, y + 10.0 * u, "LIGHT SPEED", TEXT);
    if ui.button(9002, right - 50.0 * u, y + 9.0 * u, 50.0 * u, 18.0 * u, "HIDE") {
        ui.hidden = true;
    }
    // The reference the multiplier is relative to.
    let ref_y = y + 28.0 * u;
    let ref_w = ui.text(left, ref_y, "reference walk", FAINT);
    let space = 6.0 * ui.font;
    let speed_w = ui.number(left + ref_w + space, ref_y, WALK_SPEED, 1, DIM);
    ui.text(left + ref_w + space + speed_w + space, ref_y, "m/s", FAINT);

    // The multiplier, the one number the experiment is about. It is drawn at
    // three times the body size; the widths are measured at that size.
    let saved = ui.font;
    let big = if 3.0 * u > saved { 3.0 * u } else { saved };
    ui.font = big;
    var buf: [u8; 32] = [32; 32];
    let n = format_fixed(lab.mult, mult_decimals(lab.mult), &buf);
    let lead = "c = ";
    let lw = ui.text_width(lead);
    let nw = ui.text_width(buf[0..n]);
    let big_y = y + 46.0 * u;
    ui.text(left, big_y, lead, DIM);
    ui.text(left + lw, big_y, buf[0..n], ACCENT);
    ui.text(left + lw + nw + big, big_y, "x", ACCENT);
    ui.font = saved;
    // The rest of the sentence, so the number is never ambiguous.
    ui.text(left, big_y + 7.0 * big + 4.0 * u, "walking speed", DIM);

    // The kinematic readout, from the instantaneous velocity.
    let row = y + 94.0 * u;
    // Each value starts after its label's measured width: the font may be
    // wider than the layout unit (at least 2 pixels per glyph pixel).
    let gap = 6.0 * ui.font;
    let vl = ui.text(left, row, "v/c", FAINT);
    let vn = ui.number(left + vl + gap, row, lab.beta(), 3, TEXT);
    let gx = max(left + 112.0 * u, left + vl + gap + vn + 2.0 * gap);
    let gl = ui.text(gx, row, "gamma", FAINT);
    ui.number(gx + gl + gap, row, lab.gamma(), 2, TEXT);

    // The logarithmic slider: equal distances are equal ratios. The min and
    // max labels under it say where the ends of the track are.
    var t = t_from_mult(lab.mult);
    if ui.track(9100, left, y + 112.0 * u, inner, 38.0 * u, "Speed of Light (c)", &t) {
        lab.set_mult(mult_from_t(t));
    }
    ui.text(left, y + 154.0 * u, "1.1x", FAINT);
    ui.text_right(x, y + 154.0 * u, right, "1000x", FAINT);

    // Presets: two rows of a four-column grid, so each chip can print the
    // whole multiplier ("1000x") without clipping.
    let gap = 3.0 * u;
    let cw = (inner - gap * 3.0) / 4.0;
    for i in 0..7 {
        let col = (i % 4) as f64;
        let line = (i / 4) as f64;
        let cx = left + (cw + gap) * col;
        let cy = y + 172.0 * u + (22.0 * u + gap) * line;
        let on = (lab.mult - PRESET_MULTS[i]).abs() < 1e-6;
        if ui.chip(9200 + i, cx, cy, cw, 22.0 * u, PRESET_LABELS[i], on) && !on {
            lab.set_mult(PRESET_MULTS[i]);
        }
    }

    // The four effects, so each can be seen on its own.
    let tw = (inner - 6.0 * u) * 0.5;
    for i in 0..4 {
        let cx = left + (tw + 6.0 * u) * (i % 2) as f64;
        let cy = y + 229.0 * u + 25.0 * u * (i / 2) as f64;
        if ui.toggle(9300 + i, cx, cy, tw, 22.0 * u, EFFECT_NAMES[i], lab.effects[i]) {
            lab.effects[i] = !lab.effects[i];
        }
    }

    // Progression and frame rate. The orbs move the slider; they never set a
    // second speed of light.
    let foot = y + 284.0 * u;
    let ol = ui.text(left, foot, "orbs", FAINT) + 6.0 * ui.font;
    let ow = ui.number(left + ol, foot, lab.collected as f64, 0, GOOD) + ui.font;
    let sw = ui.text(left + ol + ow, foot, "/", FAINT) + ui.font;
    ui.number(left + ol + ow + sw, foot, ORB_COUNT as f64, 0, FAINT);
    var fb: [u8; 32] = [32; 32];
    let fn_ = format_fixed(st.fps, 0, &fb);
    ui.text_right(x, foot, right - ui.text_width("fps") - 6.0 * u, "fps", FAINT);
    ui.text_right(x, foot, right, fb[0..fn_], DIM);

    // The two resets: the whole experiment, and the pose alone.
    let bw = (inner - 6.0 * u) * 0.5;
    if ui.button(9003, left, y + 302.0 * u, bw, 24.0 * u, "RESET ALL") {
        act.reset = true;
    }
    if ui.button(9004, left + bw + 6.0 * u, y + 302.0 * u, bw, 24.0 * u, "RESET VIEW") {
        act.reset_view = true;
    }

    // The keyboard line.
    ui.text(left, y + 334.0 * u, "1-7 presets  arrows nudge", FAINT);
    ui.text(left, y + 348.0 * u, "TAB hide   R reset view", FAINT);

    // An orb pickup reports the multiplier it moved the slider to, once.
    if lab.toast > 0.0 {
        let msg = format_in("orb {}/{ORB_COUNT}  c = {:.2}x", lab.toast_orb + 1, lab.mult, gpa);
        let mw = ui.text_width(msg.as_slice()) + 24.0 * u;
        let by = y + ph + 8.0 * u;
        ui.rect(x + 4.0 * u, by + 4.0 * u, mw, 24.0 * u, [0.0, 0.0, 0.0, 0.3]);
        ui.rect(x, by, mw, 24.0 * u, HEADER);
        ui.outline(x, by, mw, 24.0 * u, u, WARN);
        ui.text(x + 12.0 * u, by + 5.0 * u, msg.as_slice(), WARN);
    }
    act
}
