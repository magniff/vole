// relativity: walk through a village at a speed of light you can set. The
// panel in the corner is a logarithmic slider over c / v_walk (1.001x to
// 10x); the renderer turns the instantaneous velocity into aberration,
// Doppler shift, beaming and Lorentz contraction. There is one multiplier in
// the program: the slider, the presets, the keyboard and the orbs all write
// the same field through Lab::set_mult.
//
// --headless renders the same pipelines into a readback surface and writes a
// PPM, so the effects can be checked without a display server.

mod check;
mod font;
mod render;
mod state;
mod ui;
mod ui_panel;
mod ui_render;

use std::{clamp, env, gpu, max};
use std::cli::{Arg, Command, Matches};
use std::gpu::RawSurface;
use std::time::monotonic_now;
use std::window::{App, Button, Event, MouseAction, WindowDesc};
use std::window::keys::{Logical, Named};

use render::renderer_new;
use state::{BETA_LIMIT, Lab, PRESET_MULTS, lab_default};
use ui::{Input, Ui};
use ui_panel::{Status, panel};
use ui_render::ui_renderer_new;

/// One key press moves the slider this far along its track: fine control at
/// the low end, where the world changes most.
const KEY_NUDGE: f64 = 0.008;
const KEY_NUDGE_FAST: f64 = 0.04;

fn parse_size(s: str) -> (i64, i64) {
    let (ws, hs) = match s.split_once("x") {
        Some(pair) => pair,
        None => ("960", "600"),
    };
    let w = ws.parse::<i64>().unwrap_or(960);
    let h = hs.parse::<i64>().unwrap_or(600);
    (w, h)
}

/// The film is traced at logical resolution: one output pixel per point, so
/// a Retina frame costs a bilinear fetch, not another trace.
fn render_dimensions(width: i64, height: i64, scale: f64) -> (i64, i64) {
    let divisor = max(1, scale as i64);
    (max(8, width / divisor), max(8, height / divisor))
}

fn deg_to_rad(d: f64) -> f64 {
    d * 3.141592653589793 / 180.0
}

/// The lab a headless run starts from: the CLI can set the multiplier, the
/// current velocity (as a fraction of c) and the pose.
fn cli_lab(m: Matches) -> Lab {
    var lab = lab_default();
    let mult = m.get_as::<f64>("mult").unwrap_or(lab.mult);
    lab.set_mult(mult);
    if let Some(pos) = m.get("pos") {
        let (xs, zs) = match pos.split_once(",") {
            Some(pair) => pair,
            None => ("0", "14"),
        };
        lab.x = xs.parse::<f64>().unwrap_or(lab.x);
        lab.z = zs.parse::<f64>().unwrap_or(lab.z);
    }
    lab.yaw = deg_to_rad(m.get_as::<f64>("yaw").unwrap_or(0.0));
    lab.pitch = clamp(deg_to_rad(m.get_as::<f64>("pitch").unwrap_or(-2.3)), -1.2, 1.2);
    // A velocity along the view direction, at a fraction of c. It is the
    // instantaneous velocity the effects are computed from, not the slider.
    let beta = clamp(m.get_as::<f64>("beta").unwrap_or(0.0), 0.0, BETA_LIMIT);
    if beta > 0.0 {
        let v = beta * lab.c();
        lab.set_velocity(lab.yaw.sin() * v, -lab.yaw.cos() * v);
    }
    lab
}

fn main(gpa: Gpa) -> i32 {
    let cli = Command::new_in("relativity", gpa)
        .version("0.1")
        .about("a village you walk through at a speed of light you can set")
        .arg(Arg::flag("headless").help("render to a readback surface instead of opening a window"))
        .arg(Arg::flag("ui").help("headless: draw the on-screen panel over the image"))
        .arg(Arg::option("ui-scale").value_name("S").default("1")
            .help("headless --ui: physical pixels per UI point (2 on a Retina display)"))
        .arg(Arg::option("size").value_name("WxH").default("960x600")
            .help("headless: image size in physical pixels"))
        .arg(Arg::option("mult").value_name("M").default("1.5")
            .help("headless: c / v_walk, from 1.001 to 10"))
        .arg(Arg::option("beta").value_name("B").default("0")
            .help("headless: current velocity as a fraction of c (0 to 0.999)"))
        .arg(Arg::option("pos").value_name("X,Z").default("0,14")
            .help("headless: observer position in metres"))
        .arg(Arg::option("yaw").value_name("DEG").default("0")
            .help("headless: observer heading in degrees"))
        .arg(Arg::option("pitch").value_name("DEG").default("-2.3")
            .help("headless: observer pitch in degrees"))
        .arg(Arg::option("out").value_name("FILE.ppm")
            .help("headless: write the image as a binary PPM"));
    let m = cli.parse_or_exit(env::args());
    let (width, height) = parse_size(m.get("size").unwrap_or("960x600"));
    if m.flag("headless") {
        if width < 8 || height < 8 {
            eprintln("relativity: --size must be at least 8x8");
            return 2;
        }
        return check::run(width, height, m.get("out").unwrap_or(""), cli_lab(m),
            m.flag("ui"), m.get_as::<f64>("ui-scale").unwrap_or(1.0), gpa);
    }

    var app = match App::new_in(gpa) {
        Ok(a) => a,
        Err(_) => {
            eprintln("relativity: no window server on this display (try --headless)");
            return 1;
        }
    };
    var win = match app.window(WindowDesc::new("relativity", 1280, 800)) {
        Ok(w) => w,
        Err(_) => {
            eprintln("relativity: could not create a window");
            return 1;
        }
    };
    let inst = gpu::Instance::new_in(gpa);
    let opened = match inst.adapter() {
        Ok(a) => a.device(),
        Err(e) => Err(e),
    };
    let (dev, var queue) = match opened {
        Ok(pair) => pair,
        Err(e) => {
            eprintln("relativity: no GPU: {e}");
            return 1;
        }
    };
    var surf = match inst.surface(dev, RawSurface::MetalLayer(win.raw_surface())) {
        Ok(s) => s,
        Err(e) => {
            eprintln("relativity: no surface for the window: {e}");
            return 1;
        }
    };
    let pixels = win.size();
    surf.configure(dev, pixels.w, pixels.h);
    var scale = pixels.scale;
    let logical = render_dimensions(pixels.w, pixels.h, pixels.scale);
    var renderer = match renderer_new(dev, logical.0, logical.1) {
        Ok(r) => r,
        Err(e) => {
            eprintln("relativity: renderer: {e}");
            return 1;
        }
    };
    var ui = Ui::new_in(gpa);
    var ui_renderer = match ui_renderer_new(dev, &queue, gpa) {
        Ok(r) => r,
        Err(e) => {
            eprintln("relativity: UI renderer: {e}");
            return 1;
        }
    };

    var lab = lab_default();
    // Held keys: w, a, s, d, then shift. Released by the same events that set
    // them, so the observer stops when the key is let go.
    var keys: [bool; 5] = [false; 5];
    var dragging = false;
    var last_x = 0.0;
    var last_y = 0.0;
    var mouse_x = 0.0;
    var mouse_y = 0.0;
    var mouse_down = false;
    var mouse_press = false;
    var mouse_release = false;
    var frames: i64 = 0;
    var frame_clock = monotonic_now();
    var last_clock = monotonic_now();
    var frame_ms = 0.0;
    var fps = 0.0;
    println("relativity: walk the village, drag the speed of light");
    win.request_frame();
    loop {
        match app.wait() {
            Ok(Event::Frame(_)) => {
                let now = monotonic_now();
                let dt = clamp(now.saturating_sub(last_clock).as_secs_f64(), 0.0, 0.05);
                last_clock = now;

                // Movement: the acceleration ramp turns the keys into an
                // instantaneous velocity, and Lab::step keeps |v| below c.
                let forward = (if keys[0] { 1.0 } else { 0.0 })
                    - (if keys[1] { 1.0 } else { 0.0 });
                let strafe = (if keys[3] { 1.0 } else { 0.0 })
                    - (if keys[2] { 1.0 } else { 0.0 });
                lab.step(dt, forward, strafe, keys[4]);

                let input = Input {
                    x: mouse_x, y: mouse_y, down: mouse_down,
                    press: mouse_press, release: mouse_release, wheel: 0.0,
                    w: surf.width as f64, h: surf.height as f64, scale: scale,
                };
                ui.begin(input);
                let actions = panel(&ui, &lab, Status { fps: fps, ms: frame_ms }, gpa);
                ui.end();
                mouse_press = false;
                mouse_release = false;
                if actions.reset {
                    lab.reset();
                }
                if actions.reset_view {
                    lab.reset_view();
                }

                match surf.frame() {
                    Ok(frame) => {
                        let target = frame.texture.view();
                        renderer.draw(dev, &queue, target, lab, lab.world_time);
                        ui_renderer.draw(dev, &queue, target, ui.verts.as_slice());
                        frame.present(&queue);
                        frames += 1;
                    }
                    Err(_) => {}
                }

                let elapsed = now.saturating_sub(frame_clock);
                if elapsed.as_millis() >= 400 {
                    let seconds = elapsed.as_secs_f64();
                    frame_ms = seconds * 1000.0 / frames as f64;
                    fps = frames as f64 / seconds;
                    let title = format_in(
                        "relativity | c = {:.3}x walking speed | v/c = {:.3} | gamma = {:.2} | {fps:.0} fps", lab.mult, lab.beta(), lab.gamma(),
                        gpa,
                    );
                    win.set_title(title.as_slice());
                    frame_clock = now;
                    frames = 0;
                }
                win.request_frame();
            }
            Ok(Event::Resize(_, size)) => {
                if size.w > 0 && size.h > 0 {
                    surf.configure(dev, size.w, size.h);
                    scale = size.scale;
                    let logical = render_dimensions(size.w, size.h, size.scale);
                    match renderer_new(dev, logical.0, logical.1) {
                        Ok(r) => {
                            renderer = r;
                            win.request_frame();
                        }
                        Err(e) => eprintln("relativity: resize: {e}"),
                    }
                }
            }
            Ok(Event::Key(k)) => {
                if !k.ime {
                    match k.key {
                        Logical::Named(Named::Escape) => {
                            if k.pressed {
                                win.close();
                                break;
                            }
                        }
                        Logical::Named(Named::Tab) => {
                            if k.pressed { ui.hidden = !ui.hidden; }
                        }
                        Logical::Named(Named::Shift) => {
                            keys[4] = k.pressed;
                        }
                        Logical::Named(Named::ArrowLeft) => {
                            if k.pressed {
                                let step = if keys[4] { KEY_NUDGE_FAST } else { KEY_NUDGE };
                                lab.nudge(-step);
                            }
                        }
                        Logical::Named(Named::ArrowRight) => {
                            if k.pressed {
                                let step = if keys[4] { KEY_NUDGE_FAST } else { KEY_NUDGE };
                                lab.nudge(step);
                            }
                        }
                        Logical::Named(Named::ArrowUp) => {
                            if k.pressed {
                                let step = if keys[4] { KEY_NUDGE_FAST } else { KEY_NUDGE };
                                lab.nudge(step);
                            }
                        }
                        Logical::Named(Named::ArrowDown) => {
                            if k.pressed {
                                let step = if keys[4] { KEY_NUDGE_FAST } else { KEY_NUDGE };
                                lab.nudge(-step);
                            }
                        }
                        Logical::Char(ch) => {
                            if ch == 'w' as u32 { keys[0] = k.pressed; }
                            if ch == 's' as u32 { keys[1] = k.pressed; }
                            if ch == 'a' as u32 { keys[2] = k.pressed; }
                            if ch == 'd' as u32 { keys[3] = k.pressed; }
                            if k.pressed {
                                if ch == 'q' as u32 {
                                    win.close();
                                    break;
                                }
                                if ch == 'f' as u32 {
                                    win.set_fullscreen(!win.is_fullscreen());
                                }
                                if ch == 'r' as u32 { lab.reset(); }
                                if ch == 'v' as u32 { lab.reset_view(); }
                                if ch >= '1' as u32 && ch <= '7' as u32 {
                                    lab.set_mult(PRESET_MULTS[(ch - '1' as u32) as i64]);
                                }
                            }
                        }
                        _ => {}
                    }
                }
            }
            Ok(Event::Mouse(mouse)) => {
                match mouse.action {
                    MouseAction::Press => {
                        mouse_x = mouse.x;
                        mouse_y = mouse.y;
                        if mouse.button == Button::Left {
                            mouse_down = true;
                            mouse_press = true;
                            // A press on the panel drags a widget, never the
                            // view; the SHOW UI tab counts as the panel.
                            let on_ui = ui.covers(mouse.x, mouse.y)
                                || overlay_hidden(ui, surf.width, surf.height, mouse.x, mouse.y);
                            if on_ui {
                                dragging = false;
                            } else {
                                dragging = true;
                                last_x = mouse.x;
                                last_y = mouse.y;
                            }
                        }
                    }
                    MouseAction::Release => {
                        mouse_x = mouse.x;
                        mouse_y = mouse.y;
                        if mouse.button == Button::Left {
                            mouse_down = false;
                            mouse_release = true;
                            dragging = false;
                        }
                    }
                    MouseAction::Move => {
                        mouse_x = mouse.x;
                        mouse_y = mouse.y;
                        if dragging && !ui.covers(mouse.x, mouse.y) {
                            lab.look(mouse.x - last_x, mouse.y - last_y);
                            last_x = mouse.x;
                            last_y = mouse.y;
                        }
                    }
                }
            }
            Ok(Event::Close(_)) => {
                win.close();
                break;
            }
            Ok(Event::Quit) => {
                win.close();
                break;
            }
            Ok(_) => {}
            Err(_) => {
                eprintln("relativity: window event loop failed");
                break;
            }
        }
    }
    0
}

/// The SHOW UI tab sits at the top right while the panel is hidden; a click
/// there must not start a camera drag.
fn overlay_hidden(ui: Ui, width: i64, height: i64, x: f64, y: f64) -> bool {
    let _ = height;
    let u = ui.u;
    ui.hidden && x > width as f64 - 100.0 * u && y < 36.0 * u
}

#[test]
fn high_dpi_rendering_uses_logical_resolution() {
    assert_eq(render_dimensions(2200, 1440, 2.0), (1100, 720));
    assert_eq(render_dimensions(1100, 720, 1.0), (1100, 720));
    assert_eq(render_dimensions(2, 2, 1.0), (8, 8));
}
