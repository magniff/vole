// EDITION: rust
// Headless rendering: the same compute, display and UI pipelines as the
// window, into RawSurface::Headless, with a readback only for the checks and
// the PPM. `--ui` composites the real panel, so the layout can be inspected
// without a display server; `--beta` sets the velocity the effects use.

use std::{fs, gpu};
use std::gpu::{BufferUsage, Format, TextureUsage};
use std::time::Instant;

use render::{Renderer, renderer_new};
use state::{Lab, WALK_SPEED};
use ui::{Input, Ui};
use ui_panel::{Status, panel};
use ui_render::{UiRenderer, ui_renderer_new};

fn capture(renderer: &mut Renderer, dev: &gpu::Device<Gpa>, queue: &mut gpu::Queue,
    target: &gpu::Texture, width: i64, height: i64, lab: Lab, time: f64,
    gpa: Gpa) -> Result<Vec<u8, Gpa>, gpu::Error<Gpa>> {
    renderer.draw(dev, queue, &target.view(), lab, time);
    let stride = (width * 4 + 255) / 256 * 256;
    let mut readback = dev.buffer(stride * height, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let mut enc = dev.encoder();
    enc.copy_texture_to_buffer(target, &readback, stride);
    queue.submit(enc.finish());
    let pixels = readback.map_read(dev);
    let mut image: Vec<u8, Gpa> = Vec::new_in(gpa);
    for y in 0..height {
        let row = y * stride;
        for x in 0..width * 4 {
            image.push(pixels[(row + x) as usize]);
        }
    }
    Ok(image)
}

fn write_ppm(path: &str, image: &[u8], width: i64, height: i64, gpa: Gpa) -> bool {
    let mut out: Vec<u8, Gpa> = Vec::new_in(gpa);
    let header = format_in("P6\n{{width}} {{height}}\n255\n", gpa);
    out.extend_from_slice(header.as_bytes());
    // The surface is BGRA: the PPM wants RGB, so swap the first and third.
    for y in 0..height {
        for x in 0..width {
            let at = y * width * 4 + x * 4;
            out.push(image[(at + 2) as usize]);
            out.push(image[(at + 1) as usize]);
            out.push(image[at as usize]);
        }
    }
    match fs::write(path, out.as_slice()) {
        Ok(_) => true,
        Err(_) => false,
    }
}

fn lit_pixels(image: &[u8], width: i64, height: i64) -> i64 {
    let mut lit: i64 = 0;
    for p in 0..width * height {
        let at = p * 4;
        if image[at as usize] as i64 + image[(at + 1) as usize] as i64 + image[(at + 2) as usize] as i64 > 24 {
            lit += 1;
        }
    }
    lit
}

/// Pixels that differ by more than `slack` in any channel: a flat threshold
/// keeps ACES rounding from counting as a change.
fn differing(a: &[u8], b: &[u8], width: i64, height: i64, slack: i64) -> i64 {
    let mut n: i64 = 0;
    for p in 0..width * height {
        let at = p * 4;
        let dr = image_delta(a[at as usize], b[at as usize]);
        let dg = image_delta(a[(at + 1) as usize], b[(at + 1) as usize]);
        let db = image_delta(a[(at + 2) as usize], b[(at + 2) as usize]);
        if dr > slack || dg > slack || db > slack { n += 1; }
    }
    n
}

fn image_delta(a: u8, b: u8) -> i64 {
    let d = a as i64 - b as i64;
    if d < 0 { -d } else { d }
}

fn detail(image: &[u8], width: i64, height: i64) -> i64 {
    // Sum of |neighbour difference| over the green channel: a cheap measure
    // of how much structure is in the frame.
    let mut sum: i64 = 0;
    for y in 0..height {
        for x in 1..width {
            let at = (y * width + x) * 4 + 1;
            sum += image_delta(image[at as usize], image[(at - 4) as usize]);
        }
    }
    sum
}

fn capture_ui(renderer: &mut Renderer, ui_renderer: &mut UiRenderer, dev: &gpu::Device<Gpa>,
    queue: &mut gpu::Queue, target: &gpu::Texture, width: i64, height: i64, lab: &mut Lab,
    time: f64, scale: f64, gpa: Gpa) -> Result<Vec<u8, Gpa>, gpu::Error<Gpa>> {
    let mut ui = Ui::new_in(gpa);
    ui.begin(Input {
        x: -100.0, y: -100.0, down: false, press: false, release: false,
        wheel: 0.0, w: width as f64, h: height as f64, scale: scale,
    });
    let actions = panel(&mut ui, lab, Status { fps: 60.0, ms: 16.0 }, gpa);
    ui.end();
    let _ = actions;
    renderer.draw(dev, queue, &target.view(), *lab, time);
    ui_renderer.draw(dev, queue, &target.view(), ui.verts.as_slice());
    let stride = (width * 4 + 255) / 256 * 256;
    let mut readback = dev.buffer(stride * height, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let mut enc = dev.encoder();
    enc.copy_texture_to_buffer(target, &readback, stride);
    queue.submit(enc.finish());
    let pixels = readback.map_read(dev);
    let mut image: Vec<u8, Gpa> = Vec::new_in(gpa);
    for y in 0..height {
        for x in 0..width * 4 {
            image.push(pixels[(y * stride + x) as usize]);
        }
    }
    Ok(image)
}

/// Render a still frame, a moving one, the same motion at the slider's other end, and (with
/// `--ui`) the panel over the moving frame. The checks are the experiment in
/// miniature: the frame is lit and detailed, velocity changes it, the slider
/// changes it, and the panel is actually drawn.
pub fn run(width: i64, height: i64, out: &str, lab: Lab, with_ui: bool, ui_scale: f64,
    gpa: Gpa) -> i32 {
    let lab = lab;
    println("relativity {width}x{height}, c = {:.3}x walking speed", lab.mult);
    let inst = gpu::Instance::new_in(gpa);
    let opened = match inst.adapter() {
        Ok(a) => a.device(),
        Err(e) => Err(e),
    };
    let (dev, mut queue) = match opened {
        Ok(pair) => pair,
        Err(e) => {
            eprintln("relativity: no GPU: {{e}}");
            return 1;
        }
    };
    let mut renderer = match renderer_new(&dev, width, height) {
        Ok(r) => r,
        Err(e) => {
            eprintln("relativity: renderer: {{e}}");
            return 1;
        }
    };
    let target = dev.texture(width, height, Format::Bgra8Unorm,
        usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);
    let clock = Instant::now();

    // RELATIVITY_BENCH set: time 30 frames (traced and displayed, one readback
    // at the end) at this size, as the window draws them, and stop.
    if std::env::var_os_in("RELATIVITY_BENCH", gpa).is_some() {
        let _ = capture(&mut renderer, &dev, &mut queue, &target, width, height, lab, 0.0, gpa);
        let t0 = Instant::now();
        for i in 0..30 {
            renderer.draw(&dev, &mut queue, &target.view(), lab, i as f64);
        }
        // One readback waits for the 30 draws.
        let _ = capture(&mut renderer, &dev, &mut queue, &target, width, height, lab, 30.0, gpa);
        let ms = t0.elapsed().as_secs_f64() * 1000.0 / 30.0;
        println("bench {{width}}x{{height}}: {{ms:.2}} ms a frame");
        return 0;
    }

    // A frame with no velocity: the reference the moving frames differ from.
    let mut still = lab;
    still.set_velocity(0.0, 0.0);
    let still_img = match capture(&mut renderer, &dev, &mut queue, &target, width, height, still,
        0.0, gpa) {
        Ok(image) => image,
        Err(e) => {
            eprintln("relativity: capture: {{e}}");
            return 1;
        }
    };

    // The same multiplier, walking. The demo speed is 0.9c at low multipliers
    // and a fixed 0.9 * 1.5 * v_walk above them, so 10x shows the same
    // velocity with the effects gone.
    let mut moving = lab;
    if moving.beta() <= 0.0 {
        let speed = (0.9 * moving.c()).min(0.9 * 1.5 * WALK_SPEED);
        moving.set_velocity(moving.yaw.sin() * speed, -moving.yaw.cos() * speed);
    }
    let walk = match capture(&mut renderer, &dev, &mut queue, &target, width, height, moving, 0.0,
        gpa) {
        Ok(image) => image,
        Err(e) => {
            eprintln("relativity: capture: {{e}}");
            return 1;
        }
    };
    println("moving at v = {:.3} m/s, v/c = {:.4}, gamma = {:.3}", moving.speed(), moving.beta(),
        moving.gamma());

    // The other end of the slider at the same velocity.
    let mut far = moving;
    far.set_mult(if moving.mult > 5.0 { 1.5 } else { 10.0 });
    let far_img = match capture(&mut renderer, &dev, &mut queue, &target, width, height, far, 0.0,
        gpa) {
        Ok(image) => image,
        Err(e) => {
            eprintln("relativity: capture: {{e}}");
            return 1;
        }
    };
    println("compared with c = {:.3}x: v/c = {:.4}, gamma = {:.3}", far.mult, far.beta(),
        far.gamma());

    // (The ok lines print no measurements, so a test can pin them; a FAIL
    // line prints them.) Measured before the walk's image becomes the composed one.
    let motion = differing(still_img.as_slice(), walk.as_slice(), width, height, 2);
    let slider = differing(walk.as_slice(), far_img.as_slice(), width, height, 2);
    let mut image = walk;
    let mut ui_ok = true;
    if with_ui {
        let mut ui_renderer = match ui_renderer_new(&dev, &mut queue, gpa) {
            Ok(r) => r,
            Err(e) => {
                eprintln("relativity: UI renderer: {{e}}");
                return 1;
            }
        };
        let composed = match capture_ui(&mut renderer, &mut ui_renderer, &dev, &mut queue, &target,
            width, height, &mut moving, 0.0, ui_scale, gpa) {
            Ok(image) => image,
            Err(e) => {
                eprintln("relativity: UI capture: {{e}}");
                return 1;
            }
        };
        let ui_diff = differing(image.as_slice(), composed.as_slice(), width, height, 2);
        if ui_diff < (width * height / 50).max(1) {
            ui_ok = false;
            println("ui FAIL ({{ui_diff}} pixels changed by the panel)");
        } else {
            println("ui ok");
        }
        image = composed;
    }

    let lit = lit_pixels(image.as_slice(), width, height);
    let structure = detail(image.as_slice(), width, height);
    let need = (width * height / 20).max(1);
    let mut rendered_ok = ui_ok;
    if lit < width * height / 2 {
        rendered_ok = false;
        println("render FAIL ({lit} of {} pixels lit)", width * height);
    } else {
        println("render ok");
    }
    // Edges grow with the frame's size, not its area: the bar is per pixel
    // of perimeter, so a blank or blown-out frame fails at every size.
    if structure < (width + height) * 8 {
        rendered_ok = false;
        println("detail FAIL ({{structure}})");
    } else {
        println("detail ok");
    }
    // Near 10x the walk is v/c ~ 0.1: the effects are faint, as they
    // should be, and the frame need not change.
    if motion < need && moving.beta() > 0.05 {
        rendered_ok = false;
        println("motion FAIL ({{motion}} pixels changed)");
    } else {
        println("motion ok");
    }
    if slider < need {
        rendered_ok = false;
        println("slider FAIL ({{slider}} pixels changed)");
    } else {
        println("slider ok");
    }

    if out.len() > 0 {
        if write_ppm(out, image.as_slice(), width, height, gpa) {
            println("wrote {{out}}");
        } else {
            eprintln("relativity: could not write {{out}}");
            return 1;
        }
    }
    if rendered_ok {
        let elapsed = clock.elapsed().as_secs_f64();
        println("frames ok");
        0
    } else {
        1
    }
}
