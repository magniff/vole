// The simulation's state and its physics: one walking observer in a village,
// moving at a speed set by a single slider. Everything relativistic is derived
// from the instantaneous velocity, never from the slider alone.
//
// The panel, the presets, the keyboard and the orbs all write `mult` through
// `set_mult`, so there is exactly one value for c in the program.

use std::{clamp, max, min};

/// The observer's reference walking speed, in metres per second. It is a
/// property of the world (a comfortable pace), not of the current input: the
/// slider is expressed as a multiple of it.
pub const WALK_SPEED: f64 = 4.0;
/// Shift multiplies the pace, so at the low end of the slider the observer can
/// reach the velocity limit and feel it.
pub const SPRINT: f64 = 1.6;
pub const MIN_MULT: f64 = 1.1;
pub const MAX_MULT: f64 = 1000.0;
/// The velocity limit, as a fraction of c. The observer never reaches c: the
/// margin keeps gamma finite and the shader away from a division by zero.
pub const BETA_LIMIT: f64 = 0.999;
pub const EYE_HEIGHT: f64 = 1.65;
pub const BOUND: f64 = 30.0;
/// Ground acceleration, in m/s^2: the velocity ramps instead of jumping, so
/// beta and the effects follow the actual motion.
pub const ACCEL: f64 = 16.0;
pub const TURN_SPEED: f64 = 1.8;
pub const ORB_COUNT: i64 = 8;

pub const PRESET_LABELS: [[u8]; 7] = ["1.1x", "1.5x", "2x", "5x", "10x", "100x", "1000x"];
pub const PRESET_MULTS: [f64; 7] = [1.1, 1.5, 2.0, 5.0, 10.0, 100.0, 1000.0];

/// The orbs are a guided tour of the slider: touching one moves the same
/// multiplier the slider moves. They sit in a spiral so the walk between them
/// is part of the experiment.
pub const ORB_X: [f64; 8] = [2.6, -4.2, -8.6, -3.0, 5.4, 10.2, 4.0, -9.0];
pub const ORB_Z: [f64; 8] = [5.0, 2.2, -3.4, -8.8, -7.2, -1.0, 8.4, 9.6];
pub const ORB_MULT: [f64; 8] = [1.1, 1.5, 2.0, 3.0, 5.0, 10.0, 100.0, 1000.0];

/// Position of the camera, as the panel and the renderer need it.
pub struct Lab {
    /// c / WALK_SPEED. The single source of truth for the speed of light.
    pub mult: f64,
    pub x: f64,
    pub z: f64,
    pub yaw: f64,
    pub pitch: f64,
    /// Instantaneous world velocity (m/s); y stays zero (walking). Derived
    /// from the proper velocity below by `sync_velocity`, never set alone.
    pub vx: f64,
    pub vz: f64,
    /// Proper velocity (m/s of distance per second of the walker's own
    /// clock, u = gamma v): what walking controls. Any u gives a world speed
    /// below c, so c can never be reached, and a slider change keeps u and
    /// moves v with it.
    pub ux: f64,
    pub uz: f64,
    pub orbs: [bool; 8],
    pub collected: i64,
    /// Seconds left of the "orb 3/8 -> c = 3x" message.
    pub toast: f64,
    pub toast_orb: i64,
    /// 0 doppler, 1 aberration, 2 beaming, 3 contraction.
    pub effects: [bool; 4],
    pub exposure: f64,
}

/// The logarithmic slider: t in [0, 1] maps to the multiplier with equal
/// distances for equal ratios. 1.1x to 2x is a fifth of the track, so the
/// low end where the world changes most gets most of the resolution.
pub fn mult_from_t(t: f64) -> f64 {
    MIN_MULT * (MAX_MULT / MIN_MULT).powf(clamp(t, 0.0, 1.0))
}

pub fn t_from_mult(m: f64) -> f64 {
    (clamp(m, MIN_MULT, MAX_MULT) / MIN_MULT).ln() / (MAX_MULT / MIN_MULT).ln()
}

pub fn lab_default() -> Lab {
    Lab {
        mult: 1.5,
        x: 0.0,
        z: 14.0,
        yaw: 0.0,
        pitch: -0.04,
        vx: 0.0,
        vz: 0.0,
        ux: 0.0,
        uz: 0.0,
        orbs: [false; 8],
        collected: 0,
        toast: 0.0,
        toast_orb: 0,
        effects: [true; 4],
        exposure: 1.15,
    }
}

impl Lab {
    /// The simulated speed of light, in m/s.
    pub fn c(self) -> f64 {
        self.mult * WALK_SPEED
    }

    pub fn speed(self) -> f64 {
        (self.vx * self.vx + self.vz * self.vz).sqrt()
    }

    /// beta = |v| / c, from the instantaneous velocity.
    pub fn beta(self) -> f64 {
        min(self.speed() / self.c(), BETA_LIMIT)
    }

    pub fn gamma(self) -> f64 {
        let b = self.beta();
        1.0 / max(1e-9, 1.0 - b * b).sqrt()
    }

    /// The only writer of the multiplier; every control goes through it. A
    /// lower c also lowers the velocity limit, so the current velocity is
    /// clamped here at once: the observer never exceeds BETA_LIMIT * c even
    /// for the frame in which the slider moves.
    pub fn set_mult(inout self, m: f64) {
        self.mult = clamp(m, MIN_MULT, MAX_MULT);
        self.sync_velocity();
    }

    /// The world velocity from the proper velocity: v = u / sqrt(1 + u^2/c^2),
    /// below c for every u; BETA_LIMIT is only the numerical safety margin.
    pub fn sync_velocity(inout self) {
        let c = self.c();
        let u = (self.ux * self.ux + self.uz * self.uz).sqrt();
        if u == 0.0 {
            self.vx = 0.0;
            self.vz = 0.0;
            return;
        }
        let k = min(1.0 / (1.0 + u * u / (c * c)).sqrt(), BETA_LIMIT * c / u);
        self.vx = self.ux * k;
        self.vz = self.uz * k;
    }

    /// Set the world velocity directly (headless runs, tests): the proper
    /// velocity that gives it, u = gamma v, with v kept under the limit.
    pub fn set_velocity(inout self, vx: f64, vz: f64) {
        let c = self.c();
        let v = (vx * vx + vz * vz).sqrt();
        let s = if v > BETA_LIMIT * c { BETA_LIMIT * c / v } else { 1.0 };
        let b = v * s / c;
        let g = 1.0 / (1.0 - b * b).sqrt();
        self.ux = vx * s * g;
        self.uz = vz * s * g;
        self.sync_velocity();
    }

    /// Move the slider by a fraction of its track (keyboard nudges).
    pub fn nudge(inout self, dt: f64) {
        self.set_mult(mult_from_t(t_from_mult(self.mult) + dt));
    }

    pub fn look(inout self, dx: f64, dy: f64) {
        self.yaw -= dx * 0.0038;
        self.pitch = clamp(self.pitch - dy * 0.0032, -1.2, 1.2);
    }

    pub fn forward(self) -> [f64; 3] {
        let cp = self.pitch.cos();
        [self.yaw.sin() * cp, self.pitch.sin(), -self.yaw.cos() * cp]
    }

    /// Walk for `dt` seconds: accelerate toward the input direction, never let
    /// the speed reach c, move, stay inside the village, then collect orbs.
    pub fn step(inout self, dt: f64, forward: f64, strafe: f64, sprint: bool) {
        let dir_len = (forward * forward + strafe * strafe).sqrt();
        var tx = 0.0;
        var tz = 0.0;
        if dir_len > 0.0 {
            let f = self.forward();
            let fl = (f[0] * f[0] + f[2] * f[2]).sqrt();
            let fx = if fl > 0.0 { f[0] / fl } else { 0.0 };
            let fz = if fl > 0.0 { f[2] / fl } else { -1.0 };
            let rx = self.yaw.cos();
            let rz = self.yaw.sin();
            tx = (fx * forward + rx * strafe) / dir_len;
            tz = (fz * forward + rz * strafe) / dir_len;
        }
        // Walking sets the proper velocity: the walker's own pace, whatever
        // c is. The world velocity follows from it, always below c, so the
        // limit needs no clamp (sync_velocity keeps a numerical margin).
        let pace = WALK_SPEED * if sprint { SPRINT } else { 1.0 };
        var ddx = tx * pace - self.ux;
        var ddz = tz * pace - self.uz;
        let dl = (ddx * ddx + ddz * ddz).sqrt();
        let cap = ACCEL * dt;
        if dl > cap && dl > 0.0 {
            ddx = ddx / dl * cap;
            ddz = ddz / dl * cap;
        }
        self.ux += ddx;
        self.uz += ddz;
        self.sync_velocity();
        self.x = clamp(self.x + self.vx * dt, -BOUND, BOUND);
        self.z = clamp(self.z + self.vz * dt, -BOUND, BOUND);
        if self.toast > 0.0 { self.toast = max(0.0, self.toast - dt); }
        self.pick_up();
    }

    /// Walking into an orb moves the slider to that orb's multiplier, through
    /// `set_mult`. The slider and the orbs therefore cannot disagree.
    pub fn pick_up(inout self) {
        if self.collected >= ORB_COUNT { return; }
        for i in 0..ORB_COUNT {
            if self.orbs[i] { continue; }
            let dx = self.x - ORB_X[i];
            let dz = self.z - ORB_Z[i];
            if dx * dx + dz * dz < 1.6 * 1.6 {
                self.orbs[i] = true;
                self.collected += 1;
                self.set_mult(ORB_MULT[i]);
                self.toast = 2.6;
                self.toast_orb = i;
            }
        }
    }

    /// Bits of the collected orbs, for the shader to stop drawing them.
    pub fn orb_mask(self) -> i64 {
        var mask = 0;
        for i in 0..ORB_COUNT {
            if self.orbs[i] { mask = mask | (1 << i); }
        }
        mask
    }

    pub fn reset(inout self) {
        let fresh = lab_default();
        self.mult = fresh.mult;
        self.x = fresh.x;
        self.z = fresh.z;
        self.yaw = fresh.yaw;
        self.pitch = fresh.pitch;
        self.set_velocity(0.0, 0.0);
        self.orbs = fresh.orbs;
        self.collected = fresh.collected;
        self.toast = fresh.toast;
        self.toast_orb = fresh.toast_orb;
        self.effects = fresh.effects;
        self.exposure = fresh.exposure;
    }

    pub fn reset_view(inout self) {
        self.x = 0.0;
        self.z = 14.0;
        self.yaw = 0.0;
        self.pitch = -0.04;
        self.set_velocity(0.0, 0.0);
    }
}

#[test]
fn the_log_slider_round_trips() {
    for i in 0..=20 {
        let t = i as f64 / 20.0;
        let m = mult_from_t(t);
        let back = t_from_mult(m);
        assert_eq((back - t).abs() < 1e-9, true);
    }
    assert_eq((mult_from_t(0.0) - 1.1).abs() < 1e-12, true);
    assert_eq((mult_from_t(1.0) - 1000.0).abs() < 1e-9, true);
}

#[test]
fn the_low_end_gets_the_resolution() {
    // Equal ratios take equal track: 1.1..2 is 1/5 of the way, 2..10 another
    // fifth, 10..100 a third, 100..1000 a sixth.
    let a = t_from_mult(2.0);
    let b = t_from_mult(10.0);
    let c = t_from_mult(100.0);
    assert_eq(a > 0.07 && a < 0.10, true);
    assert_eq(b > 0.30 && b < 0.35, true);
    assert_eq(c > 0.65 && c < 0.70, true);
    // A linear slider would put 2x at 0.0009: this is the whole point.
    assert_eq(a > 50.0 * (2.0 - 1.1) / (1000.0 - 1.1), true);
}

#[test]
fn presets_land_exactly_on_their_multiplier() {
    var lab = lab_default();
    for i in 0..7 {
        lab.set_mult(PRESET_MULTS[i]);
        assert_eq(lab.mult == PRESET_MULTS[i], true);
        assert_eq((mult_from_t(t_from_mult(lab.mult)) - PRESET_MULTS[i]).abs() < 1e-9, true);
    }
    lab.set_mult(0.5);
    assert_eq(lab.mult == MIN_MULT, true);
    lab.set_mult(5000.0);
    assert_eq(lab.mult == MAX_MULT, true);
}

#[test]
fn beta_and_gamma_follow_the_velocity() {
    var lab = lab_default();
    lab.set_mult(2.0);
    lab.set_velocity(0.0, 0.0);
    assert_eq(lab.beta() == 0.0, true);
    assert_eq(lab.gamma() == 1.0, true);
    // 2x walking speed of light, walking straight ahead at 4 m/s.
    lab.set_velocity(0.0, -4.0);
    assert_eq((lab.beta() - 0.5).abs() < 1e-12, true);
    assert_eq((lab.gamma() - 1.1547005383792515).abs() < 1e-9, true);
}

#[test]
fn the_speed_limit_holds_at_the_lowest_slider() {
    var lab = lab_default();
    lab.set_mult(MIN_MULT);
    var i = 0;
    while i < 400 {
        lab.step(1.0 / 60.0, 1.0, 0.0, true);
        i += 1;
    }
    // A sprint's proper velocity, 1.6 x 4 m/s, against c = 4.4 m/s: the world
    // speed is u / sqrt(1 + u^2/c^2), beta 0.824, approached, never c.
    let u = WALK_SPEED * SPRINT;
    let c = lab.c();
    let want = u / (c * c + u * u).sqrt();
    let b = lab.beta();
    assert_eq((b - want).abs() < 1e-6, true);
    assert_eq(b < BETA_LIMIT, true);
    // Even an absurd proper velocity stays under the limit.
    lab.ux = 1e9;
    lab.uz = 0.0;
    lab.sync_velocity();
    assert_eq(lab.beta() <= BETA_LIMIT + 1e-12, true);
}

#[test]
fn the_slider_moves_beta_at_once() {
    var lab = lab_default();
    lab.set_mult(1000.0);
    var i = 0;
    while i < 120 {
        lab.step(1.0 / 60.0, 1.0, 0.0, false);
        i += 1;
    }
    // At 1000x the walker walks at walking speed: beta about 0.001.
    assert_eq((lab.speed() - WALK_SPEED).abs() < 1e-3, true);
    let fast = lab.beta();
    // The same stride at 1.1x: beta jumps the moment the slider moves.
    lab.set_mult(1.1);
    let slow = lab.beta();
    assert_eq(fast < 0.002, true);
    assert_eq(slow > 0.6 && slow < 0.7, true);
    // And back: the stride was kept, so v is walking speed again.
    lab.set_mult(1000.0);
    assert_eq((lab.speed() - WALK_SPEED).abs() < 1e-3, true);
}

#[test]
fn stopping_removes_the_effects() {
    var lab = lab_default();
    lab.set_mult(1.1);
    var i = 0;
    while i < 120 {
        lab.step(1.0 / 60.0, 1.0, 0.0, true);
        i += 1;
    }
    assert_eq(lab.beta() > 0.8, true);
    i = 0;
    while i < 240 {
        lab.step(1.0 / 60.0, 0.0, 0.0, false);
        i += 1;
    }
    assert_eq(lab.beta() < 1e-6, true);
    assert_eq(lab.gamma() == 1.0, true);
}

#[test]
fn an_orb_moves_the_same_multiplier_as_the_slider() {
    var lab = lab_default();
    lab.set_mult(1.5);
    lab.x = ORB_X[3];
    lab.z = ORB_Z[3];
    lab.step(1.0 / 60.0, 0.0, 0.0, false);
    assert_eq(lab.orbs[3], true);
    assert_eq(lab.mult == ORB_MULT[3], true);
    assert_eq(lab.toast > 0.0, true);
    assert_eq(lab.collected, 1);
    // The slider still wins afterwards, and the two never disagree because
    // they are the same field.
    lab.set_mult(42.0);
    assert_eq(lab.mult == 42.0, true);
    lab.step(1.0 / 60.0, 0.0, 0.0, false);
    assert_eq(lab.mult == 42.0, true);
}

#[test]
fn the_orb_mask_tracks_the_collected_orbs() {
    var lab = lab_default();
    assert_eq(lab.orb_mask(), 0);
    lab.orbs[0] = true;
    lab.orbs[7] = true;
    assert_eq(lab.orb_mask(), 129);
    assert_eq(lab.orb_mask(), 0b10000001);
}

#[test]
fn reset_restores_the_lab() {
    var lab = lab_default();
    lab.set_mult(500.0);
    lab.x = 20.0;
    lab.collected = 4;
    lab.effects[0] = false;
    lab.reset();
    assert_eq(lab.mult == 1.5, true);
    assert_eq(lab.x == 0.0, true);
    assert_eq(lab.collected, 0);
    assert_eq(lab.effects[0], true);
}
