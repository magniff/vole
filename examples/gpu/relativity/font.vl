// A 5 x 7 bitmap font for the immediate-mode UI: ASCII 32 to 126, the
// classic one of character LCDs. Each glyph is five columns of seven
// bits (bit 0 at the top), in two words: columns 0 to 3 in the first, a
// byte each, column 4 in the second. The UI renderer bakes it into an
// R8Unorm atlas once, then draws each character as one textured quad.

pub const GLYPHS: [u32; 190] = [
    0x00000000, 0x00000000, 0x005f0000, 0x00000000, 0x07000700, 0x00000000,
    0x7f147f14, 0x00000014, 0x2a7f2a24, 0x00000012, 0x64081323, 0x00000062,
    0x22554936, 0x00000050, 0x00030500, 0x00000000, 0x41221c00, 0x00000000,
    0x1c224100, 0x00000000, 0x083e0814, 0x00000014, 0x083e0808, 0x00000008,
    0x00305000, 0x00000000, 0x08080808, 0x00000008, 0x00606000, 0x00000000,
    0x04081020, 0x00000002, 0x4549513e, 0x0000003e, 0x407f4200, 0x00000000,
    0x49516142, 0x00000046, 0x4b454121, 0x00000031, 0x7f121418, 0x00000010,
    0x45454527, 0x00000039, 0x49494a3c, 0x00000030, 0x05097101, 0x00000003,
    0x49494936, 0x00000036, 0x29494906, 0x0000001e, 0x00363600, 0x00000000,
    0x00365600, 0x00000000, 0x41221408, 0x00000000, 0x14141414, 0x00000014,
    0x14224100, 0x00000008, 0x09510102, 0x00000006, 0x41794932, 0x0000003e,
    0x1111117e, 0x0000007e, 0x4949497f, 0x00000036, 0x4141413e, 0x00000022,
    0x2241417f, 0x0000001c, 0x4949497f, 0x00000041, 0x0109097f, 0x00000001,
    0x5141413e, 0x00000032, 0x0808087f, 0x0000007f, 0x417f4100, 0x00000000,
    0x3f414020, 0x00000001, 0x2214087f, 0x00000041, 0x4040407f, 0x00000040,
    0x0204027f, 0x0000007f, 0x1008047f, 0x0000007f, 0x4141413e, 0x0000003e,
    0x0909097f, 0x00000006, 0x2151413e, 0x0000005e, 0x2919097f, 0x00000046,
    0x49494946, 0x00000031, 0x017f0101, 0x00000001, 0x4040403f, 0x0000003f,
    0x2040201f, 0x0000001f, 0x2018207f, 0x0000007f, 0x14081463, 0x00000063,
    0x04780403, 0x00000003, 0x45495161, 0x00000043, 0x41417f00, 0x00000000,
    0x10080402, 0x00000020, 0x7f414100, 0x00000000, 0x02010204, 0x00000004,
    0x40404040, 0x00000040, 0x04020100, 0x00000000, 0x54545420, 0x00000078,
    0x4444487f, 0x00000038, 0x44444438, 0x00000020, 0x48444438, 0x0000007f,
    0x54545438, 0x00000018, 0x01097e08, 0x00000002, 0x54541408, 0x0000003c,
    0x0404087f, 0x00000078, 0x407d4400, 0x00000000, 0x3d444020, 0x00000000,
    0x28107f00, 0x00000044, 0x407f4100, 0x00000000, 0x0418047c, 0x00000078,
    0x0404087c, 0x00000078, 0x44444438, 0x00000038, 0x1414147c, 0x00000008,
    0x18141408, 0x0000007c, 0x0404087c, 0x00000008, 0x54545448, 0x00000020,
    0x40443f04, 0x00000020, 0x2040403c, 0x0000007c, 0x2040201c, 0x0000001c,
    0x4030403c, 0x0000003c, 0x28102844, 0x00000044, 0x5050500c, 0x0000003c,
    0x4c546444, 0x00000044, 0x41360800, 0x00000000, 0x007f0000, 0x00000000,
    0x08364100, 0x00000000, 0x04020102, 0x00000002,
];

pub const CELL: i64 = 8;
pub const COLS: i64 = 16;
pub const ATLAS_W: i64 = 128;
pub const ATLAS_H: i64 = 128;
pub const GLYPH_W: i64 = 5;
pub const GLYPH_H: i64 = 7;
pub const ADVANCE: i64 = 6;
pub const CELLS: i64 = 96;

// The white texel that every solid quad samples.
pub const WHITE_U: f64 = 0.5 / 128.0;
pub const WHITE_V: f64 = 0.5 / 128.0;

/// The atlas: glyph n at cell n + 1 (cell 0 is the white texel), five
/// columns by seven rows of ink in each 8 x 8 cell.
pub fn atlas_in(gpa: Gpa) -> Vec<u8> {
    var a: Vec<u8> = Vec::filled_in(ATLAS_W as usize * ATLAS_H as usize, 0, gpa);
    a[0] = 255;
    for g in 0..95 {
        let cell = g + 1;
        let cx = (cell % COLS) * CELL;
        let cy = (cell / COLS) * CELL;
        let w0 = GLYPHS[g * 2];
        let w1 = GLYPHS[g * 2 + 1];
        for gx in 0..GLYPH_W {
            let bits = if gx < 4 { (w0 >> ((gx * 8) as u32)) & 255 } else { w1 & 255 };
            for gy in 0..GLYPH_H {
                if ((bits >> (gy as u32)) & 1) != 0 {
                    a[(cy + gy) * ATLAS_W + cx + gx] = 255;
                }
            }
        }
    }
    a
}

pub struct GlyphUv {
    pub u0: f64,
    pub u1: f64,
    pub v0: f64,
    pub v1: f64,
}

/// The atlas rectangle of one byte: the space glyph for anything outside
/// printable ASCII.
pub fn glyph_uv(ch: u8) -> GlyphUv {
    var c = ch;
    if c < 32 || c > 126 { c = 32; }
    let cell = (c as i64) - 32 + 1;
    let cx = (cell % COLS) * CELL;
    let cy = (cell / COLS) * CELL;
    GlyphUv {
        u0: (cx as f64 + 0.25) / ATLAS_W as f64,
        u1: (cx as f64 + GLYPH_W as f64 - 0.25) / ATLAS_W as f64,
        v0: (cy as f64 + 0.25) / ATLAS_H as f64,
        v1: (cy as f64 + GLYPH_H as f64 - 0.25) / ATLAS_H as f64,
    }
}
