// EDITION: rust
// GPU resources and one frame: a compute pass traces the village for every
// film pixel, a full-screen pass tone-maps it into the surface, and the UI
// pass draws the panel on top. The film is traced at logical resolution so a
// Retina surface costs one fetch per output pixel, not one trace.

use std::gpu;
use std::gpu::{
    BindGroup, Buffer, BufferUsage, ComputePipeline, Format, PassDesc, RenderPipeline, TextureView,
};

use state::{EYE_HEIGHT, Lab, WALK_SPEED};

const SCENE: &str = include_str("scene.wgsl");
const DISPLAY: &str = include_str("display.wgsl");

pub const FOV_DEG: f64 = 62.0;

pub struct Renderer {
    pub width: i64,
    pub height: i64,
    params: Buffer,
    film: Buffer,
    /// The village's boxes, balls and orbs (58 x 48 + 38 x 32 bytes), copied
    /// from the shader's constants by `init` in the first frame.
    scene: Buffer,
    scene_ready: bool,
    init_pipe: ComputePipeline,
    init_group: BindGroup,
    trace_pipe: ComputePipeline,
    trace_group: BindGroup,
    draw_pipe: RenderPipeline,
    draw_group: BindGroup,
}

pub fn renderer_new(dev: &gpu::Device<Gpa>, width: i64, height: i64) -> Result<Renderer,
    gpu::Error<Gpa>> {
    let trace_pipe = dev.compute_pipeline(dev.shader_wgsl(SCENE)?, "main")?;
    let init_pipe = dev.compute_pipeline(dev.shader_wgsl(SCENE)?, "init")?;
    let scene = dev.buffer(58 * 48 + 38 * 32, BufferUsage::STORAGE);
    let init_group = dev.bind_group(init_pipe.bind_layout(0), &[gpu::bind(2, &scene)][..]);
    let draw_pipe = dev.render_pipeline(gpu::RenderDesc::new(
        dev.shader_wgsl(DISPLAY)?, "vs", "fs", Format::Bgra8Unorm,
    ))?;
    let params = dev.buffer(dev.align_uniform(36 * 4),
        BufferUsage::UNIFORM | BufferUsage::COPY_DST);
    let film = dev.buffer(width * height * 16, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
    let trace_group = dev.bind_group(trace_pipe.bind_layout(0), &[
        gpu::bind(0, &params), gpu::bind(1, &film), gpu::bind(2, &scene),
    ][..]);
    let draw_group = dev.bind_group(draw_pipe.bind_layout(0), &[
        gpu::bind(0, &params), gpu::bind(1, &film),
    ][..]);
    Ok(Renderer {
        width: width, height: height, params: params, film: film,
        scene: scene, scene_ready: false, init_pipe: init_pipe, init_group: init_group,
        trace_pipe: trace_pipe, trace_group: trace_group,
        draw_pipe: draw_pipe, draw_group: draw_group,
    })
}

impl Renderer {
    /// A resize only reallocates the film and its two bind groups.
    pub fn resize(&mut self, dev: &gpu::Device<Gpa>, width: i64, height: i64) {
        if width == self.width && height == self.height { return; }
        self.width = width;
        self.height = height;
        self.film = dev.buffer(width * height * 16, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
        self.trace_group = dev.bind_group(self.trace_pipe.bind_layout(0), &[
            gpu::bind(0, &self.params), gpu::bind(1, &self.film), gpu::bind(2, &self.scene),
        ][..]);
        self.draw_group = dev.bind_group(self.draw_pipe.bind_layout(0), &[
            gpu::bind(0, &self.params), gpu::bind(1, &self.film),
        ][..]);
    }

    fn pack(&self, lab: Lab, time: f64) -> [f32; 36] {
        let cp = lab.pitch.cos();
        let f = [lab.yaw.sin() * cp, lab.pitch.sin(), -lab.yaw.cos() * cp];
        let r = [lab.yaw.cos(), 0.0, lab.yaw.sin()];
        let up = [
            -lab.yaw.sin() * lab.pitch.sin(),
            cp,
            lab.yaw.cos() * lab.pitch.sin(),
        ];
        let c = lab.c();
        let b = lab.beta();
        let mut u: [f32; 36] = [0.0; 36];
        u[0] = lab.x as f32;
        u[1] = EYE_HEIGHT as f32;
        u[2] = lab.z as f32;
        u[3] = time as f32;
        u[4] = f[0] as f32;
        u[5] = f[1] as f32;
        u[6] = f[2] as f32;
        u[7] = (FOV_DEG * 3.141592653589793 / 360.0).tan() as f32;
        u[8] = r[0] as f32;
        u[9] = r[1] as f32;
        u[10] = r[2] as f32;
        u[11] = (self.width as f32) / (self.height as f32);
        u[12] = up[0] as f32;
        u[13] = up[1] as f32;
        u[14] = up[2] as f32;
        // The eye adapts to the forward beam: beaming scales radiance by D^3,
        // D = gamma (1 + beta) straight ahead, so the exposure is divided by
        // D^2. Ahead stays readable (about D times brighter), behind goes dark,
        // and at rest D = 1 changes nothing.
        let d_ahead = if lab.effects[2] { lab.gamma() * (1.0 + b) } else { 1.0 };
        u[15] = (lab.exposure / (d_ahead * d_ahead)) as f32;
        u[16] = (lab.vx as f32) / (c as f32);
        u[17] = 0.0;
        u[18] = (lab.vz as f32) / (c as f32);
        u[19] = b as f32;
        u[20] = lab.gamma() as f32;
        u[21] = lab.mult as f32;
        u[22] = WALK_SPEED as f32;
        u[23] = 0.0;
        for i in 0..4 {
            u[(24 + i) as usize] = if lab.effects[i as usize] { 1.0 } else { 0.0 };
        }
        u[28] = 0.42;
        u[29] = 0.78;
        u[30] = 0.46;
        u[31] = 2.1;
        u[32] = lab.orb_mask() as f32;
        u[33] = self.width as f32;
        u[34] = self.height as f32;
        u[35] = 0.0;
        u
    }

    pub fn draw(&mut self, dev: &gpu::Device<Gpa>, queue: &mut gpu::Queue, target: &TextureView,
        lab: Lab, time: f64) {
        let uniform = self.pack(lab, time);
        queue.write_buffer(&self.params, 0, gpu::bytes_of_f32(&uniform[..]));
        let trace_pipe = &self.trace_pipe;
        let trace_group = &self.trace_group;
        let draw_pipe = &self.draw_pipe;
        let draw_group = &self.draw_group;
        let (w, h) = (self.width, self.height);
        let mut enc = dev.encoder();
        if !self.scene_ready {
            let init_pipe = &self.init_pipe;
            let init_group = &self.init_group;
            enc.compute_pass(|pass| {
                pass.set_pipeline(init_pipe);
                pass.set_bind_group(0, init_group);
                pass.dispatch(1, 1, 1);
            });
            self.scene_ready = true;
        }
        enc.compute_pass(|pass| {
            pass.set_pipeline(trace_pipe);
            pass.set_bind_group(0, trace_group);
            pass.dispatch((w + 7) / 8, (h + 7) / 8, 1);
        });
        enc.render_pass(PassDesc::color(target, gpu::Color::black(), gpu::Load::Clear), |pass| {
            pass.set_pipeline(draw_pipe);
            pass.set_bind_group(0, draw_group);
            pass.draw(0..3, 0..1);
        });
        queue.submit(enc.finish());
    }
}
