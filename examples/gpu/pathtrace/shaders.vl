// WGSL for the path tracer. The compute shader owns intersection, PBR material
// sampling, rectangular area-light sampling, homogeneous fog, diagnostics and
// progressive moments. The render shader tone-maps the same GPU buffers and
// draws the compact instrument overlay; no full-image CPU readback is involved.

pub const TRACE: [u8] = include_str("trace.wgsl");

pub const DISPLAY: [u8] = include_str("display.wgsl");
