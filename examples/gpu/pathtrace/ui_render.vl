// The UI's GPU side: one 5 x 7 glyph atlas (built once in font.vl), one
// vertex buffer rewritten per frame from ui.verts, and one alpha-blended
// render pass over the image the path tracer just presented. The pass
// loads the target instead of clearing it, so the panel floats over the
// scene without a second texture or a CPU composite.

use std::gpu;
use std::gpu::{
    BindGroup, Buffer, BufferUsage, Format, Load, PassDesc, RenderPipeline, SamplerDesc, Texture,
    TextureView, VertexFormat, VertexLayout,
};

use font::{ATLAS_H, ATLAS_W, atlas_in};

embed wgsl UI_WGSL from "ui.wgsl";

// 4096 quads: a panel of ~200 shapes and ~1200 characters is well inside.
const MAX_VERTS: i64 = 4096 * 6;

pub struct UiRenderer {
    pipe: RenderPipeline,
    group: BindGroup,
    vb: Buffer,
    atlas: Texture,
}

pub fn ui_renderer_new(dev: gpu::Device, queue: inout gpu::Queue,
    gpa: Gpa) -> Result<UiRenderer, gpu::Error> {
    let shader = dev.shader_wgsl(UI_WGSL.src)?;
    var desc = gpu::RenderDesc::new(shader, "vs", "fs", Format::Bgra8Unorm);
    var layout = VertexLayout::new(32);
    layout.attribute(0, VertexFormat::Float32x2, 0);
    layout.attribute(1, VertexFormat::Float32x4, 8);
    layout.attribute(2, VertexFormat::Float32x2, 24);
    desc.vertex_buffer(layout);
    desc.blend(gpu::Blend::alpha());
    let pipe = dev.render_pipeline(desc)?;
    let atlas = dev.texture(ATLAS_W, ATLAS_H, Format::R8Unorm);
    let texels = atlas_in(gpa);
    queue.write_texture(atlas, texels.as_slice(), ATLAS_W);
    let sampler = dev.sampler(SamplerDesc::nearest());
    let group = dev.bind_group(pipe.bind_layout(0), [
        gpu::bind_texture(0, atlas.view()), gpu::bind_sampler(1, sampler),
    ][..]);
    let vb = dev.buffer(MAX_VERTS * 32, BufferUsage::VERTEX | BufferUsage::COPY_DST);
    Ok(UiRenderer { pipe: pipe, group: group, vb: vb, atlas: atlas })
}

impl UiRenderer {
    /// Blend the frame's draw list over `target`. Call after the scene's
    /// passes and before presenting the window's frame.
    pub fn draw(inout self, dev: gpu::Device, queue: inout gpu::Queue, target: TextureView,
        verts: [f32]) {
        let count = verts.len() / 8;
        if count == 0 { return; }
        queue.write_buffer(self.vb, 0, gpu::bytes_of_f32(verts));
        let pipe = self.pipe;
        let group = self.group;
        let vb = self.vb;
        var enc = dev.encoder();
        enc.render_pass(PassDesc::color(target, load: Load::Keep), |pass| {
            pass.set_pipeline(pipe);
            pass.set_bind_group(0, group);
            pass.set_vertex_buffer(0, vb);
            pass.draw(0..count as i64, 0..1);
        });
        queue.submit(enc.finish());
    }
}
