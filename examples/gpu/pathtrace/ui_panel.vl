// EDITION: rust
// The laboratory panel: one accordion of five sections, drawn with the
// immediate-mode widgets in ui.vl. Every control writes the same Lab the
// keyboard shortcuts write, so both paths stay one implementation.
//
// Layout is in UI points (ui.u physical pixels each). The panel is a fixed
// 300 points wide and as tall as the open section needs, so it fits a
// 1280 x 720 window even at scale 2 and never needs a scrollbar.

use state::{Lab, SCENES, SCENE_NAMES, SCENE_TAGLINES};
use ui::{ACCENT, BG, BORDER, DIM, FAINT, GOOD, HEADER, Rect, TEXT, Ui, WARN, fmt_f64};

pub const WIDTH: f64 = 300.0;
const PAD: f64 = 14.0;
const HEAD: f64 = 66.0;
const TAB: f64 = 28.0;
const FOOT: f64 = 24.0;
const TABS: i64 = 5;

const TAB_NAMES: [&[u8]; 5] = [b"SCENE", b"CAMERA", b"ATMOSPHERE", b"MATERIAL", b"DISPLAY"];
const MATERIAL_NAMES: [&[u8]; 4] = [b"M1 diffuse", b"M2 glass", b"M3 chrome", b"M4 gold"];
const MATERIAL_SHORT: [&[u8]; 4] = [b"M1", b"M2", b"M3", b"M4"];
const DEBUG_ITEMS: [&[u8]; 16] = [b"beauty", b"normals", b"albedo", b"depth", b"traversal",
    b"material ids", b"bounce depth", b"variance", b"ray path", b"", b"", b"", b"", b"", b"", b""];
const DEBUG_NAMES: [&[u8]; 9] = [b"beauty", b"normals", b"albedo", b"depth", b"traversal",
    b"material ids", b"bounce depth", b"variance", b"ray path"];

const TAB_HOVER: [f32; 4] = [0.055, 0.065, 0.085, 1.0];
const TAB_HINT: [f32; 4] = [0.30, 0.34, 0.40, 1.0];

const SCENE_STRIPES: [[f32; 4]; 4] = [
    [0.94, 0.33, 0.18, 1.0],
    [0.40, 0.78, 0.98, 1.0],
    [0.28, 0.58, 0.96, 1.0],
    [0.68, 0.73, 0.82, 1.0],
];

const BASE_COLORS: [[f32; 3]; 6] = [
    [0.72, 0.075, 0.045], [0.035, 0.28, 0.72], [0.06, 0.55, 0.24],
    [0.83, 0.48, 0.12], [0.84, 0.89, 0.96], [0.42, 0.08, 0.62],
];
const TINTS: [[f32; 3]; 4] = [
    [1.0, 1.0, 1.0], [0.55, 0.85, 0.95], [0.95, 0.72, 0.38], [0.90, 0.42, 0.62],
];
const LIGHT_COLORS: [[f32; 3]; 4] = [
    [1.0, 0.91, 0.78], [1.0, 1.0, 1.0], [0.62, 0.78, 1.0], [1.0, 0.28, 0.16],
];
const FOG_COLORS: [[f32; 3]; 4] = [
    [0.94, 0.96, 1.0], [0.62, 0.78, 0.95], [1.0, 0.86, 0.66], [0.55, 0.62, 0.75],
];

#[derive(Clone, Copy)]
pub struct Status {
    pub samples: i64,
    pub max_samples: i64,
    pub fps: f64,
    pub ms: f64,
    pub width: i64,
    pub height: i64,
    pub paused: bool,
}

#[derive(Clone, Copy)]
pub struct Actions {
    pub toggle_pause: bool,
    pub reset_accum: bool,
    pub restore: bool,
}

fn none() -> Actions {
    Actions { toggle_pause: false, reset_accum: false, restore: false }
}

fn same3(a: [f32; 3], b: [f32; 3]) -> bool {
    let d0 = a[0] - b[0];
    let d1 = a[1] - b[1];
    let d2 = a[2] - b[2];
    let e0 = if d0 < 0.0 { -d0 } else { d0 };
    let e1 = if d1 < 0.0 { -d1 } else { d1 };
    let e2 = if d2 < 0.0 { -d2 } else { d2 };
    e0 < 0.02 && e1 < 0.02 && e2 < 0.02
}

fn content_height(section: i64) -> f64 {
    match section {
        0 => 200.0,
        1 => 209.0,
        2 => 389.0,
        3 => 384.0,
        _ => 150.0,
    }
}

/// One frame of the panel. The caller runs `ui.end()` afterwards, which
/// draws the open dropdown last, above the panel.
pub fn panel(ui: &mut Ui<Gpa>, lab: &mut Lab, st: Status) -> Actions {
    let mut act = none();
    let u = ui.u;
    if ui.hidden {
        let bw = 88.0 * u;
        let bh = 24.0 * u;
        let x = ui.inp.w - bw - 12.0 * u;
        let y = 12.0 * u;
        ui.full_clip();
        ui.over = ui.inp.x >= x && ui.inp.x < x + bw && ui.inp.y >= y && ui.inp.y < y + bh;
        if ui.button(9000, x, y, bw, bh, b"SHOW UI") {
            ui.hidden = false;
        }
        return act;
    }

    let x0 = ui.panel_x;
    let y0 = ui.panel_y;
    let pw = WIDTH * u;
    let tabs_y = y0 + HEAD * u;
    let hide_w = 54.0 * u;
    let hide_x = x0 + pw - PAD * u - hide_w;

    // Tabs answer on press, before the height (and so the background) is
    // computed: opening a section grows the panel in the same frame.
    for i in 0..TABS {
        let ty = tabs_y + TAB * u * i as f64;
        if ui.click_here(x0, ty, pw, TAB * u) {
            ui.section = i;
        }
    }
    let open = ui.section;
    let ch = content_height(open);
    let ph = (HEAD + TAB * TABS as f64 + ch + FOOT) * u;

    // The title bar drags the panel; the hide button carves itself out.
    ui.drag_panel(x0, y0, pw, HEAD * u, hide_x, hide_w);
    let x = ui.panel_x;
    let y = ui.panel_y;
    let hide_x = x + pw - PAD * u - hide_w;
    ui.panel_h = ph;
    ui.over = ui.inp.x >= x && ui.inp.x < x + pw && ui.inp.y >= y && ui.inp.y < y + ph;
    ui.full_clip();

    // Background, a soft shadow, a header band and the sample progress.
    ui.rect(x + 5.0 * u, y + 5.0 * u, pw, ph, [0.0, 0.0, 0.0, 0.30]);
    ui.rect(x, y, pw, ph, BG);
    ui.outline(x, y, pw, ph, u, BORDER);
    ui.rect(x, y, pw, 2.0 * u, ACCENT);
    ui.rect(x + PAD * u, y + HEAD * u - u, pw - 2.0 * PAD * u, u, BORDER);
    ui.rect(x + PAD * u, y + 11.0 * u, 3.0 * u, 14.0 * u, ACCENT);
    ui.text(x + 23.0 * u, y + 8.0 * u, b"PATHTRACE", TEXT);
    // Three lines: the name, the scene with the samples, the mode with the
    // frame rate. HIDE sits on the first line only.
    ui.text(x + 23.0 * u, y + 24.0 * u, SCENE_NAMES[lab.scene.clamp(0, SCENES - 1) as usize], DIM);
    ui.text(x + 23.0 * u, y + 40.0 * u, b"tracing lab", FAINT);
    let right = x + pw - PAD * u;
    let mut buf: [u8; 32] = [32; 32];
    let mut at = fmt_f64(st.samples as f64, 0, &mut buf);
    let sw = ui.text_width(&buf[at as usize..32]);
    ui.text_right(x, y + 24.0 * u, right - sw - 6.0 * u, b"spp", FAINT);
    ui.text_right(x, y + 24.0 * u, right, &buf[at as usize..32], ACCENT);
    at = fmt_f64(st.fps, 0, &mut buf);
    let fw = ui.text_width(&buf[at as usize..32]);
    ui.text_right(x, y + 40.0 * u, right - fw - 6.0 * u, b"fps", FAINT);
    ui.text_right(x, y + 40.0 * u, right, &buf[at as usize..32], DIM);

    let bar_x = x + PAD * u;
    let bar_w = pw - 2.0 * PAD * u;
    let frac = if st.max_samples > 0 { st.samples as f64 / st.max_samples as f64 } else { 1.0 };
    ui.rect(bar_x, y + HEAD * u - 9.0 * u, bar_w, 4.0 * u, [0.06, 0.075, 0.10, 1.0]);
    ui.rect(bar_x, y + HEAD * u - 9.0 * u, bar_w * frac.clamp(0.0, 1.0), 4.0 * u,
        if st.paused { WARN } else { ACCENT });
    if ui.button(9001, hide_x, y + 6.0 * u, hide_w, 18.0 * u, b"HIDE") {
        ui.hidden = true;
    }

    // The tab strip.
    for i in 0..TABS {
        let ty = y + HEAD * u + TAB * u * i as f64;
        let on = i == open;
        let hovered = ui.inp.x >= x && ui.inp.x < x + pw
            && ui.inp.y >= ty && ui.inp.y < ty + TAB * u;
        ui.rect(x + u, ty, pw - 2.0 * u, TAB * u - u,
            if on { HEADER } else if hovered { TAB_HOVER } else { BG });
        if on {
            ui.rect(x + u, ty, 3.0 * u, TAB * u - u, ACCENT);
        }
        let ty_text = ty + (TAB * u - 7.0 * ui.font) * 0.5;
        ui.text(x + PAD * u, ty_text, if on { b"v" } else { b">" },
            if on { ACCENT } else { FAINT });
        ui.text(x + (PAD + 16.0) * u, ty_text, TAB_NAMES[i as usize],
            if on { TEXT } else if hovered { DIM } else { FAINT });
        let hint = match i {
            0 => SCENE_NAMES[lab.scene as usize],
            1 => b"orbit",
            2 => b"fog",
            3 => MATERIAL_SHORT[lab.selected as usize],
            _ => DEBUG_NAMES[lab.debug.clamp(0, 8) as usize],
        };
        ui.text_right(x, ty_text, x + pw - PAD * u, hint,
            if on { DIM } else { TAB_HINT });
    }

    let cx = x + PAD * u;
    let cy = tabs_y + TAB * TABS as f64 * u + 8.0 * u;
    let cw = pw - 2.0 * PAD * u;
    let clip_h = ph - (cy - y) - FOOT * u;
    ui.set_clip(Rect { x: cx, y: cy, w: cw, h: if clip_h > 0.0 { clip_h } else { 0.0 } });
    match open {
        0 => draw_scene(ui, lab, cx, cy, cw),
        1 => draw_camera(ui, lab, cx, cy, cw),
        2 => draw_atmosphere(ui, lab, cx, cy, cw),
        3 => draw_material(ui, lab, cx, cy, cw),
        _ => draw_display(ui, lab, st, cx, cy, cw),
    }

    // Pause and reset live under every section, in the footer.
    ui.set_clip(Rect { x: cx, y: y + ph - FOOT * u, w: cw, h: FOOT * u });
    let fy = y + ph - FOOT * u + 1.0 * u;
    if ui.button(9100, cx, fy - 2.0 * u, 66.0 * u, 20.0 * u,
        if st.paused { b"RESUME" } else { b"PAUSE" }) {
        act.toggle_pause = true;
    }
    if ui.button(9101, cx + 74.0 * u, fy - 2.0 * u, 66.0 * u, 20.0 * u, b"CLEAR") {
        act.reset_accum = true;
    }
    if ui.button(9102, cx + 148.0 * u, fy - 2.0 * u, 116.0 * u, 20.0 * u, b"RESET ALL") {
        act.restore = true;
    }
    return act;
}

fn draw_scene(ui: &mut Ui<Gpa>, lab: &mut Lab, x: f64, y: f64, w: f64) {
    let u = ui.u;
    let ch = 42.0 * u;
    for i in 0..SCENES {
        let by = y + (ch + 4.0 * u) * i as f64;
        let on = i == lab.scene;
        if ui.card(1000 + i, x, by, w, ch, SCENE_NAMES[i as usize], SCENE_TAGLINES[i as usize],
            SCENE_STRIPES[i as usize], on) && !on {
            lab.apply_scene(i);
            ui.mark_reset();
        }
    }
}

fn draw_camera(ui: &mut Ui<Gpa>, lab: &mut Lab, x: f64, y: f64, w: f64) {
    let u = ui.u;
    let mut yy = y;
    if ui.slider(1100, x, yy, w, 40.0 * u, b"field of view", &mut lab.fov, 18.0, 100.0, 0, b"deg") {
        ui.mark_reset();
    }
    yy += 45.0 * u;
    let dof = lab.aperture > 0.001;
    if ui.toggle(1101, x, yy, w, 26.0 * u, b"depth of field", dof) {
        lab.aperture = if dof { 0.0 } else { 0.08 };
        ui.mark_reset();
    }
    yy += 31.0 * u;
    if ui.slider(1102, x, yy, w, 40.0 * u, b"aperture", &mut lab.aperture, 0.0, 0.5, 2, b"") {
        ui.mark_reset();
    }
    yy += 45.0 * u;
    if ui.slider(1103, x, yy, w, 40.0 * u, b"focus distance", &mut lab.focus, 0.5, 22.0, 1, b"m") {
        ui.mark_reset();
    }
    yy += 45.0 * u;
    let bw = (w - 6.0 * u) * 0.5;
    if ui.button(1104, x, yy, bw, 28.0 * u, b"FOCUS") {
        lab.focus_selected();
        ui.mark_reset();
    }
    if ui.button(1105, x + bw + 6.0 * u, yy, bw, 28.0 * u, b"RESET VIEW") {
        lab.reset_view();
        ui.mark_reset();
    }
}

fn draw_atmosphere(ui: &mut Ui<Gpa>, lab: &mut Lab, x: f64, y: f64, w: f64) {
    let u = ui.u;
    let sw = (w - 3.0 * 6.0 * u) * 0.25;
    let mut yy = y;
    let fog = lab.fog_density > 0.0;
    if ui.toggle(1200, x, yy, w, 26.0 * u, b"volumetric fog", fog) {
        lab.fog_density = if fog { 0.0 } else { 0.045 };
        ui.mark_reset();
    }
    yy += 31.0 * u;
    if ui.slider(1201, x, yy, w, 40.0 * u, b"density", &mut lab.fog_density,
        0.0, 0.12, 3, b"1/m") {
        ui.mark_reset();
    }
    yy += 45.0 * u;
    if ui.slider(1202, x, yy, w, 40.0 * u, b"anisotropy", &mut lab.fog_anisotropy,
        -0.85, 0.85, 2, b"g") {
        ui.mark_reset();
    }
    yy += 45.0 * u;
    ui.text(x, yy, b"fog color", DIM);
    for i in 0..4 {
        let sx = x + (sw + 6.0 * u) * i as f64;
        if ui.swatch(1210 + i, sx, yy + 18.0 * u, sw, 16.0 * u, FOG_COLORS[i as usize],
            same3(lab.fog_color, FOG_COLORS[i as usize])) {
            lab.fog_color = FOG_COLORS[i as usize];
            ui.mark_reset();
        }
    }
    yy += 46.0 * u;
    if ui.slider(1203, x, yy, w, 40.0 * u, b"environment", &mut lab.environment,
        0.0, 4.0, 2, b"") {
        ui.mark_reset();
    }
    yy += 45.0 * u;
    if ui.slider(1204, x, yy, w, 40.0 * u, b"light intensity", &mut lab.light_intensity,
        0.0, 30.0, 1, b"") {
        ui.mark_reset();
    }
    yy += 45.0 * u;
    if ui.slider(1205, x, yy, w, 40.0 * u, b"light height", &mut lab.light_y,
        1.0, 12.0, 1, b"m") {
        ui.mark_reset();
    }
    yy += 45.0 * u;
    ui.text(x, yy, b"light color", DIM);
    for i in 0..4 {
        let sx = x + (sw + 6.0 * u) * i as f64;
        if ui.swatch(1220 + i, sx, yy + 18.0 * u, sw, 16.0 * u, LIGHT_COLORS[i as usize],
            lab.light_palette == i as i64) {
            lab.light_color = LIGHT_COLORS[i as usize];
            lab.light_palette = i as i64;
            ui.mark_reset();
        }
    }
    yy += 46.0 * u;
    if ui.toggle(1206, x, yy, w, 26.0 * u, b"global illumination", lab.gi) {
        lab.gi = !lab.gi;
        ui.mark_reset();
    }
}

fn draw_material(ui: &mut Ui<Gpa>, lab: &mut Lab, x: f64, y: f64, w: f64) {
    let u = ui.u;
    let i = lab.selected.clamp(0, 3);
    let cw = (w - 3.0 * 4.0 * u) * 0.25;
    let mut yy = y;
    for k in 0..4 {
        if ui.chip(1300 + k, x + (cw + 4.0 * u) * k as f64, yy, cw, 24.0 * u,
            MATERIAL_SHORT[k as usize], k == i) {
            lab.selected = k;
            lab.palette = 0;
            lab.tint_palette = 0;
            ui.mark_reset();
        }
    }
    yy += 27.0 * u;
    ui.text(x, yy, MATERIAL_NAMES[i as usize], DIM);
    yy += 18.0 * u;
    let sw = (w - 5.0 * 6.0 * u) / 6.0;
    for k in 0..6 {
        if ui.swatch(1310 + k, x + (sw + 6.0 * u) * k as f64, yy, sw, 18.0 * u,
            BASE_COLORS[k as usize], lab.palette == k as i64) {
            lab.materials[i as usize].data[0] = BASE_COLORS[k as usize][0];
            lab.materials[i as usize].data[1] = BASE_COLORS[k as usize][1];
            lab.materials[i as usize].data[2] = BASE_COLORS[k as usize][2];
            lab.palette = k as i64;
            ui.mark_reset();
        }
    }
    yy += 27.0 * u;
    let mut rough = lab.materials[i as usize].data[3] as f64;
    if ui.slider(1320, x, yy, w, 40.0 * u, b"roughness", &mut rough, 0.015, 1.0, 3, b"") {
        lab.materials[i as usize].data[3] = rough as f32;
        ui.mark_reset();
    }
    yy += 45.0 * u;
    let mut metal = lab.materials[i as usize].data[4] as f64;
    if ui.slider(1321, x, yy, w, 40.0 * u, b"metallic", &mut metal, 0.0, 1.0, 2, b"") {
        lab.materials[i as usize].data[4] = metal as f32;
        ui.mark_reset();
    }
    yy += 45.0 * u;
    let mut ior = lab.materials[i as usize].data[5] as f64;
    if ui.slider(1322, x, yy, w, 40.0 * u, b"refraction", &mut ior, 1.0, 2.4, 2, b"") {
        lab.materials[i as usize].data[5] = ior as f32;
        ui.mark_reset();
    }
    yy += 45.0 * u;
    let dielectric = lab.materials[i as usize].data[6] > 0.5;
    if ui.toggle(1323, x, yy, w, 26.0 * u, b"transmission", dielectric) {
        lab.materials[i as usize].data[6] = if dielectric { 0.0 } else { 1.0 };
        ui.mark_reset();
    }
    yy += 31.0 * u;
    ui.text(x, yy, b"absorption tint", DIM);
    let sw = (w - 3.0 * 6.0 * u) * 0.25;
    for k in 0..4 {
        if ui.swatch(1330 + k, x + (sw + 6.0 * u) * k as f64, yy + 18.0 * u, sw,
            16.0 * u, TINTS[k as usize], lab.tint_palette == k as i64) {
            lab.materials[i as usize].data[8] = TINTS[k as usize][0];
            lab.materials[i as usize].data[9] = TINTS[k as usize][1];
            lab.materials[i as usize].data[10] = TINTS[k as usize][2];
            lab.tint_palette = k as i64;
            ui.mark_reset();
        }
    }
    yy += 46.0 * u;
    let mut density = lab.materials[i as usize].data[7] as f64;
    if ui.slider(1324, x, yy, w, 40.0 * u, b"density", &mut density,
        0.0, 2.0, 2, b"1/m") {
        lab.materials[i as usize].data[7] = density as f32;
        ui.mark_reset();
    }
    yy += 45.0 * u;
    let mut emission = lab.materials[i as usize].data[11] as f64;
    if ui.slider(1325, x, yy, w, 40.0 * u, b"emission", &mut emission, 0.0, 20.0, 1, b"") {
        lab.materials[i as usize].data[11] = emission as f32;
        ui.mark_reset();
    }
}

fn draw_display(ui: &mut Ui<Gpa>, lab: &mut Lab, st: Status, x: f64, y: f64, w: f64) {
    let u = ui.u;
    let mut yy = y;
    let mut debug = lab.debug;
    if ui.combo(1400, x, yy, w, 22.0 * u, b"view", DEBUG_ITEMS, 9, &mut debug) {
        lab.debug = debug;
        if debug == 8 { ui.mark_reset(); } else { ui.mark_redraw(); }
    }
    yy += 27.0 * u;
    if ui.toggle(1401, x, yy, w, 26.0 * u, b"comparison split", lab.comparison) {
        lab.comparison = !lab.comparison;
        ui.mark_redraw();
    }
    yy += 31.0 * u;
    ui.text(x, yy, b"res", DIM);
    let ww = ui.number(x + 48.0 * u, yy, st.width as f64, 0, TEXT);
    let x_at = x + 48.0 * u + ww + 4.0 * u;
    ui.text(x_at, yy, b"x", FAINT);
    let hh = ui.number(x_at + 10.0 * u, yy, st.height as f64, 0, TEXT);
    ui.text(x_at + 10.0 * u + hh + 4.0 * u, yy, b"px", FAINT);

    ui.text(x, yy + 16.0 * u, b"frame", DIM);
    let mut b2: [u8; 32] = [32; 32];
    let at = fmt_f64(st.ms, 1, &mut b2);
    ui.text(x + 70.0 * u, yy + 16.0 * u, &b2[at as usize..32], TEXT);
    ui.text(x + 70.0 * u + 44.0 * u, yy + 16.0 * u, b"ms", FAINT);
    ui.text(x, yy + 32.0 * u, b"mode", DIM);
    ui.text(x + 70.0 * u, yy + 32.0 * u, DEBUG_NAMES[lab.debug.clamp(0, 8) as usize], TEXT);
    if lab.gi {
        ui.text_right(x, yy + 32.0 * u, x + w, b"GI", GOOD);
    } else {
        ui.text_right(x, yy + 32.0 * u, x + w, b"DIRECT", WARN);
    }
}
