// CPU-side laboratory state. These plain values are packed into one uniform
// by render.vl; path tracing and accumulation remain entirely on the GPU.

import "math.h" as c;

use std::{clamp, min};

pub const DEBUG_MODES: i64 = 9;

pub struct Material {
    // albedo.rgb, roughness; metallic, ior, transmission, absorption density;
    // absorption tint.rgb, emission. This is exactly three WGSL vec4s.
    pub data: [f32; 12],
}

pub struct Lab {
    pub yaw: f64,
    pub pitch: f64,
    pub dist: f64,
    pub fov: f64,
    pub aperture: f64,
    pub focus: f64,
    pub exposure: f64,
    pub environment: f64,
    pub fog_density: f64,
    pub fog_anisotropy: f64,
    pub light_x: f64,
    pub light_z: f64,
    pub light_intensity: f64,
    pub light_width: f64,
    pub light_height: f64,
    pub light_color: [f32; 3],
    pub materials: [Material; 4],
    pub selected: i64,
    pub palette: i64,
    pub tint_palette: i64,
    pub light_palette: i64,
    pub debug: i64,
    pub grid: bool,
    pub gi: bool,
    pub comparison: bool,
    pub select_x: f64,
    pub select_y: f64,
}

pub fn material(albedo: [f32; 3], roughness: f32, metallic: f32, ior: f32,
    transmission: f32, absorption: [f32; 3], density: f32, emission: f32) -> Material {
    Material { data: [
        albedo[0], albedo[1], albedo[2], roughness,
        metallic, ior, transmission, density,
        absorption[0], absorption[1], absorption[2], emission,
    ] }
}

pub fn lab_default() -> Lab {
    Lab {
        yaw: 0.0, pitch: 0.18, dist: 8.0, fov: 45.0,
        aperture: 0.0, focus: 8.0, exposure: 1.15,
        environment: 0.7, fog_density: 0.0, fog_anisotropy: 0.35,
        light_x: 0.0, light_z: -0.8, light_intensity: 5.0,
        light_width: 4.0, light_height: 3.0, light_color: [1.0, 0.91, 0.78],
        materials: [
            material([0.72, 0.075, 0.045], 0.48, 0.0, 1.45, 0.0,
                [1.0, 1.0, 1.0], 0.0, 0.0),
            material([0.97, 0.99, 1.0], 0.015, 0.0, 1.5, 1.0,
                [0.55, 0.85, 0.95], 0.12, 0.0),
            material([0.84, 0.89, 0.96], 0.07, 1.0, 1.45, 0.0,
                [1.0, 1.0, 1.0], 0.0, 0.0),
            material([0.83, 0.48, 0.12], 0.28, 1.0, 1.45, 0.0,
                [1.0, 1.0, 1.0], 0.0, 0.0),
        ],
        selected: 0, palette: 0, tint_palette: 0, light_palette: 0,
        debug: 0, grid: false, gi: true, comparison: false,
        select_x: 0.63, select_y: 0.5,
    }
}

impl Lab {
    /// Keep the eye inside the open studio. The side walls are at x = ±4.2,
    /// the back wall at z = -3.2 and the floor at y = -1; margins keep the
    /// near plane and orbit path visibly clear of them. Rotation and zoom call
    /// this together, since the safe yaw range depends on distance and pitch.
    pub fn clamp_camera(inout self) {
        self.pitch = clamp(self.pitch, 0.03, 0.75);
        self.dist = clamp(self.dist, 4.5, 18.0);
        self.yaw = clamp(self.yaw, -0.78, 0.78);
        let cp = unsafe { c::cos(self.pitch) };
        let side_room = 3.55;
        let yaw_room = unsafe { c::asin(min(1.0, side_room / (self.dist * cp))) };
        let yaw_limit = min(0.78, yaw_room);
        self.yaw = clamp(self.yaw, -yaw_limit, yaw_limit);
        let sx = unsafe { c::fabs(c::sin(self.yaw)) } * cp;
        if sx > 0.0001 {
            self.dist = min(self.dist, side_room / sx);
        }
        // This also protects the back wall if the yaw limit is widened later.
        let cz = unsafe { c::cos(self.yaw) } * cp;
        if cz < -0.0001 {
            self.dist = min(self.dist, 2.55 / -cz);
        }
    }

    pub fn select_next(inout self) {
        self.selected = (self.selected + 1) % 4;
    }

    pub fn cycle_color(inout self) {
        let colors: [[f32; 3]; 6] = [
            [0.72, 0.075, 0.045], [0.035, 0.28, 0.72], [0.06, 0.55, 0.24],
            [0.83, 0.48, 0.12], [0.84, 0.89, 0.96], [0.42, 0.08, 0.62],
        ];
        self.palette = (self.palette + 1) % 6;
        let color = colors[self.palette];
        let i = self.selected;
        self.materials[i].data[0] = color[0];
        self.materials[i].data[1] = color[1];
        self.materials[i].data[2] = color[2];
    }

    pub fn cycle_absorption(inout self) {
        let colors: [[f32; 3]; 4] = [
            [1.0, 1.0, 1.0], [0.55, 0.85, 0.95], [0.95, 0.72, 0.38], [0.90, 0.42, 0.62],
        ];
        self.tint_palette = (self.tint_palette + 1) % 4;
        let color = colors[self.tint_palette];
        let i = self.selected;
        self.materials[i].data[8] = color[0];
        self.materials[i].data[9] = color[1];
        self.materials[i].data[10] = color[2];
    }

    pub fn cycle_light_color(inout self) {
        let colors: [[f32; 3]; 4] = [
            [1.0, 0.91, 0.78], [1.0, 1.0, 1.0], [0.62, 0.78, 1.0], [1.0, 0.28, 0.16],
        ];
        self.light_palette = (self.light_palette + 1) % 4;
        self.light_color = colors[self.light_palette];
    }

    pub fn adjust_roughness(inout self, delta: f32) {
        let i = self.selected;
        self.materials[i].data[3] = clamp(self.materials[i].data[3] + delta, 0.015, 1.0);
    }

    pub fn adjust_metallic(inout self, delta: f32) {
        let i = self.selected;
        self.materials[i].data[4] = clamp(self.materials[i].data[4] + delta, 0.0, 1.0);
    }

    pub fn adjust_ior(inout self, delta: f32) {
        let i = self.selected;
        self.materials[i].data[5] = clamp(self.materials[i].data[5] + delta, 1.0, 2.4);
    }

    pub fn adjust_density(inout self, delta: f32) {
        let i = self.selected;
        self.materials[i].data[7] = clamp(self.materials[i].data[7] + delta, 0.0, 2.0);
    }

    pub fn adjust_emission(inout self, delta: f32) {
        let i = self.selected;
        self.materials[i].data[11] = clamp(self.materials[i].data[11] + delta, 0.0, 20.0);
    }

    pub fn restore(inout self) {
        self = lab_default();
    }
}

#[test]
fn material_controls_are_bounded() {
    var lab = lab_default();
    lab.adjust_roughness(-4.0);
    lab.adjust_metallic(4.0);
    lab.adjust_ior(-4.0);
    lab.adjust_density(-4.0);
    lab.adjust_emission(-4.0);
    assert_eq(lab.materials[0].data[3], 0.015);
    assert_eq(lab.materials[0].data[4], 1.0);
    assert_eq(lab.materials[0].data[5], 1.0);
    assert_eq(lab.materials[0].data[7], 0.0);
    assert_eq(lab.materials[0].data[11], 0.0);
}

#[test]
fn camera_orbit_and_zoom_stay_inside_the_studio() {
    var lab = lab_default();
    lab.yaw = 20.0;
    lab.pitch = -2.0;
    lab.dist = 18.0;
    lab.clamp_camera();
    let cp = unsafe { c::cos(lab.pitch) };
    let x = lab.dist * unsafe { c::sin(lab.yaw) } * cp;
    let y = lab.dist * unsafe { c::sin(lab.pitch) };
    let z = lab.dist * unsafe { c::cos(lab.yaw) } * cp;
    assert_eq(unsafe { c::fabs(x) } <= 3.550001, true);
    assert_eq(y > -0.5, true);
    assert_eq(z >= -2.550001, true);
    assert_eq(lab.pitch >= 0.03 && lab.pitch <= 0.75, true);
}

#[test]
fn restore_recovers_the_composed_scene() {
    var lab = lab_default();
    lab.select_next();
    lab.adjust_roughness(0.5);
    lab.light_width = 0.1;
    lab.fog_density = 1.0;
    lab.debug = 7;
    lab.restore();
    assert_eq(lab.selected, 0);
    assert_eq(lab.light_width, 4.0);
    assert_eq(lab.fog_density, 0.0);
    assert_eq(lab.debug, 0);
    assert_eq(lab.materials[1].data[5], 1.5);
}
