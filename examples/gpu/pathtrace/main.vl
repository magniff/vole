// pathtrace: an interactive GPU path-tracing laboratory in Vole's native
// window. The on-screen immediate-mode panel (ui.vl, ui_panel.vl) is the
// main way to change scenes, fog, light and materials; the keyboard keeps
// its shortcuts as accelerators. Rendering and all numerical sampling use
// std::gpu. --headless runs the same pipelines without a window.

mod check;
mod font;
mod render;
mod shaders;
mod state;
mod ui;
mod ui_panel;
mod ui_render;

use std::{clamp, env, gpu, max, min};
use std::cli::{Arg, Command};
use std::gpu::RawSurface;
use std::time::monotonic_now;
use std::window::{App, Button, Event, MouseAction, WindowDesc};
use std::window::keys::{Logical, Named};

use render::{MAX_SAMPLES, renderer_new};
use state::{DEBUG_MODES, Lab, lab_default, scene_lab};
use ui::{Input, Ui};
use ui_panel::Status;
use ui_render::ui_renderer_new;

fn parse_size(s: str) -> (i64, i64) {
    let (ws, hs) = match s.split_once("x") {
        Some(pair) => pair,
        None => ("96", "64"),
    };
    let w = ws.parse::<i64>().unwrap_or(96);
    let h = hs.parse::<i64>().unwrap_or(64);
    (w, h)
}

fn render_dimensions(width: i64, height: i64, scale: f64) -> (i64, i64) {
    let divisor = max(1, scale as i64);
    (max(8, width / divisor), max(8, height / divisor))
}

fn mode_name(mode: i64) -> str {
    match mode {
        0 => "beauty",
        1 => "normals",
        2 => "albedo",
        3 => "depth",
        4 => "traversal",
        5 => "materials",
        6 => "bounce depth",
        7 => "variance",
        _ => "ray path",
    }
}

fn scene_name(scene: i64) -> str {
    match scene {
        0 => "Studio",
        1 => "Fog hall",
        2 => "Mirror field",
        _ => "Material grid",
    }
}

/// A key shortcut changes the lab: `reset` invalidates accumulation,
/// `redraw` only re-presents the image.
struct Keys {
    pub reset: bool,
    pub redraw: bool,
}

fn key_shortcuts(lab: inout Lab, ch: u32) -> Keys {
    var k = Keys { reset: false, redraw: false };
    if ch == 'r' as u32 { k.reset = true; }
    if ch == 't' as u32 {
        lab.apply_scene(if lab.scene == 3 { 0 } else { 3 });
        k.reset = true;
    }
    if ch == 'g' as u32 {
        lab.gi = !lab.gi;
        k.reset = true;
    }
    if ch == 'd' as u32 {
        lab.debug = (lab.debug + 1) % DEBUG_MODES;
        if lab.debug == 8 { k.reset = true; } else { k.redraw = true; }
    }
    if ch == 'b' as u32 {
        lab.comparison = !lab.comparison;
        k.redraw = true;
    }
    if ch == 'c' as u32 { lab.cycle_color(); k.reset = true; }
    if ch == 'a' as u32 { lab.cycle_absorption(); k.reset = true; }
    if ch == 'x' as u32 { lab.cycle_light_color(); k.reset = true; }
    if ch == '[' as u32 { lab.adjust_roughness(-0.03); k.reset = true; }
    if ch == ']' as u32 { lab.adjust_roughness(0.03); k.reset = true; }
    if ch == '-' as u32 { lab.adjust_metallic(-0.1); k.reset = true; }
    if ch == '=' as u32 { lab.adjust_metallic(0.1); k.reset = true; }
    if ch == 'n' as u32 { lab.adjust_ior(-0.05); k.reset = true; }
    if ch == 'm' as u32 { lab.adjust_ior(0.05); k.reset = true; }
    if ch == 'v' as u32 { lab.adjust_density(-0.03); k.reset = true; }
    if ch == 'w' as u32 { lab.adjust_density(0.03); k.reset = true; }
    if ch == 'e' as u32 {
        let i = lab.selected;
        lab.materials[i].data[6] = if lab.materials[i].data[6] > 0.5 { 0.0 } else { 1.0 };
        k.reset = true;
    }
    if ch == '9' as u32 { lab.adjust_emission(-0.5); k.reset = true; }
    if ch == '0' as u32 { lab.adjust_emission(0.5); k.reset = true; }
    if ch == 'i' as u32 { lab.light_z -= 0.25; k.reset = true; }
    if ch == 'k' as u32 { lab.light_z += 0.25; k.reset = true; }
    if ch == 'j' as u32 { lab.light_x -= 0.25; k.reset = true; }
    if ch == 'l' as u32 { lab.light_x += 0.25; k.reset = true; }
    if ch == '1' as u32 {
        lab.light_intensity = max(0.0, lab.light_intensity - 0.5);
        k.reset = true;
    }
    if ch == '2' as u32 {
        lab.light_intensity = min(30.0, lab.light_intensity + 0.5);
        k.reset = true;
    }
    if ch == '3' as u32 {
        lab.light_width = max(0.25, lab.light_width - 0.25);
        k.reset = true;
    }
    if ch == '4' as u32 {
        lab.light_width = min(10.0, lab.light_width + 0.25);
        k.reset = true;
    }
    if ch == '5' as u32 {
        lab.light_height = max(0.25, lab.light_height - 0.25);
        k.reset = true;
    }
    if ch == '6' as u32 {
        lab.light_height = min(10.0, lab.light_height + 0.25);
        k.reset = true;
    }
    if ch == '7' as u32 {
        lab.environment = max(0.0, lab.environment - 0.1);
        k.reset = true;
    }
    if ch == '8' as u32 {
        lab.environment = min(4.0, lab.environment + 0.1);
        k.reset = true;
    }
    if ch == ',' as u32 {
        lab.fov = max(18.0, lab.fov - 3.0);
        k.reset = true;
    }
    if ch == '.' as u32 {
        lab.fov = min(100.0, lab.fov + 3.0);
        k.reset = true;
    }
    if ch == 'o' as u32 {
        lab.aperture = if lab.aperture == 0.0 { 0.12 } else { 0.0 };
        k.reset = true;
    }
    if ch == ';' as u32 {
        lab.aperture = max(0.0, lab.aperture - 0.02);
        k.reset = true;
    }
    if ch == '\'' as u32 {
        lab.aperture = min(0.5, lab.aperture + 0.02);
        k.reset = true;
    }
    if ch == 'u' as u32 {
        lab.focus_selected();
        k.reset = true;
    }
    if ch == 'h' as u32 {
        lab.fog_density = if lab.fog_density == 0.0 { 0.035 } else { 0.0 };
        k.reset = true;
    }
    if ch == 'y' as u32 {
        lab.fog_density += 0.01;
        if lab.fog_density > 0.12 { lab.fog_density = 0.0; }
        k.reset = true;
    }
    k
}

fn main(gpa: Gpa) -> i32 {
    let cli = Command::new_in("pathtrace", gpa)
        .version("0.3")
        .about("a progressive GPU path-tracing laboratory with an on-screen UI")
        .arg(Arg::flag("headless").help("run GPU readback checks instead of opening a window"))
        .arg(Arg::flag("benchmark").help("run a fixed-seed steady-state GPU benchmark"))
        .arg(Arg::flag("grid").help("headless: use the 4x4 material comparison scene"))
        .arg(Arg::flag("fog").help("headless: enable homogeneous volumetric fog"))
        .arg(Arg::flag("dof").help("headless: enable thin-lens depth of field"))
        .arg(Arg::flag("direct").help("headless: direct lighting only (no diffuse GI)"))
        .arg(Arg::flag("ui").help("headless: draw the on-screen panel over the image"))
        .arg(Arg::option("ui-scale").value_name("S").default("1")
            .help("headless --ui: physical pixels per UI point (2 on a Retina display)"))
        .arg(Arg::option("ui-section").value_name("N").default("0")
            .help("headless --ui: the panel section to open (0 scene, 1 camera, 2 atmosphere, 3 material, 4 display)"))
        .arg(Arg::option("scene").value_name("N").default("0")
            .help("headless: 0 studio, 1 fog hall, 2 mirror field, 3 material grid"))
        .arg(Arg::option("debug").value_name("N").default("0")
            .help("headless: 0 beauty, 1 normals, 2 albedo, 3 depth, 4 traversal, 5 IDs, 6 bounces, 7 variance, 8 ray path"))
        .arg(Arg::option("samples").value_name("N").default("16")
            .help("headless/benchmark: accumulated samples"))
        .arg(Arg::option("size").value_name("WxH").default("96x64")
            .help("headless/benchmark: image size in physical pixels"))
        .arg(Arg::option("out").value_name("FILE.ppm")
            .help("headless: write the final image as a binary PPM"));
    let m = cli.parse_or_exit(env::args());
    let samples = m.get_as::<i64>("samples").unwrap_or(16);
    let (width, height) = parse_size(m.get("size").unwrap_or("96x64"));
    if m.flag("headless") || m.flag("benchmark") {
        if samples < 2 || width < 8 || height < 8 {
            eprintln("pathtrace: headless wants --samples >= 2 and --size at least 8x8");
            return 2;
        }
        let scene = clamp(m.get_as::<i64>("scene").unwrap_or(0), 0, 3);
        var lab = if m.flag("grid") { scene_lab(3) } else { scene_lab(scene) };
        lab.gi = !m.flag("direct");
        if m.flag("fog") { lab.fog_density = 0.05; }
        if m.flag("dof") { lab.aperture = 0.12; }
        lab.debug = clamp(m.get_as::<i64>("debug").unwrap_or(0), 0, DEBUG_MODES - 1);
        if m.flag("benchmark") {
            return check::benchmark_lab(samples, width, height, lab, gpa);
        }
        return check::run_lab(samples, width, height, m.get("out").unwrap_or(""), lab,
            m.flag("ui"), m.get_as::<f64>("ui-scale").unwrap_or(1.0),
            clamp(m.get_as::<i64>("ui-section").unwrap_or(0), 0, 4), gpa);
    }

    var app = match App::new_in(gpa) {
        Ok(a) => a,
        Err(_) => {
            eprintln("pathtrace: no window server on this display (try --headless)");
            return 1;
        }
    };
    var win = match app.window(WindowDesc::new("pathtrace", 1100, 720)) {
        Ok(w) => w,
        Err(_) => {
            eprintln("pathtrace: could not create a window");
            return 1;
        }
    };
    let inst = gpu::Instance::new_in(gpa);
    let opened = match inst.adapter() {
        Ok(a) => a.device(),
        Err(e) => Err(e),
    };
    let (dev, var queue) = match opened {
        Ok(pair) => pair,
        Err(e) => {
            eprintln("pathtrace: no GPU: {e}");
            return 1;
        }
    };
    var surf = match inst.surface(dev, RawSurface::MetalLayer(win.raw_surface())) {
        Ok(s) => s,
        Err(e) => {
            eprintln("pathtrace: no surface for the window: {e}");
            return 1;
        }
    };
    let pixels = win.size();
    surf.configure(dev, pixels.w, pixels.h);
    var scale = pixels.scale;
    let logical = render_dimensions(pixels.w, pixels.h, pixels.scale);
    var renderer = match renderer_new(dev, logical.0, logical.1) {
        Ok(r) => r,
        Err(e) => {
            eprintln("pathtrace: renderer: {e}");
            return 1;
        }
    };
    var ui = Ui::new_in(gpa);
    var ui_renderer = match ui_renderer_new(dev, &queue, gpa) {
        Ok(r) => r,
        Err(e) => {
            eprintln("pathtrace: UI renderer: {e}");
            return 1;
        }
    };

    var lab = lab_default();
    var paused = false;
    var dragging = false;
    var last_x = 0.0;
    var last_y = 0.0;
    var mouse_x = 0.0;
    var mouse_y = 0.0;
    var mouse_down = false;
    var mouse_press = false;
    var mouse_release = false;
    var wheel = 0.0;
    var frames: i64 = 0;
    var accumulated: i64 = 0;
    var frame_clock = monotonic_now();
    var frame_ms = 0.0;
    var fps = 0.0;
    println("pathtrace: native window + Metal GPU + immediate-mode UI");
    win.request_frame();
    loop {
        match app.wait() {
            Ok(Event::Frame(_)) => {
                let now = monotonic_now();
                let input = Input {
                    x: mouse_x, y: mouse_y, down: mouse_down,
                    press: mouse_press, release: mouse_release, wheel: wheel,
                    w: surf.width as f64, h: surf.height as f64, scale: scale,
                };
                ui.begin(input);
                let actions = ui_panel::panel(&ui, &lab, Status {
                    samples: renderer.samples,
                    max_samples: MAX_SAMPLES,
                    fps: fps,
                    ms: frame_ms,
                    width: renderer.width,
                    height: renderer.height,
                    paused: paused,
                });
                ui.end();
                mouse_press = false;
                mouse_release = false;
                wheel = 0.0;
                if actions.toggle_pause { paused = !paused; }
                if actions.reset_accum { renderer.reset(); paused = false; }
                if actions.restore {
                    lab.restore();
                    ui.mark_reset();
                }
                if ui.reset {
                    lab.clamp_camera();
                    renderer.reset();
                    paused = false;
                }
                let accumulating = lab.debug == 0 || lab.debug >= 7;
                let advance = renderer.samples < MAX_SAMPLES && !paused
                    && (accumulating || renderer.samples == 0);
                match surf.frame() {
                    Ok(frame) => {
                        let target = frame.texture.view();
                        if advance {
                            let batch = if accumulating { 4 } else { 1 };
                            accumulated += renderer.draw_batch(dev, &queue, target, lab, batch);
                        } else {
                            renderer.redraw(dev, &queue, target, lab);
                        }
                        ui_renderer.draw(dev, &queue, target, ui.verts.as_slice());
                        frame.present(&queue);
                        frames += 1;
                    }
                    Err(_) => {}
                }
                let elapsed = now.saturating_sub(frame_clock);
                if elapsed.as_millis() >= 400 {
                    let seconds = elapsed.as_secs_f64();
                    frame_ms = seconds * 1000.0 / frames as f64;
                    fps = frames as f64 / seconds;
                    let title = format_in(
                        "pathtrace | {} | {}spp | {frame_ms:.1}ms frame | {}x{} | {}",
                        scene_name(lab.scene), renderer.samples, renderer.width, renderer.height,
                        mode_name(lab.debug), gpa);
                    win.set_title(title.as_slice());
                    frame_clock = now;
                    frames = 0;
                    accumulated = 0;
                }
                win.request_frame();
            }
            Ok(Event::Resize(_, size)) => {
                if size.w > 0 && size.h > 0 {
                    surf.configure(dev, size.w, size.h);
                    scale = size.scale;
                    let logical = render_dimensions(size.w, size.h, size.scale);
                    match renderer_new(dev, logical.0, logical.1) {
                        Ok(r) => {
                            renderer = r;
                            win.request_frame();
                        }
                        Err(e) => eprintln("pathtrace: resize: {e}"),
                    }
                }
            }
            Ok(Event::Key(k)) => {
                if k.pressed && !k.ime {
                    match k.key {
                        Logical::Named(Named::Escape) => {
                            win.close();
                            break;
                        }
                        Logical::Named(Named::Tab) => {
                            ui.hidden = !ui.hidden;
                        }
                        Logical::Named(Named::Backspace) => {
                            lab.restore();
                            renderer.reset();
                            paused = false;
                            win.request_frame();
                        }
                        Logical::Named(Named::ArrowLeft) => {
                            lab.yaw -= 0.08;
                            lab.clamp_camera();
                            renderer.reset();
                            paused = false;
                            win.request_frame();
                        }
                        Logical::Named(Named::ArrowRight) => {
                            lab.yaw += 0.08;
                            lab.clamp_camera();
                            renderer.reset();
                            paused = false;
                            win.request_frame();
                        }
                        Logical::Named(Named::ArrowUp) => {
                            lab.pitch = min(lab.pitch + 0.05, 1.35);
                            lab.clamp_camera();
                            renderer.reset();
                            paused = false;
                            win.request_frame();
                        }
                        Logical::Named(Named::ArrowDown) => {
                            lab.pitch = max(lab.pitch - 0.05, -0.15);
                            lab.clamp_camera();
                            renderer.reset();
                            paused = false;
                            win.request_frame();
                        }
                        Logical::F(1) => {
                            lab.exposure = max(0.1, lab.exposure / 1.15);
                            win.request_frame();
                        }
                        Logical::F(2) => {
                            lab.exposure = min(12.0, lab.exposure * 1.15);
                            win.request_frame();
                        }
                        Logical::Char(ch) => {
                            if ch == 'q' as u32 {
                                win.close();
                                break;
                            }
                            if ch == 'f' as u32 { win.set_fullscreen(!win.is_fullscreen()); }
                            if ch == ' ' as u32 {
                                paused = !paused;
                                win.request_frame();
                            }
                            let keys = key_shortcuts(&lab, ch);
                            if keys.reset {
                                lab.clamp_camera();
                                renderer.reset();
                                paused = false;
                                win.request_frame();
                            } else if keys.redraw {
                                win.request_frame();
                            }
                        }
                        _ => {}
                    }
                }
            }
            Ok(Event::Mouse(mouse)) => {
                match mouse.action {
                    MouseAction::Press => {
                        mouse_x = mouse.x;
                        mouse_y = mouse.y;
                        if mouse.button == Button::Left {
                            mouse_down = true;
                            mouse_press = true;
                            if ui.covers(mouse.x, mouse.y) {
                                dragging = false;
                            } else {
                                dragging = true;
                                last_x = mouse.x;
                                last_y = mouse.y;
                            }
                        }
                        if mouse.button == Button::Right && !ui.covers(mouse.x, mouse.y) {
                            lab.select_x = clamp(mouse.x / surf.width as f64, 0.0, 0.999);
                            lab.select_y = clamp(mouse.y / surf.height as f64, 0.0, 0.999);
                            lab.debug = 8;
                            renderer.reset();
                            paused = false;
                            win.request_frame();
                        }
                    }
                    MouseAction::Release => {
                        mouse_x = mouse.x;
                        mouse_y = mouse.y;
                        if mouse.button == Button::Left {
                            mouse_down = false;
                            mouse_release = true;
                            dragging = false;
                        }
                    }
                    MouseAction::Move => {
                        mouse_x = mouse.x;
                        mouse_y = mouse.y;
                        if dragging {
                            lab.yaw -= (mouse.x - last_x) * 0.007;
                            lab.pitch = clamp(lab.pitch + (mouse.y - last_y) * 0.007, -0.15, 1.35);
                            last_x = mouse.x;
                            last_y = mouse.y;
                            lab.clamp_camera();
                            renderer.reset();
                            paused = false;
                            win.request_frame();
                        }
                    }
                }
            }
            Ok(Event::Scroll(s)) => {
                wheel += s.dy;
                if !ui.covers(mouse_x, mouse_y) {
                    lab.dist = clamp(lab.dist * 0.94f64.powf(s.dy), 4.5, 18.0);
                    lab.clamp_camera();
                    renderer.reset();
                    paused = false;
                    win.request_frame();
                }
            }
            Ok(Event::Close(_)) => {
                win.close();
                break;
            }
            Ok(Event::Quit) => {
                win.close();
                break;
            }
            Ok(_) => {}
            Err(_) => {
                eprintln("pathtrace: window event loop failed");
                break;
            }
        }
    }
    0
}

#[test]
fn high_dpi_rendering_uses_logical_resolution() {
    assert_eq(render_dimensions(2200, 1440, 2.0), (1100, 720));
    assert_eq(render_dimensions(1100, 720, 1.0), (1100, 720));
    assert_eq(render_dimensions(2, 2, 1.0), (8, 8));
}
