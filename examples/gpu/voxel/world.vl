// Bounded chunk streaming and GPU-resident terrain generation/meshing.

import "math.h" as c;

use std::{abs, gpu};
use std::gpu::{BindGroup, Buffer, ComputePipeline};
use std::gpu::types::BufferUsage;
use std::gpu::types::BufferUsage::STORAGE;

use shaders::WORLD_WGSL;

pub const CHUNK: i64 = 32;
pub const HEIGHT: i64 = 48;
pub const VOXELS: i64 = CHUNK * CHUNK * HEIGHT;
pub const MAX_VERTS: i64 = 12288 * 6;
pub const RADIUS: i64 = 3;

pub struct WorldPipes {
    terrain: ComputePipeline,
    mesh: ComputePipeline,
}

pub struct Edit {
    pub data: [f32; 8],
}

pub struct Chunk {
    pub cx: i64,
    pub cz: i64,
    pub render_group: BindGroup,
    pub water_group: BindGroup,
    pub plant_group: BindGroup,
    pub meta: Buffer,
    pub vertices: Buffer,
    water: Buffer,
    plants: Buffer,
    density: Buffer,
    offsets: Buffer,
    info: Buffer,
    terrain_group: BindGroup,
    mesh_group: BindGroup,
}

pub struct World {
    pub seed: u64,
    pub chunks: Vec<Chunk>,
    pub generated: i64,
    pub edits: Vec<Edit>,
    params: Buffer,
    edit_buffer: Buffer,
    pipes: WorldPipes,
}

pub fn chunk_coord(x: f64) -> i64 {
    // UNSAFE: negative chunk coordinates require C floor; no safe std equivalent exists.
    // SAFETY: the input is a scalar coordinate and the floor call is side-effect free.
    unsafe { c::floor(x / CHUNK as f64) as i64 }
}

pub fn world_new(dev: gpu::Device, seed: u64, gpa: Gpa) -> Result<World, gpu::Error> {
    let shader = dev.shader_wgsl(WORLD_WGSL)?;
    let terrain = dev.compute_pipeline(shader, "terrain")?;
    let mesh = dev.compute_pipeline(shader, "mesh")?;
    let params_data: [f32; 4] = [seed as f32, 0.0, 0.0, 0.0];
    let params = dev.buffer_init(gpu::bytes_of_f32(params_data[..]),
        BufferUsage::UNIFORM | BufferUsage::COPY_DST);
    let edit_buffer = dev.buffer(1024 * 32, BufferUsage::STORAGE | BufferUsage::COPY_DST);
    var world = World {
        seed: seed, chunks: Vec::new_in(gpa), generated: 0, edits: Vec::new_in(gpa),
        params: params, edit_buffer: edit_buffer,
        pipes: WorldPipes { terrain: terrain, mesh: mesh },
    };
    // A small initial island is ready immediately; the full radius streams in
    // over subsequent frames rather than stalling the first presentation.
    for z in -1..2 {
        for x in -1..2 {
            world.load(dev, x, z);
        }
    }
    Ok(world)
}

fn chunk_new(dev: gpu::Device, pipes: WorldPipes, params: Buffer, edits: Buffer,
    cx: i64, cz: i64) -> Chunk {
    let info_data: [f32; 4] = [cx as f32, cz as f32, 0.0, 0.0];
    let info = dev.buffer_init(gpu::bytes_of_f32(info_data[..]),
        BufferUsage::UNIFORM | BufferUsage::COPY_DST);
    let density = dev.buffer(VOXELS * 4, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
    let offsets = dev.buffer(VOXELS * 4, STORAGE);
    let vertices = dev.buffer(MAX_VERTS * 48, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
    let water = dev.buffer(6144 * 48, STORAGE);
    let plants = dev.buffer(256 * 48, STORAGE);
    let meta = dev.buffer(4 * 4,
        BufferUsage::STORAGE | BufferUsage::COPY_SRC | BufferUsage::COPY_DST
            | BufferUsage::MAP_READ);
    // (a pipeline's layout is the bindings its entry point uses: terrain
    // reads params, info and edits and writes density; mesh uses all nine)
    let terrain_group = dev.bind_group(pipes.terrain.bind_layout(0), [
        gpu::bind(0, params), gpu::bind(1, info), gpu::bind(2, density), gpu::bind(8, edits),
    ][..]);
    let mesh_group = dev.bind_group(pipes.mesh.bind_layout(0), [
        gpu::bind(0, params), gpu::bind(1, info), gpu::bind(2, density),
        gpu::bind(3, offsets), gpu::bind(4, vertices), gpu::bind(5, meta),
        gpu::bind(6, water), gpu::bind(7, plants), gpu::bind(8, edits),
    ][..]);
    // The render pipeline has the same first three bindings in its own layout;
    // this group is built by render.vl through Chunk::bind_render.
    Chunk {
        cx: cx, cz: cz,
        render_group: dev.bind_group(pipes.terrain.bind_layout(0), [
            gpu::bind(0, params), gpu::bind(1, info), gpu::bind(2, density), gpu::bind(8, edits),
        ][..]),
        water_group: dev.bind_group(pipes.terrain.bind_layout(0), [
            gpu::bind(0, params), gpu::bind(1, info), gpu::bind(2, density), gpu::bind(8, edits),
        ][..]),
        plant_group: dev.bind_group(pipes.terrain.bind_layout(0), [
            gpu::bind(0, params), gpu::bind(1, info), gpu::bind(2, density), gpu::bind(8, edits),
        ][..]),
        meta: meta, vertices: vertices, water: water, plants: plants,
        density: density, offsets: offsets, info: info,
        terrain_group: terrain_group, mesh_group: mesh_group,
    }
}

impl Chunk {
    pub fn generate(self, dev: gpu::Device, queue: inout gpu::Queue,
        terrain_pipe: ComputePipeline, mesh_pipe: ComputePipeline) {
        let zeros: [u32; 4] = [0, 0, 0, 0];
        queue.write_buffer(self.meta, 0, gpu::bytes_of_u32(zeros[..]));
        let terrain = self.terrain_group;
        let mesh = self.mesh_group;
        var enc = dev.encoder();
        enc.compute_pass(|pass| {
            pass.set_pipeline(terrain_pipe);
            pass.set_bind_group(0, terrain);
            pass.dispatch(4, 4);
        });
        enc.compute_pass(|pass| {
            pass.set_pipeline(mesh_pipe);
            pass.set_bind_group(0, mesh);
            pass.dispatch(1);
        });
        queue.submit(enc.finish());
    }

    pub fn bind_render(inout self, dev: gpu::Device, layout: gpu::BindLayout, camera: Buffer) {
        self.render_group = dev.bind_group(layout,
            [gpu::bind(0, camera), gpu::bind(1, self.vertices), gpu::bind(2, self.meta)][..]);
        self.water_group = dev.bind_group(layout,
            [gpu::bind(0, camera), gpu::bind(1, self.water), gpu::bind(2, self.meta)][..]);
        self.plant_group = dev.bind_group(layout,
            [gpu::bind(0, camera), gpu::bind(1, self.plants), gpu::bind(2, self.meta)][..]);
    }
}

impl World {
    fn has(self, cx: i64, cz: i64) -> bool {
        for chunk in self.chunks {
            if chunk.cx == cx && chunk.cz == cz { return true; }
        }
        false
    }

    fn load(inout self, dev: gpu::Device, cx: i64, cz: i64) {
        let chunk = chunk_new(dev, self.pipes, self.params, self.edit_buffer, cx, cz);
        self.chunks.push(chunk);
        self.generated += 1;
    }

    /// Unload outside a one-chunk hysteresis ring and generate at most four new
    /// chunks per call. No density or mesh data is read back during streaming.
    pub fn update(inout self, dev: gpu::Device, queue: inout gpu::Queue,
        camera_x: f64, camera_z: f64, layout: gpu::BindLayout, camera: Buffer) {
        let ccx = chunk_coord(camera_x);
        let ccz = chunk_coord(camera_z);
        var i = 0;
        while i < self.chunks.len() {
            let cx = self.chunks[i].cx;
            let cz = self.chunks[i].cz;
            if abs(cx - ccx) > RADIUS + 1 || abs(cz - ccz) > RADIUS + 1 {
                self.chunks.remove(i);
            } else {
                i += 1;
            }
        }
        var loaded = 0;
        for z in ccz - RADIUS..ccz + RADIUS + 1 {
            for x in ccx - RADIUS..ccx + RADIUS + 1 {
                if loaded < 4 && !self.has(x, z) {
                    self.load(dev, x, z);
                    let at = self.chunks.len() - 1;
                    self.chunks[at].generate(dev, &queue, self.pipes.terrain, self.pipes.mesh);
                    self.chunks[at].bind_render(dev, layout, camera);
                    loaded += 1;
                }
            }
        }
    }

    /// Session edits live outside chunks and are replayed by world-space density
    /// evaluation whenever a chunk reloads. Border expansion also rebuilds the
    /// neighbor meshes whose boundary faces may have changed.
    pub fn sculpt(inout self, dev: gpu::Device, queue: inout gpu::Queue,
        x: f32, y: f32, z: f32, radius: f32, add: bool) -> bool {
        if self.edits.len() >= 1024 { return false; }
        let edit = Edit { data: [x, y, z, radius, if add { 1.0 } else { 0.0 }, 0.0, 0.0, 0.0] };
        self.edits.push(edit);
        queue.write_buffer(self.edit_buffer, (self.edits.len() - 1) * 32,
            gpu::bytes_of_f32(self.edits[self.edits.len() - 1].data[..]));
        let params_data: [f32; 4] = [self.seed as f32, self.edits.len() as f32, 0.0, 0.0];
        queue.write_buffer(self.params, 0, gpu::bytes_of_f32(params_data[..]));
        for i in 0..self.chunks.len() {
            let cx = self.chunks[i].cx * CHUNK;
            let cz = self.chunks[i].cz * CHUNK;
            let margin = radius as i64 + 2;
            if x as i64 >= cx - margin && x as i64 < cx + CHUNK + margin
                && z as i64 >= cz - margin && z as i64 < cz + CHUNK + margin {
                self.chunks[i].generate(dev, &queue, self.pipes.terrain, self.pipes.mesh);
            }
        }
        true
    }

    pub fn generate_initial(inout self, dev: gpu::Device, queue: inout gpu::Queue,
        layout: gpu::BindLayout, camera: Buffer) {
        for i in 0..self.chunks.len() {
            self.chunks[i].generate(dev, &queue, self.pipes.terrain, self.pipes.mesh);
            self.chunks[i].bind_render(dev, layout, camera);
        }
    }
}

// Independent CPU mathematical helpers used by unit tests and placement rules.
pub fn terrain_height_cpu(x: f64, z: f64, seed: u64) -> f64 {
    // UNSAFE: the CPU reference needs C trigonometry, unavailable as safe std calls.
    // SAFETY: all arguments are scalar coordinates; the calls do not access memory.
    let (a, b) = unsafe {
        (
            c::sin(x * 0.031 + seed as f64 * 0.0001) * c::cos(z * 0.027),
            c::sin((x + z) * 0.013 + 1.7),
        )
    };
    12.0 + a * 5.0 + b * 8.0
}

pub fn biome_cpu(height: f64, moisture: f64) -> i64 {
    if height > 33.0 { return 4; }
    if height > 22.0 { return 3; }
    if height < 8.5 { return 2; }
    if moisture > 0.57 { return 1; }
    0
}

pub fn density_cpu(x: f64, y: f64, z: f64, seed: u64) -> f64 {
    terrain_height_cpu(x, z, seed) - y - 0.5
}

pub fn prefix_sum_cpu(input: [u32], output: inout [u32]) -> u32 {
    var running = 0u32;
    for i in 0..input.len() {
        output[i] = running;
        running += input[i];
    }
    running
}

pub fn placement_hash(seed: u64, x: i64, z: i64) -> u32 {
    var n = (x as u32) * 374761393u32 + (z as u32) * 668265263u32 + seed as u32;
    n = (n ^ (n >> 13)) * 1274126177u32;
    n ^ (n >> 16)
}

pub fn plant_candidate(seed: u64, x: i64, z: i64, moisture: f64) -> bool {
    let threshold: u32 = if moisture > 0.57 { 60 } else { 94 };
    placement_hash(seed, x, z) % 100 >= threshold
}

pub fn apply_edit_cpu(initial: f64, distance: f64, radius: f64, add: bool) -> f64 {
    if distance >= radius { return initial; }
    if add {
        if radius - distance > initial { return radius - distance; }
        return initial;
    }
    if distance - radius < initial { return distance - radius; }
    initial
}

pub fn exposed_faces(solid: bool, neighbors: [bool; 6]) -> i64 {
    if !solid { return 0; }
    var faces = 0;
    for neighbor in neighbors {
        if !neighbor { faces += 1; }
    }
    faces
}

#[test]
fn negative_chunk_coordinates_floor_correctly() {
    assert_eq(chunk_coord(0.0), 0);
    assert_eq(chunk_coord(31.9), 0);
    assert_eq(chunk_coord(32.0), 1);
    assert_eq(chunk_coord(-0.1), -1);
    assert_eq(chunk_coord(-32.0), -1);
    assert_eq(chunk_coord(-32.1), -2);
}

#[test]
fn procedural_fields_are_deterministic() {
    for i in 0..32 {
        let x = i as f64 * 7.3 - 50.0;
        let z = i as f64 * -3.1;
        assert_eq(terrain_height_cpu(x, z, 42), terrain_height_cpu(x, z, 42));
        assert_eq(density_cpu(x, 4.0, z, 42), density_cpu(x, 4.0, z, 42));
    }
}

#[test]
fn biome_and_neighbor_rules_cover_boundaries() {
    assert_eq(biome_cpu(40.0, 0.0), 4);
    assert_eq(biome_cpu(25.0, 0.0), 3);
    assert_eq(biome_cpu(5.0, 0.0), 2);
    assert_eq(biome_cpu(15.0, 0.8), 1);
    assert_eq(biome_cpu(15.0, 0.2), 0);
    assert_eq(exposed_faces(false, [false; 6]), 0);
    assert_eq(exposed_faces(true, [false; 6]), 6);
    assert_eq(exposed_faces(true, [true; 6]), 0);
    assert_eq(exposed_faces(true, [true, false, true, false, true, false]), 3);
}

#[test]
fn prefix_offsets_and_placement_do_not_depend_on_order() {
    var offsets: [u32; 4] = [0; 4];
    let input: [u32; 4] = [2, 0, 1, 3];
    let total = prefix_sum_cpu(input[..], &offsets);
    assert_eq(offsets, [0, 2, 2, 3]);
    assert_eq(total, 6);
    let a = plant_candidate(42, -20, 8, 0.8);
    let b = plant_candidate(42, -20, 8, 0.8);
    assert_eq(a, b);
    assert_eq(placement_hash(42, 7, 9) == placement_hash(42, 8, 9), false);
}

#[test]
fn sculpt_operations_are_replayable_and_bounded() {
    let base = density_cpu(4.0, 8.0, 4.0, 1);
    let carved = apply_edit_cpu(base, 0.0, 3.0, false);
    assert_eq(carved < 0.0, true);
    let filled = apply_edit_cpu(carved, 0.0, 3.0, true);
    assert_eq(filled > 0.0, true);
    assert_eq(apply_edit_cpu(base, 5.0, 3.0, false), base);
}

#[test]
fn shared_world_coordinates_have_identical_density() {
    let left = density_cpu(-1.0, 8.0, 20.0, 7);
    let right = density_cpu(-1.0, 8.0, 20.0, 7);
    assert_eq(left, right);
}
