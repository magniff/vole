// EDITION: rust
// Free-fly camera using only std::window's absolute mouse/key events.

#[derive(Clone, Copy)]
pub struct Camera {
    pub x: f64,
    pub y: f64,
    pub z: f64,
    pub yaw: f64,
    pub pitch: f64,
    pub speed: f64,
}

pub fn camera_default() -> Camera {
    Camera { x: 18.0, y: 48.0, z: 48.0, yaw: 0.20, pitch: -0.48, speed: 18.0 }
}

impl Camera {
    pub fn forward(self) -> [f64; 3] {
        let (sy, cy, sp, cp) = (self.yaw.sin(), self.yaw.cos(), self.pitch.sin(), self.pitch.cos());
        [sy * cp, sp, -cy * cp]
    }

    pub fn right(self) -> [f64; 3] {
        [self.yaw.cos(), 0.0, self.yaw.sin()]
    }

    pub fn look(&mut self, dx: f64, dy: f64) {
        self.yaw -= dx * 0.004;
        self.pitch = (self.pitch - dy * 0.004).clamp(-1.45, 1.45);
    }

    pub fn fly(&mut self, dt: f64, forward: f64, strafe: f64, vertical: f64) {
        let f = self.forward();
        let r = self.right();
        self.x += (f[0] * forward + r[0] * strafe) * self.speed * dt;
        self.y += (f[1] * forward + vertical) * self.speed * dt;
        self.z += (f[2] * forward + r[2] * strafe) * self.speed * dt;
        self.y = self.y.clamp(2.0, 90.0);
    }
}

#[test]
fn camera_moves_and_stays_finite() {
    let mut cam = camera_default();
    let x = cam.x;
    cam.fly(0.1, 1.0, 0.0, 0.0);
    assert_eq(cam.x != x, true);
    cam.look(10.0, -10000.0);
    assert_eq(cam.pitch <= 1.45, true);
    cam.look(0.0, 10000.0);
    assert_eq(cam.pitch >= -1.45, true);
}
