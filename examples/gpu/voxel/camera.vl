// Free-fly camera using only std::window's absolute mouse/key events.

import "math.h" as c;

use std::clamp;

pub struct Camera {
    pub x: f64,
    pub y: f64,
    pub z: f64,
    pub yaw: f64,
    pub pitch: f64,
    pub speed: f64,
}

pub fn camera_default() -> Camera {
    Camera { x: 18.0, y: 48.0, z: 48.0, yaw: 0.20, pitch: -0.48, speed: 18.0 }
}

impl Camera {
    pub fn forward(self) -> [f64; 3] {
        // UNSAFE: Vole has no safe trigonometric std function, so call C math.
        // SAFETY: scalar inputs are finite camera angles; C sin/cos cannot access memory.
        let (sy, cy, sp, cp) = unsafe {
            (c::sin(self.yaw), c::cos(self.yaw), c::sin(self.pitch), c::cos(self.pitch))
        };
        [sy * cp, sp, -cy * cp]
    }

    pub fn right(self) -> [f64; 3] {
        // UNSAFE: Vole has no safe trigonometric std function, so call C math.
        // SAFETY: yaw is a finite scalar; these calls have no memory side effects.
        unsafe { [c::cos(self.yaw), 0.0, c::sin(self.yaw)] }
    }

    pub fn look(inout self, dx: f64, dy: f64) {
        self.yaw -= dx * 0.004;
        self.pitch = clamp(self.pitch - dy * 0.004, -1.45, 1.45);
    }

    pub fn fly(inout self, dt: f64, forward: f64, strafe: f64, vertical: f64) {
        let f = self.forward();
        let r = self.right();
        self.x += (f[0] * forward + r[0] * strafe) * self.speed * dt;
        self.y += (f[1] * forward + vertical) * self.speed * dt;
        self.z += (f[2] * forward + r[2] * strafe) * self.speed * dt;
        self.y = clamp(self.y, 2.0, 90.0);
    }
}

#[test]
fn camera_moves_and_stays_finite() {
    var cam = camera_default();
    let x = cam.x;
    cam.fly(0.1, 1.0, 0.0, 0.0);
    assert_eq(cam.x != x, true);
    cam.look(10.0, -10000.0);
    assert_eq(cam.pitch <= 1.45, true);
    cam.look(0.0, 10000.0);
    assert_eq(cam.pitch >= -1.45, true);
}
