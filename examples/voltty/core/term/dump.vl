// The dump: the terminal's state as text, in the format of
// examples/voltty/core/oracle/FORMAT.md, which the oracle prints for
// alacritty_terminal. Two dumps are equal when the terminals are.

use crate::vt::utf8;

use super::{SHAPE_BEAM, SHAPE_BLOCK, SHAPE_UNDERLINE, Term, push_hex2};
use super::cell::{COLOR_INDEXED, COLOR_NAMED, Cell, DEFAULT_BG, DEFAULT_FG, TAG_MASK, VALUE_MASK};
use super::grid::{Cursor, NO_COLOR};

impl Term<Gpa> {
    // Appends the dump to `out`; the replies and clipboard stores since the
    // last dump are printed and cleared.
    pub fn dump(&mut self, out: &mut Vec<u8, Gpa>) {
        let lines = self.grid.lines;
        let cols = self.grid.cols;
        out.extend_from_slice(format_in("size {lines} {cols}\n", *out.allocator()).as_bytes());
        let c = self.grid.cursor;
        out.extend_from_slice(format_in("cursor {} {} {}\n", c.line, c.col, c.needs_wrap as i64,
            *out.allocator()).as_bytes());
        let mut shape = SHAPE_BLOCK;
        let mut blink = false;
        if self.style_set {
            shape = self.style_shape;
            blink = self.style_blink;
        }
        let name = if shape == SHAPE_UNDERLINE { "underline" }
            else if shape == SHAPE_BEAM { "beam" } else { "block" };
        out.extend_from_slice(
            format_in("style {name} {}\nmode ", blink as i64, *out.allocator()).as_bytes());
        push_hex(out, self.mode as i64);
        out.push(b'\n');
        if self.has_shown_title {
            out.extend_from_slice(b"title ");
            escape_bytes(out, self.shown_title.as_slice());
            out.push(b'\n');
        } else {
            out.extend_from_slice(b"title -\n");
        }
        out.extend_from_slice(b"tmpl ");
        self.cursor_attrs(out, c);
        out.extend_from_slice(b"\ncharsets ");
        charsets(out, c);
        let s = self.grid.saved;
        out.extend_from_slice(format_in("\nsaved {} {} {} ", s.line, s.col, s.needs_wrap as i64,
            *out.allocator()).as_bytes());
        self.cursor_attrs(out, s);
        out.push(b' ');
        charsets(out, s);
        out.push(b'\n');
        for i in 0..self.colors.len() {
            let v = self.colors[i];
            if v >= 0 {
                out.extend_from_slice(format_in("color {i} #", *out.allocator()).as_bytes());
                push_hex2(out, (v >> 16) & 0xFF, false);
                push_hex2(out, (v >> 8) & 0xFF, false);
                push_hex2(out, v & 0xFF, false);
                out.push(b'\n');
            }
        }
        if self.reply.len() > 0 {
            out.extend_from_slice(b"reply ");
            escape_bytes(out, self.reply.as_slice());
            out.push(b'\n');
            self.reply.clear();
        }
        for i in 0..self.clip_kind.len() {
            out.extend_from_slice(b"clip ");
            out.push(self.clip_kind[i]);
            out.push(b' ');
            escape_bytes(out, self.clip_text[i].as_slice());
            out.push(b'\n');
        }
        self.clear_clips();
        let hist = self.grid.hist();
        out.extend_from_slice(format_in("history {hist}\n", *out.allocator()).as_bytes());
        let mut a = Vec::<u8, Gpa>::new_in(self.gpa_of());
        let mut b = Vec::<u8, Gpa>::new_in(self.gpa_of());
        let mut l = -hist;
        while l < lines {
            let r = self.grid.row(l);
            let mut end = cols;
            while end > 0 && self.is_blank(r[(end - 1) as usize]) {
                end -= 1;
            }
            out.extend_from_slice(format_in("row {l} ", *out.allocator()).as_bytes());
            for x in 0..end {
                escape_char(out, r[x as usize].c());
                let id = r[x as usize].extra_id();
                if self.extras.has_zw(id) {
                    for &z in self.extras.zw(id) {
                        out.extend_from_slice(b"\\+{");
                        push_hex(out, z as i64);
                        out.push(b'}');
                    }
                }
            }
            out.push(b'\n');
            let mut x: i64 = 0;
            while x < cols {
                a.clear();
                self.cell_attrs(&mut a, r[x as usize]);
                if a.as_slice() == b"n256 n257 0 - -" {
                    x += 1;
                    continue;
                }
                let mut y = x + 1;
                while y < cols {
                    b.clear();
                    self.cell_attrs(&mut b, r[y as usize]);
                    if b.as_slice() != a.as_slice() {
                        break;
                    }
                    y += 1;
                }
                out.extend_from_slice(
                    format_in("attr {l} {x}-{} ", y - 1, *out.allocator()).as_bytes());
                out.extend_from_slice(a.as_slice());
                out.push(b'\n');
                x = y;
            }
            l += 1;
        }
        out.extend_from_slice(b"end\n");
    }

    fn is_blank(&self, c: Cell) -> bool {
        if c.c() != 32 || c.fg != DEFAULT_FG || c.bg != DEFAULT_BG || c.flags != 0 {
            return false;
        }
        let id = c.extra_id();
        id == 0
            || !self.extras.has_zw(id) && self.extras.ul(id) == NO_COLOR
            && self.extras.link(id) == 0
    }

    // `fg bg flags ul link`.
    fn cell_attrs(&self, out: &mut Vec<u8, Gpa>, c: Cell) {
        push_color(out, c.fg);
        out.push(b' ');
        push_color(out, c.bg);
        out.push(b' ');
        push_hex(out, c.flags as i64);
        out.push(b' ');
        let id = c.extra_id();
        let mut ul = NO_COLOR;
        let mut link: i64 = 0;
        if id != 0 {
            ul = self.extras.ul(id);
            link = self.extras.link(id);
        }
        if ul == NO_COLOR {
            out.push(b'-');
        } else {
            push_color(out, ul);
        }
        out.push(b' ');
        self.push_link(out, link);
    }

    fn cursor_attrs(&mut self, out: &mut Vec<u8, Gpa>, c: Cursor) {
        push_color(out, c.fg);
        out.push(b' ');
        push_color(out, c.bg);
        out.push(b' ');
        push_hex(out, c.flags as i64);
        out.push(b' ');
        if c.ul == NO_COLOR {
            out.push(b'-');
        } else {
            push_color(out, c.ul);
        }
        out.push(b' ');
        self.push_link(out, c.link);
    }

    fn push_link(&self, out: &mut Vec<u8, Gpa>, link: i64) {
        if link == 0 {
            out.push(b'-');
            return;
        }
        if self.extras.links[link as usize].auto_id {
            out.push(b'*');
        } else {
            escape_bytes(out, self.extras.links[link as usize].id.as_slice());
        }
        out.push(b'|');
        escape_bytes(out, self.extras.links[link as usize].uri.as_slice());
    }
}

fn charsets(out: &mut Vec<u8, Gpa>, c: Cursor) {
    for k in 0..4 {
        out.push(if c.charsets[k as usize] == 1 { b'g' } else { b'a' });
    }
}

fn push_color(out: &mut Vec<u8, Gpa>, c: u32) {
    let tag = c & TAG_MASK;
    let v = (c & VALUE_MASK) as i64;
    if tag == COLOR_NAMED {
        out.push(b'n');
        out.extend_from_slice(format_in("{}", v, *out.allocator()).as_bytes());
    } else if tag == COLOR_INDEXED {
        out.push(b'i');
        out.extend_from_slice(format_in("{}", v, *out.allocator()).as_bytes());
    } else {
        out.push(b'#');
        push_hex2(out, (v >> 16) & 0xFF, false);
        push_hex2(out, (v >> 8) & 0xFF, false);
        push_hex2(out, v & 0xFF, false);
    }
}

pub fn push_hex(out: &mut Vec<u8, Gpa>, v: i64) {
    let digits = "0123456789abcdef";
    if v == 0 {
        out.push(b'0');
        return;
    }
    let mut tmp: [u8; 16] = [0; 16];
    let mut n: i64 = 0;
    let mut x = v;
    while x > 0 {
        tmp[n as usize] = digits[(x & 15) as usize];
        x = x >> 4;
        n += 1;
    }
    while n > 0 {
        n -= 1;
        out.push(tmp[n as usize]);
    }
}

// A cell's character: printable ASCII as itself (but `\`), U+00A0 and up
// as UTF-8, the rest `\u{X}`.
fn escape_char(out: &mut Vec<u8, Gpa>, c: u32) {
    if c >= 0x20 && c < 0x7F && c != 0x5C {
        out.push(c as u8);
    } else if c >= 0xA0 {
        let mut tmp: [u8; 4] = [0; 4];
        let n = utf8::encode(c, &mut tmp[..], 0);
        out.extend_from_slice(&tmp[0..n as usize]);
    } else {
        out.extend_from_slice(b"\\u{");
        push_hex(out, c as i64);
        out.push(b'}');
    }
}

// Bytes: printable ASCII as itself (but `\`), the rest `\xNN`.
pub fn escape_bytes(out: &mut Vec<u8, Gpa>, s: &[u8]) {
    for &b in s {
        if b >= 0x20 && b < 0x7F && b != 0x5C {
            out.push(b);
        } else {
            out.extend_from_slice(b"\\x");
            push_hex2(out, b as i64, false);
        }
    }
}
