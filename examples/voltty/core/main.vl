// voltty, the terminal emulator of vole 0.23 (docs/design/terminal.md),
// headless: the parser (vt/), the terminal state (term/), the input
// encoders (input/), the pty (pty.vl). The window and the renderer join
// it on std::window and std::gpu; without them it runs this way:
//
//   voltty --dump LINES COLS HISTORY   stdin through the terminal, then its dump
//   voltty --script                    the oracle's script format on stdin
//                                      (oracle/FORMAT.md)
//   voltty --bench [-n RUNS] FILE...   parse + grid throughput, 120x40, 10,000 lines
//   voltty --run LINES COLS [--send TEXT] [--send-n N] -- CMD ARG...
//                                      CMD on a pty, TEXT (or N bytes `a`) typed
//                                      to it after its first output, until it
//                                      exits; then the dump
//   voltty --keys                      key, mouse and paste encodings (input/),
//                                      a table of events on stdin
//
// `--escaped` before the mode reads stdin with `\e`, `\n`, `\xNN` escapes
// (for test cases, whose stdin is text).

mod input;
mod pty;
mod sys;
mod term;
mod vt;

use std::io;
use std::alloc::Allocator;
use std::cli::{Arg, Command};
use std::io::Read;

use term::Term;
use vt::Parser;

// The OSC buffer: OSC 52 clipboard payloads fit (vte has no limit).
const OSC_LIMIT: i64 = 1048576;

fn number(s: &[u8]) -> i64 {
    match std::str::from_utf8(s) {
        Ok(t) => t.parse::<i64>().unwrap_or(-1),
        Err(_) => -1,
    }
}

// `\e`, `\n`, `\r`, `\t`, `\\`, `\xNN`.
fn unescape(s: &[u8], gpa: Gpa) -> Vec<u8, Gpa> {
    let mut out: Vec<u8, Gpa> = Vec::new_in(gpa);
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let c = s[i as usize];
        if c == b'\\' && i + 1 < s.len() as i64 {
            let d = s[(i + 1) as usize];
            if d == b'e' {
                out.push(0x1Bu8);
                i += 2;
            } else if d == b'n' {
                out.push(b'\n');
                i += 2;
            } else if d == b'r' {
                out.push(b'\r');
                i += 2;
            } else if d == b't' {
                out.push(b'\t');
                i += 2;
            }
            else if d == b'x' && i + 3 < s.len() as i64 && hexval(s[(i + 2) as usize]) >= 0
                && hexval(s[(i + 3) as usize]) >= 0 {
                out.push((hexval(s[(i + 2) as usize]) * 16 + hexval(s[(i + 3) as usize])) as u8);
                i += 4;
            } else {
                out.push(d);
                i += 2;
            }
        } else {
            out.push(c);
            i += 1;
        }
    }
    out
}

fn hexval(c: u8) -> i64 {
    if c >= b'0' && c <= b'9' {
        (c - b'0') as i64
    } else if c >= b'a' && c <= b'f' {
        (c - b'a') as i64 + 10
    } else if c >= b'A' && c <= b'F' {
        (c - b'A') as i64 + 10
    } else {
        -1
    }
}

// A terminal and its parser, with the parser's OSC buffer.
struct Session<A: Allocator> {
    term: Term<A>,
    parser: Parser<A>,
}

fn session(lines: i64, cols: i64, history: i64, gpa: Gpa) -> Session<Gpa> {
    Session {
        term: Term::new_in(lines, cols, history, gpa), parser: Parser::new_in(OSC_LIMIT, gpa),
    }
}

fn dump_mode(lines: i64, cols: i64, history: i64, input: &[u8], gpa: Gpa) {
    let mut s = session(lines, cols, history, gpa);
    s.term.feed(&mut s.parser, input);
    let mut out = Vec::<u8, Gpa>::new_in(gpa);
    s.term.stop_sync(&mut s.parser);
    s.term.dump(&mut out);
    sys::write_all(1, out.as_slice());
}

// The script format (oracle/FORMAT.md): `T lines cols history`, `D n`
// then n bytes, `R lines cols`, `P`.
fn script_mode(input: &[u8], gpa: Gpa) -> i32 {
    let mut out = Vec::<u8, Gpa>::new_in(gpa);
    let mut s = session(1, 2, 0, gpa);
    let mut have = false;
    let mut at: i64 = 0;
    while at < input.len() as i64 {
        let mut nl = at;
        while nl < input.len() as i64 && input[nl as usize] != b'\n' {
            nl += 1;
        }
        let line = &input[at as usize..nl as usize];
        at = nl + 1;
        if line.len() == 0 {
            continue;
        }
        let words: Vec<&[u8], Gpa> = line.split(|&b| b == b' ').collect_in(gpa);
        let cmd = words[0];
        if cmd == b"T" && words.len() == 4 {
            s = session(number(words[1]), number(words[2]), number(words[3]), gpa);
            have = true;
        } else if cmd == b"D" && words.len() == 2 {
            let n = number(words[1]);
            let mut end = at + n;
            if end > input.len() as i64 {
                end = input.len() as i64;
            }
            if have {
                s.term.feed(&mut s.parser, &input[at as usize..end as usize]);
            }
            at = end;
        } else if cmd == b"R" && words.len() == 3 {
            if have {
                s.term.stop_sync(&mut s.parser);
                s.term.resize(number(words[1]), number(words[2]));
            }
        } else if cmd == b"P" {
            if have {
                s.term.stop_sync(&mut s.parser);
                s.term.dump(&mut out);
            }
        } else {
            eprintln("voltty: unknown script line {}", String::from_utf8_lossy_in(line, gpa));
            return 2;
        }
    }
    sys::write_all(1, out.as_slice());
    0
}

// The throughput of parser and grid on each file: the best of `runs`, fed
// in 64 KiB chunks (a pty read's size) to a 120x40 terminal with 10,000
// lines of scrollback.
fn bench_mode(files: &[&str], runs: i64, gpa: Gpa) -> i32 {
    for &f in files {
        let data = match sys::read_file(f.as_bytes(), gpa) {
            Some(d) => d,
            None => {
                eprintln("voltty: cannot read {f}");
                return 2;
            }
        };
        let bytes = data.as_slice();
        let mut best: i64 = 0;
        for r in 0..runs {
            let mut s = session(40, 120, 10000, gpa);
            let t0 = sys::now_ns();
            let mut at: i64 = 0;
            while at < bytes.len() as i64 {
                let mut end = at + 65536;
                if end > bytes.len() as i64 {
                    end = bytes.len() as i64;
                }
                s.term.feed(&mut s.parser, &bytes[at as usize..end as usize]);
                at = end;
            }
            let t = sys::now_ns() - t0;
            if r == 0 || t < best {
                best = t;
            }
        }
        let mib = bytes.len() as f64 / 1048576.0;
        let ms = best as f64 / 1000000.0;
        let rate = mib / (ms / 1000.0);
        println("{f}: {mib:.1} MiB in {ms:.1} ms, {rate:.0} MiB/s");
    }
    0
}

fn usage() -> i32 {
    eprintln("usage: voltty [--escaped] --dump LINES COLS HISTORY | --script | --bench [-n RUNS] FILE... | --run LINES COLS -- CMD ARG... | --keys");
    2
}

fn main(gpa: Gpa) -> i32 {
    let cli = Command::new_in("voltty", gpa).about("voltty's terminal core, headless")
        .arg(Arg::flag("escaped").help("read stdin with \\e, \\n, \\xNN escapes (for test cases)"))
        .arg(Arg::flag("dump").help("LINES COLS HISTORY: stdin through the terminal, its dump"))
        .arg(Arg::flag("script").help("the oracle's script format on stdin (oracle/FORMAT.md)"))
        .arg(Arg::flag("bench").help("FILE...: parse + grid throughput, 120x40, 10,000 lines"))
        .arg(Arg::flag("run")
            .help("LINES COLS -- CMD ARG...: CMD on a pty until it exits; then the dump"))
        .arg(Arg::flag("keys").help("key, mouse and paste encodings of a table of events on stdin"))
        .arg(Arg::option("runs").short('n').default("5").help("--bench: the best of RUNS"))
        .arg(Arg::option("send").value_name("TEXT")
            .help("--run: typed to CMD after its first output"))
        .arg(Arg::option("send-n").value_name("N").help("--run: then N bytes `a` (a large paste)"))
        .arg(Arg::positional("operand").multiple().help("the mode's operands"));
    let m = cli.parse_or_exit(std::env::args());
    let args = m.values("operand");
    let mut modes: i64 = 0;
    let all: [&str; 5] = ["dump", "script", "bench", "run", "keys"];
    for mode in all {
        if m.flag(mode) {
            modes += 1;
        }
    }
    if modes != 1 {
        return usage();
    }
    if m.flag("bench") {
        let runs = number(m.get("runs").unwrap_or("5").as_bytes());
        return bench_mode(args, runs, gpa);
    }
    if m.flag("run") {
        if args.len() < 3 {
            return usage();
        }
        let lines = number(args[0].as_bytes());
        let cols = number(args[1].as_bytes());
        let mut send: Vec<u8, Gpa> = Vec::new_in(gpa);
        if let Some(text) = m.get("send") {
            send = unescape(text.as_bytes(), gpa);
        }
        if let Some(n) = m.get("send-n") {
            // N bytes `a` (a large paste: the queue holds what the pty
            // does not take yet)
            for _ in 0..number(n.as_bytes()) {
                send.push(b'a');
            }
        }
        let mut cmd: Vec<&[u8], Gpa> = Vec::new_in(gpa);
        for a in &args[2..] {
            cmd.push(a.as_bytes());
        }
        return pty::run_headless(lines, cols, cmd.as_slice(), send.as_slice(), gpa);
    }
    let mut raw: Vec<u8, Gpa> = Vec::new_in(gpa);
    io::stdin().read_to_end(&mut raw).unwrap();
    let input = if m.flag("escaped") { unescape(raw.as_slice(), gpa) } else { raw };
    let mut rc: i32 = 0;
    if m.flag("dump") {
        let lines: i64 = if args.len() >= 3 { number(args[0].as_bytes()) } else { -1 };
        let cols: i64 = if args.len() >= 3 { number(args[1].as_bytes()) } else { -1 };
        let hist: i64 = if args.len() >= 3 { number(args[2].as_bytes()) } else { -1 };
        if lines < 1 || cols < 2 || hist < 0 {
            rc = usage();
        } else {
            dump_mode(lines, cols, hist, input.as_slice(), gpa);
        }
    } else if m.flag("script") {
        rc = script_mode(input.as_slice(), gpa);
    } else {
        rc = input::run_table(input.as_slice(), gpa);
    }
    rc
}
