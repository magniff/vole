pub extern "C" {
    fn strlen(s: *mut u8) -> u64;
}

// MTLClearColor: four doubles, an HFA passed in v0-v3.
#[derive(Clone, Copy)]
#[repr(C)]
pub struct ClearColor {
    pub r: f64,
    pub g: f64,
    pub b: f64,
    pub a: f64,
}

// MTLRegion: an origin and a size of three u64 each (48 bytes: passed
// by reference to a copy, as AAPCS64 says for large aggregates).
#[derive(Clone, Copy)]
#[repr(C)]
pub struct MtlRegion {
    pub x: u64,
    pub y: u64,
    pub z: u64,
    pub w: u64,
    pub h: u64,
    pub d: u64,
}

// A class by name; null when the runtime has none (its framework is not
// loaded).
pub fn class(name: *const u8) -> *mut u8 {
    // SAFETY: objc_getClass reads a NUL-terminated name; every caller
    // passes a c"..." literal.
    unsafe { objc_getClass(name) }
}

// A selector by name (registered on first use).
pub fn sel(name: *const u8) -> *mut u8 {
    // SAFETY: as `class`: a NUL-terminated literal.
    unsafe { sel_registerName(name) }
}

// The text of a C string as a slice, valid while the string is (for an
// NSString's UTF8String: until the autorelease pool around it is
// popped).
pub unsafe fn cstr(p: *mut u8) -> &'static [u8] {
    if p == 0 as *mut u8 {
        return b"";
    }
    std::slice::from_raw_parts(p, strlen(p) as usize)
}

// The type encoding of an instance method `name` of class `cls` (or of
// its superclasses), or of the protocol `proto`'s method: the encoding a
// method added to a subclass must have. Null when neither has it.
pub fn method_types(cls: *mut u8, proto: *mut u8, name: *mut u8) -> *mut u8 {
    let s = sel(name);
    // SAFETY: the runtime's metadata queries take a class (or null), a
    // protocol (or null) and a selector; they return null or a pointer
    // into the runtime's own (immortal) metadata.
    unsafe {
        if cls != 0 as *mut u8 {
            let m = class_getInstanceMethod(cls, s);
            if m != 0 as *mut u8 {
                return method_getTypeEncoding(m);
            }
        }
        if proto != 0 as *mut u8 {
            let d = protocol_getMethodDescription(proto, s, true, true);
            if d.types != 0 as *mut u8 {
                return d.types;
            }
            let o = protocol_getMethodDescription(proto, s, false, true);
            return o.types;
        }
    }
    0 as *mut u8
}

// An autoreleased NSString with the bytes of `s` (UTF-8). Valid until
// the enclosing autorelease pool is popped; `retain` keeps it longer.
pub fn nsstring(s: &[u8]) -> *mut u8 {
    // SAFETY: -[NSString initWithBytes:length:encoding:] reads exactly
    // `len` bytes at `ptr`; `s` is a live slice. NSUTF8StringEncoding is
    // 4. alloc/init returns +1, balanced by autorelease.
    unsafe {
        let a = msg_p(class(c"NSString"), sel(c"alloc"));
        let o = msg_p_puu(a, sel(c"initWithBytes:length:encoding:"), s.as_ptr(), s.len() as u64, 4);
        msg_p(o, sel(c"autorelease"))
    }
}

pub extern "C" {
    #[link_name = "objc_msgSend"]
    fn msg_p_puu(o: *mut u8, s: *mut u8, a: *const u8, b: u64, c: u64) -> *mut u8;
}

// The UTF-8 bytes of an NSString (or NSAttributedString's string), a
// view valid until the current autorelease pool is popped.
pub fn nsstring_bytes(o: *mut u8) -> &'static [u8] {
    if o == 0 as *mut u8 {
        return b"";
    }
    // SAFETY: `o` is an NSString (callers pass the results of methods
    // typed NSString); UTF8String returns an inner pointer that lives as
    // long as the pool the caller is inside.
    unsafe {
        let p = msg_p(o, sel(c"UTF8String"));
        cstr(p)
    }
}

pub fn retain(o: *mut u8) -> *mut u8 {
    // SAFETY: objc_retain takes any object or nil.
    unsafe { objc_retain(o) }
}

pub fn release(o: *mut u8) {
    // SAFETY: callers release only what they retained (or got at +1).
    unsafe { objc_release(o); }
}

pub fn pool_push() -> *mut u8 {
    // SAFETY: push and pop are paired by every caller, on the main thread.
    unsafe { objc_autoreleasePoolPush() }
}

pub fn pool_pop(p: *mut u8) {
    // SAFETY: `p` is the token of the matching push.
    unsafe { objc_autoreleasePoolPop(p); }
}
