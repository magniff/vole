    #[link_name = "objc_msgSend"]
    fn msg_p_r(o: *mut u8, s: *mut u8, a: Rect) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_ruub(o: *mut u8, s: *mut u8, a: Rect, b: u64, c: u64, d: bool) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_rupp(o: *mut u8, s: *mut u8, a: Rect, b: u64, c: *mut u8, d: *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_uppb(o: *mut u8, s: *mut u8, a: u64, b: *mut u8, c: *mut u8, d: bool) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_uuub(o: *mut u8, s: *mut u8, a: u64, b: u64, c: u64, d: bool) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_ppP(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8, err: *mut *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_pP(o: *mut u8, s: *mut u8, a: *mut u8, err: *mut *mut u8) -> *mut u8;
    // otherEventWithType:location:modifierFlags:timestamp:windowNumber:
    // context:subtype:data1:data2:
    #[link_name = "objc_msgSend"]
    fn msg_p_utudipsii(o: *mut u8, s: *mut u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,
        ctx: *mut u8, sub: i16, d1: i64, d2: i64) -> *mut u8;
    // keyEventWithType:location:modifierFlags:timestamp:windowNumber:
    // context:characters:charactersIgnoringModifiers:isARepeat:keyCode:
    #[link_name = "objc_msgSend"]
    fn msg_p_utudipppbh(o: *mut u8, s: *mut u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,
        ctx: *mut u8, chars: *mut u8, plain: *mut u8, repeat: bool, code: u16) -> *mut u8;
    // mouseEventWithType:location:modifierFlags:timestamp:windowNumber:
    // context:eventNumber:clickCount:pressure:
