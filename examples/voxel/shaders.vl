// GPU procedural terrain and rendering. All functions use world coordinates,
// so shared chunk borders and load order cannot change the generated world.

pub const WORLD_WGSL: [u8] = "struct Params { seed: vec4<f32> }\n\
    struct Info { chunk: vec4<f32> }\n\
    struct Vertex { pos: vec4<f32>, normal: vec4<f32>, color: vec4<f32> }\n\
    struct Edit { data: vec4<f32>, kind: vec4<f32> }\n\
    @group(0) @binding(0) var<uniform> params: Params;\n\
    @group(0) @binding(1) var<uniform> info: Info;\n\
    @group(0) @binding(2) var<storage, read_write> density: array<f32>;\n\
    @group(0) @binding(3) var<storage, read_write> offsets: array<u32>;\n\
    @group(0) @binding(4) var<storage, read_write> vertices: array<Vertex>;\n\
    @group(0) @binding(5) var<storage, read_write> meta: array<atomic<u32>>;\n\
    @group(0) @binding(6) var<storage, read_write> water: array<Vertex>;\n\
    @group(0) @binding(7) var<storage, read_write> plants: array<Vertex>;\n\
    @group(0) @binding(8) var<storage, read> edits: array<Edit>;\n\
    const N: u32 = 32u;\n\
    const H: u32 = 48u;\n\
    const WATER: f32 = 12.0;\n\
    const MAX_FACES: u32 = 12288u;\n\
    fn hash2(x: i32, z: i32) -> f32 {\n\
    var n = u32(x) * 374761393u + u32(z) * 668265263u + u32(params.seed.x) * 1442695041u;\n\
    n = (n ^ (n >> 13u)) * 1274126177u;\n\
    n = n ^ (n >> 16u);\n\
    return f32(n & 0x00ffffffu) / 16777215.0;\n\
    }\n\
    fn noise2(x: f32, z: f32) -> f32 {\n\
    let ix = i32(floor(x));\n\
    let iz = i32(floor(z));\n\
    var fx = x - floor(x);\n\
    var fz = z - floor(z);\n\
    fx = fx * fx * (3.0 - 2.0 * fx);\n\
    fz = fz * fz * (3.0 - 2.0 * fz);\n\
    let a = hash2(ix, iz);\n\
    let b = hash2(ix + 1, iz);\n\
    let c = hash2(ix, iz + 1);\n\
    let d = hash2(ix + 1, iz + 1);\n\
    return mix(mix(a, b, fx), mix(c, d, fx), fz);\n\
    }\n\
    fn fbm(x: f32, z: f32) -> f32 {\n\
    var sum = 0.0;\n\
    var amplitude = 0.5;\n\
    var frequency = 1.0;\n\
    for (var i = 0; i < 5; i += 1) {\n\
    sum += noise2(x * frequency, z * frequency) * amplitude;\n\
    frequency *= 2.03;\n\
    amplitude *= 0.5;\n\
    }\n\
    return sum;\n\
    }\n\
    fn height(x: f32, z: f32) -> f32 {\n\
    let warp_x = noise2(x * 0.009 + 17.0, z * 0.009 + 3.0) - 0.5;\n\
    let warp_z = noise2(x * 0.009 - 8.0, z * 0.009 + 29.0) - 0.5;\n\
    let wx = x + warp_x * 34.0;\n\
    let wz = z + warp_z * 34.0;\n\
    let broad = fbm(wx * 0.009, wz * 0.009);\n\
    let detail = fbm(wx * 0.035 + 40.0, wz * 0.035 - 20.0);\n\
    let ridge_noise = noise2(wx * 0.014 + 70.0, wz * 0.014 - 30.0);\n\
    let ridge = pow(1.0 - abs(ridge_noise * 2.0 - 1.0), 3.0);\n\
    return 4.0 + broad * 15.0 + detail * 7.0 + ridge * ridge * 20.0;\n\
    }\n\
    fn apply_edits(x: f32, y: f32, z: f32, initial: f32) -> f32 {\n\
    var d = initial;\n\
    for (var i = 0u; i < u32(params.seed.y); i += 1u) {\n\
    let edit = edits[i];\n\
    let distance = length(vec3<f32>(x, y, z) - edit.data.xyz);\n\
    if distance < edit.data.w {\n\
    if edit.kind.x < 0.5 { d = min(d, distance - edit.data.w); }\n\
    else { d = max(d, edit.data.w - distance); }\n\
    }\n\
    }\n\
    return d;\n\
    }\n\
    fn density_from_height(x: i32, y: i32, z: i32, h: f32) -> f32 {\n\
    var d = h - f32(y) - 0.5;\n\
    if y > 3 {\n\
    let cave = abs(sin(f32(x) * 0.13 + sin(f32(z) * 0.09))\n\
    + sin(f32(z) * 0.17 - f32(y) * 0.11) + sin(f32(y) * 0.19 + f32(x) * 0.07));\n\
    d = min(d, (cave - 0.48) * 5.0);\n\
    }\n\
    return apply_edits(f32(x), f32(y), f32(z), d);\n\
    }\n\
    fn world_density(x: i32, y: i32, z: i32) -> f32 {\n\
    if y < 0 { return 10.0; }\n\
    if y >= 48 { return -10.0; }\n\
    return density_from_height(x, y, z, height(f32(x), f32(z)));\n\
    }\n\
    fn index(x: u32, y: u32, z: u32) -> u32 { return (y * N + z) * N + x; }\n\
    fn solid(x: i32, y: i32, z: i32, base: vec3<i32>) -> bool {\n\
    if x >= 0 && x < 32 && y >= 0 && y < 48 && z >= 0 && z < 32 {\n\
    return density[index(u32(x), u32(y), u32(z))] > 0.0;\n\
    }\n\
    return world_density(base.x + x, base.y + y, base.z + z) > 0.0;\n\
    }\n\
    @compute @workgroup_size(8, 8)\n\
    fn terrain(@builtin(global_invocation_id) gid: vec3<u32>) {\n\
    if gid.x >= N || gid.y >= N { return; }\n\
    let wx = i32(info.chunk.x) * 32 + i32(gid.x);\n\
    let wz = i32(info.chunk.y) * 32 + i32(gid.y);\n\
    let h = height(f32(wx), f32(wz));\n\
    for (var y = 0u; y < H; y += 1u) {\n\
    density[index(gid.x, y, gid.y)] = density_from_height(wx, i32(y), wz, h);\n\
    }\n\
    }\n\
    var<workgroup> scan: array<u32, 256>;\n\
    fn face_count(x: i32, y: i32, z: i32, base: vec3<i32>) -> u32 {\n\
    if !solid(x, y, z, base) { return 0u; }\n\
    var count = 0u;\n\
    if !solid(x + 1, y, z, base) { count += 1u; }\n\
    if !solid(x - 1, y, z, base) { count += 1u; }\n\
    if !solid(x, y + 1, z, base) { count += 1u; }\n\
    if !solid(x, y - 1, z, base) { count += 1u; }\n\
    if !solid(x, y, z + 1, base) { count += 1u; }\n\
    if !solid(x, y, z - 1, base) { count += 1u; }\n\
    return count;\n\
    }\n\
    fn biome(x: f32, z: f32, y: f32, normal_y: f32) -> vec3<f32> {\n\
    let h = height(x, z);\n\
    let moisture = noise2(x * 0.013 + 90.0, z * 0.013 - 40.0);\n\
    var color = vec3<f32>(0.28, 0.43, 0.16);\n\
    if moisture > 0.57 { color = vec3<f32>(0.12, 0.29, 0.12); }\n\
    if h < WATER + 0.5 { color = vec3<f32>(0.68, 0.59, 0.36); }\n\
    if h > 22.0 || normal_y < 0.5 { color = vec3<f32>(0.42, 0.41, 0.40); }\n\
    if h > 33.0 && normal_y > 0.5 { color = vec3<f32>(0.82, 0.87, 0.91); }\n\
    let variation = 0.88 + 0.20 * noise2(x * 0.7, z * 0.7);\n\
    return color * variation;\n\
    }\n\
    fn biome_id(x: f32, z: f32) -> f32 {\n\
    let h = height(x, z);\n\
    if h > 33.0 { return 4.0; }\n\
    if h > 22.0 { return 3.0; }\n\
    if h < WATER + 0.5 { return 2.0; }\n\
    if noise2(x * 0.013 + 90.0, z * 0.013 - 40.0) > 0.57 { return 1.0; }\n\
    return 0.0;\n\
    }\n\
    fn put(vertex_index: u32, p: vec3<f32>, n: vec3<f32>, color: vec3<f32>, material: f32) {\n\
    if vertex_index < MAX_FACES * 6u {\n\
    vertices[vertex_index].pos = vec4<f32>(p, 1.0);\n\
    vertices[vertex_index].normal = vec4<f32>(n, 0.0);\n\
    vertices[vertex_index].color = vec4<f32>(color, material);\n\
    }\n\
    }\n\
    fn emit_quad(at_face: u32, orientation: u32, p: vec3<f32>, n: vec3<f32>, color: vec3<f32>) {\n\
    let at = at_face * 6u;\n\
    var a = vec3<f32>(0.0);\n\
    var b = vec3<f32>(1.0);\n\
    var c = vec3<f32>(1.0);\n\
    var d = vec3<f32>(0.0);\n\
    if orientation == 0u { a = vec3<f32>(1,0,0); b = vec3<f32>(1,1,0); c = vec3<f32>(1,1,1); d = vec3<f32>(1,0,1); }\n\
    if orientation == 1u { a = vec3<f32>(0,0,1); b = vec3<f32>(0,1,1); c = vec3<f32>(0,1,0); d = vec3<f32>(0,0,0); }\n\
    if orientation == 2u { a = vec3<f32>(0,1,1); b = vec3<f32>(1,1,1); c = vec3<f32>(1,1,0); d = vec3<f32>(0,1,0); }\n\
    if orientation == 3u { a = vec3<f32>(0,0,0); b = vec3<f32>(1,0,0); c = vec3<f32>(1,0,1); d = vec3<f32>(0,0,1); }\n\
    if orientation == 4u { a = vec3<f32>(1,0,1); b = vec3<f32>(1,1,1); c = vec3<f32>(0,1,1); d = vec3<f32>(0,0,1); }\n\
    if orientation == 5u { a = vec3<f32>(0,0,0); b = vec3<f32>(0,1,0); c = vec3<f32>(1,1,0); d = vec3<f32>(1,0,0); }\n\
    let v0 = p + a;\n\
    let v1 = p + b;\n\
    let v2 = p + c;\n\
    let v3 = p + d;\n\
    let material = biome_id(p.x, p.z);\n\
    put(at, v0, n, color, material);\n\
    put(at + 1u, v1, n, color, material);\n\
    put(at + 2u, v2, n, color, material);\n\
    put(at + 3u, v0, n, color, material);\n\
    put(at + 4u, v2, n, color, material);\n\
    put(at + 5u, v3, n, color, material);\n\
    }\n\
    fn water_put(at: u32, p: vec3<f32>, color: vec3<f32>) {\n\
    if at < 6144u {\n\
    water[at].pos = vec4<f32>(p, 1.0);\n\
    water[at].normal = vec4<f32>(0.0, 1.0, 0.0, 0.0);\n\
    water[at].color = vec4<f32>(color, 0.68);\n\
    }\n\
    }\n\
    fn water_quad(p: vec3<f32>, depth: f32) {\n\
    let face = atomicAdd(&meta[1], 1u);\n\
    let at = face * 6u;\n\
    let shallow = vec3<f32>(0.12, 0.48, 0.56);\n\
    let deep = vec3<f32>(0.035, 0.16, 0.28);\n\
    let color = mix(shallow, deep, clamp(depth / 6.0, 0.0, 1.0));\n\
    let a = p + vec3<f32>(0,0,1);\n\
    let b = p + vec3<f32>(1,0,1);\n\
    let c = p + vec3<f32>(1,0,0);\n\
    let d = p;\n\
    water_put(at, a, color); water_put(at + 1u, b, color); water_put(at + 2u, c, color);\n\
    water_put(at + 3u, a, color); water_put(at + 4u, c, color); water_put(at + 5u, d, color);\n\
    }\n\
    @compute @workgroup_size(256)\n\
    fn mesh(@builtin(local_invocation_id) lid: vec3<u32>) {\n\
    let lane = lid.x;\n\
    let base = vec3<i32>(i32(info.chunk.x) * 32, 0, i32(info.chunk.y) * 32);\n\
    var running = 0u;\n\
    for (var tile = 0u; tile < 192u; tile += 1u) {\n\
    let voxel = tile * 256u + lane;\n\
    let x = i32(voxel % N);\n\
    let z = i32((voxel / N) % N);\n\
    let y = i32(voxel / (N * N));\n\
    let count = face_count(x, y, z, base);\n\
    scan[lane] = count;\n\
    workgroupBarrier();\n\
    for (var step = 1u; step < 256u; step *= 2u) {\n\
    var value = scan[lane];\n\
    if lane >= step { value += scan[lane - step]; }\n\
    workgroupBarrier();\n\
    scan[lane] = value;\n\
    workgroupBarrier();\n\
    }\n\
    offsets[voxel] = running + scan[lane] - count;\n\
    let total = scan[255];\n\
    workgroupBarrier();\n\
    running += total;\n\
    workgroupBarrier();\n\
    }\n\
    if lane == 0u {\n\
    atomicStore(&meta[0], min(running * 6u, MAX_FACES * 6u));\n\
    if running > MAX_FACES { atomicStore(&meta[3], 1u); }\n\
    }\n\
    for (var voxel = lane; voxel < N * N * H; voxel += 256u) {\n\
    let x = i32(voxel % N);\n\
    let z = i32((voxel / N) % N);\n\
    let y = i32(voxel / (N * N));\n\
    if !solid(x, y, z, base) { continue; }\n\
    let p = vec3<f32>(f32(base.x + x), f32(y), f32(base.z + z));\n\
    let color = biome(p.x, p.z, p.y, 1.0);\n\
    var face = 0u;\n\
    if !solid(x + 1, y, z, base) { emit_quad(offsets[voxel] + face, 0u, p, vec3<f32>(1,0,0), biome(p.x,p.z,p.y,0.0)); face += 1u; }\n\
    if !solid(x - 1, y, z, base) { emit_quad(offsets[voxel] + face, 1u, p, vec3<f32>(-1,0,0), biome(p.x,p.z,p.y,0.0)); face += 1u; }\n\
    if !solid(x, y + 1, z, base) { emit_quad(offsets[voxel] + face, 2u, p, vec3<f32>(0,1,0), color); face += 1u; }\n\
    if !solid(x, y - 1, z, base) { emit_quad(offsets[voxel] + face, 3u, p, vec3<f32>(0,-1,0), biome(p.x,p.z,p.y,0.0)); face += 1u; }\n\
    if !solid(x, y, z + 1, base) { emit_quad(offsets[voxel] + face, 4u, p, vec3<f32>(0,0,1), biome(p.x,p.z,p.y,0.0)); face += 1u; }\n\
    if !solid(x, y, z - 1, base) { emit_quad(offsets[voxel] + face, 5u, p, vec3<f32>(0,0,-1), biome(p.x,p.z,p.y,0.0)); }\n\
    }\n\
    for (var cell = lane; cell < N * N; cell += 256u) {\n\
    let wx = base.x + i32(cell % N);\n\
    let wz = base.z + i32(cell / N);\n\
    let h = height(f32(wx), f32(wz));\n\
    if h < WATER { water_quad(vec3<f32>(f32(wx), WATER, f32(wz)), WATER - h); }\n\
    }\n\
    for (var candidate = lane; candidate < 256u; candidate += 256u) {\n\
    let wx = base.x + i32(candidate % 16u) * 2;\n\
    let wz = base.z + i32(candidate / 16u) * 2;\n\
    let h = height(f32(wx), f32(wz));\n\
    let slope = abs(height(f32(wx + 1), f32(wz)) - h) + abs(height(f32(wx), f32(wz + 1)) - h);\n\
    let moisture = noise2(f32(wx) * 0.013 + 90.0, f32(wz) * 0.013 - 40.0);\n\
    let random = hash2(wx, wz);\n\
    let forest = moisture > 0.57 && h > WATER + 0.5 && h < 28.0;\n\
    let tree = slope < 2.0 && ((forest && random > 0.60) || (!forest && random > 0.94));\n\
    let grass = slope < 1.5 && h > WATER + 0.5 && h < 25.0 && random > 0.40;\n\
    if tree || grass {\n\
    let at = atomicAdd(&meta[2], 1u);\n\
    if at < 256u {\n\
    let scale = 0.75 + hash2(wx + 13, wz - 7) * 0.85;\n\
    var kind = 2.0;\n\
    if tree { kind = 1.0; }\n\
    if h < WATER + 0.5 && random > 0.96 { kind = 3.0; }\n\
    let green = mix(vec3<f32>(0.16, 0.36, 0.12), vec3<f32>(0.08, 0.24, 0.10), moisture);\n\
    plants[at].pos = vec4<f32>(f32(wx) + 0.5, h, f32(wz) + 0.5, scale);\n\
    plants[at].color = vec4<f32>(green, kind);\n\
    }\n\
    }\n\
    }\n\
    }\n";

pub const RENDER_WGSL: [u8] = "struct Camera {\n\
    eye: vec4<f32>, forward: vec4<f32>, right: vec4<f32>, up: vec4<f32>,\n\
    params: vec4<f32>, sun: vec4<f32>, misc: vec4<f32>, brush: vec4<f32>, brush_params: vec4<f32>,\n\
    }\n\
    struct Vertex { pos: vec4<f32>, normal: vec4<f32>, color: vec4<f32> }\n\
    @group(0) @binding(0) var<uniform> cam: Camera;\n\
    @group(0) @binding(1) var<storage, read> vertices: array<Vertex>;\n\
    @group(0) @binding(2) var<storage, read> meta: array<u32>;\n\
    struct Out {\n\
    @builtin(position) pos: vec4<f32>, @location(0) world: vec3<f32>,\n\
    @location(1) normal: vec3<f32>, @location(2) color: vec3<f32>,\n\
    @location(3) distance: f32, @location(4) bary: vec3<f32>,\n\
    @location(5) uv: vec2<f32>, @location(6) kind: f32,\n\
    }\n\
    fn project(p: vec3<f32>) -> vec4<f32> {\n\
    let relative = p - cam.eye.xyz;\n\
    let depth = dot(relative, cam.forward.xyz);\n\
    if depth <= 0.05 { return vec4<f32>(0.0, 0.0, 2.0, 1.0); }\n\
    let x = dot(relative, cam.right.xyz) / (cam.params.x * cam.params.y);\n\
    let y = dot(relative, cam.up.xyz) / cam.params.x;\n\
    return vec4<f32>(x, y, depth * 1.00010001 - 0.100010001, depth);\n\
    }\n\
    @vertex fn vs(@builtin(vertex_index) id: u32) -> Out {\n\
    var out: Out;\n\
    if id >= meta[0] {\n\
    out.pos = vec4<f32>(0.0, 0.0, 2.0, 1.0);\n\
    out.world = vec3<f32>(0.0); out.normal = vec3<f32>(0,1,0);\n\
    out.color = vec3<f32>(0.0); out.distance = 0.0; out.bary = vec3<f32>(0.0);\n\
    out.uv = vec2<f32>(0.0); out.kind = 0.0;\n\
    return out;\n\
    }\n\
    let v = vertices[id];\n\
    out.pos = project(v.pos.xyz);\n\
    out.world = v.pos.xyz;\n\
    out.normal = v.normal.xyz;\n\
    out.color = v.color.xyz;\n\
    out.distance = length(v.pos.xyz - cam.eye.xyz);\n\
    if id % 3u == 0u { out.bary = vec3<f32>(1,0,0); }\n\
    else if id % 3u == 1u { out.bary = vec3<f32>(0,1,0); }\n\
    else { out.bary = vec3<f32>(0,0,1); }\n\
    out.uv = vec2<f32>(0.0); out.kind = v.color.w;\n\
    return out;\n\
    }\n\
    @fragment fn fs(v: Out) -> @location(0) vec4<f32> {\n\
    let n = normalize(v.normal);\n\
    let sun = normalize(cam.sun.xyz);\n\
    let diffuse = max(0.0, dot(n, sun));\n\
    let sky = 0.38 + 0.22 * max(0.0, n.y);\n\
    let ao = 0.72 + 0.28 * max(0.0, n.y);\n\
    var color = v.color * (sky + diffuse * cam.sun.w) * ao;\n\
    let detail = 0.94 + 0.06 * sin(v.world.x * 12.3 + v.world.z * 9.7 + v.world.y * 4.1);\n\
    color *= detail;\n\
    if cam.misc.z > 0.5 && abs(length(v.world - cam.brush.xyz) - cam.brush_params.x) < 0.45 {\n\
    color = mix(color, vec3<f32>(1.0,0.25,0.75), 0.72);\n\
    }\n\
    if cam.params.w > 0.5 && cam.params.w < 1.5 {\n\
    let cell = abs(fract(v.world.xz / 32.0) - vec2<f32>(0.5));\n\
    if max(cell.x, cell.y) > 0.485 { color = vec3<f32>(0.1, 0.8, 1.0); }\n\
    }\n\
    if cam.params.w > 1.5 && cam.params.w < 2.5 { color = n * 0.5 + vec3<f32>(0.5); }\n\
    if cam.params.w > 2.5 && cam.params.w < 3.5 {\n\
    let palettes = array<vec3<f32>, 5>(vec3<f32>(0.2,0.8,0.2), vec3<f32>(0.0,0.5,0.1),\n\
    vec3<f32>(0.9,0.75,0.3), vec3<f32>(0.5,0.5,0.55), vec3<f32>(0.9,0.95,1.0));\n\
    color = palettes[u32(v.kind + 0.5)];\n\
    }\n\
    if cam.params.w > 3.5 && cam.params.w < 4.5 { color = vec3<f32>(v.world.y / 48.0, 0.4, 1.0 - v.world.y / 48.0); }\n\
    if cam.params.w > 4.5 {\n\
    let edge = min(v.bary.x, min(v.bary.y, v.bary.z));\n\
    if edge < 0.035 { color = vec3<f32>(0.03, 0.05, 0.07); }\n\
    }\n\
    let fog = 1.0 - exp(-v.distance * v.distance * 0.000035);\n\
    let fog_color = vec3<f32>(0.48, 0.65, 0.82);\n\
    return vec4<f32>(mix(color, fog_color, clamp(fog, 0.0, 0.94)), 1.0);\n\
    }\n\
    @vertex fn vs_water(@builtin(vertex_index) id: u32) -> Out {\n\
    var out: Out;\n\
    if id >= meta[1] { out.pos = vec4<f32>(0.0,0.0,2.0,1.0); return out; }\n\
    let v = vertices[id];\n\
    var p = v.pos.xyz;\n\
    p.y += sin(p.x * 0.55 + cam.params.z * 1.7) * 0.045\n\
    + sin(p.z * 0.72 - cam.params.z * 1.2) * 0.035;\n\
    out.pos = project(p);\n\
    out.world = p; out.normal = vec3<f32>(0,1,0); out.color = v.color.xyz;\n\
    out.distance = length(p - cam.eye.xyz); out.bary = vec3<f32>(0.0);\n\
    out.uv = vec2<f32>(0.0); out.kind = 0.0;\n\
    return out;\n\
    }\n\
    @fragment fn fs_water(v: Out) -> @location(0) vec4<f32> {\n\
    let ripple = sin(v.world.x * 1.4 + cam.params.z * 2.0) * sin(v.world.z * 1.1 - cam.params.z);\n\
    let view = normalize(cam.eye.xyz - v.world);\n\
    let fresnel = pow(1.0 - max(0.0, view.y), 3.0);\n\
    let sky = vec3<f32>(0.42, 0.65, 0.82);\n\
    var color = mix(v.color, sky, 0.18 + fresnel * 0.55);\n\
    color += vec3<f32>(0.12, 0.16, 0.18) * max(0.0, ripple) * 0.35;\n\
    let fog = 1.0 - exp(-v.distance * v.distance * 0.000035);\n\
    color = mix(color, vec3<f32>(0.48,0.65,0.82), clamp(fog,0.0,0.94));\n\
    return vec4<f32>(color, 0.66);\n\
    }\n\
    @vertex fn vs_plant(@builtin(vertex_index) id: u32,\n\
    @builtin(instance_index) instance: u32) -> Out {\n\
    var out: Out;\n\
    if instance >= meta[2] { out.pos = vec4<f32>(0.0,0.0,2.0,1.0); return out; }\n\
    let plant = vertices[instance];\n\
    let lod_distance = length(plant.pos.xyz - cam.eye.xyz);\n\
    if (lod_distance > 150.0 && instance % 2u == 1u) || lod_distance > 230.0 {\n\
    out.pos = vec4<f32>(0.0,0.0,2.0,1.0); return out;\n\
    }\n\
    let kind = plant.color.w;\n\
    var corner = id % 6u;\n\
    if corner == 3u { corner = 0u; }\n\
    if corner == 4u { corner = 2u; }\n\
    if corner == 5u { corner = 3u; }\n\
    let ux = f32(corner == 1u || corner == 2u);\n\
    let uy = f32(corner >= 2u);\n\
    var size = vec2<f32>(0.45, 1.0) * plant.pos.w;\n\
    if kind < 1.5 { size = vec2<f32>(2.8, 5.2) * plant.pos.w; }\n\
    if kind > 2.5 { size = vec2<f32>(0.8, 2.6) * plant.pos.w; }\n\
    var p = plant.pos.xyz;\n\
    let side = (ux - 0.5) * size.x;\n\
    if id < 6u { p.x += side; } else { p.z += side; }\n\
    p.y += uy * size.y;\n\
    p.x += sin(cam.params.z * 1.5 + plant.pos.x * 0.3 + plant.pos.z * 0.2) * uy * uy * 0.16;\n\
    out.pos = project(p);\n\
    out.world = p; out.color = plant.color.xyz; out.kind = kind;\n\
    out.normal = normalize(vec3<f32>(0.3,0.8,0.2)); out.distance = length(p - cam.eye.xyz);\n\
    out.bary = vec3<f32>(0.0); out.uv = vec2<f32>(ux, uy);\n\
    return out;\n\
    }\n\
    @fragment fn fs_plant(v: Out) -> @location(0) vec4<f32> {\n\
    var color = v.color;\n\
    if v.kind < 1.5 {\n\
    let trunk = abs(v.uv.x - 0.5) < 0.065 && v.uv.y < 0.62;\n\
    let canopy_width = (1.0 - v.uv.y) * 0.52 + 0.08;\n\
    let canopy = v.uv.y > 0.28 && abs(v.uv.x - 0.5) < canopy_width;\n\
    if !trunk && !canopy { discard; }\n\
    if trunk { color = vec3<f32>(0.24,0.13,0.065); }\n\
    else { color *= 0.72 + v.uv.y * 0.55; }\n\
    } else if v.kind < 2.5 {\n\
    let blade = abs(v.uv.x - 0.5 + sin(v.uv.y * 4.0) * 0.08) < 0.11 * (1.0 - v.uv.y * 0.6);\n\
    if !blade { discard; }\n\
    color *= 0.8 + v.uv.y * 0.4;\n\
    } else {\n\
    if abs(v.uv.x - 0.5) > 0.16 { discard; }\n\
    color = vec3<f32>(0.20,0.42,0.22);\n\
    }\n\
    let light = 0.55 + 0.45 * max(0.0, dot(normalize(v.normal), normalize(cam.sun.xyz)));\n\
    color *= light;\n\
    let fog = 1.0 - exp(-v.distance * v.distance * 0.000035);\n\
    return vec4<f32>(mix(color, vec3<f32>(0.48,0.65,0.82), clamp(fog,0.0,0.94)), 1.0);\n\
    }\n";
