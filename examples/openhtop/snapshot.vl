// One snapshot, and the difference between two.

use crate::linux::linux_snapshot;
use crate::macos::macos_snapshot;
use crate::model::{Snapshot, empty_snapshot, min_float};
use crate::platform::linux_here;

// ---- From two snapshots to percentages ----

// CPU time is compared process by process (by pid) and the totals from
// /proc/stat line by line; a process new since the last snapshot shows 0
// until the next one.
fn compute_usage_rates(prev: Snapshot, cur: inout Snapshot) {
    let elapsed = cur.wall_us - prev.wall_us;
    for i in 0..cur.procs.len {
        let pid = cur.procs[i].pid;
        var old_us = 0;
        var found = false;
        for p in prev.procs.iter() {
            if p.pid == pid {
                old_us = p.cpu_us;
                found = true;
                break;
            }
        }
        if found && elapsed > 0 {
            let d = cur.procs[i].cpu_us - old_us;
            if d > 0 {
                cur.procs[i].cpu_pct = d as f64 * 100.0 / elapsed as f64;
            }
        }
        if cur.mem_total_kb > 0 {
            cur.procs[i].mem_pct = cur.procs[i].rss_kb as f64 * 100.0
                / cur.mem_total_kb as f64;
        }
        if cur.procs[i].state == 'R' {
            cur.n_running += 1;
        }
        cur.n_threads += cur.procs[i].threads;
    }

    if prev.ticks_total > 0 && cur.ticks_total > prev.ticks_total {
        let dt = cur.ticks_total - prev.ticks_total;
        let di = cur.ticks_idle - prev.ticks_idle;
        let busy = if di < dt { dt - di } else { 0 };
        cur.cpu_pct = busy as f64 * 100.0 / dt as f64;
    }
    for i in 0..cur.core_total.len {
        var pct = 0.0;
        if i < prev.core_total.len && cur.core_total[i] > prev.core_total[i] {
            let dt = cur.core_total[i] - prev.core_total[i];
            let di = cur.core_idle[i] - prev.core_idle[i];
            let busy = if di < dt { dt - di } else { 0 };
            pct = busy as f64 * 100.0 / dt as f64;
        }
        cur.core_pct.push(pct);
    }

    // No /proc/stat (macOS): the processes' shares over the cores.
    if cur.ticks_total == 0 && cur.cpus > 0 {
        var sum = 0.0;
        for p in cur.procs.iter() {
            sum += p.cpu_pct;
        }
        cur.cpu_pct = min_float(sum / cur.cpus as f64, 100.0);
    }
}

pub fn read_snapshot(prev: Snapshot, gpa: Gpa) -> Snapshot {
    var snap = empty_snapshot(gpa);
    if linux_here() {
        snap = linux_snapshot(gpa);
    } else {
        snap = macos_snapshot(gpa);
    }
    compute_usage_rates(prev, &snap);
    snap
}
