// Byte and text helpers for the lines the backends read.

// ---- Small helpers ----

pub fn find_byte(s: &[u8], b: u8) -> i64 {
    for i in 0..s.len() {
        if s[i] == b {
            return i as i64;
        }
    }
    -1
}

pub fn rfind_byte(s: &[u8], b: u8) -> i64 {
    let mut i = s.len();
    while i > 0 {
        i -= 1;
        if s[i] == b {
            return i as i64;
        }
    }
    -1
}

pub fn starts_with(s: &[u8], p: &[u8]) -> bool {
    if p.len() > s.len() {
        return false;
    }
    for i in 0..p.len() {
        if s[i] != p[i] {
            return false;
        }
    }
    true
}

// The index of needle in hay, -1 when it is not there.
pub fn find_sub(hay: &[u8], needle: &[u8]) -> i64 {
    if needle.len() == 0 || needle.len() > hay.len() {
        return -1;
    }
    for start in 0..hay.len() - needle.len() + 1 {
        let mut same = true;
        for j in 0..needle.len() {
            if hay[start + j] != needle[j] {
                same = false;
                break;
            }
        }
        if same {
            return start as i64;
        }
    }
    -1
}

// Whether needle is in hay, ASCII case folded.
pub fn contains_text(hay: &[u8], needle: &[u8]) -> bool {
    if needle.len() == 0 {
        return true;
    }
    if needle.len() > hay.len() {
        return false;
    }
    for start in 0..hay.len() - needle.len() + 1 {
        let mut same = true;
        for j in 0..needle.len() {
            if lower(hay[start + j]) != lower(needle[j]) {
                same = false;
                break;
            }
        }
        if same {
            return true;
        }
    }
    false
}

fn lower(b: u8) -> u8 {
    if b >= b'A' && b <= b'Z' { b + 32 } else { b }
}

// s cut to at most n bytes, never in the middle of a UTF-8 character.
pub fn cut_text(s: &[u8], n: i64) -> &[u8] {
    if s.len() as i64 <= n {
        return s;
    }
    let mut k = n;
    while k > 0 && s[k as usize] >= 0x80 && s[k as usize] < 0xc0 {
        k -= 1;
    }
    &s[..k as usize]
}

// The first token of s, without leading spaces or tabs.
pub fn first_token(s: &[u8]) -> &[u8] {
    let mut i: i64 = 0;
    while i < s.len() as i64 && (s[i as usize] == b' ' || s[i as usize] == b'\t') {
        i += 1;
    }
    let mut j = i;
    while j < s.len() as i64 && s[j as usize] != b' ' && s[j as usize] != b'\t' {
        j += 1;
    }
    &s[i as usize..j as usize]
}

// A space, a tab or a line end.
fn blank(b: u8) -> bool {
    b == b' ' || (b >= 9 && b <= 13)
}

// s without the blanks at its ends.
pub fn trim(s: &[u8]) -> &[u8] {
    let mut from: usize = 0;
    let mut to = s.len();
    while from < to && blank(s[from]) {
        from += 1;
    }
    while to > from && blank(s[to - 1]) {
        to -= 1;
    }
    &s[from..to]
}

// s cut at every `sep`.
pub fn split<'a>(s: &'a [u8], sep: u8, gpa: Gpa) -> Vec<&'a [u8], Gpa> {
    let mut parts: Vec<&'a [u8], Gpa> = Vec::new_in(gpa);
    let mut from: usize = 0;
    for i in 0..s.len() {
        if s[i] == sep {
            parts.push(&s[from..i]);
            from = i + 1;
        }
    }
    parts.push(&s[from..]);
    parts
}

// The fields of s: what stands between its runs of blanks.
pub fn fields<'a>(s: &'a [u8], gpa: Gpa) -> Vec<&'a [u8], Gpa> {
    let mut parts: Vec<&'a [u8], Gpa> = Vec::new_in(gpa);
    let mut i: usize = 0;
    while i < s.len() {
        while i < s.len() && blank(s[i]) {
            i += 1;
        }
        let from = i;
        while i < s.len() && !blank(s[i]) {
            i += 1;
        }
        if i > from {
            parts.push(&s[from..i]);
        }
    }
    parts
}

// The decimal integer s is, or None.
pub fn parse_int(s: &[u8]) -> Option<i64> {
    match str::from_utf8(s) {
        Ok(text) => text.parse::<i64>().ok(),
        Err(_) => None,
    }
}

// The decimal number s is, or None.
pub fn parse_f64(s: &[u8]) -> Option<f64> {
    match str::from_utf8(s) {
        Ok(text) => text.parse::<f64>().ok(),
        Err(_) => None,
    }
}
