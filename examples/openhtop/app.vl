// EDITION: rust
// Running: one frame for --once, or the interactive loop.

use std::thread;
use std::sys::{SYS_SIGTERM, SysTermios, sys_kill, sys_make_raw, sys_tcgetattr, sys_tcsetattr};
use std::time::Duration;

use crate::demo::demo_snapshot;
use crate::model::{
    FILTER_MAX, Flags, Key, Snapshot, State, clamp_offset, empty_snapshot, initial_state,
    move_selection, now_micros, select_edge, sort_processes,
};
use crate::platform::{key_pressed, read_key, terminal_size, write_bytes};
use crate::snapshot::read_snapshot;
use crate::ui::{process_rows, render};

fn handle_key(state: &mut State, key: Key, snap: &Snapshot<Gpa>, rows: i64, gpa: Gpa) {
    if state.mode == 3 {
        if key_pressed(key) {
            state.mode = 0;
        }
        return;
    }
    if state.mode == 1 {
        match key {
            Key::Escape => state.mode = 0,
            Key::Char(b'\n') | Key::Char(b'\r') => state.mode = 0,
            Key::Char(8) | Key::Char(127) => if state.filter_len > 0 { state.filter_len -= 1 },
            Key::Char(c) => if c >= 32 && c < 127 && state.filter_len < FILTER_MAX {
                state.filter[state.filter_len as usize] = c;
                state.filter_len += 1;
            },
            _ => {}
        }
        return;
    }
    if state.mode == 2 {
        match key {
            Key::Char(b'y') | Key::Char(b'Y') => {
                let pid = state.selected;
                match sys_kill(pid, SYS_SIGTERM) {
                    Ok(()) => {
                        let msg = format_in("sent SIGTERM to {pid}", gpa);
                        state.set_message(msg.as_bytes());
                    }
                    Err(_) => state.set_message(b"kill failed"),
                }
                state.mode = 0;
            }
            Key::Char(b'n') | Key::Char(b'N') | Key::Escape => {
                state.mode = 0;
                state.set_message(b"kill cancelled");
            }
            _ => {}
        }
        return;
    }
    match key {
        Key::Char(b'q') | Key::Char(3) | Key::Escape | Key::Function(10) => state.quit = true,
        Key::Char(b'j') | Key::Down => move_selection(state, snap, 1, gpa),
        Key::Char(b'k') | Key::Up => move_selection(state, snap, -1, gpa),
        Key::PageDown => move_selection(state, snap, rows, gpa),
        Key::PageUp => move_selection(state, snap, -rows, gpa),
        Key::Home => select_edge(state, snap, false, gpa),
        Key::End => select_edge(state, snap, true, gpa),
        Key::Char(b's') | Key::Function(3) => {
            state.sort = (state.sort + 1) % 5;
            state.offset = 0;
        }
        Key::Char(b'r') | Key::Function(4) => state.reverse = !state.reverse,
        Key::Char(b'/') | Key::Function(2) => state.mode = 1,
        Key::Char(b'x') | Key::Function(9) => if state.selected != 0 { state.mode = 2 },
        Key::Char(b'p') | Key::Function(5) => state.paused = !state.paused,
        Key::Char(b'?') | Key::Function(1) => state.mode = 3,
        _ => {}
    }
}

// ---- Modes of running ----

fn render_once_frame(flags: Flags, gpa: Gpa) -> (Vec<u8, Gpa>, i64, i64) {
    let w: i64 = if flags.width > 0 { flags.width } else { 100 };
    let h: i64 = if flags.height > 0 { flags.height } else { 24 };
    let mut st = initial_state(flags);
    st.width = w;
    st.height = h;
    let mut snap = empty_snapshot(gpa);
    if flags.demo {
        snap = demo_snapshot(gpa);
    } else {
        // Two samples 150 ms apart: the first alone has no interval to
        // measure a process's CPU time over.
        snap = read_snapshot(&empty_snapshot(gpa), gpa);
        thread::sleep(Duration::from_millis(150));
        snap = read_snapshot(&snap, gpa);
    }
    sort_processes(&mut snap, st);
    clamp_offset(&mut st, &snap, process_rows(&snap, w, h), gpa);
    (render(&snap, st, w, h, gpa), w, h)
}

// The frame with the blanks that pad each line to the width removed: what
// --once writes, where there is nothing to erase (and tests can read).
fn trim_line_padding(frame: &Vec<u8, Gpa>, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut out = Vec::<u8, Gpa>::with_capacity_in(frame.len(), gpa);
    let bytes = frame.as_slice();
    let mut start: i64 = 0;
    for i in 0..bytes.len() {
        if bytes[i] == b'\n' {
            let mut end = i;
            while end as i64 > start && (bytes[end - 1] == b' ' || bytes[end - 1] == b'\r') {
                end -= 1;
            }
            out.extend_from_slice(&bytes[start as usize..end]);
            out.push(b'\n');
            start = i as i64 + 1;
        }
    }
    if start < bytes.len() as i64 {
        out.extend_from_slice(&bytes[start as usize..]);
    }
    out
}

pub fn run_once(flags: Flags, gpa: Gpa) -> i32 {
    let (frame, _, _) = render_once_frame(flags, gpa);
    write_bytes(1, trim_line_padding(&frame, gpa).as_slice());
    0
}

// The terminal as run_tui found it: the guard's Drop shows the cursor,
// leaves the alternate screen and restores the settings, on every way out
// of run_tui (the loop's return, an early one).
struct Restore { saved: SysTermios }

impl Drop for Restore {
    fn drop(&mut self) {
        write_bytes(1, b"\x1b[?25h\x1b[?1049l");
        sys_tcsetattr(0, self.saved);
    }
}

pub fn run_tui(flags: Flags, gpa: Gpa) -> i32 {
    let saved = match sys_tcgetattr(0) {
        Ok(t) => t,
        Err(_) => return run_once(flags, gpa),
    };
    let mut raw = saved;
    sys_make_raw(&mut raw);
    if sys_tcsetattr(0, raw).is_err() {
        return run_once(flags, gpa);
    }
    write_bytes(1, b"\x1b[?1049h\x1b[?25l");
    let _restore = Restore { saved };
    tui_loop(flags, gpa)
}

fn tui_loop(flags: Flags, gpa: Gpa) -> i32 {
    let mut state = initial_state(flags);
    // Two samples before the first frame, as in --once, so CPU% has an
    // interval to measure over from the start.
    let mut snap = if flags.demo {
        demo_snapshot(gpa)
    } else {
        let a = read_snapshot(&empty_snapshot(gpa), gpa);
        thread::sleep(Duration::from_millis(150));
        read_snapshot(&a, gpa)
    };
    let mut first = true;
    let mut next_us = now_micros() + state.interval_ms * 1000;
    sort_processes(&mut snap, state);
    loop {
        let now = now_micros();
        let mut timeout: i64 = 500;
        if !state.paused {
            let wait = next_us - now;
            timeout = if wait <= 0 { 0 } else if wait > 500000 { 500 }
                else { (wait / 1000) as i32 as i64 };
        }
        let key = read_key(timeout as i32);
        let (w, h) = terminal_size(state);
        state.width = w;
        state.height = h;
        let rows = process_rows(&snap, w, h);
        if key_pressed(key) {
            handle_key(&mut state, key, &snap, rows, gpa);
        }
        if state.quit {
            return 0;
        }
        let mut refreshed = false;
        if !state.paused && now_micros() >= next_us {
            if !flags.demo {
                let next = read_snapshot(&snap, gpa);
                snap = next;
            }
            sort_processes(&mut snap, state);
            next_us = now_micros() + state.interval_ms * 1000;
            refreshed = true;
        }
        clamp_offset(&mut state, &snap, rows, gpa);
        if refreshed || key_pressed(key) || first {
            let frame = render(&snap, state, w, h, gpa);
            let bytes = frame.as_slice();
            write_bytes(1, b"\x1b[H");
            // The last line's '\n' would scroll a full screen by one row;
            // its '\r' is enough to park the cursor at the left.
            if bytes.len() > 0 {
                write_bytes(1, &bytes[..bytes.len() - 1]);
            }
            write_bytes(1, b"\x1b[J");
            first = false;
        }
    }
}
