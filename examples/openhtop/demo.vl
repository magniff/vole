// EDITION: rust
// A fixed snapshot, for --demo and the test.

use crate::model::{Proc, Snapshot, empty_snapshot};

// ---- A fixed snapshot, for --demo and the test ----

fn demo_proc(snap: &mut Snapshot<Gpa>, pid: i32, user: &[u8], name: &[u8], state: u8, cpu: f64,
    rss_kb: i64, virt_kb: i64, shr_kb: i64, cpu_us: i64) {
    let mut p = Proc::empty();
    p.pid = pid;
    p.ppid = 1;
    p.state = state;
    p.pri = 31;
    p.ni = 0;
    p.threads = 1;
    p.rss_kb = rss_kb;
    p.virt_kb = virt_kb;
    p.shr_kb = shr_kb;
    p.cpu_us = cpu_us;
    p.cpu_pct = cpu;
    p.mem_pct = rss_kb as f64 * 100.0 / snap.mem_total_kb as f64;
    p.set_user(user);
    p.set_name(name);
    snap.procs.push(p);
}

pub fn demo_snapshot(gpa: Gpa) -> Snapshot<Gpa> {
    let mut snap = empty_snapshot(gpa);
    snap.cpus = 8;
    snap.cpu_pct = 37.4;
    snap.core_pct.push(12.0);
    snap.core_pct.push(48.0);
    snap.core_pct.push(3.0);
    snap.core_pct.push(91.0);
    snap.core_pct.push(22.0);
    snap.core_pct.push(0.0);
    snap.core_pct.push(64.0);
    snap.core_pct.push(57.0);
    snap.mem_total_kb = 16 * 1024 * 1024;
    snap.mem_used_kb = 6 * 1024 * 1024 + 512 * 1024;
    snap.swap_total_kb = 2 * 1024 * 1024;
    snap.swap_used_kb = 320 * 1024;
    snap.load = [1.24, 0.98, 0.76];
    snap.uptime_s = 12345.0;
    snap.wall_us = 1000000;
    snap.n_running = 2;
    snap.n_threads = 24;
    demo_proc(&mut snap, 1, b"root", b"launchd", b'S', 1.5, 18400, 4352000, 12000, 698694);
    demo_proc(&mut snap, 322, b"root", b"logd", b'S', 2.1, 8224, 435200, 3200, 952633);
    demo_proc(&mut snap, 704, b"ada", b"postgres: writer", b'S', 72.4, 831488, 2048000, 65536,
        48612345);
    demo_proc(&mut snap, 1812, b"ada", b"volec test", b'R', 180.0, 1468006, 3145728, 98304,
        120345678);
    demo_proc(&mut snap, 2400, b"ada", b"openhtop", b'R', 12.0, 9216, 262144, 4096, 3045678);
    demo_proc(&mut snap, 2600, b"ada", b"cargo build", b'S', 31.2, 524288, 1572864, 24576,
        54321098);
    demo_proc(&mut snap, 3001, b"root", b"sshd: ada", b'S', 0.0, 7400, 131072, 2048, 123456);
    snap
}
