// The macOS backend: one snapshot from ps, vm_stat and sysctl.

use std::time::{SystemTime, UNIX_EPOCH};

use crate::model::{Proc, Snapshot, empty_snapshot, max, min, now_micros};
use crate::platform::{read_load_average, read_macos_core_ticks, run_command, run_int_command};
use crate::text::{fields, find_sub, parse_f64, parse_int, split, starts_with, trim};

// ---- macOS: ps, vm_stat, sysctl ----

// `ps` prints [dd-]hh:mm:ss.cc of CPU time; the fraction is centiseconds.
fn parse_ps_time(s: &[u8]) -> i64 {
    let mut nums: [i64; 4] = [0, 0, 0, 0];
    let mut count: i64 = 0;
    let mut cur: i64 = 0;
    let mut frac: i64 = 0;
    let mut scale: i64 = 100000;
    let mut in_frac = false;
    let mut has_days = false;
    for i in 0..s.len() {
        let b = s[i];
        if b >= b'0' && b <= b'9' {
            if in_frac {
                frac += (b - b'0') as i64 * scale;
                scale /= 10;
            } else {
                cur = cur * 10 + (b - b'0') as i64;
            }
        } else if b == b'.' {
            in_frac = true;
        } else if b == b':' || b == b'-' {
            if b == b'-' {
                has_days = true;
            }
            nums[count as usize] = cur;
            count += 1;
            cur = 0;
            in_frac = false;
        }
    }
    nums[count as usize] = cur;
    count += 1;
    let mut total: i64 = 0;
    if has_days {
        total = nums[0] * 86400;
        if count >= 4 {
            total += nums[1] * 3600 + nums[2] * 60 + nums[3];
        } else if count == 3 {
            total += nums[1] * 60 + nums[2];
        }
    } else if count >= 3 {
        total = nums[0] * 3600 + nums[1] * 60 + nums[2];
    } else if count == 2 {
        total = nums[0] * 60 + nums[1];
    } else {
        total = nums[0];
    }
    total * 1000000 + frac
}

// The byte where the n-th (0-based) whitespace-separated field starts.
fn field_offset(line: &[u8], n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut seen: i64 = 0;
    while seen < n {
        while i < line.len() as i64 && (line[i as usize] == b' ' || line[i as usize] == b'\t') {
            i += 1;
        }
        while i < line.len() as i64 && line[i as usize] != b' ' && line[i as usize] != b'\t' {
            i += 1;
        }
        seen += 1;
    }
    while i < line.len() as i64 && (line[i as usize] == b' ' || line[i as usize] == b'\t') {
        i += 1;
    }
    i
}

pub fn macos_snapshot(gpa: Gpa) -> Snapshot<Gpa> {
    let mut snap = empty_snapshot(gpa);
    snap.wall_us = now_micros();
    let out = match run_command(
        "ps",
        &["-axo", "pid=,ppid=,uid=,user=,state=,time=,rss=,pri=,ni=,command="],
        gpa,
    ) {
        Some(b) => b,
        None => return snap,
    };
    let lines = split(out.as_slice(), b'\n', gpa);
    for line in lines {
        if line.len() == 0 {
            continue;
        }
        let f = fields(line, gpa);
        if f.len() < 10 {
            continue;
        }
        let mut p = Proc::empty();
        p.pid = parse_int(f[0]).unwrap_or(0) as i32;
        if p.pid == 0 {
            continue;
        }
        p.ppid = parse_int(f[1]).unwrap_or(0) as i32;
        p.uid = parse_int(f[2]).unwrap_or(0);
        p.set_user(f[3]);
        p.state = if f[4].len() > 0 { f[4][0] } else { b'?' };
        p.cpu_us = parse_ps_time(f[5]);
        p.rss_kb = parse_int(f[6]).unwrap_or(0);
        p.pri = parse_int(f[7]).unwrap_or(0);
        p.ni = parse_int(f[8]).unwrap_or(0);
        // ps's vsz is the same reservation for every process on macOS, so
        // it says nothing about this one (htop shows VIRT 0 there too).
        p.virt_kb = 0;
        p.threads = 0;
        p.set_name(trim(&line[field_offset(line, 9) as usize..]));
        snap.procs.push(p);
    }
    snap.cpus = read_macos_core_ticks(&mut snap.core_total, &mut snap.core_idle);
    if snap.cpus == 0 {
        snap.cpus = max(run_int_command("sysctl", &["-n", "hw.ncpu"], 1, gpa), 1);
    }
    snap.mem_total_kb = run_int_command("sysctl", &["-n", "hw.memsize"], 0, gpa) / 1024;
    let page_kb = max(run_int_command("sysctl", &["-n", "hw.pagesize"], 4096, gpa) / 1024, 1);
    read_macos_memory(&mut snap, page_kb, gpa);
    read_macos_swap(&mut snap, gpa);
    read_macos_uptime(&mut snap, gpa);
    read_load_average(&mut snap);
    snap
}

// vm_stat's page counts: active, wired and compressed pages are what is in
// use.
fn read_macos_memory(snap: &mut Snapshot<Gpa>, page_kb: i64, gpa: Gpa) {
    let out = match run_command("vm_stat", &[], gpa) {
        Some(b) => b,
        None => return,
    };
    let active = vm_stat_pages(out.as_slice(), b"Pages active:", gpa);
    let wired = vm_stat_pages(out.as_slice(), b"Pages wired down:", gpa);
    let compressed = vm_stat_pages(out.as_slice(), b"Pages occupied by compressor:", gpa);
    snap.mem_used_kb = min((active + wired + compressed) * page_kb, snap.mem_total_kb);
}

fn vm_stat_pages(text: &[u8], key: &[u8], gpa: Gpa) -> i64 {
    let lines = split(text, b'\n', gpa);
    for line in lines {
        if starts_with(line, key) {
            let rest = trim(&line[key.len()..]);
            let mut i: i64 = 0;
            let mut v: i64 = 0;
            while i < rest.len() as i64 && rest[i as usize] >= b'0' && rest[i as usize] <= b'9' {
                v = v * 10 + (rest[i as usize] - b'0') as i64;
                i += 1;
            }
            return v;
        }
    }
    0
}

// sysctl -n vm.swapusage: "total = 2048.00M  used = 1013.44M  free = ...".
fn read_macos_swap(snap: &mut Snapshot<Gpa>, gpa: Gpa) {
    let out = match run_command("sysctl", &["-n", "vm.swapusage"], gpa) {
        Some(b) => b,
        None => return,
    };
    snap.swap_total_kb = size_after_label(out.as_slice(), b"total = ", gpa);
    snap.swap_used_kb = size_after_label(out.as_slice(), b"used = ", gpa);
}

fn size_after_label(text: &[u8], key: &[u8], gpa: Gpa) -> i64 {
    let at = find_sub(text, key);
    if at < 0 {
        return 0;
    }
    let rest = &text[(at + key.len() as i64) as usize..];
    let mut n: i64 = 0;
    while n < rest.len() as i64 && rest[n as usize] != b' ' && rest[n as usize] != b')' {
        n += 1;
    }
    parse_size_kilobytes(&rest[..n as usize])
}

// A size with a unit, as vm.swapusage prints it: "123K", "1.50M", "0B".
fn parse_size_kilobytes(tok: &[u8]) -> i64 {
    if tok.len() == 0 {
        return 0;
    }
    let last = tok[tok.len() - 1];
    let mut mult = 1.0;
    let mut num = tok;
    if last == b'K' {
        num = &tok[..tok.len() - 1];
    } else if last == b'M' {
        mult = 1024.0;
        num = &tok[..tok.len() - 1];
    } else if last == b'G' {
        mult = 1024.0 * 1024.0;
        num = &tok[..tok.len() - 1];
    } else if last == b'B' {
        num = &tok[..tok.len() - 1];
    }
    match parse_f64(num) {
        Some(v) => (v * mult) as i64,
        None => 0,
    }
}

// kern.boottime: "{ sec = 1792745384, usec = ... } ...", and the uptime is
// now minus that.
fn read_macos_uptime(snap: &mut Snapshot<Gpa>, gpa: Gpa) {
    let out = match run_command("sysctl", &["-n", "kern.boottime"], gpa) {
        Some(b) => b,
        None => return,
    };
    let at = find_sub(out.as_slice(), b"sec = ");
    if at < 0 {
        return;
    }
    let rest = &out.as_slice()[(at + 6) as usize..];
    let mut n: i64 = 0;
    while n < rest.len() as i64 && rest[n as usize] >= b'0' && rest[n as usize] <= b'9' {
        n += 1;
    }
    let boot = parse_int(&rest[..n as usize]).unwrap_or(0);
    let now = match SystemTime::now().duration_since(UNIX_EPOCH) {
        Ok(since) => since.as_secs() as i64,
        Err(_) => 0,
    };
    if now > boot {
        snap.uptime_s = (now - boot) as f64;
    }
}
