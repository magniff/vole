// The macOS backend: one snapshot from ps, vm_stat and sysctl.

use std::{parse_int, time};
use std::num::parse_f64;
use std::sys::SYS_CLOCK_REALTIME;

use crate::model::{Proc, Snapshot, empty_snapshot, max, min, now_micros};
use crate::platform::{read_load_average, read_macos_core_ticks, run_command, run_int_command};
use crate::text::{find_sub, starts_with};

// ---- macOS: ps, vm_stat, sysctl ----

// `ps` prints [dd-]hh:mm:ss.cc of CPU time; the fraction is centiseconds.
fn parse_ps_time(s: [u8]) -> i64 {
    var nums: [i64; 4] = [0, 0, 0, 0];
    var count = 0;
    var cur = 0;
    var frac = 0;
    var scale = 100000;
    var in_frac = false;
    var has_days = false;
    for i in 0..s.len {
        let b = s[i];
        if b >= '0' && b <= '9' {
            if in_frac {
                frac += (b - '0') as i64 * scale;
                scale /= 10;
            } else {
                cur = cur * 10 + (b - '0') as i64;
            }
        } else if b == '.' {
            in_frac = true;
        } else if b == ':' || b == '-' {
            if b == '-' {
                has_days = true;
            }
            nums[count] = cur;
            count += 1;
            cur = 0;
            in_frac = false;
        }
    }
    nums[count] = cur;
    count += 1;
    var total = 0;
    if has_days {
        total = nums[0] * 86400;
        if count >= 4 {
            total += nums[1] * 3600 + nums[2] * 60 + nums[3];
        } else if count == 3 {
            total += nums[1] * 60 + nums[2];
        }
    } else if count >= 3 {
        total = nums[0] * 3600 + nums[1] * 60 + nums[2];
    } else if count == 2 {
        total = nums[0] * 60 + nums[1];
    } else {
        total = nums[0];
    }
    total * 1000000 + frac
}

// The byte where the n-th (0-based) whitespace-separated field starts.
fn field_offset(line: [u8], n: i64) -> i64 {
    var i = 0;
    var seen = 0;
    while seen < n {
        while i < line.len && (line[i] == ' ' || line[i] == '\t') {
            i += 1;
        }
        while i < line.len && line[i] != ' ' && line[i] != '\t' {
            i += 1;
        }
        seen += 1;
    }
    while i < line.len && (line[i] == ' ' || line[i] == '\t') {
        i += 1;
    }
    i
}

pub fn macos_snapshot(gpa: Gpa) -> Snapshot {
    var snap = empty_snapshot(gpa);
    snap.wall_us = now_micros();
    let out = match run_command(
        "ps",
        ["-axo", "pid=,ppid=,uid=,user=,state=,time=,rss=,pri=,ni=,command="],
        gpa,
    ) {
        Some(b) => b,
        None => return snap,
    };
    let lines = split_in(out.as_slice(), '\n', gpa);
    for line in lines {
        if line.len == 0 {
            continue;
        }
        let f = split_whitespace_in(line, gpa);
        if f.len < 10 {
            continue;
        }
        var p = Proc::empty();
        p.pid = parse_int(f[0]).unwrap_or(0) as i32;
        if p.pid == 0 {
            continue;
        }
        p.ppid = parse_int(f[1]).unwrap_or(0) as i32;
        p.uid = parse_int(f[2]).unwrap_or(0);
        p.set_user(f[3]);
        p.state = if f[4].len > 0 { f[4][0] } else { '?' };
        p.cpu_us = parse_ps_time(f[5]);
        p.rss_kb = parse_int(f[6]).unwrap_or(0);
        p.pri = parse_int(f[7]).unwrap_or(0);
        p.ni = parse_int(f[8]).unwrap_or(0);
        // ps's vsz is the same reservation for every process on macOS, so
        // it says nothing about this one (htop shows VIRT 0 there too).
        p.virt_kb = 0;
        p.threads = 0;
        p.set_name(trim(line[field_offset(line, 9)..]));
        snap.procs.push(p);
    }
    snap.cpus = read_macos_core_ticks(&snap.core_total, &snap.core_idle);
    if snap.cpus == 0 {
        snap.cpus = max(run_int_command("sysctl", ["-n", "hw.ncpu"], 1, gpa), 1);
    }
    snap.mem_total_kb = run_int_command("sysctl", ["-n", "hw.memsize"], 0, gpa) / 1024;
    let page_kb = max(run_int_command("sysctl", ["-n", "hw.pagesize"], 4096, gpa) / 1024, 1);
    read_macos_memory(&snap, page_kb, gpa);
    read_macos_swap(&snap, gpa);
    read_macos_uptime(&snap, gpa);
    read_load_average(&snap);
    snap
}

// vm_stat's page counts: active, wired and compressed pages are what is in
// use.
fn read_macos_memory(snap: inout Snapshot, page_kb: i64, gpa: Gpa) {
    let out = match run_command("vm_stat", [""][..0], gpa) {
        Some(b) => b,
        None => return,
    };
    let active = vm_stat_pages(out.as_slice(), "Pages active:", gpa);
    let wired = vm_stat_pages(out.as_slice(), "Pages wired down:", gpa);
    let compressed = vm_stat_pages(out.as_slice(), "Pages occupied by compressor:", gpa);
    snap.mem_used_kb = min((active + wired + compressed) * page_kb, snap.mem_total_kb);
}

fn vm_stat_pages(text: [u8], key: [u8], gpa: Gpa) -> i64 {
    let lines = split_in(text, '\n', gpa);
    for line in lines {
        if starts_with(line, key) {
            let rest = trim(line[key.len..]);
            var i = 0;
            var v = 0;
            while i < rest.len && rest[i] >= '0' && rest[i] <= '9' {
                v = v * 10 + (rest[i] - '0') as i64;
                i += 1;
            }
            return v;
        }
    }
    0
}

// sysctl -n vm.swapusage: "total = 2048.00M  used = 1013.44M  free = ...".
fn read_macos_swap(snap: inout Snapshot, gpa: Gpa) {
    let out = match run_command("sysctl", ["-n", "vm.swapusage"], gpa) {
        Some(b) => b,
        None => return,
    };
    snap.swap_total_kb = size_after_label(out.as_slice(), "total = ", gpa);
    snap.swap_used_kb = size_after_label(out.as_slice(), "used = ", gpa);
}

fn size_after_label(text: [u8], key: [u8], gpa: Gpa) -> i64 {
    let at = find_sub(text, key);
    if at < 0 {
        return 0;
    }
    let rest = text[at + key.len..];
    var n = 0;
    while n < rest.len && rest[n] != ' ' && rest[n] != ')' {
        n += 1;
    }
    parse_size_kilobytes(rest[..n])
}

// A size with a unit, as vm.swapusage prints it: "123K", "1.50M", "0B".
fn parse_size_kilobytes(tok: [u8]) -> i64 {
    if tok.len == 0 {
        return 0;
    }
    let last = tok[tok.len - 1];
    var mult = 1.0;
    var num = tok;
    if last == 'K' {
        num = tok[..tok.len - 1];
    } else if last == 'M' {
        mult = 1024.0;
        num = tok[..tok.len - 1];
    } else if last == 'G' {
        mult = 1024.0 * 1024.0;
        num = tok[..tok.len - 1];
    } else if last == 'B' {
        num = tok[..tok.len - 1];
    }
    match parse_f64(num) {
        Ok(v) => (v * mult) as i64,
        Err(_) => 0,
    }
}

// kern.boottime: "{ sec = 1792745384, usec = ... } ...", and the uptime is
// now minus that.
fn read_macos_uptime(snap: inout Snapshot, gpa: Gpa) {
    let out = match run_command("sysctl", ["-n", "kern.boottime"], gpa) {
        Some(b) => b,
        None => return,
    };
    let at = find_sub(out.as_slice(), "sec = ");
    if at < 0 {
        return;
    }
    let rest = out.as_slice()[at + 6..];
    var n = 0;
    while n < rest.len && rest[n] >= '0' && rest[n] <= '9' {
        n += 1;
    }
    let boot = parse_int(rest[..n]).unwrap_or(0);
    let now = time::clock_now(SYS_CLOCK_REALTIME).as_secs() as i64;
    if now > boot {
        snap.uptime_s = (now - boot) as f64;
    }
}
