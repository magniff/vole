// openhtop: a process monitor in the terminal, after htop.
//
// One refresh is a snapshot of the system: the processes, the CPU time each
// has used, the memory, the load average and the uptime. Two snapshots give
// what one cannot: a process's share of the CPU in the interval between them
// (its CPU time grew by so much, the wall clock by so much), and the CPU's
// usage from the idle time in /proc/stat.
//
// The data comes from the system: on Linux /proc (stat, statm, cmdline,
// status, meminfo, uptime, loadavg), on macOS ps, vm_stat and sysctl. Both
// paths are libc calls and ordinary commands, so the program links on either
// system and picks one at run time by asking whether /proc/self/stat exists
// (the trick examples/life and examples/httpd use for their own systems).
//
// The interface is htop's in miniature: the alternate screen, a raw
// terminal, a frame built whole in a Buf and written at once (so it does not
// tear), bars and a table, a few keys (below), and the terminal restored on
// the way out.
//
//   q quit        j/k or arrows move     PgUp/PgDn/Home/End
//   s sort        r reverse              / filter
//   x kill        p pause                ? help
//
// `--demo` renders a fixed snapshot, so the layout can be checked on any
// machine; `--once` prints one frame and exits (no terminal needed), which
// is how tests/examples/openhtop.test checks it.
mod model;
mod text;
mod platform;
mod linux;
mod macos;
mod snapshot;
mod demo;
mod format;
mod ui;
mod app;

use std::env;
use std::cli::{Arg, Command};
use std::sys::sys_isatty;

use app::{run_once, run_tui};
use model::{FILTER_MAX, Flags, copy_text, max};

fn parse_sort(s: [u8]) -> i64 {
    if s == "mem" {
        1
    } else if s == "pid" {
        2
    } else if s == "time" {
        3
    } else if s == "command" {
        4
    } else {
        0
    }
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("openhtop", gpa)
        .version("0.1")
        .about("A process monitor in the terminal, after htop")
        .arg(Arg::flag("demo").help("show a fixed snapshot instead of the system's"))
        .arg(Arg::flag("once").help("print one frame and exit"))
        .arg(Arg::flag("no-color").help("no ANSI colors"))
        .arg(Arg::option("delay").short('d').value_name("MS").default("1500")
            .help("milliseconds between refreshes"))
        .arg(Arg::option("sort").short('s').value_name("FIELD").default("cpu")
            .help("cpu, mem, pid, time or command"))
        .arg(Arg::option("width").value_name("COLUMNS").default("0")
            .help("width (a terminal's is used otherwise)"))
        .arg(Arg::option("height").value_name("ROWS").default("0")
            .help("height (a terminal's is used otherwise)"))
        .arg(Arg::option("pid").value_name("PID").default("0")
            .help("show only this process"))
        .arg(Arg::option("filter").value_name("TEXT").default("")
            .help("show only processes whose command or user contains TEXT"));
    let m = cmd.parse_or_exit(env::args());

    var flags = Flags {
        demo: m.flag("demo"),
        once: m.flag("once"),
        color: !m.flag("no-color") && sys_isatty(1),
        width: m.get_as::<i64>("width").unwrap_or(0),
        height: m.get_as::<i64>("height").unwrap_or(0),
        interval_ms: max(m.get_as::<i64>("delay").unwrap_or(1500), 100),
        sort: parse_sort(m.get("sort").unwrap_or("cpu")),
        only_pid: m.get_as::<i32>("pid").unwrap_or(0),
        filter: [0; FILTER_MAX],
        filter_len: 0,
    };
    if let Some(f) = m.get("filter") {
        flags.filter_len = copy_text(&flags.filter, f);
    }

    let tty = sys_isatty(0) && sys_isatty(1);
    if flags.once || !tty {
        run_once(flags, gpa)
    } else {
        run_tui(flags, gpa)
    }
}
