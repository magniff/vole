// Sizes, times, bars and colors.

use crate::model::{max, min, min_float};

// Green under 40%, yellow under 75%, red above: the load of a meter.
pub fn usage_color(pct: f64) -> [u8] {
    if pct >= 75.0 {
        "\x1b[31m"
    } else if pct >= 40.0 {
        "\x1b[33m"
    } else {
        "\x1b[32m"
    }
}

// [|||||||      37.4%] or [|||||  6.5G/16.0G]: a bar of cells columns,
// with the value right-aligned inside it, over the bar where they meet.
pub fn meter_bar(pct: f64, value: [u8], cells: i64, gpa: Gpa) -> Buf {
    let shown = min_float(max(pct as i64, 0.0 as i64) as f64, 100.0);
    var filled = (shown / 100.0 * cells as f64) as i64;
    // A load that rounds to no cell still shows one, as htop's bars do.
    if filled == 0 && pct > 0.0 {
        filled = 1;
    }
    let value_len = max(min(value.len, cells), 0);
    let value_start = cells - value_len;
    var bar = Buf::with_capacity_in(cells + 4, gpa);
    bar.push('[');
    for i in 0..cells {
        if i >= value_start {
            bar.push(value[i - value_start]);
        } else if i < filled {
            bar.push('|');
        } else {
            bar.push(' ');
        }
    }
    bar.push(']');
    bar
}

pub fn human_size(kb: i64, gpa: Gpa) -> Buf {
    if kb >= 1024 * 1024 {
        format_in(f"{kb as f64 / (1024.0 * 1024.0):.1}G", gpa)
    } else if kb >= 1024 {
        format_in(f"{kb as f64 / 1024.0:.1}M", gpa)
    } else {
        format_in(f"{kb}K", gpa)
    }
}

// "6.5G/16.0G", the value inside a memory or swap meter.
pub fn format_used_total(used_kb: i64, total_kb: i64, gpa: Gpa) -> Buf {
    format_in(
        f"{human_size(used_kb, gpa).as_slice()}/{human_size(total_kb, gpa).as_slice()}",
        gpa,
    )
}

pub fn format_uptime(seconds: f64, gpa: Gpa) -> Buf {
    let total = if seconds > 0.0 { seconds as i64 } else { 0 };
    let days = total / 86400;
    let hours = total / 3600 % 24;
    let minutes = total / 60 % 60;
    let secs = total % 60;
    if days > 0 {
        format_in(f"{days}d {hours:02}:{minutes:02}:{secs:02}", gpa)
    } else {
        format_in(f"{hours:02}:{minutes:02}:{secs:02}", gpa)
    }
}

pub fn format_load(load: [f64; 3], gpa: Gpa) -> Buf {
    format_in(f"{load[0]:.2} {load[1]:.2} {load[2]:.2}", gpa)
}

pub fn format_cpu_time(micros: i64, gpa: Gpa) -> Buf {
    let seconds = micros / 1000000;
    let hours = seconds / 3600;
    let minutes = seconds / 60 % 60;
    let secs = seconds % 60;
    if hours > 0 {
        format_in(f"{hours}:{minutes:02}:{secs:02}", gpa)
    } else {
        format_in(f"{minutes}:{secs:02}", gpa)
    }
}

pub fn sort_label(sort: i64) -> [u8] {
    if sort == 0 {
        "CPU"
    } else if sort == 1 {
        "MEM"
    } else if sort == 2 {
        "PID"
    } else if sort == 3 {
        "TIME+"
    } else {
        "Command"
    }
}
