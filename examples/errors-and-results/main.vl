// A config-file parser: errors as typed values, `?` to pass them up,
// `From` to convert between layers, and `main` returning a Result.
//
// The config comes on stdin, one `key = value` per line:
//   name = demo
//   port = 8080
// `#` starts a comment. `port` is required; the other keys have defaults.
use std::{fmt, io};
use std::alloc::Allocator;
use std::collections::HashMap;
use std::fmt::{Display, Formatter};
use std::num::ParseIntError;

// ---- The value layer: one value, no idea where it came from. ----

#[derive(Debug)]
enum ValueError { NotANumber(ParseIntError), NotABool, OutOfRange(i64, i64, i64) }

// Lets `?` turn parse's error into ours.
impl From<ParseIntError> for ValueError {
    fn from(e: ParseIntError) -> ValueError { ValueError::NotANumber(e) }
}

impl Display for ValueError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            ValueError::NotANumber(e) => write(f, "not a number ({e})"),
            ValueError::NotABool => write(f, "expected true or false"),
            ValueError::OutOfRange(n, lo, hi) => write(f, "{n} is not in {lo}..={hi}"),
        }
    }
}

fn parse_number(text: &str, lo: i64, hi: i64) -> Result<i64, ValueError> {
    let n = text.parse::<i64>()?; // Err(ParseIntError) returns Err(ValueError::from(e))
    if n < lo || n > hi { return Err(ValueError::OutOfRange(n, lo, hi)); }
    Ok(n)
}

fn parse_word(text: &str) -> Option<bool> {
    if text == "true" { return Some(true); }
    if text == "false" { return Some(false); }
    None
}

fn parse_bool(text: &str) -> Result<bool, ValueError> {
    parse_word(text).ok_or(ValueError::NotABool) // Option -> Result
}

// ---- The file layer: knows lines and keys. ----

#[derive(Debug)]
enum ConfigError<A: Allocator> {
    Read(io::Error),
    NoEquals(i64),
    UnknownKey(i64, String<A>),
    Duplicate(i64, String<A>),
    BadValue(i64, String<A>, ValueError),
    Missing(String<A>),
}

impl<A: Allocator> From<io::Error> for ConfigError<A> {
    fn from(e: io::Error) -> ConfigError<A> { ConfigError::Read(e) }
}

impl<A: Allocator> Display for ConfigError<A> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            ConfigError::Read(e) => write(f, "{e}"),
            ConfigError::NoEquals(line) => write(f, "line {line}: expected `key = value`"),
            ConfigError::UnknownKey(line, key) => write(f, "line {line}: unknown key `{key}`"),
            ConfigError::Duplicate(line, key) => write(f, "line {line}: `{key}` is set twice"),
            ConfigError::BadValue(line, key, e) => write(f, "line {line}: {key}: {e}"),
            ConfigError::Missing(key) => write(f, "`{key}` is required"),
        }
    }
}

const KEYS: [&str; 5] = ["name", "port", "workers", "debug", "timeout_ms"];

// A value as written, and the line it is on (for messages).
struct Field<'a> { value: &'a str, line: i64 }

type Fields<'a> = HashMap<&'a str, Field<'a>, Gpa>;

struct Config<'a> { name: &'a str, port: i64, workers: i64, debug: bool, timeout_ms: i64 }

// The text to `key -> Field`; the first bad line stops it.
fn read_fields<'a>(text: &'a str, fields: &mut HashMap<&'a str, Field<'a>, Gpa>) -> Result<(),
    ConfigError<Gpa>> {
    let mut number = 0;
    for raw in text.lines() {
        number += 1;
        let line = raw.trim();
        if line.is_empty() || line.starts_with("#") { continue; }
        // Option -> Result: no '=' is an error, with the line number.
        let (key, value) = line.split_once("=").ok_or(ConfigError::<Gpa>::NoEquals(number))?;
        let key = key.trim();
        let value = value.trim();
        // (an error owns a copy of its key: it may outlive the text)
        let gpa = *fields.allocator();
        if !KEYS.iter().any(|k| *k == key) {
            return Err(ConfigError::UnknownKey(number, String::from_in(key, gpa)));
        }
        if fields.contains_key(&key) {
            return Err(ConfigError::Duplicate(number, String::from_in(key, gpa)));
        }
        fields.insert(key, Field { value, line: number });
    }
    Ok(())
}

// Absent is not an error: Ok(None). A bad value is: Err, with its line.
fn number(fields: &Fields, key: &str, lo: i64, hi: i64) -> Result<Option<i64>, ConfigError<Gpa>> {
    match fields.get(&key) {
        None => Ok(None),
        Some(field) => {
            // map_err: a ValueError becomes a ConfigError that says where
            let n = parse_number(field.value, lo, hi).map_err(|e| {
                ConfigError::BadValue(field.line, String::from_in(key, *fields.allocator()), e)
            })?;
            Ok(Some(n))
        }
    }
}

fn flag(fields: &Fields, key: &str) -> Result<Option<bool>, ConfigError<Gpa>> {
    match fields.get(&key) {
        None => Ok(None),
        Some(field) => {
            let b = parse_bool(field.value).map_err(|e| {
                ConfigError::BadValue(field.line, String::from_in(key, *fields.allocator()), e)
            })?;
            Ok(Some(b))
        }
    }
}

fn parse_config(text: &str, gpa: Gpa) -> Result<Config<'_>, ConfigError<Gpa>> {
    let mut fields: Fields = HashMap::new_in(gpa);
    // (dropped on every exit, the early ones of `?` too)
    read_fields(text, &mut fields)?;
    Ok(Config {
        name: fields.get(&"name").map(|f| f.value).unwrap_or("unnamed"),
        port: number(&fields, "port", 1, 65535)?
            .ok_or(ConfigError::Missing(String::from_in("port", gpa)))?,
        workers: number(&fields, "workers", 1, 64)?.unwrap_or(1),
        debug: flag(&fields, "debug")?.unwrap_or(false),
        timeout_ms: number(&fields, "timeout_ms", 0, 60000)?.unwrap_or(1000),
    })
}

// Errors are values: here each one is matched and printed, not returned.
fn show_rejections(gpa: Gpa) {
    let samples = [
        "port = 80\nport = 81",
        "port: 80",
        "port = 80\ncolour = blue",
        "port = 8o",
        "port = 70000",
        "port = 80\ndebug = yes",
        "name = no port",
    ];
    println("rejected samples:");
    for sample in samples {
        match parse_config(sample, gpa) {
            Ok(c) => println("  accepted?! port {}", c.port),
            Err(e) => {
                let quoted = format_in("{sample:?}", gpa); // Debug: quoted, \n escaped
                println("  {quoted:<26} {e}");
            }
        }
    }
}

// `?` in main: an Err ends the program with `Error: ` and the error's Debug
// text on stderr, and exit status 1.
fn main(gpa: Gpa) -> Result<(), ConfigError<Gpa>> {
    show_rejections(gpa);
    let input = io::read_to_string_in(io::stdin(), gpa)?; // io::Error -> ConfigError through From
    // An error owns its key (a String), so it can outlive `input`, which is
    // dropped when main returns, before main's caller prints the error.
    let config = parse_config(&input, gpa)?;
    println("config: {} on port {}", config.name, config.port);
    println("  workers {}, debug {}, timeout {} ms", config.workers, config.debug,
        config.timeout_ms);
    Ok(())
}
