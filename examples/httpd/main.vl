// EDITION: rust
// httpd: a simple HTTP file server, a clone of `python -m http.server`:
// serves the files and directory listings of a directory on
// http://127.0.0.1:8000/.
//
// usage: httpd [DIRECTORY]          (default: the current directory)
//   e.g. httpd /var/www
//        httpd .
//
// It runs on Linux and macOS, built for either from either: the C library
// is declared by hand, and where the systems differ (socket constants,
// struct sockaddr_in, struct dirent) the module `sys` asks uname() which
// one it runs on.

use std::env;
use std::alloc::Allocator;
use std::cli::{Arg, Command};

// UNSAFE: the C library's functions, declared by hand (no headers: the
// program is built for Linux and macOS from either).
// SAFETY: the signatures are POSIX's, the same on both systems; each
// call says why its arguments are valid.
extern "C" {
    fn socket(domain: i32, kind: i32, protocol: i32) -> i32;
    fn setsockopt(fd: i32, level: i32, name: i32, value: *const u8, len: u32) -> i32;
    fn bind(fd: i32, addr: *const u8, len: u32) -> i32;
    fn listen(fd: i32, backlog: i32) -> i32;
    fn accept(fd: i32, addr: *mut u8, len: *mut u32) -> i32;
    fn read(fd: i32, buf: *mut u8, count: u64) -> i64;
    fn write(fd: i32, buf: *const u8, count: u64) -> i64;
    fn open(path: *const u8, flags: i32, ...) -> i32;
    fn close(fd: i32) -> i32;
    fn lseek(fd: i32, offset: i64, whence: i32) -> i64;
    fn opendir(path: *const u8) -> *mut u8;
    fn readdir(dir: *mut u8) -> *const u8;
    fn closedir(dir: *mut u8) -> i32;
    fn strlen(s: *const u8) -> u64;
    fn getcwd(buf: *mut u8, size: u64) -> *mut u8;
    fn realpath(path: *const u8, resolved: *mut u8) -> *mut u8;
    fn uname(names: *mut u8) -> i32;
}

const PORT: u16 = 8000;
const LOCALHOST: u32 = 0x7f000001; // 127.0.0.1
const O_RDONLY: i32 = 0;
const SEEK_END: i32 = 2;
const PATH_MAX: i64 = 4096;

// A file descriptor (a file, a connection), closed when the guard is
// dropped: at the end of its scope, whichever `return` is taken.
struct Fd { fd: i32 }

impl Drop for Fd {
    fn drop(&mut self) {
        // UNSAFE: close(2) is the C library's, declared above; std has no descriptor type.
        // SAFETY: the descriptor is an open one (checked by the caller), held by this
        // guard alone, and closed once, here.
        unsafe { close(self.fd) };
    }
}

// An open directory, closed when the guard is dropped.
struct Dir { dir: *mut u8 }

impl Drop for Dir {
    fn drop(&mut self) {
        // UNSAFE: closedir(3) is the C library's, declared above.
        // SAFETY: the pointer is the one opendir() returned, not null, held by this guard
        // alone, and closed once, here.
        unsafe { closedir(self.dir) };
    }
}

// ============================================================================
// What differs between Linux and macOS
// ============================================================================

mod sys {
    use std::mem::size_of;

    use super::{bind, close, listen, setsockopt, socket, strlen, uname};

    // The system the program runs on. Intel Macs keep the old struct
    // dirent under readdir's plain name.
    #[derive(Clone, Copy, PartialEq)]
    pub enum System { Linux, MacArm, MacIntel }

    fn starts_with(s: &[u8], prefix: &[u8]) -> bool {
        s.len() >= prefix.len() && &s[..prefix.len()] == prefix
    }

    pub fn detect() -> System {
        // struct utsname: five fields of 256 bytes on macOS (the machine
        // last), six of 65 on Linux; the system's name comes first.
        let mut names: [u8; 1280] = [0; 1280];
        // UNSAFE: uname(2) is the C library's, and writes through a pointer.
        // SAFETY: `names` is larger than either system's struct utsname.
        let failed = unsafe { uname(names.as_mut_ptr()) != 0 };
        if failed || !starts_with(&names[..], b"Darwin") {
            return System::Linux;
        }
        if starts_with(&names[1024..], b"arm64") { System::MacArm } else { System::MacIntel }
    }

    // struct sockaddr_in: BSD puts the length before the family.
    #[repr(C)]
    struct SockaddrIn { family: u16, port: u16, addr: u32, zero: [u8; 8] }

    #[repr(C)]
    struct SockaddrInBsd { len: u8, family: u8, port: u16, addr: u32, zero: [u8; 8] }

    const AF_INET: i32 = 2;
    const SOCK_STREAM: i32 = 1;

    fn swap16(x: u16) -> u16 {
        (x << 8) | (x >> 8)
    }

    fn swap32(x: u32) -> u32 {
        (x << 24) | ((x & 0xff00) << 8) | ((x >> 8) & 0xff00) | (x >> 24)
    }

    // A TCP socket listening on addr:port (in host order), with
    // SO_REUSEADDR; or the message of what failed.
    pub fn listen_tcp(system: System, addr: u32, port: u16) -> Result<i32, &'static str> {
        // UNSAFE: socket(2) is the C library's.
        // SAFETY: it takes three numbers.
        let fd = unsafe { socket(AF_INET, SOCK_STREAM, 0) };
        if fd < 0 {
            return Err("error: socket() failed\n");
        }
        // SOL_SOCKET and SO_REUSEADDR
        let linux = system == System::Linux;
        let level: i32 = if linux { 1 } else { 0xffff };
        let name: i32 = if linux { 2 } else { 4 };
        let one: i32 = 1;
        // UNSAFE: setsockopt(2) is the C library's, and reads through a pointer.
        // SAFETY: the value is `one`, an i32 that lives past the call, with its size.
        unsafe {
            setsockopt(fd, level, name, &one as *const i32 as *const u8, size_of::<i32>() as u32);
        }

        let bound = if linux {
            let sa = SockaddrIn {
                family: AF_INET as u16, port: swap16(port), addr: swap32(addr), zero: [0; 8],
            };
            // UNSAFE: bind(2) is the C library's, and reads through a pointer.
            // SAFETY: `sa` is Linux's struct sockaddr_in (repr(C)), passed with its
            // size, and lives past the call.
            unsafe {
                bind(fd, &sa as *const SockaddrIn as *const u8, size_of::<SockaddrIn>() as u32)
            }
        } else {
            let sa = SockaddrInBsd {
                len: size_of::<SockaddrInBsd>() as u8,
                family: AF_INET as u8,
                port: swap16(port),
                addr: swap32(addr),
                zero: [0; 8],
            };
            // UNSAFE: bind(2) is the C library's, and reads through a pointer.
            // SAFETY: `sa` is BSD's struct sockaddr_in (repr(C)), passed with its
            // size, and lives past the call.
            unsafe {
                bind(fd, &sa as *const SockaddrInBsd as *const u8,
                    size_of::<SockaddrInBsd>() as u32)
            }
        };
        if bound < 0 {
            // UNSAFE: close(2) is the C library's.
            // SAFETY: fd is the socket opened above, closed once on this path.
            unsafe {
                close(fd);
            }
            return Err("error: bind() failed (port 8000 in use?)\n");
        }
        // UNSAFE: listen(2) is the C library's.
        // SAFETY: fd is the bound socket.
        let listening = unsafe { listen(fd, 128) };
        if listening < 0 {
            // UNSAFE: close(2) is the C library's.
            // SAFETY: fd is the socket opened above, closed once on this path.
            unsafe {
                close(fd);
            }
            return Err("error: listen() failed\n");
        }
        Ok(fd)
    }

    // struct dirent as readdir returns it on each system (d_name is as
    // long as the name).
    #[repr(C)]
    struct DirentLinux { ino: u64, off: i64, reclen: u16, r#type: u8, name: [u8; 256] }

    #[repr(C)]
    struct DirentMac {
        ino: u64, seekoff: u64, reclen: u16, namlen: u16, r#type: u8, name: [u8; 1024],
    }

    #[repr(C)]
    struct DirentMacOld { ino: u32, reclen: u16, r#type: u8, namlen: u8, name: [u8; 256] }

    // O_NONBLOCK, so that opening a FIFO does not wait for a writer
    pub fn o_nonblock(system: System) -> i32 {
        if system == System::Linux { 0x800 } else { 0x4 }
    }

    pub const DT_UNKNOWN: u8 = 0;
    pub const DT_DIR: u8 = 4;

    // The name (NUL-terminated) and the d_type of the entry readdir
    // returned.
    //
    // UNSAFE: it reads a struct dirent through a raw pointer.
    // SAFETY: the caller's promise: `entry` points to a struct dirent of
    // this system. Only the address of its name is taken (the struct is as
    // long as the name, often shorter than the declared array).
    pub unsafe fn dirent(system: System, entry: *const u8) -> (*const u8, u8) {
        match system {
            System::Linux => {
                let d = entry as *const DirentLinux;
                (&raw const (*d).name as *const u8, (*d).r#type)
            }
            System::MacArm => {
                let d = entry as *const DirentMac;
                (&raw const (*d).name as *const u8, (*d).r#type)
            }
            System::MacIntel => {
                let d = entry as *const DirentMacOld;
                (&raw const (*d).name as *const u8, (*d).r#type)
            }
        }
    }

    // The bytes of a C string.
    //
    // UNSAFE: it reads C's string through a raw pointer.
    // SAFETY: the caller's promise: `s` points to a NUL-terminated string
    // that outlives the slice.
    pub unsafe fn cstr<'a>(s: *const u8) -> &'a [u8] {
        std::slice::from_raw_parts(s, strlen(s) as usize)
    }
}

use sys::System;

// ============================================================================
// Bytes and paths
// ============================================================================

fn ends_with(s: &[u8], suffix: &[u8]) -> bool {
    s.len() >= suffix.len() && &s[s.len() - suffix.len()..] == suffix
}

// A path for C: its bytes and a NUL (the Vec is freed when the Path is
// dropped).
struct Path<A: Allocator> { buf: Vec<u8, A> }

impl Path<Gpa> {
    // dir/name, without doubling the slash between them.
    fn join(dir: &[u8], name: &[u8], gpa: Gpa) -> Path<Gpa> {
        let mut buf = Vec::<u8, Gpa>::new_in(gpa);
        buf.extend_from_slice(dir);
        let dir_slash = ends_with(dir, b"/");
        let name_slash = name.len() > 0 && name[0] == b'/';
        if dir_slash && name_slash {
            buf.extend_from_slice(&name[1..]);
        } else {
            if !dir_slash && !name_slash {
                buf.push(b'/');
            }
            buf.extend_from_slice(name);
        }
        buf.push(0);
        Path { buf }
    }

    fn c(&self) -> *const u8 {
        self.buf.as_ptr()
    }

    fn bytes(&self) -> &[u8] {
        &self.buf[..self.buf.len() - 1]
    }
}

// What a path names.
#[derive(PartialEq)]
enum Kind { Missing, Dir, File(i64) }

fn probe(system: System, path: &Path<Gpa>) -> Kind {
    // UNSAFE: opendir(3) is the C library's.
    // SAFETY: the path is NUL-terminated (Path::join) and lives past the call.
    let dir = unsafe { opendir(path.c()) };
    if !dir.is_null() {
        // UNSAFE: closedir(3) is the C library's.
        // SAFETY: `dir` is the open directory, not null, closed once.
        unsafe {
            closedir(dir);
        }
        return Kind::Dir;
    }
    // UNSAFE: open(2) is the C library's.
    // SAFETY: the path is NUL-terminated and lives past the call.
    let fd = unsafe { open(path.c(), O_RDONLY | sys::o_nonblock(system)) };
    if fd < 0 {
        return Kind::Missing;
    }
    let _fd = Fd { fd };
    // UNSAFE: lseek(2) is the C library's.
    // SAFETY: fd is open until `_fd` is dropped.
    unsafe { Kind::File(lseek(fd, 0, SEEK_END)) }
}

// ============================================================================
// URL decoding: %XX sequences, and '+' as a space
// ============================================================================

fn hex_val(ch: u8) -> Option<u8> {
    match ch {
        b'0'..=b'9' => Some(ch - b'0'),
        b'A'..=b'F' => Some(ch - b'A' + 10),
        b'a'..=b'f' => Some(ch - b'a' + 10),
        _ => None,
    }
}

fn url_decode(s: &[u8], gpa: Gpa) -> Vec<u8, Gpa> {
    let mut out = Vec::<u8, Gpa>::new_in(gpa);
    let mut r = 0usize;
    while r < s.len() {
        let ch = s[r];
        r += 1;
        if ch == b'%' && r + 1 < s.len() {
            if let Some(hi) = hex_val(s[r]) {
                if let Some(lo) = hex_val(s[r + 1]) {
                    out.push(hi * 16 + lo);
                    r += 2;
                    continue;
                }
            }
        }
        out.push(if ch == b'+' { b' ' } else { ch });
    }
    out
}

// ============================================================================
// MIME type detection (minimal, by extension)
// ============================================================================

struct Mime { ext: &'static str, kind: &'static str }

fn guess_mime(path: &[u8]) -> &'static str {
    let types = [
        Mime { ext: ".html", kind: "text/html; charset=utf-8" },
        Mime { ext: ".htm", kind: "text/html; charset=utf-8" },
        Mime { ext: ".css", kind: "text/css" },
        Mime { ext: ".js", kind: "application/javascript" },
        Mime { ext: ".json", kind: "application/json" },
        Mime { ext: ".txt", kind: "text/plain; charset=utf-8" },
        Mime { ext: ".md", kind: "text/plain; charset=utf-8" },
        Mime { ext: ".png", kind: "image/png" },
        Mime { ext: ".jpg", kind: "image/jpeg" },
        Mime { ext: ".jpeg", kind: "image/jpeg" },
        Mime { ext: ".gif", kind: "image/gif" },
        Mime { ext: ".svg", kind: "image/svg+xml" },
        Mime { ext: ".ico", kind: "image/x-icon" },
        Mime { ext: ".pdf", kind: "application/pdf" },
        Mime { ext: ".zip", kind: "application/zip" },
        Mime { ext: ".tar", kind: "application/x-tar" },
        Mime { ext: ".gz", kind: "application/gzip" },
        Mime { ext: ".wasm", kind: "application/wasm" },
        Mime { ext: ".xml", kind: "application/xml" },
        Mime { ext: ".mp4", kind: "video/mp4" },
        Mime { ext: ".webm", kind: "video/webm" },
        Mime { ext: ".mp3", kind: "audio/mpeg" },
    ];
    for m in types {
        if ends_with(path, m.ext.as_bytes()) {
            return m.kind;
        }
    }
    "application/octet-stream"
}

// ============================================================================
// HTML-escape a string for safe display (handles &, <, >, ")
// ============================================================================

fn push_escaped(out: &mut Vec<u8, Gpa>, s: &[u8]) {
    for &ch in s {
        match ch {
            b'&' => out.extend_from_slice(b"&amp;"),
            b'<' => out.extend_from_slice(b"&lt;"),
            b'>' => out.extend_from_slice(b"&gt;"),
            b'"' => out.extend_from_slice(b"&quot;"),
            _ => out.push(ch),
        }
    }
}

// ============================================================================
// HTTP responses
// ============================================================================

fn send_all(fd: i32, s: &[u8]) {
    let mut sent = 0usize;
    while sent < s.len() {
        // UNSAFE: write(2) is the C library's.
        // SAFETY: s[sent..] is the caller's slice, and the count is its length.
        let n = unsafe { write(fd, s[sent..].as_ptr(), (s.len() - sent) as u64) };
        if n <= 0 {
            break;
        }
        sent += n as usize;
    }
}

// The headers, with a Content-Length when it is known.
fn send_headers(fd: i32, status: &str, content_type: &str, length: Option<i64>, gpa: Gpa) {
    let mut h = format_in("HTTP/1.0 {status}\r\nContent-Type: {content_type}", gpa);
    if let Some(n) = length {
        h.push_str(format_in("\r\nContent-Length: {n}", gpa).as_str());
    }
    h.push_str("\r\nConnection: close\r\n\r\n");
    send_all(fd, h.as_bytes());
}

fn send_html(fd: i32, status: &str, body: Vec<u8, Gpa>, gpa: Gpa) {
    let bytes = body.as_slice();
    send_headers(fd, status, "text/html; charset=utf-8", Some(bytes.len() as i64), gpa);
    send_all(fd, bytes);
}

fn send_404(fd: i32, path: &[u8], gpa: Gpa) {
    let mut body = Vec::<u8, Gpa>::new_in(gpa);
    body.extend_from_slice(b"<!DOCTYPE html><html><head><title>404 Not Found</title>");
    body.extend_from_slice(b"<style>body{font-family:sans-serif;margin:40px}</style></head>");
    body.extend_from_slice(b"<body><h1>404 Not Found</h1><p>The path <code>");
    push_escaped(&mut body, path);
    body.extend_from_slice(b"</code> was not found on this server.</p></body></html>");
    send_html(fd, "404 Not Found", body, gpa);
}

// (the location is the request's bytes, which need not be UTF-8)
fn send_redirect(fd: i32, location: &[u8], gpa: Gpa) {
    let mut h = Vec::<u8, Gpa>::new_in(gpa);
    h.extend_from_slice(b"HTTP/1.0 301 Moved Permanently\r\nLocation: ");
    h.extend_from_slice(location);
    h.extend_from_slice(b"\r\nConnection: close\r\n\r\n");
    send_all(fd, h.as_slice());
}

// ============================================================================
// Directory listing
// ============================================================================

fn push_style(out: &mut Vec<u8, Gpa>) {
    out.extend_from_slice(b"<style>\n");
    out.extend_from_slice(b"body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; ");
    out.extend_from_slice(b"margin: 0; padding: 20px 40px; background: #fafafa; color: #333; }\n");
    out.extend_from_slice(
        b"h1 { font-weight: 400; border-bottom: 1px solid #ddd; padding-bottom: 10px; }\n");
    out.extend_from_slice(b"table { border-collapse: collapse; width: 100%; max-width: 800px; }\n");
    out.extend_from_slice(b"th, td { text-align: left; padding: 8px 16px; }\n");
    out.extend_from_slice(b"th { background: #eee; font-weight: 600; font-size: 0.85em; ");
    out.extend_from_slice(b"text-transform: uppercase; letter-spacing: 0.05em; }\n");
    out.extend_from_slice(b"tr:hover { background: #f0f0f0; }\n");
    out.extend_from_slice(b"a { color: #0066cc; text-decoration: none; }\n");
    out.extend_from_slice(b"a:hover { text-decoration: underline; }\n");
    out.extend_from_slice(b".dir { font-weight: 600; }\n");
    out.extend_from_slice(b".size { font-variant-numeric: tabular-nums; color: #666; }\n");
    out.extend_from_slice(b".icon { width: 20px; }\n");
    out.extend_from_slice(b"</style>\n");
}

fn serve_directory(fd: i32, system: System, dir_path: &Path<Gpa>, url: &[u8], gpa: Gpa) {
    // UNSAFE: opendir(3) is the C library's.
    // SAFETY: the path is NUL-terminated (Path::join) and lives past the call.
    let dir = unsafe { opendir(dir_path.c()) };
    if dir.is_null() {
        send_404(fd, url, gpa);
        return;
    }
    let _dir = Dir { dir };

    let mut body = Vec::<u8, Gpa>::new_in(gpa);
    body.extend_from_slice(b"<!DOCTYPE html>\n<html>\n<head>\n");
    body.extend_from_slice(b"<meta charset=\"utf-8\">\n");
    body.extend_from_slice(b"<title>Directory listing for ");
    push_escaped(&mut body, url);
    body.extend_from_slice(b"</title>\n");
    push_style(&mut body);
    body.extend_from_slice(b"</head>\n<body>\n");
    body.extend_from_slice(b"<h1>Directory listing for ");
    push_escaped(&mut body, url);
    body.extend_from_slice(b"</h1>\n");
    if url.len() > 1 {
        body.extend_from_slice(b"<p><a href=\"..\">Parent directory</a></p>\n");
    }
    body.extend_from_slice(
        b"<table>\n<tr><th class=\"icon\"></th><th>Name</th><th>Size</th></tr>\n");

    loop {
        // UNSAFE: readdir(3) is the C library's.
        // SAFETY: `dir` is open until `_dir` is dropped.
        let entry = unsafe { readdir(dir) };
        if entry.is_null() {
            break;
        }
        // UNSAFE: the entry and its name are read through raw pointers.
        // SAFETY: `entry` is this system's struct dirent, as readdir returned
        // it, and its name is NUL-terminated; both live until the next
        // readdir on `dir`, at the next turn of the loop, after `name`'s last use.
        let (name, dtype) = unsafe {
            let (cname, dtype) = sys::dirent(system, entry);
            (sys::cstr(cname), dtype)
        };
        if ends_with(name, b".") && (name.len() == 1 || name.len() == 2 && name[0] == b'.') {
            continue;
        }

        let path = Path::join(dir_path.bytes(), name, gpa);
        let kind = probe(system, &path);
        // d_type is DT_UNKNOWN on file systems that do not keep it
        let is_dir = if dtype == sys::DT_UNKNOWN { kind == Kind::Dir }
            else { dtype == sys::DT_DIR };

        body.extend_from_slice(b"<tr><td class=\"icon\">");
        body.extend_from_slice(b"</td><td><a ");
        if is_dir {
            body.extend_from_slice(b"class=\"dir\" ");
        }
        body.extend_from_slice(b"href=\"");
        push_escaped(&mut body, name);
        if is_dir {
            body.push(b'/');
        }
        body.extend_from_slice(b"\">");
        push_escaped(&mut body, name);
        if is_dir {
            body.push(b'/');
        }
        body.extend_from_slice(b"</a></td><td class=\"size\">");
        match kind {
            _ if is_dir => body.push(b'-'),
            Kind::File(size) if size >= 0 => {
                body.extend_from_slice(format_in("{}", size, gpa).as_bytes())
            }
            _ => body.push(b'?'),
        }
        body.extend_from_slice(b"</td></tr>\n");
    }

    body.extend_from_slice(b"</table>\n");
    body.extend_from_slice(b"<hr><p style=\"color:#999;font-size:0.85em\">");
    body.extend_from_slice(b"Vole HTTP Server</p>\n");
    body.extend_from_slice(b"</body>\n</html>\n");
    send_html(fd, "200 OK", body, gpa);
}

// ============================================================================
// File serving
// ============================================================================

fn serve_file(fd: i32, system: System, path: &Path<Gpa>, size: i64, gpa: Gpa) {
    // (not to wait for a writer if it is a FIFO)
    // UNSAFE: open(2) is the C library's.
    // SAFETY: the path is NUL-terminated and lives past the call.
    let file = unsafe { open(path.c(), O_RDONLY | sys::o_nonblock(system)) };
    if file < 0 {
        send_404(fd, path.bytes(), gpa);
        return;
    }
    let _file = Fd { fd: file };

    // (a FIFO or a device has no size)
    let length: Option<i64> = if size >= 0 { Some(size) } else { None };
    send_headers(fd, "200 OK", guess_mime(path.bytes()), length, gpa);
    let mut chunk: [u8; 8192] = [0; 8192];
    loop {
        // UNSAFE: read(2) is the C library's, and writes through a pointer.
        // SAFETY: `chunk` is ours to write and 8192 bytes long.
        let n = unsafe { read(file, chunk.as_mut_ptr(), 8192) };
        if n <= 0 {
            break;
        }
        send_all(fd, &chunk[..n as usize]);
    }
}

// ============================================================================
// Requests
// ============================================================================

// The method and the path (without the query) of a request line.
fn parse_request(req: &[u8]) -> Option<(&[u8], &[u8])> {
    let mut i = 0usize;
    while i < req.len() && req[i] != b' ' {
        i += 1;
    }
    if i == req.len() {
        return None;
    }
    let method = &req[..i];
    let start = i + 1;
    i = start;
    while i < req.len() && req[i] != b' ' && req[i] != b'?' {
        i += 1;
    }
    if i == start {
        return None;
    }
    Some((method, &req[start..i]))
}

fn handle_request(fd: i32, system: System, root: &[u8], gpa: Gpa) {
    let _connection = Fd { fd };
    let mut request: [u8; 8192] = [0; 8192];
    // UNSAFE: read(2) is the C library's, and writes through a pointer.
    // SAFETY: `request` is ours to write, and longer than the count.
    let n = unsafe { read(fd, request.as_mut_ptr(), 8191) };
    if n <= 0 {
        return;
    }
    let (method, raw_path) = if let Some(parts) = parse_request(&request[..n as usize]) {
        parts
    } else {
        send_404(fd, b"/", gpa);
        return;
    };

    let decoded = url_decode(raw_path, gpa);
    let url = decoded.as_slice();

    // log the request on stderr (its bytes as they came)
    let mut log = Vec::<u8, Gpa>::new_in(gpa);
    log.extend_from_slice(method);
    log.push(b' ');
    log.extend_from_slice(url);
    send_all(2, log.as_slice());

    let path = Path::join(root, url, gpa);
    match probe(system, &path) {
        Kind::Missing => {
            eprintln(" 404");
            send_404(fd, url, gpa);
        }
        Kind::File(size) => {
            eprintln(" 200 ({})", guess_mime(path.bytes()));
            serve_file(fd, system, &path, size, gpa);
        }
        Kind::Dir => {
            if !ends_with(url, b"/") {
                let mut location = Vec::<u8, Gpa>::new_in(gpa);
                location.extend_from_slice(url);
                location.push(b'/');
                eprintln(" 301");
                send_redirect(fd, location.as_slice(), gpa);
                return;
            }
            let index = Path::join(path.bytes(), b"index.html", gpa);
            if let Kind::File(size) = probe(system, &index) {
                eprintln(" 200 (index.html)");
                serve_file(fd, system, &index, size, gpa);
                return;
            }
            eprintln(" 200 (dir)");
            serve_directory(fd, system, &path, url, gpa);
        }
    }
}

// ============================================================================
// Main: the root directory, then a socket and the accept loop
// ============================================================================

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("httpd", gpa)
        .about("a simple HTTP file server on http://127.0.0.1:8000/")
        .arg(Arg::positional("directory").help("the directory to serve (none: the current one)"));
    let m = cmd.parse_or_exit(env::args());
    let system = sys::detect();

    // the directory made absolute, else the current directory
    let mut root_buf: [u8; 4096] = [0; 4096];
    let mut resolved = false;
    if let Some(dir) = m.get("directory") {
        // (C wants the path NUL-terminated: a &str is not)
        let mut dir_c = String::new_in(gpa);
        dir_c.push_str(dir);
        dir_c.push('\0');
        // UNSAFE: realpath(3) is the C library's, and writes through a pointer.
        // SAFETY: `dir_c` is NUL-terminated and lives past the call;
        // `root_buf` has PATH_MAX bytes, all realpath writes.
        resolved = unsafe { !realpath(dir_c.as_ptr(), root_buf.as_mut_ptr()).is_null() };
    }
    if !resolved {
        // UNSAFE: getcwd(3) is the C library's, and writes through a pointer.
        // SAFETY: `root_buf` is ours to write, and PATH_MAX bytes long.
        let cwd = unsafe { getcwd(root_buf.as_mut_ptr(), PATH_MAX as u64) };
        if cwd.is_null() {
            eprintln("error: cannot get cwd");
            return 1;
        }
    }
    // UNSAFE: the C string in `root_buf` is read through a pointer.
    // SAFETY: realpath or getcwd left a NUL-terminated path in `root_buf`,
    // which lives, unchanged, to the end of main.
    let root = unsafe { sys::cstr(root_buf.as_ptr()) };

    eprintln("Serving {}", String::from_utf8_lossy_in(root, gpa));

    match sys::listen_tcp(system, LOCALHOST, PORT) {
        Err(message) => {
            eprint("{message}");
            1
        }
        Ok(server) => {
            eprintln("Serving HTTP on http://127.0.0.1:8000/ ...");
            loop {
                // UNSAFE: accept(2) is the C library's.
                // SAFETY: `server` is the listening socket; the peer's address
                // is not asked for (two null pointers, as accept allows).
                let fd = unsafe { accept(server, std::ptr::null_mut(), std::ptr::null_mut()) };
                if fd >= 0 {
                    handle_request(fd, system, root, gpa);
                }
            }
        }
    }
}
