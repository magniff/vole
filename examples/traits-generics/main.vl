// A small geometry and units library, used: traits with default methods,
// generic functions with bounds, an associated type, derived and
// hand-written trait impls, operator overloading, and From/Into between
// unit types. The library is two modules, geometry.vl and units.vl.
mod geometry;
mod units;

use std::collections::HashMap;
use std::fmt::Display;

use geometry::{
    AnyShape, Circle, HALF_TURN, Measured, Polygon, ROTATE_90, Rect, Segment, Shape, Vec2,
};
use units::{Feet, Meters, total};

// Generic over any Shape: the bound lets the body call area().
fn total_area<T: Shape>(shapes: &[T]) -> f64 {
    let mut total = 0.0;
    for s in shapes { total += s.area(); } // s: a reference to each element
    total
}

// Generic over any Ord: the largest element, or None for an empty slice.
// `Copy` lets it return the element itself, not a reference to it.
fn largest<T: Ord + Copy>(xs: &[T]) -> Option<T> {
    if xs.is_empty() { return None; }
    let mut best = xs[0];
    for x in xs { if *x > best { best = *x; } }
    Some(best)
}

// Generic over the associated type: T::Output is whatever T measures to,
// and the `where` clause says it can be printed.
fn show<T: Measured>(label: &str, x: &T)
    where
        T::Output: Display,
{
    let m: T::Output = x.measure();
    println("{label:<10} {m}");
}

fn main(gpa: Gpa) -> i32 {
    println("== vectors (operators, derive)");
    let a = Vec2::new(3, 4);
    let b = Vec2::new(-1, 2);
    println("a + b = {}, a - b = {}, -a = {}", a + b, a - b, -a);
    println("a.dot(b) = {}, |a| = {}, a == b: {}, a > b: {}", a.dot(b), a.length(), a == b, a > b);
    println("debug: {a:?}");
    let turn = ROTATE_90 * ROTATE_90; // * on Mat2: composition
    println("rotate a by 90: {}, by 180: {}", ROTATE_90.apply(a), turn.apply(a));
    println("rotating twice is a half turn: {}, {turn:?}", turn == HALF_TURN);

    println("== sorting and hashing (derive(Ord, Hash))");
    let at = Vec2::new; // a function as a value
    let mut points = [at(2, 1), at(0, 5), at(2, 0), at(0, 5), at(-3, 3)];
    points.sort_unstable(); // by x, then y: the field order
    print("sorted:");
    for p in points { print(" {p}"); }
    println("");
    let mut seen: HashMap<Vec2, i64, Gpa> = HashMap::new_in(gpa);
    for p in points { *seen.entry(p).or_insert(0) += 1; }
    println("distinct: {}, (0, 5) seen {} times", seen.len(),
        seen.get(&Vec2::new(0, 5)).copied().unwrap_or(0));
    let nothing: [i64; 0] = [];
    println("largest point: {:?}, of nothing: {:?}", largest(&points), largest(&nothing));

    println("== shapes (a trait, defaults, generics)");
    let circle = Circle { center: Vec2::new(0, 0), r: 2 };
    let rect = Rect { min: Vec2::new(0, 0), max: Vec2::new(4, 3) };
    let mut triangle = Polygon { points: Vec::new_in(gpa) };
    for p in [Vec2::new(0, 0), Vec2::new(4, 0), Vec2::new(0, 3)] { triangle.points.push(p); }
    circle.describe();
    rect.describe();
    triangle.describe(); // Polygon keeps the default name, "shape"

    let rects = [rect, Rect { min: Vec2::new(1, 1), max: Vec2::new(2, 3) }];
    println("total area of the rects: {:.2}", total_area(&rects));
    let shapes: [AnyShape<Gpa>; 3] = [AnyShape::C(circle), AnyShape::R(rect),
        AnyShape::P(triangle.clone())];
    println("total area of everything: {:.2}", total_area(&shapes));

    // Clone of a struct with a Vec field copies the Vec (derive(Clone)).
    let mut bigger = triangle.clone();
    bigger.points[1] = Vec2::new(8, 0);
    println("stretched clone: area {:.1}, the original: {:.1}", bigger.area(), triangle.area());
    println("{bigger:?}");

    println("== units (From, Into, an associated type)");
    let run = Meters { m: 5000.0 };
    let tower = Feet { ft: 1063.0 };
    let tower_m: Meters = tower.into();
    let run_ft = Feet::from(run);
    println("{run} is {run_ft}; {tower} is {tower_m}");
    let limit = Meters { m: 300.0 };
    println("taller than {limit}? {}", tower_m > limit);
    println("difference: {}, negated: {}", run - tower_m, -(run - tower_m));
    let laps = [Feet { ft: 1312.34 }, Feet { ft: 656.17 }];
    println("two laps: {}, in metres already: {}", total(&laps), total(&[run, tower_m]));
    let diagonal = Segment { a: rect.min, b: rect.max };
    show("diagonal", &diagonal); // Segment::Output is Meters
    show("rect", &rect); // Rect::Output is SquareMeters
    0
}
