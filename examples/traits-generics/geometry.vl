// EDITION: rust
// Points, a 2x2 matrix, shapes, and two traits over them.
use std::alloc::Allocator;
use std::fmt::{Display, Formatter, self};
use std::ops::{Add, Mul, Neg, Sub};

use crate::units::{Meters, SquareMeters};

// UNSAFE: sqrt is C's (libm): the block declares a foreign function.
// SAFETY: the declaration is math.h's: a double in, a double out.
extern "C" {
    fn sqrt(x: f64) -> f64;
}

pub const PI: f64 = 3.141592653589793;

// A safe wrapper.
pub fn square_root(x: f64) -> f64 {
    // UNSAFE: sqrt is C's.
    // SAFETY: sqrt of any f64 is defined (NaN for a negative).
    unsafe { sqrt(x) }
}

// derive writes == (PartialEq, Eq), < (PartialOrd, Ord: x, then y),
// hashing (a HashMap key), {:?} (Debug) and .clone(); Copy makes a
// Vec2 a plain value, copied where it is used.
#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Clone, Copy)]
pub struct Vec2 { pub x: i64, pub y: i64 }

impl Vec2 {
    pub fn new(x: i64, y: i64) -> Vec2 { Vec2 { x, y } }
    pub fn dot(self, o: Vec2) -> i64 { self.x * o.x + self.y * o.y }
    pub fn cross(self, o: Vec2) -> i64 { self.x * o.y - self.y * o.x }
    pub fn length(self) -> f64 { square_root(self.dot(self) as f64) }
}

impl Add for Vec2 {
    type Output = Vec2;
    fn add(self, o: Vec2) -> Vec2 { Vec2 { x: self.x + o.x, y: self.y + o.y } }
}

impl Sub for Vec2 {
    type Output = Vec2;
    fn sub(self, o: Vec2) -> Vec2 { Vec2 { x: self.x - o.x, y: self.y - o.y } }
}

impl Neg for Vec2 {
    type Output = Vec2;
    fn neg(self) -> Vec2 { Vec2 { x: -self.x, y: -self.y } }
}

impl Display for Vec2 {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { write(f, "({}, {})", self.x, self.y) }
}

// A linear map of the plane. `*` composes two maps: (a * b).apply(p) is
// a.apply(b.apply(p)).
#[derive(PartialEq, Eq, Debug, Clone, Copy)]
pub struct Mat2 { pub a: i64, pub b: i64, pub c: i64, pub d: i64 }

pub const ROTATE_90: Mat2 = Mat2 { a: 0, b: -1, c: 1, d: 0 };
pub const HALF_TURN: Mat2 = Mat2 { a: -1, b: 0, c: 0, d: -1 };

impl Mat2 {
    pub fn apply(self, p: Vec2) -> Vec2 {
        Vec2 { x: self.a * p.x + self.b * p.y, y: self.c * p.x + self.d * p.y }
    }
}

impl Mul for Mat2 {
    type Output = Mat2;

    fn mul(self, o: Mat2) -> Mat2 {
        Mat2 {
            a: self.a * o.a + self.b * o.c,
            b: self.a * o.b + self.b * o.d,
            c: self.c * o.a + self.d * o.c,
            d: self.c * o.b + self.d * o.d,
        }
    }
}

// ---- Shapes ----

// What every shape can do. `name` and `describe` have default bodies:
// an impl may keep them or write its own.
pub trait Shape {
    fn area(&self) -> f64;
    fn perimeter(&self) -> f64;
    fn name(&self) -> &'static str { "shape" }

    fn describe(&self) {
        println("{:<8} area {:>7.2}  perimeter {:>6.2}", self.name(), self.area(),
            self.perimeter());
    }
}

pub struct Circle { pub center: Vec2, pub r: i64 }

#[derive(Clone, Copy)]
pub struct Rect { pub min: Vec2, pub max: Vec2 }

#[derive(Debug, Clone)]
pub struct Polygon<A: Allocator> { pub points: Vec<Vec2, A> }

impl Shape for Circle {
    fn area(&self) -> f64 { PI * (self.r * self.r) as f64 }
    fn perimeter(&self) -> f64 { 2.0 * PI * self.r as f64 }
    fn name(&self) -> &'static str { "circle" }
}

impl Shape for Rect {
    fn area(&self) -> f64 {
        let d = self.max - self.min;
        (d.x * d.y) as f64
    }

    fn perimeter(&self) -> f64 {
        let d = self.max - self.min;
        (2 * (d.x + d.y)) as f64
    }

    // overrides the default `name`
    fn name(&self) -> &'static str { "rect" }
}

impl<A: Allocator> Polygon<A> {
    // The polygon's edges, in order, each from a vertex to the next.
    pub fn edges(&self) -> Edges<'_> { Edges { points: &self.points, i: 0 } }
}

impl<A: Allocator> Shape for Polygon<A> {
    // The shoelace formula: half the sum of the edges' cross products.
    fn area(&self) -> f64 {
        let mut twice = 0;
        for (a, b) in self.edges() { twice += a.cross(b); }
        twice.abs() as f64 / 2.0
    }

    fn perimeter(&self) -> f64 {
        let mut sum = 0.0;
        for (a, b) in self.edges() { sum += (b - a).length(); }
        sum
    }
    // `name` is left out: Polygon gets the trait's default, "shape".
}

// An iterator of our own, over a borrowed slice of points: its
// associated type `Item` is a pair of points.
pub struct Edges<'a> { points: &'a [Vec2], i: usize }

impl<'a> Iterator for Edges<'a> {
    type Item = (Vec2, Vec2);

    fn next(&mut self) -> Option<(Vec2, Vec2)> {
        let n = self.points.len();
        if self.i >= n { return None; }
        let edge = (self.points[self.i], self.points[(self.i + 1) % n]);
        self.i += 1;
        Some(edge)
    }
}

// No trait objects: a list of mixed shapes is an enum of the cases, and
// the enum implements the trait by dispatching with match.
pub enum AnyShape<A: Allocator> { C(Circle), R(Rect), P(Polygon<A>) }

impl<A: Allocator> Shape for AnyShape<A> {
    fn area(&self) -> f64 {
        match self {
            AnyShape::C(c) => c.area(),
            AnyShape::R(r) => r.area(),
            AnyShape::P(p) => p.area(),
        }
    }

    fn perimeter(&self) -> f64 {
        match self {
            AnyShape::C(c) => c.perimeter(),
            AnyShape::R(r) => r.perimeter(),
            AnyShape::P(p) => p.perimeter(),
        }
    }

    fn name(&self) -> &'static str {
        match self {
            AnyShape::C(c) => c.name(),
            AnyShape::R(r) => r.name(),
            AnyShape::P(p) => p.name(),
        }
    }
}

// ---- Measuring: a trait with an associated type ----

// What `measure` returns depends on the implementing type: a segment
// has a length, a rectangle an area.
pub trait Measured {
    type Output;
    fn measure(&self) -> Self::Output;
}

pub struct Segment { pub a: Vec2, pub b: Vec2 }

impl Measured for Segment {
    type Output = Meters;
    fn measure(&self) -> Meters { Meters { m: (self.b - self.a).length() } }
}

impl Measured for Rect {
    type Output = SquareMeters;
    fn measure(&self) -> SquareMeters { SquareMeters { m2: self.area() } }
}
