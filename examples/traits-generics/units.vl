// Units of length: one struct per unit, so a value in feet cannot be
// added to one in metres by mistake. `From` converts, operator traits
// give + - and unary -, `PartialOrd` gives < and >.
use std::cmp::Ordering;
use std::fmt::{Display, Formatter, self};
use std::ops::{Add, Neg, Sub};

#[derive(Clone, Copy)]
pub struct Meters { pub m: f64 }

#[derive(Clone, Copy)]
pub struct Feet { pub ft: f64 }

const FEET_PER_METER: f64 = 3.28084;

impl From<Feet> for Meters {
    fn from(f: Feet) -> Meters { Meters { m: f.ft / FEET_PER_METER } }
}

impl From<Meters> for Feet {
    fn from(m: Meters) -> Feet { Feet { ft: m.m * FEET_PER_METER } }
}

impl Add for Meters {
    type Output = Meters;
    fn add(self, o: Meters) -> Meters { Meters { m: self.m + o.m } }
}

impl Sub for Meters {
    type Output = Meters;
    fn sub(self, o: Meters) -> Meters { Meters { m: self.m - o.m } }
}

impl Neg for Meters {
    type Output = Meters;
    fn neg(self) -> Meters { Meters { m: -self.m } }
}

// Floats have no total order (NaN compares with nothing), so a length
// has PartialOrd, not Ord: partial_cmp returns an Option, and == and
// < <= > >= follow from the two impls.
impl PartialEq for Meters {
    fn eq(&self, o: &Meters) -> bool { self.m == o.m }
}

impl PartialOrd for Meters {
    fn partial_cmp(&self, o: &Meters) -> Option<Ordering> { self.m.partial_cmp(&o.m) }
}

impl Display for Meters {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { write(f, "{:.2} m", self.m) }
}

impl Display for Feet {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { write(f, "{:.2} ft", self.ft) }
}

// An area: what a length times a length is.
pub struct SquareMeters { pub m2: f64 }

impl Display for SquareMeters {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { write(f, "{:.2} m2", self.m2) }
}

// Any length given in a unit that converts to metres: `T: Into<Meters>`
// holds for every T with `impl From<T> for Meters` (Meters itself too).
// `Copy` lets the loop take each length out of the slice.
pub fn total<T: Into<Meters> + Copy>(lengths: &[T]) -> Meters {
    let mut sum = Meters { m: 0.0 };
    for x in lengths {
        let m: Meters = (*x).into(); // Into needs the target type: here, the let's
        sum = sum + m;
    }
    sum
}
