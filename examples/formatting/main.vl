// EDITION: rust
// Formatting: format strings and their specs, Display and Debug written
// by hand and derived, and the ways to send formatted text somewhere:
// println, eprintln (stderr), format_in (a new String), write (append).
// The program prints a small inventory report.
use std::fmt::{Debug, Display, Formatter, Write, self};

// ---- Types that format themselves ----

// Money in cents. Display by hand: "$1,234.50", "-$3.05".
struct Money { cents: i64 }

impl Display for Money {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        // The text first, in a buffer on the stack, so that `f.pad` can
        // apply the width and alignment of the spec (`{value:>12}`).
        let mut text = Text { buf: [0; 32], len: 0 };
        let mut c = self.cents;
        if c < 0 {
            text.write_char('-')?;
            c = -c;
        }
        text.write_char('$')?;
        // the dollars, with a comma every three digits
        let dollars = c / 100;
        let mut group = 1;
        while group * 1000 <= dollars { group *= 1000; }
        write(&mut text, "{}", dollars / group)?;
        while group > 1 {
            group /= 1000;
            write(&mut text, ",{:03}", dollars / group % 1000)?;
        }
        write(&mut text, ".{:02}", c % 100)?;
        f.pad(text.as_str())
    }
}

// Formatted text without an allocator: a type with `write_str` takes
// `write(&mut w, "..", args)`.
struct Text { buf: [u8; 32], len: usize }

impl Write for Text {
    fn write_str(&mut self, s: &str) -> fmt::Result {
        let b = s.as_bytes();
        if self.len + b.len() > self.buf.len() { return Err(fmt::Error); }
        self.buf[self.len..self.len + b.len()].copy_from_slice(b);
        self.len += b.len();
        Ok(())
    }
}

impl Text {
    fn as_str(&self) -> &str { std::str::from_utf8(&self.buf[..self.len]).unwrap_or("") }
}

// Debug is for programmers: the raw value.
impl Debug for Money {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { write(f, "Money({})", self.cents) }
}

// A stock-keeping number: Display "#42", Debug "SKU-0042".
struct Sku { id: i64 }

impl Display for Sku {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut text = Text { buf: [0; 32], len: 0 };
        write(&mut text, "#{}", self.id)?;
        f.pad(text.as_str())
    }
}

impl Debug for Sku {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { write(f, "SKU-{:04}", self.id) }
}

// derive(Debug) writes Rust's text for these, using the impls above for
// the Sku and Money fields.
#[derive(Debug)]
enum Category { Tools, Food(i64), Toys }

#[derive(Debug)]
struct Item { sku: Sku, name: &'static str, category: Category, qty: i64, price: Money }

fn item(id: i64, name: &'static str, category: Category, qty: i64, cents: i64) -> Item {
    Item { sku: Sku { id }, name, category, qty, price: Money { cents } }
}

// ---- The sections of the report ----

// One line of the spec table: the spec as written, what it printed (a
// String from `format_in`, dropped when `row` returns), and a note.
fn row(spec: &str, shown: String<Gpa>, note: &str, gpa: Gpa) {
    let cell = format_in("[{shown}]", gpa);
    println("{spec:<13} {cell:<12} {note}");
}

fn specs(gpa: Gpa) {
    println("== format specs");
    let n = 42;
    let x = 3.14159;
    let name = "vole";
    row("{n}", format_in("{n}", gpa), "Display", gpa);
    row("{n:>8}", format_in("{n:>8}", gpa), "right-aligned: the default for numbers", gpa);
    row("{n:<8}", format_in("{n:<8}", gpa), "left-aligned", gpa);
    row("{n:08}", format_in("{n:08}", gpa), "zero-padded", gpa);
    row("{n:x} {n:X}", format_in("{n:x} {n:X}", gpa), "hex", gpa);
    row("{n:08b}", format_in("{n:08b}", gpa), "binary, zero-padded", gpa);
    row("{x}", format_in("{x}", gpa), "the shortest text that reads back", gpa);
    row("{x:.2}", format_in("{x:.2}", gpa), "two decimals", gpa);
    row("{x:>9.3}", format_in("{x:>9.3}", gpa), "width and precision", gpa);
    row("{name:>9}", format_in("{name:>9}", gpa), "text goes left by default", gpa);
    row("{name:?}", format_in("{name:?}", gpa), "Debug: quoted and escaped", gpa);
    row("{}, 'A'", format_in("{}", 'A', gpa), "a char", gpa);
    row("{}, n * 2 + 1", format_in("{}", n * 2 + 1, gpa), "the next argument", gpa);
    println("{{{{ and }}}} in a format string are literal braces: {{n}}");
}

fn table(items: &[Item], gpa: Gpa) {
    println("== inventory");
    println("{:<6} {:<16} {:>5} {:>10} {:>12}", "sku", "item", "qty", "price", "value");
    let rule = "-".repeat_in(53, gpa);
    println("{rule}");
    let mut total = Money { cents: 0 };
    for it in items {
        let value = Money { cents: it.price.cents * it.qty };
        total.cents += value.cents;
        // A width applies to our own Display too: Money is right-aligned.
        println("{:<6} {:<16} {:>5} {:>10} {value:>12}", it.sku, it.name, it.qty, it.price);
    }
    println("{rule}");
    println("{:<40} {total:>12}", "total");
}

fn debug_views(items: &[Item], gpa: Gpa) {
    println("== debug");
    println("{:?}", items[0]);
    println("{:?} {:?} {:?}", items[2].category, items[2].sku, items[2].price);
    let quantities: Vec<i64, Gpa> = items.iter().map(|it| it.qty).collect_in(gpa);
    println("{quantities:?} {:?} {:?}", quantities.last(), "tab\there");
}

fn hex_dump(bytes: &[u8], gpa: Gpa) {
    println("== hex dump");
    for (n, chunk) in bytes.chunks(8).enumerate() {
        let mut line = format_in("{:04x}  ", n * 8, gpa); // format_in: a new String to keep
        for i in 0..8usize {
            // write appends to a String; it cannot fail there
            if i < chunk.len() { write(&mut line, "{:02x} ", chunk[i]).unwrap(); }
            else { line.push_str("   "); }
        }
        line.push_str(" |");
        for b in chunk {
            line.push(if *b >= b' ' && *b <= b'~' { *b as char } else { '.' });
        }
        line.push('|');
        println("{line}");
    }
}

fn main(gpa: Gpa) -> i32 {
    let items = [
        item(7, "hammer", Category::Tools, 12, 1599),
        item(42, "socket set", Category::Tools, 3, 8950),
        item(108, "coffee beans", Category::Food(180), 40, 1275),
        item(9, "rubber duck", Category::Toys, 250, 199),
        item(1500, "workbench", Category::Tools, 2, 64900),
    ];
    specs(gpa);
    table(&items, gpa);
    debug_views(&items, gpa);
    hex_dump(b"vole formats\tbytes\n", gpa);

    // Warnings go to stderr: the report on stdout stays clean.
    for it in &items {
        if it.qty < 5 { eprintln("warning: {} ({:?}) is low: {} left", it.name, it.sku, it.qty); }
    }
    0
}
