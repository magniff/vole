// A calculator: reads lines of arithmetic from stdin and prints their
// values. A tokenizer and a recursive-descent parser over a slice of
// tokens, with enums, match, methods, slices, std's Vec, Results and `?`
// for the errors, and Display impls that turn them into messages.
use std::{fmt, io};

#[derive(Clone, Copy, PartialEq)]
enum Token { Num(i64), Plus, Minus, Star, Slash, Percent, Open, Close, End }
use Token::{Close, End, Minus, Num, Open, Percent, Plus, Slash, Star};

enum Error { BadChar(char), Unexpected(Token), DivideByZero }
use Error::{BadChar, DivideByZero, Unexpected};

// How a token is named in a message.
impl fmt::Display for Token {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        let name = match self {
            Num(_) => "a number",
            Plus => "'+'",
            Minus => "'-'",
            Star => "'*'",
            Slash => "'/'",
            Percent => "'%'",
            Open => "'('",
            Close => "')'",
            End => "the end",
        };
        f.write_str(name)
    }
}

impl fmt::Display for Error {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        match self {
            BadChar(c) => write(f, "unexpected character '{c}'"),
            Unexpected(t) => write(f, "unexpected {t}"),
            DivideByZero => f.write_str("division by zero"),
        }
    }
}

// The tokens of a line, ending with End; or the first character that is
// not part of one.
fn tokenize(text: &str, gpa: Gpa) -> Result<Vec<Token, Gpa>, Error> {
    let mut tokens: Vec<Token, Gpa> = Vec::new_in(gpa);
    let mut chars = text.chars().peekable();
    while let Some(c) = chars.next() {
        let token = match c {
            ' ' => continue,
            '0'..='9' => {
                let mut value = c.to_digit(10).unwrap() as i64;
                while let Some(d) = chars.peek().and_then(|c| c.to_digit(10)) {
                    value = value * 10 + d as i64;
                    chars.next();
                }
                Num(value)
            }
            '+' => Plus,
            '-' => Minus,
            '*' => Star,
            '/' => Slash,
            '%' => Percent,
            '(' => Open,
            ')' => Close,
            _ => return Err(BadChar(c)),
        };
        tokens.push(token);
    }
    tokens.push(End);
    Ok(tokens)
}

// Each rule returns the value of what it parsed, or the first error: `?`
// passes an Err up through every caller at once.
struct Parser<'a> { tokens: &'a [Token], at: usize }

impl Parser<'_> {
    fn peek(&self) -> Token {
        self.tokens[self.at]
    }

    // sum: term (('+' | '-') term)*
    fn sum(&mut self) -> Result<i64, Error> {
        let mut value = self.term()?;
        loop {
            match self.peek() {
                Plus => {
                    self.at += 1;
                    value += self.term()?;
                }
                Minus => {
                    self.at += 1;
                    value -= self.term()?;
                }
                _ => return Ok(value),
            }
        }
    }

    // term: unary (('*' | '/' | '%') unary)*
    fn term(&mut self) -> Result<i64, Error> {
        let mut value = self.unary()?;
        loop {
            let op = self.peek();
            match op {
                Star | Slash | Percent => {
                    self.at += 1;
                    let rhs = self.unary()?;
                    value = match op {
                        Star => value * rhs,
                        _ if rhs == 0 => return Err(DivideByZero),
                        Slash => value / rhs,
                        _ => value % rhs,
                    };
                }
                _ => return Ok(value),
            }
        }
    }

    // unary: '-' unary | number | '(' sum ')'
    fn unary(&mut self) -> Result<i64, Error> {
        let t = self.peek();
        match t {
            Minus => {
                self.at += 1;
                Ok(-self.unary()?)
            }
            Num(n) => {
                self.at += 1;
                Ok(n)
            }
            Open => {
                self.at += 1;
                let value = self.sum()?;
                if self.peek() != Close {
                    return Err(Unexpected(self.peek()));
                }
                self.at += 1;
                Ok(value)
            }
            other => Err(Unexpected(other)),
        }
    }
}

// A whole line: one sum, then nothing more.
fn evaluate(line: &str, gpa: Gpa) -> Result<i64, Error> {
    let tokens = tokenize(line, gpa)?;
    let mut parser = Parser { tokens: &tokens, at: 0 };
    let value = parser.sum()?;
    match parser.peek() {
        End => Ok(value),
        rest => Err(Unexpected(rest)),
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut line = String::new_in(gpa);
    // read_line appends a line, its '\n' included: 0 bytes is the end.
    while io::stdin().read_line(&mut line).unwrap_or(0) > 0 {
        let text = line.trim();
        if !text.is_empty() {
            match evaluate(text, gpa) {
                Ok(value) => println("{value}"),
                Err(e) => println("error: {e}"),
            }
        }
        line.clear();
    }
    0
}
