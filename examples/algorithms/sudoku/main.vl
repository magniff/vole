// A sudoku solver: backtracking over bitmasks, always filling the cell
// with the fewest candidates first.
//
// Each row, column and box keeps a 9-bit mask of the digits it holds; a
// cell's candidates are the digits in none of its three masks, one OR
// and one NOT. The search picks the empty cell with the fewest
// candidates (a forced cell has one: no guess at all), tries each, and
// undoes the move when the rest fails. It keeps going after the first
// solution to prove there is no second one.
//
//     volec examples/algorithms/sudoku/main.vl -o sudoku && ./sudoku
//
// It solves a few well-known hard puzzles, shows one parse error, then
// solves 70 variants of them (digits relabelled, rows and columns
// shuffled: the same puzzle to the solver, different to a cache) and
// prints a checksum; the time goes to stderr.

import "time.h" as c;

// ----------------------------------------------------------------- grid

// The 81 cells, row by row (0: empty), and the digits used by each row,
// column and box, as bit d - 1 of a mask. A plain value: copied where
// it is assigned or passed (Copy).
#[derive(Clone, Copy)]
struct Sudoku { cells: [u8; 81], rows: [u64; 9], cols: [u64; 9], boxes: [u64; 9] }

// What is wrong with a puzzle's text: its length; the byte at an index;
// the digit at an index, already in its row, column or box.
#[derive(Debug)]
enum ParseError { Length(usize), BadChar(usize, u8), Conflict(usize, u8) }

const ALL: u64 = 0x1ff;

fn box_of(i: usize) -> usize { (i / 27) * 3 + (i % 9) / 3 }

impl Sudoku {
    fn empty() -> Sudoku { Sudoku { cells: [0; 81], rows: [0; 9], cols: [0; 9], boxes: [0; 9] } }

    // 81 characters, row by row: '1' to '9', or '.' or '0' for an empty
    // cell. Two equal digits in a row, column or box are an error too.
    fn parse(text: &str) -> Result<Sudoku, ParseError> {
        if text.len() != 81 { return Err(ParseError::Length(text.len())); }
        let mut s = Sudoku::empty();
        for (i, b) in text.bytes().enumerate() {
            if b == b'.' || b == b'0' { continue; }
            if b < b'1' || b > b'9' { return Err(ParseError::BadChar(i, b)); }
            let d = b - b'0';
            if s.candidates(i) & (1u64 << (d - 1)) == 0 {
                return Err(ParseError::Conflict(i, d));
            }
            s.place(i, d);
        }
        Ok(s)
    }

    fn candidates(&self, i: usize) -> u64 {
        ALL & !(self.rows[i / 9] | self.cols[i % 9] | self.boxes[box_of(i)])
    }

    fn place(&mut self, i: usize, d: u8) {
        let bit = 1u64 << (d - 1);
        self.cells[i] = d;
        self.rows[i / 9] |= bit;
        self.cols[i % 9] |= bit;
        self.boxes[box_of(i)] |= bit;
    }

    fn clear(&mut self, i: usize) {
        let bit = !(1u64 << (self.cells[i] - 1));
        self.cells[i] = 0;
        self.rows[i / 9] &= bit;
        self.cols[i % 9] &= bit;
        self.boxes[box_of(i)] &= bit;
    }

    fn clues(&self) -> usize { self.cells.iter().filter(|d| **d != 0).count() }

    // Row r as nine ASCII bytes.
    fn row_text(&self, r: usize) -> [u8; 9] {
        let mut t = [0u8; 9];
        for k in 0..9 {
            let d = self.cells[r * 9 + k];
            t[k] = if d == 0 { b'.' } else { b'0' + d };
        }
        t
    }
}

// ---------------------------------------------------------------- solve

// The search's state: the grid it fills, the first solution it found,
// how many it found (it stops at `limit`), and the nodes it visited.
struct Search { grid: Sudoku, first: Sudoku, found: i64, limit: i64, nodes: i64 }

impl Search {
    // Searches until `limit` solutions are found: 2 tells whether the
    // first one is the only one.
    fn run(puzzle: Sudoku, limit: i64) -> Search {
        let mut s = Search { grid: puzzle, first: puzzle, found: 0, limit, nodes: 0 };
        s.fill();
        s
    }

    fn fill(&mut self) {
        self.nodes += 1;
        // The empty cell with the fewest candidates, and their mask.
        let mut best: Option<(usize, u64)> = None;
        let mut best_count = 10;
        for i in 0..81usize {
            if self.grid.cells[i] != 0 { continue; }
            let m = self.grid.candidates(i);
            let n = m.count_ones();
            if n < best_count {
                best = Some((i, m));
                best_count = n;
                if n <= 1 { break; } // dead end, or forced
            }
        }
        let Some((cell, mask)) = best else { // no empty cell: a solution
            if self.found == 0 { self.first = self.grid; }
            self.found += 1;
            return;
        };
        let mut m = mask;
        while m != 0 && self.found < self.limit {
            let bit = m & m.wrapping_neg();
            m ^= bit;
            self.grid.place(cell, (bit - 1).count_ones() as u8 + 1);
            self.fill();
            self.grid.clear(cell);
        }
    }
}

// ------------------------------------------------------------ variants

// xorshift64*: a small, fast, seeded generator.
struct Rng { state: u64 }

impl Rng {
    fn next(&mut self) -> u64 {
        let mut x = self.state;
        x ^= x >> 12;
        x ^= x << 25;
        x ^= x >> 27;
        self.state = x;
        x.wrapping_mul(0x2545F4914F6CDD1D)
    }

    fn below(&mut self, n: usize) -> usize { ((self.next() >> 33) % (n as u64)) as usize }

    // A random order of 0..n into p (Fisher-Yates).
    fn shuffle(&mut self, p: &mut [usize]) {
        for i in 0..p.len() { p[i] = i; }
        for i in 1..p.len() {
            let j = self.below(i + 1);
            p.swap(i, j);
        }
    }
}

// The same puzzle in disguise: digits relabelled, the bands (groups of
// three rows) and the rows inside each band shuffled, the same for the
// columns. Every solution maps to a solution, so the difficulty is kept.
fn disguise(p: &Sudoku, rng: &mut Rng) -> Sudoku {
    let mut digits = [0usize; 9];
    rng.shuffle(&mut digits);
    let mut row_of = [0usize; 9];
    let mut col_of = [0usize; 9];
    shuffle_lines(rng, &mut row_of);
    shuffle_lines(rng, &mut col_of);
    let mut out = Sudoku::empty();
    for r in 0..9usize {
        for c in 0..9usize {
            let d = p.cells[row_of[r] * 9 + col_of[c]];
            if d != 0 { out.place(r * 9 + c, (digits[d as usize - 1] + 1) as u8); }
        }
    }
    out
}

// A random order of the nine rows (or columns) into `line_of` that keeps
// each band together: the bands shuffled, and the three lines inside each.
fn shuffle_lines(rng: &mut Rng, line_of: &mut [usize]) {
    let mut bands = [0usize; 3];
    rng.shuffle(&mut bands);
    for b in 0..3 {
        let mut inner = [0usize; 3];
        rng.shuffle(&mut inner);
        for k in 0..3 { line_of[b * 3 + k] = bands[b] * 3 + inner[k]; }
    }
}

// --------------------------------------------------------------- main

fn now_ns() -> i64 {
    let mut ts = c::timespec { tv_sec: 0, tv_nsec: 0 };
    // UNSAFE: timespec_get is C's, and writes through a pointer.
    // SAFETY: `&mut ts` is a whole timespec, borrowed for the call.
    unsafe { c::timespec_get(&mut ts, c::TIME_UTC); }
    ts.tv_sec * 1_000_000_000 + ts.tv_nsec
}

// Nine ASCII bytes as text.
fn ascii(row: &[u8; 9]) -> &str {
    std::str::from_utf8(&row[..]).unwrap_or("?")
}

const PUZZLES: [&str; 7] = [
    "8..........36......7..9.2...5...7.......457.....1...3...1....68..85...1..9....4..",
    "4.....8.5.3..........7......2.....6.....8.4......1.......6.3.7.5..2.....1.4......",
    "52...6.........7.13...........4..8..6......5...........418.........3..2...87.....",
    "6.....8.3.4.7.................5.4.7.3..2.....1.6.......2.....5.....8.6......1....",
    "48.3............71.2.......7.5....6....2..8.............1.76...3.....4......5....",
    "....14....3....2...7..........9...3.6.1.............8.2.....1.4....5.6.....7.8...",
    "53..7....6..195....98....6.8...6...34..8.3..17...2...6.6....28....419..5....8..79",
];

fn main(gpa: Gpa) -> i32 {
    let first = Sudoku::parse(PUZZLES[0]).unwrap();
    let s = Search::run(first, 2);
    println("puzzle        solution");
    for r in 0..9 {
        let (puzzle, solution) = (first.row_text(r), s.first.row_text(r));
        println("{}     {}", ascii(&puzzle), ascii(&solution));
    }
    println("");
    println("#  clues   nodes  unique");
    let mut puzzles: Vec<Sudoku, Gpa> = Vec::new_in(gpa);
    for (k, text) in PUZZLES.iter().enumerate() {
        let p = Sudoku::parse(text).unwrap();
        let s = Search::run(p, 2);
        println("{k}  {:>5} {:>7}  {}", p.clues(), s.nodes,
            if s.found == 1 { "yes" } else { "no" });
        puzzles.push(p);
    }
    let broken = "53..7....6..195....98....6.8...6...34..8.3..17...2...6.6....28....419..5....8..78";
    match Sudoku::parse(broken) {
        Ok(_) => println("parsed?"),
        Err(e) => println("a broken puzzle: {e:?}"),
    }

    let count = 70;
    let mut rng = Rng { state: 2026 };
    let mut checksum = 0u64;
    let mut nodes = 0;
    let t0 = now_ns();
    for k in 0..count {
        let p = disguise(&puzzles[k % puzzles.len()], &mut rng);
        let s = Search::run(p, 1);
        nodes += s.nodes;
        for d in s.first.cells { checksum = checksum.wrapping_mul(31).wrapping_add(d as u64); }
    }
    let t1 = now_ns();
    println("{count} disguised puzzles: {nodes} nodes, checksum {checksum:x}");
    eprintln("sudoku: {count} puzzles in {} ms", (t1 - t0) / 1_000_000);
    0
}
