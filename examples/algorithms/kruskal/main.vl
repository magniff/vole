// EDITION: rust
// Kruskal's minimum spanning tree with a union-find, on a generated graph.
//
// The edges are sorted by weight and taken in that order, each one that
// joins two different components; a disjoint-set forest (union by size,
// path halving) tells whether two nodes are already connected in almost
// constant time. The result is a minimum spanning forest: a tree for each
// connected component.
//
//     volec examples/algorithms/kruskal/main.vl -o kruskal && ./kruskal
//
// A small named graph is solved and printed first; then a random one of
// 200,000 nodes and 1,000,000 edges, its results on stdout and the time
// on stderr.

import "time.h" as c;

use std::alloc::Allocator;

// ---------------------------------------------------------------- input

// xorshift64*: a small, fast, seeded generator of 64-bit values.
struct Rng { state: u64 }

impl Rng {
    fn new(seed: u64) -> Rng { Rng { state: seed | 1 } }

    fn next(&mut self) -> u64 {
        let mut x = self.state;
        x ^= x >> 12;
        x ^= x << 25;
        x ^= x >> 27;
        self.state = x;
        x.wrapping_mul(0x2545F4914F6CDD1D)
    }

    // A value in 0..n.
    fn below(&mut self, n: i64) -> i64 { ((self.next() >> 33) % (n as u64)) as i64 }
}

// An undirected edge. The derived Ord compares the fields in order, so
// sorting edges sorts them by weight (ties by u, then v: deterministic).
#[derive(PartialEq, Eq, PartialOrd, Ord, Debug, Clone, Copy)]
struct Edge { w: i64, u: i32, v: i32 }

const MAX_WEIGHT: i64 = 1_000_000;

// m random edges between n nodes, weights 1 to MAX_WEIGHT.
fn random_edges(n: i64, m: i64, seed: u64, gpa: Gpa) -> Vec<Edge, Gpa> {
    let mut rng = Rng::new(seed);
    let mut edges: Vec<Edge, Gpa> = Vec::with_capacity_in(m as usize, gpa);
    for _ in 0..m {
        let u = rng.below(n) as i32;
        let v = rng.below(n) as i32;
        let w = 1 + rng.below(MAX_WEIGHT);
        edges.push(Edge { w, u, v });
    }
    edges
}

// ----------------------------------------------------------- union-find

// A disjoint-set forest: parent[x] is x for a root, else a node closer to
// it; size[r] is the number of nodes under root r.
struct UnionFind<A: Allocator> { parent: Vec<i32, A>, size: Vec<i32, A>, sets: i64 }

impl UnionFind<Gpa> {
    fn new(n: i64, gpa: Gpa) -> UnionFind<Gpa> {
        let parent = (0..n).map(|i| i as i32).collect_in(gpa);
        UnionFind { parent, size: Vec::from_elem_in(1i32, n as usize, gpa), sets: n }
    }

    // The root of x's set. Path halving: every node on the way is pointed
    // at its grandparent, so the trees stay nearly flat.
    fn find(&mut self, x: i64) -> i64 {
        let p = self.parent.as_mut_slice();
        let mut x = x;
        while p[x as usize] as i64 != x {
            let g = p[p[x as usize] as usize];
            p[x as usize] = g;
            x = g as i64;
        }
        x
    }

    // Joins the sets of a and b; false if they were one already. The
    // smaller tree goes under the larger one's root.
    fn unite(&mut self, a: i64, b: i64) -> bool {
        let (x, y) = (self.find(a), self.find(b));
        if x == y { return false; }
        let size = self.size.as_mut_slice();
        let (ra, rb) = if size[x as usize] < size[y as usize] { (y, x) } else { (x, y) };
        self.parent[rb as usize] = ra as i32;
        size[ra as usize] += size[rb as usize];
        self.sets -= 1;
        true
    }
}

// -------------------------------------------------------------- kruskal

// The edges of a minimum spanning forest of the n nodes, and how many
// trees it has. Sorts `edges` in place.
fn kruskal(n: i64, edges: &mut [Edge], gpa: Gpa) -> (Vec<Edge, Gpa>, i64) {
    edges.sort_unstable(); // equal edges are the same edge: no order to keep
    let mut uf = UnionFind::new(n, gpa);
    let mut tree: Vec<Edge, Gpa> = Vec::with_capacity_in(n as usize - 1, gpa);
    for e in edges.iter() {
        if uf.unite(e.u, e.v) {
            tree.push(*e);
            if tree.len() as i64 == n - 1 { break; } // spanning: no edge left can join
        }
    }
    (tree, uf.sets)
}

// --------------------------------------------------------------- output

fn now_ns() -> i64 {
    let mut ts = c::timespec { tv_sec: 0, tv_nsec: 0 };
    // UNSAFE: timespec_get is C's, and writes through a pointer.
    // SAFETY: `&mut ts` is a whole timespec, borrowed for the call.
    unsafe { c::timespec_get(&mut ts, c::TIME_UTC); }
    ts.tv_sec * 1_000_000_000 + ts.tv_nsec
}

fn main(gpa: Gpa) -> i32 {
    // A small graph: seven towns and the cost of a road between pairs.
    let names = ["A", "B", "C", "D", "E", "F", "G"];
    let mut roads = [
        Edge { w: 7, u: 0, v: 1 }, Edge { w: 5, u: 0, v: 3 }, Edge { w: 8, u: 1, v: 2 },
        Edge { w: 9, u: 1, v: 3 }, Edge { w: 7, u: 1, v: 4 }, Edge { w: 5, u: 2, v: 4 },
        Edge { w: 15, u: 3, v: 4 }, Edge { w: 6, u: 3, v: 5 }, Edge { w: 8, u: 4, v: 5 },
        Edge { w: 9, u: 4, v: 6 }, Edge { w: 11, u: 5, v: 6 },
    ];
    let (tree, trees) = kruskal(7, &mut roads, gpa);
    for e in &tree {
        println("{} - {}  {:>2}", names[e.u as usize], names[e.v as usize], e.w);
    }
    let cost: i64 = tree.iter().map(|e| e.w).sum();
    println("{} roads, cost {cost}, {trees} tree", tree.len());
    println("cheapest road: {:?}", tree[0]);

    // A big random graph, timed: 200,000 nodes, 1,000,000 edges.
    let n = 200_000;
    let mut edges = random_edges(n, 1_000_000, 7, gpa);
    let t0 = now_ns();
    let (forest, components) = kruskal(n, &mut edges, gpa);
    let t1 = now_ns();
    let weight: i64 = forest.iter().map(|e| e.w).sum();
    let heaviest = forest.iter().map(|e| e.w).max().unwrap();
    println("random graph: {n} nodes, {} edges", edges.len());
    println("spanning forest: {} edges, {components} components", forest.len());
    println("total weight {weight}, heaviest edge {heaviest}");
    eprintln("kruskal on {} edges: {} ms", edges.len(), (t1 - t0) / 1_000_000);
    0
}
