// EDITION: rust
// N-queens: count the ways to place n queens on an n x n board so that
// no two attack each other, with backtracking over bitmasks.
//
// Each row gets one queen. Three masks say which columns of the current
// row are attacked: by a queen above in the same column, on a diagonal
// going down-left, or on one going down-right. Going one row down shifts
// the diagonal masks by one bit, and the free squares of a row are one
// AND and one NOT: the whole search is a few integer instructions per
// node, no arrays.
//
//     volec examples/algorithms/nqueens/main.vl -o nqueens && ./nqueens
//
// It prints one solution for n = 8, then the counts for n = 1 to 14
// against the known values (OEIS A000170), and the time on stderr.

import "time.h" as c;

// ---------------------------------------------------------------- count

// The number of ways to complete a board whose rows above are placed:
// `cols` has a bit per occupied column, `left` and `right` a bit per
// column of this row attacked along a diagonal. `all` has the n low bits.
fn count(all: u64, cols: u64, left: u64, right: u64) -> i64 {
    if cols == all { return 1; }
    let mut free = all & !(cols | left | right);
    let mut total = 0;
    while free != 0 {
        let bit = free & free.wrapping_neg(); // the lowest free column
        free ^= bit;
        total += count(all, cols | bit, (left | bit) << 1, (right | bit) >> 1);
    }
    total
}

// All solutions on an n x n board. A board and its mirror image are
// different solutions, and the mirror of a queen in column j of the first
// row has it in column n - 1 - j: so count the first row's left half
// only, and double. For odd n, the middle column is its own mirror and is
// counted once.
fn solutions(n: i64) -> i64 {
    let all = (1u64 << n) - 1;
    let mut total = 0;
    for j in 0..n / 2 {
        let bit = 1u64 << j;
        total += count(all, bit, bit << 1, bit >> 1);
    }
    total *= 2;
    if n % 2 == 1 {
        let bit = 1u64 << (n / 2);
        total += count(all, bit, bit << 1, bit >> 1);
    }
    total
}

// ---------------------------------------------------------------- board

// The first solution in the search's order: `queens[r]` is the column of
// the queen of row r. The same masks; the recursion stops at the first
// complete board.
fn first(row: usize, cols: u64, left: u64, right: u64, queens: &mut [u32]) -> bool {
    let n = queens.len();
    if row == n { return true; }
    let all = (1u64 << n) - 1;
    let mut free = all & !(cols | left | right);
    while free != 0 {
        let bit = free & free.wrapping_neg();
        free ^= bit;
        queens[row] = bit.trailing_zeros();
        if first(row + 1, cols | bit, (left | bit) << 1, (right | bit) >> 1, queens) {
            return true;
        }
    }
    false
}

fn draw(queens: &[u32]) {
    for q in queens {
        for j in 0..queens.len() as u32 {
            print("{}", if j == *q { " Q" } else { " ." });
        }
        println("");
    }
}

// --------------------------------------------------------------- main

fn now_ns() -> i64 {
    let mut ts = c::timespec { tv_sec: 0, tv_nsec: 0 };
    // UNSAFE: timespec_get is C's, and writes through a pointer.
    // SAFETY: `&mut ts` is a whole timespec, borrowed for the call.
    unsafe { c::timespec_get(&mut ts, c::TIME_UTC); }
    ts.tv_sec * 1_000_000_000 + ts.tv_nsec
}

// The known counts, n = 1 to 14 (OEIS A000170).
const KNOWN: [i64; 14] = [1, 0, 0, 2, 10, 4, 40, 92, 352, 724, 2680, 14200, 73712, 365596];

fn main() -> i32 {
    let mut queens = [0u32; 8];
    if first(0, 0, 0, 0, &mut queens) {
        print("the first solution for n = 8, by row:");
        for q in queens { print(" {q}"); }
        println("");
        draw(&queens);
    }

    println(" n  solutions");
    let t0 = now_ns();
    let mut all_known = true;
    for n in 1..=14 {
        let found = solutions(n);
        let ok = found == KNOWN[n as usize - 1];
        all_known = all_known && ok;
        println("{n:>2} {found:>10}{}", if ok { "" } else { "  WRONG" });
    }
    let t1 = now_ns();
    println("{}", if all_known { "all match OEIS A000170" } else { "MISMATCH" });
    eprintln("n-queens 1..14: {} ms", (t1 - t0) / 1_000_000);
    if all_known { 0 } else { 1 }
}
