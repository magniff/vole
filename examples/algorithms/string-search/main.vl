// EDITION: rust
// String search: naive, Knuth-Morris-Pratt and Boyer-Moore-Horspool.
//
// Three ways to find every occurrence of a pattern in a text, overlapping
// ones included. The text is 16 MiB of pseudo-words over the letters a to
// h, from a seeded generator, so every run searches the same bytes; each
// pattern is counted by all three searchers, which must agree.
//
//     volec examples/algorithms/string-search/main.vl -o search && ./search
//
// A short demo prints KMP's failure table and the matches in a short
// text; then the big text's counts go to stdout and each searcher's time
// and throughput to stderr.

import "time.h" as c;

use std::alloc::Allocator;

// ---------------------------------------------------------------- input

// xorshift64*: a small, fast, seeded generator of 64-bit values.
struct Rng { state: u64 }

impl Rng {
    fn new(seed: u64) -> Rng { Rng { state: seed | 1 } }

    fn next(&mut self) -> u64 {
        let mut x = self.state;
        x ^= x >> 12;
        x ^= x << 25;
        x ^= x >> 27;
        self.state = x;
        x.wrapping_mul(0x2545F4914F6CDD1D)
    }

    // A value in lo..=hi.
    fn range(&mut self, lo: i64, hi: i64) -> i64 {
        lo + ((self.next() >> 33) % ((hi - lo + 1) as u64)) as i64
    }
}

// `size` bytes of words of 1 to 8 letters from 'a' to 'h', separated by
// single spaces.
fn generate_text(size: usize, seed: u64, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut rng = Rng::new(seed);
    let mut text: Vec<u8, Gpa> = Vec::with_capacity_in(size, gpa);
    while text.len() < size {
        let len = rng.range(1, 8);
        for _ in 0..len { text.push(b'a' + rng.range(0, 7) as u8); }
        text.push(b' ');
    }
    text.truncate(size);
    text
}

// ------------------------------------------------------------ searchers

// A searcher calls `found(i)` for every i where the pattern starts in
// the text, in increasing order. Generic over the callback, so counting
// and collecting positions are the same code, and the closure is inlined.
trait Searcher {
    fn each_match<F: FnMut(usize)>(&self, text: &[u8], found: F);

    fn count(&self, text: &[u8]) -> i64 {
        let mut n = 0;
        self.each_match(text, |_| { n += 1; });
        n
    }
}

// Tries every position: O(n * m) at worst, but on most texts the first
// byte already differs and it is O(n).
struct Naive<'a> { pat: &'a [u8] }

impl<'a> Searcher for Naive<'a> {
    fn each_match<F: FnMut(usize)>(&self, text: &[u8], mut found: F) {
        let pat = self.pat;
        let m = pat.len();
        let first = pat[0];
        for i in 0..text.len() - m + 1 {
            if text[i] == first && &text[i..i + m] == pat { found(i); }
        }
    }
}

// Knuth-Morris-Pratt: `fail[j]` is the length of the longest proper
// prefix of pat[..j + 1] that is also its suffix. After matching j bytes
// and failing, the search continues with fail[j - 1] bytes matched, so
// it never moves backwards in the text: O(n + m), whatever the input.
struct Kmp<'a, A: Allocator> { pat: &'a [u8], fail: Vec<usize, A> }

impl<'a> Kmp<'a, Gpa> {
    fn new(pat: &'a [u8], gpa: Gpa) -> Kmp<'a, Gpa> {
        let m = pat.len();
        let mut fail: Vec<usize, Gpa> = Vec::from_elem_in(0, m, gpa);
        let f = fail.as_mut_slice();
        let mut k: usize = 0; // the border of pat[..j]
        for j in 1..m {
            while k > 0 && pat[j] != pat[k] { k = f[k - 1]; }
            if pat[j] == pat[k] { k += 1; }
            f[j] = k;
        }
        Kmp { pat, fail }
    }
}

impl<'a, A: Allocator> Searcher for Kmp<'a, A> {
    fn each_match<F: FnMut(usize)>(&self, text: &[u8], mut found: F) {
        let pat = self.pat;
        let f = self.fail.as_slice();
        let m = pat.len();
        let mut k: usize = 0; // bytes of pat matched
        for i in 0..text.len() {
            let b = text[i];
            while k > 0 && b != pat[k] { k = f[k - 1]; }
            if b == pat[k] { k += 1; }
            if k == m {
                found(i + 1 - m);
                k = f[m - 1]; // overlapping matches too
            }
        }
    }
}

// Boyer-Moore-Horspool: compare the window's last byte first; when the
// window does not match, slide it so that this byte lines up with its
// last occurrence in the pattern (all of m when it has none). On a large
// alphabet it skips most of the text: O(n / m) at best, O(n * m) at
// worst.
struct Horspool<'a> { pat: &'a [u8], shift: [usize; 256] }

impl<'a> Horspool<'a> {
    fn new(pat: &'a [u8]) -> Horspool<'a> {
        let m = pat.len();
        let mut shift = [m; 256];
        for j in 0..m - 1 { shift[pat[j] as usize] = m - 1 - j; }
        Horspool { pat, shift }
    }
}

impl<'a> Searcher for Horspool<'a> {
    fn each_match<F: FnMut(usize)>(&self, text: &[u8], mut found: F) {
        let pat = self.pat;
        let m = pat.len();
        let last = pat[m - 1];
        let head = &pat[..m - 1];
        let mut i: usize = 0;
        while i + m <= text.len() {
            let b = text[i + m - 1];
            if b == last && &text[i..i + m - 1] == head { found(i); }
            i += self.shift[b as usize];
        }
    }
}

// --------------------------------------------------------------- output

fn now_ns() -> i64 {
    let mut ts = c::timespec { tv_sec: 0, tv_nsec: 0 };
    // UNSAFE: timespec_get is C's, and writes through a pointer.
    // SAFETY: `&mut ts` is a whole timespec, borrowed for the call.
    unsafe { c::timespec_get(&mut ts, c::TIME_UTC); }
    ts.tv_sec * 1_000_000_000 + ts.tv_nsec
}

// The demo: the failure table, and the matches of `pat` in `text`.
fn demo(pat: &str, text: &str, gpa: Gpa) {
    let kmp = Kmp::new(pat.as_bytes(), gpa);
    print("pattern  ");
    for c in pat.chars() { print(" {c}"); }
    print("\nfailure  ");
    for k in kmp.fail.iter() { print(" {k}"); }
    println("");
    let mut at: Vec<usize, Gpa> = Vec::new_in(gpa);
    kmp.each_match(text.as_bytes(), |i| at.push(i)); // the closure collects
    println("text      {text}");
    print("matches   ");
    let mut col: usize = 0;
    for i in at.iter() {
        for _ in col..*i { print(" "); }
        print("^");
        col = *i + 1;
    }
    println("\n{} matches at {at:?}", at.len());
}

// Counts the matches of one searcher, adding the time it took to `ns`.
fn timed<S: Searcher>(s: &S, text: &[u8], ns: &mut i64) -> i64 {
    let t0 = now_ns();
    let n = s.count(text);
    *ns += now_ns() - t0;
    n
}

fn main(gpa: Gpa) -> i32 {
    demo("abacab", "abacabacab abacab", gpa);
    println("");

    let size: usize = 16 << 20;
    let text = generate_text(size, 2026, gpa);
    let t = text.as_slice();
    let words = t.iter().filter(|b| **b == b' ').count();
    println("text: {size} bytes, {words} words, letters a-h");
    println("{:<12} {:>8}", "pattern", "matches");

    let patterns = ["bad", "face", "hhhh", "a bad", "decade", "cabbage"];
    let mut times = [0i64; 3];
    for pat in patterns {
        let bytes = pat.as_bytes();
        let naive = Naive { pat: bytes };
        let kmp = Kmp::new(bytes, gpa);
        let horspool = Horspool::new(bytes);
        let counts = [
            timed(&naive, t, &mut times[0]),
            timed(&kmp, t, &mut times[1]),
            timed(&horspool, t, &mut times[2]),
        ];
        let agree = counts[1] == counts[0] && counts[2] == counts[0];
        println("{pat:<12} {:>8}{}", counts[0], if agree { "" } else { "  MISMATCH" });
        if !agree { return 1; }
    }
    println("naive, kmp and horspool agree");

    let names = ["naive", "kmp", "horspool"];
    let mb = (size * patterns.len()) as f64 / 1e6;
    for k in 0..3 {
        let ms = times[k] as f64 / 1e6;
        eprintln("{:<9} {ms:>6.1} ms  {:>6.0} MB/s", names[k], mb / ms * 1000.0);
    }
    0
}
