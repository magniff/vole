// EDITION: rust
// Huffman coding: an encoder and a decoder with canonical codes.
//
// Counts the bytes of a text, builds the Huffman tree with a min-heap,
// turns its depths into canonical codes, packs the text into a bit
// stream, and decodes it back with a lookup table, checking that the
// round trip gives the text back. A short sentence shows the code table;
// then 4 MiB of generated text (words drawn from a small vocabulary with
// skewed frequencies, from a seeded generator) is compressed and timed.
//
//     volec examples/algorithms/huffman/main.vl -o huffman && ./huffman
//
// Results go to stdout, timings to stderr. `main` returns a Result: an
// error (a code too long for the table, a round trip that differs) is
// printed as `Error: ...` with exit status 1.

import "math.h" as m;
import "time.h" as c;

use std::alloc::Allocator;

// ---------------------------------------------------------------- input

// xorshift64*: a small, fast, seeded generator of 64-bit values.
struct Rng { state: u64 }

impl Rng {
    fn new(seed: u64) -> Rng { Rng { state: seed | 1 } }

    fn next(&mut self) -> u64 {
        let mut x = self.state;
        x ^= x >> 12;
        x ^= x << 25;
        x ^= x >> 27;
        self.state = x;
        x.wrapping_mul(0x2545F4914F6CDD1D)
    }

    // A value in lo..=hi.
    fn range(&mut self, lo: i64, hi: i64) -> i64 {
        lo + ((self.next() >> 33) % ((hi - lo + 1) as u64)) as i64
    }
}

const WORDS: [&str; 24] = [
    "the", "of", "and", "to", "a", "in", "is", "that", "it", "was", "for", "on",
    "with", "as", "his", "they", "be", "at", "one", "have", "this", "from", "huffman",
    "code",
];

// `size` bytes of sentences. The smaller of two uniform draws picks the
// word, so early words are more frequent, as in real text.
fn generate_text(size: i64, seed: u64, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut rng = Rng::new(seed);
    let mut text: Vec<u8, Gpa> = Vec::with_capacity_in(size as usize + 16, gpa);
    let last = WORDS.len() - 1;
    while text.len() as i64 < size {
        let words = rng.range(3, 12);
        for k in 0..words {
            let i = rng.range(0, last as i64);
            let j = rng.range(0, last as i64);
            let w = WORDS[(if i < j { i } else { j }) as usize].as_bytes();
            if k == 0 {
                text.push(w[0] - 32); // capitalized
                text.extend_from_slice(&w[1..]);
            } else {
                text.push(b' ');
                text.extend_from_slice(w);
            }
        }
        text.extend_from_slice(if rng.range(0, 3) == 0 { b",\n" } else { b". " });
    }
    text.truncate(size as usize);
    text
}

// ------------------------------------------------------------- the tree

// A binary min-heap of any ordered T that is a plain value (as in
// examples/algorithms/dijkstra).
struct MinHeap<T: Ord + Copy, A: Allocator> { items: Vec<T, A> }

impl<T: Ord + Copy, A: Allocator> MinHeap<T, A> {
    fn new(a: A) -> MinHeap<T, A> { MinHeap { items: Vec::new_in(a) } }

    fn len(&self) -> usize { self.items.len() }

    fn push(&mut self, x: T) {
        self.items.push(x);
        let s = self.items.as_mut_slice();
        let mut i = s.len() - 1;
        while i > 0 && x < s[(i - 1) / 2] {
            s[i] = s[(i - 1) / 2];
            i = (i - 1) / 2;
        }
        s[i] = x;
    }

    fn pop(&mut self) -> Option<T> {
        let last = self.items.pop()?;
        let s = self.items.as_mut_slice();
        if s.is_empty() { return Some(last); }
        let top = s[0];
        let mut i = 0;
        loop {
            let mut child = 2 * i + 1;
            if child >= s.len() { break; }
            if child + 1 < s.len() && s[child + 1] < s[child] { child += 1; }
            if last <= s[child] { break; }
            s[i] = s[child];
            i = child;
        }
        s[i] = last;
        Some(top)
    }
}

// A subtree in the heap. The derived Ord compares the weights, then the
// node numbers, so equal weights merge in a fixed order and the codes
// are the same on every machine.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Debug)]
struct Subtree { weight: i64, node: i64 }

// The code length of each byte value: its leaf's depth in the Huffman
// tree (0 for a byte that does not occur). The tree's nodes are numbered:
// 0..256 are the leaves, one per byte value, and each merge adds one;
// `kids` holds each node's two children, (-1, -1) for a leaf.
fn code_lengths(freq: &[i64], gpa: Gpa) -> [i64; 256] {
    let mut kids: Vec<(i64, i64), Gpa> = Vec::from_elem_in((-1, -1), 256, gpa);
    let mut heap: MinHeap<Subtree, Gpa> = MinHeap::new(gpa);
    for b in 0..256i64 {
        if freq[b as usize] > 0 { heap.push(Subtree { weight: freq[b as usize], node: b }); }
    }
    let mut lengths = [0i64; 256];
    if heap.len() == 1 { // one symbol: a 1-bit code
        lengths[heap.pop().unwrap().node as usize] = 1;
        return lengths;
    }
    // Merge the two lightest subtrees until one is left: the root.
    while heap.len() > 1 {
        let a = heap.pop().unwrap();
        let b = heap.pop().unwrap();
        kids.push((a.node, b.node));
        heap.push(Subtree { weight: a.weight + b.weight, node: kids.len() as i64 - 1 });
    }
    // The depths, walking down from the root with a stack.
    let mut stack: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    stack.push((kids.len() as i64 - 1, 0i64));
    while let Some((node, depth)) = stack.pop() {
        let (left, right) = kids[node as usize];
        if left < 0 {
            lengths[node as usize] = depth;
        } else {
            stack.push((left, depth + 1));
            stack.push((right, depth + 1));
        }
    }
    lengths
}

// ---------------------------------------------------------------- codes

#[derive(Debug)]
enum HuffError { CodeTooLong(i64), Mismatch(i64) }

// The longest code the decoder's table takes: 2^MAX_BITS entries.
const MAX_BITS: i64 = 20;

// Canonical codes: only the lengths matter. Symbols sorted by (length,
// byte value) get consecutive codes, shifted left when the length grows,
// so a decoder rebuilds the codes from the 256 lengths alone.
struct Codebook { len: [i64; 256], code: [u64; 256], max_len: i64 }

#[derive(PartialEq, Eq, PartialOrd, Ord)]
struct ByLength { len: i64, byte: i64 }

impl Codebook {
    fn new(lengths: [i64; 256], gpa: Gpa) -> Result<Codebook, HuffError> {
        let mut order: Vec<ByLength, Gpa> = Vec::new_in(gpa);
        for b in 0..256i64 {
            if lengths[b as usize]
                > 0 { order.push(ByLength { len: lengths[b as usize], byte: b }); }
        }
        order.sort_unstable(); // by the derived Ord
        let max_len = order.last().map(|e| e.len).unwrap_or(0);
        if max_len > MAX_BITS { return Err(HuffError::CodeTooLong(max_len)); }
        let mut book = Codebook { len: lengths, code: [0u64; 256], max_len };
        let mut code = 0u64;
        let mut prev = 0;
        for e in order.iter() {
            code <<= e.len - prev;
            book.code[e.byte as usize] = code;
            code += 1;
            prev = e.len;
        }
        Ok(book)
    }

    // The decoder's table, indexed by the next max_len bits of the
    // stream: each entry is (byte | length << 8). A code of length L
    // fills the 2^(max_len - L) entries that start with it.
    fn decode_table(&self, gpa: Gpa) -> Vec<u32, Gpa> {
        let mut table = Vec::from_elem_in(0u32, 1usize << self.max_len, gpa);
        let t = table.as_mut_slice();
        for b in 0..256i64 {
            let len = self.len[b as usize];
            if len == 0 { continue; }
            let first = (self.code[b as usize] << (self.max_len - len)) as i64;
            for k in first..first + (1 << (self.max_len - len)) {
                t[k as usize] = (b | len << 8) as u32;
            }
        }
        table
    }

    fn code_text(&self, b: u8, gpa: Gpa) -> String<Gpa> {
        let mut s = String::new_in(gpa);
        for k in 0..self.len[b as usize] {
            s.push(if (self.code[b as usize] >> (self.len[b as usize] - 1 - k)) & 1 == 1 { '1' }
                else { '0' });
        }
        s
    }
}

// ---------------------------------------------------- encode and decode

// Packs each byte's code into a bit stream, most significant bit first:
// `acc` holds the bits not yet written (fewer than 8 between bytes), the
// last byte is padded with zero bits.
fn encode(text: &[u8], book: &Codebook, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut out: Vec<u8, Gpa> = Vec::with_capacity_in(text.len() / 2, gpa);
    let mut acc = 0u64;
    let mut bits = 0;
    for b in text.iter().copied() {
        let len = book.len[b as usize];
        acc = (acc << len) | book.code[b as usize];
        bits += len;
        while bits >= 8 {
            bits -= 8;
            out.push((acc >> bits) as u8);
        }
    }
    if bits > 0 { out.push((acc << (8 - bits)) as u8); }
    out
}

// Decodes `count` bytes: keeps up to 64 bits of the stream in `acc`,
// looks the next max_len of them up in the table, consumes the length
// found there.
fn decode(bits: &[u8], count: i64, book: &Codebook, gpa: Gpa) -> Vec<u8, Gpa> {
    let table = book.decode_table(gpa);
    let t = table.as_slice();
    let max = book.max_len;
    let mask = (1u64 << max) - 1;
    let mut out: Vec<u8, Gpa> = Vec::with_capacity_in(count as usize, gpa);
    let mut acc = 0u64;
    let mut have = 0;
    let mut pos = 0;
    for _ in 0..count {
        while have <= 56 { // refill a byte at a time
            let byte = if pos < bits.len() { bits[pos] } else { 0 };
            acc = (acc << 8) | byte;
            pos += 1;
            have += 8;
        }
        let e = t[((acc >> (have - max)) & mask) as usize];
        out.push(e as u8);
        have -= e >> 8;
    }
    out
}

// ---------------------------------------------------------------- stats

fn frequencies(text: &[u8]) -> [i64; 256] {
    let mut freq = [0i64; 256];
    for b in text.iter().copied() { freq[b as usize] += 1; }
    freq
}

// The Shannon entropy of the byte distribution, in bits per byte: no
// code that codes bytes one at a time does better.
fn entropy(freq: &[i64], total: i64) -> f64 {
    freq.iter().filter(|n| **n > 0).fold(0.0, |h, n| {
        let p = *n as f64 / total as f64;
        // UNSAFE: log2 is C's (math.h).
        // SAFETY: it takes and returns a double by value; p is in (0, 1].
        h - p * unsafe { m::log2(p) }
    })
}

// FNV-1a of the bytes.
fn checksum(bytes: &[u8]) -> u64 {
    bytes.iter().fold(0xcbf29ce484222325u64, |h, b| (h ^ *b as u64).wrapping_mul(0x100000001b3))
}

fn now_ns() -> i64 {
    let mut ts = c::timespec { tv_sec: 0, tv_nsec: 0 };
    // UNSAFE: timespec_get is C's, and writes through a pointer.
    // SAFETY: `&mut ts` is a whole timespec, borrowed for the call.
    unsafe { c::timespec_get(&mut ts, c::TIME_UTC); }
    ts.tv_sec * 1_000_000_000 + ts.tv_nsec
}

fn rate(what: &str, ns: i64, bytes: f64) {
    eprintln("{what}: {:>6.2} ms, {:>5.0} MB/s", ns as f64 / 1e6, bytes * 1e3 / ns as f64);
}

// Compresses `text`, decodes it back and checks it; prints the sizes.
// With `table`, also each byte's count and code.
fn round_trip(text: &[u8], table: bool, gpa: Gpa) -> Result<(), HuffError> {
    let t0 = now_ns();
    let freq = frequencies(text);
    let book = Codebook::new(code_lengths(&freq, gpa), gpa)?;
    let t1 = now_ns();
    let packed = encode(text, &book, gpa);
    let t2 = now_ns();
    let back = decode(packed.as_slice(), text.len() as i64, &book, gpa);
    let t3 = now_ns();

    if table {
        println("byte  count  bits  code");
        for len in 1..book.max_len + 1 {
            for b in 0..256i64 {
                if book.len[b as usize] != len { continue; }
                let code = book.code_text(b as u8, gpa);
                let q = if b == b' ' as i64 { '\'' } else { ' ' }; // quote the space
                println("{q}{}{q}  {:>5}  {len:>4}  {code}", b as u8 as char, freq[b as usize]);
            }
        }
    }
    if let Some(i) = (0..text.len()).position(|i| back[i] != text[i]) {
        return Err(HuffError::Mismatch(i as i64));
    }
    let bits = book.len.iter().zip(freq.iter()).fold(0i64, |s, (l, n)| s + *l * *n);
    let distinct = freq.iter().filter(|n| **n > 0).count();
    let n = text.len() as f64;
    let percent = packed.len() as f64 * 100.0 / n;
    let h = entropy(&freq, text.len() as i64);
    println("{} bytes, {distinct} distinct, longest code {} bits", text.len(), book.max_len);
    println("encoded: {bits} bits = {} bytes, {percent:.1}% of the input", packed.len());
    println("bits per byte: {:.4} (entropy {h:.4})", bits as f64 / n);
    println("checksum of the encoding: {:x}; decoded == input", checksum(packed.as_slice()));
    if !table {
        eprintln("count + tree + codes: {:>6.2} ms", (t1 - t0) as f64 / 1e6);
        rate("encode", t2 - t1, n);
        rate("decode", t3 - t2, n);
    }
    Ok(())
}

fn main(gpa: Gpa) -> Result<(), HuffError> {
    round_trip(b"this is an example of a huffman tree", true, gpa)?;
    println("");
    let text = generate_text(4 << 20, 2026, gpa);
    println("{:?}...", std::str::from_utf8(&text[..60]).unwrap());
    round_trip(&text, false, gpa)?;
    Ok(())
}
