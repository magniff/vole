// Arbitrary-precision natural numbers: schoolbook and Karatsuba
// multiplication, 1000!, and Fibonacci numbers up to F(1000000).
//
// A number is a Vec of limbs in base 10^9, least significant first, with
// no zero limb at the top (zero has no limbs). Base 10^9 makes printing in
// decimal free (each limb is nine digits) and a limb product, below 10^18,
// fits a u64 with room for the carry. A product of two numbers is the
// product of two polynomials in B = 10^9 whose coefficients are the
// limbs: the schoolbook method is O(n^2) limb products; Karatsuba's
// splitting does three half-size products instead of four, O(n^1.585).
//
//     volec examples/algorithms/bigint/main.vl -o bigint && ./bigint
//
// Results go to stdout; the times of the big products to stderr.

import "time.h" as c;

use std::alloc::Allocator;
use std::cmp::Ordering;
use std::fmt::{Display, Formatter, self};
use std::ops::{Add, Mul, Sub};

const BASE: u64 = 1_000_000_000;

// Below this many limbs (in the shorter operand), schoolbook is faster.
const KARATSUBA_MIN: usize = 96;

// ---------------------------------------------------------------- limbs
//
// The kernels work on slices of limbs. A product's slice `r` has room for
// a.len + b.len limbs and starts zeroed.

// r = a * b (r zeroed), O(a.len * b.len). A limb product is below 10^18
// and a u64 holds 18 of them, so the rows are added up in u64 columns
// without carrying, and the carries are propagated once every 16 rows:
// the inner loop is a multiply and an add.
fn mul_schoolbook(a: &[u32], b: &[u32], r: &mut [u32], gpa: Gpa) {
    let mut columns = Vec::from_elem_in(0u64, a.len() + b.len(), gpa);
    let acc = columns.as_mut_slice();
    let mut i = 0;
    while i < a.len() {
        let end = if i + 16 < a.len() { i + 16 } else { a.len() };
        for row in i..end {
            let ai: u64 = a[row];
            let out = &mut acc[row..row + b.len()];
            for j in 0..b.len() { out[j] += ai * b[j]; }
        }
        let mut carry: u64 = 0; // each column back below BASE
        for k in i..acc.len() {
            let cur = acc[k] + carry;
            acc[k] = cur % BASE;
            carry = cur / BASE;
            if carry == 0 && k >= end + b.len() { break; }
        }
        i = end;
    }
    for k in 0..acc.len() { r[k] = acc[k] as u32; }
}

// r[off..] += x; the sum fits in r.
fn add_at(r: &mut [u32], x: &[u32], off: usize) {
    let mut carry: u32 = 0;
    let mut k = off;
    for limb in x.iter().copied() {
        let mut s = r[k] + limb + carry;
        carry = 0;
        if s >= BASE as u32 { s -= BASE as u32; carry = 1; }
        r[k] = s;
        k += 1;
    }
    while carry != 0 {
        let s = r[k] + 1;
        if s == BASE as u32 { r[k] = 0; } else { r[k] = s; carry = 0; }
        k += 1;
    }
}

// r -= x, where r >= x.
fn sub_from(r: &mut [u32], x: &[u32]) {
    let mut borrow: u32 = 0;
    let mut k = 0;
    for limb in x.iter().copied() {
        let sub = limb + borrow;
        if r[k] >= sub { r[k] -= sub; borrow = 0; }
        else { r[k] = r[k] + BASE as u32 - sub; borrow = 1; }
        k += 1;
    }
    while borrow != 0 {
        if r[k] > 0 { r[k] -= 1; borrow = 0; } else { r[k] = BASE as u32 - 1; }
        k += 1;
    }
}

// The slice without its zero limbs at the top.
fn trimmed(x: &[u32]) -> &[u32] {
    let mut n = x.len();
    while n > 0 && x[n - 1] == 0 { n -= 1; }
    &x[..n]
}

// a + b, as a new Vec of max(a.len, b.len) + 1 limbs.
fn sum_of(a: &[u32], b: &[u32], gpa: Gpa) -> Vec<u32, Gpa> {
    let n = if a.len() > b.len() { a.len() } else { b.len() };
    let mut s = Vec::from_elem_in(0u32, n + 1, gpa);
    let out = s.as_mut_slice();
    add_at(out, a, 0);
    add_at(out, b, 0);
    s
}

// r = a * b (r zeroed), by Karatsuba. With a = a1 B^m + a0 and
// b = b1 B^m + b0:
//     a b = z2 B^2m + (p - z2 - z0) B^m + z0
// where z0 = a0 b0, z2 = a1 b1, p = (a0 + a1)(b0 + b1): three products of
// half the size.
fn mul_karatsuba(a: &[u32], b: &[u32], r: &mut [u32], gpa: Gpa) {
    if a.len() < b.len() { return mul_karatsuba(b, a, r, gpa); }
    if b.len() < KARATSUBA_MIN { return mul_schoolbook(a, b, r, gpa); }
    if 2 * b.len() <= a.len() {
        // Lopsided: b times each b.len-limb piece of a.
        let mut part = Vec::from_elem_in(0u32, 2 * b.len(), gpa);
        let p = part.as_mut_slice();
        let mut off = 0;
        while off < a.len() {
            let end = if off + b.len() < a.len() { off + b.len() } else { a.len() };
            for k in 0..p.len() { p[k] = 0; }
            mul_karatsuba(&a[off..end], b, p, gpa);
            add_at(r, trimmed(p), off);
            off = end;
        }
        return;
    }
    let m = a.len() / 2; // b.len > m: both halves are there
    let (a0, a1) = (&a[..m], &a[m..]);
    let (b0, b1) = (&b[..m], &b[m..]);
    mul_karatsuba(a0, b0, &mut r[..2 * m], gpa); // z0, in place
    mul_karatsuba(a1, b1, &mut r[2 * m..], gpa); // z2, in place
    let sa = sum_of(a0, a1, gpa);
    let sb = sum_of(b0, b1, gpa);
    let mut prod = Vec::from_elem_in(0u32, sa.len() + sb.len(), gpa);
    let p = prod.as_mut_slice();
    mul_karatsuba(&sa, &sb, p, gpa);
    sub_from(p, &r[..2 * m]); // p - z0
    sub_from(p, &r[2 * m..]); // p - z0 - z2 = a0 b1 + a1 b0
    add_at(r, trimmed(p), m);
}

// -------------------------------------------------------------- BigUint

// The derived PartialEq compares the limb Vecs by contents; Clone copies them
// (a deep copy); Debug shows the limbs.
#[derive(PartialEq, Eq, Clone, Debug)]
struct BigUint<A: Allocator> { limbs: Vec<u32, A> }

impl BigUint<Gpa> {
    fn zero(gpa: Gpa) -> BigUint<Gpa> { BigUint { limbs: Vec::new_in(gpa) } }

    // Takes the Vec, dropping zero limbs at the top.
    fn from_limbs(v: Vec<u32, Gpa>) -> BigUint<Gpa> {
        let mut limbs = v;
        while limbs.last().copied() == Some(0u32) { limbs.pop(); }
        BigUint { limbs }
    }

    fn is_zero(&self) -> bool { self.limbs.is_empty() }

    // self *= k, in place, for a small k.
    fn mul_small(&mut self, k: u32) {
        let s = self.limbs.as_mut_slice();
        let mut carry: u64 = 0;
        for i in 0..s.len() {
            let cur = s[i] * k as u64 + carry;
            s[i] = (cur % BASE) as u32;
            carry = cur / BASE;
        }
        if carry != 0 { self.limbs.push(carry as u32); }
    }

    // The number of decimal digits (1 for zero).
    fn digits(&self) -> i64 {
        if self.is_zero() { return 1; }
        let mut top = self.limbs[self.limbs.len() - 1];
        let mut d = 0;
        while top > 0 {
            d += 1;
            top /= 10;
        }
        9 * (self.limbs.len() as i64 - 1) + d
    }

    fn digit_sum(&self) -> i64 {
        self.limbs.iter().map(|limb| {
            let mut x = *limb;
            let mut s = 0i64;
            while x > 0 {
                s += (x % 10) as i64;
                x /= 10;
            }
            s
        }).sum()
    }

    // The schoolbook product, for checking Karatsuba.
    fn mul_slow(&self, other: &BigUint<Gpa>, gpa: Gpa) -> BigUint<Gpa> {
        let mut r = Vec::from_elem_in(0u32, self.limbs.len() + other.limbs.len(), gpa);
        mul_schoolbook(&self.limbs, &other.limbs, &mut r, gpa);
        BigUint::from_limbs(r)
    }

    // self + other, a new number; the operands stay as they are.
    fn plus(&self, other: &BigUint<Gpa>) -> BigUint<Gpa> {
        BigUint::from_limbs(sum_of(&self.limbs, &other.limbs, *self.limbs.allocator()))
    }

    // self - other, for self >= other (natural numbers).
    fn minus(&self, other: &BigUint<Gpa>) -> BigUint<Gpa> {
        if self < other { panic("BigUint: subtraction below zero"); }
        let mut r = self.limbs.clone();
        sub_from(&mut r, &other.limbs);
        BigUint::from_limbs(r)
    }

    // self * other, by Karatsuba.
    fn times(&self, other: &BigUint<Gpa>) -> BigUint<Gpa> {
        // (the result is allocated where self's limbs are)
        let gpa = *self.limbs.allocator();
        let mut r = Vec::from_elem_in(0u32, self.limbs.len() + other.limbs.len(), gpa);
        mul_karatsuba(&self.limbs, &other.limbs, &mut r, gpa);
        BigUint::from_limbs(r)
    }
}

impl BigUint<Gpa> {
    fn from_u64(x: u64, gpa: Gpa) -> BigUint<Gpa> {
        let mut limbs: Vec<u32, Gpa> = Vec::new_in(gpa);
        let mut x = x;
        while x > 0 {
            limbs.push((x % BASE) as u32);
            x /= BASE;
        }
        BigUint { limbs }
    }
}

// Longer is larger; at equal lengths, the first limb that differs from
// the top decides.
impl Ord for BigUint<Gpa> {
    fn cmp(&self, other: &BigUint<Gpa>) -> Ordering {
        let (a, b) = (self.limbs.as_slice(), other.limbs.as_slice());
        if a.len() != b.len() { return a.len().cmp(&b.len()); }
        for i in (0..a.len()).rev() {
            if a[i] != b[i] { return a[i].cmp(&b[i]); }
        }
        Ordering::Equal
    }
}

impl PartialOrd for BigUint<Gpa> {
    fn partial_cmp(&self, other: &BigUint<Gpa>) -> Option<Ordering> { Some(self.cmp(other)) }
}

// The operators take their operands by value, as the traits say: `a * b`
// consumes a and b, where plus, minus and times borrow them.
impl Add for BigUint<Gpa> {
    type Output = BigUint<Gpa>;
    fn add(self, other: BigUint<Gpa>) -> BigUint<Gpa> { self.plus(&other) }
}

impl Sub for BigUint<Gpa> {
    type Output = BigUint<Gpa>;
    fn sub(self, other: BigUint<Gpa>) -> BigUint<Gpa> { self.minus(&other) }
}

impl Mul for BigUint<Gpa> {
    type Output = BigUint<Gpa>;
    fn mul(self, other: BigUint<Gpa>) -> BigUint<Gpa> { self.times(&other) }
}

// Decimal: the top limb as it is, every other one as nine digits.
impl<A: Allocator> Display for BigUint<A> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let s = self.limbs.as_slice();
        if s.is_empty() { return write(f, "0"); }
        write(f, "{}", s[s.len() - 1])?;
        for i in (0..s.len() - 1).rev() { write(f, "{:09}", s[i])?; }
        Ok(())
    }
}

// ----------------------------------------------------------- algorithms

// n!, one small multiplication at a time.
fn factorial(n: u32, gpa: Gpa) -> BigUint<Gpa> {
    let mut f = BigUint::from_u64(1, gpa);
    for k in 2..=n { f.mul_small(k); }
    f
}

// lo * (lo + 1) * ... * hi, splitting the range in halves: the factors
// stay balanced, so the big products go through Karatsuba.
fn product(lo: u64, hi: u64, gpa: Gpa) -> BigUint<Gpa> {
    if hi - lo < 8 {
        let mut p = BigUint::from_u64(lo, gpa);
        for k in lo + 1..=hi { p.mul_small(k as u32); }
        return p;
    }
    let mid = (lo + hi) / 2;
    product(lo, mid, gpa) * product(mid + 1, hi, gpa)
}

// F(n) by adding: n additions.
fn fib_iterative(n: i64, gpa: Gpa) -> BigUint<Gpa> {
    let mut a = BigUint::zero(gpa);
    let mut b = BigUint::from_u64(1, gpa);
    for _ in 0..n {
        let next = a.plus(&b);
        a = b; // the old a is dropped
        b = next;
    }
    a
}

// F(n) by fast doubling, O(log n) multiplications:
//     F(2k) = F(k) (2 F(k+1) - F(k)),  F(2k+1) = F(k)^2 + F(k+1)^2
fn fib_doubling(n: i64, gpa: Gpa) -> BigUint<Gpa> {
    let mut a = BigUint::zero(gpa); // F(k), k = 0
    let mut b = BigUint::from_u64(1, gpa); // F(k + 1)
    let mut bit = 62;
    while bit >= 0 && (n >> bit) & 1 == 0 { bit -= 1; }
    while bit >= 0 {
        let twice = b.plus(&b);
        let diff = twice.minus(&a);
        let sq_a = a.times(&a);
        let sq_b = b.times(&b);
        let even = a.times(&diff); // F(2k)
        let odd = sq_a.plus(&sq_b); // F(2k + 1)
        if (n >> bit) & 1 == 1 {
            b = even.plus(&odd);
            a = odd; // k becomes 2k + 1
        } else {
            a = even; // k becomes 2k
            b = odd;
        }
        bit -= 1;
    }
    a
}

// ---------------------------------------------------------------- input

// xorshift64*: a small, fast, seeded generator of 64-bit values.
struct Rng { state: u64 }

impl Rng {
    fn new(seed: u64) -> Rng { Rng { state: seed | 1 } }

    fn next(&mut self) -> u64 {
        let mut x = self.state;
        x ^= x >> 12;
        x ^= x << 25;
        x ^= x >> 27;
        self.state = x;
        x.wrapping_mul(0x2545F4914F6CDD1D)
    }

    // A number of n random limbs.
    fn big(&mut self, n: usize, gpa: Gpa) -> BigUint<Gpa> {
        let mut v: Vec<u32, Gpa> = Vec::with_capacity_in(n, gpa);
        for _ in 0..n { v.push(((self.next() >> 32) % BASE) as u32); }
        BigUint::from_limbs(v)
    }
}

// --------------------------------------------------------------- output

fn now_ns() -> i64 {
    let mut ts = c::timespec { tv_sec: 0, tv_nsec: 0 };
    // UNSAFE: timespec_get is C's, and writes through a pointer.
    // SAFETY: `&mut ts` is a whole timespec, borrowed for the call.
    unsafe { c::timespec_get(&mut ts, c::TIME_UTC); }
    ts.tv_sec * 1_000_000_000 + ts.tv_nsec
}

// Milliseconds between two now_ns() readings.
fn ms(t0: i64, t1: i64) -> f64 { (t1 - t0) as f64 / 1e6 }

// A one-line summary: the number of digits, the first and last ones, the
// digit sum.
fn describe(name: &str, x: &BigUint<Gpa>, gpa: Gpa) {
    let text = format_in("{x}", gpa);
    let s = text.as_str();
    if s.len() <= 60 {
        println("{name} = {s}");
    } else {
        println("{name} = {}...{}", &s[..20], &s[s.len() - 20..]);
    }
    println("    {} digits, digit sum {}", x.digits(), x.digit_sum());
}

fn main(gpa: Gpa) -> i32 {
    // Small ones, and what a number looks like inside.
    let f30 = factorial(30, gpa);
    describe("30!", &f30, gpa);
    println("    as limbs: {f30:?}");

    // 1000!, two ways.
    let f1000 = factorial(1000, gpa);
    describe("1000!", &f1000, gpa);
    let text = format_in("{f1000}", gpa);
    let zeros = text.as_bytes().iter().fold(0, |n, d| if *d == b'0' { n + 1 } else { 0 });
    println("    {zeros} trailing zeros");
    let tree = product(1, 1000, gpa);
    println("    product tree (Karatsuba) == one at a time: {}", tree == f1000);

    // Fibonacci numbers, two ways.
    let fib_a = fib_iterative(10_000, gpa);
    let fib_b = fib_doubling(10_000, gpa);
    describe("F(10000)", &fib_a, gpa);
    println("    fast doubling == additions: {}", fib_a == fib_b);
    let t0 = now_ns();
    let big = fib_doubling(1_000_000, gpa);
    let t1 = now_ns();
    describe("F(1000000)", &big, gpa);
    eprintln("F(1000000) by fast doubling: {:.1} ms", ms(t0, t1));

    // Karatsuba against schoolbook on random operands.
    let mut rng = Rng::new(2026);
    let mut agree = 0;
    let trials = 30;
    for _ in 0..trials {
        let nx = 1 + (rng.next() % 600) as usize;
        let x = rng.big(nx, gpa);
        let ny = 1 + (rng.next() % 600) as usize;
        let y = rng.big(ny, gpa);
        let fast = x.times(&y);
        let slow = x.mul_slow(&y, gpa);
        if fast == slow { agree += 1; }
    }
    println("karatsuba == schoolbook on {agree} of {trials} random pairs");

    let n = 5000usize;
    let x = rng.big(n, gpa);
    let y = rng.big(n, gpa);
    let t2 = now_ns();
    let slow = x.mul_slow(&y, gpa);
    let t3 = now_ns();
    let fast = x.times(&y);
    let t4 = now_ns();
    println(
        "{n} x {n} limbs ({} digits each): equal {}, digit sum {}", 9 * n, slow == fast,
        fast.digit_sum());
    eprintln("{n} x {n} limbs: schoolbook {:.1} ms, karatsuba {:.1} ms", ms(t2, t3), ms(t3, t4));
    0
}
