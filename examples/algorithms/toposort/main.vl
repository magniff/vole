// Topological sorting, with Kahn's algorithm, and cycle detection, with a
// depth-first search that colours the nodes white, grey and black.
//
// A topological order lists a directed graph's nodes so that every edge
// goes forward: each task after the tasks it depends on. One exists if
// and only if the graph has no cycle. Kahn's algorithm repeatedly takes
// a node nothing points to any more; when it gets stuck, the graph has a
// cycle, and the depth-first search finds one to report.
//
//     volec examples/algorithms/toposort/main.vl -o toposort && ./toposort
//
// A small build plan, given as text, is sorted, then broken by one more
// dependency; then a random DAG of 1,000,000 nodes and 4,000,000 edges
// is sorted, its longest path found, and a cycle added and detected. The
// results go to stdout, the times to stderr.

use std::hash::FixedState;

import "time.h" as c;

use std::alloc::Allocator;
use std::collections::HashMap;

// ---------------------------------------------------------------- graph

// A directed graph in CSR form: the edges leaving v go to
// targets[start[v]..start[v + 1]].
struct Graph<A: Allocator> { n: i64, start: Vec<i64, A>, targets: Vec<i32, A> }

impl Graph<Gpa> {
    // The graph of n nodes with these (from, to) edges: a counting sort
    // of the edges by their source.
    fn new(n: i64, edges: &[(i32, i32)], gpa: Gpa) -> Graph<Gpa> {
        let mut start = Vec::from_elem_in(0i64, n as usize + 1, gpa);
        let s = start.as_mut_slice();
        for (from, _) in edges.iter().copied() { s[(from + 1) as usize] += 1; }
        for v in 0..n { s[(v + 1) as usize] += s[v as usize]; }
        let mut targets = Vec::from_elem_in(0i32, edges.len(), gpa);
        let t = targets.as_mut_slice();
        let mut fill = Vec::from_elem_in(0i64, n as usize, gpa);
        let f = fill.as_mut_slice();
        for (from, to) in edges.iter().copied() {
            t[(s[from as usize] + f[from as usize]) as usize] = to;
            f[from as usize] += 1;
        }
        Graph { n, start, targets }
    }

    // The nodes v points to.
    fn edges(&self, v: i64) -> &[i32] {
        &self.targets[self.start[v as usize] as usize..self.start[(v + 1) as usize] as usize]
    }
}

// ----------------------------------------------------------------- sort

// Kahn's algorithm: the nodes in a topological order, or Err with the
// number of nodes it could not place (they are on or behind a cycle).
fn kahn(g: &Graph<Gpa>, gpa: Gpa) -> Result<Vec<i32, Gpa>, i64> {
    let mut indegree = Vec::from_elem_in(0i32, g.n as usize, gpa);
    let deg = indegree.as_mut_slice();
    for u in g.targets.iter().copied() { deg[u as usize] += 1; }

    // `order` is also the queue: the nodes before `head` are done, the
    // ones after it wait for their edges to be removed.
    let mut order: Vec<i32, Gpa> = Vec::with_capacity_in(g.n as usize, gpa);
    for v in 0..g.n {
        if deg[v as usize] == 0 { order.push(v as i32); }
    }
    let mut head = 0;
    while head < order.len() {
        let v = order[head];
        head += 1;
        for u in g.edges(v).iter().copied() {
            deg[u as usize] -= 1;
            if deg[u as usize] == 0 { order.push(u); }
        }
    }
    if order.len() as i64 < g.n { return Err(g.n - order.len() as i64); }
    Ok(order)
}

const WHITE: u8 = 0; // not reached yet
const GREY: u8 = 1; // on the current path of the search
const BLACK: u8 = 2; // finished: everything after it is explored

// A cycle of g, as its nodes in order (the last one points back to the
// first), or None if g has none. A depth-first search with its own stack
// (a recursive one would overflow on a path of a million nodes): an edge
// to a grey node closes a cycle, the part of the stack from that node on.
fn find_cycle(g: &Graph<Gpa>, gpa: Gpa) -> Option<Vec<i32, Gpa>> {
    let mut colour = Vec::from_elem_in(WHITE, g.n as usize, gpa);
    let col = colour.as_mut_slice();
    let mut stack: Vec<(i32, i64), Gpa> = Vec::new_in(gpa); // (node, its next edge)
    let start = g.start.as_slice();
    let targets = g.targets.as_slice();
    for root in 0..g.n {
        if col[root as usize] != WHITE { continue; }
        col[root as usize] = GREY;
        stack.push((root as i32, start[root as usize]));
        while let Some((v, k)) = stack.last().copied() {
            if k == start[(v + 1) as usize] { // every edge done: v is finished
                col[v as usize] = BLACK;
                stack.pop();
                continue;
            }
            let top = stack.len() - 1;
            stack[top] = (v, k + 1);
            let u = targets[k as usize];
            if col[u as usize] == GREY {
                let from = stack.iter().position(|e| e.0 == u)?; // grey: on the stack
                let cycle = stack[from..].iter().map(|e| e.0).collect_in(gpa);
                return Some(cycle);
            }
            if col[u as usize] == WHITE {
                col[u as usize] = GREY;
                stack.push((u, start[u as usize]));
            }
        }
    }
    None
}

// The number of nodes on a longest path, and the path's first and last
// nodes, given a topological order: each node's depth is one more than
// the deepest node pointing to it.
fn longest_path(g: &Graph<Gpa>, order: &[i32], gpa: Gpa) -> (i64, i32, i32) {
    let mut depth = Vec::from_elem_in(1i32, g.n as usize, gpa);
    let mut from: Vec<i32, Gpa> = (0..g.n).map(|v| v as i32).collect_in(gpa); // where v's path starts
    let (d, f) = (depth.as_mut_slice(), from.as_mut_slice());
    let mut last = order[0];
    for v in order.iter().copied() {
        for u in g.edges(v).iter().copied() {
            if d[v as usize] + 1 > d[u as usize] {
                d[u as usize] = d[v as usize] + 1;
                f[u as usize] = f[v as usize];
            }
        }
        if d[v as usize] > d[last as usize] { last = v; }
    }
    (d[last as usize] as i64, f[last as usize], last)
}

// ----------------------------------------------------------- build plan

// What is wrong with a plan: a line, or the tasks of a cycle. The names
// borrow the plan's text (`'a`).
enum PlanError<'a, A: Allocator> { Syntax(&'a str), Cycle(Vec<&'a str, A>) }

// A cycle of node numbers, before it gets its names back.
struct Cycle<A: Allocator> { nodes: Vec<i32, A> }

// Tasks and their dependencies, from lines "task: dep dep ...".
struct Plan<'a, A: Allocator> {
    names: Vec<&'a str, A>, ids: HashMap<&'a str, i64, A, FixedState>, edges: Vec<(i32, i32), A>,
}

impl<'a> Plan<'a, Gpa> {
    fn parse(lines: &[&'a str], gpa: Gpa) -> Result<Plan<'a, Gpa>, PlanError<'a, Gpa>> {
        let mut plan = Plan {
            names: Vec::new_in(gpa), ids: HashMap::new_in(gpa), edges: Vec::new_in(gpa),
        };
        for line in lines.iter().copied() {
            let mut words = line.split_whitespace();
            let first = words.next().unwrap_or("");
            if !first.ends_with(':') {
                return Err(PlanError::Syntax(line));
            }
            let task = plan.id(&first[..first.len() - 1]);
            for word in words {
                let dep = plan.id(word);
                plan.edges.push((dep as i32, task as i32)); // dep before task
            }
        }
        Ok(plan)
    }

    // The number of a task's name, a new one the first time it is seen.
    fn id(&mut self, name: &'a str) -> i64 {
        if let Some(i) = self.ids.get(name) { return *i; }
        let i = self.names.len();
        self.names.push(name);
        self.ids.insert(name, i as i64);
        i as i64
    }

    // The tasks in an order that runs each after its dependencies.
    fn order(&self, gpa: Gpa) -> Result<Vec<&'a str, Gpa>, PlanError<'a, Gpa>> {
        let g = Graph::new(self.names.len() as i64, &self.edges, gpa);
        let order = sort(&g, gpa).map_err(|c| self.named(&c, gpa))?;
        Ok(order.iter().map(|v| self.names[*v as usize]).collect_in(gpa))
    }

    fn named(&self, cycle: &Cycle<Gpa>, gpa: Gpa) -> PlanError<'a, Gpa> {
        PlanError::Cycle(cycle.nodes.iter().map(|v| self.names[*v as usize]).collect_in(gpa))
    }
}

// A topological order of g, or a cycle that prevents one.
fn sort(g: &Graph<Gpa>, gpa: Gpa) -> Result<Vec<i32, Gpa>, Cycle<Gpa>> {
    match kahn(g, gpa) {
        Ok(order) => Ok(order),
        Err(_) => Err(Cycle { nodes: find_cycle(g, gpa).unwrap() }),
    }
}

// The order of the tasks in `lines`: `?` passes a syntax error or a
// cycle on to the caller.
fn plan_order<'a>(lines: &[&'a str], gpa: Gpa) -> Result<Vec<&'a str, Gpa>, PlanError<'a, Gpa>> {
    let plan = Plan::parse(lines, gpa)?;
    plan.order(gpa) // the names borrow the text of `lines` ('a), not the plan
}

fn print_plan(lines: &[&str], gpa: Gpa) {
    match plan_order(lines, gpa) {
        Ok(order) => {
            print("order:");
            for name in order { print(" {name}"); }
            println("");
        }
        Err(PlanError::Cycle(names)) => {
            // The cycle's edges go from a dependency to what needs it:
            // read backwards, each task needs the next.
            let n = names.len();
            print("cycle:");
            for k in 1..=n { print(" {} needs", names[n - k]); }
            println(" {}", names[n - 1]);
        }
        Err(PlanError::Syntax(line)) => println("not a dependency line: '{line}'"),
    }
}

// --------------------------------------------------------- random graph

// xorshift64*: a small, fast, seeded generator of 64-bit values.
struct Rng { state: u64 }

impl Rng {
    fn new(seed: u64) -> Rng { Rng { state: seed | 1 } }

    fn next(&mut self) -> u64 {
        let mut x = self.state;
        x ^= x >> 12;
        x ^= x << 25;
        x ^= x >> 27;
        self.state = x;
        x.wrapping_mul(0x2545F4914F6CDD1D)
    }

    // A value in 0..n.
    fn below(&mut self, n: i64) -> i64 { ((self.next() >> 33) % (n as u64)) as i64 }
}

// m random edges between n nodes, all going forward in a hidden random
// order of the nodes, so the graph is acyclic.
fn random_dag(n: i64, m: i64, seed: u64, gpa: Gpa) -> Vec<(i32, i32), Gpa> {
    let mut rng = Rng::new(seed);
    let mut rank: Vec<i64, Gpa> = (0..n).collect_in(gpa);
    let r = rank.as_mut_slice();
    for i in 1..n { // Fisher-Yates: a random permutation
        let j = rng.below(i + 1);
        r.swap(i as usize, j as usize);
    }
    let mut edges: Vec<(i32, i32), Gpa> = Vec::with_capacity_in(m as usize + 1, gpa);
    while edges.len() as i64 < m {
        let (a, b) = (rng.below(n), rng.below(n));
        if a == b { continue; }
        if r[a as usize] < r[b as usize] { edges.push((a as i32, b as i32)); }
        else { edges.push((b as i32, a as i32)); }
    }
    edges
}

fn now_ns() -> i64 {
    let mut ts = c::timespec { tv_sec: 0, tv_nsec: 0 };
    // UNSAFE: timespec_get is C's, and writes through a pointer.
    // SAFETY: `&mut ts` is a whole timespec, borrowed for the call.
    unsafe { c::timespec_get(&mut ts, c::TIME_UTC); }
    ts.tv_sec * 1_000_000_000 + ts.tv_nsec
}

fn main(gpa: Gpa) -> i32 {
    // A small build: each line is a task and what it needs first.
    let build = [
        "app: net ui",
        "net: io tls",
        "tls: crypto",
        "ui: gfx io",
        "gfx: math",
        "crypto: math",
        "tests: app",
    ];
    print_plan(&build, gpa);
    // One more dependency closes a loop.
    let broken = ["app: net ui", "net: io tls", "tls: crypto", "crypto: math", "math: app"];
    print_plan(&broken, gpa);
    print_plan(&["app net"], gpa);

    // A random DAG of a million nodes, sorted and checked.
    let n: i64 = 1_000_000;
    let mut edges = random_dag(n, 4_000_000, 99, gpa);
    let g = Graph::new(n, &edges, gpa);
    let t0 = now_ns();
    let order = kahn(&g, gpa).unwrap();
    let t1 = now_ns();
    let mut position = Vec::from_elem_in(0usize, n as usize, gpa);
    for (i, v) in order.iter().enumerate() { position[*v as usize] = i; }
    let p = position.as_slice();
    let forward = edges.iter().all(|e| p[e.0 as usize] < p[e.1 as usize]);
    println("random DAG: {n} nodes, {} edges", edges.len());
    println(
        "sorted: {} nodes, first {}, last {}, every edge forward: {forward}", order.len(), order[0],
        order[(n - 1) as usize]);
    let (length, first, last) = longest_path(&g, &order, gpa);
    println("longest path: {length} nodes, from {first} to {last}");

    // An edge from the end of that path back to its start makes a cycle.
    edges.push((last, first));
    let cyclic = Graph::new(n, &edges, gpa);
    let t2 = now_ns();
    let stuck = kahn(&cyclic, gpa).err().unwrap_or(0);
    let cycle = find_cycle(&cyclic, gpa).unwrap();
    let t3 = now_ns();
    let s = cycle.as_slice();
    let closed = (0..s.len()).all(|i| cyclic
        .edges(s[i])
        .iter()
        .any(|u| *u == s[(i + 1) % s.len()]));
    println("with the edge {last} -> {first}: kahn stuck with {stuck} nodes left");
    println("cycle found: {} nodes, every step an edge: {closed}", s.len());
    eprintln(
        "kahn on {n} nodes: {} ms, kahn + cycle search: {} ms", (t1 - t0) / 1_000_000,
        (t3 - t2) / 1_000_000);
    0
}
