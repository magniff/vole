// A small key-value store answering one request per line of stdin:
// `SET key n`, `ADD key n`, `GET key`, `SUM key...`. Each request gets
// scratch memory of its own, `arena_scope(&gpa, |scratch| ...)`: its words,
// its lowercased keys and its response are allocated there, by bumping a
// pointer, and all of it is freed at once when the request is answered.
// What outlives a request is allocated elsewhere: the map on Gpa, the
// keys' text in an arena kept for the whole run.
use std::io;
use std::alloc::{Allocator, Arena, arena_scope};
use std::collections::HashMap;

// What lives for the whole run. The keys borrow from the names arena,
// so the arena outlives the map: the lifetime 'n says so.
struct Store<'n, M: Allocator, N: Allocator> {
    values: HashMap<&'n str, i64, M>,
    names: &'n Arena<N>,
}

// s in lowercase, a new String on the allocator a (here: the request's
// scratch arena).
fn lower_in<A: Allocator>(s: &str, a: A) -> String<A> {
    let mut out = String::with_capacity_in(s.len(), a);
    for c in s.chars() {
        out.push(c.to_ascii_lowercase());
    }
    out
}

// Answers one request into `out`; every allocation but the store's is on
// `scratch`, whatever its type: the caller decides how long it lives.
fn answer<A: Allocator + Copy>(
    store: &mut Store<'_, Gpa, Gpa>, line: &str, scratch: A, out: &mut String<A>,
) {
    let words: Vec<&str, A> = line.split_whitespace().collect_in(scratch);
    if words.is_empty() {
        out.push_str("empty request");
        return;
    }
    let cmd = lower_in(words[0], scratch);
    let cmd = cmd.as_str();
    if (cmd == "set" || cmd == "add") && words.len() == 3 {
        let key = lower_in(words[1], scratch);
        let n = match words[2].parse::<i64>() {
            Ok(n) => n,
            Err(_) => {
                write(out, "not a number: {}", words[2]).unwrap();
                return;
            }
        };
        let old = store.values.get(key.as_str()).copied().unwrap_or(0);
        let new = if cmd == "set" { n } else { old + n };
        match store.values.get_mut(key.as_str()) {
            // A known key: its value changes in place.
            Some(v) => *v = new,
            // A new key: its text goes where the map's keys live. The
            // copy borrows the arena, not the request's scratch.
            None => {
                store.values.insert(store.names.alloc_str(key.as_str()), new);
            }
        }
        write(out, "{key} = {new}").unwrap();
    } else if cmd == "get" && words.len() == 2 {
        let key = lower_in(words[1], scratch);
        match store.values.get(key.as_str()) {
            Some(n) => write(out, "{key} = {n}").unwrap(),
            None => write(out, "{key} is not set").unwrap(),
        }
    } else if cmd == "sum" && words.len() >= 2 {
        let mut total = 0;
        let mut missing = String::new_in(scratch);
        for name in &words[1..] {
            let key = lower_in(name, scratch);
            match store.values.get(key.as_str()) {
                Some(n) => total += *n,
                None => {
                    missing.push(' ');
                    missing.push_str(key.as_str());
                }
            }
        }
        write(out, "sum = {total}").unwrap();
        if !missing.is_empty() {
            write(out, " (not set:{missing})").unwrap();
        }
    } else {
        write(out, "unknown request: {line}").unwrap();
    }
}

fn main(gpa: Gpa) -> i32 {
    let input = io::read_to_string_in(io::stdin(), gpa).unwrap();
    // The keys' arena is made before the store and dropped after it.
    let names = Arena::new_in(gpa);
    let mut store = Store { values: HashMap::new_in(gpa), names: &names };

    let mut requests = 0;
    let mut peak = 0;
    for line in input.lines() {
        if line.is_empty() {
            continue;
        }
        // The request's scratch: an arena of its own, from gpa, freed
        // (all of it) when the closure returns. Only a usize leaves it.
        let used = arena_scope(&gpa, |scratch| {
            let mut out = String::new_in(scratch);
            answer(&mut store, line, scratch, &mut out);
            println("{line:<24} -> {out}");
            scratch.used()
        });
        requests += 1;
        if used > peak {
            peak = used;
        }
    }
    println(
        "{requests} requests, {} keys; scratch per request at most {peak} bytes",
        store.values.len());
    println("the keys' arena holds {} bytes", names.used());
    0
}
