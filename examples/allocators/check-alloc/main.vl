// EDITION: rust
// The memory bugs vole still lets through, one per command-line
// argument: `leak`, `dangling` and `twice` (none: the correct version of
// each). Safe code cannot read memory after it is freed or free it twice:
// those are compile errors (the README shows them). What is left is a
// leak, which is safe, and a bug in `unsafe` code, whose raw pointers
// nothing checks. Built as usual, each prints a wrong number,
// crashes or shows nothing at all; built with `volec --check-alloc`, each
// is reported with its block, where it was allocated and where it was
// freed.
use std::env;
use std::alloc::{Allocator, Layout};
use std::cli::{Arg, Command};
use std::ptr::NonNull;

// The bug: a String whose drop never runs. `std::mem::forget` takes a
// value and does not drop it: safe code, and its memory is never freed.
fn leaked(gpa: Gpa, fixed: bool) {
    let mut b = String::new_in(gpa);
    b.push_str("a report nobody frees");
    println("{b}");
    if !fixed {
        std::mem::forget(b);
    }
}

// The bug: a raw pointer into a Vec kept across a push that moved the
// Vec's memory. A reference (`&v[0]`) kept across the push would be a
// compile error; a raw pointer is not checked.
fn dangling(gpa: Gpa, fixed: bool) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..4 {
        v.push(i * 10 + 1);
    }
    let first = v.as_ptr();
    v.push(41);
    if fixed {
        // safe code indexes the Vec: there is no pointer to keep valid
        println("first {}", v[0]);
    } else {
        // UNSAFE: the bug this example shows: a read through a pointer into the Vec's buffer.
        // SAFETY: none, on purpose: v.push(41) may have moved the buffer (--check-alloc says so).
        println("first {}", unsafe { *first });
    }
}

// Two i64s managed by hand, through a raw pointer. The struct is `Copy`
// and has no `Drop`: `let b = a;` copies the pointer, not the memory, and
// nothing frees it but an explicit `deallocate`.
#[derive(Clone, Copy)]
struct Pair { p: *mut i64 }

fn pair_layout() -> Layout { Layout::array::<i64>(2).unwrap() }

fn pair_new(gpa: Gpa, a: i64, b: i64) -> Pair {
    let p = gpa.allocate(pair_layout()).expect("out of memory").as_ptr() as *mut i64;
    // UNSAFE: the two i64s are written through the raw pointer.
    // SAFETY: p is a new block of 16 bytes, aligned for i64: p and p + 1 are inside it.
    unsafe {
        *p = a;
        *p.add(1) = b;
    }
    Pair { p }
}

impl Pair {
    // The block to give back to the allocator.
    fn block(self) -> NonNull<u8> { NonNull::new(self.p as *mut u8).unwrap() }
}

// The bug: two copies of a Pair, each freed.
fn freed_twice(gpa: Gpa, fixed: bool) {
    let counts = pair_new(gpa, 3, 4);
    let shelf = counts;
    // UNSAFE: a Pair's memory is managed by hand, through a raw pointer.
    // SAFETY: shelf.p points to the two i64s pair_new wrote, not freed yet.
    println("shelf: {}", unsafe { *shelf.p + *shelf.p.add(1) });
    // UNSAFE: deallocate is the allocator's unsafe method.
    // SAFETY: the block is pair_new's, with its layout, and this is its first free.
    unsafe { gpa.deallocate(counts.block(), pair_layout()) };
    if !fixed {
        // UNSAFE: the bug this example shows: the copy freed as well.
        // SAFETY: none, on purpose: shelf.p is counts.p, freed above (--check-alloc says so).
        unsafe { gpa.deallocate(shelf.block(), pair_layout()) };
    }
}

#[derive(PartialEq)]
enum Bug { NoBug, Leak, Dangling, Twice }

// The bug the arguments name; None (and a message) for one it does not
// know. `--help` prints the help and exits.
fn parse_args(gpa: Gpa) -> Option<Bug> {
    let cmd = Command::new_in("shop", gpa)
        .about("memory bugs for --check-alloc to find")
        .arg(Arg::positional("bug").help("leak, dangling or twice (none: the correct versions)"));
    let m = cmd.parse_or_exit(env::args());
    let bug = m.get("bug").unwrap_or("");
    if bug == "" {
        Some(Bug::NoBug)
    } else if bug == "leak" {
        Some(Bug::Leak)
    } else if bug == "dangling" {
        Some(Bug::Dangling)
    } else if bug == "twice" {
        Some(Bug::Twice)
    } else {
        eprintln("shop: no bug '{bug}': leak, dangling or twice");
        None
    }
}

fn main(gpa: Gpa) -> i32 {
    let bug = match parse_args(gpa) {
        Some(b) => b,
        None => return 2,
    };
    let fixed = bug == Bug::NoBug;
    if fixed || bug == Bug::Leak {
        leaked(gpa, fixed);
    }
    if fixed || bug == Bug::Dangling {
        dangling(gpa, fixed);
    }
    if fixed || bug == Bug::Twice {
        freed_twice(gpa, fixed);
    }
    if fixed {
        // (counted only by the checking Gpa: 0 otherwise)
        println("blocks still allocated: {}", gpa.live_blocks());
    }
    0
}
