// EDITION: rust
// Totals of a shop's orders, read from stdin, one per line: `customer
// item quantity price` (the price in cents). The program shows where
// memory comes from in vole: nothing allocates unless it is given an
// allocator, the general-purpose one (`Gpa`) is main's parameter, and it
// is passed down to whatever allocates. A function's signature says
// whether it allocates; `volec query effects` confirms it.
use std::io;
use std::alloc::Allocator;
use std::collections::HashMap;

struct Order<'a> { customer: &'a str, item: &'a str, quantity: i64, cents: i64 }

// The orders in `text`, in a new Vec on `gpa` (the caller frees it). A
// line that does not parse is reported and skipped. The &str fields
// borrow `text`: they live as long as it does, and cost nothing.
fn parse_orders<'a>(text: &'a str, gpa: Gpa) -> Vec<Order<'a>, Gpa> {
    let mut orders: Vec<Order<'a>, Gpa> = Vec::new_in(gpa);
    for line in text.lines() {
        let w: Vec<&str, Gpa> = line.split_whitespace().collect_in(gpa);
        if w.is_empty() {
            continue;
        }
        if w.len() != 4 {
            eprintln("skipped: {line}");
            continue;
        }
        match (w[2].parse::<i64>(), w[3].parse::<i64>()) {
            (Ok(q), Ok(c)) => orders.push(Order {
                customer: w[0], item: w[1], quantity: q, cents: c,
            }),
            _ => eprintln("skipped: {line}"),
        }
    }
    orders
}

// The sum of the orders' amounts. It only reads: it takes a slice, and no
// allocator, so it cannot allocate.
fn total(orders: &[Order]) -> i64 {
    let mut t = 0;
    for o in orders {
        t += o.quantity * o.cents;
    }
    t
}

// Each customer's total, in a new map on the same allocator as `orders`:
// a container carries its allocator, `allocator()` hands it over, so this
// function needs no allocator parameter of its own.
fn by_customer<'a>(orders: &Vec<Order<'a>, Gpa>) -> HashMap<&'a str, i64, Gpa> {
    let mut m: HashMap<&'a str, i64, Gpa> = HashMap::new_in(*orders.allocator());
    for o in orders.iter() {
        *m.entry(o.customer).or_insert(0) += o.quantity * o.cents;
    }
    m
}

// How many of each item, on whatever allocator the caller picks: generic
// over it (Gpa here; an arena or a FixedBuf would do as well).
fn count_items<'a, A: Allocator>(orders: &[Order<'a>], a: A) -> HashMap<&'a str, i64, A> {
    let mut m: HashMap<&'a str, i64, A> = HashMap::new_in(a);
    for o in orders {
        *m.entry(o.item).or_insert(0) += o.quantity;
    }
    m
}

fn main(gpa: Gpa) -> i32 {
    // stdin, all of it, in a String on gpa.
    let input = io::read_to_string_in(io::stdin(), gpa).unwrap();

    let orders = parse_orders(&input, gpa);

    let customers = by_customer(&orders);
    let items = count_items(&orders, gpa);

    // The customers by name: their entries in a Vec, sorted.
    let mut rows: Vec<(&str, i64), Gpa> =
        customers.iter().map(|(name, cents)| (*name, *cents)).collect_in(gpa);
    rows.sort_by(|a, b| a.0.cmp(b.0));
    for (name, cents) in rows.iter() {
        println("{name:<8} {:>4}.{:02}", cents / 100, cents % 100);
    }
    let t = total(&orders);
    println("{} orders, {} items, total {}.{:02}", orders.len(), items.len(), t / 100, t % 100);
    let line = format_in("apples sold: {}", items.get("apples").copied().unwrap_or(0), gpa);
    println("{line}");
    0
}
