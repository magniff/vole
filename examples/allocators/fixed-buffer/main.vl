// EDITION: rust
// A reverse-Polish calculator that never touches the heap: `main` takes
// no allocator, so nothing in the program can call malloc, and all its
// memory is 512 bytes on main's stack, handed out by a FixedBuf. A line or
// a stack of numbers that would grow past them is an error the calculator
// reports (`try_reserve` returns an error), not a crash.
use std::alloc::FixedBuf;
use std::fmt::{Display, Formatter};
import "unistd.h" as c;

enum CalcError<'a> {
    Underflow(&'a str),
    Unknown(&'a str),
    TooDeep(usize),
    Leftover(usize),
    Empty,
    TooLong(usize),
    NotText,
}

impl Display for CalcError<'_> {
    fn fmt(&self, f: &mut Formatter) -> std::fmt::Result {
        match self {
            CalcError::Underflow(w) => write(f, "'{w}' needs two numbers"),
            CalcError::Unknown(w) => write(f, "unknown word '{w}'"),
            CalcError::TooDeep(n) => {
                write(f, "out of memory at depth {n} (the stack has no more room)")
            }
            CalcError::Leftover(n) => write(f, "{n} numbers left: an operator is missing"),
            CalcError::Empty => f.write_str("nothing to compute"),
            CalcError::TooLong(n) => write(f, "out of memory: the line is longer than {n} bytes"),
            CalcError::NotText => f.write_str("the line is not UTF-8"),
        }
    }
}

// The calculator's stack: numbers in a FixedBuf's memory.
type Stack<'a, 'm> = Vec<i64, &'a FixedBuf<'m>>;

// Pushes x, or says how deep the stack was when the memory ran out.
fn push<'a>(stack: &mut Stack, x: i64) -> Result<(), CalcError<'a>> {
    if stack.try_reserve(1).is_err() {
        return Err(CalcError::TooDeep(stack.len()));
    }
    stack.push(x);
    Ok(())
}

// The first index from i on whose byte is not (blank true) or is (blank
// false) a space; line.len() if none.
fn skip(line: &[u8], i: usize, blank: bool) -> usize {
    for j in i..line.len() {
        if (line[j] == b' ') != blank {
            return j;
        }
    }
    line.len()
}

fn pop2<'a>(stack: &mut Stack, w: &'a str) -> Result<(i64, i64), CalcError<'a>> {
    if stack.len() < 2 {
        return Err(CalcError::Underflow(w));
    }
    let b = stack.pop().unwrap();
    let a = stack.pop().unwrap();
    Ok((a, b))
}

// The value of one line, computed on `stack` (emptied first). Allocates
// only from a FixedBuf: the declaration is checked, so a Gpa sneaking in
// three calls down would be an error here.
#[effects(alloc(FixedBuf), panic)]
fn eval<'a>(line: &'a str, stack: &mut Stack) -> Result<i64, CalcError<'a>> {
    stack.clear();
    let bytes = line.as_bytes();
    let mut i = 0;
    // (a counted loop: each round takes at least one byte, so line.len()
    // rounds are enough; `while` would add the effect diverge)
    for _ in 0..bytes.len() {
        // the next word: line[start..i]
        let start = skip(bytes, i, true);
        if start == bytes.len() {
            break;
        }
        i = skip(bytes, start, false);
        let w: &str = &line[start..i];
        if w == "+" || w == "-" || w == "*" || w == "/" {
            let (a, b) = pop2(stack, w)?;
            let r = if w == "+" {
                a + b
            } else if w == "-" {
                a - b
            } else if w == "*" {
                a * b
            } else {
                a / b
            };
            push(stack, r)?;
        } else if w == "dup" {
            if stack.is_empty() {
                return Err(CalcError::Underflow(w));
            }
            let top = stack[stack.len() - 1];
            push(stack, top)?;
        } else {
            match w.parse::<i64>() {
                Ok(n) => push(stack, n)?,
                Err(_) => return Err(CalcError::Unknown(w)),
            }
        }
    }
    if stack.is_empty() {
        return Err(CalcError::Empty);
    }
    if stack.len() > 1 {
        return Err(CalcError::Leftover(stack.len()));
    }
    Ok(stack[0])
}

// Standard input, read with C's read(2) into 64 bytes of this struct, a
// byte at a time. (std's readers of a whole input take an allocator for
// what they read; this program has none to give.)
struct Input {
    chunk: [u8; 64],
    len: usize,
    pos: usize,
}

impl Input {
    // The next byte, or None at the end of the input.
    fn byte(&mut self) -> Option<u8> {
        if self.pos == self.len {
            // UNSAFE: read(2) is C's, and takes a raw pointer.
            // SAFETY: the pointer is to chunk's 64 bytes, and 64 is the
            // most read may write.
            let n = unsafe { c::read(0, self.chunk.as_mut_ptr(), 64) };
            self.pos = 0;
            if n <= 0 {
                self.len = 0;
                return None;
            }
            self.len = n as usize;
        }
        self.pos += 1;
        Some(self.chunk[self.pos - 1])
    }

    // The next line into `line` (emptied first), without its newline:
    // Ok(false) at the end of the input. A line that does not fit is
    // skipped to its end, and is an error.
    fn line<'a>(&mut self, line: &mut Vec<u8, &FixedBuf>) -> Result<bool, CalcError<'a>> {
        line.clear();
        let mut next = self.byte();
        if next.is_none() {
            return Ok(false);
        }
        let mut full = false;
        while let Some(b) = next {
            if b == b'\n' {
                break;
            }
            if !full {
                if line.try_reserve(1).is_ok() {
                    line.push(b);
                } else {
                    full = true;
                }
            }
            next = self.byte();
        }
        if full {
            return Err(CalcError::TooLong(line.len()));
        }
        Ok(true)
    }
}

// A line to show: at most 30 bytes of it, and "..." when there is more.
fn short(s: &str) -> (&str, &str) {
    if s.len() <= 30 {
        return (s, "");
    }
    let mut n = 30;
    while !s.is_char_boundary(n) {
        n -= 1;
    }
    (&s[..n], "...")
}

fn main() -> i32 {
    // All the memory there is: 512 bytes on this function's stack, in two
    // buffers. A FixedBuf borrows its memory mutably, and a container on
    // it borrows the FixedBuf: the line and the stack, alive together,
    // each have their own. Both ask for their room once, up front: a
    // Vec that grows asks for a new, larger block, and a FixedBuf does
    // not give the old one's room back.
    let mut line_mem = [0u8; 184];
    let mut stack_mem = [0u8; 328];
    let line_fb = FixedBuf::new(&mut line_mem);
    let stack_fb = FixedBuf::new(&mut stack_mem);
    let mut line: Vec<u8, &FixedBuf> = Vec::with_capacity_in(160, &line_fb);
    let mut stack: Stack = Vec::with_capacity_in(32, &stack_fb);
    let mut input = Input { chunk: [0u8; 64], len: 0, pos: 0 };
    let mut lines = 0;
    let mut failed = 0;
    loop {
        let read = match input.line(&mut line) {
            Ok(false) => break,
            Ok(true) => Ok(()),
            Err(e) => Err(e),
        };
        lines += 1;
        // (what was read is shown as text; bytes that are not UTF-8 are
        // an error of their own)
        let text = match std::str::from_utf8(line.as_slice()) {
            Ok(t) => t,
            Err(_) => {
                println("(bytes): {}", CalcError::NotText);
                failed += 1;
                continue;
            }
        };
        let result = match read {
            Ok(()) => eval(text, &mut stack),
            Err(e) => Err(e),
        };
        let (shown, more) = short(text);
        match result {
            Ok(v) => println("{shown}{more} = {v}"),
            Err(e) => {
                println("{shown}{more}: {e}");
                failed += 1;
            }
        }
    }
    println(
        "{lines} lines, {failed} failed; {} of 512 bytes in use, room for {} numbers",
        line.capacity() + stack.capacity() * 8, stack.capacity());
    0
}
