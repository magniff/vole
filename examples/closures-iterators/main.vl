// EDITION: rust
// A log-file analyzer: reads an access log on stdin and prints a report,
// almost every step a chain of iterator adapters and closures.
//
// A line is `TIME LEVEL SERVICE STATUS MILLIS PATH`, e.g.
//   09:00:02 WARN api 429 3 /users
// Blank lines and `#` comments are skipped; malformed lines are counted.
use std::io;
use std::collections::HashMap;

#[derive(Clone, Copy, PartialEq, Debug)]
enum Level { Info, Warn, Error }

// The fields are slices of the input: 'a says an Entry borrows it. It is
// Copy: a few words, no memory of its own.
#[derive(Clone, Copy)]
struct Entry<'a> {
    time: &'a str, level: Level, service: &'a str, status: i64, millis: i64, path: &'a str,
}

// Our own iterator: the lines of a text, as slices of it (no copies).
// (std has it: `text.lines()`.)
struct Lines<'a> { text: &'a str, pos: usize }

impl<'a> Lines<'a> {
    fn new(text: &'a str) -> Lines<'a> { Lines { text, pos: 0 } }
}

impl<'a> Iterator for Lines<'a> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        if self.pos >= self.text.len() { return None; }
        let rest = &self.text[self.pos..];
        let len = rest.find('\n').unwrap_or(rest.len());
        self.pos += len + 1; // past the '\n'
        Some(&rest[..len])
    }
}

fn parse_level(word: &str) -> Option<Level> {
    if word == "INFO" { Some(Level::Info) }
    else if word == "WARN" { Some(Level::Warn) }
    else if word == "ERROR" { Some(Level::Error) }
    else { None }
}

// `?` on an Option: any missing or malformed field makes the line None.
fn parse_entry(line: &str) -> Option<Entry> {
    let mut words = line.split_whitespace();
    let entry = Entry {
        time: words.next()?,
        level: parse_level(words.next()?)?,
        service: words.next()?,
        status: words.next()?.parse().ok()?,
        millis: words.next()?.parse().ok()?,
        path: words.next()?,
    };
    if words.next().is_some() { return None; } // a seventh word
    Some(entry)
}

// A generic function taking a closure: how many entries match `pred`.
fn count_where<F: Fn(&Entry) -> bool>(entries: &[Entry], pred: F) -> usize {
    entries.iter().filter(|e| pred(e)).count()
}

fn bar(n: usize) -> &'static str {
    let bars = "##############################";
    &bars[..n.min(bars.len())]
}

fn main(gpa: Gpa) -> i32 {
    let input = io::read_to_string_in(io::stdin(), gpa).unwrap();

    // Parse: skip blanks and comments, keep good entries, count bad ones.
    // The closure pushes to `entries` and bumps `bad`: it borrows both
    // mutably (it captures the variables, not copies).
    let mut entries: Vec<Entry, Gpa> = Vec::new_in(gpa);
    let mut bad = 0;
    Lines::new(&input)
        .filter(|l| !l.is_empty() && !l.starts_with('#'))
        .for_each(|l| {
            match parse_entry(l) {
                Some(e) => entries.push(e),
                None => bad += 1,
            }
        });
    let all = entries.as_slice();
    println("{} requests, {bad} malformed line(s) skipped", all.len());
    if all.is_empty() { return 0; }

    // Totals with consumers: count, sum, min, max, fold.
    let errors = count_where(all, |e| e.level == Level::Error);
    let warnings = count_where(all, |e| e.level == Level::Warn);
    let total_ms: i64 = all.iter().map(|e| e.millis).sum();
    let slowest = all.iter().map(|e| e.millis).max().unwrap_or(0);
    let fastest = all.iter().map(|e| e.millis).min().unwrap_or(0);
    let (ok, failed) = all.iter().fold((0, 0), |(ok, failed), e| {
        if e.status < 400 { (ok + 1, failed) } else { (ok, failed + 1) }
    });
    println("levels: {errors} errors, {warnings} warnings");
    println("status: {ok} ok, {failed} failed");
    println("latency: min {fastest} ms, max {slowest} ms, mean {} ms", total_ms / all.len() as i64);

    // Questions: any, all, position.
    let has_5xx = all.iter().any(|e| e.status >= 500);
    let all_fast = all.iter().all(|e| e.millis < 1000);
    println("any 5xx: {has_5xx}, all under a second: {all_fast}");
    if let Some(i) = all.iter().position(|e| e.level == Level::Error) {
        let e = &all[i];
        println("first error: request #{} at {}, {} {} ({})", i + 1, e.time, e.service, e.path,
            e.status);
    }

    // A closure kept in a `let`, borrowing `limit`.
    let limit = 100;
    let is_slow = |e: &Entry| e.millis > limit;
    let mut slow: Vec<Entry, Gpa> = all.iter().copied().filter(is_slow).collect_in(gpa);
    slow.sort_by(|a, b| b.millis.cmp(&a.millis)); // slowest first
    println("slow requests (over {limit} ms): {}, the top 3:", slow.len());
    for (rank, e) in slow.iter().enumerate().take(3) {
        println("  {}. {:>4} ms  {:<5} {}", rank + 1, e.millis, e.service, e.path);
    }

    // Counting with a HashMap, then sorting its pairs: by requests, most
    // first, then by name.
    let mut per_service: HashMap<&str, i64, Gpa> = HashMap::new_in(gpa);
    for e in all { *per_service.entry(e.service).or_insert(0) += 1; }
    let mut ranked: Vec<(&str, i64), Gpa> = per_service
        .iter()
        .map(|(s, n)| (*s, *n))
        .collect_in(gpa);
    ranked.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(b.0)));
    println("requests per service:");
    for (service, n) in &ranked {
        let total: i64 = all.iter().filter(|e| e.service == *service).map(|e| e.millis).sum();
        println("  {service:<6} {n:>3}  {:<6}  mean {} ms", bar(*n as usize), total / n);
    }

    // Two iterators side by side: zip pairs each request with the next
    // one (the shorter one, all[1..], ends the pairs).
    let mut same_second = 0;
    for (a, b) in all.iter().zip(&all[1..]) {
        if a.time == b.time { same_second += 1; }
    }
    println("back-to-back requests in the same second: {same_second}");
    0
}
