// EDITION: rust
// Prints the number of command-line arguments, then each of them, the
// program's own name first. `std::env::args()` iterates over them as
// `&str`s.
use std::env;

fn main() -> i32 {
    println("argc: {}", env::args().count());
    for arg in env::args() {
        println("-- {arg}");
    }
    0
}
