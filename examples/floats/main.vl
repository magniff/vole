// EDITION: rust
// The distance between two points in space, with f64 and C's math
// library: `sqrt` is declared by hand in an extern "C" block (the program
// is linked with -lm), and a format string prints the result with six
// decimals, as C's "%f" would. (std has it too: `x.sqrt()`.)
// UNSAFE: a C function, declared by hand.
// SAFETY: the signature is math.h's: double sqrt(double).
extern "C" {
    fn sqrt(x: f64) -> f64;
}

struct Point { x: f64, y: f64, z: f64 }

impl Point {
    fn distance(&self, other: &Point) -> f64 {
        let dx = self.x - other.x;
        let dy = self.y - other.y;
        let dz = self.z - other.z;
        // UNSAFE: sqrt is C's, from libm.
        // SAFETY: it takes and returns a double by value; nothing to keep valid.
        unsafe { sqrt(dx * dx + dy * dy + dz * dz) }
    }
}

fn main() -> i32 {
    let a = Point { x: 0.0, y: 0.0, z: 0.0 };
    let b = Point { x: 1.0, y: 1.0, z: 1.0 };
    println("{:.6}", a.distance(&b));
    0
}
