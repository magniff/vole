// The WGSL of the demo: one fragment shader that raymarches a distance
// field. The field is the Mandelbulb (power u.power, the usual
// spherical-coordinate iteration) or the quaternion Julia set (the
// constant u.julia), chosen by u.eye.w. Each pixel: a ray from the eye
// through the screen, a sphere test, sphere tracing on the estimate,
// then the normal (tetrahedron gradient), a soft shadow and ambient
// occlusion, and the sky. The uniform block is camera.vl/main.vl's
// `uniforms`, 28 f32s in WGSL's layout.

pub const SHADE: [u8] = "struct U {\n\
    res: vec2<f32>,\n\
    time: f32,\n\
    power: f32,\n\
    eye: vec4<f32>,\n\
    fwd: vec4<f32>,\n\
    right: vec4<f32>,\n\
    up: vec4<f32>,\n\
    julia: vec4<f32>,\n\
    opts: vec4<f32>,\n\
    }\n\
    @group(0) @binding(0) var<uniform> u: U;\n\
    \n\
    // The Mandelbulb's distance estimate (Quilez's form): iterate the\n\
    // power in spherical coordinates, track the derivative dr.\n\
    fn de_bulb(p: vec3<f32>) -> f32 {\n\
    var z = p;\n\
    var dr = 1.0;\n\
    var r = 0.0;\n\
    let n = i32(u.opts.x);\n\
    for (var i = 0; i < n; i = i + 1) {\n\
    r = length(z);\n\
    if (r > 2.0) { break; }\n\
    let rs = max(r, 1e-9);\n\
    let th = acos(clamp(z.z / rs, -1.0, 1.0)) * u.power;\n\
    let ph = atan2(z.y, z.x) * u.power;\n\
    dr = pow(rs, u.power - 1.0) * u.power * dr + 1.0;\n\
    let zr = pow(rs, u.power);\n\
    z = zr * vec3<f32>(sin(th) * cos(ph), sin(ph) * sin(th), cos(th)) + p;\n\
    }\n\
    return 0.5 * log(max(r, 1e-9)) * r / dr;\n\
    }\n\
    \n\
    // A quaternion product.\n\
    fn qmul(a: vec4<f32>, b: vec4<f32>) -> vec4<f32> {\n\
    return vec4<f32>(\n\
    a.x * b.x - a.y * b.y - a.z * b.z - a.w * b.w,\n\
    a.x * b.y + a.y * b.x + a.z * b.w - a.w * b.z,\n\
    a.x * b.z - a.y * b.w + a.z * b.x + a.w * b.y,\n\
    a.x * b.w + a.y * b.z - a.z * b.y + a.w * b.x);\n\
    }\n\
    \n\
    // The quaternion Julia set's distance estimate (Quilez): z -> z^2 + c\n\
    // from z = (p, 0), with the derivative md2 tracked alongside.\n\
    fn de_julia(p: vec3<f32>) -> f32 {\n\
    var z = vec4<f32>(p, 0.0);\n\
    var md2 = 1.0;\n\
    var mz2 = dot(z, z);\n\
    let n = i32(u.opts.x);\n\
    for (var i = 0; i < n; i = i + 1) {\n\
    md2 = md2 * 4.0 * mz2;\n\
    z = qmul(z, z) + u.julia;\n\
    mz2 = dot(z, z);\n\
    if (mz2 > 4.0) { break; }\n\
    }\n\
    return 0.25 * sqrt(mz2 / max(md2, 1e-12)) * log(max(mz2, 1e-12));\n\
    }\n\
    \n\
    fn map(p: vec3<f32>) -> f32 {\n\
    if (u.eye.w < 0.5) { return de_bulb(p); }\n\
    return de_julia(p);\n\
    }\n\
    \n\
    // Sphere tracing from the bounding sphere (radius 2) in: the distance\n\
    // to the surface, or -1 when the ray misses. The step is 0.8 of the\n\
    // estimate, which is not exact for the power's bulbs.\n\
    fn march(ro: vec3<f32>, rd: vec3<f32>) -> f32 {\n\
    let b = dot(ro, rd);\n\
    let c = dot(ro, ro) - 4.0;\n\
    let h = b * b - c;\n\
    if (h < 0.0) { return -1.0; }\n\
    let s = sqrt(h);\n\
    var t = max(-b - s, 0.0);\n\
    let tmax = -b + s;\n\
    for (var i = 0; i < 200; i = i + 1) {\n\
    let d = map(ro + rd * t);\n\
    if (d < 0.0004 * t) { return t; }\n\
    t = t + d * 0.8;\n\
    if (t > tmax) { break; }\n\
    }\n\
    return -1.0;\n\
    }\n\
    \n\
    // The surface normal: the gradient of the estimate, four samples.\n\
    fn normal_at(p: vec3<f32>) -> vec3<f32> {\n\
    let e = vec2<f32>(0.0005, -0.0005);\n\
    return normalize(\n\
    e.xyy * map(p + e.xyy) + e.yyx * map(p + e.yyx) +\n\
    e.yxy * map(p + e.yxy) + e.xxx * map(p + e.xxx));\n\
    }\n\
    \n\
    // A soft shadow toward the light (k sets the softness).\n\
    fn shadow(ro: vec3<f32>, rd: vec3<f32>) -> f32 {\n\
    var res = 1.0;\n\
    var t = 0.01;\n\
    for (var i = 0; i < 48; i = i + 1) {\n\
    let h = map(ro + rd * t);\n\
    res = min(res, 10.0 * h / t);\n\
    t = t + clamp(h, 0.005, 0.1);\n\
    if (res < 0.001 || t > 4.0) { break; }\n\
    }\n\
    let s = clamp(res, 0.0, 1.0);\n\
    return s * s * (3.0 - 2.0 * s);\n\
    }\n\
    \n\
    // Ambient occlusion: how much the estimate falls short along the normal.\n\
    fn occlusion(p: vec3<f32>, n: vec3<f32>) -> f32 {\n\
    var occ = 0.0;\n\
    var sca = 1.0;\n\
    for (var i = 0; i < 5; i = i + 1) {\n\
    let h = 0.01 + 0.12 * f32(i) / 4.0;\n\
    let d = map(p + h * n);\n\
    occ = occ + (h - d) * sca;\n\
    sca = sca * 0.95;\n\
    }\n\
    return clamp(1.0 - 3.0 * occ, 0.0, 1.0);\n\
    }\n\
    \n\
    fn background(rd: vec3<f32>) -> vec3<f32> {\n\
    let k = clamp(0.5 + 0.5 * rd.y, 0.0, 1.0);\n\
    return mix(vec3<f32>(0.10, 0.08, 0.12), vec3<f32>(0.02, 0.03, 0.07), k);\n\
    }\n\
    \n\
    fn palette(t: f32) -> vec3<f32> {\n\
    return 0.5 + 0.5 * cos(6.2831 * (vec3<f32>(0.0, 0.10, 0.20) + t));\n\
    }\n\
    \n\
    @vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {\n\
    var p = vec2<f32>(-1.0, -1.0);\n\
    if (i == 1u) { p = vec2<f32>(3.0, -1.0); }\n\
    if (i == 2u) { p = vec2<f32>(-1.0, 3.0); }\n\
    return vec4<f32>(p, 0.0, 1.0);\n\
    }\n\
    \n\
    @fragment fn fs(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {\n\
    let uv = (pos.xy - 0.5 * u.res) * vec2<f32>(1.0, -1.0) / u.res.y;\n\
    let rd = normalize(u.fwd.xyz * u.fwd.w + u.right.xyz * uv.x + u.up.xyz * uv.y);\n\
    let ro = u.eye.xyz;\n\
    let t = march(ro, rd);\n\
    if (u.opts.w > 0.5) {\n\
    if (t >= 0.0) { return vec4<f32>(1.0, 1.0, 1.0, 1.0); }\n\
    return vec4<f32>(0.0, 0.0, 0.0, 1.0);\n\
    }\n\
    if (t < 0.0) {\n\
    return vec4<f32>(sqrt(background(rd)), 1.0);\n\
    }\n\
    let p = ro + rd * t;\n\
    let n = normal_at(p);\n\
    let light = normalize(vec3<f32>(0.6, 0.8, -0.5));\n\
    var sh = 1.0;\n\
    if (u.opts.y > 0.5) { sh = shadow(p + n * 0.002, light); }\n\
    var ao = 1.0;\n\
    if (u.opts.z > 0.5) { ao = occlusion(p, n); }\n\
    let diff = clamp(dot(n, light), 0.0, 1.0) * sh;\n\
    let sky = 0.5 + 0.5 * n.y;\n\
    let hv = normalize(light - rd);\n\
    let spec = pow(clamp(dot(n, hv), 0.0, 1.0), 48.0) * sh;\n\
    let alb = palette(length(p) * 0.9 + 0.02 * u.time);\n\
    var col = alb * (vec3<f32>(1.0, 0.92, 0.78) * diff * 1.2\n\
    + vec3<f32>(0.25, 0.32, 0.45) * sky * ao * 0.8);\n\
    col = col + vec3<f32>(spec * 0.25 * ao);\n\
    col = mix(col, background(rd), 1.0 - exp(-0.02 * t * t));\n\
    return vec4<f32>(sqrt(clamp(col, vec3<f32>(0.0), vec3<f32>(1.0))), 1.0);\n\
    }\n";
