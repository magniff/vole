// The scene on the CPU: the meshes (a checked floor, cubes and spheres,
// generated from primitives), the orbiting lights, the camera's matrices
// (column-major, [f32; 16]), and their #[test]s. Vertices are 9 floats:
// position, normal, albedo.

const PI: f32 = 3.14159265;

// A deterministic generator: a 64-bit LCG, the high bits.
pub struct Rng {
    s: i64,
}

impl Rng {
    pub fn new(seed: i64) -> Rng {
        Rng { s: seed }
    }

    // in [0, 1)
    pub fn unit(inout self) -> f32 {
        self.s = self.s * 6364136223846793005 + 1442695040888963407;
        ((self.s >> 40) & 16777215) as f32 / 16777216.0
    }

    pub fn range(inout self, lo: f32, hi: f32) -> f32 {
        lo + (hi - lo) * self.unit()
    }
}

pub fn add3(a: [f32; 3], b: [f32; 3]) -> [f32; 3] {
    [a[0] + b[0], a[1] + b[1], a[2] + b[2]]
}

pub fn scale3(a: [f32; 3], s: f32) -> [f32; 3] {
    [a[0] * s, a[1] * s, a[2] * s]
}

pub fn dot3(a: [f32; 3], b: [f32; 3]) -> f32 {
    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
}

pub fn axis(a: i64, s: f32) -> [f32; 3] {
    if a == 0 {
        [s, 0.0, 0.0]
    } else if a == 1 {
        [0.0, s, 0.0]
    } else {
        [0.0, 0.0, s]
    }
}

// The scene's triangles: `verts` is 9 floats a vertex, `idx` u32s.
pub struct Mesh {
    pub verts: Vec<f32>,
    pub idx: Vec<u32>,
}

impl Mesh {
    pub fn new_in(gpa: Gpa) -> Mesh {
        Mesh { verts: Vec::new_in(gpa), idx: Vec::new_in(gpa) }
    }

    pub fn vertex_count(self) -> i64 {
        self.verts.len() / 9
    }

    pub fn index_count(self) -> i64 {
        self.idx.len()
    }

    fn vert(inout self, p: [f32; 3], n: [f32; 3], c: [f32; 3]) {
        for k in 0..3 {
            self.verts.push(p[k]);
        }
        for k in 0..3 {
            self.verts.push(n[k]);
        }
        for k in 0..3 {
            self.verts.push(c[k]);
        }
    }

    // A quad a, b, c, d (in order) with one normal and colour.
    fn quad(inout self, a: [f32; 3], b: [f32; 3], c: [f32; 3], d: [f32; 3],
        n: [f32; 3], col: [f32; 3]) {
        let base = self.vertex_count() as u32;
        self.vert(a, n, col);
        self.vert(b, n, col);
        self.vert(c, n, col);
        self.vert(d, n, col);
        self.idx.push(base);
        self.idx.push(base + 1);
        self.idx.push(base + 2);
        self.idx.push(base);
        self.idx.push(base + 2);
        self.idx.push(base + 3);
    }

    // The floor: side x side units, cells of `cell` units checkered in two
    // greys, at y = 0.
    pub fn floor(inout self, cells: i64, cell: f32) {
        let half = cells as f32 * cell / 2.0;
        let up: [f32; 3] = [0.0, 1.0, 0.0];
        for i in 0..cells {
            for j in 0..cells {
                let x0 = -half + i as f32 * cell;
                let z0 = -half + j as f32 * cell;
                let x1 = x0 + cell;
                let z1 = z0 + cell;
                let g: f32 = if (i + j) % 2 == 0 { 0.52 } else { 0.36 };
                let col = [g, g * 1.02, g * 1.08];
                self.quad([x0, 0.0, z0], [x0, 0.0, z1], [x1, 0.0, z1], [x1, 0.0, z0], up, col);
            }
        }
    }

    // An axis-aligned cube of half size h around c.
    pub fn cube(inout self, c: [f32; 3], h: f32, col: [f32; 3]) {
        for a in 0..3 {
            for side in 0..2 {
                let s: f32 = if side == 0 { -1.0 } else { 1.0 };
                let n = axis(a, s);
                let u = axis((a + 1) % 3, 1.0);
                let w = axis((a + 2) % 3, 1.0);
                let f = add3(c, scale3(n, h));
                let p00 = add3(f, add3(scale3(u, -h), scale3(w, -h)));
                let p10 = add3(f, add3(scale3(u, h), scale3(w, -h)));
                let p11 = add3(f, add3(scale3(u, h), scale3(w, h)));
                let p01 = add3(f, add3(scale3(u, -h), scale3(w, h)));
                self.quad(p00, p10, p11, p01, n, col);
            }
        }
    }

    // A UV sphere of radius r: 12 rings, 18 segments.
    pub fn sphere(inout self, c: [f32; 3], r: f32, col: [f32; 3]) {
        let rings: i64 = 12;
        let segs: i64 = 18;
        let base = self.vertex_count() as u32;
        for i in 0..(rings + 1) {
            let th = PI * (i as f32) / (rings as f32);
            for j in 0..(segs + 1) {
                let ph = 2.0 * PI * (j as f32) / (segs as f32);
                let n = [th.sin() * ph.cos(), th.cos(), th.sin() * ph.sin()];
                self.vert(add3(c, scale3(n, r)), n, col);
            }
        }
        for i in 0..rings {
            for j in 0..segs {
                let a = base + (i * (segs + 1) + j) as u32;
                let b = a + (segs + 1) as u32;
                self.idx.push(a);
                self.idx.push(b);
                self.idx.push(a + 1);
                self.idx.push(a + 1);
                self.idx.push(b);
                self.idx.push(b + 1);
            }
        }
    }
}

// The demo's scene: the floor, 10 cubes and 8 spheres at seeded places.
pub fn build_scene(gpa: Gpa) -> Mesh {
    var m = Mesh::new_in(gpa);
    m.floor(12, 2.0);
    var rng = Rng::new(7);
    for _ in 0..10 {
        let x = rng.range(-8.0, 8.0);
        let z = rng.range(-8.0, 6.0);
        let h = rng.range(0.5, 1.1);
        let col = [rng.range(0.3, 0.95), rng.range(0.3, 0.95), rng.range(0.3, 0.95)];
        m.cube([x, h, z], h, col);
    }
    for _ in 0..8 {
        let x = rng.range(-8.0, 8.0);
        let z = rng.range(-8.0, 6.0);
        let r = rng.range(0.5, 1.1);
        let col = [rng.range(0.4, 1.0), rng.range(0.4, 1.0), rng.range(0.4, 1.0)];
        m.sphere([x, r, z], r, col);
    }
    m
}

// One light on an orbit: around the y axis at `radius`, its height bobbing
// between y and y + bob, `reach` its radius, `color` its colour (linear)
// and `power` its intensity.
pub struct Orbit {
    pub radius: f32,
    pub speed: f32,
    pub phase: f32,
    pub y: f32,
    pub bob: f32,
    pub reach: f32,
    pub color: [f32; 3],
    pub power: f32,
}

// The fully saturated colour of hue h (in turns).
fn hue_channel(h: f32, k: f32) -> f32 {
    var x = h + k;
    x = x - x.floor();
    var y = (x * 6.0 - 3.0).abs() - 1.0;
    if y < 0.0 {
        y = 0.0;
    }
    if y > 1.0 {
        y = 1.0;
    }
    y
}

// n lights with seeded orbits and the hues spread around the wheel.
pub fn make_lights(n: i64, gpa: Gpa) -> Vec<Orbit> {
    var out: Vec<Orbit> = Vec::new_in(gpa);
    var rng = Rng::new(99);
    for i in 0..n {
        let h = i as f32 / n as f32;
        let speed = rng.range(0.15, 0.6) * if i % 2 == 0 { 1.0 } else { -1.0 };
        out.push(Orbit {
            radius: rng.range(1.0, 8.5),
            speed: speed,
            phase: rng.range(0.0, 2.0 * PI),
            y: rng.range(0.3, 2.2),
            bob: rng.range(0.4, 1.2),
            reach: rng.range(1.2, 2.2),
            color: [hue_channel(h, 0.0), hue_channel(h, 2.0 / 3.0), hue_channel(h, 1.0 / 3.0)],
            power: rng.range(0.8, 1.4),
        });
    }
    out
}

// Where the light is in the world at time t (seconds).
pub fn light_at(o: Orbit, t: f32) -> [f32; 3] {
    let a = o.phase + o.speed * t;
    [o.radius * a.cos(), o.y + o.bob * (0.5 + 0.5 * (a * 2.0).sin()), o.radius * a.sin()]
}

// The lights' packed form, 8 floats each: view-space position and reach;
// colour and power. `out` is 8 * lights.len() long.
pub fn pack_lights(lights: [Orbit], t: f32, view: [f32; 16], out: inout Vec<f32>) {
    for i in 0..lights.len() {
        let p = xform_point(view, light_at(lights[i], t));
        let o = lights[i];
        let base = i * 8;
        out[base] = p[0];
        out[base + 1] = p[1];
        out[base + 2] = p[2];
        out[base + 3] = o.reach;
        out[base + 4] = o.color[0];
        out[base + 5] = o.color[1];
        out[base + 6] = o.color[2];
        out[base + 7] = o.power;
    }
}

// Column-major 4 x 4 matrices.
pub fn mat_mul(a: [f32; 16], b: [f32; 16]) -> [f32; 16] {
    var r: [f32; 16] = [0.0; 16];
    for c in 0..4 {
        for row in 0..4 {
            var s: f32 = 0.0;
            for k in 0..4 {
                s = s + a[k * 4 + row] * b[c * 4 + k];
            }
            r[c * 4 + row] = s;
        }
    }
    r
}

pub fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> [f32; 16] {
    let f = 1.0 / (fovy / 2.0).tan();
    [f / aspect, 0.0, 0.0, 0.0,
     0.0, f, 0.0, 0.0,
     0.0, 0.0, (far + near) / (near - far), -1.0,
     0.0, 0.0, 2.0 * far * near / (near - far), 0.0]
}

pub fn look_at(eye: [f32; 3], target: [f32; 3], up: [f32; 3]) -> [f32; 16] {
    let f = norm3(add3(target, scale3(eye, -1.0)));
    let s: [f32; 3] = norm3(cross3(f, up));
    let u = cross3(s, f);
    [s[0], u[0], -f[0], 0.0,
     s[1], u[1], -f[1], 0.0,
     s[2], u[2], -f[2], 0.0,
     -dot3(s, eye), -dot3(u, eye), dot3(f, eye), 1.0]
}

pub fn cross3(a: [f32; 3], b: [f32; 3]) -> [f32; 3] {
    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
}

pub fn norm3(a: [f32; 3]) -> [f32; 3] {
    scale3(a, 1.0 / dot3(a, a).sqrt())
}

// The point p times m, with the divide by w.
pub fn xform_point(m: [f32; 16], p: [f32; 3]) -> [f32; 3] {
    [m[0] * p[0] + m[4] * p[1] + m[8] * p[2] + m[12],
     m[1] * p[0] + m[5] * p[1] + m[9] * p[2] + m[13],
     m[2] * p[0] + m[6] * p[1] + m[10] * p[2] + m[14]]
}

// The homogeneous point p times m (no divide).
pub fn xform4(m: [f32; 16], p: [f32; 4]) -> [f32; 4] {
    var r: [f32; 4] = [0.0; 4];
    for row in 0..4 {
        var s: f32 = 0.0;
        for k in 0..4 {
            s = s + m[k * 4 + row] * p[k];
        }
        r[row] = s;
    }
    r
}

// The direction d times the rotation part of m.
pub fn xform_dir(m: [f32; 16], d: [f32; 3]) -> [f32; 3] {
    [m[0] * d[0] + m[4] * d[1] + m[8] * d[2],
     m[1] * d[0] + m[5] * d[1] + m[9] * d[2],
     m[2] * d[0] + m[6] * d[1] + m[10] * d[2]]
}

// The camera of the demo: where it looks at the scene from.
pub fn view_matrix() -> [f32; 16] {
    look_at([0.0, 6.5, 13.0], [0.0, 0.5, 0.0], [0.0, 1.0, 0.0])
}

#[test]
fn rng_is_in_range() {
    var r = Rng::new(3);
    for _ in 0..1000 {
        let x = r.unit();
        assert(x >= 0.0 && x < 1.0);
    }
}

#[test]
fn scene_counts(gpa: Gpa) {
    let m = build_scene(gpa);
    // floor 12 x 12 cells of 4 vertices; a cube 24; a sphere 13 x 19
    assert_eq(m.vertex_count(), 12 * 12 * 4 + 10 * 24 + 8 * 13 * 19);
    // floor 6, cube 36, sphere 12 x 18 x 6
    assert_eq(m.index_count(), 12 * 12 * 6 + 10 * 36 + 8 * 12 * 18 * 6);
}

#[test]
fn centre_projects_to_the_middle() {
    let m = mat_mul(perspective(0.8, 16.0 / 9.0, 0.1, 80.0), view_matrix());
    // the point the camera looks at: clip x and y are 0, w is in front
    let p: [f32; 4] = [0.0, 0.5, 0.0, 1.0];
    let c = xform4(m, p);
    let eps: f32 = 0.0001;
    assert(c[3] > 0.0);
    assert(c[0].abs() < eps && c[1].abs() < eps);
}

#[test]
fn lights_are_in_front_of_the_camera(gpa: Gpa) {
    let lights = make_lights(512, gpa);
    let view = view_matrix();
    for i in 0..lights.len() {
        let p = xform_point(view, light_at(lights[i], 1.5));
        // view space looks down -z: in front means z < 0
        assert(p[2] < 0.0);
    }
}

#[test]
fn light_colours_are_in_range(gpa: Gpa) {
    let lights = make_lights(256, gpa);
    for i in 0..lights.len() {
        let c = lights[i].color;
        for k in 0..3 {
            assert(c[k] >= 0.0 && c[k] <= 1.0);
        }
    }
}
