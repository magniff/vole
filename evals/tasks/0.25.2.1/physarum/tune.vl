// The parameters the keys change, the mouse's pointer, and the CPU side of
// the checks (the trail's expected total). No GPU here: `volec test`
// runs these.

// The sensors and the turn in radians (the angles), the sensor distance
// in map cells, decay the fraction of the trail that goes each step, and
// diffuse the share of the 3 x 3 blur in the trail's new value.
pub struct Tune {
    pub sensor_angle: f32,
    pub sensor_dist: f32,
    pub turn: f32,
    pub decay: f32,
    pub diffuse: f32,
}

impl Tune {
    pub fn new() -> Tune {
        Tune { sensor_angle: 0.39, sensor_dist: 9.0, turn: 0.79, decay: 0.05, diffuse: 0.5 }
    }

    // Knob k moves one step up (dir > 0) or down, clamped to its range.
    pub fn adjust(inout self, k: i64, dir: i64) {
        let d: f32 = if dir > 0 { 1.0 } else { -1.0 };
        if k == 0 {
            self.sensor_angle = clampf(self.sensor_angle + 0.05 * d, 0.05, 1.5);
        } else if k == 1 {
            self.sensor_dist = clampf(self.sensor_dist + 1.0 * d, 1.0, 40.0);
        } else if k == 2 {
            self.turn = clampf(self.turn + 0.05 * d, 0.01, 1.5);
        } else if k == 3 {
            self.decay = clampf(self.decay + 0.01 * d, 0.0, 0.5);
        } else if k == 4 {
            self.diffuse = clampf(self.diffuse + 0.1 * d, 0.0, 1.0);
        }
    }

    // The knob's current value, as text.
    pub fn value_of(self, k: i64) -> f32 {
        if k == 0 {
            self.sensor_angle
        } else if k == 1 {
            self.sensor_dist
        } else if k == 2 {
            self.turn
        } else if k == 3 {
            self.decay
        } else {
            self.diffuse
        }
    }
}

// The mouse as the kernels see it: a disc of `radius` cells at (x, y),
// adding `amount` a step (positive food, negative repellent). amount 0
// is no pointer.
pub struct Pointer {
    pub x: f32,
    pub y: f32,
    pub radius: f32,
    pub amount: f32,
}

impl Pointer {
    pub fn none() -> Pointer {
        Pointer { x: 0.0, y: 0.0, radius: 1.0, amount: 0.0 }
    }
}

// The key that changes a knob: a letter per knob and direction. Returns
// 2 * knob + 1 for "up", 2 * knob for "down", -1 for no knob.
pub fn knob_key(c: u32) -> i64 {
    if c == 'a' as u32 { 0 }
    else if c == 'z' as u32 { 1 }
    else if c == 's' as u32 { 2 }
    else if c == 'x' as u32 { 3 }
    else if c == 'd' as u32 { 4 }
    else if c == 'c' as u32 { 5 }
    else if c == 'f' as u32 { 6 }
    else if c == 'v' as u32 { 7 }
    else if c == 'g' as u32 { 8 }
    else if c == 'b' as u32 { 9 }
    else { -1 }
}

// The trail's total after one step, if every agent deposits one unit and
// the trail decays by `decay`: the blur keeps the sum, so
// total' = (1 - decay) * (total + agents).
pub fn predicted_total(total: f64, agents: f64, decay: f64) -> f64 {
    (1.0 - decay) * (total + agents)
}

// The relative error of `got` against `want` (0 when both are 0).
pub fn rel_err(got: f64, want: f64) -> f64 {
    let d = if got > want { got - want } else { want - got };
    if want == 0.0 { d } else { d / want }
}

fn clampf(x: f32, lo: f32, hi: f32) -> f32 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

#[test]
fn knobs_clamp_at_their_ends() {
    var t = Tune::new();
    for _ in 0..100 {
        t.adjust(3, -1);
    }
    assert_eq(t.decay, 0.0);
    for _ in 0..100 {
        t.adjust(3, 1);
    }
    assert_eq(t.decay, 0.5);
}

#[test]
fn each_key_moves_its_own_knob() {
    var t = Tune::new();
    let before = t.turn;
    t.adjust(2, 1);
    assert(t.turn > before);
    assert_eq(t.sensor_dist, Tune::new().sensor_dist);
}

#[test]
fn letters_map_to_knobs() {
    assert_eq(knob_key('a' as u32), 0);
    assert_eq(knob_key('c' as u32), 5);
    assert_eq(knob_key('q' as u32), -1);
}

#[test]
fn the_recurrence_settles_at_agents_over_decay() {
    var total = 0.0;
    for _ in 0..2000 {
        total = predicted_total(total, 1000.0, 0.05);
    }
    assert(rel_err(total, 1000.0 * 0.95 / 0.05) < 1e-9);
}

#[test]
fn relative_error_is_zero_for_equal_values() {
    assert_eq(rel_err(3.0, 3.0), 0.0);
    assert_eq(rel_err(0.0, 0.0), 0.0);
}
