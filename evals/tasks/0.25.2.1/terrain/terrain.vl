// The terrain's grid and its level of detail. The vertices are never
// stored: the vertex shader takes each grid point's position and normal
// from the heightmap (shaders.vl), so this module only chooses which
// vertices each block draws, as triangles over the grid.
//
// The grid is CELLS x CELLS cells (VERTS x VERTS points), cut into
// BLOCKS x BLOCKS blocks of BLOCK x BLOCK cells. A block is drawn at a
// step of 1, 2, 4 or 8 cells by its distance from the eye. Neighbouring
// blocks at different steps leave small cracks along their edges (no
// skirts or stitching yet; see README.md).

pub const CELLS: i64 = 256;
pub const VERTS: i64 = 257;
pub const BLOCK: i64 = 16;
pub const BLOCKS: i64 = 16;
// The world's height for a heightmap value of 1.0.
pub const HEIGHT: f32 = 60.0;
// Sea level, in heightmap values (the water sits at SEA * HEIGHT).
pub const SEA: f32 = 0.30;
pub const LOD_STEPS: i64 = 4;

// The step (1, 2, 4, 8 cells) for a block whose centre is `d` world units
// from the eye.
pub fn lod_for(d: f32) -> i64 {
    if d < 48.0 {
        1
    } else if d < 112.0 {
        2
    } else if d < 208.0 {
        4
    } else {
        8
    }
}

// Which of the LOD_STEPS levels a step is: 1 -> 0, 2 -> 1, 4 -> 2, 8 -> 3.
pub fn level_of(step: i64) -> i64 {
    var l = 0;
    var s = step;
    while s > 1 {
        s = s / 2;
        l += 1;
    }
    l
}

// One block as drawn this frame: its range in the index list, and its step.
pub struct Chunk {
    pub start: i64,
    pub count: i64,
    pub step: i64,
}

// The grid's triangles at every LOD, and this frame's choice for each block.
pub struct Mesh {
    // templates[l]: the block's triangles at step 2^l, as offsets from the
    // block's first grid point (the corner at its lowest x and z).
    pub templates: Vec<Vec<u32>>,
    // This frame's indices, every block's triangles one after another.
    pub indices: Vec<u32>,
    pub chunks: Vec<Chunk>,
    // Triangles drawn per LOD level this frame.
    pub tris: [i64; 4],
}

impl Mesh {
    pub fn new_in(gpa: Gpa) -> Mesh {
        var templates: Vec<Vec<u32>> = Vec::new_in(gpa);
        for l in 0..LOD_STEPS {
            templates.push(template(1 << l, gpa));
        }
        Mesh {
            templates: templates,
            indices: Vec::new_in(gpa),
            chunks: Vec::new_in(gpa),
            tris: [0, 0, 0, 0],
        }
    }

    // Chooses every block's step for an eye at `eye` (world units; x and z
    // are the grid's), and fills indices and chunks.
    pub fn select(inout self, eye: [f32; 3]) {
        self.indices.clear();
        self.chunks.clear();
        self.tris = [0, 0, 0, 0];
        for by in 0..BLOCKS {
            for bx in 0..BLOCKS {
                let cx = bx as f32 * BLOCK as f32 + BLOCK as f32 * 0.5;
                let cz = by as f32 * BLOCK as f32 + BLOCK as f32 * 0.5;
                let dx = cx - eye[0];
                let dz = cz - eye[2];
                let step = lod_for((dx * dx + dz * dz).sqrt());
                let l = level_of(step);
                let base = (by * BLOCK) * VERTS + bx * BLOCK;
                let start = self.indices.len();
                for k in self.templates[l].iter() {
                    self.indices.push(base as u32 + k);
                }
                let count = self.indices.len() - start;
                self.chunks.push(Chunk { start: start, count: count, step: step });
                self.tris[l as usize] += count / 3;
            }
        }
    }

    pub fn triangles(self) -> i64 {
        self.tris[0] + self.tris[1] + self.tris[2] + self.tris[3]
    }
}

// The triangles of one block at `step` cells, as offsets from its first
// grid point: each step x step cell is two triangles over its corners.
pub fn template(step: i64, gpa: Gpa) -> Vec<u32> {
    var t: Vec<u32> = Vec::new_in(gpa);
    let w = VERTS;
    var j = 0;
    while j < BLOCK {
        var i = 0;
        while i < BLOCK {
            let a = j * w + i;
            let b = a + step;
            let c = a + step * w;
            let d = c + step;
            t.push(a as u32);
            t.push(c as u32);
            t.push(b as u32);
            t.push(b as u32);
            t.push(c as u32);
            t.push(d as u32);
            i += step;
        }
        j += step;
    }
    t
}

#[test]
fn lod_steps_grow_with_distance() {
    assert_eq(lod_for(10.0), 1);
    assert_eq(lod_for(60.0), 2);
    assert_eq(lod_for(150.0), 4);
    assert_eq(lod_for(900.0), 8);
    assert_eq(level_of(8), 3);
    assert_eq(level_of(1), 0);
}

#[test]
fn a_block_has_two_triangles_per_cell_at_every_step(gpa: Gpa) {
    for l in 0..LOD_STEPS {
        let s = 1 << l;
        let t = template(s, gpa);
        let cells = (BLOCK / s) * (BLOCK / s);
        assert_eq(t.len(), cells * 6);
    }
}

#[test]
fn the_mesh_draws_every_block_at_its_chosen_step(gpa: Gpa) {
    var m = Mesh::new_in(gpa);
    m.select([8.0, 30.0, 8.0]);
    // the block next to the eye is at full detail, the far corner coarse
    assert_eq(m.chunks[0].step, 1);
    assert_eq(m.chunks[(BLOCKS * BLOCKS - 1) as usize].step, 8);
    assert_eq(m.chunks.len(), BLOCKS * BLOCKS);
    assert_eq(m.indices.len(), m.triangles() * 3);
    let limit = VERTS * VERTS;
    for k in m.indices.iter() {
        assert_eq((k as i64) < limit, true);
    }
}
