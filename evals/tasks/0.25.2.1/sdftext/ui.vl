// Immediate-mode widgets. Each frame the program calls the widgets in the
// same order; each call draws the widget (into the canvas) and returns what
// the input did to it. Input for the frame is in Ui.inp: the pointer, its
// button's press and release edges, the wheel, the typed bytes, Backspace.
// Ids name the widget that is hot (under the pointer), active (pressed
// and still held) or focused (the text field taking keys); 0 is none.

use draw::Canvas;

pub static INK: [f32; 4] = [0.92, 0.93, 0.95, 1.0];
pub static DIM: [f32; 4] = [0.55, 0.58, 0.63, 1.0];
pub static ACCENT: [f32; 4] = [0.30, 0.66, 1.0, 1.0];
pub static BUTTON: [f32; 4] = [0.20, 0.23, 0.29, 1.0];
pub static BUTTON_HOT: [f32; 4] = [0.27, 0.31, 0.38, 1.0];
pub static BUTTON_DOWN: [f32; 4] = [0.14, 0.42, 0.72, 1.0];
pub static TRACK: [f32; 4] = [0.14, 0.16, 0.20, 1.0];
pub static PANEL: [f32; 4] = [0.11, 0.12, 0.15, 1.0];
pub static ROW_SELECTED: [f32; 4] = [0.16, 0.36, 0.60, 1.0];
pub static FIELD_FOCUS: [f32; 4] = [0.30, 0.66, 1.0, 1.0];
pub static FIELD: [f32; 4] = [0.08, 0.09, 0.11, 1.0];

// The label size (cap height, logical units) of buttons and fields.
pub const LABEL: f64 = 16.0;
pub const ROW: f64 = 24.0;      // a list row's height
const FIELD_MAX: i64 = 40;      // the longest text a field takes

// What the input did this frame.
pub struct Input {
    pub mx: f64,
    pub my: f64,
    pub down: bool,         // the left button is held
    pub pressed: bool,      // it went down this frame
    pub released: bool,     // it went up this frame
    pub wheel: f64,         // lines; positive scrolls up
    pub typed: Vec<u8>,     // the text typed this frame (UTF-8)
    pub backspace: bool,
}

impl Input {
    pub fn new_in(gpa: Gpa) -> Input {
        Input { mx: -1.0, my: -1.0, down: false, pressed: false, released: false, wheel: 0.0,
            typed: Vec::new_in(gpa), backspace: false }
    }

    // The edges and the typed text are for one frame only.
    pub fn end_frame(inout self) {
        self.pressed = false;
        self.released = false;
        self.wheel = 0.0;
        self.typed.clear();
        self.backspace = false;
    }
}

pub fn inside(px: f64, py: f64, x: f64, y: f64, w: f64, h: f64) -> bool {
    px >= x && px < x + w && py >= y && py < y + h
}

pub struct Ui {
    pub inp: Input,
    pub hot: i64,
    pub active: i64,
    pub focus: i64,
}

impl Ui {
    pub fn new_in(gpa: Gpa) -> Ui {
        Ui { inp: Input::new_in(gpa), hot: 0, active: 0, focus: 0 }
    }

    // Called at the start of each frame: nothing is hot until a widget says so.
    pub fn begin(inout self) {
        self.hot = 0;
    }

    // Called at the end of each frame: the input's edges are used up.
    pub fn end(inout self) {
        self.inp.end_frame();
    }

    // A push button. True on the frame the button is released over it.
    pub fn button(inout self, cv: inout Canvas, id: i64, x: f64, y: f64, w: f64, h: f64,
        label: [u8]) -> bool {
        let over = inside(self.inp.mx, self.inp.my, x, y, w, h);
        if over {
            self.hot = id;
        }
        if over && self.inp.pressed {
            self.active = id;
        }
        var clicked = false;
        if self.active == id && self.inp.released {
            clicked = over;
            self.active = 0;
        }
        var fill = BUTTON;
        if self.active == id && self.inp.down {
            fill = BUTTON_DOWN;
        } else if self.hot == id {
            fill = BUTTON_HOT;
        }
        cv.rect(x, y, w, h, fill);
        let tw = Canvas::text_width(label, LABEL) - LABEL * 0.1;
        cv.text(label, x + (w - tw) / 2.0, y + (h - LABEL) / 2.0, LABEL, 0.0, INK);
        clicked
    }

    // A horizontal slider over 0..1. Returns the new value; it follows the
    // pointer while the button is held on it.
    pub fn slider(inout self, cv: inout Canvas, id: i64, x: f64, y: f64, w: f64, h: f64,
        value: f64) -> f64 {
        let over = inside(self.inp.mx, self.inp.my, x, y, w, h);
        if over {
            self.hot = id;
        }
        if over && self.inp.pressed {
            self.active = id;
        }
        var v = value;
        if self.active == id {
            if self.inp.down {
                v = ((self.inp.mx - x) / w).clamp(0.0, 1.0);
            } else {
                self.active = 0;
            }
        }
        let mid = y + h / 2.0;
        cv.rect(x, mid - 3.0, w, 6.0, TRACK);
        cv.rect(x, mid - 3.0, w * v, 6.0, ACCENT);
        var knob = BUTTON_HOT;
        if self.active == id || self.hot == id {
            knob = INK;
        }
        cv.rect(x + w * v - 8.0, mid - 11.0, 16.0, 22.0, knob);
        v
    }

    // A one-line text field. It takes the typed bytes while it has focus.
    pub fn field(inout self, cv: inout Canvas, id: i64, x: f64, y: f64, w: f64, h: f64,
        text: inout Vec<u8>) {
        let over = inside(self.inp.mx, self.inp.my, x, y, w, h);
        if over {
            self.hot = id;
        }
        if self.inp.pressed {
            if over {
                self.focus = id;
            } else if self.focus == id {
                self.focus = 0;
            }
        }
        if self.focus == id {
            for i in 0..self.inp.typed.len() {
                if text.len() < FIELD_MAX {
                    text.push(self.inp.typed[i]);
                }
            }
            if self.inp.backspace && text.len() > 0 {
                text.truncate(text.len() - 1);
            }
        }
        cv.rect(x, y, w, h, if self.focus == id { FIELD_FOCUS } else { BUTTON });
        cv.rect(x + 2.0, y + 2.0, w - 4.0, h - 4.0, FIELD);
        cv.clip(x + 2.0, y, w - 4.0, h);
        cv.text(text.as_slice(), x + 10.0, y + (h - LABEL) / 2.0, LABEL, 0.0, INK);
        cv.unclip();
        if self.focus == id {
            let tw = Canvas::text_width(text.as_slice(), LABEL) - LABEL * 0.1;
            cv.rect(x + 12.0 + tw, y + 7.0, 2.0, h - 14.0, ACCENT);
        }
    }

    // A scrolling list of n rows labelled ITEM 0.. . `scroll` is the offset
    // in logical units, `selected` the row picked by a click (-1: none).
    pub fn list(inout self, cv: inout Canvas, id: i64, x: f64, y: f64, w: f64, h: f64,
        n: i64, scroll: inout f64, selected: inout i64, gpa: Gpa) {
        let over = inside(self.inp.mx, self.inp.my, x, y, w, h);
        if over {
            self.hot = id;
        }
        let content = n as f64 * ROW;
        let top_max = (content - h).max(0.0);
        if over && self.inp.wheel != 0.0 {
            scroll = (scroll - self.inp.wheel * ROW * 3.0).clamp(0.0, top_max);
        }
        if over && self.inp.pressed {
            let row = ((self.inp.my - y + scroll) / ROW).floor() as i64;
            if row >= 0 && row < n {
                selected = row;
            }
        }
        cv.rect(x, y, w, h, PANEL);
        cv.clip(x, y, w, h);
        for i in 0..n {
            let top = y + i as f64 * ROW - scroll;
            if top + ROW < y || top > y + h {
                continue;
            }
            if i == selected {
                cv.rect(x, top, w - 8.0, ROW, ROW_SELECTED);
            }
            let label = format_in(f"ITEM {i}", gpa);
            cv.text(label.as_slice(), x + 10.0, top + (ROW - 14.0) / 2.0, 14.0, 0.0, INK);
        }
        cv.unclip();
        if top_max > 0.0 {
            let thumb = (h * h / content).max(20.0);
            let at = y + (h - thumb) * scroll / top_max;
            cv.rect(x + w - 6.0, at, 4.0, thumb, DIM);
        }
    }
}

#[test]
fn inside_is_half_open() {
    assert_eq(inside(10.0, 10.0, 10.0, 10.0, 5.0, 5.0), true);
    assert_eq(inside(15.0, 10.0, 10.0, 10.0, 5.0, 5.0), false);
    assert_eq(inside(9.9, 12.0, 10.0, 10.0, 5.0, 5.0), false);
}

#[test]
fn button_clicks_on_release_over_it(gpa: Gpa) {
    var ui = Ui::new_in(gpa);
    var cv = Canvas::new_in(gpa, 1.0);
    ui.inp.mx = 15.0;
    ui.inp.my = 15.0;
    ui.begin();
    ui.inp.pressed = true;
    ui.inp.down = true;
    assert_eq(ui.button(&cv, 7, 10.0, 10.0, 20.0, 20.0, "X"), false);
    ui.end();
    // released away from the button: no click, and the button is no longer active
    ui.inp.mx = 90.0;
    ui.begin();
    ui.inp.down = false;
    ui.inp.released = true;
    assert_eq(ui.button(&cv, 7, 10.0, 10.0, 20.0, 20.0, "X"), false);
    assert_eq(ui.active, 0);
    ui.end();
    // pressed and released over it: one click
    ui.inp.mx = 15.0;
    ui.begin();
    ui.inp.pressed = true;
    ui.inp.down = true;
    assert_eq(ui.button(&cv, 7, 10.0, 10.0, 20.0, 20.0, "X"), false);
    ui.end();
    ui.begin();
    ui.inp.down = false;
    ui.inp.released = true;
    assert_eq(ui.button(&cv, 7, 10.0, 10.0, 20.0, 20.0, "X"), true);
    ui.end();
}
