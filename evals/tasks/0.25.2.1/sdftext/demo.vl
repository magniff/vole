// The page: a column of text samples at several sizes and angles, and a
// column of widgets (a counter, a slider, a text field, a scrolling list).
// Coordinates are logical, in a W x H page; the window and the headless
// render lay it out the same way.

use draw::Canvas;
use ui::{ACCENT, DIM, INK, Ui};

pub const W: f64 = 800.0;
pub const H: f64 = 580.0;
// The widget column starts this far from the page's right edge.
pub const COLUMN: f64 = 288.0;

pub const ID_MINUS: i64 = 1;
pub const ID_PLUS: i64 = 2;
pub const ID_RESET: i64 = 3;
pub const ID_SLIDER: i64 = 4;
pub const ID_FIELD: i64 = 5;
pub const ID_LIST: i64 = 6;
pub const LIST_ROWS: i64 = 40;

// The sample lines: each at its cap height, from the title down.
pub static SIZES: [f64; 5] = [14.0, 20.0, 32.0, 48.0, 72.0];
pub const SAMPLES: [[u8]; 5] = [
    "THE QUICK BROWN FOX",
    "THE QUICK BROWN",
    "VOLE 0123",
    "SDF 2026",
    "VOLE",
];
// The turned line: its angles in degrees, at 28.
pub static ANGLES: [f64; 4] = [0.0, 10.0, 20.0, 30.0];

pub struct Demo {
    pub ui: Ui,
    pub count: i64,
    pub slider: f64,
    pub field: Vec<u8>,
    pub scroll: f64,
    pub selected: i64,
}

// The left edge of the widget column in a page of width w.
pub fn column_x(w: f64) -> f64 {
    w - COLUMN
}

// The place of each widget, for the headless scenario's pointer.
pub fn minus_at(w: f64) -> [f64; 4] { [column_x(w), 84.0, 64.0, 36.0] }
pub fn plus_at(w: f64) -> [f64; 4] { [column_x(w) + 76.0, 84.0, 64.0, 36.0] }
pub fn reset_at(w: f64) -> [f64; 4] { [column_x(w) + 152.0, 84.0, 104.0, 36.0] }
pub fn slider_at(w: f64) -> [f64; 4] { [column_x(w), 164.0, 256.0, 24.0] }
pub fn field_at(w: f64) -> [f64; 4] { [column_x(w), 226.0, 256.0, 40.0] }
pub fn list_at(w: f64) -> [f64; 4] { [column_x(w), 306.0, 256.0, 230.0] }

impl Demo {
    pub fn new_in(gpa: Gpa) -> Demo {
        Demo { ui: Ui::new_in(gpa), count: 0, slider: 0.5, field: Vec::new_in(gpa), scroll: 0.0,
            selected: -1 }
    }

    // Draws one frame into cv from the input in self.ui.inp, then clears the
    // input's edges.
    pub fn frame(inout self, cv: inout Canvas, gpa: Gpa) {
        self.ui.begin();
        let x = column_x(W);

        // the left column: the title and the samples
        cv.text("SDF TEXT", 24.0, 22.0, 36.0, 0.0, INK);
        cv.text("ONE ATLAS  ANY SIZE AND ANGLE", 24.0, 66.0, 14.0, 0.0, DIM);
        var y = 100.0;
        for k in 0..SIZES.len() {
            cv.text(SAMPLES[k], 24.0, y, SIZES[k], 0.0, INK);
            y += SIZES[k] * 1.5 + 8.0;
        }
        for k in 0..ANGLES.len() {
            let a = ANGLES[k] * f64::consts::PI / 180.0;
            cv.text("TURN", 24.0 + k as f64 * 120.0, 430.0, 28.0, a, ACCENT);
        }
        let readout = format_in(f"SLIDER {(self.slider * 100.0).round()}  COUNT {self.count}  ROW {self.selected}", gpa);
        cv.text(readout.as_slice(), 24.0, 508.0, 16.0, 0.0, INK);
        cv.text("+ AND - BUTTONS  DRAG THE SLIDER  TYPE IN THE BOX  WHEEL THE LIST", 24.0, 552.0, 12.0, 0.0, DIM);

        // the widget column
        let counter = format_in(f"COUNT {self.count}", gpa);
        cv.text(counter.as_slice(), x, 60.0, 14.0, 0.0, DIM);
        let minus = minus_at(W);
        let plus = plus_at(W);
        let reset = reset_at(W);
        if self.ui.button(&cv, ID_MINUS, minus[0], minus[1], minus[2], minus[3], "-") {
            self.count -= 1;
        }
        if self.ui.button(&cv, ID_PLUS, plus[0], plus[1], plus[2], plus[3], "+") {
            self.count += 1;
        }
        if self.ui.button(&cv, ID_RESET, reset[0], reset[1], reset[2], reset[3], "RESET") {
            self.count = 0;
        }

        let pct = (self.slider * 100.0).round();
        let sl = format_in(f"SLIDER {pct}", gpa);
        cv.text(sl.as_slice(), x, 140.0, 14.0, 0.0, DIM);
        let s = slider_at(W);
        self.slider = self.ui.slider(&cv, ID_SLIDER, s[0], s[1], s[2], s[3], self.slider);

        cv.text("TEXT", x, 206.0, 14.0, 0.0, DIM);
        let f = field_at(W);
        self.ui.field(&cv, ID_FIELD, f[0], f[1], f[2], f[3], &self.field);

        cv.text("LIST", x, 286.0, 14.0, 0.0, DIM);
        let l = list_at(W);
        self.ui.list(&cv, ID_LIST, l[0], l[1], l[2], l[3], LIST_ROWS, &self.scroll,
            &self.selected, gpa);

        self.ui.end();
    }
}
