// A CPU canvas for the chat's picture: W x H pixels as 0x00RRGGBB, drawn
// with rectangles and the 5 x 7 font, shown by the window's shader (and
// written as a PPM for --shot).

use font::GLYPHS;

pub const W: i64 = 1024;
pub const H: i64 = 640;

pub struct Canvas {
    pub px: Vec<u32>,
}

impl Canvas {
    pub fn new_in(gpa: Gpa) -> Canvas {
        Canvas { px: Vec::filled_in(W * H, 0, gpa) }
    }

    pub fn clear(inout self, c: u32) {
        for i in 0..W * H {
            self.px[i] = c;
        }
    }

    // A filled rectangle, clipped to the canvas.
    pub fn rect(inout self, x: i64, y: i64, w: i64, h: i64, c: u32) {
        let x0 = if x < 0 { 0 } else { x };
        let y0 = if y < 0 { 0 } else { y };
        let x1 = if x + w > W { W } else { x + w };
        let y1 = if y + h > H { H } else { y + h };
        var yy = y0;
        while yy < y1 {
            var xx = x0;
            while xx < x1 {
                self.px[yy * W + xx] = c;
                xx += 1;
            }
            yy += 1;
        }
    }

    // One character at (x, y), each font pixel `scale` pixels square.
    pub fn glyph(inout self, x: i64, y: i64, scale: i64, ch: u8, c: u32) {
        var g: i64 = 63 - 32;
        if ch >= 32 && ch <= 126 {
            g = ch as i64 - 32;
        }
        let w0 = GLYPHS[g * 2];
        let w1 = GLYPHS[g * 2 + 1];
        for col in 0..5 {
            let bits = if col < 4 { (w0 >> ((col * 8) as u32)) & 255 } else { w1 & 255 };
            for row in 0..7 {
                if (bits >> (row as u32)) & 1 == 1 {
                    self.rect(x + col * scale, y + row * scale, scale, scale, c);
                }
            }
        }
    }

    // Text from (x, y) with a character cell of 6 x 8 font pixels; a
    // non-ASCII byte shows as '?' (only the lead of a character).
    pub fn text(inout self, x: i64, y: i64, scale: i64, s: [u8], c: u32) {
        var cx = x;
        for b in s {
            if b < 128 {
                if b >= 32 {
                    self.glyph(cx, y, scale, b, c);
                }
                cx += 6 * scale;
            } else if b >= 192 {
                self.glyph(cx, y, scale, 63, c);
                cx += 6 * scale;
            }
        }
    }

    // The picture as a binary PPM file.
    pub fn write_ppm(self, path: [u8], gpa: Gpa) -> bool {
        var out = Buf::new_in(gpa);
        out.push_str("P6\n1024 640\n255\n");
        for i in 0..W * H {
            let c = self.px[i];
            out.push(((c >> 16) & 255) as u8);
            out.push(((c >> 8) & 255) as u8);
            out.push((c & 255) as u8);
        }
        match std::fs::write(path, out.as_slice()) {
            Ok(_) => true,
            Err(_) => false,
        }
    }
}
