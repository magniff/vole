// Sampling: greedy, or temperature with a top-p cut, over the 64 most
// likely tokens; and a small xorshift generator (no clock in it, so a
// seed gives the same text every time).

use check::top_k;

pub struct Rng {
    pub s: u64,
}

impl Rng {
    pub fn new(seed: u64) -> Rng {
        Rng { s: if seed == 0 { 88172645463325252 } else { seed } }
    }

    // The next uniform number in [0, 1).
    pub fn next_unit(inout self) -> f64 {
        var x = self.s;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        self.s = x;
        ((x >> 11) as f64) / 9007199254740992.0
    }
}

// The next token from logits lg: the argmax when temp <= 0, else a draw
// from softmax(lg / temp) cut to the smallest set of likeliest tokens
// whose probability reaches top_p.
pub fn sample(lg: [f32], temp: f64, top_p: f64, rng: inout Rng, gpa: Gpa) -> i64 {
    if temp <= 0.0 {
        return check::argmax(lg);
    }
    let cand = top_k(lg, 64, gpa);
    let top = lg[cand.get(0)] as f64;
    var w: Vec<f64> = Vec::new_in(gpa);
    var total = 0.0;
    for j in 0..cand.len() {
        let p = ((lg[cand.get(j)] as f64 - top) / temp).exp();
        w.push(p);
        total += p;
    }
    // the nucleus: the first k whose cumulative share reaches top_p
    var k = 0;
    var acc = 0.0;
    while k < w.len() {
        acc += w.get(k) / total;
        k += 1;
        if acc >= top_p {
            break;
        }
    }
    var mass = 0.0;
    for j in 0..k {
        mass += w.get(j);
    }
    let r = rng.next_unit() * mass;
    var run = 0.0;
    for j in 0..k {
        run += w.get(j);
        if r < run {
            return cand.get(j);
        }
    }
    cand.get(k - 1)
}
