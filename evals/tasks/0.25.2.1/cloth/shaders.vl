// The WGSL of the cloth. COMMON (the uniform, the lighting and the camera's
// projection) is in front of every module; each kernel or draw adds its own
// bindings. A particle is a vec4: xyz and its inverse mass w (0: pinned).
// The grid is n x n, index i = y * n + x.

pub const COMMON: [u8] = "struct U {\n\
    a: vec4<f32>,\n\
    g: vec4<f32>,\n\
    wind: vec4<f32>,\n\
    sphere: vec4<f32>,\n\
    k: vec4<f32>,\n\
    grab: vec4<f32>,\n\
    eye: vec4<f32>,\n\
    right: vec4<f32>,\n\
    up: vec4<f32>,\n\
    fwd: vec4<f32>,\n\
    proj: vec4<f32>,\n\
    light: vec4<f32>,\n\
    misc: vec4<f32>,\n\
    }\n\
    @group(0) @binding(0) var<uniform> u: U;\n\
    fn shade(n: vec3<f32>, view: vec3<f32>, albedo: vec3<f32>) -> vec3<f32> {\n\
    let l = normalize(u.light.xyz);\n\
    let diff = max(dot(n, l), 0.0);\n\
    let h = normalize(l + view);\n\
    let spec = pow(max(dot(n, h), 0.0), 48.0) * 0.25;\n\
    let amb = 0.22 + 0.12 * max(n.y, 0.0);\n\
    return albedo * (amb + 0.85 * diff) + vec3<f32>(spec, spec, spec);\n\
    }\n\
    fn project(p: vec3<f32>) -> vec4<f32> {\n\
    let d = p - u.eye.xyz;\n\
    let vz = dot(d, u.fwd.xyz);\n\
    let vx = dot(d, u.right.xyz);\n\
    let vy = dot(d, u.up.xyz);\n\
    let t = u.fwd.w;\n\
    let near = u.proj.y;\n\
    let far = u.proj.z;\n\
    return vec4<f32>(vx / (t * u.proj.x), vy / t, far / (far - near) * (vz - near), vz);\n\
    }\n";

// Predict: the velocity from the last substep (x - prev) / h, damped, plus
// gravity and wind; x moves by it. prev takes the x it started from.
pub const PREDICT: [u8] = "@group(0) @binding(1) var<storage, read_write> pos: array<vec4<f32>>;\n\
    @group(0) @binding(2) var<storage, read_write> prev: array<vec4<f32>>;\n\
    @group(0) @binding(3) var<storage, read> nrm: array<vec4<f32>>;\n\
    @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    let i = id.x;\n\
    let n = u32(u.a.z);\n\
    if (i >= n * n) { return; }\n\
    let p = pos[i];\n\
    let x = p.xyz;\n\
    let h = u.a.x;\n\
    let v = (x - prev[i].xyz) / h;\n\
    prev[i] = vec4<f32>(x, 0.0);\n\
    if (p.w == 0.0) { return; }\n\
    var acc = u.g.xyz;\n\
    if (u.wind.w > 0.5) {\n\
    let nn = normalize(nrm[i].xyz);\n\
    let gust = 0.6 + 0.4 * sin(1.3 * u.a.y + 2.0 * x.x + 0.7 * x.y);\n\
    acc = acc + u.wind.xyz * (u.g.w * abs(dot(nn, u.wind.xyz)) * gust);\n\
    }\n\
    let vn = v * max(0.0, 1.0 - u.k.z * h) + acc * h;\n\
    pos[i] = vec4<f32>(x + vn * h, p.w);\n\
    }\n";

// Solve (Jacobi with averaging): every particle reads its 4 stretch and 4
// bend neighbours in src and writes its corrected x to dst. A constraint
// asks each end to move by its share (w / (w_i + w_j)) of the error; the
// corrections are averaged with the constraints' stiffness as weights.
pub const SOLVE: [u8] = "@group(0) @binding(1) var<storage, read> src: array<vec4<f32>>;\n\
    @group(0) @binding(2) var<storage, read_write> dst: array<vec4<f32>>;\n\
    fn nbr(d: i32, m: i32) -> vec2<i32> {\n\
    if (d == 0) { return vec2<i32>(m, 0); }\n\
    if (d == 1) { return vec2<i32>(-m, 0); }\n\
    if (d == 2) { return vec2<i32>(0, m); }\n\
    return vec2<i32>(0, -m);\n\
    }\n\
    @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    let n = i32(u.a.z);\n\
    let i = i32(id.x);\n\
    if (i >= n * n) { return; }\n\
    let p = src[i];\n\
    if (p.w == 0.0) {\n\
    dst[i] = p;\n\
    return;\n\
    }\n\
    let gx = i % n;\n\
    let gy = i / n;\n\
    let rest = u.proj.w;\n\
    var corr = vec3<f32>(0.0, 0.0, 0.0);\n\
    var wsum = 0.0;\n\
    for (var s: i32 = 0; s < 8; s = s + 1) {\n\
    var m: i32 = 1;\n\
    var kk = u.k.x;\n\
    var len0 = rest;\n\
    if (s >= 4) {\n\
    m = 2;\n\
    kk = u.k.y;\n\
    len0 = 2.0 * rest;\n\
    }\n\
    let q = nbr(s % 4, m);\n\
    let jx = gx + q.x;\n\
    let jy = gy + q.y;\n\
    if (jx >= 0 && jx < n && jy >= 0 && jy < n) {\n\
    let o = src[jy * n + jx];\n\
    let d = o.xyz - p.xyz;\n\
    let len = length(d);\n\
    let sum = p.w + o.w;\n\
    if (len > 1e-7 && sum > 0.0) {\n\
    corr = corr + kk * (p.w / sum) * (len - len0) * (d / len);\n\
    }\n\
    wsum = wsum + kk;\n\
    }\n\
    }\n\
    var x = p.xyz;\n\
    if (wsum > 0.0) { x = x + u.misc.x * corr / wsum; }\n\
    dst[i] = vec4<f32>(x, p.w);\n\
    }\n";

// Collide: the sphere and the floor push a particle out (in place), and the
// grabbed particle is held at the mouse's target.
pub const COLLIDE: [u8] = "@group(0) @binding(1) var<storage, read_write> pos: array<vec4<f32>>;\n\
    @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    let i = id.x;\n\
    let n = u32(u.a.z);\n\
    if (i >= n * n) { return; }\n\
    let p = pos[i];\n\
    var x = p.xyz;\n\
    let d = x - u.sphere.xyz;\n\
    let l = length(d);\n\
    if (l < u.sphere.w && l > 1e-7) { x = u.sphere.xyz + d * (u.sphere.w / l); }\n\
    if (x.y < u.k.w) { x.y = u.k.w; }\n\
    if (f32(i) == u.grab.w) { x = u.grab.xyz; }\n\
    pos[i] = vec4<f32>(x, p.w);\n\
    }\n";

// Normals from the grid's neighbours (central differences, clamped at the
// edges): cross(d/dx, d/dy), (0, 0, 1) where the cloth is folded flat.
pub const NORMAL: [u8] = "@group(0) @binding(1) var<storage, read> pos: array<vec4<f32>>;\n\
    @group(0) @binding(2) var<storage, read_write> nrm: array<vec4<f32>>;\n\
    @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    let n = i32(u.a.z);\n\
    let i = i32(id.x);\n\
    if (i >= n * n) { return; }\n\
    let gx = i % n;\n\
    let gy = i / n;\n\
    let xl = max(gx - 1, 0);\n\
    let xr = min(gx + 1, n - 1);\n\
    let yd = max(gy - 1, 0);\n\
    let yu = min(gy + 1, n - 1);\n\
    let tx = pos[gy * n + xr].xyz - pos[gy * n + xl].xyz;\n\
    let ty = pos[yu * n + gx].xyz - pos[yd * n + gx].xyz;\n\
    var nn = cross(ty, tx);\n\
    let l = length(nn);\n\
    if (l > 1e-12) { nn = nn / l; } else { nn = vec3<f32>(0.0, 0.0, 1.0); }\n\
    nrm[i] = vec4<f32>(nn, 0.0);\n\
    }\n";

// The cloth as two triangles per grid cell (vertex_index), lit from both
// sides: a back face (the side turned from the eye) is bluer.
pub const CLOTH: [u8] = "@group(0) @binding(1) var<storage, read> pos: array<vec4<f32>>;\n\
    @group(0) @binding(2) var<storage, read> nrm: array<vec4<f32>>;\n\
    struct Cv { @builtin(position) clip: vec4<f32>, @location(0) wp: vec3<f32>, @location(1) nn: vec3<f32> }\n\
    @vertex fn vs_cloth(@builtin(vertex_index) vi: u32) -> Cv {\n\
    let n = u32(u.a.z);\n\
    let q = vi / 6u;\n\
    let k = vi % 6u;\n\
    let qx = q % (n - 1u);\n\
    let qy = q / (n - 1u);\n\
    var dx = 0u;\n\
    var dy = 0u;\n\
    if (k == 1u || k == 4u || k == 5u) { dx = 1u; }\n\
    if (k == 2u || k == 3u || k == 5u) { dy = 1u; }\n\
    let idx = (qy + dy) * n + (qx + dx);\n\
    let p = pos[idx].xyz;\n\
    return Cv(project(p), p, nrm[idx].xyz);\n\
    }\n\
    @fragment fn fs_cloth(v: Cv) -> @location(0) vec4<f32> {\n\
    let view = normalize(u.eye.xyz - v.wp);\n\
    var n = normalize(v.nn);\n\
    var albedo = vec3<f32>(0.90, 0.45, 0.20);\n\
    if (dot(n, view) < 0.0) {\n\
    n = -n;\n\
    albedo = vec3<f32>(0.30, 0.55, 0.90);\n\
    }\n\
    let c = shade(n, view, albedo);\n\
    return vec4<f32>(sqrt(clamp(c, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0))), 1.0);\n\
    }\n";

// The sphere (a 32 x 24 latitude-longitude mesh: 4608 vertices) and then the
// floor (a 8 x 8 square, two triangles); tag 1 marks the floor.
pub const SOLID: [u8] = "struct Sv { @builtin(position) clip: vec4<f32>, @location(0) wp: vec3<f32>, @location(1) nn: vec3<f32>, @location(2) tag: f32 }\n\
    fn corner(k: u32) -> vec2<u32> {\n\
    var dx = 0u;\n\
    var dy = 0u;\n\
    if (k == 1u || k == 4u || k == 5u) { dx = 1u; }\n\
    if (k == 2u || k == 3u || k == 5u) { dy = 1u; }\n\
    return vec2<u32>(dx, dy);\n\
    }\n\
    @vertex fn vs_solid(@builtin(vertex_index) vi: u32) -> Sv {\n\
    if (vi < 4608u) {\n\
    let c = corner(vi % 6u);\n\
    let q = vi / 6u;\n\
    let lon = f32(q % 32u + c.x) / 32.0 * 6.2831853;\n\
    let lat = (f32(q / 32u + c.y) / 24.0 - 0.5) * 3.1415927;\n\
    let dir = vec3<f32>(cos(lat) * cos(lon), sin(lat), cos(lat) * sin(lon));\n\
    let p = u.sphere.xyz + dir * u.sphere.w;\n\
    return Sv(project(p), p, dir, 0.0);\n\
    }\n\
    let c = corner((vi - 4608u) % 6u);\n\
    let p = vec3<f32>(-4.0 + 8.0 * f32(c.x), u.k.w, -4.0 + 8.0 * f32(c.y));\n\
    return Sv(project(p), p, vec3<f32>(0.0, 1.0, 0.0), 1.0);\n\
    }\n\
    @fragment fn fs_solid(v: Sv) -> @location(0) vec4<f32> {\n\
    let view = normalize(u.eye.xyz - v.wp);\n\
    var albedo = vec3<f32>(0.80, 0.82, 0.86);\n\
    if (v.tag > 0.5) {\n\
    let s = floor(v.wp.x) + floor(v.wp.z);\n\
    let k = s - 2.0 * floor(s * 0.5);\n\
    albedo = mix(vec3<f32>(0.26, 0.28, 0.32), vec3<f32>(0.42, 0.44, 0.50), k);\n\
    }\n\
    let c = shade(normalize(v.nn), view, albedo);\n\
    return vec4<f32>(sqrt(clamp(c, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0))), 1.0);\n\
    }\n";
