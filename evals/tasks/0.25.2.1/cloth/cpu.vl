// The CPU side of the cloth, with no GPU in it: vectors, the camera (the
// same projection the shaders make), picking and the drag's point, the
// scene's uniform (packed as the shaders read it), the moving sphere, the
// start state, and the numbers the headless run checks.

// The field of view: the screen's half height is TAN_HALF times the depth.
pub const TAN_HALF: f32 = 0.5;
// The cloth: SIZE metres square, its top edge at TOP, pinned at the two top corners.
pub const SIZE: f32 = 2.0;
pub const TOP: f32 = 1.3;

// The wind's direction (a unit vector) below.
pub fn wind_dir() -> V3 {
    v3(0.8, 0.0, 0.6)
}

pub struct V3 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
}

pub fn v3(x: f32, y: f32, z: f32) -> V3 {
    V3 { x: x, y: y, z: z }
}

pub fn add(a: V3, b: V3) -> V3 {
    v3(a.x + b.x, a.y + b.y, a.z + b.z)
}

pub fn sub(a: V3, b: V3) -> V3 {
    v3(a.x - b.x, a.y - b.y, a.z - b.z)
}

pub fn scale(a: V3, s: f32) -> V3 {
    v3(a.x * s, a.y * s, a.z * s)
}

pub fn dot(a: V3, b: V3) -> f32 {
    a.x * b.x + a.y * b.y + a.z * b.z
}

pub fn cross(a: V3, b: V3) -> V3 {
    v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
}

pub fn norm(a: V3) -> V3 {
    let l = dot(a, a).sqrt();
    if l > 0.0 { scale(a, 1.0 / l) } else { a }
}

// The camera: an orbit around `target`, `dist` away, at yaw and pitch (radians).
pub struct Camera {
    pub yaw: f32,
    pub pitch: f32,
    pub dist: f32,
    pub target: V3,
}

impl Camera {
    pub fn new() -> Camera {
        Camera { yaw: 0.30, pitch: 0.12, dist: 4.4, target: v3(0.0, 0.05, 0.0) }
    }

    pub fn eye(self) -> V3 {
        let c = self.pitch.cos();
        add(self.target, v3(self.dist * c * self.yaw.sin(), self.dist * self.pitch.sin(),
            self.dist * c * self.yaw.cos()))
    }

    // The view for a w x h target.
    pub fn view(self, w: i64, h: i64) -> View {
        let eye = self.eye();
        let fwd = norm(sub(self.target, eye));
        let right = norm(cross(fwd, v3(0.0, 1.0, 0.0)));
        let up = cross(right, fwd);
        View { eye: eye, right: right, up: up, fwd: fwd, w: w, h: h }
    }
}

// The camera's basis and the target's size.
pub struct View {
    pub eye: V3,
    pub right: V3,
    pub up: V3,
    pub fwd: V3,
    pub w: i64,
    pub h: i64,
}

impl View {
    pub fn aspect(self) -> f32 {
        (self.w as f32) / (self.h as f32)
    }

    // The pixel of p (from the top-left) and its depth along the view.
    pub fn pixel(self, p: V3) -> (f32, f32, f32) {
        let d = sub(p, self.eye);
        let vz = dot(d, self.fwd);
        let vx = dot(d, self.right);
        let vy = dot(d, self.up);
        let nx = vx / (vz * TAN_HALF * self.aspect());
        let ny = vy / (vz * TAN_HALF);
        ((nx + 1.0) * 0.5 * (self.w as f32), (1.0 - ny) * 0.5 * (self.h as f32), vz)
    }

    // The unit direction through the pixel (x, y).
    pub fn ray(self, x: f32, y: f32) -> V3 {
        let nx = 2.0 * x / (self.w as f32) - 1.0;
        let ny = 1.0 - 2.0 * y / (self.h as f32);
        norm(add(self.fwd, add(scale(self.right, nx * TAN_HALF * self.aspect()),
            scale(self.up, ny * TAN_HALF))))
    }
}

// Where the ray through the pixel (x, y) meets the plane through p that faces
// the view: the drag's target for a particle at p.
pub fn drag_point(v: View, x: f32, y: f32, p: V3) -> V3 {
    let d = v.ray(x, y);
    let t = dot(sub(p, v.eye), v.fwd) / dot(d, v.fwd);
    add(v.eye, scale(d, t))
}

// The free particle nearest to the pixel (x, y), within 28 pixels, or -1.
pub fn pick(v: View, pos: [f32], n: i64, x: f32, y: f32) -> i64 {
    var best: i64 = -1;
    var best_d2: f32 = 28.0 * 28.0;
    for i in 0..n * n {
        if pos[4 * i + 3] > 0.0 {
            let (sx, sy, depth) = v.pixel(v3(pos[4 * i], pos[4 * i + 1], pos[4 * i + 2]));
            let dx = sx - x;
            let dy = sy - y;
            if depth > 0.0 && dx * dx + dy * dy < best_d2 {
                best_d2 = dx * dx + dy * dy;
                best = i;
            }
        }
    }
    best
}

// The sphere's centre at time t: a slow sway through the cloth, or still.
pub fn sphere_centre(t: f32, moving: bool) -> V3 {
    if moving {
        v3(0.35 * (0.45 * t).sin(), -0.25 + 0.05 * (0.8 * t).sin(), 0.25 * (0.3 * t).cos())
    } else {
        v3(0.0, -0.25, 0.0)
    }
}

// The sphere's radius and the floor's height.
pub const RADIUS: f32 = 0.45;
pub const FLOOR: f32 = -1.0;

// What a frame needs, besides the camera: the step, the forces, the
// constraints and the mouse's grab.
pub struct Scene {
    pub h: f32,
    pub time: f32,
    pub n: i64,
    pub gravity: f32,
    pub wind: bool,
    pub wind_strength: f32,
    pub sphere: V3,
    pub k_stretch: f32,
    pub k_bend: f32,
    pub damping: f32,
    pub relax: f32,
    pub rest: f32,
    pub grab: V3,
    pub grab_index: i64,
}

// The rest length of a stretch constraint.
pub fn rest_length(n: i64) -> f32 {
    SIZE / ((n - 1) as f32)
}

// The uniform (13 vec4s, the shaders' struct U) for a frame.
pub fn pack(s: Scene, v: View) -> [f32; 52] {
    var words: [f32; 52] = [0.0; 52];
    let light = norm(v3(-0.5, 1.0, 0.8));
    let wd = wind_dir();
    put(&words, 0, s.h, s.time, s.n as f32, 0.0);
    put(&words, 1, 0.0, s.gravity, 0.0, s.wind_strength);
    put(&words, 2, wd.x, wd.y, wd.z, if s.wind { 1.0 } else { 0.0 });
    put(&words, 3, s.sphere.x, s.sphere.y, s.sphere.z, RADIUS);
    put(&words, 4, s.k_stretch, s.k_bend, s.damping, FLOOR);
    put(&words, 5, s.grab.x, s.grab.y, s.grab.z, s.grab_index as f32);
    put(&words, 6, v.eye.x, v.eye.y, v.eye.z, 0.0);
    put(&words, 7, v.right.x, v.right.y, v.right.z, 0.0);
    put(&words, 8, v.up.x, v.up.y, v.up.z, 0.0);
    put(&words, 9, v.fwd.x, v.fwd.y, v.fwd.z, TAN_HALF);
    put(&words, 10, v.aspect(), 0.05, 50.0, s.rest);
    put(&words, 11, light.x, light.y, light.z, 0.0);
    put(&words, 12, s.relax, 0.0, 0.0, 0.0);
    words
}

fn put(w: inout [f32; 52], k: i64, a: f32, b: f32, c: f32, d: f32) {
    w[4 * k] = a;
    w[4 * k + 1] = b;
    w[4 * k + 2] = c;
    w[4 * k + 3] = d;
}

// The cloth at rest: an n x n grid in the plane z = 0, the top corners pinned
// (their inverse mass 0; the others 1). Each particle is x, y, z, w.
pub fn initial_positions(n: i64, gpa: Gpa) -> Vec<f32> {
    var out: Vec<f32> = Vec::with_capacity_in(n * n * 4, gpa);
    let last = (n - 1) as f32;
    for j in 0..n {
        for i in 0..n {
            let x = ((i as f32) / last - 0.5) * SIZE;
            let y = TOP - ((j as f32) / last) * SIZE;
            let pinned = j == 0 && (i == 0 || i == n - 1);
            out.push(x);
            out.push(y);
            out.push(0.0);
            out.push(if pinned { 0.0 } else { 1.0 });
        }
    }
    out
}

// The same cloth, every free particle moved by a deterministic jitter of up
// to a fifth of the rest length: the solver's test starts from it.
pub fn jittered_positions(n: i64, gpa: Gpa) -> Vec<f32> {
    var out = initial_positions(n, gpa);
    let amp = 0.2 * rest_length(n);
    for i in 0..n * n {
        if out[4 * i + 3] > 0.0 {
            let s = (i as f32) * 12.9898;
            let r = (s.sin() * 43758.5453) - (s.sin() * 43758.5453).floor();
            let q = ((s * 0.37).sin() * 9301.0) - ((s * 0.37).sin() * 9301.0).floor();
            out[4 * i] = out[4 * i] + amp * (2.0 * r - 1.0);
            out[4 * i + 1] = out[4 * i + 1] + amp * (2.0 * q - 1.0);
        }
    }
    out
}

// The sphere and the floor as the solver makes them: the point pushed out of
// the sphere (if inside) and onto the floor.
pub fn push_out(p: V3, c: V3, r: f32, floor: f32) -> V3 {
    var x = p;
    let d = sub(p, c);
    let l = dot(d, d).sqrt();
    if l < r && l > 0.0 {
        x = add(c, scale(d, r / l));
    }
    if x.y < floor {
        x.y = floor;
    }
    x
}

// What the headless run prints and checks, from the particles' positions and
// their last displacement (velocity = (x - prev) / h).
pub struct Stats {
    // the stretch constraints' error, relative to the rest length: rms and largest
    pub err_rms: f64,
    pub err_max: f64,
    // kinetic and gravitational energy (unit mass per free particle)
    pub ke: f64,
    pub pe: f64,
    // non-finite numbers
    pub bad: i64,
    // the lowest free particle above the floor, and the nearest surface of the sphere
    pub floor_clear: f64,
    pub sphere_clear: f64,
    // the fastest particle, metres a second
    pub max_speed: f64,
}

fn non_finite(x: f32) -> bool {
    (x - x) != 0.0
}

// The stretch error of the edge between particles a and b, relative to the rest length.
fn edge_error(pos: [f32], a: i64, b: i64, rest: f32) -> f64 {
    let dx = pos[4 * b] - pos[4 * a];
    let dy = pos[4 * b + 1] - pos[4 * a + 1];
    let dz = pos[4 * b + 2] - pos[4 * a + 2];
    let len = (dx * dx + dy * dy + dz * dz).sqrt();
    ((len - rest) / rest) as f64
}

pub fn measure(pos: [f32], prev: [f32], s: Scene) -> Stats {
    let n = s.n;
    var sum = 0.0;
    var worst = 0.0;
    var edges: i64 = 0;
    var bad: i64 = 0;
    var ke = 0.0;
    var pe = 0.0;
    var floor_clear = 1.0e9;
    var sphere_clear = 1.0e9;
    var max_speed = 0.0;
    for j in 0..n {
        for i in 0..n {
            let a = j * n + i;
            for c in 0..3 {
                if non_finite(pos[4 * a + c]) { bad += 1; }
            }
            let x = pos[4 * a];
            let y = pos[4 * a + 1];
            let z = pos[4 * a + 2];
            let d = sphere_gap(v3(x, y, z), s.sphere) as f64;
            if d < sphere_clear { sphere_clear = d; }
            if pos[4 * a + 3] > 0.0 {
                let vx = (x - prev[4 * a]) / s.h;
                let vy = (y - prev[4 * a + 1]) / s.h;
                let vz = (z - prev[4 * a + 2]) / s.h;
                let v2 = (vx * vx + vy * vy + vz * vz) as f64;
                ke += 0.5 * v2;
                if v2.sqrt() > max_speed { max_speed = v2.sqrt(); }
                pe += (-s.gravity) as f64 * y as f64;
                let fc = (y - FLOOR) as f64;
                if fc < floor_clear { floor_clear = fc; }
            }
            if i + 1 < n {
                let e = edge_error(pos, a, a + 1, s.rest);
                sum += e * e;
                edges += 1;
                if e.abs() > worst { worst = e.abs(); }
            }
            if j + 1 < n {
                let e = edge_error(pos, a, a + n, s.rest);
                sum += e * e;
                edges += 1;
                if e.abs() > worst { worst = e.abs(); }
            }
        }
    }
    let rms = if edges > 0 { (sum / edges as f64).sqrt() } else { 0.0 };
    Stats {
        err_rms: rms, err_max: worst, ke: ke, pe: pe, bad: bad,
        floor_clear: floor_clear, sphere_clear: sphere_clear, max_speed: max_speed,
    }
}

// The distance from p to the sphere's surface (negative inside).
pub fn sphere_gap(p: V3, c: V3) -> f32 {
    let d = sub(p, c);
    dot(d, d).sqrt() - RADIUS
}

#[test]
fn camera_centre_is_the_middle_of_the_screen() {
    let cam = Camera::new();
    let v = cam.view(640, 360);
    let (x, y, depth) = v.pixel(cam.target);
    assert(depth > 0.0);
    assert((x - 320.0).abs() < 0.01);
    assert((y - 180.0).abs() < 0.01);
}

#[test]
fn ray_and_pixel_agree() {
    let cam = Camera::new();
    let v = cam.view(800, 600);
    let p = v3(0.3, -0.2, 0.1);
    let (x, y, _) = v.pixel(p);
    let d = v.ray(x, y);
    let to = norm(sub(p, v.eye));
    assert((dot(d, to) - 1.0).abs() < 1.0e-4);
}

#[test]
fn drag_point_stays_on_the_ray() {
    let cam = Camera::new();
    let v = cam.view(800, 600);
    let p = v3(0.1, 0.0, 0.0);
    let (x, y, _) = v.pixel(p);
    let q = drag_point(v, x + 40.0, y - 20.0, p);
    assert((dot(sub(q, p), v.fwd)).abs() < 1.0e-4);
}

#[test]
fn push_out_puts_points_on_the_sphere_and_the_floor() {
    let c = v3(0.0, 0.0, 0.0);
    let q = push_out(v3(0.1, 0.0, 0.0), c, 0.5, -1.0);
    assert((dot(q, q).sqrt() - 0.5).abs() < 1.0e-5);
    let f = push_out(v3(2.0, -1.5, 0.0), c, 0.5, -1.0);
    assert(f.y == -1.0);
    let k = push_out(v3(2.0, 0.3, 0.0), c, 0.5, -1.0);
    assert(k.x == 2.0);
}

#[test]
fn sphere_sways_and_is_still_when_asked() {
    let a = sphere_centre(1.0, true);
    let b = sphere_centre(1.0, false);
    assert(b.x == 0.0);
    assert(b.y == -0.25);
    assert(a.x != 0.0 || a.z != 0.0);
}

#[test]
fn start_cloth_is_a_grid_with_two_pinned_corners(gpa: Gpa) {
    let v = initial_positions(4, gpa);
    assert(v.len() == 4 * 4 * 4);
    assert(v[3] == 0.0);
    assert(v[4 * 3 + 3] == 0.0);
    assert(v[4 * 4 + 3] == 1.0);
}

#[test]
fn pick_finds_the_particle_under_the_mouse(gpa: Gpa) {
    let n = 8;
    let cam = Camera::new();
    let v = cam.view(800, 600);
    let start = initial_positions(n, gpa);
    let k = 3 * n + 4;
    let (x, y, _) = v.pixel(v3(start[4 * k], start[4 * k + 1], start[4 * k + 2]));
    assert(pick(v, start.as_slice(), n, x + 3.0, y - 2.0) == k);
    assert(pick(v, start.as_slice(), n, 5.0, 5.0) == -1);
}
