// windtunnel: a 2D lattice-Boltzmann wind tunnel (D2Q9, BGK collision) on
// the GPU, drawn into a window. Flow comes from the left past a cylinder;
// the mouse draws and erases obstacles.
//
//   windtunnel                       the window (see README.md for the keys)
//   windtunnel --headless [--shot F] no window: the mass and shedding checks
//   windtunnel --frames N            the window for N frames, then its mean frame time
//
// lattice.vl holds the CPU side and the tests, shaders.vl the WGSL and
// sim.vl the GPU side.

mod lattice;
mod shaders;
mod sim;

use std::{env, gpu};
use std::cli::{Arg, Command};
use std::gpu::{Format, RawSurface};
use std::time::{Duration, monotonic_now};
use std::window::{App, Button, Event, MouseAction, WindowDesc};
use std::window::keys::{Logical, Named};

use lattice::{cylinder, omega_for, reynolds_of, stroke, strouhal, amplitude};
use sim::Sim;

// The grid: 480 x 240 cells; the cylinder is 24 cells across, its centre a
// quarter of the way along the channel. The inflow is 0.1 cells a step.
const NX: i64 = 480;
const NY: i64 = 240;
const U: f64 = 0.1;
const D: f64 = 24.0;
const CX0: f64 = 120.0;
const CY0: f64 = 120.0;
const R0: f64 = 12.0;
// the window's size in points (the picture is 2 x the grid)
const WIN_W: i64 = 960;
const WIN_H: i64 = 480;
// lattice steps a frame in the window
const STEPS_PER_FRAME: i64 = 4;
// the Reynolds number's range, for the + and - keys
const RE_MIN: f64 = 20.0;
// above 100 this lattice (BGK, 480 x 240) blows up: 110 does at D 24
const RE_MAX: f64 = 100.0;
// The headless check: the shedding behind the cylinder is measured from a
// probe 2 D behind its centre, after a transient.
const TRANSIENT: i64 = 6000;
const SAMPLES: i64 = 12000;

// The views' names, by number: 0 speed, 1 vorticity, 2 dye, 3 pressure.
fn view_name(v: i64) -> [u8] {
    if v == 0 { "speed" } else if v == 1 { "vorticity" } else if v == 2 { "dye" } else { "pressure" }
}

fn view_named(name: [u8]) -> i64 {
    var v = -1;
    for i in 0..4 {
        if view_name(i) == name {
            v = i;
        }
    }
    v
}

// Advances s by n steps; with slot0 >= 0 the probe records step i at slot
// slot0 + i.
fn advance(s: inout Sim, n: i64, slot0: i64) {
    for i in 0..n {
        let slot = if slot0 < 0 { -1 } else { slot0 + i };
        s.set_params(slot);
        var enc = s.dev.encoder();
        s.step(&enc);
        s.queue.submit(enc.finish());
    }
}

fn probe_index() -> i64 {
    (CY0 as i64) * NX + (CX0 as i64 + 2 * D as i64)
}

// The numbers the headless run prints and checks.
fn headless(re: f64, view: i64, shot: [u8], gpa: Gpa) -> i32 {
    let omega = omega_for(re, U, D);
    let mask = cylinder(NX, NY, CX0, CY0, R0, gpa);
    var ok = true;

    // 1. mass: a closed box (walls at every edge), the cylinder inside
    var closed = match Sim::new_in(NX, NY, omega, U, true, 1, Format::Bgra8Unorm, gpa) {
        Ok(s) => s,
        Err(e) => {
            eprintln(f"windtunnel: {e}");
            return 1;
        }
    };
    closed.set_mask(mask.as_slice());
    let m0 = closed.total_mass(mask.as_slice());
    advance(&closed, 1500, -1);
    let m1 = closed.total_mass(mask.as_slice());
    advance(&closed, 1500, -1);
    let m2 = closed.total_mass(mask.as_slice());
    // the sums are f32 populations added up in f64: the drift is their rounding
    // (about 1e-7 of a cell's mass a step, so 1e-2 over 115k cells at most)
    let drift = if (m1 - m0).abs() > (m2 - m0).abs() { (m1 - m0).abs() } else { (m2 - m0).abs() };
    let rel = drift / m0;
    let mass_ok = rel < 1e-4;
    ok = ok && mass_ok;
    println(f"mass, closed box, 3000 steps: {m0:.3} at the start, {m1:.3} after 1500, {m2:.3} after 3000 (relative drift {rel:.2e}, {(m2 - m0) / 3000.0:.1e} a step): {verdict(mass_ok)}");

    // 2. shedding: the open channel; the vertical speed 2 D behind the cylinder
    var s = match Sim::new_in(NX, NY, omega, U, false, SAMPLES, Format::Bgra8Unorm, gpa) {
        Ok(s) => s,
        Err(e) => {
            eprintln(f"windtunnel: {e}");
            return 1;
        }
    };
    s.set_mask(mask.as_slice());
    s.probe_cell = probe_index();
    advance(&s, TRANSIENT, -1);
    advance(&s, SAMPLES, 0);
    let samples = gpu::f32s(s.probe.map_read(s.dev));
    let st = strouhal(samples, D, U);
    let amp = amplitude(samples);
    let shed_ok = st > 0.14 && st < 0.20 && amp > 1e-4;
    ok = ok && shed_ok;
    println(f"shedding, Re {reynolds_of(omega, U, D):.1} (D {D:.0} cells, U {U}), {SAMPLES} samples after {TRANSIENT} steps: Strouhal {st:.3} (known 0.16 to 0.17 at Re 100), amplitude {amp:.2e}: {verdict(shed_ok)}");

    if shot.len() > 0 {
        s.view = view;
        s.set_params(-1);
        let img = s.snapshot_in(2 * NX, 2 * NY, gpa);
        if std::fs::write(shot, img.as_slice()).is_err() {
            eprintln(f"windtunnel: cannot write {shot}");
            return 1;
        }
        println(f"shot: {shot} ({2 * NX} x {2 * NY}, view {view_name(view)})");
    }
    if ok { 0 } else { 1 }
}

fn verdict(ok: bool) -> [u8] {
    if ok { "ok" } else { "FAILED" }
}

// The mouse, the keys and the settings, between frames.
struct Input {
    // a button held: left draws an obstacle, right erases one
    left: bool,
    right: bool,
    // the mouse, and the last stroke's end, in cells
    x: f64,
    y: f64,
    px: f64,
    py: f64,
    have: bool,
    // the brush's radius in cells
    brush: i64,
    paused: bool,
    reset: bool,
    quit: bool,
    // the view, and the Reynolds number
    view: i64,
    re: f64,
    re_changed: bool,
    // the obstacle: cleared, or the cylinder put back
    clear: bool,
    cylinder: bool,
    // the mask changed by a stroke: upload it
    dirty: bool,
}

fn on_key(inp: inout Input, key: Logical) {
    match key {
        Logical::Char(c) => {
            if c == ' ' as u32 {
                inp.paused = !inp.paused;
            } else if c == 'r' as u32 {
                inp.reset = true;
            } else if c == 'v' as u32 {
                inp.view = (inp.view + 1) % 4;
            } else if c >= '1' as u32 && c <= '4' as u32 {
                inp.view = (c - '1' as u32) as i64;
            } else if c == '+' as u32 || c == '=' as u32 {
                inp.re = (inp.re * 1.25).min(RE_MAX);
                inp.re_changed = true;
            } else if c == '-' as u32 {
                inp.re = (inp.re / 1.25).max(RE_MIN);
                inp.re_changed = true;
            } else if c == 'c' as u32 {
                inp.clear = true;
            } else if c == 'o' as u32 {
                inp.cylinder = true;
            } else if c == ']' as u32 {
                inp.brush = if inp.brush < 16 { inp.brush + 1 } else { 16 };
            } else if c == '[' as u32 {
                inp.brush = if inp.brush > 1 { inp.brush - 1 } else { 1 };
            } else if c == 'q' as u32 {
                inp.quit = true;
            }
        }
        Logical::Named(Named::Escape) => inp.quit = true,
        _ => {}
    }
}

// A frame's time, from the window's clock, for the --frames summary.
fn secs(d: Duration) -> f64 {
    d.as_secs_f64()
}

fn windowed(re: f64, view: i64, frames: i64, shot: [u8], gpa: Gpa) -> i32 {
    var app = match App::new_in(gpa) {
        Ok(a) => a,
        Err(_) => {
            eprintln("windtunnel: no window server (try --headless)");
            return 1;
        }
    };
    var win = match app.window(WindowDesc::new("windtunnel", WIN_W, WIN_H)) {
        Ok(w) => w,
        Err(_) => {
            eprintln("windtunnel: no window");
            return 1;
        }
    };
    let sz = win.size();
    var s = match Sim::new_in(NX, NY, omega_for(re, U, D), U, false, 1, Format::Bgra8Unorm, gpa) {
        Ok(s) => s,
        Err(e) => {
            eprintln(f"windtunnel: {e}");
            return 1;
        }
    };
    let inst = gpu::Instance::new_in(gpa);
    var surf = match inst.surface(s.dev, RawSurface::MetalLayer(win.raw_surface())) {
        Ok(x) => x,
        Err(e) => {
            eprintln(f"windtunnel: {e}");
            return 1;
        }
    };
    surf.configure(s.dev, sz.w, sz.h);
    var mask = cylinder(NX, NY, CX0, CY0, R0, gpa);
    s.set_mask(mask.as_slice());
    s.view = view;
    var inp = Input {
        left: false, right: false, x: 0.0, y: 0.0, px: 0.0, py: 0.0, have: false, brush: 6,
        paused: false, reset: false, quit: false, view: view, re: re, re_changed: false,
        clear: false, cylinder: false, dirty: false,
    };
    println(f"windtunnel: Re {re:.0}, view {view_name(view)}; drag the left button to draw, the right to erase; keys in README.md");
    let start = monotonic_now();
    var frame_count = 0;
    var first = 0.0;
    var last = 0.0;
    win.request_frame();
    loop {
        match app.wait() {
            Ok(Event::Frame(_)) => {
                if inp.clear {
                    mask = cylinder(NX, NY, -1000.0, -1000.0, 0.0, gpa);
                    inp.clear = false;
                    inp.dirty = true;
                }
                if inp.cylinder {
                    mask = cylinder(NX, NY, CX0, CY0, R0, gpa);
                    inp.cylinder = false;
                    inp.dirty = true;
                }
                if inp.dirty {
                    s.set_mask(mask.as_slice());
                    inp.dirty = false;
                }
                if inp.reset {
                    s.reset(gpa);
                    inp.reset = false;
                }
                if inp.re_changed {
                    s.omega = omega_for(inp.re, U, D);
                    inp.re_changed = false;
                    println(f"Re {inp.re:.0}");
                }
                s.view = inp.view;
                s.set_params(-1);
                match surf.frame() {
                    Ok(f) => {
                        var enc = s.dev.encoder();
                        if !inp.paused {
                            for _ in 0..STEPS_PER_FRAME {
                                s.step(&enc);
                            }
                        }
                        s.draw(&enc, f.texture.view());
                        s.queue.submit(enc.finish());
                        f.present(&s.queue);
                    }
                    Err(_) => {}
                }
                frame_count += 1;
                let now = secs(monotonic_now().saturating_sub(start));
                if frame_count == 1 {
                    first = now;
                }
                last = now;
                if frames > 0 && frame_count >= frames {
                    if frame_count > 1 {
                        let mean = (last - first) * 1000.0 / (frame_count - 1) as f64;
                        println(f"{NX} x {NY} grid, {STEPS_PER_FRAME} steps a frame: {frame_count} frames, {mean:.2} ms a frame");
                    }
                    if shot.len() > 0 {
                        let img = s.snapshot_in(sz.w, sz.h, gpa);
                        if std::fs::write(shot, img.as_slice()).is_err() {
                            eprintln(f"windtunnel: cannot write {shot}");
                        }
                    }
                    break;
                }
                if inp.quit {
                    break;
                }
                win.request_frame();
            }
            Ok(Event::Mouse(m)) => {
                // the window's points to cells
                let x = m.x * NX as f64 / sz.w as f64;
                let y = m.y * NY as f64 / sz.h as f64;
                match m.action {
                    MouseAction::Press => {
                        match m.button {
                            Button::Left => inp.left = true,
                            Button::Right => inp.right = true,
                            _ => {}
                        }
                        inp.have = false;
                    }
                    MouseAction::Release => {
                        match m.button {
                            Button::Left => inp.left = false,
                            Button::Right => inp.right = false,
                            _ => {}
                        }
                        inp.have = false;
                    }
                    MouseAction::Move => {}
                }
                if inp.left || inp.right {
                    let (px, py) = if inp.have { (inp.px, inp.py) } else { (x, y) };
                    let value: u32 = if inp.left { 1 } else { 0 };
                    stroke(&mask, NX, NY, px, py, x, y, inp.brush as f64, value);
                    inp.dirty = true;
                    inp.have = true;
                }
                inp.px = x;
                inp.py = y;
                inp.x = x;
                inp.y = y;
            }
            Ok(Event::Key(k)) => {
                if k.pressed && !k.repeat {
                    on_key(&inp, k.key);
                }
            }
            Ok(Event::Resize(_, z)) => surf.configure(s.dev, z.w, z.h),
            Ok(Event::Close(_)) => break,
            Ok(Event::Quit) => break,
            _ => {}
        }
        if inp.quit {
            break;
        }
    }
    let _ = s.queue.wait_idle();
    0
}

fn main(gpa: Gpa) -> i32 {
    let cli = Command::new_in("windtunnel", gpa)
        .about("A lattice-Boltzmann wind tunnel on the GPU: a window, or the headless checks")
        .arg(Arg::flag("headless").help("no window: the mass and shedding checks, then --shot"))
        .arg(Arg::option("re").value_name("RE").default("100")
            .help("the Reynolds number, 20 to 100 (the window: + and - change it)"))
        .arg(Arg::option("view").value_name("NAME").default("dye")
            .help("the first view: speed, vorticity, dye or pressure"))
        .arg(Arg::option("frames").value_name("N").default("0")
            .help("window: quit after N frames and print the mean frame time"))
        .arg(Arg::option("shot").value_name("FILE.ppm")
            .help("the picture as a PPM image (headless: after the checks; window: with --frames)"));
    let m = cli.parse_or_exit(env::args());
    let re = match std::num::parse_f64(m.get("re").unwrap_or("100")) {
        Ok(x) => x,
        Err(_) => {
            eprintln("windtunnel: --re takes a number");
            return 2;
        }
    };
    if re < RE_MIN || re > RE_MAX {
        eprintln(f"windtunnel: --re {re} is outside {RE_MIN} to {RE_MAX}");
        return 2;
    }
    let name = m.get("view").unwrap_or("dye");
    let view = view_named(name);
    if view < 0 {
        eprintln(f"windtunnel: no view named {name} (speed, vorticity, dye, pressure)");
        return 2;
    }
    let frames = parse_int(m.get("frames").unwrap_or("0")).unwrap_or(0);
    let shot = m.get("shot").unwrap_or("");
    if m.flag("headless") {
        return headless(re, view, shot, gpa);
    }
    windowed(re, view, frames, shot, gpa)
}
