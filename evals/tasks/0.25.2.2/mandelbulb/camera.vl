// The camera and the look of the picture, on the CPU: a pose (position,
// yaw, pitch) that the keys and the mouse move as a goal, a camera that
// eases toward the goal every frame (so motion is smooth), the fixed views
// of the headless mode, and the uniform block the shader reads.

// A pose: where the eye is, and which way it looks (yaw about the y axis,
// pitch up from the horizon, both in radians).
pub struct Pose {
    pub x: f64,
    pub y: f64,
    pub z: f64,
    pub yaw: f64,
    pub pitch: f64,
}

impl Pose {
    pub fn toward(self, g: Pose, k: f64) -> Pose {
        Pose {
            x: self.x + (g.x - self.x) * k,
            y: self.y + (g.y - self.y) * k,
            z: self.z + (g.z - self.z) * k,
            yaw: self.yaw + (g.yaw - self.yaw) * k,
            pitch: self.pitch + (g.pitch - self.pitch) * k,
        }
    }
}

// What the picture shows: which fractal, its parameters and the effects.
pub struct Look {
    // 0: the Mandelbulb, 1: the Mandelbox
    pub kind: i64,
    // the Mandelbulb's exponent (2 to 16)
    pub power: f64,
    // the Mandelbox's scale (-3 to -1)
    pub bscale: f64,
    // the estimate's iterations (the detail)
    pub iters: i64,
    pub shadows: bool,
    pub ao: bool,
}

// The camera's basis for a pose: the unit forward, right and up vectors.
pub fn forward(p: Pose) -> [f64; 3] {
    [p.pitch.cos() * p.yaw.sin(), p.pitch.sin(), p.pitch.cos() * p.yaw.cos()]
}

pub fn right(p: Pose) -> [f64; 3] {
    [p.yaw.cos(), 0.0, -p.yaw.sin()]
}

pub fn up(p: Pose) -> [f64; 3] {
    let f = forward(p);
    let r = right(p);
    [f[1] * r[2] - f[2] * r[1], f[2] * r[0] - f[0] * r[2], f[0] * r[1] - f[1] * r[0]]
}

// The fixed views of the headless mode: 0 to 2 the Mandelbulb, 3 the Mandelbox.
pub fn view(k: i64) -> Pose {
    if k == 0 {
        Pose { x: 0.0, y: 0.0, z: -2.5, yaw: 0.0, pitch: 0.0 }
    } else if k == 1 {
        Pose { x: 0.45, y: 0.35, z: -1.35, yaw: 0.35, pitch: -0.2 }
    } else if k == 2 {
        Pose { x: 0.0, y: 1.5, z: -1.8, yaw: 0.0, pitch: -0.55 }
    } else {
        Pose { x: 0.0, y: 0.0, z: -6.0, yaw: 0.2, pitch: 0.05 }
    }
}

// The kind a fixed view shows.
pub fn view_kind(k: i64) -> i64 {
    if k == 3 { 1 } else { 0 }
}

pub fn view_name(k: i64) -> [u8] {
    if k == 0 {
        "bulb-front"
    } else if k == 1 {
        "bulb-close"
    } else if k == 2 {
        "bulb-above"
    } else {
        "box-far"
    }
}

// The uniform block: 7 vec4s, 28 floats (see shader.vl).
pub fn pack(p: Pose, look: Look, time: f64, w: i64, h: i64) -> [f32; 28] {
    let f = forward(p);
    let r = right(p);
    let u = up(p);
    let power = if look.kind == 0 { look.power } else { look.bscale };
    let fov = 0.6;
    let words: [f64; 28] = [
        w as f64, h as f64, time, power,
        p.x, p.y, p.z, 0.0,
        f[0], f[1], f[2], 0.0,
        r[0], r[1], r[2], 0.0,
        u[0], u[1], u[2], 0.0,
        look.kind as f64, if look.shadows { 1.0 } else { 0.0 },
        if look.ao { 1.0 } else { 0.0 }, fov,
        look.bscale, look.iters as f64, if look.kind == 0 { 1.6 } else { 5.0 }, 0.0,
    ];
    var out: [f32; 28] = [0.0; 28];
    for i in 0..28 {
        out[i] = words[i] as f32;
    }
    out
}

// The goal the user steers, with the camera easing toward it.
pub struct Camera {
    pub at: Pose,
    pub goal: Pose,
}

impl Camera {
    pub fn new(p: Pose) -> Camera {
        Camera { at: p, goal: p }
    }

    // Move the camera a fraction of the way toward the goal: a frame's
    // share of a 8-per-second ease, whatever the frame time.
    pub fn ease(inout self, dt: f64) {
        let k = 1.0 - (-dt * 8.0).exp();
        self.at = self.at.toward(self.goal, k);
    }

    // Move the goal along the camera's own axes: forward, right and up,
    // in units a second times dt.
    pub fn fly(inout self, fwd: f64, side: f64, lift: f64, dt: f64) {
        let f = forward(self.goal);
        let r = right(self.goal);
        let s = 1.4 * dt;
        self.goal.x = self.goal.x + (f[0] * fwd + r[0] * side) * s;
        self.goal.z = self.goal.z + (f[2] * fwd + r[2] * side) * s;
        self.goal.y = self.goal.y + (f[1] * fwd + lift) * s;
    }

    // Mouse drag: dx and dy in pixels (dy down the screen).
    pub fn look(inout self, dx: f64, dy: f64) {
        self.goal.yaw = self.goal.yaw + dx * 0.004;
        let p = self.goal.pitch - dy * 0.004;
        self.goal.pitch = if p > 1.5 { 1.5 } else if p < -1.5 { -1.5 } else { p };
    }
}

#[test]
fn basis_is_orthonormal() {
    var k = 0;
    while k < 4 {
        let p = view(k);
        let f = forward(p);
        let r = right(p);
        let u = up(p);
        let len = f[0] * f[0] + f[1] * f[1] + f[2] * f[2];
        assert((len - 1.0).abs() < 1e-12);
        assert((f[0] * r[0] + f[1] * r[1] + f[2] * r[2]).abs() < 1e-12);
        assert((u[0] * f[0] + u[1] * f[1] + u[2] * f[2]).abs() < 1e-12);
        assert(u[1] > 0.0);
        k += 1;
    }
}

#[test]
fn yaw_zero_looks_down_plus_z() {
    let f = forward(Pose { x: 0.0, y: 0.0, z: 0.0, yaw: 0.0, pitch: 0.0 });
    assert((f[2] - 1.0).abs() < 1e-12);
    assert(f[0].abs() < 1e-12);
}

#[test]
fn pack_puts_power_and_kind_in_place() {
    let look = Look { kind: 0, power: 8.0, bscale: -2.0, iters: 10, shadows: true, ao: false };
    let w = pack(view(0), look, 1.5, 640, 360);
    assert((w[3] - 8.0).abs() < 1e-6);
    assert(w[0] == 640.0);
    assert(w[20] == 0.0);
    assert(w[21] == 1.0);
    assert(w[22] == 0.0);
}

#[test]
fn ease_reaches_the_goal() {
    var c = Camera::new(view(0));
    c.look(200.0, 0.0);
    c.fly(1.0, 0.0, 0.0, 0.5);
    var i = 0;
    while i < 600 {
        c.ease(1.0 / 60.0);
        i += 1;
    }
    assert((c.at.x - c.goal.x).abs() < 1e-6);
    assert((c.at.yaw - c.goal.yaw).abs() < 1e-6);
}
