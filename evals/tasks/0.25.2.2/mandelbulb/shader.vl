// The WGSL of the raymarcher: one full-screen pass. Each pixel casts a ray
// from the camera, sphere-traces the fractal's distance estimate (the
// Mandelbulb, or a Mandelbox), and shades the hit with soft shadows,
// ambient occlusion and an orbit-trap colour.
//
// The uniform block (see camera.vl's `pack`, 28 floats = 7 vec4s):
//   res  = (width, height, time, power)     power: Mandelbulb exponent
//   pos  = camera position
//   fwd, right, up = the camera's basis (unit vectors)
//   opt  = (kind 0 Mandelbulb / 1 Mandelbox, shadows 0/1, ao 0/1, fov)
//   ext  = (box scale, estimate iterations, radius of the bounding sphere, _)

pub const SHADER: [u8] = "struct U {\n\
    res: vec4<f32>,\n\
    pos: vec4<f32>,\n\
    fwd: vec4<f32>,\n\
    right: vec4<f32>,\n\
    up: vec4<f32>,\n\
    opt: vec4<f32>,\n\
    ext: vec4<f32>,\n\
    }\n\
    @group(0) @binding(0) var<uniform> u: U;\n\
    struct V { @builtin(position) pos: vec4<f32>, @location(0) uv: vec2<f32> }\n\
    @vertex fn vs(@builtin(vertex_index) i: u32) -> V {\n\
    var p = vec2<f32>(-1.0, -1.0);\n\
    if (i == 1u) { p = vec2<f32>(3.0, -1.0); }\n\
    if (i == 2u) { p = vec2<f32>(-1.0, 3.0); }\n\
    return V(vec4<f32>(p, 0.0, 1.0), p);\n\
    }\n\
    // The Mandelbulb's estimate (Quilez's), with the orbit trap: the closest\n\
    // the orbit came to the origin.\n\
    fn bulb_de(p: vec3<f32>) -> vec2<f32> {\n\
    let n = u.res.w;\n\
    let iters = i32(u.ext.y);\n\
    var z = p;\n\
    var dr = 1.0;\n\
    var r = 0.0;\n\
    var trap = 1e9;\n\
    for (var i = 0; i < iters; i = i + 1) {\n\
    r = length(z);\n\
    trap = min(trap, r);\n\
    if (r > 2.0) { break; }\n\
    let rs = max(r, 1e-9);\n\
    let theta = acos(clamp(z.z / rs, -1.0, 1.0)) * n;\n\
    let phi = atan2(z.y, z.x) * n;\n\
    let zr = pow(rs, n);\n\
    dr = pow(rs, n - 1.0) * n * dr + 1.0;\n\
    z = zr * vec3<f32>(sin(theta) * cos(phi), sin(phi) * sin(theta), cos(theta)) + p;\n\
    }\n\
    let d = 0.5 * log(max(r, 1e-9)) * r / max(dr, 1e-9);\n\
    return vec2<f32>(d, trap);\n\
    }\n\
    // The Mandelbox's estimate: box fold, sphere fold, scale and shift.\n\
    fn box_de(p: vec3<f32>) -> vec2<f32> {\n\
    let s = u.ext.x;\n\
    let iters = i32(u.ext.y);\n\
    var z = p;\n\
    var dr = 1.0;\n\
    var trap = 1e9;\n\
    for (var i = 0; i < iters; i = i + 1) {\n\
    z = clamp(z, vec3<f32>(-1.0), vec3<f32>(1.0)) * 2.0 - z;\n\
    let r2 = dot(z, z);\n\
    trap = min(trap, r2);\n\
    if (r2 < 0.25) {\n\
    z = z * 4.0;\n\
    dr = dr * 4.0;\n\
    } else if (r2 < 1.0) {\n\
    z = z / r2;\n\
    dr = dr / r2;\n\
    }\n\
    z = z * s + p;\n\
    dr = dr * abs(s) + 1.0;\n\
    }\n\
    let d = length(z) / abs(dr);\n\
    return vec2<f32>(d, sqrt(trap));\n\
    }\n\
    fn scene(p: vec3<f32>) -> vec2<f32> {\n\
    if (u.opt.x < 0.5) { return bulb_de(p); }\n\
    return box_de(p);\n\
    }\n\
    // March from ro along rd: (distance, trap), distance < 0 for a miss.\n\
    fn march(ro: vec3<f32>, rd: vec3<f32>) -> vec2<f32> {\n\
    let big = u.ext.z;\n\
    let b = dot(ro, rd);\n\
    let disc = b * b - (dot(ro, ro) - big * big);\n\
    if (disc < 0.0) { return vec2<f32>(-1.0, 0.0); }\n\
    let t1 = -b + sqrt(disc);\n\
    if (t1 < 0.0) { return vec2<f32>(-1.0, 0.0); }\n\
    var t = max(-b - sqrt(disc), 0.0);\n\
    var trap = 0.0;\n\
    for (var i = 0; i < 300; i = i + 1) {\n\
    let h = scene(ro + rd * t);\n\
    trap = h.y;\n\
    if (h.x < 0.0006 * t + 0.00002) { return vec2<f32>(t, trap); }\n\
    t = t + h.x * 0.8;\n\
    if (t > t1) { break; }\n\
    }\n\
    return vec2<f32>(-1.0, trap);\n\
    }\n\
    fn normal_at(p: vec3<f32>) -> vec3<f32> {\n\
    let e = vec2<f32>(0.0005, -0.0005);\n\
    return normalize(e.xyy * scene(p + e.xyy).x + e.yyx * scene(p + e.yyx).x\n\
    + e.yxy * scene(p + e.yxy).x + e.xxx * scene(p + e.xxx).x);\n\
    }\n\
    // Soft shadow (Quilez): the closest the ray comes to the surface, relative to its distance.\n\
    fn soft_shadow(ro: vec3<f32>, rd: vec3<f32>) -> f32 {\n\
    var res = 1.0;\n\
    var t = 0.02;\n\
    for (var i = 0; i < 80; i = i + 1) {\n\
    let h = scene(ro + rd * t).x;\n\
    res = min(res, 4.0 * h / t);\n\
    t = t + clamp(h, 0.01, 0.1);\n\
    if (res < 0.001 || t > 6.0) { break; }\n\
    }\n\
    let c = clamp(res, 0.0, 1.0);\n\
    return c * c * (3.0 - 2.0 * c);\n\
    }\n\
    // Ambient occlusion: five samples along the normal.\n\
    fn occlusion(p: vec3<f32>, n: vec3<f32>) -> f32 {\n\
    var occ = 0.0;\n\
    var sca = 1.0;\n\
    for (var i = 0; i < 5; i = i + 1) {\n\
    let h = 0.02 + 0.12 * f32(i);\n\
    let d = scene(p + n * h).x;\n\
    occ = occ + (h - d) * sca;\n\
    sca = sca * 0.9;\n\
    }\n\
    return 0.35 + 0.65 * clamp(1.0 - 1.5 * occ, 0.0, 1.0);\n\
    }\n\
    fn palette(t: f32) -> vec3<f32> {\n\
    return vec3<f32>(0.5, 0.45, 0.4) + vec3<f32>(0.5, 0.4, 0.35) * cos(6.2831 * (vec3<f32>(1.0, 1.0, 0.8) * t + vec3<f32>(0.0, 0.15, 0.25)));\n\
    }\n\
    fn sky(rd: vec3<f32>) -> vec3<f32> {\n\
    let t = clamp(0.5 + 0.5 * rd.y, 0.0, 1.0);\n\
    return mix(vec3<f32>(0.03, 0.03, 0.05), vec3<f32>(0.16, 0.2, 0.32), t);\n\
    }\n\
    @fragment fn fs(v: V) -> @location(0) vec4<f32> {\n\
    let aspect = u.res.x / u.res.y;\n\
    let fovk = u.opt.w;\n\
    let uv = vec2<f32>(v.uv.x * aspect, v.uv.y) * fovk;\n\
    let rd = normalize(u.fwd.xyz + uv.x * u.right.xyz + uv.y * u.up.xyz);\n\
    let ro = u.pos.xyz;\n\
    let hit = march(ro, rd);\n\
    var col = sky(rd);\n\
    if (hit.x > 0.0) {\n\
    let t = hit.x;\n\
    let p = ro + rd * t;\n\
    let n = normal_at(p);\n\
    let key = normalize(vec3<f32>(0.6, 0.8, -0.5));\n\
    let fill = normalize(vec3<f32>(-0.7, 0.2, 0.6));\n\
    var sh = 1.0;\n\
    if (u.opt.y > 0.5) { sh = soft_shadow(p + n * 0.002, key); }\n\
    var occ = 1.0;\n\
    if (u.opt.z > 0.5) { occ = occlusion(p, n); }\n\
    let dif = clamp(dot(n, key), 0.0, 1.0) * sh;\n\
    let fil = clamp(dot(n, fill), 0.0, 1.0);\n\
    let hal = normalize(key - rd);\n\
    let spe = pow(clamp(dot(n, hal), 0.0, 1.0), 48.0) * sh;\n\
    let rim = pow(1.0 - clamp(dot(n, -rd), 0.0, 1.0), 3.0);\n\
    let base = palette(hit.y * 2.2 + 0.05 * u.res.z);\n\
    let lit = base * (dif * vec3<f32>(1.0, 0.92, 0.8) + 0.25 * fil * vec3<f32>(0.4, 0.5, 0.8)\n\
    + 0.12 * occ * vec3<f32>(0.5, 0.6, 0.7));\n\
    col = lit * occ + spe * vec3<f32>(0.5) + rim * 0.15 * sky(rd);\n\
    col = mix(col, sky(rd), 1.0 - exp(-0.035 * t * t));\n\
    }\n\
    return vec4<f32>(sqrt(clamp(1.2 * col, vec3<f32>(0.0), vec3<f32>(1.0))), 1.0);\n\
    }\n";

// The window's second pass: the scene texture, sampled (linearly) over the frame.
pub const BLIT: [u8] = "@group(0) @binding(0) var t: texture_2d<f32>;\n\
    @group(0) @binding(1) var s: sampler;\n\
    struct B { @builtin(position) pos: vec4<f32>, @location(0) uv: vec2<f32> }\n\
    @vertex fn vs(@builtin(vertex_index) i: u32) -> B {\n\
    var p = vec2<f32>(-1.0, -1.0);\n\
    if (i == 1u) { p = vec2<f32>(3.0, -1.0); }\n\
    if (i == 2u) { p = vec2<f32>(-1.0, 3.0); }\n\
    return B(vec4<f32>(p, 0.0, 1.0), vec2<f32>(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5));\n\
    }\n\
    @fragment fn fs(b: B) -> @location(0) vec4<f32> {\n\
    return textureSampleLevel(t, s, b.uv, 0.0);\n\
    }\n";
