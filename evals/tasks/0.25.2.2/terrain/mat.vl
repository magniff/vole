// Vectors and 4 x 4 matrices for the camera and the sun. A matrix is 16
// f32s, column by column (column c is m[4c .. 4c + 4]). The view is
// right-handed and looks down -z; depths run from 0 to 1 (Metal's).

pub struct V3 {
    pub x: f32,
    pub y: f32,
    pub z: f32,
}

impl V3 {
    pub fn new(x: f32, y: f32, z: f32) -> V3 {
        V3 { x: x, y: y, z: z }
    }

    pub fn add(self, o: V3) -> V3 {
        V3::new(self.x + o.x, self.y + o.y, self.z + o.z)
    }

    pub fn sub(self, o: V3) -> V3 {
        V3::new(self.x - o.x, self.y - o.y, self.z - o.z)
    }

    pub fn scale(self, k: f32) -> V3 {
        V3::new(self.x * k, self.y * k, self.z * k)
    }

    pub fn dot(self, o: V3) -> f32 {
        self.x * o.x + self.y * o.y + self.z * o.z
    }

    pub fn cross(self, o: V3) -> V3 {
        V3::new(self.y * o.z - self.z * o.y, self.z * o.x - self.x * o.z, self.x * o.y - self.y * o.x)
    }

    pub fn len(self) -> f32 {
        self.dot(self).sqrt()
    }

    pub fn norm(self) -> V3 {
        self.scale(1.0 / self.len())
    }
}

pub fn identity() -> [f32; 16] {
    var m: [f32; 16] = [0.0; 16];
    m[0] = 1.0;
    m[5] = 1.0;
    m[10] = 1.0;
    m[15] = 1.0;
    m
}

// a * b: first b, then a.
pub fn mul(a: [f32; 16], b: [f32; 16]) -> [f32; 16] {
    var c: [f32; 16] = [0.0; 16];
    for col in 0..4 {
        for row in 0..4 {
            var s: f32 = 0.0;
            for k in 0..4 {
                s += a[k * 4 + row] * b[col * 4 + k];
            }
            c[col * 4 + row] = s;
        }
    }
    c
}

pub fn perspective(fovy: f32, aspect: f32, near: f32, far: f32) -> [f32; 16] {
    let f = 1.0 / (fovy * 0.5).tan();
    var m: [f32; 16] = [0.0; 16];
    m[0] = f / aspect;
    m[5] = f;
    m[10] = far / (near - far);
    m[11] = -1.0;
    m[14] = far * near / (near - far);
    m
}

pub fn look_at(eye: V3, target: V3, up: V3) -> [f32; 16] {
    let f = target.sub(eye).norm();
    let s = f.cross(up).norm();
    let u = s.cross(f);
    var m: [f32; 16] = [0.0; 16];
    m[0] = s.x;
    m[1] = u.x;
    m[2] = -f.x;
    m[4] = s.y;
    m[5] = u.y;
    m[6] = -f.y;
    m[8] = s.z;
    m[9] = u.z;
    m[10] = -f.z;
    m[12] = -s.dot(eye);
    m[13] = -u.dot(eye);
    m[14] = f.dot(eye);
    m[15] = 1.0;
    m
}

// An orthographic box: left, right, bottom, top, near, far (view space).
pub fn ortho(l: f32, r: f32, b: f32, t: f32, near: f32, far: f32) -> [f32; 16] {
    var m: [f32; 16] = [0.0; 16];
    m[0] = 2.0 / (r - l);
    m[5] = 2.0 / (t - b);
    m[10] = 1.0 / (near - far);
    m[12] = -(r + l) / (r - l);
    m[13] = -(t + b) / (t - b);
    m[14] = near / (near - far);
    m[15] = 1.0;
    m
}

// m applied to the point p, homogeneous (x, y, z, w).
pub fn transform(m: [f32; 16], p: V3) -> [f32; 4] {
    var out: [f32; 4] = [0.0; 4];
    for row in 0..4 {
        out[row] = m[row] * p.x + m[4 + row] * p.y + m[8 + row] * p.z + m[12 + row];
    }
    out
}

fn near(a: f32, b: f32) -> bool {
    (a - b).abs() < 0.0001
}

#[test]
fn mul_by_identity_is_the_matrix() {
    let m = perspective(1.0, 1.5, 1.0, 100.0);
    let k = mul(identity(), m);
    var same = true;
    for i in 0..16 {
        if !near(k[i], m[i]) {
            same = false;
        }
    }
    assert_eq(same, true);
}

#[test]
fn look_at_puts_the_eye_at_the_origin_and_the_target_down_minus_z() {
    let e = V3::new(1.0, 2.0, 3.0);
    let m = look_at(e, V3::new(1.0, 2.0, -7.0), V3::new(0.0, 1.0, 0.0));
    let o = transform(m, e);
    assert_eq(near(o[0], 0.0) && near(o[1], 0.0) && near(o[2], 0.0), true);
    let t = transform(m, V3::new(1.0, 2.0, -7.0));
    assert_eq(near(t[0], 0.0) && near(t[1], 0.0) && near(t[2], -10.0), true);
}

#[test]
fn perspective_maps_near_to_depth_zero_and_far_to_one() {
    let m = perspective(1.0, 1.0, 2.0, 50.0);
    let n = transform(m, V3::new(0.0, 0.0, -2.0));
    let f = transform(m, V3::new(0.0, 0.0, -50.0));
    assert_eq(near(n[2] / n[3], 0.0) && near(f[2] / f[3], 1.0), true);
}

#[test]
fn ortho_maps_the_box_to_the_unit_cube() {
    let m = ortho(-10.0, 10.0, -5.0, 5.0, 1.0, 101.0);
    let c = transform(m, V3::new(10.0, 5.0, -1.0));
    let d = transform(m, V3::new(-10.0, -5.0, -101.0));
    assert_eq(near(c[0], 1.0) && near(c[1], 1.0) && near(c[2], 0.0), true);
    assert_eq(near(d[0], -1.0) && near(d[1], -1.0) && near(d[2], 1.0), true);
}
