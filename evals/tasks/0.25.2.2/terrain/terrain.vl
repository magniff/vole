// The terrain's grid and its level of detail, on the CPU. The grid is
// NC x NC chunks of CHUNK quads; a chunk draws at a step (1, 2, 4 or 8
// grid cells a quad) chosen by its distance to the eye, and hangs a
// skirt below each of its four edges so that a chunk at a coarser step
// than its neighbour leaves no crack. The GPU (shaders.vl) builds the
// same vertices from the same numbers: the constants below are written
// there too.

use mat::V3;

pub const NC: i64 = 16;
pub const CHUNK: i64 = 32;
pub const NCHUNKS: i64 = 256;
pub const SAMPLES: i64 = 513;
pub const CELL: f32 = 2.0;
pub const SKIRT: f32 = 40.0;
pub const AMP: f32 = 190.0;
pub const SEA: f32 = 0.0;

// The step a chunk at distance d from the eye draws at.
pub fn step_for(d: f32) -> i64 {
    if d < 220.0 { 1 } else if d < 440.0 { 2 } else if d < 800.0 { 4 } else { 8 }
}

// The centre of chunk c, in world units (the grid is centred on 0).
pub fn chunk_center(c: i64) -> V3 {
    let half = (SAMPLES - 1) as f32 * 0.5;
    let x = ((c % NC) * CHUNK + CHUNK / 2) as f32 - half;
    let z = ((c / NC) * CHUNK + CHUNK / 2) as f32 - half;
    V3::new(x * CELL, 0.0, z * CELL)
}

// The steps of all chunks for an eye.
pub fn lod_steps(eye: V3) -> [u32; 256] {
    var steps: [u32; 256] = [0; 256];
    for c in 0..NCHUNKS {
        steps[c] = step_for(eye.sub(chunk_center(c)).len()) as u32;
    }
    steps
}

// Quads a chunk draws at step s: the inner grid, then 4 skirts of n quads.
pub fn chunk_quads(step: i64) -> i64 {
    let n = CHUNK / step;
    n * n + 4 * n
}

pub fn chunk_verts(step: i64) -> i64 {
    6 * chunk_quads(step)
}

pub fn chunk_tris(step: i64) -> i64 {
    2 * chunk_quads(step)
}

// Triangles drawn for a set of steps, and how many chunks are at each
// of the four steps (index 0 is step 1, 3 is step 8).
pub fn triangles(steps: [u32; 256]) -> i64 {
    var t = 0;
    for c in 0..NCHUNKS {
        t += chunk_tris(steps[c] as i64);
    }
    t
}

pub fn histogram(steps: [u32; 256]) -> [i64; 4] {
    var h: [i64; 4] = [0; 4];
    for c in 0..NCHUNKS {
        let i = match steps[c] {
            1 => 0,
            2 => 1,
            4 => 2,
            _ => 3,
        };
        h[i] += 1;
    }
    h
}

// Triangles of the full-detail grid: every chunk at step 1.
pub fn full_triangles() -> i64 {
    NCHUNKS * chunk_tris(1)
}

#[test]
fn steps_grow_with_distance() {
    assert_eq(step_for(10.0), 1);
    assert_eq(step_for(300.0), 2);
    assert_eq(step_for(600.0), 4);
    assert_eq(step_for(5000.0), 8);
}

#[test]
fn chunk_counts_per_step() {
    // step 1: 32 x 32 inner quads and 4 x 32 skirt quads, 2 triangles each
    assert_eq(chunk_quads(1), 1152);
    assert_eq(chunk_tris(1), 2304);
    assert_eq(chunk_verts(1), 6912);
    // step 8: 4 x 4 inner quads and 4 x 4 skirt quads
    assert_eq(chunk_tris(8), 64);
}

#[test]
fn lod_is_nearest_at_the_eye_and_coarsest_far_away() {
    let near_c = chunk_center(0);
    let eye = V3::new(near_c.x, 30.0, near_c.z);
    let steps = lod_steps(eye);
    assert_eq(steps[0], 1);
    let far = lod_steps(V3::new(-5000.0, 0.0, -5000.0));
    let h = histogram(far);
    assert_eq(h[3], NCHUNKS);
}

#[test]
fn chunk_centers_cover_the_grid() {
    let first = chunk_center(0);
    let last = chunk_center(NCHUNKS - 1);
    assert_eq(first.x < 0.0 && first.z < 0.0, true);
    assert_eq(last.x > 0.0 && last.z > 0.0, true);
}
