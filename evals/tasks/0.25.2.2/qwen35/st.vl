// A safetensors file, read whole: its header (tensor names, dtypes, shapes,
// byte ranges) and its bytes. Tensors are read in place, never converted:
// the GPU reads bf16 pairs and f32 words straight from these bytes.

use json::{Json, member_index};

pub struct Entry {
    name: Vec<u8>,
    is_f32: bool,
    start: i64,
    end: i64,
    shape: Vec<i64>,
}

pub struct SafeTensors {
    bytes: Vec<u8>,
    entries: Vec<Entry>,
}

// The number at element i of a JSON array, or 0.
fn num_at(xs: [Json], i: i64) -> i64 {
    match xs[i] {
        Json::Num(n) => n as i64,
        _ => 0,
    }
}

impl SafeTensors {
    // Reads the file at path (all of it: the bytes stay in memory).
    pub fn open(path: [u8], gpa: Gpa) -> Result<SafeTensors, std::io::Error> {
        let bytes = std::fs::read_in(path, gpa)?;
        var hlen: i64 = 0;
        var k: i64 = 7;
        while k >= 0 {
            hlen = hlen * 256 + bytes[k] as i64;
            k -= 1;
        }
        let base = 8 + hlen;
        let header = json::parse(bytes[8..base], gpa);
        var entries: Vec<Entry> = Vec::new_in(gpa);
        match header {
            Json::Obj(ms) => {
                for m in ms {
                    match m.val {
                        Json::Obj(fs) => {
                            var e = Entry { name: Vec::new_in(gpa), is_f32: false,
                                start: 0, end: 0, shape: Vec::new_in(gpa) };
                            e.name.extend_from_slice(m.key.as_slice());
                            let d = member_index(fs, "dtype");
                            if d >= 0 {
                                match fs[d].val {
                                    Json::Str(t) => e.is_f32 = t.as_slice() == "F32",
                                    _ => {}
                                }
                            }
                            let s = member_index(fs, "shape");
                            if s >= 0 {
                                match fs[s].val {
                                    Json::Arr(xs) => {
                                        for i in 0..xs.len() { e.shape.push(num_at(xs, i)); }
                                    }
                                    _ => {}
                                }
                            }
                            let o = member_index(fs, "data_offsets");
                            if o >= 0 {
                                match fs[o].val {
                                    Json::Arr(xs) => {
                                        e.start = base + num_at(xs, 0);
                                        e.end = base + num_at(xs, 1);
                                    }
                                    _ => {}
                                }
                            }
                            entries.push(e);
                        }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        Ok(SafeTensors { bytes: bytes, entries: entries })
    }

    pub fn count(self) -> i64 {
        self.entries.len()
    }

    // The index of the tensor called name, or -1.
    pub fn find(self, name: [u8]) -> i64 {
        var i: i64 = 0;
        while i < self.entries.len() {
            if self.entries[i].name.as_slice() == name {
                return i;
            }
            i += 1;
        }
        -1
    }

    // The tensor's raw bytes (bf16 or f32, little-endian).
    pub fn bytes_of(self, i: i64) -> [u8] {
        self.bytes[self.entries[i].start..self.entries[i].end]
    }

    pub fn is_f32(self, i: i64) -> bool {
        self.entries[i].is_f32
    }

    pub fn shape(self, i: i64) -> [i64] {
        self.entries[i].shape.as_slice()
    }

    pub fn name(self, i: i64) -> [u8] {
        self.entries[i].name.as_slice()
    }
}
