// Qwen3.5-0.8B (text only) on the GPU, in vole.
//
//   qwen35                              the chat window (std::window)
//   qwen35 --headless --check           the model against reference/reference.json
//   qwen35 --headless --prompt TEXT [--tokens N] [--raw] [--temp T] [--top-p P]
//          [--seed S] [--shot FILE.ppm] the reply on stdout (speeds on stderr)
//
// The checkpoint is read from model/ (a symlink to it) at run time, never
// copied. --frames N (the window) quits after N frames: a short test.

mod json;
mod st;
mod tok;
mod wgsl;
mod font;
mod model;
mod run;
mod check;
mod chat;
mod ui;
mod app;

use std::env;
use std::cli::{Arg, Command};

use chat::Chat;
use model::Model;
use run::Sampler;
use st::SafeTensors;
use tok::Tok;

static MODEL_DIR: str = "model";
static WEIGHTS: str = "model/model.safetensors-00001-of-00001.safetensors";

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("qwen35", gpa)
        .arg(Arg::flag("headless").help("no window: the reply on stdout"))
        .arg(Arg::flag("check").help("compare with reference/reference.json"))
        .arg(Arg::option("prompt").value_name("TEXT").default(""))
        .arg(Arg::option("tokens").value_name("N").default("128"))
        .arg(Arg::option("temp").value_name("T").default("0"))
        .arg(Arg::option("top-p").value_name("P").default("0.9"))
        .arg(Arg::option("seed").value_name("S").default("1"))
        .arg(Arg::option("shot").value_name("FILE").default(""))
        .arg(Arg::option("frames").value_name("N").default("0"))
        .arg(Arg::flag("raw").help("the prompt as plain text, not in the chat template"));
    let m = cmd.parse_or_exit(env::args());

    let tk = Tok::load(MODEL_DIR, gpa).unwrap();
    let st = SafeTensors::open(WEIGHTS, gpa).unwrap();
    var net = Model::new(st, gpa).unwrap();

    if m.flag("check") {
        let refs = std::fs::read_in("reference/reference.json", gpa).unwrap();
        let fails = check::check(&net, tk, refs.as_slice(), gpa);
        println(f"fails {fails}");
        return if fails == 0 { 0 } else { 1 };
    }

    let cfg = Sampler {
        temp: m.get_as::<f64>("temp").unwrap(),
        top_p: m.get_as::<f64>("top-p").unwrap(),
        seed: m.get_as::<u64>("seed").unwrap(),
    };
    var chat = Chat::new(cfg, gpa);
    chat.max_new = m.get_as::<i64>("tokens").unwrap();

    if !m.flag("headless") {
        return app::window(&net, tk, &chat, m.get_as::<i64>("frames").unwrap(),
            m.get("prompt").unwrap().as_bytes(), gpa);
    }
    let text = m.get("prompt").unwrap();
    if text.len() > 0 {
        chat.submit(&net, tk, text.as_bytes(), m.flag("raw"));
        var mark = chat.log.len();
        while chat.generating {
            chat.gen_one(&net, tk);
            print(chat.log.as_slice()[mark..chat.log.len()]);
            mark = chat.log.len();
        }
        println("");
        eprintln(f"prefill {chat.prefill_tps:.1} tok/s; decode {chat.made} tokens");
    }
    let shot = m.get("shot").unwrap();
    if shot.len() > 0 {
        return app::shot(&net, tk, &chat, shot, gpa);
    }
    0
}
