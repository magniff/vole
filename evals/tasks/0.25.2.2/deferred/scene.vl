// The scene: a checkered floor, a grid of boxes of seeded heights and
// three spheres, as one mesh of 9-float vertices (position, normal,
// colour); and the point lights, moving on orbits, as 8 floats each
// (position and radius, colour and intensity).

use math::{PI, add3, scale3, sub3};

pub const LIGHT_FLOATS: i64 = 8;

// A mesh: vertices (9 f32s each) and triangles (3 indices each).
pub struct Mesh {
    pub verts: Vec<f32>,
    pub index: Vec<u32>,
}

impl Mesh {
    pub fn new_in(gpa: Gpa) -> Mesh {
        Mesh { verts: Vec::new_in(gpa), index: Vec::new_in(gpa) }
    }

    pub fn vertex_count(self) -> i64 {
        self.verts.len() / 9
    }

    fn vertex(inout self, p: [f32; 3], n: [f32; 3], c: [f32; 3]) -> u32 {
        let i = self.vertex_count();
        self.verts.push(p[0]);
        self.verts.push(p[1]);
        self.verts.push(p[2]);
        self.verts.push(n[0]);
        self.verts.push(n[1]);
        self.verts.push(n[2]);
        self.verts.push(c[0]);
        self.verts.push(c[1]);
        self.verts.push(c[2]);
        i as u32
    }

    fn tri(inout self, a: u32, b: u32, c: u32) {
        self.index.push(a);
        self.index.push(b);
        self.index.push(c);
    }

    // A parallelogram from corner o along the edges u and v, with normal n.
    pub fn quad(inout self, o: [f32; 3], u: [f32; 3], v: [f32; 3], n: [f32; 3], c: [f32; 3]) {
        let a = self.vertex(o, n, c);
        let b = self.vertex(add3(o, u), n, c);
        let d = self.vertex(add3(o, v), n, c);
        let e = self.vertex(add3(add3(o, u), v), n, c);
        self.tri(a, b, e);
        self.tri(a, e, d);
    }

    // An axis-aligned box: centre c, half sizes h.
    pub fn boxed(inout self, c: [f32; 3], h: [f32; 3], col: [f32; 3]) {
        let x = h[0];
        let y = h[1];
        let z = h[2];
        let lo = sub3(c, h);
        let x2: [f32; 3] = [2.0 * x, 0.0, 0.0];
        let y2: [f32; 3] = [0.0, 2.0 * y, 0.0];
        let z2: [f32; 3] = [0.0, 0.0, 2.0 * z];
        let px: [f32; 3] = [1.0, 0.0, 0.0];
        let py: [f32; 3] = [0.0, 1.0, 0.0];
        let pz: [f32; 3] = [0.0, 0.0, 1.0];
        // the face at +x, -x, +y, -y, +z, -z
        self.quad(add3(lo, [2.0 * x, 0.0, 0.0]), y2, z2, px, col);
        self.quad(lo, z2, y2, scale3(px, -1.0), col);
        self.quad(add3(lo, [0.0, 2.0 * y, 0.0]), z2, x2, py, col);
        self.quad(lo, x2, z2, scale3(py, -1.0), col);
        self.quad(add3(lo, [0.0, 0.0, 2.0 * z]), x2, y2, pz, col);
        self.quad(lo, y2, x2, scale3(pz, -1.0), col);
    }

    // A UV sphere: centre c, radius r, 16 rings and 24 segments.
    pub fn sphere(inout self, c: [f32; 3], r: f32, col: [f32; 3]) {
        let rings: i64 = 16;
        let segs: i64 = 24;
        let base = self.vertex_count() as u32;
        for i in 0..rings + 1 {
            let th = PI * (i as f32) / (rings as f32);
            for j in 0..segs + 1 {
                let ph = 2.0 * PI * (j as f32) / (segs as f32);
                let n: [f32; 3] = [th.sin() * ph.cos(), th.cos(), th.sin() * ph.sin()];
                self.vertex(add3(c, scale3(n, r)), n, col);
            }
        }
        let row = (segs + 1) as u32;
        for i in 0..rings {
            for j in 0..segs {
                let a = base + (i as u32) * row + (j as u32);
                let b = a + row;
                self.tri(a, b, a + 1);
                self.tri(a + 1, b, b + 1);
            }
        }
    }

    // A square floor of side 2 * half, in tiles x tiles checks.
    pub fn floor(inout self, half: f32, tiles: i64) {
        let s = 2.0 * half / (tiles as f32);
        let up: [f32; 3] = [0.0, 1.0, 0.0];
        for i in 0..tiles {
            for j in 0..tiles {
                let col: [f32; 3] = if (i + j) % 2 == 0 {
                    [0.62, 0.62, 0.66]
                } else {
                    [0.22, 0.24, 0.28]
                };
                let o: [f32; 3] = [-half + (i as f32) * s, 0.0, -half + (j as f32) * s];
                self.quad(o, [s, 0.0, 0.0], [0.0, 0.0, s], up, col);
            }
        }
    }
}

// A value in 0..1 from a seed and a salt (a small integer hash, the same
// on every run).
pub fn rnd(seed: i64, salt: i64) -> f32 {
    var s = (seed * 1000003 + salt * 7919 + 12345) % 2147483648;
    s = (s * 48271) % 2147483647;
    s = (s * 48271) % 2147483647;
    ((s % 1000003) as f32) / 1000003.0
}

// The colour of hue h (in turns), saturation s, value v.
pub fn hsv(h: f32, s: f32, v: f32) -> [f32; 3] {
    let hh = h - h.floor();
    let r = clamp01((hh * 6.0 - 3.0).abs() - 1.0);
    let g = clamp01(2.0 - (hh * 6.0 - 2.0).abs());
    let b = clamp01(2.0 - (hh * 6.0 - 4.0).abs());
    [v * ((1.0 - s) + s * r), v * ((1.0 - s) + s * g), v * ((1.0 - s) + s * b)]
}

fn clamp01(x: f32) -> f32 {
    if x < 0.0 { 0.0 } else if x > 1.0 { 1.0 } else { x }
}

// The scene's mesh: the floor, 7 x 7 boxes of seeded heights, three spheres.
pub fn build_scene(gpa: Gpa) -> Mesh {
    var m = Mesh::new_in(gpa);
    m.floor(20.0, 10);
    for gx in 0..7 {
        for gz in 0..7 {
            let seed = gx * 7 + gz;
            let x = -12.0 + 4.0 * (gx as f32);
            let z = -12.0 + 4.0 * (gz as f32);
            let hh = 0.5 + 2.2 * rnd(seed, 1);
            let col = hsv(rnd(seed, 2), 0.55, 0.85);
            m.boxed([x, hh, z], [0.8, hh, 0.8], col);
        }
    }
    m.sphere([2.0, 1.5, 2.0], 1.5, [0.9, 0.45, 0.2]);
    m.sphere([-6.0, 1.5, 6.0], 1.5, [0.85, 0.85, 0.9]);
    m.sphere([10.0, 1.5, -6.0], 1.5, [0.3, 0.7, 0.9]);
    m
}

// The lights at time t, into out (n * 8 f32s, sized by the caller). Light
// i orbits a centre on the floor at its own speed, height and colour.
pub fn lights_into(n: i64, t: f32, out: inout Vec<f32>) {
    for i in 0..n {
        let s = i * 11;
        let cx = (rnd(s, 1) * 2.0 - 1.0) * 19.0;
        let cz = (rnd(s, 2) * 2.0 - 1.0) * 19.0;
        let rr = 1.5 + 4.0 * rnd(s, 3);
        let sp = 0.25 + 0.6 * rnd(s, 4);
        let ph = 6.2831853 * rnd(s, 5);
        let y = 0.4 + 1.6 * rnd(s, 6);
        let a = sp * t + ph;
        let c = hsv(rnd(s, 7) + 0.02 * t, 0.85, 1.0);
        let b = (i * LIGHT_FLOATS) as i64;
        out[b] = cx + rr * a.cos();
        out[b + 1] = y;
        out[b + 2] = cz + rr * a.sin();
        out[b + 3] = 2.5 + 1.5 * rnd(s, 8);
        out[b + 4] = c[0];
        out[b + 5] = c[1];
        out[b + 6] = c[2];
        out[b + 7] = 0.9;
    }
}

#[test]
fn the_floor_is_a_hundred_quads(gpa: Gpa) {
    var m = Mesh::new_in(gpa);
    m.floor(20.0, 10);
    assert_eq(m.vertex_count(), 400);
    assert_eq(m.index.len(), 600);
}

#[test]
fn the_scene_indices_stay_inside_its_vertices(gpa: Gpa) {
    let m = build_scene(gpa);
    let n = m.vertex_count();
    assert(n > 1000);
    assert(m.index.len() % 3 == 0);
    for k in 0..m.index.len() {
        assert(m.index[k] < n as u32);
    }
}

#[test]
fn hsv_gives_the_primaries() {
    let r = hsv(0.0, 1.0, 1.0);
    let g = hsv(1.0 / 3.0, 1.0, 1.0);
    let b = hsv(2.0 / 3.0, 1.0, 1.0);
    assert(r[0] > 0.99 && r[1] < 0.01 && r[2] < 0.01);
    assert(g[1] > 0.99 && g[0] < 0.01 && g[2] < 0.01);
    assert(b[2] > 0.99 && b[0] < 0.01 && b[1] < 0.01);
}

#[test]
fn rnd_is_in_range_and_moves() {
    let a = rnd(3, 1);
    let b = rnd(4, 1);
    assert(a >= 0.0 && a < 1.0 && b >= 0.0 && b < 1.0);
    assert(a != b);
}

#[test]
fn the_lights_stay_near_the_floor_and_are_coloured(gpa: Gpa) {
    var out: Vec<f32> = Vec::new_in(gpa);
    for k in 0..256 * 8 {
        out.push(0.0);
    }
    lights_into(256, 1.5, &out);
    for i in 0..256 {
        let b = i * 8;
        assert(out[b].abs() < 30.0 && out[b + 2].abs() < 30.0);
        assert(out[b + 1] > 0.0 && out[b + 1] < 3.0);
        assert(out[b + 3] > 0.0);
        assert(out[b + 4] >= 0.0 && out[b + 4] <= 1.0);
    }
}
