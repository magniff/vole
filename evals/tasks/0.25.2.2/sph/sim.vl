// The SPH fluid on the GPU: the particles' buffers (made once, in new_in),
// seven compute kernels and the picture's pipeline, with a bind group
// each. A substep is clear, count, scan, scatter (the grid: a counting
// sort of the particles by cell), density, forces, integration. Nothing is
// read back in a frame and nothing is allocated in one.

use std::gpu;
use std::gpu::{BufferUsage, Format, PassDesc, TextureUsage};

use geom::{grid_side, lattice, pack, Knobs};
use shaders::{CLEAR, COUNT, DENSITY, FORCE, INTEGRATE, PRE, RENDER, SCAN, SCATTER};

pub struct Sim {
    pub dev: gpu::Device,
    pub queue: gpu::Queue,
    // the particles, and the grid's side (cells across and down)
    pub n: i64,
    pub gx: i64,
    pub gy: i64,
    pub cells: i64,
    ubuf: gpu::Buffer,
    pub pos: gpu::Buffer,
    pub vel: gpu::Buffer,
    acc: gpu::Buffer,
    pub dens: gpu::Buffer,
    pub cellid: gpu::Buffer,
    pub sorted: gpu::Buffer,
    pub counts: gpu::Buffer,
    pub starts: gpu::Buffer,
    cursor: gpu::Buffer,
    pub penmax: gpu::Buffer,
    k_clear: gpu::ComputePipeline,
    k_count: gpu::ComputePipeline,
    k_scan: gpu::ComputePipeline,
    k_scatter: gpu::ComputePipeline,
    k_density: gpu::ComputePipeline,
    k_force: gpu::ComputePipeline,
    k_integrate: gpu::ComputePipeline,
    render: gpu::RenderPipeline,
    g_clear: gpu::BindGroup,
    g_count: gpu::BindGroup,
    g_scan: gpu::BindGroup,
    g_scatter: gpu::BindGroup,
    g_density: gpu::BindGroup,
    g_force: gpu::BindGroup,
    g_integrate: gpu::BindGroup,
    g_render: gpu::BindGroup,
    // the start layout and zero velocities, for reset
    start: Vec<f32>,
    zeros: Vec<u8>,
}

// A compute pipeline from the shader made of `parts`, its entry point `main`.
fn kernel(dev: gpu::Device, parts: [[u8]], gpa: Gpa) -> Result<gpu::ComputePipeline, gpu::Error> {
    var src = Buf::new_in(gpa);
    for p in parts {
        src.push_str(p);
    }
    let shader = dev.shader_wgsl(src.as_slice())?;
    dev.compute_pipeline(shader, "main")
}

fn storage(dev: gpu::Device, bytes: i64) -> gpu::Buffer {
    dev.buffer(bytes, BufferUsage::STORAGE | BufferUsage::COPY_DST | BufferUsage::MAP_READ)
}

// One kernel over `groups` workgroups.
fn run(pass: inout gpu::ComputePass, k: gpu::ComputePipeline, g: gpu::BindGroup, groups: i64) {
    pass.set_pipeline(k);
    pass.set_bind_group(0, g);
    pass.dispatch(groups);
}

impl Sim {
    // `side` x `side` particles in the start block, on the system's GPU.
    pub fn new_in(side: i64, gpa: Gpa) -> Result<Sim, gpu::Error> {
        let inst = gpu::Instance::new_in(gpa);
        let (dev, queue) = inst.adapter()?.device()?;
        let n = side * side;
        let gs = grid_side();
        let cells = gs * gs;
        let start = lattice(side, gpa);

        let ubuf = dev.buffer(128, BufferUsage::UNIFORM | BufferUsage::COPY_DST);
        let pos = dev.buffer_init(gpu::bytes_of_f32(start.as_slice()),
            BufferUsage::STORAGE | BufferUsage::COPY_DST | BufferUsage::MAP_READ);
        let vel = storage(dev, n * 8);
        let acc = storage(dev, n * 8);
        let dens = storage(dev, n * 4);
        let cellid = storage(dev, n * 4);
        let sorted = storage(dev, n * 4);
        let counts = storage(dev, cells * 4);
        let starts = storage(dev, (cells + 1) * 4);
        let cursor = storage(dev, cells * 4);
        let penmax = storage(dev, 4);

        let k_clear = kernel(dev, [PRE, CLEAR][..], gpa)?;
        let k_count = kernel(dev, [PRE, COUNT][..], gpa)?;
        let k_scan = kernel(dev, [PRE, SCAN][..], gpa)?;
        let k_scatter = kernel(dev, [PRE, SCATTER][..], gpa)?;
        let k_density = kernel(dev, [PRE, DENSITY][..], gpa)?;
        let k_force = kernel(dev, [PRE, FORCE][..], gpa)?;
        let k_integrate = kernel(dev, [PRE, INTEGRATE][..], gpa)?;
        var rsrc = Buf::new_in(gpa);
        rsrc.push_str(PRE);
        rsrc.push_str(RENDER);
        let rshader = dev.shader_wgsl(rsrc.as_slice())?;
        let render = dev.render_pipeline(gpu::RenderDesc::new(rshader, "vs", "fs",
            Format::Bgra8Unorm))?;

        let b = gpu::bind;
        let g_clear = dev.bind_group(k_clear.bind_layout(0), [b(0, ubuf), b(1, counts)][..]);
        let g_count = dev.bind_group(k_count.bind_layout(0),
            [b(0, ubuf), b(1, pos), b(2, cellid), b(3, counts)][..]);
        let g_scan = dev.bind_group(k_scan.bind_layout(0),
            [b(0, ubuf), b(1, counts), b(2, starts), b(3, cursor)][..]);
        let g_scatter = dev.bind_group(k_scatter.bind_layout(0),
            [b(0, ubuf), b(1, cellid), b(2, cursor), b(3, sorted)][..]);
        let g_density = dev.bind_group(k_density.bind_layout(0),
            [b(0, ubuf), b(1, pos), b(2, starts), b(3, sorted), b(4, cellid), b(5, dens)][..]);
        let g_force = dev.bind_group(k_force.bind_layout(0),
            [b(0, ubuf), b(1, pos), b(2, vel), b(3, dens), b(4, starts), b(5, sorted),
                b(6, cellid), b(7, acc)][..]);
        let g_integrate = dev.bind_group(k_integrate.bind_layout(0),
            [b(0, ubuf), b(1, pos), b(2, vel), b(3, acc), b(4, penmax)][..]);
        let g_render = dev.bind_group(render.bind_layout(0),
            [b(0, ubuf), b(1, pos), b(2, vel)][..]);

        var zeros: Vec<u8> = Vec::filled_in(n * 8, 0u8, gpa);
        Ok(Sim {
            dev: dev, queue: queue, n: n, gx: gs, gy: gs, cells: cells, ubuf: ubuf,
            pos: pos, vel: vel, acc: acc, dens: dens, cellid: cellid, sorted: sorted,
            counts: counts, starts: starts, cursor: cursor, penmax: penmax,
            k_clear: k_clear, k_count: k_count, k_scan: k_scan, k_scatter: k_scatter,
            k_density: k_density, k_force: k_force, k_integrate: k_integrate, render: render,
            g_clear: g_clear, g_count: g_count, g_scan: g_scan, g_scatter: g_scatter,
            g_density: g_density, g_force: g_force, g_integrate: g_integrate,
            g_render: g_render, start: start, zeros: zeros,
        })
    }

    // The uniform of the next frame's steps and picture (written in queue
    // order, so a frame in flight keeps its own).
    pub fn set_knobs(inout self, k: Knobs) {
        let words = pack(k, self.n, self.gx, self.gy);
        self.queue.write_buffer(self.ubuf, 0, gpu::bytes_of_f32(words[..]));
    }

    // Back to the start block, at rest.
    pub fn reset(inout self) {
        self.queue.write_buffer(self.pos, 0, gpu::bytes_of_f32(self.start.as_slice()));
        self.queue.write_buffer(self.vel, 0, self.zeros.as_slice());
        self.queue.write_buffer(self.penmax, 0, [0u8, 0u8, 0u8, 0u8][..]);
    }

    // The grid of the current positions only: clear, count, scan, scatter.
    pub fn build_grid(inout self, enc: inout gpu::Encoder) {
        let cg = (self.cells + 63) / 64;
        let groups = (self.n + 63) / 64;
        enc.compute_pass(|pass| {
            run(&pass, self.k_clear, self.g_clear, cg);
            run(&pass, self.k_count, self.g_count, groups);
            run(&pass, self.k_scan, self.g_scan, 1);
            run(&pass, self.k_scatter, self.g_scatter, groups);
        });
    }

    // `substeps` substeps, recorded into `enc`.
    pub fn step(inout self, enc: inout gpu::Encoder, substeps: i64) {
        let cg = (self.cells + 63) / 64;
        let groups = (self.n + 63) / 64;
        enc.compute_pass(|pass| {
            for _ in 0..substeps {
                run(&pass, self.k_clear, self.g_clear, cg);
                run(&pass, self.k_count, self.g_count, groups);
                run(&pass, self.k_scan, self.g_scan, 1);
                run(&pass, self.k_scatter, self.g_scatter, groups);
                run(&pass, self.k_density, self.g_density, groups);
                run(&pass, self.k_force, self.g_force, groups);
                run(&pass, self.k_integrate, self.g_integrate, groups);
            }
        });
    }

    // The particles, coloured by speed, into `target`.
    pub fn draw(self, enc: inout gpu::Encoder, target: gpu::TextureView) {
        let n = self.n;
        enc.render_pass(PassDesc::color(target), |pass| {
            pass.set_pipeline(self.render);
            pass.set_bind_group(0, self.g_render);
            pass.draw(0..6, 0..n);
        });
    }

    // The picture of the current state, w x h pixels, as a binary PPM
    // (waits for the GPU).
    pub fn snapshot_in(inout self, w: i64, h: i64, gpa: Gpa) -> Buf {
        let tex = self.dev.texture(w, h, Format::Bgra8Unorm,
            usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);
        let stride = (w * 4 + 255) / 256 * 256;
        var out = self.dev.buffer(stride * h, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
        var enc = self.dev.encoder();
        self.draw(&enc, tex.view());
        enc.copy_texture_to_buffer(tex, out, stride);
        self.queue.submit(enc.finish());
        let px = out.map_read(self.dev);
        var b = format_in(f"P6\n{w} {h}\n255\n", gpa);
        for y in 0..h {
            for x in 0..w {
                let i = y * stride + x * 4;
                b.push(px[i + 2]);
                b.push(px[i + 1]);
                b.push(px[i]);
            }
        }
        b
    }
}
