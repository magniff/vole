#!/usr/bin/env python3
"""Run a GPU program with the GPU to itself (the eval's harness).

usage: gpu-run [--timeout SECONDS] [--] COMMAND [ARGS...]

Several agents share this machine and its one GPU. Every run of a
program that uses the GPU goes through this wrapper: it waits for a
machine-wide lock, runs COMMAND alone, and releases the lock when COMMAND
ends, however it ends (the kernel drops the lock if this process dies).
So timings (frame times, tokens per second) are measured on an
uncontended GPU. It prints how long it waited, and the machine's load
when the run started, on stderr. COMMAND is killed after --timeout
seconds (default 300), so a hung program cannot block the others; the
exit status is COMMAND's, or 124 on a timeout.
"""
import fcntl
import os
import signal
import subprocess
import sys
import time

LOCK = "/tmp/vole-eval-gpu.lock"


def main():
    args = sys.argv[1:]
    timeout = 300.0
    if args[:1] == ["--timeout"]:
        if len(args) < 2:
            sys.exit("gpu-run: --timeout needs a number of seconds")
        timeout = float(args[1])
        args = args[2:]
    if args[:1] == ["--"]:
        args = args[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if args else 2
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o666)
    t0 = time.time()
    fcntl.flock(fd, fcntl.LOCK_EX)
    waited = time.time() - t0
    load = os.getloadavg()[0]
    sys.stderr.write("gpu-run: waited %.1f s for the GPU; load %.1f\n" % (waited, load))
    sys.stderr.flush()
    proc = subprocess.Popen(args, start_new_session=True)
    try:
        return proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        try:
            # (round 3) bounded: a child stuck in the driver may not die at
            # once, and the lock must not wait on it
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            sys.stderr.write("gpu-run: pid %d did not end 10 s after SIGKILL; the lock is released anyway\n" % proc.pid)
        sys.stderr.write("gpu-run: killed after %.0f s (--timeout)\n" % timeout)
        return 124
    except KeyboardInterrupt:
        os.killpg(proc.pid, signal.SIGKILL)
        return 130
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


if __name__ == "__main__":
    sys.exit(main())
