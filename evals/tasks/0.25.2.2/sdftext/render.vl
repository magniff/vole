// The GPU side: one pipeline that draws the canvas's triangles with
// alpha blending into a target of Bgra8Unorm (a window's frame, or a
// texture read back for the headless shot), and the atlas texture.

use std::gpu;
use std::gpu::{BufferUsage, Format, PassDesc, RenderDesc, SamplerDesc, VertexFormat, VertexLayout};

use crate::atlas;
use crate::canvas::Canvas;
use crate::shaders::DRAW;

// The vertex buffer's size: 4 MiB, about 12 000 glyphs a frame.
pub const VB_BYTES: i64 = 4194304;

pub struct Renderer {
    pub pipe: gpu::RenderPipeline,
    pub group: gpu::BindGroup,
    pub vb: gpu::Buffer,
}

impl Renderer {
    // The pipeline, the atlas (written once, here) and the vertex buffer.
    pub fn new_in(dev: gpu::Device, queue: inout gpu::Queue, gpa: Gpa) -> Result<Renderer,
        gpu::Error> {
        let shader = dev.shader_wgsl(DRAW)?;
        var desc = RenderDesc::new(shader, "vs", "fs", Format::Bgra8Unorm);
        var layout = VertexLayout::new(36);
        layout.attribute(0, VertexFormat::Float32x2, 0);
        layout.attribute(1, VertexFormat::Float32x2, 8);
        layout.attribute(2, VertexFormat::Float32x4, 16);
        layout.attribute(3, VertexFormat::Float32, 32);
        desc.vertex_buffer(layout);
        desc.blend(gpu::Blend::alpha(), target: 0);
        let pipe = dev.render_pipeline(desc)?;
        let img = atlas::build(gpa);
        let tex = dev.texture(atlas::W, atlas::H, Format::R8Unorm);
        queue.write_texture(tex, img.as_slice(), atlas::W);
        let samp = dev.sampler(SamplerDesc::linear());
        let group = dev.bind_group(pipe.bind_layout(0),
            [gpu::bind_texture(0, tex.view()), gpu::bind_sampler(1, samp)][..]);
        let vb = dev.buffer(VB_BYTES, BufferUsage::VERTEX | BufferUsage::COPY_DST);
        Ok(Renderer { pipe: pipe, group: group, vb: vb })
    }

    // Records the canvas into `enc`: its vertices written, then one pass
    // into `target`. False when the canvas does not fit the buffer.
    pub fn record(inout self, queue: inout gpu::Queue, enc: inout gpu::Encoder,
        cv: Canvas, target: gpu::TextureView) -> bool {
        let n = cv.count();
        if n * 36 > VB_BYTES {
            return false;
        }
        queue.write_buffer(self.vb, 0, gpu::bytes_of_f32(cv.v.as_slice()));
        let pipe = self.pipe;
        let group = self.group;
        let vb = self.vb;
        enc.render_pass(PassDesc::color(target), |pass| {
            pass.set_pipeline(pipe);
            pass.set_bind_group(0, group);
            pass.set_vertex_buffer(0, vb);
            pass.draw(0..n, 0..1);
        });
        true
    }
}
