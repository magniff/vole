// A stroke font for the glyph atlas: each glyph is a set of straight
// strokes (a vector description, not a bitmap). Design units: x in
// 0..60, y in 0..100 (y down, 0 is the cap line, 100 the baseline),
// so a capital is 100 units high and the advance is 80 units.
//
// A glyph's string: its character, a space, then its strokes; a stroke
// is a run of "x y" pairs, strokes are separated by ';'. Lowercase
// letters use the capitals. The atlas (atlas.vl) turns the strokes into
// distance fields; nothing here is rasterised.

pub const GLYPHS: [[u8]; 51] = [
    "0 0 0 60 0 60 100 0 100 0 0; 10 90 50 10",
    "1 30 0 30 100; 10 20 30 0; 10 100 50 100",
    "2 0 0 60 0 60 50 0 50 0 100 60 100",
    "3 0 0 60 0 60 100 0 100; 10 50 60 50",
    "4 0 0 0 50 60 50; 45 0 45 100",
    "5 60 0 0 0 0 50 60 50 60 100 0 100",
    "6 60 0 0 0 0 100 60 100 60 50 0 50",
    "7 0 0 60 0 25 100",
    "8 0 0 60 0 60 100 0 100 0 0; 0 50 60 50",
    "9 0 100 60 100 60 0 0 0 0 50 60 50",
    "A 0 100 30 0 60 100; 10 60 50 60",
    "B 0 0 0 100 45 100 60 80 60 70 45 50 0 50; 0 0 45 0 60 20 60 30 45 50",
    "C 60 15 45 0 15 0 0 15 0 85 15 100 45 100 60 85",
    "D 0 0 0 100 40 100 60 75 60 25 40 0 0 0",
    "E 60 0 0 0 0 100 60 100; 0 50 45 50",
    "F 0 100 0 0 60 0; 0 50 45 50",
    "G 60 15 45 0 15 0 0 15 0 85 15 100 45 100 60 85 60 55 35 55",
    "H 0 0 0 100; 60 0 60 100; 0 50 60 50",
    "I 15 0 45 0; 30 0 30 100; 15 100 45 100",
    "J 60 0 60 85 45 100 15 100 0 85",
    "K 0 0 0 100; 60 0 0 60; 20 40 60 100",
    "L 0 0 0 100 60 100",
    "M 0 100 0 0 30 60 60 0 60 100",
    "N 0 100 0 0 60 100 60 0",
    "O 15 0 45 0 60 15 60 85 45 100 15 100 0 85 0 15 15 0",
    "P 0 100 0 0 45 0 60 15 60 35 45 50 0 50",
    "Q 15 0 45 0 60 15 60 85 45 100 15 100 0 85 0 15 15 0; 40 70 60 100",
    "R 0 100 0 0 45 0 60 15 60 35 45 50 0 50; 30 50 60 100",
    "S 60 10 45 0 15 0 0 10 0 40 15 50 45 50 60 60 60 90 45 100 15 100 0 90",
    "T 0 0 60 0; 30 0 30 100",
    "U 0 0 0 85 15 100 45 100 60 85 60 0",
    "V 0 0 30 100 60 0",
    "W 0 0 15 100 30 40 45 100 60 0",
    "X 0 0 60 100; 60 0 0 100",
    "Y 0 0 30 50 60 0; 30 50 30 100",
    "Z 0 0 60 0 0 100 60 100",
    ". 25 90 35 90 35 100 25 100 25 90",
    "- 10 50 50 50",
    "+ 30 25 30 75; 10 50 50 50",
    "= 10 35 50 35; 10 65 50 65",
    "/ 60 0 0 100",
    "! 30 0 30 70; 30 90 30 100",
    "? 0 15 15 0 45 0 60 15 60 35 30 55 30 70; 30 90 30 100",
    "( 40 0 20 20 20 80 40 100",
    ") 20 0 40 20 40 80 20 100",
    "% 0 0 60 100; 0 0 15 0 15 15 0 15 0 0; 45 85 60 85 60 100 45 100 45 85",
    "* 30 20 30 80; 10 35 50 65; 50 35 10 65",
    ": 30 30 30 40; 30 80 30 90",
    "' 30 0 30 20",
    "_ 0 100 60 100",
    "# 20 0 15 100; 45 0 40 100; 5 35 60 35; 0 65 55 65",
];

// The index of the glyph for a character (lowercase letters are drawn
// as capitals), or -1 when the font has none (a space included).
pub fn glyph_index(c: u8) -> i64 {
    var want = c;
    if c >= 'a' && c <= 'z' {
        want = c - 32;
    }
    for i in 0..GLYPHS.len() {
        if GLYPHS[i][0] == want {
            return i as i64;
        }
    }
    -1
}

// One straight stroke of a glyph, in design units.
pub struct Seg {
    pub ax: f32,
    pub ay: f32,
    pub bx: f32,
    pub by: f32,
}

// The segments of glyph i (GLYPHS[i]): each pair of consecutive points
// in a stroke is a segment.
pub fn segments(i: i64, gpa: Gpa) -> Vec<Seg> {
    var out: Vec<Seg> = Vec::new_in(gpa);
    let g = GLYPHS[i];
    var pts: Vec<i64> = Vec::new_in(gpa);
    var start: i64 = 0;
    var num: i64 = 0;
    var in_num = false;
    for k in 2..g.len() + 1 {
        let c = if k < g.len() { g[k] } else { ';' };
        if c >= '0' && c <= '9' {
            num = num * 10 + (c - '0') as i64;
            in_num = true;
        } else {
            if in_num {
                pts.push(num);
                num = 0;
                in_num = false;
            }
            if c == ';' || k == g.len() {
                let n = pts.len() as i64 - start;
                var q: i64 = 0;
                while q + 3 < n {
                    let a = start + q;
                    out.push(Seg {
                        ax: pts[a] as f32,
                        ay: pts[a + 1] as f32,
                        bx: pts[a + 2] as f32,
                        by: pts[a + 3] as f32,
                    });
                    q += 2;
                }
                start = pts.len() as i64;
            }
        }
    }
    out
}

#[test]
fn every_glyph_has_strokes(gpa: Gpa) {
    for i in 0..GLYPHS.len() {
        let s = segments(i as i64, gpa);
        assert_eq(s.len() > 0, true);
    }
}
