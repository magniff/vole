// The glyph atlas: a signed distance field for every glyph of font.vl,
// computed at startup from its strokes (the exact distance to the
// nearest stroke, minus the stroke's half width). Each glyph has a square
// cell of CELL texels that covers SPAN design units from (ORIGIN_X,
// ORIGIN_Y); the stored value is 0.5 on the outline, above 0.5 inside,
// and it falls to 0 and 1 over SPREAD units either side. The shader
// thresholds it with fwidth, so the edge is as sharp as the screen.

use font::{GLYPHS, Seg, segments};

pub const CELL: i64 = 96;
pub const COLS: i64 = 16;
pub const ROWS: i64 = (GLYPHS.len() as i64 + COLS - 1) / COLS;
pub const W: i64 = COLS * CELL;
pub const H: i64 = ROWS * CELL;

// The square each cell covers, in design units, from its top-left.
pub const SPAN: f32 = 140.0;
pub const ORIGIN_X: f32 = -40.0;
pub const ORIGIN_Y: f32 = -20.0;
// Half the stroke's width, and the distance over which the value goes
// from 0.5 to 0 or 1.
pub const HALF: f32 = 7.0;
pub const SPREAD: f32 = 14.0;

// The distance from (px, py) to a segment.
pub fn seg_dist(s: Seg, px: f32, py: f32) -> f32 {
    let dx = s.bx - s.ax;
    let dy = s.by - s.ay;
    let len2 = dx * dx + dy * dy;
    var t: f32 = 0.0;
    if len2 > 0.0 {
        t = ((px - s.ax) * dx + (py - s.ay) * dy) / len2;
    }
    t = t.clamp(0.0, 1.0);
    let ex = s.ax + dx * t - px;
    let ey = s.ay + dy * t - py;
    (ex * ex + ey * ey).sqrt()
}

// The atlas value (0 to 1) of a glyph's segments at a design point.
pub fn value_at(segs: [Seg], px: f32, py: f32) -> f32 {
    var d: f32 = 1000000.0;
    for i in 0..segs.len() {
        let e = seg_dist(segs[i], px, py);
        if e < d {
            d = e;
        }
    }
    let v = 0.5 - (d - HALF) / (2.0 * SPREAD);
    v.clamp(0.0, 1.0)
}

// The atlas: W x H bytes, row by row, glyph i in cell (i % COLS, i / COLS).
pub fn build(gpa: Gpa) -> Vec<u8> {
    var img: Vec<u8> = Vec::new_in(gpa);
    for _ in 0..W * H {
        img.push(0);
    }
    for g in 0..GLYPHS.len() {
        let segs = segments(g as i64, gpa);
        let cx = (g as i64 % COLS) * CELL;
        let cy = (g as i64 / COLS) * CELL;
        for y in 0..CELL {
            for x in 0..CELL {
                let px = ORIGIN_X + (x as f32 + 0.5) / CELL as f32 * SPAN;
                let py = ORIGIN_Y + (y as f32 + 0.5) / CELL as f32 * SPAN;
                let v = value_at(segs.as_slice(), px, py);
                img[(cy + y) * W + cx + x] = (v * 255.0 + 0.5) as u8;
            }
        }
    }
    img
}

// Each glyph's stroke is inside (above 0.5) at its middle and its cell's
// corner outside (below 0.5), read from the built bytes.
#[test]
fn strokes_inside_corners_outside(gpa: Gpa) {
    let img = build(gpa);
    for g in 0..GLYPHS.len() {
        let segs = segments(g as i64, gpa);
        let s = segs[0];
        let mx = (s.ax + s.bx) / 2.0;
        let my = (s.ay + s.by) / 2.0;
        let cx = (g as i64 % COLS) * CELL;
        let cy = (g as i64 / COLS) * CELL;
        let tx = ((mx - ORIGIN_X) / SPAN * CELL as f32) as i64;
        let ty = ((my - ORIGIN_Y) / SPAN * CELL as f32) as i64;
        assert_eq(img[(cy + ty) * W + cx + tx] > 128, true);
        assert_eq(img[cy * W + cx] < 128, true);
    }
}
