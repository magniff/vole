// The widgets: immediate mode. Each frame, page() calls every widget with
// its rectangle; a widget draws itself into the canvas and returns what
// the input did to it. The state that lives across frames (the clicks,
// the slider's value, the text, the list's selection) is in Ui. Input
// arrives as Ev values (feed), so the headless check drives the same code
// as the window does.

use crate::canvas::Canvas;

pub const PAGE_W: f32 = 960.0;
pub const PAGE_H: f32 = 640.0;

// Ids of the widgets (0 is none).
const ADD: i64 = 1;
const RESET: i64 = 2;
const SLIDER: i64 = 3;
const FIELD: i64 = 4;
const LIST: i64 = 5;

// The list's row height, in logical units.
pub const ROW: f32 = 28.0;

pub const FRUIT: [[u8]; 30] = [
    "APPLE", "APRICOT", "BANANA", "BILBERRY", "BLACKBERRY", "BLUEBERRY", "CHERRY",
    "COCONUT", "CRANBERRY", "DATE", "DURIAN", "FIG", "GRAPE", "GUAVA", "HONEYDEW",
    "KIWI", "KUMQUAT", "LEMON", "LIME", "LYCHEE", "MANGO", "MELON", "NECTARINE",
    "ORANGE", "PAPAYA", "PEAR", "PERSIMMON", "PINEAPPLE", "PLUM", "QUINCE",
];

const PAPER: [f32; 4] = [0.09, 0.10, 0.13, 1.0];
const PANEL: [f32; 4] = [0.14, 0.15, 0.19, 1.0];
const INK: [f32; 4] = [0.93, 0.94, 0.96, 1.0];
const DIM: [f32; 4] = [0.55, 0.58, 0.66, 1.0];
const ACCENT: [f32; 4] = [0.98, 0.64, 0.22, 1.0];
const BUTTON: [f32; 4] = [0.22, 0.36, 0.62, 1.0];
const BUTTON_HOT: [f32; 4] = [0.28, 0.44, 0.74, 1.0];
const BUTTON_DOWN: [f32; 4] = [0.16, 0.26, 0.46, 1.0];
const TRACK: [f32; 4] = [0.22, 0.23, 0.28, 1.0];
const FIELD_BG: [f32; 4] = [0.07, 0.08, 0.10, 1.0];
const FIELD_ON: [f32; 4] = [0.10, 0.13, 0.20, 1.0];
const SELECT: [f32; 4] = [0.98, 0.64, 0.22, 0.28];
const THUMB: [f32; 4] = [0.93, 0.94, 0.96, 1.0];

// What the input does: positions are logical units.
pub enum Ev {
    Move(f32, f32),
    Down,
    Up,
    // lines the content moves up (negative: down)
    Wheel(f32),
    Char(u8),
    Back,
}

pub struct Ui {
    pub cv: Canvas,
    pub gpa: Gpa,
    pub mx: f32,
    pub my: f32,
    pub down: bool,
    // edges of this frame: set by feed, cleared by end
    pub pressed: bool,
    pub released: bool,
    pub wheel: f32,
    pub keys: Vec<u8>,
    pub backs: i64,
    // across frames
    pub active: i64,
    pub focus: i64,
    pub clicks: i64,
    pub value: f32,
    pub text: Vec<u8>,
    pub sel: i64,
    pub top: i64,
}

fn inside(x: f32, y: f32, w: f32, h: f32, px: f32, py: f32) -> bool {
    px >= x && px < x + w && py >= y && py < y + h
}

impl Ui {
    pub fn new_in(pw: f32, ph: f32, sc: f32, gpa: Gpa) -> Ui {
        Ui {
            cv: Canvas::new_in(pw, ph, sc, gpa),
            gpa: gpa,
            mx: 0.0, my: 0.0, down: false, pressed: false, released: false, wheel: 0.0,
            keys: Vec::new_in(gpa), backs: 0,
            active: 0, focus: 0, clicks: 0, value: 0.42, text: Vec::new_in(gpa), sel: -1, top: 0,
        }
    }

    pub fn feed(inout self, e: Ev) {
        match e {
            Ev::Move(x, y) => {
                self.mx = x;
                self.my = y;
            }
            Ev::Down => {
                self.down = true;
                self.pressed = true;
            }
            Ev::Up => {
                self.down = false;
                self.released = true;
            }
            Ev::Wheel(d) => {
                self.wheel += d;
            }
            Ev::Char(c) => {
                self.keys.push(c);
            }
            Ev::Back => {
                self.backs += 1;
            }
        }
    }

    // Starts a frame: the canvas is emptied.
    pub fn begin(inout self) {
        self.cv.clear();
    }

    // Ends a frame: this frame's edges and typed keys are used up.
    pub fn end(inout self) {
        self.pressed = false;
        self.released = false;
        self.keys.clear();
        self.backs = 0;
    }

    // A button; true on the frame its press (here) is released here.
    pub fn button(inout self, id: i64, x: f32, y: f32, w: f32, h: f32, label: [u8]) -> bool {
        let hot = inside(x, y, w, h, self.mx, self.my);
        var clicked = false;
        if self.pressed && hot {
            self.active = id;
        }
        if self.released && self.active == id {
            if hot {
                clicked = true;
            }
            self.active = 0;
        }
        var c = BUTTON;
        if self.active == id && self.down {
            c = BUTTON_DOWN;
        } else if hot {
            c = BUTTON_HOT;
        }
        self.cv.rect(x, y, w, h, c);
        let tw = Canvas::text_width(label, 14.0);
        self.cv.text(label, x + (w - tw) / 2.0, y + (h - 14.0) / 2.0, 14.0, 0.0, INK);
        clicked
    }

    // A horizontal slider over [x, x + w] at the height y: dragging (or a
    // press on the track) sets self.value in 0..1.
    pub fn slider(inout self, x: f32, y: f32, w: f32) {
        let hot = inside(x, y - 10.0, w, 20.0, self.mx, self.my);
        if self.pressed && hot {
            self.active = SLIDER;
        }
        if self.active == SLIDER && (self.down || self.released) {
            self.value = ((self.mx - x) / w).clamp(0.0, 1.0);
        }
        if self.released && self.active == SLIDER {
            self.active = 0;
        }
        let on = self.active == SLIDER || hot;
        self.cv.rect(x, y - 3.0, w, 6.0, TRACK);
        self.cv.rect(x, y - 3.0, self.value * w, 6.0, ACCENT);
        let tx = x + self.value * w;
        self.cv.rect(tx - 6.0, y - 12.0, 12.0, 24.0, if on { ACCENT } else { THUMB });
    }

    // A one-line text field. A press inside focuses it; while focused it
    // takes the typed keys and the backspaces of the frame.
    pub fn field(inout self, x: f32, y: f32, w: f32, h: f32) {
        let hot = inside(x, y, w, h, self.mx, self.my);
        if self.pressed {
            if hot {
                self.focus = FIELD;
            } else if self.focus == FIELD {
                self.focus = 0;
            }
        }
        let on = self.focus == FIELD;
        if on {
            for i in 0..self.keys.len() {
                self.text.push(self.keys[i]);
            }
            var b = self.backs;
            while b > 0 && self.text.len() > 0 {
                let _ = self.text.pop();
                b -= 1;
            }
        }
        self.cv.rect(x, y, w, h, if on { FIELD_ON } else { FIELD_BG });
        if self.text.len() == 0 && !on {
            self.cv.text("TYPE HERE", x + 12.0, y + (h - 16.0) / 2.0, 16.0, 0.0, DIM);
        } else {
            let tx = self.text.as_slice();
            self.cv.text(tx, x + 12.0, y + (h - 16.0) / 2.0, 16.0, 0.0, INK);
            if on {
                let cx = x + 12.0 + Canvas::text_width(tx, 16.0);
                self.cv.rect(cx + 2.0, y + 8.0, 2.0, h - 16.0, ACCENT);
            }
        }
    }

    // A list of rows: the wheel scrolls it (whole rows), a press on a row
    // selects it.
    pub fn list(inout self, x: f32, y: f32, w: f32, h: f32, items: [[u8]]) {
        let hot = inside(x, y, w, h, self.mx, self.my);
        let n = items.len() as i64;
        let vis = (h / ROW) as i64;
        let most = if n > vis { n - vis } else { 0 };
        if hot {
            let steps = self.wheel as i64;
            self.wheel -= steps as f32;
            self.top = clamp_i(self.top + steps, 0, most);
        } else {
            self.wheel = 0.0;
        }
        if self.pressed && hot {
            let row = self.top + ((self.my - y) / ROW) as i64;
            if row < n {
                self.sel = row;
            }
        }
        self.cv.rect(x, y, w, h, PANEL);
        for r in 0..vis {
            let i = self.top + r;
            if i < n {
                let ry = y + r as f32 * ROW;
                if i == self.sel {
                    self.cv.rect(x, ry, w, ROW, SELECT);
                }
                self.cv.text(items[i], x + 12.0, ry + (ROW - 14.0) / 2.0, 14.0, 0.0, INK);
            }
        }
        if most > 0 {
            let th = h * vis as f32 / n as f32;
            let ty = y + (h - th) * self.top as f32 / most as f32;
            self.cv.rect(x + w - 6.0, ty, 4.0, th, DIM);
        }
    }

    // The label of the list's selected row, or "NONE".
    pub fn selected_name(self) -> [u8] {
        if self.sel >= 0 { FRUIT[self.sel] } else { "NONE" }
    }

    // The whole page, widgets and text, for this frame.
    pub fn page(inout self) {
        self.begin();
        self.cv.rect(0.0, 0.0, PAGE_W, PAGE_H, PAPER);
        self.cv.text("SDF TEXT", 30.0, 22.0, 44.0, 0.0, INK);
        self.cv.text("STROKE FONT, DISTANCE FIELD ATLAS", 30.0, 80.0, 12.0, 0.0, DIM);
        self.cv.text("ABCDEFGHIJKLM", 30.0, 108.0, 12.0, 0.0, INK);
        self.cv.text("NOPQRSTUVWXYZ 0123456789", 30.0, 128.0, 20.0, 0.0, INK);
        self.cv.text("THE QUICK BROWN FOX", 30.0, 160.0, 32.0, 0.0, INK);
        self.cv.text("JUMPS OVER 42 DOGS", 30.0, 204.0, 36.0, 0.0, INK);
        self.cv.text("SDF 96", 30.0, 272.0, 96.0, 0.0, ACCENT);
        self.cv.text("TILTED -20", 40.0, 402.0, 30.0, 0.3, INK);
        self.cv.text("SPIN 46", 330.0, 540.0, 30.0, -0.8, INK);
        self.cv.text("UP", 500.0, 596.0, 60.0, -1.5707963, ACCENT);

        self.cv.text("CONTROLS", 640.0, 96.0, 16.0, 0.0, DIM);
        if self.button(ADD, 640.0, 120.0, 130.0, 40.0, "ADD") {
            self.clicks += 1;
        }
        if self.button(RESET, 790.0, 120.0, 130.0, 40.0, "RESET") {
            self.clicks = 0;
            self.text.clear();
        }
        let clicks = format_in(f"CLICKS {self.clicks}", self.gpa);
        self.cv.text(clicks.as_slice(), 640.0, 176.0, 14.0, 0.0, INK);
        let value = format_in(f"VALUE {(self.value * 100.0) as i64}", self.gpa);
        self.cv.text(value.as_slice(), 640.0, 204.0, 14.0, 0.0, INK);
        self.slider(640.0, 240.0, 280.0);
        self.cv.text("NAME", 640.0, 290.0, 14.0, 0.0, DIM);
        self.field(640.0, 310.0, 280.0, 40.0);
        self.cv.text("FRUIT, WHEEL TO SCROLL", 640.0, 376.0, 14.0, 0.0, DIM);
        self.list(640.0, 398.0, 280.0, 140.0, FRUIT[..]);
        self.cv.text("SELECTED", 640.0, 556.0, 14.0, 0.0, DIM);
        self.cv.text(self.selected_name(), 740.0, 556.0, 14.0, 0.0, ACCENT);
        self.cv.text("CLICK AND DRAG THE SLIDER, TYPE IN THE FIELD, WHEEL THE LIST, ESC QUITS",
            30.0, 610.0, 12.0, 0.0, DIM);
    }
}

fn clamp_i(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

#[test]
fn button_clicks_on_release_inside(gpa: Gpa) {
    var ui = Ui::new_in(PAGE_W, PAGE_H, 1.0, gpa);
    ui.begin();
    ui.feed(Ev::Move(650.0, 130.0));
    ui.feed(Ev::Down);
    ui.feed(Ev::Move(900.0, 300.0));
    ui.feed(Ev::Up);
    // released outside the button: no click
    assert_eq(ui.button(ADD, 640.0, 120.0, 130.0, 40.0, "ADD"), false);
    ui.end();
    ui.begin();
    ui.feed(Ev::Move(650.0, 130.0));
    ui.feed(Ev::Down);
    ui.feed(Ev::Up);
    assert_eq(ui.button(ADD, 640.0, 120.0, 130.0, 40.0, "ADD"), true);
    ui.end();
}

#[test]
fn slider_follows_the_pointer_and_clamps(gpa: Gpa) {
    var ui = Ui::new_in(PAGE_W, PAGE_H, 1.0, gpa);
    ui.begin();
    ui.feed(Ev::Move(640.0 + 0.25 * 280.0, 240.0));
    ui.feed(Ev::Down);
    ui.slider(640.0, 240.0, 280.0);
    ui.feed(Ev::Move(2000.0, 240.0));
    ui.slider(640.0, 240.0, 280.0);
    ui.feed(Ev::Up);
    ui.slider(640.0, 240.0, 280.0);
    assert_eq(ui.value, 1.0);
}

#[test]
fn field_types_and_backspaces_only_when_focused(gpa: Gpa) {
    var ui = Ui::new_in(PAGE_W, PAGE_H, 1.0, gpa);
    ui.begin();
    ui.feed(Ev::Char('X'));
    ui.field(640.0, 310.0, 280.0, 40.0);
    ui.end();
    assert_eq(ui.text.len(), 0);
    ui.begin();
    ui.feed(Ev::Move(700.0, 330.0));
    ui.feed(Ev::Down);
    ui.feed(Ev::Up);
    ui.field(640.0, 310.0, 280.0, 40.0);
    ui.end();
    ui.begin();
    ui.feed(Ev::Char('A'));
    ui.feed(Ev::Char('B'));
    ui.feed(Ev::Back);
    ui.feed(Ev::Back);
    ui.feed(Ev::Back);
    ui.field(640.0, 310.0, 280.0, 40.0);
    ui.end();
    assert_eq(ui.text.len(), 0);
}

#[test]
fn list_scroll_is_clamped_to_its_rows(gpa: Gpa) {
    var ui = Ui::new_in(PAGE_W, PAGE_H, 1.0, gpa);
    ui.begin();
    ui.feed(Ev::Move(700.0, 450.0));
    ui.feed(Ev::Wheel(1000.0));
    ui.list(640.0, 398.0, 280.0, 140.0, FRUIT[..]);
    ui.end();
    // 30 rows, 5 visible: the last top is 25
    assert_eq(ui.top, 25);
    ui.begin();
    ui.feed(Ev::Wheel(-100.0));
    ui.list(640.0, 398.0, 280.0, 140.0, FRUIT[..]);
    ui.end();
    assert_eq(ui.top, 0);
}
