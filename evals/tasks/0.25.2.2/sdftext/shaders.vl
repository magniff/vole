// The one shader module: a solid colour (mode 0) or a glyph (mode 1),
// the glyph's coverage from the distance field in the atlas. fwidth on
// the field gives the edge's width in the frame's own pixels, so the
// text stays sharp at every size and angle.

pub const DRAW: [u8] = "struct V {\n\
    @builtin(position) pos: vec4<f32>,\n\
    @location(0) uv: vec2<f32>,\n\
    @location(1) col: vec4<f32>,\n\
    @location(2) mode: f32,\n\
    }\n\
    @group(0) @binding(0) var atlas: texture_2d<f32>;\n\
    @group(0) @binding(1) var samp: sampler;\n\
    @vertex fn vs(@location(0) p: vec2<f32>, @location(1) uv: vec2<f32>,\n\
    @location(2) col: vec4<f32>, @location(3) mode: f32) -> V {\n\
    return V(vec4<f32>(p, 0.0, 1.0), uv, col, mode);\n\
    }\n\
    @fragment fn fs(v: V) -> @location(0) vec4<f32> {\n\
    let d = textureSampleLevel(atlas, samp, v.uv, 0.0).r;\n\
    let w = fwidth(d) * 0.75 + 0.0001;\n\
    let cover = smoothstep(0.5 - w, 0.5 + w, d);\n\
    let a = select(1.0, cover, v.mode > 0.5);\n\
    return vec4<f32>(v.col.rgb, v.col.a * a);\n\
    }\n";
