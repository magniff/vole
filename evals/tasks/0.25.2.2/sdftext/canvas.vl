// The display list: an immediate-mode canvas of triangles. Everything is
// in logical units (the window's points); `sc` physical pixels make one.
// Each vertex is nine f32s: x, y (NDC, made here), u, v (the atlas), the
// colour r, g, b, a, and mode: 0 a solid colour, 1 a glyph (the colour
// times the distance field's coverage). Text is placed glyph by glyph,
// rotated about its origin on the CPU, so the shader only thresholds.

use crate::atlas::{CELL, COLS, H, ORIGIN_X, ORIGIN_Y, SPAN, W};
use crate::font::glyph_index;

// The advance from one glyph to the next, in design units (font.vl).
pub const ADVANCE: f32 = 80.0;

pub struct Canvas {
    pub v: Vec<f32>,
    // the physical size of the target, and physical pixels per logical unit
    pub pw: f32,
    pub ph: f32,
    pub sc: f32,
}

impl Canvas {
    pub fn new_in(pw: f32, ph: f32, sc: f32, gpa: Gpa) -> Canvas {
        Canvas { v: Vec::new_in(gpa), pw: pw, ph: ph, sc: sc }
    }

    // Empties the list (the frame's), keeping its memory.
    pub fn clear(inout self) {
        self.v.clear();
    }

    // The number of vertices.
    pub fn count(self) -> i64 {
        self.v.len() as i64 / 9
    }

    fn vert(inout self, x: f32, y: f32, u: f32, v: f32, c: [f32; 4], mode: f32) {
        let nx = x * self.sc / self.pw * 2.0 - 1.0;
        let ny = 1.0 - y * self.sc / self.ph * 2.0;
        self.v.push(nx);
        self.v.push(ny);
        self.v.push(u);
        self.v.push(v);
        self.v.push(c[0]);
        self.v.push(c[1]);
        self.v.push(c[2]);
        self.v.push(c[3]);
        self.v.push(mode);
    }

    // A solid rectangle (logical units, unrotated).
    pub fn rect(inout self, x: f32, y: f32, w: f32, h: f32, c: [f32; 4]) {
        self.vert(x, y, 0.0, 0.0, c, 0.0);
        self.vert(x + w, y, 0.0, 0.0, c, 0.0);
        self.vert(x, y + h, 0.0, 0.0, c, 0.0);
        self.vert(x, y + h, 0.0, 0.0, c, 0.0);
        self.vert(x + w, y, 0.0, 0.0, c, 0.0);
        self.vert(x + w, y + h, 0.0, 0.0, c, 0.0);
    }

    // A glyph quad: local corners (x0, y0)..(x1, y1) relative to the
    // origin (ox, oy), turned by the angle (cs, sn), with the atlas
    // rectangle (u0, v0)..(u1, v1).
    fn quad(inout self, ox: f32, oy: f32, cs: f32, sn: f32, x0: f32, y0: f32, x1: f32, y1: f32,
        u0: f32, v0: f32, u1: f32, v1: f32, c: [f32; 4]) {
        let (ax, ay) = turn(ox, oy, cs, sn, x0, y0);
        let (bx, by) = turn(ox, oy, cs, sn, x1, y0);
        let (dx, dy) = turn(ox, oy, cs, sn, x0, y1);
        let (ex, ey) = turn(ox, oy, cs, sn, x1, y1);
        self.vert(ax, ay, u0, v0, c, 1.0);
        self.vert(bx, by, u1, v0, c, 1.0);
        self.vert(dx, dy, u0, v1, c, 1.0);
        self.vert(dx, dy, u0, v1, c, 1.0);
        self.vert(bx, by, u1, v0, c, 1.0);
        self.vert(ex, ey, u1, v1, c, 1.0);
    }

    // The width of a text of `s` at `size` (its capitals' height).
    pub fn text_width(s: [u8], size: f32) -> f32 {
        s.len() as f32 * ADVANCE * size / 100.0
    }

    // Draws s with its origin at (x, y), its capitals `size` high, turned by
    // `angle` (radians, clockwise on the screen) about the origin.
    pub fn text(inout self, s: [u8], x: f32, y: f32, size: f32, angle: f32, c: [f32; 4]) {
        let k = size / 100.0;
        let cs = angle.cos();
        let sn = angle.sin();
        var pen: f32 = 0.0; // in design units
        for i in 0..s.len() {
            let g = glyph_index(s[i]);
            if g >= 0 {
                let cx = (g % COLS) * CELL;
                let cy = (g / COLS) * CELL;
                let u0 = cx as f32 / W as f32;
                let u1 = (cx + CELL) as f32 / W as f32;
                let v0 = cy as f32 / H as f32;
                let v1 = (cy + CELL) as f32 / H as f32;
                self.quad(x, y, cs, sn,
                    (pen + ORIGIN_X) * k, ORIGIN_Y * k,
                    (pen + ORIGIN_X + SPAN) * k, (ORIGIN_Y + SPAN) * k,
                    u0, v0, u1, v1, c);
            }
            pen += ADVANCE;
        }
    }
}

// The point (lx, ly) from an origin, turned by (cs, sn).
fn turn(ox: f32, oy: f32, cs: f32, sn: f32, lx: f32, ly: f32) -> (f32, f32) {
    (ox + lx * cs - ly * sn, oy + lx * sn + ly * cs)
}

#[test]
fn text_is_six_vertices_a_glyph(gpa: Gpa) {
    var cv = Canvas::new_in(960.0, 640.0, 1.0, gpa);
    cv.text("AB C", 0.0, 0.0, 20.0, 0.0, [1.0, 1.0, 1.0, 1.0]);
    // the space draws nothing: three glyphs
    assert_eq(cv.count(), 18);
    assert_eq(Canvas::text_width("AB C", 100.0), 320.0);
}
