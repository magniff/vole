// The CPU side of the wind tunnel: the lattice's constants, the map from
// a Reynolds number to the relaxation rate, the shedding estimate from the
// probe's series, and the tests of those.
//
// Units are lattice units: a step is 1, a cell is 1. The inflow speed U
// is fixed; the cylinder's diameter D is fixed; the viscosity follows the
// Reynolds number, nu = U D / Re, and the BGK relaxation rate is
// omega = 1 / (3 nu + 1/2).

// Inflow speed (cells a step; Mach 0.17, incompressible enough).
pub const INFLOW: f64 = 0.1;
// The cylinder's diameter in cells.
pub const DIAMETER: f64 = 20.0;
// The Reynolds number's range in the controls. Above about 150 the BGK
// collision went to NaN at this resolution (D = 20 cells, U = 0.1), so the
// range stops at 140.
pub const RE_MIN: f64 = 30.0;
pub const RE_MAX: f64 = 140.0;

// The relaxation rate for a Reynolds number (D2Q9, BGK).
pub fn omega_for(re: f64) -> f64 {
    let nu = INFLOW * DIAMETER / re;
    1.0 / (3.0 * nu + 0.5)
}

pub fn clamp_re(re: f64) -> f64 {
    if re < RE_MIN { RE_MIN } else if re > RE_MAX { RE_MAX } else { re }
}

// The D2Q9 weights of direction k (0: rest, 1-4: axes, 5-8: diagonals).
pub fn weight(k: i64) -> f64 {
    if k == 0 { 4.0 / 9.0 } else if k <= 4 { 1.0 / 9.0 } else { 1.0 / 36.0 }
}

// The velocity of direction k, x and y.
pub fn ex(k: i64) -> i64 {
    if k == 1 || k == 5 || k == 8 { 1 } else if k == 3 || k == 6 || k == 7 { -1 } else { 0 }
}

pub fn ey(k: i64) -> i64 {
    if k == 2 || k == 5 || k == 6 { 1 } else if k == 4 || k == 7 || k == 8 { -1 } else { 0 }
}

// The shedding estimate: the Strouhal number f D / U of the probe's
// series after its first `skip` samples, from the mean crossings
// (upward) of its mean, with the peak-to-peak amplitude.
pub struct Shedding {
    pub st: f64,
    pub amp: f64,
    pub crossings: i64,
}

pub fn shedding(xs: [f32], skip: i64) -> Shedding {
    let n = xs.len();
    var sum = 0.0;
    var lo = 1.0e30;
    var hi = -1.0e30;
    for t in skip..n {
        let x = xs[t] as f64;
        sum = sum + x;
        if x < lo { lo = x; }
        if x > hi { hi = x; }
    }
    let count_all = n - skip;
    if count_all < 3 {
        return Shedding { st: 0.0, amp: 0.0, crossings: 0 };
    }
    let mean = sum / count_all as f64;
    var first = -1.0;
    var last = -1.0;
    var crossings = 0;
    for t in (skip + 1)..n {
        let a = xs[t - 1] as f64 - mean;
        let b = xs[t] as f64 - mean;
        if a < 0.0 && b >= 0.0 {
            let at = (t - 1) as f64 + (-a) / (b - a);
            if crossings == 0 { first = at; }
            last = at;
            crossings = crossings + 1;
        }
    }
    if crossings < 2 {
        return Shedding { st: 0.0, amp: hi - lo, crossings: crossings };
    }
    let period = (last - first) / (crossings - 1) as f64;
    Shedding { st: DIAMETER / (INFLOW * period), amp: hi - lo, crossings: crossings }
}

// The relative drift of a conserved total from its first value.
pub fn drift(first: f64, now: f64) -> f64 {
    let d = now - first;
    let s = if d < 0.0 { -d } else { d };
    if first == 0.0 { s } else { s / first }
}

#[test]
fn lattice_is_isotropic() {
    var wsum = 0.0;
    var xx = 0.0;
    var yy = 0.0;
    var xy = 0.0;
    for k in 0..9 {
        wsum = wsum + weight(k);
        xx = xx + weight(k) * (ex(k) * ex(k)) as f64;
        yy = yy + weight(k) * (ey(k) * ey(k)) as f64;
        xy = xy + weight(k) * (ex(k) * ey(k)) as f64;
    }
    assert(drift(1.0, wsum) < 1.0e-12);
    assert(drift(1.0 / 3.0, xx) < 1.0e-12);
    assert(drift(1.0 / 3.0, yy) < 1.0e-12);
    assert(xy == 0.0);
}

#[test]
fn omega_at_re_100() {
    let w = omega_for(100.0);
    // nu = 0.1 * 20 / 100 = 0.02, tau = 0.56, omega = 1.7857...
    assert(drift(1.7857142857, w) < 1.0e-6);
    assert(omega_for(RE_MAX) < 2.0);
    assert(omega_for(RE_MIN) < 2.0);
}

#[test]
fn re_is_clamped() {
    assert(clamp_re(10.0) == RE_MIN);
    assert(clamp_re(1000.0) == RE_MAX);
    assert(clamp_re(120.0) == 120.0);
}

#[test]
fn strouhal_of_a_sine() {
    // A period of 1250 steps is St = 20 / (0.1 * 1250) = 0.16.
    var xs: [f32; 6000] = [0.0; 6000];
    for t in 0..6000 {
        xs[t] = (0.001 * sin_turns(t as f64 / 1250.0)) as f32;
    }
    let s = shedding(xs[..], 500);
    assert(drift(0.16, s.st) < 0.002);
    assert(s.crossings >= 4);
}

// sin of a turn count: reduced to [-0.5, 0.5) turns, then a Taylor series
// (accurate to about 1e-7 there). Std has no libm, so the test brings its own.
fn sin_turns(turns: f64) -> f64 {
    let s = turns + 0.5;
    let whole = s as i64 as f64;
    let fl = if whole > s { whole - 1.0 } else { whole };
    let y = (turns - fl) * 6.283185307179586;
    let y2 = y * y;
    y * (1.0 - y2 / 6.0 * (1.0 - y2 / 20.0 * (1.0 - y2 / 42.0 * (1.0 - y2 / 72.0))))
}
