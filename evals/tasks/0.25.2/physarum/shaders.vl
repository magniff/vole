// The WGSL of the Physarum step, one module per kernel. Each module is
// COMMON followed by one kernel's part; the shared uniform block is at
// group 0, binding 0 in all of them.
//
// Trail: two f32 grids (ping-pong). Agents deposit into a fixed-point
// i32 grid `dep` with atomicAdd (FIX units per 1.0); the diffuse kernel
// reads trail + dep, blurs, decays, adds food, and writes the other trail;
// clear_dep zeroes `dep` for the next step.

pub const COMMON: [u8] = "struct U {\n\
    ints: vec4<u32>,\n\
    sense: vec4<f32>,\n\
    trail: vec4<f32>,\n\
    mouse: vec4<f32>,\n\
    look: vec4<f32>,\n\
}\n\
@group(0) @binding(0) var<uniform> u: U;\n\
const FIX: f32 = 1024.0;\n\
const PI: f32 = 3.14159265;\n\
const TAU: f32 = 6.28318531;\n\
fn hash(x0: u32) -> u32 {\n\
    var x = x0;\n\
    x = x ^ (x >> 16u);\n\
    x = x * 0x7feb352du;\n\
    x = x ^ (x >> 15u);\n\
    x = x * 0x846ca68bu;\n\
    x = x ^ (x >> 16u);\n\
    return x;\n\
}\n\
fn to_unit(s: u32) -> f32 {\n\
    return f32(s) / 4294967296.0;\n\
}\n\
fn wrap_angle(a: f32) -> f32 {\n\
    return a - TAU * floor(a / TAU);\n\
}\n";

// Agents start in a disc at the centre, with random headings.
pub const INIT: [u8] = "@group(0) @binding(1) var<storage, read_write> agents: array<vec4<f32>>;\n\
@compute @workgroup_size(256)\n\
fn init_agents(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    let i = id.x;\n\
    if (i >= u.ints.z) { return; }\n\
    let gw = f32(u.ints.x);\n\
    let gh = f32(u.ints.y);\n\
    var s = hash(i * 747796405u + u.ints.w);\n\
    s = hash(s);\n\
    let r = sqrt(to_unit(s)) * 0.3 * min(gw, gh);\n\
    s = hash(s);\n\
    let t = to_unit(s) * TAU;\n\
    s = hash(s);\n\
    let heading = to_unit(s) * TAU;\n\
    agents[i] = vec4<f32>(gw * 0.5 + r * cos(t), gh * 0.5 + r * sin(t), heading, 0.0);\n\
}\n";

// One step of every agent: sense the trail ahead and to both sides, turn
// towards the strongest, move (bouncing off the walls), deposit.
pub const AGENTS: [u8] = "@group(0) @binding(1) var<storage, read> trail: array<f32>;\n\
@group(0) @binding(2) var<storage, read_write> dep: array<atomic<i32>>;\n\
@group(0) @binding(3) var<storage, read_write> agents: array<vec4<f32>>;\n\
fn cell_at(x: f32, y: f32) -> u32 {\n\
    let cx = clamp(i32(x), 0, i32(u.ints.x) - 1);\n\
    let cy = clamp(i32(y), 0, i32(u.ints.y) - 1);\n\
    return u32(cy) * u.ints.x + u32(cx);\n\
}\n\
fn sense_at(p: vec2<f32>, ang: f32, d: f32) -> f32 {\n\
    return trail[cell_at(p.x + cos(ang) * d, p.y + sin(ang) * d)];\n\
}\n\
@compute @workgroup_size(256)\n\
fn agents_step(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    let i = id.x;\n\
    if (i >= u.ints.z) { return; }\n\
    let gw = f32(u.ints.x);\n\
    let gh = f32(u.ints.y);\n\
    let a = agents[i];\n\
    var p = a.xy;\n\
    var ang = a.z;\n\
    var s = hash(hash(i) ^ u.ints.w);\n\
    let sa = u.sense.x;\n\
    let sd = u.sense.y;\n\
    let turn = u.sense.z;\n\
    let spd = u.sense.w;\n\
    let fl = sense_at(p, ang + sa, sd);\n\
    let fc = sense_at(p, ang, sd);\n\
    let fr = sense_at(p, ang - sa, sd);\n\
    s = hash(s);\n\
    let r = to_unit(s);\n\
    if (fc < fl || fc < fr) {\n\
        if (fl > fr) {\n\
            ang = ang + turn * r;\n\
        } else if (fr > fl) {\n\
            ang = ang - turn * r;\n\
        } else {\n\
            ang = ang + select(-turn, turn, r > 0.5);\n\
        }\n\
    }\n\
    if (u.mouse.w == 2.0) {\n\
        let mx = p.x - u.mouse.x;\n\
        let my = p.y - u.mouse.y;\n\
        let rr = u.mouse.z;\n\
        if (mx * mx + my * my < rr * rr) {\n\
            let cr = cos(ang) * my - sin(ang) * mx;\n\
            ang = ang + select(-2.0 * turn, 2.0 * turn, cr > 0.0);\n\
        }\n\
    }\n\
    ang = wrap_angle(ang);\n\
    p = p + vec2<f32>(cos(ang), sin(ang)) * spd;\n\
    if (p.x < 0.0) { p.x = -p.x; ang = PI - ang; }\n\
    if (p.x >= gw) { p.x = 2.0 * gw - p.x; ang = PI - ang; }\n\
    if (p.y < 0.0) { p.y = -p.y; ang = -ang; }\n\
    if (p.y >= gh) { p.y = 2.0 * gh - p.y; ang = -ang; }\n\
    p = clamp(p, vec2<f32>(0.0), vec2<f32>(gw - 0.01, gh - 0.01));\n\
    ang = wrap_angle(ang);\n\
    let old = atomicAdd(&dep[cell_at(p.x, p.y)], i32(u.trail.z * FIX));\n\
    agents[i] = vec4<f32>(p, ang, 0.0);\n\
}\n";

// The new trail: the old one plus this step's deposits, blurred 3x3 by
// `diffuse`, decayed, and with the food added under the mouse.
pub const DIFFUSE: [u8] = "@group(0) @binding(1) var<storage, read> trail: array<f32>;\n\
@group(0) @binding(2) var<storage, read_write> dep: array<atomic<i32>>;\n\
@group(0) @binding(3) var<storage, read_write> dst: array<f32>;\n\
fn cell_value(x: i32, y: i32) -> f32 {\n\
    let gw = i32(u.ints.x);\n\
    let gh = i32(u.ints.y);\n\
    let cx = clamp(x, 0, gw - 1);\n\
    let cy = clamp(y, 0, gh - 1);\n\
    let i = u32(cy * gw + cx);\n\
    return trail[i] + f32(atomicLoad(&dep[i])) / FIX;\n\
}\n\
@compute @workgroup_size(256)\n\
fn diffuse(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    let i = id.x;\n\
    if (i >= u.ints.x * u.ints.y) { return; }\n\
    let x = i32(i % u.ints.x);\n\
    let y = i32(i / u.ints.x);\n\
    var sum = 0.0;\n\
    for (var dy: i32 = -1; dy <= 1; dy = dy + 1) {\n\
        for (var dx: i32 = -1; dx <= 1; dx = dx + 1) {\n\
            sum = sum + cell_value(x + dx, y + dy);\n\
        }\n\
    }\n\
    let here = cell_value(x, y);\n\
    var v = mix(here, sum / 9.0, u.trail.y);\n\
    v = v * (1.0 - u.trail.x);\n\
    if (u.mouse.w == 1.0) {\n\
        let mx = f32(x) + 0.5 - u.mouse.x;\n\
        let my = f32(y) + 0.5 - u.mouse.y;\n\
        let rr = u.mouse.z;\n\
        let d = sqrt(mx * mx + my * my);\n\
        if (d < rr) {\n\
            v = v + u.trail.w * (1.0 - d / rr);\n\
        }\n\
    }\n\
    dst[i] = max(v, 0.0);\n\
}\n";

pub const CLEAR: [u8] = "@group(0) @binding(1) var<storage, read_write> dep: array<atomic<i32>>;\n\
@compute @workgroup_size(256)\n\
fn clear_dep(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    if (id.x >= u.ints.x * u.ints.y) { return; }\n\
    atomicStore(&dep[id.x], 0);\n\
}\n";

// The picture: the trail through a colour ramp (palette 0, 1 or 2).
pub const RENDER: [u8] = "@group(0) @binding(1) var<storage, read> trail: array<f32>;\n\
struct V { @builtin(position) pos: vec4<f32>, @location(0) uv: vec2<f32> }\n\
@vertex fn vs(@builtin(vertex_index) i: u32) -> V {\n\
    var p = vec2<f32>(-1.0, -1.0);\n\
    if (i == 1u) { p = vec2<f32>(3.0, -1.0); }\n\
    if (i == 2u) { p = vec2<f32>(-1.0, 3.0); }\n\
    return V(vec4<f32>(p, 0.0, 1.0), vec2<f32>(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5));\n\
}\n\
fn ramp(t: f32, a: vec3<f32>, b: vec3<f32>, c: vec3<f32>, d: vec3<f32>) -> vec3<f32> {\n\
    let s = t * 3.0;\n\
    if (s < 1.0) { return mix(a, b, s); }\n\
    if (s < 2.0) { return mix(b, c, s - 1.0); }\n\
    return mix(c, d, clamp(s - 2.0, 0.0, 1.0));\n\
}\n\
@fragment fn fs(v: V) -> @location(0) vec4<f32> {\n\
    let gw = u.ints.x;\n\
    let gh = u.ints.y;\n\
    let c = vec2<u32>(clamp(v.uv * vec2<f32>(f32(gw), f32(gh)), vec2<f32>(0.0), vec2<f32>(f32(gw) - 1.0, f32(gh) - 1.0)));\n\
    let x = trail[c.y * gw + c.x];\n\
    let t = 1.0 - exp(-u.look.y * x);\n\
    let pal = u.look.x;\n\
    var col = vec3<f32>(0.0);\n\
    if (pal < 0.5) {\n\
        col = ramp(t, vec3<f32>(0.0, 0.0, 0.02), vec3<f32>(0.05, 0.2, 0.6), vec3<f32>(0.3, 0.9, 0.95), vec3<f32>(1.0, 1.0, 1.0));\n\
    } else if (pal < 1.5) {\n\
        col = ramp(t, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(0.45, 0.05, 0.55), vec3<f32>(1.0, 0.5, 0.1), vec3<f32>(1.0, 1.0, 0.7));\n\
    } else {\n\
        col = ramp(t, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(0.0, 0.35, 0.1), vec3<f32>(0.4, 0.95, 0.3), vec3<f32>(0.95, 1.0, 0.8));\n\
    }\n\
    return vec4<f32>(col, 1.0);\n\
}\n";
