// physarum: Jones's Physarum (slime mould) model on the GPU. A million
// agents sense the trail ahead and to both sides, turn towards the
// strongest, move and deposit; the trail diffuses and decays every step
// (compute kernels; the deposit is an atomic fixed-point grid), and the
// picture is the trail through a colour ramp, drawn into a window.
//
//   physarum [--agents N] [--size N] [parameters]      the window
//   physarum --headless [--steps N] [--every K] [--check] [--shot F.ppm]
//
// shaders.vl holds the WGSL, sim.vl the GPU side, tune.vl the parameters
// the keys change and their uniform block.

mod shaders;
mod sim;
mod tune;

use std::{env, gpu};
use std::cli::{Arg, Command};
use std::gpu::{RawSurface, Surface};
use std::time::{Duration, monotonic_now};
use std::window::{App, Button, Event, MouseAction, WindowDesc};
use std::window::keys::{Logical, Named};

use sim::Sim;
use tune::{nudge, Tune};

fn secs(d: Duration) -> f64 {
    d.as_secs_f64()
}

fn num(v: [u8], fallback: f64) -> f64 {
    match std::num::parse_f64(v) {
        Ok(x) => x,
        Err(_) => fallback,
    }
}

fn verdict(ok: bool) -> [u8] {
    if ok { "ok" } else { "FAILED" }
}

fn finite(x: f64) -> bool {
    x == x && x < 1.0e300 && x > -1.0e300
}

// The headless run: `steps` steps, the trail's total and the agents'
// positions read at every `every` steps, then the verdicts.
fn headless(t: Tune, gw: i64, n: i64, steps: i64, every: i64, shot: [u8], check: bool,
    gpa: Gpa) -> i32 {
    var s = match Sim::new_in(gw, gw, n, gpa) {
        Ok(s) => s,
        Err(e) => {
            eprintln(f"physarum: {e}");
            return 1;
        }
    };
    if !check {
        println(f"grid {gw} x {gw} cells, {n} agents, {steps} steps, a checkpoint every {every}");
    }
    let start = monotonic_now();
    var totals: Vec<f64> = Vec::new_in(gpa);
    var bad: i64 = 0;
    for i in 0..steps {
        s.set_params(t, -1.0, -1.0, 0, i);
        var enc = s.dev.encoder();
        s.step(&enc);
        s.queue.submit(enc.finish());
        if (i + 1) % every == 0 || i + 1 == steps {
            let total = s.trail_total();
            let out = s.outside();
            bad += out;
            totals.push(total);
            if !check {
                println(f"step {i + 1:>6}: trail total {total:.6e}, agents outside the grid {out}");
            }
        }
    }
    let ms = secs(monotonic_now().saturating_sub(start)) * 1000.0 / steps as f64;
    // the trail starts from nothing and grows as the agents deposit; it
    // must stay finite throughout, and at the end be above its first
    // checkpoint
    var all_finite = true;
    for x in totals {
        if !finite(x) {
            all_finite = false;
        }
    }
    let first = totals[0];
    let last = totals[totals.len() - 1];
    let grows = all_finite && last >= first && first > 0.0;
    let inside = bad == 0;
    // the trail's total T settles where what the agents add a step equals
    // what decays: T = n * deposit * (1 - decay) / decay (no food, no mouse)
    let expected = n as f64 * t.deposit * (1.0 - t.decay) / t.decay;
    let gap = if last > expected { last - expected } else { expected - last };
    let settled = t.decay > 0.0 && gap <= 0.01 * expected;
    println(f"trail total finite, positive and not falling from {first:.4e} to {last:.4e}: {verdict(grows)}");
    println(f"trail total at the last checkpoint is the decay balance {expected:.4e} within 1%: {verdict(settled)}");
    println(f"agents inside the grid at every checkpoint: {verdict(inside)}");
    if !check {
        println(f"{ms:.2} ms a step, checkpoints included");
    }
    if shot.len() > 0 {
        let img = s.snapshot_in(gw, gw, gpa);
        if std::fs::write(shot, img.as_slice()).is_err() {
            eprintln(f"physarum: cannot write {shot}");
            return 1;
        }
        if !check {
            println(f"wrote {shot}");
        }
    }
    if grows && settled && inside { 0 } else { 1 }
}

// The mouse and the keys, between frames.
struct Ui {
    t: Tune,
    paused: bool,
    reset: bool,
    quit: bool,
    // a button held: left feeds the trail (food), right repels
    left: bool,
    right: bool,
    // the pointer, in window pixels
    x: f64,
    y: f64,
}

// What a key does (keys repeat: hold one to keep changing).
fn on_key(inp: inout Ui, key: Logical) {
    match key {
        Logical::Char(c) => {
            if c == ' ' as u32 {
                inp.paused = !inp.paused;
            } else if c == 'r' as u32 {
                inp.reset = true;
            } else if c == 'q' as u32 {
                inp.quit = true;
            } else if c == '[' as u32 {
                inp.t.angle = nudge(inp.t.angle, -2.5, 5.0, 170.0);
            } else if c == ']' as u32 {
                inp.t.angle = nudge(inp.t.angle, 2.5, 5.0, 170.0);
            } else if c == 'd' as u32 {
                inp.t.dist = nudge(inp.t.dist, -1.0, 2.0, 60.0);
            } else if c == 'f' as u32 {
                inp.t.dist = nudge(inp.t.dist, 1.0, 2.0, 60.0);
            } else if c == 't' as u32 {
                inp.t.turn = nudge(inp.t.turn, -2.0, 0.0, 180.0);
            } else if c == 'y' as u32 {
                inp.t.turn = nudge(inp.t.turn, 2.0, 0.0, 180.0);
            } else if c == '-' as u32 {
                inp.t.decay = nudge(inp.t.decay, -0.01, 0.0, 0.5);
            } else if c == '=' as u32 {
                inp.t.decay = nudge(inp.t.decay, 0.01, 0.0, 0.5);
            } else if c == 'o' as u32 {
                inp.t.diffuse = nudge(inp.t.diffuse, -0.1, 0.0, 1.0);
            } else if c == 'p' as u32 {
                inp.t.diffuse = nudge(inp.t.diffuse, 0.1, 0.0, 1.0);
            } else if c == 'z' as u32 {
                inp.t.speed = nudge(inp.t.speed, -0.25, 0.25, 4.0);
            } else if c == 'x' as u32 {
                inp.t.speed = nudge(inp.t.speed, 0.25, 0.25, 4.0);
            } else if c == 'g' as u32 {
                inp.t.gain = nudge(inp.t.gain, -0.25, 0.25, 8.0);
            } else if c == 'h' as u32 {
                inp.t.gain = nudge(inp.t.gain, 0.25, 0.25, 8.0);
            } else if c == 'c' as u32 {
                inp.t.palette = (inp.t.palette + 1) % 3;
            }
        }
        Logical::Named(Named::Escape) => inp.quit = true,
        _ => {}
    }
}

// One frame: the parameters, a step (unless paused) and the picture, in
// one submission, then presented.
fn frame(s: inout Sim, surf: inout Surface, t: Tune, px: f64, py: f64, mode: i64, seed: i64,
    step: bool) {
    match surf.frame() {
        Ok(f) => {
            s.set_params(t, px, py, mode, seed);
            var enc = s.dev.encoder();
            if step {
                s.step(&enc);
            }
            s.draw(&enc, f.texture.view());
            s.queue.submit(enc.finish());
            f.present(&s.queue);
        }
        Err(_) => {}
    }
}

fn windowed(gw: i64, n: i64, t: Tune, frames: i64, shot: [u8], gpa: Gpa) -> i32 {
    var app = match App::new_in(gpa) {
        Ok(a) => a,
        Err(_) => {
            eprintln("physarum: no window server (try --headless)");
            return 1;
        }
    };
    var win = match app.window(WindowDesc::new("physarum", 1024, 1024)) {
        Ok(w) => w,
        Err(_) => {
            eprintln("physarum: no window");
            return 1;
        }
    };
    let sz = win.size();
    var s = match Sim::new_in(gw, gw, n, gpa) {
        Ok(s) => s,
        Err(e) => {
            eprintln(f"physarum: {e}");
            return 1;
        }
    };
    let inst = gpu::Instance::new_in(gpa);
    var surf = match inst.surface(s.dev, RawSurface::MetalLayer(win.raw_surface())) {
        Ok(x) => x,
        Err(e) => {
            eprintln(f"physarum: {e}");
            return 1;
        }
    };
    surf.configure(s.dev, sz.w, sz.h);
    var ui = Ui { t: t, paused: false, reset: false, quit: false, left: false, right: false,
        x: 0.0, y: 0.0 };
    let start = monotonic_now();
    var seed: i64 = 0;
    var done: i64 = 0;
    var first = 0.0;
    var title_at = -1.0;
    win.request_frame();
    loop {
        match app.wait() {
            Ok(Event::Frame(_)) => {
                if ui.reset {
                    s.reset();
                    ui.reset = false;
                    seed = 0;
                }
                let now = secs(monotonic_now().saturating_sub(start));
                let mode = if ui.left { 1 } else if ui.right { 2 } else { 0 };
                let gx = ui.x * gw as f64 / surf.width as f64;
                let gy = ui.y * gw as f64 / surf.height as f64;
                let step = !ui.paused;
                if step {
                    seed += 1;
                }
                frame(&s, &surf, ui.t, gx, gy, mode, seed, step);
                done += 1;
                if done == 1 {
                    first = now;
                }
                if now - title_at >= 0.25 {
                    title_at = now;
                    let state = if ui.paused { "paused" } else { "running" };
                    let title = format_in(
                        f"physarum {n} agents, angle {ui.t.angle:.1} dist {ui.t.dist:.1} turn {ui.t.turn:.1} decay {ui.t.decay:.3} diffuse {ui.t.diffuse:.2} speed {ui.t.speed:.2} gain {ui.t.gain:.2} palette {ui.t.palette}, {state}",
                        gpa);
                    win.set_title(title.as_slice());
                }
                if frames > 0 && done >= frames {
                    let mean = (now - first) * 1000.0 / (done - 1) as f64;
                    println(
                        f"{n} agents on a {gw} x {gw} trail, {done} frames: {mean:.2} ms a frame ({1000.0 / mean:.1} fps)");
                    if shot.len() > 0 {
                        let img = s.snapshot_in(gw, gw, gpa);
                        if std::fs::write(shot, img.as_slice()).is_err() {
                            eprintln(f"physarum: cannot write {shot}");
                        }
                    }
                    break;
                }
                if ui.quit {
                    break;
                }
                win.request_frame();
            }
            Ok(Event::Mouse(m)) => {
                if m.action == MouseAction::Press {
                    if m.button == Button::Left {
                        ui.left = true;
                    } else if m.button == Button::Right {
                        ui.right = true;
                    }
                } else if m.action == MouseAction::Release {
                    if m.button == Button::Left {
                        ui.left = false;
                    } else if m.button == Button::Right {
                        ui.right = false;
                    }
                }
                ui.x = m.x;
                ui.y = m.y;
            }
            Ok(Event::Key(k)) => {
                if k.pressed {
                    on_key(&ui, k.key);
                }
            }
            Ok(Event::Resize(_, z)) => surf.configure(s.dev, z.w, z.h),
            Ok(Event::Close(_)) => break,
            Ok(Event::Quit) => break,
            _ => {}
        }
        if ui.quit {
            break;
        }
    }
    let _ = s.queue.wait_idle();
    0
}

fn main(gpa: Gpa) -> i32 {
    let cli = Command::new_in("physarum", gpa)
        .about("Physarum: agents follow a trail they lay, on the GPU; a window to play, or the headless checks")
        .arg(Arg::flag("headless").help("no window: run --steps steps, print the checks"))
        .arg(Arg::option("agents").value_name("N").default("1000000").help("the agents"))
        .arg(Arg::option("size").value_name("N").default("1024").help("the trail grid: N x N cells"))
        .arg(Arg::option("steps").value_name("N").default("300").help("headless: the steps"))
        .arg(Arg::option("every").value_name("K").default("50")
            .help("headless: read the trail and the agents every K steps"))
        .arg(Arg::flag("check").help("headless: print only the verdicts"))
        .arg(Arg::option("angle").value_name("DEG").default("45").help("sensor angle"))
        .arg(Arg::option("dist").value_name("CELLS").default("9").help("sensor distance"))
        .arg(Arg::option("turn").value_name("DEG").default("30").help("largest turn a step"))
        .arg(Arg::option("speed").value_name("CELLS").default("1").help("agent speed"))
        .arg(Arg::option("decay").value_name("X").default("0.08").help("trail decay a step"))
        .arg(Arg::option("diffuse").value_name("X").default("0.5").help("blur: 0 none, 1 full"))
        .arg(Arg::option("deposit").value_name("X").default("4").help("trail per agent a step"))
        .arg(Arg::option("food").value_name("X").default("3").help("trail under the mouse a step"))
        .arg(Arg::option("gain").value_name("X").default("0.03").help("colour ramp gain"))
        .arg(Arg::option("palette").value_name("N").default("0").help("0 blue, 1 fire, 2 green"))
        .arg(Arg::option("frames").value_name("N").default("0")
            .help("window: quit after N frames and print the mean frame time"))
        .arg(Arg::option("shot").value_name("FILE.ppm")
            .help("headless, or window with --frames: the picture as PPM"));
    let m = cli.parse_or_exit(env::args());
    let gw = parse_int(m.get("size").unwrap_or("1024")).unwrap_or(0);
    let n = parse_int(m.get("agents").unwrap_or("1000000")).unwrap_or(0);
    let steps = parse_int(m.get("steps").unwrap_or("300")).unwrap_or(0);
    let every = parse_int(m.get("every").unwrap_or("50")).unwrap_or(0);
    let frames = parse_int(m.get("frames").unwrap_or("0")).unwrap_or(0);
    let pal = parse_int(m.get("palette").unwrap_or("0")).unwrap_or(0);
    if gw < 16 || gw > 4096 || n < 1 || n > 16000000 || steps < 1 || every < 1 {
        eprintln("physarum: --size 16..4096, --agents 1..16000000, --steps and --every 1 or more");
        return 2;
    }
    let t = Tune {
        angle: num(m.get("angle").unwrap_or("45"), 45.0),
        dist: num(m.get("dist").unwrap_or("9"), 9.0),
        turn: num(m.get("turn").unwrap_or("30"), 30.0),
        speed: num(m.get("speed").unwrap_or("1"), 1.0),
        decay: num(m.get("decay").unwrap_or("0.08"), 0.08),
        diffuse: num(m.get("diffuse").unwrap_or("0.5"), 0.5),
        deposit: num(m.get("deposit").unwrap_or("4"), 4.0),
        food: num(m.get("food").unwrap_or("3"), 3.0),
        gain: num(m.get("gain").unwrap_or("0.03"), 0.03),
        palette: if pal < 0 { 0 } else if pal > 2 { 2 } else { pal },
    };
    let shot = m.get("shot").unwrap_or("");
    if m.flag("headless") {
        return headless(t, gw, n, steps, every, shot, m.flag("check"), gpa);
    }
    windowed(gw, n, t, frames, shot, gpa)
}
