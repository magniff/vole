// The parameters the user changes live, and the uniform block they are
// packed into (the layout is COMMON's `struct U` in shaders.vl: five
// vec4s, the first four words u32, the rest f32 bit patterns).

use std::num::f32_to_bits;

const PI: f64 = 3.14159265358979;

pub const WORDS: i64 = 20;

pub struct Tune {
    // sensor angle, degrees (the sensors sit at +- angle from the heading)
    pub angle: f64,
    // sensor distance, cells
    pub dist: f64,
    // the largest turn a step, degrees
    pub turn: f64,
    // how far an agent moves a step, cells
    pub speed: f64,
    // the fraction of the trail that decays a step
    pub decay: f64,
    // 0: no blur, 1: the full 3x3 mean
    pub diffuse: f64,
    // the trail each agent deposits a step
    pub deposit: f64,
    // the trail added under the mouse a step (left button)
    pub food: f64,
    // the colour ramp's gain (brightness of thin trails)
    pub gain: f64,
    // 0 blue, 1 fire, 2 green
    pub palette: i64,
}

impl Tune {
    pub fn new() -> Tune {
        Tune {
            angle: 45.0, dist: 9.0, turn: 30.0, speed: 1.0, decay: 0.08, diffuse: 0.5,
            deposit: 4.0, food: 3.0, gain: 0.03, palette: 0,
        }
    }
}

// x moved by d steps of `step`, kept within [lo, hi].
#[pure]
pub fn nudge(x: f64, d: f64, lo: f64, hi: f64) -> f64 {
    let y = x + d;
    if y < lo { lo } else if y > hi { hi } else { y }
}

// The uniform block for one step: the grid, the seed of this step's random
// numbers, the parameters, the pointer (grid cells; mode 0 none, 1 food,
// 2 repel) and the palette.
#[pure]
pub fn pack(t: Tune, gw: i64, gh: i64, n: i64, seed: i64, px: f64, py: f64, mode: i64)
    -> [u32; 20] {
    var words: [u32; 20] = [0; 20];
    words[0] = gw as u32;
    words[1] = gh as u32;
    words[2] = n as u32;
    words[3] = seed as u32;
    let f: [f32; 16] = [
        (t.angle * PI / 180.0) as f32, t.dist as f32, (t.turn * PI / 180.0) as f32,
        t.speed as f32,
        t.decay as f32, t.diffuse as f32, t.deposit as f32, t.food as f32,
        px as f32, py as f32, mouse_radius() as f32, mode as f32,
        t.palette as f32, t.gain as f32, 0.0, 0.0,
    ];
    for i in 0..16 {
        words[4 + i] = f32_to_bits(f[i]);
    }
    words
}

// The mouse's radius in cells (the food and repel reach).
pub fn mouse_radius() -> f64 {
    24.0
}

#[test]
fn nudge_keeps_its_range() {
    assert_eq(nudge(1.0, 0.5, 0.0, 10.0), 1.5);
    assert_eq(nudge(9.9, 0.5, 0.0, 10.0), 10.0);
    assert_eq(nudge(0.1, -0.5, 0.0, 10.0), 0.0);
}

#[test]
fn defaults_are_in_range() {
    let t = Tune::new();
    assert(t.decay > 0.0 && t.decay < 0.5);
    assert(t.diffuse >= 0.0 && t.diffuse <= 1.0);
    assert(t.angle > 0.0 && t.angle < 180.0);
}

#[test]
fn pack_writes_the_grid_and_the_seed() {
    let w = pack(Tune::new(), 1024, 512, 1000000, 7, 3.0, 4.0, 1);
    assert_eq(w[0], 1024);
    assert_eq(w[1], 512);
    assert_eq(w[2], 1000000);
    assert_eq(w[3], 7);
    assert_eq(w[4], f32_to_bits((45.0 * PI / 180.0) as f32));
    assert_eq(w[12], f32_to_bits(3.0));
    assert_eq(w[14], f32_to_bits(24.0));
    assert_eq(w[15], f32_to_bits(1.0));
    assert_eq(w[19], f32_to_bits(0.0));
}
