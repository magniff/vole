// The CPU side of sph: the constants the GPU kernels are built with, the
// starting lattice, and the references the headless checks compare the
// GPU against (the cell of a point, the counting sort, the exclusive
// prefix sum). Nothing here touches the GPU.

// The particles: a SIDE x SIDE lattice, so N = 102400 (at least 100 000).
pub const SIDE: i64 = 320;
pub const N: i64 = 102400;
// The lattice spacing; the smoothing length is 2.4 spacings, so a particle
// has about 18 neighbours inside it.
pub const SPACING: f32 = 0.0022;
pub const H: f32 = 0.00528;
// The grid covers [-EXT, EXT]^2 with cells of side H (so GX = GY = 379).
pub const EXT: f32 = 1.0;
pub const GX: i64 = 379;
pub const GY: i64 = 379;
pub const INV_H: f32 = 189.3939;
// Water-like rest density; the mass of a particle is rho0 times its area.
pub const RHO0: f32 = 1000.0;
pub const MASS: f32 = 0.00484;
// Weakly compressible: pressure = STIFF * (rho - rho0) with rho in kg/m^2
// (mass per area, as the density of a 2D SPH is), so STIFF is the square of
// the sound speed, SOUND = 20 m/s.
pub const SOUND: f32 = 20.0;
pub const STIFF: f32 = 400.0;
// Viscosity coefficient (the Laplacian's weight), a fixed step of DT.
pub const VISC: f32 = 0.0005;
pub const GRAV: f32 = -9.81;
pub const DT: f32 = 0.00008;
// The box's half sizes, in metres, before it tilts.
pub const HW: f32 = 0.8;
pub const HH: f32 = 0.5;

// Floor for any f32, as std has no floor of its own (the truncation to i64
// is exact for the grid's range).
pub fn floor_f32(x: f32) -> f32 {
    let t = x as i64 as f32;
    if t > x { t - 1.0 } else { t }
}

// The cell of a point, as the GPU computes it: clamped to the grid.
pub fn cell_of(x: f32, y: f32) -> i64 {
    var cx = floor_f32((x + EXT) * INV_H) as i64;
    var cy = floor_f32((y + EXT) * INV_H) as i64;
    if cx < 0 { cx = 0; }
    if cx > GX - 1 { cx = GX - 1; }
    if cy < 0 { cy = 0; }
    if cy > GY - 1 { cy = GY - 1; }
    cy * GX + cx
}

// The starting lattice, x y pairs, the box's bottom-left block at rest.
pub fn lattice(gpa: Gpa) -> Vec<f32> {
    var out: Vec<f32> = Vec::new_in(gpa);
    for j in 0..SIDE {
        for i in 0..SIDE {
            out.push(-0.78 + (i as f32 + 0.5) * SPACING);
            out.push(-0.48 + (j as f32 + 0.5) * SPACING);
        }
    }
    out
}

// The exclusive prefix sum: out[k] = xs[0] + ... + xs[k - 1].
pub fn exclusive_scan(xs: [u32], gpa: Gpa) -> Vec<u32> {
    var out: Vec<u32> = Vec::new_in(gpa);
    var acc: u32 = 0;
    for x in xs {
        out.push(acc);
        acc = acc + x;
    }
    out
}

// sin and cos by their Taylor series, for |x| <= 3.2 (the tilt is at most
// 0.8 rad, and the headless tilt is a sine of at most 3 rad).
pub fn sin(x: f64) -> f64 {
    var term = x;
    var sum = x;
    for k in 1..16 {
        let kk = k as f64;
        term = -term * x * x / ((2.0 * kk) * (2.0 * kk + 1.0));
        sum = sum + term;
    }
    sum
}

pub fn cos(x: f64) -> f64 {
    var term: f64 = 1.0;
    var sum: f64 = 1.0;
    for k in 1..16 {
        let kk = k as f64;
        term = -term * x * x / ((2.0 * kk - 1.0) * (2.0 * kk));
        sum = sum + term;
    }
    sum
}

#[test]
fn scan_is_exclusive(gpa: Gpa) {
    let xs: [u32; 5] = [1, 2, 3, 0, 4];
    let out = exclusive_scan(xs[..], gpa);
    assert_eq(out[0], 0);
    assert_eq(out[1], 1);
    assert_eq(out[2], 3);
    assert_eq(out[3], 6);
    assert_eq(out[4], 6);
}

#[test]
fn cell_of_is_clamped() {
    assert_eq(cell_of(-5.0, -5.0), 0);
    assert_eq(cell_of(5.0, 5.0), GX * GY - 1);
    assert_eq(cell_of(-EXT + 0.5 * H, -EXT + 0.5 * H), 0);
}

#[test]
fn lattice_is_inside_the_box(gpa: Gpa) {
    let p = lattice(gpa);
    assert_eq(p.len(), 2 * N);
    var i = 0;
    while i < p.len() {
        assert(p[i] > -HW && p[i] < HW);
        assert(p[i + 1] > -HH && p[i + 1] < HH);
        i += 2;
    }
}

#[test]
fn sin_and_cos_are_close() {
    assert(sin(0.5) > 0.4794 && sin(0.5) < 0.4795);
    assert(cos(0.5) > 0.8775 && cos(0.5) < 0.8776);
    assert(sin(3.0) > 0.1410 && sin(3.0) < 0.1412);
}
