// The terrain's index buffer: 8 x 8 tiles of 32 x 32 quads, each tile
// in 4 levels of detail (step 1, 2, 4, 8). Vertices are grid points of
// the 257 x 257 height buffer (no vertex buffer: the vertex shader reads
// the heights), so one index buffer holds every tile at every level, and
// each tile at each level is one range of it.

pub const TILE: i64 = 32;
pub const TILES: i64 = 8;
pub const LODS: i64 = 4;
pub const W: i64 = 257;
pub const SKIRT: u32 = 16777216;

pub struct Mesh {
    pub indices: Vec<u32>,
    // range k is starts[k] .. starts[k + 1], k = tile * LODS + lod
    pub starts: Vec<i64>,
}

impl Mesh {
    pub fn new_in(gpa: Gpa) -> Mesh {
        var indices: Vec<u32> = Vec::new_in(gpa);
        var starts: Vec<i64> = Vec::new_in(gpa);
        for t in 0..TILES * TILES {
            for lod in 0..LODS {
                starts.push(indices.len());
                emit_tile(&indices, (t % TILES) * TILE, (t / TILES) * TILE, lod);
            }
        }
        starts.push(indices.len());
        Mesh { indices: indices, starts: starts }
    }

    // the index range of a tile at a level: start, end
    pub fn range(self, tile: i64, lod: i64) -> (i64, i64) {
        let k = tile * LODS + lod;
        (self.starts[k], self.starts[k + 1])
    }
}

// The triangles of a tile at a level: 2 per quad, and 2 per skirt quad
// (the four edges, one quad per segment of the edge).
pub fn tris_per_tile(lod: i64) -> i64 {
    let q = TILE >> lod;
    2 * q * q + 8 * q
}

// The level of detail of a tile whose centre is at squared distance d2.
pub fn lod_for(d2: f32) -> i64 {
    if d2 < 80.0 * 80.0 {
        return 0;
    }
    if d2 < 150.0 * 150.0 {
        return 1;
    }
    if d2 < 260.0 * 260.0 {
        return 2;
    }
    3
}

// the id of grid point (x, z)
fn id(x: i64, z: i64) -> u32 {
    (z * W + x) as u32
}

// one skirt quad between grid points p and p2 (ids), dropped down
fn skirt(out: inout Vec<u32>, p: u32, p2: u32) {
    let ps = p | SKIRT;
    let p2s = p2 | SKIRT;
    out.push(p);
    out.push(p2);
    out.push(p2s);
    out.push(p);
    out.push(p2s);
    out.push(ps);
}

// the indices of tile (gx, gz) at a level: its quads, then its skirts
fn emit_tile(out: inout Vec<u32>, gx: i64, gz: i64, lod: i64) {
    let s = 1 << lod;
    let q = TILE / s;
    for j in 0..q {
        for i in 0..q {
            let a = id(gx + i * s, gz + j * s);
            let b = id(gx + (i + 1) * s, gz + j * s);
            let c = id(gx + i * s, gz + (j + 1) * s);
            let d = id(gx + (i + 1) * s, gz + (j + 1) * s);
            out.push(a);
            out.push(c);
            out.push(b);
            out.push(b);
            out.push(c);
            out.push(d);
        }
    }
    for k in 0..q {
        skirt(&out, id(gx + k * s, gz), id(gx + (k + 1) * s, gz));
        skirt(&out, id(gx + k * s, gz + TILE), id(gx + (k + 1) * s, gz + TILE));
        skirt(&out, id(gx, gz + k * s), id(gx, gz + (k + 1) * s));
        skirt(&out, id(gx + TILE, gz + k * s), id(gx + TILE, gz + (k + 1) * s));
    }
}

#[test]
fn every_range_has_the_triangles_it_should(gpa: Gpa) {
    let m = Mesh::new_in(gpa);
    for lod in 0..LODS {
        let (a, b) = m.range(5, lod);
        assert_eq(b - a, tris_per_tile(lod) * 3);
    }
    assert_eq(m.indices.len(), TILES * TILES * (6912 + 1920 + 576 + 192));
}

#[test]
fn levels_grow_with_distance() {
    assert_eq(lod_for(10.0 * 10.0), 0);
    assert_eq(lod_for(100.0 * 100.0), 1);
    assert_eq(lod_for(200.0 * 200.0), 2);
    assert_eq(lod_for(400.0 * 400.0), 3);
}
