// Vertices for the render shader: text quads sampling the SDF atlas, and
// solid rectangles. A vertex is eight f32s: x, y (logical units, through
// the placement), u, v (atlas texels; u < 0 marks a solid vertex), and
// r, g, b, a.

use glyphs::{slot, ADVANCE, ATLAS_W, CELL, COLS};
use mathx::sin_cos;

pub const FLOATS_PER_VERTEX: i64 = 8;

// A placement: a point (x, y) of the local space goes to
// k (ax + x c - y s, ay + x s + y c): the rotation (c, s) turns it about
// the anchor (ax, ay), and k is the device pixels per logical unit.
pub struct Xf {
    pub ax: f64,
    pub ay: f64,
    pub k: f64,
    pub c: f64,
    pub s: f64,
}

impl Xf {
    pub fn plain(k: f64) -> Xf {
        Xf { ax: 0.0, ay: 0.0, k: k, c: 1.0, s: 0.0 }
    }

    // Rotated by angle (radians) about (ax, ay), in local logical units.
    pub fn turned(ax: f64, ay: f64, k: f64, angle: f64) -> Xf {
        let (s, c) = sin_cos(angle);
        Xf { ax: ax, ay: ay, k: k, c: c, s: s }
    }

    pub fn x_of(self, x: f64, y: f64) -> f64 {
        self.k * (self.ax + x * self.c - y * self.s)
    }

    pub fn y_of(self, x: f64, y: f64) -> f64 {
        self.k * (self.ay + x * self.s + y * self.c)
    }
}

// One vertex, at local (x, y), with atlas texel (u, v).
fn vertex(out: inout Vec<f32>, xf: Xf, x: f64, y: f64, u: f64, v: f64, col: [f32; 4]) {
    out.push(xf.x_of(x, y) as f32);
    out.push(xf.y_of(x, y) as f32);
    out.push(u as f32);
    out.push(v as f32);
    out.push(col[0]);
    out.push(col[1]);
    out.push(col[2]);
    out.push(col[3]);
}

// Two triangles over the corners (x0, y0) .. (x1, y1), with the atlas
// corners (u0, v0) .. (u1, v1).
fn quad(out: inout Vec<f32>, xf: Xf, x0: f64, y0: f64, x1: f64, y1: f64,
        u0: f64, v0: f64, u1: f64, v1: f64, col: [f32; 4]) {
    vertex(&out, xf, x0, y0, u0, v0, col);
    vertex(&out, xf, x1, y0, u1, v0, col);
    vertex(&out, xf, x0, y1, u0, v1, col);
    vertex(&out, xf, x0, y1, u0, v1, col);
    vertex(&out, xf, x1, y0, u1, v0, col);
    vertex(&out, xf, x1, y1, u1, v1, col);
}

// A solid rectangle at (x, y), w by h.
pub fn rect(out: inout Vec<f32>, xf: Xf, x: f64, y: f64, w: f64, h: f64, col: [f32; 4]) {
    quad(&out, xf, x, y, x + w, y + h, -1.0, -1.0, -1.0, -1.0, col);
}

// A glyph whose cap top-left (pen) is at (x, y), cap height size.
fn glyph(out: inout Vec<f32>, xf: Xf, x: f64, y: f64, size: f64, slot_no: i64, col: [f32; 4]) {
    let k = size / 8.0;
    let ox = ((slot_no % COLS) * CELL) as f64;
    let oy = ((slot_no / COLS) * CELL) as f64;
    // the quad is the cell: units -1 .. 9 (VIEW_MIN .. VIEW_MIN + VIEW_UNITS)
    quad(&out, xf, x - k, y - k, x + 9.0 * k, y + 9.0 * k,
        ox, oy, ox + CELL as f64, oy + CELL as f64, col);
}

// The width of s at cap height size (its last advance included).
pub fn width(s: [u8], size: f64) -> f64 {
    s.len() as f64 * ADVANCE * size / 8.0
}

// s with its pen at (x, y) (the top of its capitals), cap height size
// (local units); characters the font lacks are skipped.
pub fn text(out: inout Vec<f32>, xf: Xf, x: f64, y: f64, size: f64, s: [u8], col: [f32; 4]) {
    var pen = x;
    var i: i64 = 0;
    while i < s.len() {
        let n = slot(s[i]);
        if n >= 0 {
            glyph(&out, xf, pen, y, size, n, col);
        }
        pen += ADVANCE * size / 8.0;
        i += 1;
    }
}

// The four sides of a rectangle, t thick, inside (x, y, w, h).
pub fn frame(out: inout Vec<f32>, xf: Xf, x: f64, y: f64, w: f64, h: f64, t: f64, col: [f32; 4]) {
    rect(&out, xf, x, y, w, t, col);
    rect(&out, xf, x, y + h - t, w, t, col);
    rect(&out, xf, x, y, t, h, col);
    rect(&out, xf, x + w - t, y, t, h, col);
}

#[test]
fn a_text_is_six_vertices_per_drawn_glyph(gpa: Gpa) {
    var v: Vec<f32> = Vec::new_in(gpa);
    text(&v, Xf::plain(1.0), 0.0, 0.0, 8.0, "AB C", [1.0, 1.0, 1.0, 1.0]);
    assert_eq(v.len(), 4 * 6 * FLOATS_PER_VERTEX);
    v.clear();
    rect(&v, Xf::plain(2.0), 1.0, 1.0, 10.0, 4.0, [0.0, 0.0, 0.0, 1.0]);
    assert_eq(v.len(), 6 * FLOATS_PER_VERTEX);
    // scaled by 2: the rectangle's far corner is at (2 * 11, 2 * 5)
    assert_eq(v[(4 * FLOATS_PER_VERTEX) as i64], 22.0);
}

#[test]
fn rotation_turns_a_point_about_the_anchor(gpa: Gpa) {
    let xf = Xf::turned(10.0, 10.0, 1.0, 3.141592653589793 / 2.0);
    // (1, 0) turns to (0, 1) about the anchor
    assert(xf.x_of(1.0, 0.0) > 9.999 && xf.x_of(1.0, 0.0) < 10.001);
    assert(xf.y_of(1.0, 0.0) > 10.999 && xf.y_of(1.0, 0.0) < 11.001);
    let _ = gpa;
}

// the atlas width this module assumes (glyphs::ATLAS_W), checked once
#[test]
fn the_atlas_is_the_cells_in_a_row(gpa: Gpa) {
    assert_eq(ATLAS_W, COLS * CELL);
    let _ = gpa;
}
