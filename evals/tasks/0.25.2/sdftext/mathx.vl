// The few functions the demo needs beyond the arithmetic: square root and
// sine/cosine, in plain vole (Newton's iteration and Taylor series), so
// the demo has no C calls and no unsafe.

pub const PI: f64 = 3.141592653589793;

// The square root of a (0 for a <= 0): Newton's iteration from a guess
// of max(a, 1); 60 steps reach full f64 precision for any value this demo
// sees.
pub fn sqrt(a: f64) -> f64 {
    if a <= 0.0 {
        return 0.0;
    }
    var x = a;
    if x < 1.0 {
        x = 1.0;
    }
    var i: i64 = 0;
    while i < 60 {
        x = 0.5 * (x + a / x);
        i += 1;
    }
    x
}

// (sin a, cos a): the angle is brought into [-PI, PI], then the series.
pub fn sin_cos(a: f64) -> (f64, f64) {
    var x = a;
    while x > PI {
        x -= 2.0 * PI;
    }
    while x < -PI {
        x += 2.0 * PI;
    }
    let x2 = x * x;
    var term_s = x;
    var term_c: f64 = 1.0;
    var sum_s = x;
    var sum_c: f64 = 1.0;
    var k: i64 = 1;
    while k < 14 {
        let n = (2 * k) as f64;
        term_c = -term_c * x2 / ((n - 1.0) * n);
        term_s = -term_s * x2 / (n * (n + 1.0));
        sum_c += term_c;
        sum_s += term_s;
        k += 1;
    }
    (sum_s, sum_c)
}

#[test]
fn square_roots_are_close() {
    assert(sqrt(2.0) > 1.41421356 && sqrt(2.0) < 1.41421357);
    assert_eq(sqrt(0.0), 0.0);
    assert(sqrt(0.25) > 0.4999999 && sqrt(0.25) < 0.5000001);
    assert(sqrt(1.0e6) > 999.9999 && sqrt(1.0e6) < 1000.0001);
}

#[test]
fn sin_and_cos_of_quarter_turns() {
    let (s, c) = sin_cos(PI / 2.0);
    assert(s > 0.9999 && s < 1.0001);
    assert(c > -0.0001 && c < 0.0001);
    let (s2, c2) = sin_cos(-PI / 6.0);
    assert(s2 > -0.5001 && s2 < -0.4999);
    assert(c2 > 0.8659 && c2 < 0.8661);
}
