// The demo page: a title, the same sentence at five sizes, a rotating
// banner whose size the slider sets, and on the right the widgets (a
// counter with two buttons, the slider, a text field, a scrolling list).
// Logical units: the window is 800 by 600.

use typeset::{Xf, text, width};
use ui::{Ui, ListState, ACCENT, DIM, INK, button, slider, text_field, list};
use mathx::PI;

pub const WIDTH: i64 = 800;
pub const HEIGHT: i64 = 600;

const ITEMS: i64 = 40;

pub struct Page {
    pub count: i64,
    // the banner's size, 0..1
    pub size: f64,
    pub name: Vec<u8>,
    pub list: ListState,
    // the banner's angle, radians
    pub angle: f64,
}

impl Page {
    pub fn new(gpa: Gpa) -> Page {
        Page {
            count: 0,
            size: 0.4,
            name: Vec::new_in(gpa),
            list: ListState { scroll: 0.0, selected: -1 },
            angle: 0.0,
        }
    }
}

// The widgets' places (logical units), shared with the headless script.
pub const CLICK_X: f64 = 430.0;
pub const CLICK_Y: f64 = 84.0;
pub const RESET_X: f64 = 606.0;
pub const SLIDER_X: f64 = 430.0;
pub const SLIDER_Y: f64 = 204.0;
pub const SLIDER_W: f64 = 346.0;
pub const FIELD_X: f64 = 430.0;
pub const FIELD_Y: f64 = 258.0;
pub const FIELD_W: f64 = 346.0;
pub const FIELD_H: f64 = 36.0;
pub const LIST_X: f64 = 430.0;
pub const LIST_Y: f64 = 326.0;
pub const LIST_W: f64 = 346.0;
pub const LIST_H: f64 = 226.0;

// Lays out and runs one frame of the page into ui.verts.
pub fn build(ui: inout Ui, page: inout Page) {
    page.angle += 0.01;
    if page.angle > 2.0 * PI {
        page.angle -= 2.0 * PI;
    }
    let plain = ui.xf;

    // the title and the sizes: one sentence at each
    text(&ui.verts, plain, 24.0, 18.0, 26.0, "SDF TEXT", INK);
    text(&ui.verts, plain, 24.0, 52.0, 10.0, "ONE ATLAS, ANY SIZE AND ANGLE", DIM);
    text(&ui.verts, plain, 24.0, 78.0, 8.0, "ABC 0123 DEFGHI", INK);
    text(&ui.verts, plain, 24.0, 96.0, 12.0, "ABC 0123 DEFGHI", INK);
    text(&ui.verts, plain, 24.0, 118.0, 18.0, "ABC 0123 DEFGH", INK);
    text(&ui.verts, plain, 24.0, 146.0, 28.0, "ABC 0123", INK);
    text(&ui.verts, plain, 24.0, 186.0, 40.0, "ABC 123", INK);

    // the banner: turns about its centre, its size from the slider
    let cap = 14.0 + page.size * 34.0;
    let banner = Xf::turned(200.0, 430.0, ui.xf.k, page.angle);
    let word: [u8] = "ROTATE";
    text(&ui.verts, banner, -width(word, cap) / 2.0, -cap / 2.0, cap, word, ACCENT);

    // the widgets
    if button(&ui, CLICK_X, CLICK_Y, 160.0, 40.0, "CLICK +1") {
        page.count += 1;
    }
    if button(&ui, RESET_X, CLICK_Y, 170.0, 40.0, "RESET") {
        page.count = 0;
    }
    var count = Buf::new_in(ui.gpa);
    count.push_str("COUNT ");
    count.push_int(page.count);
    text(&ui.verts, plain, CLICK_X, 142.0, 16.0, count.as_slice(), INK);

    text(&ui.verts, plain, SLIDER_X, 180.0, 12.0, "BANNER SIZE", DIM);
    page.size = slider(&ui, 1, SLIDER_X, SLIDER_Y, SLIDER_W, page.size);

    text(&ui.verts, plain, FIELD_X, 238.0, 12.0, "TYPE HERE", DIM);
    text_field(&ui, 2, FIELD_X, FIELD_Y, FIELD_W, FIELD_H, &page.name);

    text(&ui.verts, plain, LIST_X, 306.0, 12.0, "PICK AN ITEM", DIM);
    list(&ui, LIST_X, LIST_Y, LIST_W, LIST_H, ITEMS, &page.list);

    var sel = Buf::new_in(ui.gpa);
    sel.push_str("SELECTED ");
    if page.list.selected >= 0 {
        sel.push_int(page.list.selected + 1);
    } else {
        sel.push_str("NONE");
    }
    text(&ui.verts, plain, LIST_X, 558.0, 12.0, sel.as_slice(), INK);
    text(&ui.verts, plain, 24.0, 580.0, 10.0, "DRAG SLIDER  TYPE  WHEEL SCROLLS  ESC QUITS", DIM);
}
