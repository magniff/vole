// A small immediate-mode UI: buttons, a slider, a text field and a
// scrolling list. Each frame the page calls the widgets, which both draw
// (into ui.verts) and answer for this frame's input: the pointer position
// and presses, the wheel, the typed text and backspaces. Widgets are
// told apart by an id; ui.focus is the text field taking typing and
// ui.drag the slider or list being dragged. Coordinates are logical
// units; the placement scales them to pixels.

use typeset::{Xf, rect, frame, text, width};

pub const BG: [f32; 4] = [0.055, 0.063, 0.082, 1.0];
pub const PANEL: [f32; 4] = [0.12, 0.14, 0.18, 1.0];
pub const HOVER: [f32; 4] = [0.18, 0.21, 0.27, 1.0];
pub const PRESS: [f32; 4] = [0.1, 0.3, 0.5, 1.0];
pub const ACCENT: [f32; 4] = [0.3, 0.75, 1.0, 1.0];
pub const INK: [f32; 4] = [0.93, 0.95, 0.98, 1.0];
pub const DIM: [f32; 4] = [0.5, 0.56, 0.66, 1.0];
pub const SELECT: [f32; 4] = [0.16, 0.36, 0.56, 1.0];

// The list's row height, logical units.
pub const ROW: f64 = 26.0;

pub struct Ui {
    pub gpa: Gpa,
    pub xf: Xf,
    pub verts: Vec<f32>,
    // the pointer, logical units
    pub mx: f64,
    pub my: f64,
    pub down: bool,
    // this frame's events, cleared by end_frame
    pub pressed: bool,
    pub wheel: f64,
    pub typed: Vec<u8>,
    pub backspaces: i64,
    // the widget taking typing, the widget being dragged (-1: none)
    pub focus: i64,
    pub drag: i64,
    pub frame_no: i64,
}

pub struct ListState {
    pub scroll: f64,
    pub selected: i64,
}

impl Ui {
    pub fn new(gpa: Gpa) -> Ui {
        Ui {
            gpa: gpa,
            xf: Xf::plain(1.0),
            verts: Vec::new_in(gpa),
            mx: -1000.0,
            my: -1000.0,
            down: false,
            pressed: false,
            wheel: 0.0,
            typed: Vec::new_in(gpa),
            backspaces: 0,
            focus: -1,
            drag: -1,
            frame_no: 0,
        }
    }

    // Starts a frame at scale device pixels per logical unit.
    pub fn begin(inout self, scale: f64) {
        self.verts.clear();
        self.xf = Xf::plain(scale);
    }

    // Ends it: the one-frame events are gone.
    pub fn end_frame(inout self) {
        self.pressed = false;
        self.wheel = 0.0;
        self.typed.clear();
        self.backspaces = 0;
        self.frame_no += 1;
    }

    pub fn move_to(inout self, x: f64, y: f64) {
        self.mx = x;
        self.my = y;
    }

    // A left press: it clears the focus; a widget under the pointer takes it.
    pub fn press(inout self) {
        self.pressed = true;
        self.down = true;
        self.focus = -1;
        self.drag = -1;
    }

    pub fn release(inout self) {
        self.down = false;
        self.drag = -1;
    }

    // Text typed (UTF-8 bytes; the printable ones go into a text field).
    pub fn type_text(inout self, bytes: [u8]) {
        self.typed.extend_from_slice(bytes);
    }

    pub fn back(inout self) {
        self.backspaces += 1;
    }

    // A wheel step, positive up (the content moves down), in logical units.
    pub fn scroll(inout self, dy: f64) {
        self.wheel += dy;
    }
}

// Whether (x, y) is in the box (rx, ry, w, h).
pub fn inside(x: f64, y: f64, rx: f64, ry: f64, w: f64, h: f64) -> bool {
    x >= rx && x <= rx + w && y >= ry && y <= ry + h
}

pub fn clamp(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo {
        return lo;
    }
    if v > hi {
        return hi;
    }
    v
}

// A button with its label centred; true on the frame it was clicked.
pub fn button(ui: inout Ui, x: f64, y: f64, w: f64, h: f64, label: [u8]) -> bool {
    let over = inside(ui.mx, ui.my, x, y, w, h);
    var fill = PANEL;
    if over {
        fill = HOVER;
    }
    if over && ui.down {
        fill = PRESS;
    }
    rect(&ui.verts, ui.xf, x, y, w, h, fill);
    frame(&ui.verts, ui.xf, x, y, w, h, 1.0, ACCENT);
    let size = 14.0;
    text(&ui.verts, ui.xf, x + (w - width(label, size)) / 2.0, y + (h - size) / 2.0, size, label, INK);
    over && ui.pressed
}

// A horizontal slider of value 0..1 with its knob; returns the new value.
pub fn slider(ui: inout Ui, id: i64, x: f64, y: f64, w: f64, value: f64) -> f64 {
    let h = 12.0;
    if ui.pressed && inside(ui.mx, ui.my, x - 8.0, y - 10.0, w + 16.0, h + 20.0) {
        ui.drag = id;
    }
    var v = value;
    if ui.drag == id && ui.down {
        v = clamp((ui.mx - x) / w, 0.0, 1.0);
    }
    rect(&ui.verts, ui.xf, x, y, w, h, PANEL);
    rect(&ui.verts, ui.xf, x, y, w * v, h, ACCENT);
    rect(&ui.verts, ui.xf, x + w * v - 7.0, y - 6.0, 14.0, h + 12.0, INK);
    v
}

// A text field: a click focuses it; while it has the focus it takes the
// typed printable characters (at most 40) and the backspaces.
pub fn text_field(ui: inout Ui, id: i64, x: f64, y: f64, w: f64, h: f64, content: inout Vec<u8>) {
    let over = inside(ui.mx, ui.my, x, y, w, h);
    if ui.pressed && over {
        ui.focus = id;
    }
    let focused = ui.focus == id;
    if focused {
        var i: i64 = 0;
        while i < ui.typed.len() {
            let b = ui.typed[i];
            if b >= 32 && b < 127 && content.len() < 40 {
                content.push(b);
            }
            i += 1;
        }
        var k: i64 = 0;
        while k < ui.backspaces {
            if content.len() > 0 {
                content.pop();
            }
            k += 1;
        }
    }
    rect(&ui.verts, ui.xf, x, y, w, h, PANEL);
    var edge = DIM;
    if focused {
        edge = ACCENT;
    }
    frame(&ui.verts, ui.xf, x, y, w, h, 1.0, edge);
    let size = 16.0;
    let ty = y + (h - size) / 2.0;
    text(&ui.verts, ui.xf, x + 8.0, ty, size, content.as_slice(), INK);
    if focused && (ui.frame_no / 30) % 2 == 0 {
        let cx = x + 8.0 + width(content.as_slice(), size) + 1.0;
        rect(&ui.verts, ui.xf, cx, ty, 2.0, size, ACCENT);
    }
}

// A scrolling list of count rows labelled ITEM 1, ITEM 2, ..; the wheel
// scrolls it, a click selects the row under the pointer. A row is drawn
// only while it lies wholly inside the list's box.
pub fn list(ui: inout Ui, x: f64, y: f64, w: f64, h: f64, count: i64, st: inout ListState) {
    let total = count as f64 * ROW;
    var max_scroll = total - h;
    if max_scroll < 0.0 {
        max_scroll = 0.0;
    }
    let over = inside(ui.mx, ui.my, x, y, w, h);
    if over {
        st.scroll -= ui.wheel;
    }
    st.scroll = clamp(st.scroll, 0.0, max_scroll);
    if ui.pressed && over {
        let i = ((ui.my - y + st.scroll) / ROW) as i64;
        if i >= 0 && i < count {
            st.selected = i;
        }
    }
    rect(&ui.verts, ui.xf, x, y, w, h, PANEL);
    var i: i64 = 0;
    while i < count {
        let top = y + i as f64 * ROW - st.scroll;
        if top >= y && top + ROW <= y + h {
            if i == st.selected {
                rect(&ui.verts, ui.xf, x + 2.0, top, w - 4.0, ROW, SELECT);
            }
            var label = Buf::new_in(ui.gpa);
            label.push_str("ITEM ");
            label.push_int(i + 1);
            text(&ui.verts, ui.xf, x + 10.0, top + (ROW - 14.0) / 2.0, 14.0, label.as_slice(), INK);
        }
        i += 1;
    }
    if total > h {
        let thumb = h * h / total;
        let ty = y + (h - thumb) * st.scroll / max_scroll;
        rect(&ui.verts, ui.xf, x + w - 6.0, ty, 4.0, thumb, ACCENT);
    }
    frame(&ui.verts, ui.xf, x, y, w, h, 1.0, DIM);
}
