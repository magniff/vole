// The glyphs: a stroke font for the characters the demo uses, drawn on a
// grid of 0..8 units (x to the right, y down; the cap height is 8). A
// glyph's text lists its strokes: a point is a digit pair (x, then y),
// '|' ends a stroke, spaces are ignored. A stroke with one point is a dot.
//
// The atlas is built here, on the CPU, once: for each character a CELL x
// CELL square of signed distance to its strokes, stored as f32 in
// [0, 1] with 0.5 on the outline, larger inside. The render shader
// samples it and smooths the edge by the screen derivative, so the
// outline stays sharp at any size and rotation.

use crate::mathx::sqrt;

pub const CELL: i64 = 48;
pub const COLS: i64 = 16;
pub const ROWS: i64 = 4;
pub const ATLAS_W: i64 = 768;
pub const ATLAS_H: i64 = 192;

// The cell shows units VIEW_MIN .. VIEW_MIN + VIEW_UNITS.
pub const VIEW_MIN: f64 = -1.0;
pub const VIEW_UNITS: f64 = 10.0;

// A glyph advances ADVANCE units (its cap height is 8).
pub const ADVANCE: f64 = 10.0;

// Half the stroke width, in units, and the distance (units) over which
// the field goes from 0 to 1.
const HALF_STROKE: f64 = 0.42;
const SPREAD: f64 = 1.0;

// The characters in atlas order (a character's slot is its position).
pub const CHARSET: [u8] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .-+:/!";

// The strokes of a character (see the top of this file).
fn outline(c: u8) -> [u8] {
    match c {
        'A' => "08 40 88 | 25 65",
        'B' => "00 08 68 86 64 04 | 00 60 82 64",
        'C' => "82 60 20 02 06 28 68 86",
        'D' => "00 08 58 85 83 50 00",
        'E' => "80 00 08 88 | 04 64",
        'F' => "80 00 08 | 04 64",
        'G' => "82 60 20 02 06 28 68 86 84 54",
        'H' => "00 08 | 80 88 | 04 84",
        'I' => "20 60 | 40 48 | 28 68",
        'J' => "80 86 68 28 06",
        'K' => "00 08 | 80 04 | 40 88",
        'L' => "00 08 88",
        'M' => "08 00 46 80 88",
        'N' => "08 00 88 80",
        'O' => "20 60 82 86 68 28 06 02 20",
        'P' => "08 00 60 82 84 66 06",
        'Q' => "20 60 82 86 68 28 06 02 20 | 55 88",
        'R' => "08 00 60 82 84 66 06 | 66 88",
        'S' => "82 60 20 02 03 24 64 86 68 28 06",
        'T' => "00 80 | 40 48",
        'U' => "00 06 28 68 86 80",
        'V' => "00 48 80",
        'W' => "00 28 44 68 80",
        'X' => "00 88 | 80 08",
        'Y' => "00 44 80 | 44 48",
        'Z' => "00 80 08 88",
        '0' => "20 60 82 86 68 28 06 02 20 | 62 26",
        '1' => "24 40 48 | 28 68",
        '2' => "02 20 60 82 83 08 88",
        '3' => "02 20 60 82 64 34 | 64 86 68 28 06",
        '4' => "50 06 86 | 50 58",
        '5' => "80 10 04 54 86 68 28 06",
        '6' => "71 30 02 06 28 68 86 85 64 04",
        '7' => "00 80 38",
        '8' => "20 60 64 24 20 | 24 06 28 68 86 64 24",
        '9' => "17 58 86 82 60 20 02 03 24 84",
        '.' => "66 66",
        '-' => "24 64",
        '+' => "40 48 | 24 64",
        ':' => "33 33 | 55 55",
        '/' => "80 08",
        '!' => "40 45 | 47",
        _ => "",
    }
}

// The lowercase letters are drawn as capitals.
pub fn upper(c: u8) -> u8 {
    if c >= 'a' && c <= 'z' {
        return c - 32;
    }
    c
}

// The atlas slot of a character, or -1 when the font has no glyph for it.
pub fn slot(c: u8) -> i64 {
    let u = upper(c);
    var i: i64 = 0;
    while i < CHARSET.len() {
        if CHARSET[i] == u {
            return i;
        }
        i += 1;
    }
    -1
}

// Appends the segments of a character's strokes to out: x0, y0, x1, y1
// per segment, in units.
pub fn segments(c: u8, out: inout Vec<f64>) {
    let text = outline(c);
    var px: f64 = 0.0;
    var py: f64 = 0.0;
    var count: i64 = 0;  // points in the current stroke
    var digit: i64 = -1; // the x of a point whose y is next
    var i: i64 = 0;
    while i <= text.len() {
        // '|' and the end both end the stroke
        var b: u8 = '|';
        if i < text.len() {
            b = text[i];
        }
        if b == '|' {
            if count == 1 {
                out.push(px);
                out.push(py);
                out.push(px);
                out.push(py);
            }
            count = 0;
        } else if b >= '0' && b <= '8' {
            if digit < 0 {
                digit = (b - '0') as i64;
            } else {
                let x = px;
                let y = py;
                px = digit as f64;
                py = (b - '0') as f64;
                digit = -1;
                if count > 0 {
                    out.push(x);
                    out.push(y);
                    out.push(px);
                    out.push(py);
                }
                count += 1;
            }
        }
        i += 1;
    }
}

// The distance from (px, py) to the segment (ax, ay)-(bx, by).
pub fn dist_to_segment(px: f64, py: f64, ax: f64, ay: f64, bx: f64, by: f64) -> f64 {
    let dx = bx - ax;
    let dy = by - ay;
    let l2 = dx * dx + dy * dy;
    var t: f64 = 0.0;
    if l2 > 0.0 {
        t = ((px - ax) * dx + (py - ay) * dy) / l2;
    }
    if t < 0.0 {
        t = 0.0;
    }
    if t > 1.0 {
        t = 1.0;
    }
    let qx = ax + t * dx - px;
    let qy = ay + t * dy - py;
    sqrt(qx * qx + qy * qy)
}

// The field value at a point of glyph units: 0.5 on the stroke's edge.
pub fn field_at(segs: [f64], u: f64, v: f64) -> f64 {
    var best: f64 = 1000.0;
    var i: i64 = 0;
    while i + 3 < segs.len() {
        let d = dist_to_segment(u, v, segs[i], segs[i + 1], segs[i + 2], segs[i + 3]);
        if d < best {
            best = d;
        }
        i += 4;
    }
    let value = 0.5 - (best - HALF_STROKE) / (2.0 * SPREAD);
    if value < 0.0 {
        return 0.0;
    }
    if value > 1.0 {
        return 1.0;
    }
    value
}

// The atlas: ATLAS_W x ATLAS_H f32s, row-major. Character i's cell is at
// column i % COLS, row i / COLS.
pub fn build_atlas(gpa: Gpa) -> Vec<f32> {
    var atlas: Vec<f32> = Vec::filled_in(ATLAS_W * ATLAS_H, 0.0 as f32, gpa);
    var segs: Vec<f64> = Vec::new_in(gpa);
    var i: i64 = 0;
    while i < CHARSET.len() {
        segs.clear();
        segments(CHARSET[i], &segs);
        let ox = (i % COLS) * CELL;
        let oy = (i / COLS) * CELL;
        var ty: i64 = 0;
        while ty < CELL {
            var tx: i64 = 0;
            while tx < CELL {
                let u = VIEW_MIN + (tx as f64 + 0.5) * VIEW_UNITS / CELL as f64;
                let v = VIEW_MIN + (ty as f64 + 0.5) * VIEW_UNITS / CELL as f64;
                atlas.set((oy + ty) * ATLAS_W + ox + tx, field_at(segs.as_slice(), u, v) as f32);
                tx += 1;
            }
            ty += 1;
        }
        i += 1;
    }
    atlas
}

#[test]
fn slots_are_positions_in_the_charset() {
    assert_eq(slot('A'), 0);
    assert_eq(slot('Z'), 25);
    assert_eq(slot('0'), 26);
    assert_eq(slot('9'), 35);
    assert_eq(slot('a'), 0);
    assert_eq(slot('@'), -1);
}

#[test]
fn a_dot_is_one_segment_and_a_stroke_of_two_points_is_one(gpa: Gpa) {
    var segs: Vec<f64> = Vec::new_in(gpa);
    segments('L', &segs);
    assert_eq(segs.len(), 8);
    segs.clear();
    segments('.', &segs);
    assert_eq(segs.len(), 4);
}

#[test]
fn the_field_is_half_on_an_edge_and_above_inside_a_stroke(gpa: Gpa) {
    var segs: Vec<f64> = Vec::new_in(gpa);
    segments('I', &segs);
    // the stem is x = 4 from y = 0 to 8: on its centre line the field is high
    assert(field_at(segs.as_slice(), 4.0, 4.0) > 0.7);
    // half a stroke width out from the centre line is the edge
    let edge = field_at(segs.as_slice(), 4.0 + 0.42, 4.0);
    assert(edge > 0.49 && edge < 0.51);
    assert_eq(field_at(segs.as_slice(), -0.9, -0.9), 0.0);
}
