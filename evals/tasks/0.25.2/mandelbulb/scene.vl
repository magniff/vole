// The scene on the CPU: the camera, the fractal's knobs, the held keys and
// the fly-through. Std has no math module yet (0.25), so sin, cos and sqrt
// are here: a Taylor series and Newton's method, checked by the tests.

use std::window::MouseAction;
use std::window::keys::{KeyCode, Logical, Named};

pub const PI: f64 = 3.141592653589793;
const TAU: f64 = 6.283185307179586;

pub fn sin64(x: f64) -> f64 {
    var y = x;
    while y > PI {
        y -= TAU;
    }
    while y < -PI {
        y += TAU;
    }
    // sum of (-1)^k y^(2k+1) / (2k+1)!, eleven terms: error under 1e-12 on [-pi, pi]
    var term = y;
    var sum = y;
    var k = 1;
    while k < 12 {
        term = -term * y * y / ((2 * k) as f64 * (2 * k + 1) as f64);
        sum += term;
        k += 1;
    }
    sum
}

pub fn cos64(x: f64) -> f64 {
    sin64(x + PI / 2.0)
}

pub fn sqrt64(x: f64) -> f64 {
    if x <= 0.0 {
        return 0.0;
    }
    var g = if x > 1.0 { x } else { 1.0 };
    for _ in 0..60 {
        g = 0.5 * (g + x / g);
    }
    g
}

pub fn clamp_f(x: f64, lo: f64, hi: f64) -> f64 {
    if x < lo { lo } else if x > hi { hi } else { x }
}

pub struct V3 {
    pub x: f64,
    pub y: f64,
    pub z: f64,
}

pub fn v3(x: f64, y: f64, z: f64) -> V3 {
    V3 { x: x, y: y, z: z }
}

pub fn add3(a: V3, b: V3) -> V3 {
    v3(a.x + b.x, a.y + b.y, a.z + b.z)
}

pub fn scale3(a: V3, k: f64) -> V3 {
    v3(a.x * k, a.y * k, a.z * k)
}

pub fn dot3(a: V3, b: V3) -> f64 {
    a.x * b.x + a.y * b.y + a.z * b.z
}

pub fn cross3(a: V3, b: V3) -> V3 {
    v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
}

// A camera looks along forward(yaw, pitch); yaw 0 looks down +x, pitch
// 0 is level, positive looks up. Its right and up follow from that.
pub struct Camera {
    pub pos: V3,
    pub yaw: f64,
    pub pitch: f64,
}

pub fn forward(c: Camera) -> V3 {
    let cp = cos64(c.pitch);
    v3(cp * cos64(c.yaw), sin64(c.pitch), cp * sin64(c.yaw))
}

// forward x world up, normalised: the horizontal direction to the right.
pub fn right_of(c: Camera) -> V3 {
    v3(-sin64(c.yaw), 0.0, cos64(c.yaw))
}

pub fn up_of(c: Camera) -> V3 {
    cross3(right_of(c), forward(c))
}

// The fractals: 0 is the Mandelbulb, 1 the Mandelbox.
pub struct Scene {
    pub cam: Camera,
    pub fractal: i64,
    // the Mandelbulb's exponent, 2 to 12
    pub power: f64,
    // the Mandelbox's scale, -3 to 4
    pub scale: f64,
    pub shadows: bool,
    pub ao: bool,
    // the fly-through: on, the camera circles the fractal by itself
    pub auto: bool,
    // seconds since the start, for the fly-through
    pub t: f64,
    // a flight's speed multiplier, 0.25 to 8
    pub speed: f64,
}

// The keys held down, and the mouse's drag since the last frame.
pub struct Keys {
    pub w: bool,
    pub a: bool,
    pub s: bool,
    pub d: bool,
    pub q: bool,
    pub e: bool,
    pub shift: bool,
    pub left: bool,
    pub right: bool,
    pub up: bool,
    pub down: bool,
    pub drag: bool,
    pub last_x: f64,
    pub last_y: f64,
    pub look_x: f64,
    pub look_y: f64,
}

pub fn new_keys() -> Keys {
    Keys {
        w: false, a: false, s: false, d: false, q: false, e: false, shift: false,
        left: false, right: false, up: false, down: false,
        drag: false, last_x: 0.0, last_y: 0.0, look_x: 0.0, look_y: 0.0,
    }
}

// The camera at a focus, `dist` back along the view: the views are made so.
pub fn orbit_pos(focus: V3, yaw: f64, pitch: f64, dist: f64) -> V3 {
    let f = forward(Camera { pos: focus, yaw: yaw, pitch: pitch });
    add3(focus, scale3(f, -dist))
}

// The distance a preset view stands off: the Mandelbox is wider.
pub fn view_dist(view: i64, fractal: i64) -> f64 {
    let base = if view == 1 { 1.5 } else if view == 2 { 3.4 } else { 2.7 };
    if fractal == 1 { base * 3.3 } else { base }
}

// The fixed views the headless mode renders: 0, 1, 2.
pub fn view_scene(view: i64, fractal: i64, power: f64, scale: f64) -> Scene {
    let yaw = if view == 1 { 2.3 } else if view == 2 { 4.1 } else { 0.6 };
    let pitch = if view == 1 { -0.15 } else if view == 2 { 0.4 } else { 0.25 };
    let pos = orbit_pos(v3(0.0, 0.0, 0.0), yaw, pitch, view_dist(view, fractal));
    Scene {
        cam: Camera { pos: pos, yaw: yaw, pitch: pitch },
        fractal: fractal, power: power, scale: scale,
        shadows: true, ao: true, auto: false, t: 0.0, speed: 1.0,
    }
}

// The uniforms march.wgsl reads (its layout is written there).
pub fn uniforms(s: Scene, w: i64, h: i64) -> [f32; 24] {
    let f = forward(s.cam);
    let r = right_of(s.cam);
    let u = up_of(s.cam);
    let p = s.cam.pos;
    let on = |b: bool| -> f32 { if b { 1.0 } else { 0.0 } };
    [
        w as f32, h as f32, s.t as f32, s.power as f32,
        p.x as f32, p.y as f32, p.z as f32, 0.6,
        f.x as f32, f.y as f32, f.z as f32, s.fractal as f32,
        r.x as f32, r.y as f32, r.z as f32, s.scale as f32,
        u.x as f32, u.y as f32, u.z as f32, 0.0,
        on(s.shadows), on(s.ao), 0.0, 0.0,
    ]
}

pub fn new_scene(fractal: i64, power: f64, scale: f64) -> Scene {
    view_scene(0, fractal, power, scale)
}

// Keys that move the camera: held down, or let go.
pub fn key_held(k: inout Keys, code: KeyCode, down: bool) {
    match code {
        KeyCode::KeyW => k.w = down,
        KeyCode::KeyA => k.a = down,
        KeyCode::KeyS => k.s = down,
        KeyCode::KeyD => k.d = down,
        KeyCode::KeyQ => k.q = down,
        KeyCode::KeyE => k.e = down,
        KeyCode::ShiftLeft => k.shift = down,
        KeyCode::ShiftRight => k.shift = down,
        KeyCode::ArrowLeft => k.left = down,
        KeyCode::ArrowRight => k.right = down,
        KeyCode::ArrowUp => k.up = down,
        KeyCode::ArrowDown => k.down = down,
        _ => {}
    }
}

// The mouse: a left drag turns the camera.
pub fn mouse(k: inout Keys, action: MouseAction, left: bool, x: f64, y: f64) {
    match action {
        MouseAction::Press => {
            if left {
                k.drag = true;
                k.last_x = x;
                k.last_y = y;
            }
        }
        MouseAction::Release => {
            if left {
                k.drag = false;
            }
        }
        MouseAction::Move => {
            if k.drag {
                k.look_x += x - k.last_x;
                k.look_y += y - k.last_y;
                k.last_x = x;
                k.last_y = y;
            }
        }
    }
}

// A key that acts once per press. Returns false for keys it does not use.
pub fn on_key(s: inout Scene, key: Logical) -> bool {
    match key {
        Logical::Char(c) => {
            if c == 'p' as u32 {
                s.auto = !s.auto;
            } else if c == 'm' as u32 {
                s.fractal = 1 - s.fractal;
            } else if c == ']' as u32 {
                adjust_knob(&s, 1.0);
            } else if c == '[' as u32 {
                adjust_knob(&s, -1.0);
            } else if c == '=' as u32 {
                s.speed = clamp_f(s.speed * 1.5, 0.25, 8.0);
            } else if c == '-' as u32 {
                s.speed = clamp_f(s.speed / 1.5, 0.25, 8.0);
            } else if c == 'l' as u32 {
                s.shadows = !s.shadows;
            } else if c == 'o' as u32 {
                s.ao = !s.ao;
            } else if c == 'r' as u32 {
                let keep = s.fractal;
                let p = s.power;
                let k = s.scale;
                let t = s.t;
                s.cam = view_scene(0, keep, p, k).cam;
                s.t = t;
            } else {
                return false;
            }
            true
        }
        Logical::Named(Named::Escape) => false,
        _ => false,
    }
}

// The Mandelbulb's power steps by a quarter, the Mandelbox's scale by a twentieth.
pub fn adjust_knob(s: inout Scene, d: f64) {
    if s.fractal == 0 {
        s.power = clamp_f(s.power + 0.25 * d, 2.0, 12.0);
    } else {
        s.scale = clamp_f(s.scale + 0.05 * d, -3.0, 4.0);
    }
}

// The fly-through: the focus drifts on a slow Lissajous path and the camera
// circles it, its distance and pitch moving gently too.
pub fn auto_step(s: inout Scene, dt: f64) {
    s.cam.yaw += 0.12 * dt;
    let focus = v3(
        0.25 * sin64(0.11 * s.t),
        0.15 * sin64(0.17 * s.t + 1.0),
        0.25 * sin64(0.07 * s.t + 2.0));
    let base = if s.fractal == 1 { 8.0 } else { 2.7 };
    let dist = base + 0.4 * sin64(0.05 * s.t);
    s.cam.pitch = 0.22 * sin64(0.21 * s.t);
    s.cam.pos = orbit_pos(focus, s.cam.yaw, s.cam.pitch, dist);
}

// One frame: the fly-through, or the held keys (turn, move) and the mouse's drag.
pub fn step_scene(s: inout Scene, k: inout Keys, dt: f64) {
    s.t += dt;
    if s.auto {
        auto_step(&s, dt);
        k.look_x = 0.0;
        k.look_y = 0.0;
        return;
    }
    var turn_x = 0.0;
    if k.left { turn_x -= 1.0; }
    if k.right { turn_x += 1.0; }
    var turn_y = 0.0;
    if k.up { turn_y += 1.0; }
    if k.down { turn_y -= 1.0; }
    s.cam.yaw += turn_x * 1.2 * dt + k.look_x * 0.004;
    s.cam.pitch = clamp_f(s.cam.pitch + turn_y * 1.2 * dt - k.look_y * 0.004, -1.5, 1.5);
    k.look_x = 0.0;
    k.look_y = 0.0;

    var fwd = 0.0;
    if k.w { fwd += 1.0; }
    if k.s { fwd -= 1.0; }
    var side = 0.0;
    if k.d { side += 1.0; }
    if k.a { side -= 1.0; }
    var up = 0.0;
    if k.e { up += 1.0; }
    if k.q { up -= 1.0; }
    let boost = if k.shift { 4.0 } else { 1.0 };
    let v = add3(add3(scale3(forward(s.cam), fwd), scale3(right_of(s.cam), side)),
        scale3(up_of(s.cam), up));
    s.cam.pos = add3(s.cam.pos, scale3(v, 0.9 * s.speed * boost * dt));
}

#[test]
fn sin_and_cos_match_known_values() {
    assert(abs_diff(sin64(0.0), 0.0) < 1e-12);
    assert(abs_diff(sin64(PI / 2.0), 1.0) < 1e-12);
    assert(abs_diff(sin64(PI / 6.0), 0.5) < 1e-12);
    assert(abs_diff(sin64(-PI / 2.0), -1.0) < 1e-12);
    assert(abs_diff(sin64(10.0 * PI + 0.3), sin64(0.3)) < 1e-9);
    assert(abs_diff(cos64(0.0), 1.0) < 1e-12);
    assert(abs_diff(cos64(PI), -1.0) < 1e-12);
    assert(abs_diff(cos64(PI / 3.0), 0.5) < 1e-12);
}

#[test]
fn sqrt_is_the_root() {
    assert(sqrt64(0.0) == 0.0);
    assert(abs_diff(sqrt64(2.0), 1.4142135623730951) < 1e-12);
    assert(abs_diff(sqrt64(1e-8), 1e-4) < 1e-12);
    assert(abs_diff(sqrt64(1e6), 1000.0) < 1e-9);
}

fn abs_diff(a: f64, b: f64) -> f64 {
    if a > b { a - b } else { b - a }
}

#[test]
fn camera_basis_is_orthonormal() {
    var yaw = -3.0;
    while yaw < 3.0 {
        let c = Camera { pos: v3(0.0, 0.0, 0.0), yaw: yaw, pitch: 0.7 * sin64(yaw) };
        let f = forward(c);
        let r = right_of(c);
        let u = up_of(c);
        assert(abs_diff(dot3(f, f), 1.0) < 1e-9);
        assert(abs_diff(dot3(r, r), 1.0) < 1e-9);
        assert(abs_diff(dot3(u, u), 1.0) < 1e-9);
        assert(abs_diff(dot3(f, r), 0.0) < 1e-9);
        assert(abs_diff(dot3(f, u), 0.0) < 1e-9);
        assert(abs_diff(dot3(r, u), 0.0) < 1e-9);
        assert(u.y > 0.0);
        yaw += 0.37;
    }
}

#[test]
fn preset_views_look_at_the_origin() {
    var view = 0;
    while view < 3 {
        var fractal = 0;
        while fractal < 2 {
            let s = view_scene(view, fractal, 8.0, 2.3);
            let f = forward(s.cam);
            // the origin lies straight ahead, the view distance away
            let to = scale3(s.cam.pos, -1.0);
            let dist = sqrt64(dot3(to, to));
            assert(abs_diff(dist, view_dist(view, fractal)) < 1e-9);
            assert(abs_diff(dot3(f, scale3(to, 1.0 / dist)), 1.0) < 1e-9);
            fractal += 1;
        }
        view += 1;
    }
}

#[test]
fn knobs_stay_in_range() {
    var s = new_scene(0, 8.0, 2.3);
    var i = 0;
    while i < 100 {
        adjust_knob(&s, 1.0);
        i += 1;
    }
    assert(s.power == 12.0);
    s.fractal = 1;
    i = 0;
    while i < 200 {
        adjust_knob(&s, -1.0);
        i += 1;
    }
    assert(s.scale == -3.0);
}

#[test]
fn keys_move_the_camera_forward() {
    var s = new_scene(0, 8.0, 2.3);
    var k = new_keys();
    let before = s.cam.pos;
    k.w = true;
    step_scene(&s, &k, 0.5);
    let f = forward(s.cam);
    let moved = add3(s.cam.pos, scale3(before, -1.0));
    // along the view, and by 0.9 * 0.5 units
    assert(abs_diff(dot3(moved, f), 0.45) < 1e-9);
    assert(abs_diff(dot3(moved, right_of(s.cam)), 0.0) < 1e-9);
}

#[test]
fn drag_turns_the_camera_and_p_flies() {
    var s = new_scene(0, 8.0, 2.3);
    var k = new_keys();
    let yaw = s.cam.yaw;
    mouse(&k, MouseAction::Press, true, 100.0, 100.0);
    mouse(&k, MouseAction::Move, true, 150.0, 100.0);
    step_scene(&s, &k, 0.016);
    assert(abs_diff(s.cam.yaw - yaw, 50.0 * 0.004) < 1e-9);
    mouse(&k, MouseAction::Release, true, 150.0, 100.0);
    let _ = on_key(&s, Logical::Char('p' as u32));
    assert(s.auto);
    step_scene(&s, &k, 0.016);
    let d = sqrt64(dot3(s.cam.pos, s.cam.pos));
    assert(d > 2.0 && d < 3.5);
}

#[test]
fn uniforms_are_six_vectors() {
    let s = new_scene(1, 8.0, 2.3);
    let u = uniforms(s, 640, 360);
    assert(u.len() == 24);
    assert(u[0] == 640.0);
    assert(u[1] == 360.0);
    assert(u[11] == 1.0);
    assert(u[15] == 2.3f32);
}
