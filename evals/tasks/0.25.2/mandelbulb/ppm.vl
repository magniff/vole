// Pictures on the CPU: a BGRA readback as a binary PPM, and its brightness.

use scene::sqrt64;

// The readback's rows are `stride` bytes apart, a pixel is B G R A.
pub fn ppm_of_bgra(px: [u8], w: i64, h: i64, stride: i64, gpa: Gpa) -> Buf {
    var b = format_in(f"P6\n{w} {h}\n255\n", gpa);
    for y in 0..h {
        for x in 0..w {
            let i = y * stride + x * 4;
            b.push(px[i + 2]);
            b.push(px[i + 1]);
            b.push(px[i]);
        }
    }
    b
}

pub struct Stats {
    // mean and standard deviation of the luma, both in 0..1
    pub mean: f64,
    pub spread: f64,
}

pub fn stats_of_bgra(px: [u8], w: i64, h: i64, stride: i64) -> Stats {
    var sum = 0.0;
    var sq = 0.0;
    for y in 0..h {
        for x in 0..w {
            let i = y * stride + x * 4;
            let r = px[i + 2] as f64;
            let g = px[i + 1] as f64;
            let b = px[i] as f64;
            let l = (0.299 * r + 0.587 * g + 0.114 * b) / 255.0;
            sum += l;
            sq += l * l;
        }
    }
    let n = (w * h) as f64;
    let mean = sum / n;
    var var_ = sq / n - mean * mean;
    if var_ < 0.0 {
        var_ = 0.0;
    }
    Stats { mean: mean, spread: sqrt64(var_) }
}

#[test]
fn stats_of_a_flat_and_a_split_picture() {
    // two pixels, one row, stride 8: B G R A, then padding
    let flat: [u8; 8] = [128, 128, 128, 255, 128, 128, 128, 255];
    let s = stats_of_bgra(flat[..], 2, 1, 8);
    assert(near(s.mean, 128.0 / 255.0));
    assert(s.spread < 1e-6);
    let split: [u8; 8] = [0, 0, 0, 255, 255, 255, 255, 255];
    let t = stats_of_bgra(split[..], 2, 1, 8);
    assert(near(t.mean, 0.5));
    assert(near(t.spread, 0.5));
}

fn near(a: f64, b: f64) -> bool {
    let d = a - b;
    d < 1e-9 && d > -1e-9
}
