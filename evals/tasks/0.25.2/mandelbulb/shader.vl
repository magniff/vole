// The WGSL of the raymarcher, a string constant (std has no include_str).
// Vertex: one fullscreen triangle; fragment: the march.
//   a: resolution.xy, time, Mandelbulb power     b: camera position, tan(fov / 2)
//   c: forward, fractal (0 bulb, 1 box)           d: right, Mandelbox scale
//   e: up                                         f: shadows on, ao on

pub const MARCH: [u8] = "\
// Raymarched fractals: a Mandelbulb (power u.a.w) or a Mandelbox (scale u.d.w),\n\
// chosen by u.c.w. One fullscreen triangle; each pixel marches a ray.\n\
//\n\
// Uniform layout (six vec4s, written by scene.vl's uniforms()):\n\
//   a: resolution.xy, time, Mandelbulb power\n\
//   b: camera position, tan(fov / 2)\n\
//   c: camera forward, fractal (0 Mandelbulb, 1 Mandelbox)\n\
//   d: camera right, Mandelbox scale\n\
//   e: camera up, unused\n\
//   f: soft shadows on, ambient occlusion on\n\
\n\
struct U {\n\
    a: vec4<f32>,\n\
    b: vec4<f32>,\n\
    c: vec4<f32>,\n\
    d: vec4<f32>,\n\
    e: vec4<f32>,\n\
    f: vec4<f32>,\n\
}\n\
\n\
@group(0) @binding(0) var<uniform> u: U;\n\
\n\
struct V {\n\
    @builtin(position) pos: vec4<f32>,\n\
}\n\
\n\
@vertex fn vs(@builtin(vertex_index) i: u32) -> V {\n\
    var p = vec2<f32>(-1.0, -1.0);\n\
    if (i == 1u) { p = vec2<f32>(3.0, -1.0); }\n\
    if (i == 2u) { p = vec2<f32>(-1.0, 3.0); }\n\
    return V(vec4<f32>(p, 0.0, 1.0));\n\
}\n\
\n\
// Distance estimate and an orbit trap (the closest the orbit came to 0).\n\
fn bulb(p: vec3<f32>, pw: f32) -> vec2<f32> {\n\
    var z = p;\n\
    var dr = 1.0;\n\
    var r = 0.0;\n\
    var trap = 1e4;\n\
    for (var i = 0; i < 10; i++) {\n\
        r = length(z);\n\
        trap = min(trap, r);\n\
        if (r > 2.0) { break; }\n\
        let rr = max(r, 1e-6);\n\
        let th = acos(clamp(z.z / rr, -1.0, 1.0)) * pw;\n\
        let ph = atan2(z.y, z.x) * pw;\n\
        dr = pow(rr, pw - 1.0) * pw * dr + 1.0;\n\
        let zr = pow(rr, pw);\n\
        z = zr * vec3<f32>(sin(th) * cos(ph), sin(ph) * sin(th), cos(th)) + p;\n\
    }\n\
    return vec2<f32>(0.5 * log(max(r, 1e-6)) * r / dr, trap);\n\
}\n\
\n\
// The Mandelbox: box fold, sphere fold, scale and shift.\n\
fn box_fold(p: vec3<f32>, s: f32) -> vec2<f32> {\n\
    var z = p;\n\
    var dr = 1.0;\n\
    var trap = 1e4;\n\
    for (var i = 0; i < 14; i++) {\n\
        z = clamp(z, vec3<f32>(-1.0), vec3<f32>(1.0)) * 2.0 - z;\n\
        let r2 = dot(z, z);\n\
        trap = min(trap, r2);\n\
        if (r2 < 0.25) {\n\
            z = z * 4.0;\n\
            dr = dr * 4.0;\n\
        } else if (r2 < 1.0) {\n\
            z = z / r2;\n\
            dr = dr / r2;\n\
        }\n\
        z = z * s + p;\n\
        dr = dr * abs(s) + 1.0;\n\
        if (dot(z, z) > 1e6) { break; }\n\
    }\n\
    return vec2<f32>(length(z) / abs(dr), trap);\n\
}\n\
\n\
fn de(p: vec3<f32>) -> vec2<f32> {\n\
    if (u.c.w < 0.5) {\n\
        return bulb(p, u.a.w);\n\
    }\n\
    return box_fold(p, u.d.w);\n\
}\n\
\n\
fn normal_at(p: vec3<f32>, e: f32) -> vec3<f32> {\n\
    let k = vec2<f32>(1.0, -1.0);\n\
    return normalize(\n\
        k.xyy * de(p + k.xyy * e).x +\n\
        k.yyx * de(p + k.yyx * e).x +\n\
        k.yxy * de(p + k.yxy * e).x +\n\
        k.xxx * de(p + k.xxx * e).x);\n\
}\n\
\n\
// Soft shadow: the closest the ray came to the surface, relative to its distance.\n\
fn shadow(ro: vec3<f32>, rd: vec3<f32>) -> f32 {\n\
    var res = 1.0;\n\
    var t = 0.02;\n\
    for (var i = 0; i < 48; i++) {\n\
        let h = de(ro + rd * t).x;\n\
        res = min(res, 8.0 * h / t);\n\
        t = t + clamp(h, 0.01, 0.2);\n\
        if (res < 0.001 || t > 10.0) { break; }\n\
    }\n\
    return clamp(res, 0.0, 1.0);\n\
}\n\
\n\
// Ambient occlusion: the distance estimate sampled along the normal.\n\
fn occlusion(p: vec3<f32>, n: vec3<f32>) -> f32 {\n\
    var occ = 0.0;\n\
    var sca = 1.0;\n\
    for (var i = 0; i < 5; i++) {\n\
        let h = 0.01 + 0.12 * f32(i) / 4.0;\n\
        let d = de(p + n * h).x;\n\
        occ = occ + (h - d) * sca;\n\
        sca = sca * 0.95;\n\
    }\n\
    return clamp(1.0 - 3.0 * occ, 0.0, 1.0);\n\
}\n\
\n\
fn palette(t: f32) -> vec3<f32> {\n\
    return 0.5 + 0.5 * cos(6.2831 * (vec3<f32>(t) * 1.7 + vec3<f32>(0.0, 0.33, 0.67)));\n\
}\n\
\n\
fn background(rd: vec3<f32>) -> vec3<f32> {\n\
    return mix(vec3<f32>(0.03, 0.03, 0.06), vec3<f32>(0.10, 0.13, 0.20), 0.5 + 0.5 * rd.y);\n\
}\n\
\n\
@fragment fn fs(v: V) -> @location(0) vec4<f32> {\n\
    let res = u.a.xy;\n\
    let q = (v.pos.xy - 0.5 * res) / (0.5 * res.y);\n\
    let uv = vec2<f32>(q.x, -q.y);\n\
    let ro = u.b.xyz;\n\
    let rd = normalize(u.c.xyz + (uv.x * u.d.xyz + uv.y * u.e.xyz) * u.b.w);\n\
\n\
    var t = 0.0;\n\
    var hit = false;\n\
    var step_k = 0.9;\n\
    if (u.c.w > 0.5) { step_k = 0.6; }\n\
    for (var i = 0; i < 220; i++) {\n\
        let d = de(ro + rd * t).x;\n\
        if (d < 0.0004 * t) {\n\
            hit = true;\n\
            break;\n\
        }\n\
        t = t + step_k * d;\n\
        if (t > 30.0) { break; }\n\
    }\n\
\n\
    var col = background(rd);\n\
    if (hit) {\n\
        let p = ro + rd * t;\n\
        let trap = de(p).y;\n\
        let n = normal_at(p, 0.0004 * t);\n\
        let l = normalize(vec3<f32>(0.6, 0.8, -0.5));\n\
        let dif = clamp(dot(n, l), 0.0, 1.0);\n\
        var sh = 1.0;\n\
        if (u.f.x > 0.5) { sh = shadow(p + n * 0.002, l); }\n\
        var ao = 1.0;\n\
        if (u.f.y > 0.5) { ao = occlusion(p, n); }\n\
        let sky = 0.5 + 0.5 * n.y;\n\
        let base = palette(trap);\n\
        let lit = base * (vec3<f32>(1.0, 0.94, 0.84) * (0.12 + dif * sh * 1.3)\n\
            + vec3<f32>(0.2, 0.26, 0.38) * sky * ao) * ao;\n\
        col = mix(lit, background(rd), 1.0 - exp(-0.004 * t * t));\n\
    }\n\
    col = sqrt(clamp(col, vec3<f32>(0.0), vec3<f32>(1.0)));\n\
    return vec4<f32>(col, 1.0);\n\
}\n";
